#!/bin/sh
# commit-msg — gate do elo item<->commit do DORA: a mensagem cita id que existe e esta aberto.
# capacidade: qualidade-do-codigo-lint
# dono: ti
#
# A regua NAO mora aqui: roda via bin/_lint/commit_msg.py.
# Nenhum hook chama o verbo lint (spec_lint §1).

AQUI="$(dirname "$(readlink -f "$0")")"
PYTHON="${PYTHON:-python3}"

exec "$PYTHON" "$AQUI/../bin/_lint/commit_msg.py" "$1"
