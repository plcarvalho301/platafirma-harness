#!/usr/bin/env bash
# pre-push — a suite de contrato ganha GATILHO.
#
# capacidade: orfa
# dono: claudinho-TI
#
# POR QUE EXISTE (card #204 item 2): a suite so rodava se alguem digitasse, e sete
# dos oito arquivos estavam parados desde 10-11/08. Nao ha CI neste repo. Teste sem
# gatilho nao e rede de seguranca: e arquivo que apodrece ate virar ruido — foi
# exatamente o que aconteceu com o contrato do monta-sessao, 17 vermelhos por dias.
#
# BASELINE VERDE, e nao a suite inteira. Gate que nasce vermelho por falha que ja
# existia e gate que alguem desliga na primeira vez. Entao ele julga so o que esta
# verde HOJE, listado em `controle/tests/VERDES`, e arquivo consertado ENTRA na lista
# no mesmo commit que o conserta. A lista so cresce.
#
# JULGA A REV EMPURRADA, NAO O WORKING TREE (achado de claudinha-gestao-estrategica,
# 04/09/2026). O clone de ~/AI e COMPARTILHADO entre cadeiras: quando alguem esta com
# bin/monta-sessao modificado e nao commitado, quem commita em abertura/ paga o
# vermelho alheio. Medido naquele dia: 17 failed no clone sujo, 18 passed no mesmo
# HEAD em worktree limpo — o commit estava verde e o push foi barrado assim mesmo.
# A saida "obvia" (stashear o trabalho alheio pra desbloquear o proprio push) troca
# atraso por perda de trabalho de outro, e por isso o gate e que muda, nao o humano.
# Entao: worktree descartavel na rev que o git esta empurrando, medida la, remocao no
# trap. O estado sujo do clone deixa de ter voto.
#
# NAO TRAVA POR AMBIENTE. Sem `uvx`, avisa e deixa passar: gate que bloqueia push por
# falta de ferramenta na maquina e gate contornado com --no-verify na segunda vez.
# Bloqueia so quando MEDIU e o teste falhou.
set -uo pipefail

# O PROPRIO GIT injeta GIT_DIR/GIT_WORK_TREE (e primos) no ambiente deste hook — apontam
# pro repositorio que disparou o push. Sem limpar, qualquer `git init`/`git commit` de
# fixture DENTRO da suite (repo descartavel em tmp_path) herda essas variaveis via
# subprocess e a escrita "descartavel" cai no repositorio REAL — medido: suite verde
# rodada a mao, commit fantasma no branch de quem empurrou rodada daqui de dentro.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR       GIT_CEILING_DIRECTORIES

RAIZ="$(git rev-parse --show-toplevel)"
LISTA="$RAIZ/controle/tests/VERDES"

[ -r "$LISTA" ] || exit 0

if ! command -v uvx >/dev/null 2>&1; then
  echo "pre-push: uvx ausente — suite de contrato NAO foi medida neste push." >&2
  exit 0
fi

ARQUIVOS=""
while IFS= read -r linha; do
  case "$linha" in ''|'#'*) continue ;; esac
  [ -f "$RAIZ/controle/$linha" ] && ARQUIVOS="$ARQUIVOS $linha"
done < "$LISTA"

[ -n "$ARQUIVOS" ] || exit 0

# A REV A JULGAR vem do stdin do hook: "<local_ref> <local_oid> <remote_ref> <remote_oid>".
# local_oid todo-zero e delecao de ref: nao ha arvore a medir, e o hook nao opina.
# stdin vazio (invocacao a mao) cai no HEAD, que continua sendo commit, nunca o worktree.
REV=""
while read -r _ local_oid _ _; do
  case "$local_oid" in
    ''|*[!0-9a-f]*) continue ;;
    0000000000000000000000000000000000000000) continue ;;
  esac
  REV="$local_oid"
  break
done

if [ -z "$REV" ]; then
  REV="$(git rev-parse --verify HEAD 2>/dev/null)" || exit 0
  [ -n "$REV" ] || exit 0
fi

# Worktree descartavel: o gate mede a arvore da rev empurrada, sem tocar no clone.
ARVORE="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-arvore.XXXXXX")" || exit 0
limpa() {
  git worktree remove --force "$ARVORE" >/dev/null 2>&1 || rm -rf "$ARVORE"
  git worktree prune >/dev/null 2>&1
}
trap limpa EXIT

# mktemp -d ja criou o diretorio; `worktree add` exige inexistente ou vazio.
if ! git worktree add --detach --no-checkout "$ARVORE" "$REV" >/tmp/pre-push-arvore.txt 2>&1; then
  echo "pre-push: nao consegui isolar a rev $REV — suite NAO foi medida neste push." >&2
  tail -n 5 /tmp/pre-push-arvore.txt >&2
  exit 0
fi
if ! git -C "$ARVORE" checkout --quiet --detach "$REV" >>/tmp/pre-push-arvore.txt 2>&1; then
  echo "pre-push: nao consegui materializar a rev $REV — suite NAO foi medida neste push." >&2
  tail -n 5 /tmp/pre-push-arvore.txt >&2
  exit 0
fi

# A lista vale a do clone (e o gate de agora); os testes vem da arvore empurrada.
ALVOS=""
for arq in $ARQUIVOS; do
  [ -f "$ARVORE/controle/$arq" ] && ALVOS="$ALVOS $arq"
done
[ -n "$ALVOS" ] || exit 0

cd "$ARVORE/controle" || exit 0
# shellcheck disable=SC2086
if ! timeout 300 uvx --with redis pytest $ALVOS -q >/tmp/pre-push-contrato.txt 2>&1; then
  echo >&2
  echo "pre-push: BASELINE VERDE QUEBROU na rev ${REV:0:7} — push barrado." >&2
  tail -n 15 /tmp/pre-push-contrato.txt >&2
  echo >&2
  echo "  medido em worktree limpo da rev empurrada, nao no seu clone." >&2
  echo "  saida inteira: /tmp/pre-push-contrato.txt" >&2
  echo "  a lista do baseline: controle/tests/VERDES" >&2
  exit 1
fi

echo "pre-push: baseline de contrato verde em ${REV:0:7} ($(tail -n 1 /tmp/pre-push-contrato.txt))"
