#!/usr/bin/env bash
# pre-push — a suite de contrato ganha GATILHO.
#
# capacidade: orfa
# dono: claudinho-TI
#
# POR QUE EXISTE (card #204 item 2): a suite so rodava se alguem digitasse, e sete
# dos oito arquivos estavam parados desde 10-11/08. Nao ha CI neste repo. Teste sem
# gatilho nao e rede de seguranca: e arquivo que apodrece ate virar ruido — foi
# exatamente o que aconteceu com o contrato do monta-sessao, 17 vermelhos por dias.
#
# BASELINE VERDE, e nao a suite inteira. Gate que nasce vermelho por falha que ja
# existia e gate que alguem desliga na primeira vez. Entao ele julga so o que esta
# verde HOJE, listado na lista de portao de cada subarvore de teste (controle/tests/
# VERDES, recuperacao/VERDES, ops-server/VERDES...), e arquivo consertado ENTRA na
# lista no mesmo commit que o conserta. A lista so cresce.
#
# O REPOSITORIO INTEIRO, nao uma chave (arq:0116 §6): `teste rodar <repositorio>
# --portao --arvore` roda a lista de portao de toda chave do registro que declara
# subarvore de teste, cada uma no seu venv, e passa quando todas passam. O nome do
# repositorio e o do origin (ultimo segmento da url, sem .git). Repositorio de esteira
# documento nao e medido aqui; repositorio que o registro nao conhece, ou sem chave
# de teste, sai "nao medido" e deixa passar.
#
# JULGA A REV EMPURRADA, NAO O WORKING TREE (achado de claudinha-gestao-estrategica,
# 04/09/2026). O clone da pasta de trabalho da conta era COMPARTILHADO entre
# cadeiras: quando alguem esta com bin/monta-sessao modificado e nao commitado, quem
# commita em abertura/ paga o vermelho alheio. Entao: worktree descartavel na rev
# que o git esta empurrando, medida la, remocao no trap. O estado sujo do clone
# deixa de ter voto. O REGISTRO DE VENVS TAMBEM VEM DA ARVORE EMPURRADA, quando ela
# o tem — nao do clone de quem esta empurrando.
#
# NAO TRAVA POR AMBIENTE. Ambiente que nao constroi, ou pytest que nem coleta, nao
# vira "BASELINE VERDE QUEBROU": avisa e deixa passar. Bloqueia so quando MEDIU e o
# teste falhou de verdade (card #3150, comentário A2).
#
# card #3150, comentário A: o mesmo construtor e a MESMA chave <nome>-hash(lock+
# python) que release/teste usam (lib/venv.sh + bin/_release/registro.py). Veredito
# gravado e reaproveitado por (hash da árvore, chave) — o MESMO arquivo que o gate
# de `release promover` lê e grava, então uma rev já medida aqui não roda a suíte de
# novo na promoção. Toda ref empurrada é medida, não só a primeira (A4).
set -uo pipefail

# O PROPRIO GIT injeta GIT_DIR/GIT_WORK_TREE (e primos) no ambiente deste hook — apontam
# pro repositorio que disparou o push. Sem limpar, qualquer `git init`/`git commit` de
# fixture DENTRO da suite (repo descartavel em tmp_path) herda essas variaveis via
# subprocess e a escrita "descartavel" cai no repositorio REAL — medido: suite verde
# rodada a mao, commit fantasma no branch de quem empurrou rodada daqui de dentro.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR       GIT_CEILING_DIRECTORIES

RAIZ="$(git rev-parse --show-toplevel)"
AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

# shellcheck source=../lib/raizes.sh
. "$AQUI/../lib/raizes.sh"
# shellcheck source=../lib/venv.sh
. "$AQUI/../lib/venv.sh"
PF_VENV_PREFIXO="pre-push"

REGISTRO="$AQUI/../bin/_release/registro.py"
VEREDITOS_DIR="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/pre-push/vereditos"
ARVORES_DIR="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/pre-push/arvores"
mkdir -p "$VEREDITOS_DIR" "$ARVORES_DIR" 2>/dev/null || true

# o repositorio que se empurra, pelo origin
URL="$(git remote get-url origin 2>/dev/null || true)"
REPO="$(basename "${URL%/}")"; REPO="${REPO%.git}"
[ -n "$REPO" ] || REPO="$(basename "$RAIZ")"

# registro de antes da rev (so para decidir se ha o que medir): o do clone, senao o do hook
venvs_de() {  # $1=raiz de arvore ; imprime o registro a usar
  if [ -n "${PLATAFIRMA_VENVS:-}" ]; then printf '%s' "$PLATAFIRMA_VENVS"
  elif [ -r "$1/registro/venvs.json" ]; then printf '%s' "$1/registro/venvs.json"
  else printf '%s' "$AQUI/../registro/venvs.json"; fi
}
VENVS_CLONE="$(venvs_de "$RAIZ")"
res="$(PLATAFIRMA_VENVS="$VENVS_CLONE" python3 "$REGISTRO" "$REPO" 2>/dev/null)" || res=""
esteira="$(printf '%s' "$res" | cut -f4)"
[ "$esteira" = "documento" ] && exit 0
chaves="$(PLATAFIRMA_VENVS="$VENVS_CLONE" python3 "$REGISTRO" --familia "$REPO" 2>/dev/null | awk -F'\t' '$3 != ""' | wc -l)"
if [ "${chaves:-0}" -eq 0 ]; then
  printf 'pre-push: %s sem chave de teste no registro — não medido, deixando passar.\n' "$REPO" >&2
  exit 0
fi

# A REV A JULGAR vem do stdin do hook: "<local_ref> <local_oid> <remote_ref> <remote_oid>".
# TODA linha e uma ref empurrada (A4). local_oid todo-zero e delecao de ref: nao ha
# arvore a medir. stdin vazio (invocacao a mao) cai no HEAD.
# card #3370: a BASE de cada ref e o remote_oid (o que o servidor ja tem); ref nova (remote_oid
# todo-zero) mede contra origin/main. O teste roda so o que o diff da base alcanca; base que
# nao resolve, ou chamada a mao sem stdin, roda a lista inteira.
REFS=(); BASES=()
while read -r _ local_oid _ remote_oid; do
  case "$local_oid" in
    ''|*[!0-9a-f]*) continue ;;
    0000000000000000000000000000000000000000) continue ;;
  esac
  case "$remote_oid" in
    0000000000000000000000000000000000000000) remote_oid="origin/main" ;;
    *[!0-9a-f]*) remote_oid="" ;;
  esac
  REFS+=("$local_oid"); BASES+=("${remote_oid:-}")
done
if [ "${#REFS[@]}" -eq 0 ]; then
  h="$(git rev-parse --verify HEAD 2>/dev/null)" && [ -n "$h" ] && { REFS+=("$h"); BASES+=(""); }
fi
[ "${#REFS[@]}" -gt 0 ] || exit 0

TMP="$(mktemp -d "$ARVORES_DIR/pre-push.XXXXXX" 2>/dev/null || mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")" || exit 0
limpa() {
  local d
  for d in "$TMP"/arvore-*; do
    [ -d "$d" ] || continue
    git worktree remove --force "$d" >/dev/null 2>&1 || true
  done
  git worktree prune >/dev/null 2>&1
  rm -rf "$TMP"
}
trap limpa EXIT

# Mede UMA rev: 0 verde (ou reaproveitado verde), 1 vermelho real (barra o push),
# 3 não medido (ambiente/coleta/timeout/lista — avisa e deixa passar, nunca barra).
medir_rev() {  # $1=rev $2=base (vazio: lista inteira)
  local rev="$1" base="${2:-}"
  local arvore="$TMP/arvore-${rev:0:12}" log="$TMP/git-${rev:0:12}.txt"

  if ! git worktree add --detach --no-checkout "$arvore" "$rev" >"$log" 2>&1; then
    printf 'pre-push: não consegui isolar a rev %s — não medido, deixando passar.\n' "$rev" >&2
    tail -n 5 "$log" >&2
    return 3
  fi
  if ! git -C "$arvore" checkout --quiet --detach "$rev" >>"$log" 2>&1; then
    printf 'pre-push: não consegui materializar a rev %s — não medido, deixando passar.\n' "$rev" >&2
    tail -n 5 "$log" >&2
    return 3
  fi

  local venvs; venvs="$(venvs_de "$arvore")"
  local teste_bin="$AQUI/../bin/teste"
  local saida="$TMP/teste-${rev:0:12}.txt" rc_teste=0
  PLATAFIRMA_VENVS="$venvs" "$teste_bin" rodar "$REPO" --portao --arvore "$arvore" ${base:+--base "$base"} >"$saida" 2>&1 || rc_teste=$?

  local chaves_id
  chaves_id="$(grep -oE 'chave [A-Za-z0-9._-]+-[0-9a-f]{12}' "$saida" | sed 's/^chave //' | sort -u | tr '\n' ' ')"
  chaves_id="${chaves_id% }"
  [ -n "$chaves_id" ] || chaves_id="$REPO"

  case "$rc_teste" in
    0)
      if grep -q "veredito reaproveitado" "$saida" && ! grep -qE '^suite VERDE: .* — [0-9]+ passed' "$saida"; then
        printf 'pre-push: baseline de contrato — %s reaproveitado / reaproveitou (%s, verde)\n' "$chaves_id" "${rev:0:7}"
      else
        printf 'pre-push: baseline de contrato verde em %s (%s, rodou)\n' "${rev:0:7}" "$chaves_id"
      fi
      # card #3370: o push diz o que mediu (raio total ou quantos arquivos da lista rodaram)
      grep -hE '^(raio total|seleção):' "$saida" | sort -u | sed 's/^/pre-push: /' >&2 || true
      return 0 ;;
    1)
      if grep -q "veredito reaproveitado" "$saida" && ! grep -qE '^[[:space:]]*reprovado:' "$saida"; then
        printf 'pre-push: BASELINE VERDE QUEBROU na rev %s — veredito reaproveitado (%s, mesma árvore já medida vermelha).\n' "${rev:0:7}" "$chaves_id" >&2
      else
        {
          echo
          printf 'pre-push: BASELINE VERDE QUEBROU na rev %s — push barrado.\n' "${rev:0:7}"
          grep -E '^(portao |suite VERMELHA)' "$saida" | sed 's/^/  /'
          grep -E '^[[:space:]]*reprovado:' "$saida" | sed 's/^/  /'
          echo
          printf '  medido em worktree limpo da rev empurrada (%s), não no seu clone.\n' "$chaves_id"
          grep -E '^[[:space:]]*saida inteira:' "$saida" | sed 's/^[[:space:]]*//'
          printf '  as listas do baseline: a lista de portão de cada subárvore de teste (arq:0116 §5)\n'
        } >&2
      fi
      return 1 ;;
    *)
      printf 'pre-push: teste rodar saiu %s medindo %s (%s) — não medido, deixando passar.\n' \
        "$rc_teste" "${rev:0:7}" "$REPO" >&2
      cat "$saida" >&2
      return 3 ;;
  esac
}

FALHOU=0
for i in "${!REFS[@]}"; do
  rev="${REFS[$i]}"
  rc=0
  medir_rev "$rev" "${BASES[$i]}" || rc=$?
  [ "$rc" -eq 1 ] && FALHOU=1
done

[ "$FALHOU" -eq 0 ] || exit 1
exit 0
