#!/usr/bin/env bash
# pre-push — a suite de contrato ganha GATILHO.
#
# capacidade: orfa
# dono: claudinho-TI
#
# POR QUE EXISTE (card #204 item 2): a suite so rodava se alguem digitasse, e sete
# dos oito arquivos estavam parados desde 10-11/08. Nao ha CI neste repo. Teste sem
# gatilho nao e rede de seguranca: e arquivo que apodrece ate virar ruido — foi
# exatamente o que aconteceu com o contrato do monta-sessao, 17 vermelhos por dias.
#
# BASELINE VERDE, e nao a suite inteira. Gate que nasce vermelho por falha que ja
# existia e gate que alguem desliga na primeira vez. Entao ele julga so o que esta
# verde HOJE, listado em `controle/tests/VERDES`, e arquivo consertado ENTRA na lista
# no mesmo commit que o conserta. A lista so cresce.
#
# JULGA A REV EMPURRADA, NAO O WORKING TREE (achado de claudinha-gestao-estrategica,
# 04/09/2026). O clone da pasta de trabalho da conta era COMPARTILHADO entre
# cadeiras: quando alguem esta com bin/monta-sessao modificado e nao commitado, quem
# commita em abertura/ paga o vermelho alheio. Entao: worktree descartavel na rev
# que o git esta empurrando, medida la, remocao no trap. O estado sujo do clone
# deixa de ter voto. O REGISTRO DE VENVS TAMBEM VEM DA ARVORE EMPURRADA, pelo mesmo
# motivo — nao do clone de quem esta empurrando.
#
# NAO TRAVA POR AMBIENTE. Ambiente que nao constroi, ou pytest que nem coleta, nao
# vira "BASELINE VERDE QUEBROU": avisa e deixa passar. Bloqueia so quando MEDIU e o
# teste falhou de verdade (card #3150, comentário A2 — antes, qualquer exit != 0 do
# pytest era tratado como vermelho, inclusive uso/coleta/timeout).
#
# card #3150, comentário A: o mesmo construtor e a MESMA chave <nome>-hash(lock+
# python) que release/teste usam (lib/venv.sh + bin/_release/registro.py) — nunca
# mais uvx --with redis isolado. Veredito gravado e reaproveitado por (hash da
# árvore, chave) — o MESMO arquivo que o gate de `release promover` lê e grava
# (lib/venv.sh: caminho_veredito/ler_veredito/gravar_veredito), então uma rev já
# medida aqui não roda a suíte de novo na promoção. Toda ref empurrada é medida,
# não só a primeira (A4).
#
# `uv run --python <venv> --with pytest pytest`, nao o python do venv direto: o
# venv da chave (construir_venv) so instala o que o LOCK declara — "acervo" so tem
# boto3, por exemplo — e pytest e ferramenta de quem mede, nao dependencia do
# projeto. --with pytest injeta na hora, sem gravar no venv (mesma convencao de
# `teste rodar --chave`, bin/teste).
#
# CHAVE fixa em "harness" porque hoje NENHUM arquivo de VERDES precisa de outro
# venv (nenhum importa boto3, que é o que distingue a chave "acervo"). Arquivo que
# precisar de outra chave é trabalho novo, nomeado, não resolvido aqui.
set -uo pipefail

# O PROPRIO GIT injeta GIT_DIR/GIT_WORK_TREE (e primos) no ambiente deste hook — apontam
# pro repositorio que disparou o push. Sem limpar, qualquer `git init`/`git commit` de
# fixture DENTRO da suite (repo descartavel em tmp_path) herda essas variaveis via
# subprocess e a escrita "descartavel" cai no repositorio REAL — medido: suite verde
# rodada a mao, commit fantasma no branch de quem empurrou rodada daqui de dentro.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR       GIT_CEILING_DIRECTORIES

RAIZ="$(git rev-parse --show-toplevel)"
LISTA="$RAIZ/controle/tests/VERDES"
AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

[ -r "$LISTA" ] || exit 0

# shellcheck source=../lib/raizes.sh
. "$AQUI/../lib/raizes.sh"
# shellcheck source=../lib/venv.sh
. "$AQUI/../lib/venv.sh"
PF_VENV_PREFIXO="pre-push"

REGISTRO="$AQUI/../bin/_release/registro.py"
CHAVE="harness"
VEREDITOS_DIR="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/pre-push/vereditos"
mkdir -p "$VEREDITOS_DIR" 2>/dev/null || true

# ALVOS como array (A5), lidos de controle/tests/VERDES pelo leitor compartilhado
# (lib/venv.sh: listar_verdes) — mesmo shellcheck SC2086 que string sem aspas dava.
ARQUIVOS=()
while IFS= read -r linha; do
  ARQUIVOS+=("$linha")
done < <(listar_verdes "$RAIZ")
[ "${#ARQUIVOS[@]}" -gt 0 ] || exit 0

# A REV A JULGAR vem do stdin do hook: "<local_ref> <local_oid> <remote_ref> <remote_oid>".
# TODA linha e uma ref empurrada (A4 — o laço antigo pegava só a primeira e dava
# break). local_oid todo-zero e delecao de ref: nao ha arvore a medir. stdin vazio
# (invocacao a mao) cai no HEAD.
REFS=()
while read -r _ local_oid _ _; do
  case "$local_oid" in
    ''|*[!0-9a-f]*) continue ;;
    0000000000000000000000000000000000000000) continue ;;
  esac
  REFS+=("$local_oid")
done
if [ "${#REFS[@]}" -eq 0 ]; then
  h="$(git rev-parse --verify HEAD 2>/dev/null)" && [ -n "$h" ] && REFS+=("$h")
fi
[ "${#REFS[@]}" -gt 0 ] || exit 0

TMP="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")" || exit 0
limpa() {
  local d
  for d in "$TMP"/arvore-*; do
    [ -d "$d" ] || continue
    git worktree remove --force "$d" >/dev/null 2>&1 || true
  done
  git worktree prune >/dev/null 2>&1
  rm -rf "$TMP"
}
trap limpa EXIT

# Mede UMA rev: 0 verde (ou reaproveitado verde), 1 vermelho real (barra o push),
# 3 não medido (ambiente/coleta/timeout — avisa e deixa passar, nunca barra).
medir_rev() {  # $1=rev
  local rev="$1"
  local arvore="$TMP/arvore-${rev:0:12}" log="$TMP/git-${rev:0:12}.txt"  # "local a=$1 b=...$a" nao ve o $a recem-declarado: outro local

  if ! git worktree add --detach --no-checkout "$arvore" "$rev" >"$log" 2>&1; then
    printf 'pre-push: não consegui isolar a rev %s — não medido, deixando passar.\n' "$rev" >&2
    tail -n 5 "$log" >&2
    return 3
  fi
  if ! git -C "$arvore" checkout --quiet --detach "$rev" >>"$log" 2>&1; then
    printf 'pre-push: não consegui materializar a rev %s — não medido, deixando passar.\n' "$rev" >&2
    tail -n 5 "$log" >&2
    return 3
  fi

  local alvos=() arq
  for arq in "${ARQUIVOS[@]}"; do
    [ -f "$arvore/controle/$arq" ] && alvos+=("$arq")
  done
  # VERDES que aponta arquivo sumido e baseline que ninguem mede: aqui avisa (politica A2
  # do pre-push); o gate de `release promover` barra com 5 a mesma arvore.
  local sumidos; sumidos="$(verdes_ausentes "$arvore" | tr '\n' ' ')"
  if [ -n "${sumidos// /}" ]; then
    printf 'pre-push: AVISO — controle/tests/VERDES lista arquivo que nao existe na rev %s: %s(o gate da promocao vai barrar)\n' \
      "${rev:0:7}" "$sumidos" >&2
  fi
  [ "${#alvos[@]}" -gt 0 ] || return 0

  local arvore_hash
  arvore_hash="$(git -C "$arvore" rev-parse "${rev}^{tree}" 2>/dev/null)"
  [ -n "$arvore_hash" ] || { printf 'pre-push: não consegui medir a árvore de %s — não medido.\n' "$rev" >&2; return 3; }

  # o registro vem da PROPRIA arvore empurrada (mesma regra do "julga a rev
  # empurrada"), nunca do clone de quem esta empurrando; override so por env
  # explicita (PLATAFIRMA_VENVS), do mesmo jeito que release/teste aceitam.
  local venvs="${PLATAFIRMA_VENVS:-$arvore/registro/venvs.json}"
  local teste_bin="$AQUI/../bin/teste"
  local saida="$TMP/teste-${rev:0:12}.txt" rc_teste=0
  PLATAFIRMA_VENVS="$venvs" "$teste_bin" rodar "$CHAVE" --portao --arvore "$arvore" >"$saida" 2>&1 || rc_teste=$?

  local chave_id="$CHAVE"
  local achou_chave
  achou_chave="$(grep -oE "$CHAVE-[0-9a-f]{12}" "$saida" | head -n 1)"
  [ -n "$achou_chave" ] && chave_id="$achou_chave"

  case "$rc_teste" in
    0)
      if grep -q "reaproveitado" "$saida"; then
        printf 'pre-push: baseline de contrato — %s reaproveitado / reaproveitou (%s, verde)\n' "$chave_id" "${rev:0:7}"
      else
        printf 'pre-push: baseline de contrato verde em %s (%s, rodou)\n' "${rev:0:7}" "$chave_id"
      fi
      return 0 ;;
    1)
      if grep -q "reaproveitado" "$saida"; then
        printf 'pre-push: BASELINE VERDE QUEBROU na rev %s — veredito reaproveitado (%s, mesma árvore já medida vermelha).\n' "${rev:0:7}" "$chave_id" >&2
      else
        {
          echo
          printf 'pre-push: BASELINE VERDE QUEBROU na rev %s — push barrado.\n' "${rev:0:7}"
          grep -E '^[[:space:]]*reprovado:' "$saida" | sed 's/^/  /'
          echo
          printf '  medido em worktree limpo da rev empurrada (%s), não no seu clone.\n' "$chave_id"
          grep -E '^[[:space:]]*saida inteira:' "$saida" | sed 's/^[[:space:]]*//'
          printf '  a lista do baseline: controle/tests/VERDES\n'
        } >&2
      fi
      return 1 ;;
    *)
      printf 'pre-push: teste rodar saiu %s medindo %s (%s) — não medido, deixando passar.\n' \
        "$rc_teste" "${rev:0:7}" "$CHAVE" >&2
      cat "$saida" >&2
      return 3 ;;
  esac
}

FALHOU=0
for rev in "${REFS[@]}"; do
  rc=0
  medir_rev "$rev" || rc=$?
  [ "$rc" -eq 1 ] && FALHOU=1
done

[ "$FALHOU" -eq 0 ] || exit 1
exit 0
