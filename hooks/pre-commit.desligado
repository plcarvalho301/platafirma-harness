#!/bin/sh
# pre-commit — barra o que arq:0042 nao admite no repositorio, antes de entrar.
# capacidade: verificacao
# dono: claudinho-TI
#
# A regua NAO mora aqui: mora em `conferir repo`, `conferir superficie` e
# `conferir arranque`, e este hook as chama com --staged.
# Gate e conferencia que leem reguas diferentes divergem em silencio no primeiro
# ajuste que so um dos dois receber.
#
# Instalacao (por clone, uma vez):
#   git -C <clone> config core.hooksPath /home/claudinho/AI/platafirma-harness/hooks
#
# Limite declarado: hook e local e `git commit --no-verify` passa por cima. Nao ha
# gate no push do forge — quem burla aqui entra no repo remoto sem ser visto.

CONFERIR="${CONFERIR:-$HOME/AI/bin/conferir}"

[ -x "$CONFERIR" ] || {
    echo "pre-commit: 'conferir' nao encontrado em $CONFERIR — commit segue sem gate." >&2
    exit 0
}

"$CONFERIR" repo --staged || exit 1

# Equalizacao de superficie: texto que a fita carrega nao pode nomear tool que so
# existe no meio MCP. INCREMENTAL de proposito — julga so o que o commit
# acrescenta. O passivo herdado nao trava a casa; gate que reprova o que ja
# estava la vira `--no-verify` por habito, e ai nao gateia mais nada.
"$CONFERIR" superficie --staged || exit 1

# Texto de arranque em cwd e PONTEIRO para conduta/arranque.md, nunca copia. Mesma
# estrategia incremental: julga so o CLAUDE.md que ESTE commit acrescenta ou
# altera. As 12 copias herdadas em worktree de branch aparecem em `conferir
# arranque` (sem --staged) e se consertam por commit no branch de cada uma —
# reprovar aqui o passivo alheio so ensinaria `--no-verify`.
exec "$CONFERIR" arranque --staged
