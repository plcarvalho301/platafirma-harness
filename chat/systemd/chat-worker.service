[Unit]
# Lado verbo do giro da recepcao (card 458). O lado Matrix e o container
# chat-recepcao, e as duas pecas so se falam pelo journal SQLite do bind mount.
#
# Codigo da release, estado da instancia (card #3010): instala-se por symlink
# ~/.local/share/systemd/user/chat-worker.service -> este arquivo na release. Nada
# aqui cria diretorio: var/run/chat e var/fitas nascem no bootstrap do host, e se
# faltarem o worker falha alto em vez de recriar estado vazio em silencio.
Description=Worker do chat — lado verbo do giro da recepcao
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/platafirma/current/harness/chat
Environment=PLATAFIRMA_INSTANCIA=/srv/platafirma/casa
# systemd --user NAO le .bashrc nem .profile: sem esta linha o worker nao acha o
# verbo (/opt/platafirma/current/harness/bin) e o giro morre com "verbo nao esta no
# PATH". Pegadinha ja paga pelo longjob. So caminho da release e do sistema (desenho
# #3010 §5): o `claude` que o giro invoca e resolvido pelo proprio bin/chat.
Environment=PATH=/opt/platafirma/current/harness/bin:/usr/local/bin:/usr/bin:/bin
# Mesmo caminho que o override da instancia da ao chat-recepcao (journal compartilhado).
Environment=CHAT_JOURNAL=/srv/platafirma/casa/var/run/chat/journal.db
# Interpretador do venv harness da release (construido do venvs/harness/uv.lock na
# promocao): psycopg de chat/comum/giro.py vem dele, nunca do python do sistema.
ExecStart=/opt/platafirma/current/venv/harness/bin/python /opt/platafirma/current/harness/chat/worker/worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
