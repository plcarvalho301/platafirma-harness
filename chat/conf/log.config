# Log do Synapse para stdout — quem coleta e o daemon, e quem le e `deploy chat logs`.
version: 1

formatters:
  precisao:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: precisao

loggers:
  synapse.storage.SQL:
    level: INFO
  # O registro do Application Service sai deste logger, no startup: e a prova do
  # aceite 4 do card 447.
  synapse.config.appservice:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
