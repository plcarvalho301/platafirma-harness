# Segredos que o compose precisa ler no HOST (o container nao alcanca o cofre 700 com
# uid proprio). Este arquivo e exemplo; o real e .env, 600, fora do git, gerado por
# ./prepara.sh a partir de ~/AI/var/secrets/matrix/.
PG_PASSWORD=<senha do banco da stack, do cofre>
AS_TOKEN=<as_token, do cofre>
HS_TOKEN=<hs_token, do cofre>
