# Variaveis que o compose interpola no HOST (o container nao alcanca o cofre 700 com
# uid proprio). Este arquivo e exemplo e NAO vira .env na arvore: cada variavel mora num
# arquivo em /srv/platafirma/casa/segredos/chat/<NOME> (600), cunhado por ./prepara.sh a
# partir do cofre /srv/platafirma/casa/segredos/matrix/, e o `deploy` materializa o
# --env-file em tmpfs na subida e o apaga depois.
PG_PASSWORD=<senha do banco da stack, do cofre>
AS_TOKEN=<as_token, do cofre>
HS_TOKEN=<hs_token, do cofre>
