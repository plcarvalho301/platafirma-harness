MODOS = ("varrer", "revisar", "avaliar", "testar", "executar", "consultar", "vigiar", "pesquisar", "parecer")
LIGACOES = ("consultado", "delegado", "agendado")
FAMILIAS = ("claude", "gemini", "qwen")
PERNAS = ("fonte_de_fora", "dado_pessoal", "muda_estado")
PROIBIDAS = ("Bash", "Write", "Edit", "NotebookEdit")      # o posto já nega (spec agente §2)
# Fora do agente rodado: abrir sub-agente ou Workflow de dentro do `claude -p` escapa do modelo e do teto da
# declaração (o Workflow herda o modelo da sessão, incidente #3227) e o hook do posto não alcança, porque o
# agente não roda no clone do posto. Medido em 16/10/2026: o consultor listou Agent e Workflow no contexto.
FORA_DO_AGENTE = ("Agent", "Workflow")
REGUA_ESPECIES = ("lista-de-verificacao", "padrao")
MODOS_COM_REGUA = ("revisar", "avaliar")
CONTAS_SEGREGADAS = ("jaiminho", "quinzinho")              # as que `seg isolacao medir` mede
CABECALHO_GERADO = "# GERADO por agente — não editar"
# A porta (incidente #3223, ordem do dono 01/10/2026): o agente declara tools com o MESMO nome que o conector
# publica à cadeira, escopadas pelo agente, e abre a sessão pela mesma tool (`monta_sessao`).
PORTA = "mcp__claudinho-mcp__"
PORTA_BASE = ("malote", "run_command", "ler_arquivo", "read_file", "write_file", "monta_sessao")   # as que a porta publica fora do ferramental
ABRE = PORTA + "monta_sessao"
# A mesma porta chega com outro prefixo conforme a superfície (#3255): o Code CLI publica o conector do claude.ai
# como `claude_ai_claudinho-mcp`, e o Code Desktop pelo uuid do conector (medido 03/10/2026 no posto). A declaração
# segue com o nome canônico (PORTA); a projeção lista cada tool de porta nas três grafias, e o Code dá ao
# subagente as que existem na superfície. Conector recriado no claude.ai troca o uuid: a linha muda aqui.
GRAFIAS = (PORTA, "mcp__claude_ai_claudinho-mcp__", "mcp__f40dcc0d-abeb-4254-8b3d-34d33a57565d__")
# Alcançam todo verbo: o agente perderia o escopo da declaração. `run_command` é apelido de
# `malote` (#3270); os dois nomes ficam de fora, senão o apelido vira a porta dos fundos. Em
# TODAS as grafias: comparar só a canônica deixava `mcp__claude_ai_claudinho-mcp__run_command` e
# a grafia por uuid passarem, porque nem `grafias()` nem `fora_do_conector` olham outro prefixo.
SEM_ESCOPO = tuple(g + nome for g in GRAFIAS for nome in ("malote", "run_command"))

def grafias(tool: str) -> list[str]:
    """A tool de porta em todas as grafias da superfície; qualquer outra tool passa como veio."""
    if not tool.startswith(PORTA):
        return [tool]
    nome = tool[len(PORTA):]
    return [g + nome for g in GRAFIAS]
OLLAMA_URL = os.environ.get("OLLAMA_BASE_URL", "http://localhost:11434")


# --- a declaração ---------------------------------------------------------------------------

def conta_do_modelo(modelo: dict) -> str:
    """O modelo fixa a conta unix (spec agente §2): Claude, Gemini e Qwen local sob claudinho, Qwen de
    fronteira sob quinzinho. Gemini saiu de jaiminho por ordem do dono (02/11/2026, #4093): roda na conta de
    produção com o login dele, como os agentes Claude, porque não escreve e o raio do agente é curto."""
    familia = modelo.get("familia")
    if familia == "qwen" and not modelo.get("local"):
        return "quinzinho"
    return "claudinho"


def provedor(modelo: dict) -> str:
    """Quem lê o contexto. `host` é o ollama local; o resto sai do host."""
    familia = modelo.get("familia")
    if familia == "qwen":
        return "host" if modelo.get("local") else "qwen-fronteira"
    return str(familia)


def familia_de(decl) -> str | None:
    """A família do modelo de uma declaração, ou None se ela não for um mapa com modelo."""
    m = decl.get("modelo") if isinstance(decl, dict) else None
    return m.get("familia") if isinstance(m, dict) else None


SOBRESCREVE = ("modelo", "ferramentas", "teto")             # o que varia pela ligação (spec agente §2, rev 3)
EMBUTIDOS = ("Explore", "Plan")                             # sub-agentes do Code que um agente de projeto pode suplantar

def efetiva(decl, ligacao: str):
    """A declaração como roda naquela ligação: `por_ligacao.<ligação>` sobrescreve modelo, ferramentas e teto;
    o resto vale para todas (spec agente §2, rev 3)."""
    if not isinstance(decl, dict):
        return decl
    pl = decl.get("por_ligacao")
    extra = pl.get(ligacao) if isinstance(pl, dict) else None
    if not isinstance(extra, dict):
        return decl
    return {**decl, **{k: extra[k] for k in SOBRESCREVE if k in extra}}

def tem_projecao(decl) -> bool:
    """Ganha `.claude/agents` o agente que roda em Claude na execução delegada: a base, ou o
    `por_ligacao.delegado` quando houver (spec agente §3). Consultor e curador, Claude só consultados,
    seguem projetados como antes."""
    return isinstance(decl, dict) and not sem_lente(decl) and familia_de(efetiva(decl, "delegado")) == "claude"

def delega_em_claude(decl) -> bool:
    return (tem_projecao(decl) and isinstance(decl.get("ligacoes"), list) and "delegado" in decl["ligacoes"])

def _texto(v) -> bool:
    return isinstance(v, str) and bool(v.strip())

def _valida_execucao(d: dict, pre: str) -> list[str]:
    """Modelo, ferramentas e teto de uma execução: a base, ou a base sobrescrita por uma ligação."""
    p: list[str] = []
    modelo = d.get("modelo")
    if not (isinstance(modelo, dict) and modelo.get("familia") in FAMILIAS and _texto(modelo.get("versao"))):
        p.append(f"{pre}modelo: familia ({', '.join(FAMILIAS)}) e versao")
    ferr = d.get("ferramentas")
    if not (isinstance(ferr, list) and all(_texto(f) for f in ferr)):
        p.append(f"{pre}ferramentas: lista de nomes de tool (pode ser vazia)")
    else:
        for f in ferr:
            if f in PROIBIDAS:
                p.append(f"{pre}ferramenta proibida: {f}")
            elif f in SEM_ESCOPO:
                p.append(f"{pre}ferramenta sem escopo: {f} alcança todo verbo; declare as tools de verbo do agente")
    teto = d.get("teto")
    chaves = ["turnos", "tokens_execucao", "tokens_janela"]
    if isinstance(modelo, dict) and modelo.get("familia") == "qwen" and modelo.get("local"):
        chaves += ["num_ctx", "vram_max_mib", "prompt_eval_count_max"]
    if not (isinstance(teto, dict) and all(isinstance(teto.get(k), int) and not isinstance(teto.get(k), bool)
                                           and teto.get(k) > 0 for k in chaves)):
        p.append(f"{pre}teto: {', '.join(chaves)}, inteiros positivos")
    return p


def valida(decl, stem: str) -> list[str]:
    """Problemas de uma declaração, cada um uma frase. Lista vazia = no molde."""
    if not isinstance(decl, dict):
        return ["a declaração não é um mapa YAML"]
    p: list[str] = []
    slug = decl.get("slug")
    if not (isinstance(slug, str) and re.fullmatch(r"[a-z][a-z0-9-]*", slug)):
        p.append("slug ausente ou fora de [a-z][a-z0-9-]*")
    elif slug != stem:
        p.append(f"slug {slug!r} difere do nome do arquivo {stem!r}")
    desc = decl.get("descricao")
    if not _texto(desc) or "\n" in desc.strip():
        p.append("descricao: uma linha que o orquestrador lê para escolher")
    dono = decl.get("dono")
    if not (isinstance(dono, dict) and _texto(dono.get("cadeira"))):
        p.append("dono: precisa de cadeira (e chapeu)")
    elif dono["cadeira"] != "{cadeira}" and not _texto(dono.get("chapeu")):
        p.append("dono.chapeu: obrigatório quando a cadeira é fixa")
    if decl.get("modo") not in MODOS:
        p.append(f"modo: um de {', '.join(MODOS)}")
    p += _valida_execucao(decl, "")
    if "pecas" in decl and decl["pecas"] != []:
        p.append("pecas: só `[]` (sem lente) por ora; a lente toda é a ausência do campo")
    elif sem_lente(decl) and any(isinstance(f, str) and f.startswith("mcp__") for f in (decl.get("ferramentas") or [])):
        p.append("ferramentas: o agente sem lente sobe sem a porta; declare só as embutidas (Read, Grep, Glob)")
    pernas = decl.get("pernas")
    if not (isinstance(pernas, dict) and all(isinstance(pernas.get(k), bool) for k in PERNAS)):
        p.append(f"pernas: {', '.join(PERNAS)}, cada uma true ou false")
    else:
        if all(pernas[k] for k in PERNAS):
            p.append("pernas: as três juntas não sobem sem aprovação humana no fecho (spec agente §7)")
        elif pernas["fonte_de_fora"] and pernas["dado_pessoal"]:
            p.append("pernas: fonte de fora e dado pessoal juntos (spec agente §7)")
    regua = decl.get("regua")
    if regua is not None:
        partes = regua.split() if isinstance(regua, str) else []
        if len(partes) != 2 or partes[0] not in REGUA_ESPECIES:
            p.append(f"regua: '<espécie> <chave>' com espécie {' ou '.join(REGUA_ESPECIES)}")
        elif decl.get("modo") not in MODOS_COM_REGUA:
            p.append("regua: só nos modos revisar e avaliar")
    fecho = decl.get("fecho")
    if not (isinstance(fecho, dict) and all(_texto(fecho.get(k)) for k in ("comeca_com", "termina_com", "recebe"))):
        p.append("fecho: comeca_com, termina_com e recebe")
    lig = decl.get("ligacoes")
    if not (isinstance(lig, list) and lig and all(x in LIGACOES for x in lig)):
        p.append(f"ligacoes: uma ou mais de {', '.join(LIGACOES)}")
    elif "delegado" in lig and familia_de(efetiva(decl, "delegado")) != "claude":
        p.append("ligacoes: delegado só existe para modelo Claude (o arquivo de agente do Code não descreve outro)")
    pl = decl.get("por_ligacao")
    if pl is not None:
        if not (isinstance(pl, dict) and pl and all(k in LIGACOES for k in pl)
                and all(isinstance(v, dict) and v and set(v) <= set(SOBRESCREVE) for v in pl.values())):
            p.append(f"por_ligacao: mapa de {', '.join(LIGACOES)} para {', '.join(SOBRESCREVE)}")
        else:
            for k in pl:
                if not (isinstance(lig, list) and k in lig):
                    p.append(f"por_ligacao.{k}: a ligação não está em ligacoes")
                p += _valida_execucao(efetiva(decl, k), f"por_ligacao.{k}: ")
    if tem_projecao(decl):
        ferr_proj = efetiva(decl, "delegado").get("ferramentas")
        if isinstance(ferr_proj, list) and ferr_proj and ABRE not in ferr_proj:
            p.append(f"ferramentas da projeção: falta {ABRE}, a tool com que o agente abre a sessão (a mesma da cadeira)")
    sup = decl.get("suplanta")
    if sup is not None:
        if sup not in EMBUTIDOS:
            p.append(f"suplanta: um de {', '.join(EMBUTIDOS)}")
        elif not delega_em_claude(decl):
            p.append("suplanta: só vale com a ligação delegada em Claude (spec agente §3)")
    return p


def posto_dir() -> Path:
    v = os.environ.get("PF_POSTO", "").strip()
    return Path(v) if v else raizes.bancada() / "platafirma-posto"


def carrega(posto: Path) -> tuple[dict, dict]:
    """(declarações válidas e inválidas por slug, problemas por arquivo). Só lê."""
    decls: dict[str, dict] = {}
    problemas: dict[str, list[str]] = {}
    pasta = posto / "agentes"
    for arq in sorted(pasta.glob("*.yaml")) if pasta.is_dir() else []:
        try:
            decl = yaml.safe_load(arq.read_text(encoding="utf-8"))
        except (yaml.YAMLError, OSError) as e:
            problemas[arq.stem] = [f"não lê: {type(e).__name__}"]
            continue
        achados = valida(decl, arq.stem)
        if achados:
            problemas[arq.stem] = achados
        if isinstance(decl, dict):
            decls[arq.stem] = decl
    return decls, problemas


# --- a projeção (Claude) --------------------------------------------------------------------

def projecao_claude(decl: dict) -> str:
    """O `.claude/agents/<slug>.md` da declaração. Determinístico: o --conferir compara byte a byte."""
    slug, dono, modo = decl["slug"], decl["dono"], decl["modo"]
    exe = efetiva(decl, "delegado")                      # a projeção é a ligação delegada (spec agente §3)
    nome = decl.get("suplanta") or slug
    chapeu = dono.get("chapeu") or "<chapeu>"
    cadeira = dono["cadeira"]
    fixa = cadeira != "{cadeira}"
    regua = decl.get("regua")
    fecho = decl["fecho"]
    args = [f'cadeira="{cadeira}"' if fixa else "cadeira=<a cadeira que a delegação nomeia>",
            f'chapeu="{chapeu}"' if dono.get("chapeu") else "chapeu=<o chapéu que a delegação nomeia>",
            'perfil="cadeirinha"', f'modo="{modo}"']
    if regua:
        args.append(f'regua="{regua}"')
    args += [f'agente="{slug}"', "origem=<o sessao_id que a delegação trouxe>",
             "pergunta=<a mensagem de delegação, literal>"]
    abrir = ", ".join(f"`{a}`" for a in args)
    lente = f"a lente da cadeira `{cadeira}`, chapéu `{chapeu}`" if fixa else "a lente da cadeira que a delegação nomeia"
    linhas = [
        "---",
        f"{CABECALHO_GERADO} (fonte: agentes/{slug}.yaml; regerar: agente projetar)",
        f"name: {nome}",
        f"description: {json.dumps(decl['descricao'].strip(), ensure_ascii=False)}",
        f"model: {exe['modelo']['versao']}",
        f"tools: {', '.join(g for f in exe['ferramentas'] for g in grafias(f))}",
    ]
    if any(f.startswith(PORTA) for f in exe["ferramentas"]):
        linhas.append('mcpServers: ["claudinho-mcp"]')
    linhas.extend([
        f"maxTurns: {exe['teto']['turnos']}",
        "---",
        "",
        f"Você é o agente `{slug}` da caixa de ferramentas da PlataFirma: modo `{modo}`, {lente}. "
        "Não tem conduta nem dono: recebe uma tarefa e devolve um resultado.",
        "",
        "Primeira ação, antes de qualquer outra: abra a sua sessão pela mesma tool da cadeira, `monta_sessao`.",
        "",
        f"1. `monta_sessao` com {abrir}. A sessão é sua, da cadeira do agente, ligada à de quem te chamou.",
        "2. Passe o `sessao_id` que ela devolve em toda chamada de tool seguinte. Leia o pacote devolvido e trabalhe "
        "por ele: a peça `modo` diz o que fazer e o que devolver.",
        "",
        "Se `monta_sessao` ou outra tool da sua lista faltar, ou se `monta_sessao` voltar erro, pare antes do trabalho "
        "e devolva só a lista do que faltou ou o erro.",
        "",
        "Depois do pacote, o fecho:",
        "",
        f"- começa com: {fecho['comeca_com'].strip()}",
        f"- termina com: {fecho['termina_com'].strip()}",
        f"- quem recebe: {fecho['recebe'].strip()}",
        "",
        "Você registra e não publica: em código, abre PR e nunca mescla nem promove.",
        "",
    ])
    return "\n".join(linhas)


def _le_gerado(arq: Path) -> tuple[bool, str]:
    try:
        texto = arq.read_text(encoding="utf-8")
    except OSError:
        return False, ""
    linhas = texto.splitlines()
    return (len(linhas) > 1 and linhas[1].startswith(CABECALHO_GERADO)), texto


def confere_projecoes(posto: Path, decls: dict, problemas: dict) -> list[str]:
    """Divergências entre as declarações e .claude/agents/: órfão, projeção velha, projeção ausente."""
    achados: list[str] = []
    pasta = posto / ".claude" / "agents"
    existentes = {a.stem: a for a in sorted(pasta.glob("*.md"))} if pasta.is_dir() else {}
    for stem, arq in existentes.items():
        gerado, texto = _le_gerado(arq)
        decl = decls.get(stem)
        if not gerado:
            achados.append(f"órfão: .claude/agents/{stem}.md sem o cabeçalho de gerado (editado à mão)")
        elif decl is None or not tem_projecao(decl):
            achados.append(f"órfão: .claude/agents/{stem}.md sem declaração Claude em agentes/{stem}.yaml")
        elif stem not in problemas and texto != projecao_claude(decl):
            achados.append(f"projeção velha: .claude/agents/{stem}.md difere da declaração (agente projetar)")
    for stem, decl in decls.items():
        if stem in problemas or not tem_projecao(decl):
            continue
        if stem not in existentes:
            achados.append(f"projeção ausente: .claude/agents/{stem}.md (agente projetar)")
    return achados


# --- as tools contra o conector (incidente #3223) --------------------------------------------

def tools_do_conector() -> set[str] | None:
    """Os nomes que a porta publica à cadeira: as de base mais uma por verbo do ferramental, pela mesma lista que
    a porta projeta (`acervo listar ferramental --tools`). None quando o acervo não responde."""
    try:
        p = subprocess.run([str(Path(os.environ.get("PF_BIN") or _AQUI) / "acervo"), "listar", "ferramental", "--tools"],
                           capture_output=True, text=True, timeout=60)
        linhas = json.loads(p.stdout) if p.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    if not isinstance(linhas, list):
        return None
    return {PORTA + t for t in PORTA_BASE} | {PORTA + str(l["tool"]) for l in linhas if isinstance(l, dict) and l.get("tool")}


def fora_do_conector(stem: str, decl: dict, conector: set[str]) -> list[str]:
    """Tool de porta declarada que o conector não publica, em qualquer ligação."""
    achados: list[str] = []
    for lig in [None, *(decl.get("por_ligacao") or {})]:
        exe = efetiva(decl, lig) if lig else decl
        for f in exe.get("ferramentas") or []:
            if isinstance(f, str) and f.startswith(PORTA) and f not in conector:
                achados.append(f"fora do conector: agentes/{stem}.yaml{' por_ligacao.' + lig if lig else ''} "
                               f"declara {f}, que a porta não publica")
    return achados


# --- o portão do PR que troca `modelo` (spec agente §11.2) -----------------------------------

def isolacao_conforme(conta: str) -> tuple[bool, str]:
    """A última `seg isolacao medir` que mediu a conta: conforme só se todas as verificações dela deram ok."""
    pasta = raizes.instancia() / "var" / "log" / "seg"
    if not pasta.is_dir():
        return False, "sem medição registrada"
    for arq in sorted(pasta.glob("isolacao-*.jsonl"), reverse=True):
        for linha in reversed(arq.read_text(encoding="utf-8").splitlines()):
            try:
                reg = json.loads(linha)
            except ValueError:
                continue
            ds = [r for r in reg.get("resultados", []) if r.get("conta") == conta]
            if ds:
                ruins = [r for r in ds if r.get("estado") != "ok"]
                if ruins:
                    return False, f"{ruins[0].get('estado')}: {str(ruins[0].get('detalhe', ''))[:90]}"
                return True, ""
    return False, "sem medição registrada"


def portao_da_troca(slug: str, nova: dict, base: dict | None) -> list[str]:
    """Só há troca onde o modelo mudou em relação à base. Agente novo não troca nada."""
    if base is None:
        return []
    m_novo, m_base = nova.get("modelo", {}), base.get("modelo", {})
    if (m_novo.get("familia"), bool(m_novo.get("local"))) == (m_base.get("familia"), bool(m_base.get("local"))):
        return []
    achados: list[str] = []
    conta = conta_do_modelo(m_novo)
    if conta in CONTAS_SEGREGADAS:
        ok, motivo = isolacao_conforme(conta)
        if not ok:
            achados.append(f"caso 1: {slug} passa a rodar sob {conta}, sem isolação conforme na última "
                           f"seg isolacao medir ({motivo})")
    if nova.get("pernas", {}).get("dado_pessoal") and provedor(m_novo) not in ("host", provedor(m_base)):
        achados.append(f"caso 2 — vai ao dono antes do merge: {slug} tem a perna dado pessoal e a troca manda o "
                       f"contexto ao provedor {provedor(m_novo)}, que antes não o recebia")
    return achados


def _git(posto: Path, *args: str) -> tuple[int, str]:
    try:
        p = subprocess.run(["git", "-C", str(posto), *args], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        return 125, str(e)
    return p.returncode, p.stdout


def declaracoes_da_base(posto: Path, ref: str) -> dict | None:
    """As declarações de `ref` (git show), por slug. None se a ref não existe."""
    rc, _ = _git(posto, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
    if rc != 0:
        return None
    rc, nomes = _git(posto, "ls-tree", "--name-only", ref, "agentes/")
    if rc != 0:
        return {}
    base: dict[str, dict] = {}
    for nome in nomes.split():
        if not nome.endswith(".yaml"):
            continue
        rc, texto = _git(posto, "show", f"{ref}:{nome}")
        try:
            decl = yaml.safe_load(texto) if rc == 0 else None
        except yaml.YAMLError:
            decl = None
        if isinstance(decl, dict):
            base[Path(nome).stem] = decl
    return base


# --- atos: listar, ler, projetar ------------------------------------------------------------

def _erro(msg: str, codigo: int) -> int:
    print(f"agente: {msg}", file=sys.stderr)
    return codigo


def _avanca_posto(posto: Path) -> None:
    """O clone do posto segue origin/main (#2856 linha 99): num sha velho, `projetar --conferir` reprovava
    declaração já consertada em main. Só avança o que é seguro: clone git, árvore limpa, destacado ou em
    main, e origin/main à frente (fast-forward). Sem rede, avisa e lê o clone como está."""
    if not (posto / ".git").exists():
        return
    rc, _ = _git(posto, "fetch", "--quiet", "origin", "main")
    if rc != 0:
        print("agente: aviso: não busquei origin/main no posto; leio o clone como está", file=sys.stderr)
        return
    rc_sujo, sujo = _git(posto, "status", "--porcelain")
    rc_ramo, ramo = _git(posto, "rev-parse", "--abbrev-ref", "HEAD")
    ramo = ramo.strip()
    if rc_sujo != 0 or rc_ramo != 0 or sujo.strip() or ramo not in ("HEAD", "main"):
        return
    rc, _ = _git(posto, "merge-base", "--is-ancestor", "HEAD", "origin/main")
    if rc != 0:
        return
    if ramo == "main":
        _git(posto, "merge", "--ff-only", "--quiet", "origin/main")
    else:
        _git(posto, "checkout", "--quiet", "--detach", "origin/main")


def _posto_ou_erro() -> tuple[Path | None, int]:
    try:
        posto = posto_dir()
        _avanca_posto(posto)
        return posto, 0
    except raizes.BancadaNaoDeclarada as e:
        return None, _erro(str(e), 3)


def ato_listar(modelo: str | None, modo: str | None, como_json: bool) -> int:
    posto, rc = _posto_ou_erro()
    if posto is None:
        return rc
    decls, problemas = carrega(posto)
    linhas = []
    for stem, d in decls.items():
        if stem in problemas:
            continue
        if modelo and d["modelo"]["familia"] != modelo:
            continue
        if modo and d["modo"] != modo:
            continue
        linhas.append({"slug": stem, "modo": d["modo"], "modelo": f"{d['modelo']['familia']}:{d['modelo']['versao']}",
                       "ligacoes": d["ligacoes"], "dono": f"{d['dono']['cadeira']}/{d['dono'].get('chapeu') or '-'}"})
    for stem, achados in problemas.items():
        print(f"inválida: agentes/{stem}.yaml — {'; '.join(achados)}", file=sys.stderr)
    if como_json:
        print(json.dumps({"posto": str(posto), "agentes": linhas}, ensure_ascii=False))
    else:
        for l in linhas:
            print(f"{l['slug']:<20} {l['modo']:<10} {l['modelo']:<22} {','.join(l['ligacoes']):<24} {l['dono']}")
    if not linhas:
        return _erro(f"nenhuma declaração{' com esse filtro' if modelo or modo else ''} em {posto}/agentes", 1)
    return 0


def ato_ler(slug: str) -> int:
    posto, rc = _posto_ou_erro()
    if posto is None:
        return rc
    arq = posto / "agentes" / f"{slug}.yaml"
    if not arq.is_file():
        conhecidos = sorted(a.stem for a in (posto / "agentes").glob("*.yaml"))
        print(f"agente: sem declaração {slug!r} em {posto}/agentes", file=sys.stderr)
        parecidos = difflib.get_close_matches(slug, conhecidos, n=3)
        print(f"vizinho: agente ler {parecidos[0]}" if parecidos else "vizinho: agente listar", file=sys.stderr)
        return 1
    sys.stdout.write(arq.read_text(encoding="utf-8"))
    return 0


def ato_projetar(conferir: bool, base_ref: str | None) -> int:
    posto, rc = _posto_ou_erro()
    if posto is None:
        return rc
    if not (posto / "agentes").is_dir():
        return _erro(f"{posto}/agentes não existe", 5 if conferir else 3)
    decls, problemas = carrega(posto)
    achados = [f"declaração inválida: agentes/{s}.yaml — {a}" for s, lista in problemas.items() for a in lista]
    achados += confere_projecoes(posto, decls, problemas)
    avisos: list[str] = []
    conector = tools_do_conector()
    if conector is None:
        avisos.append("acervo listar ferramental --tools não respondeu: as tools não foram conferidas contra o conector")
    else:
        for stem, d in decls.items():
            if stem not in problemas:
                achados += fora_do_conector(stem, d, conector)
    for stem, d in decls.items():
        if d.get("modo") in MODOS_COM_REGUA and not d.get("regua") and stem not in problemas:
            avisos.append(f"{stem}: modo {d['modo']} sem regua; vale a régua do chapéu (modo revisar, «Sem régua servida»)")
    ref = base_ref or "origin/main"
    base = declaracoes_da_base(posto, ref)
    if base is None:
        if base_ref:
            return _erro(f"--base {base_ref!r} não existe em {posto}", 5)
        avisos.append("sem origin/main neste clone: o portão da troca de modelo (§11.2) não foi conferido")
        base = {}
    else:
        for stem, d in decls.items():
            if stem not in problemas:
                achados += portao_da_troca(stem, d, base.get(stem))
    if conferir:
        for a in avisos:
            print(f"aviso: {a}")
        for a in achados:
            print(f"divergente: {a}")
        if not achados:
            print(f"conforme: {len(decls)} declaração(ões), {sum(1 for d in decls.values() if tem_projecao(d))} projeção(ões) Claude")
        return 1 if achados else 0
    if problemas:
        for a in achados:
            print(f"divergente: {a}")
        return _erro("há declaração inválida; nada foi gerado", 1)
    pasta = posto / ".claude" / "agents"
    pasta.mkdir(parents=True, exist_ok=True)
    for stem, d in decls.items():
        if not tem_projecao(d):
            continue
        arq = pasta / f"{stem}.md"
        novo = projecao_claude(d)
        if not arq.exists() or arq.read_text(encoding="utf-8") != novo:
            arq.write_text(novo, encoding="utf-8")
            print(f"gerado: .claude/agents/{stem}.md")
    for arq in sorted(pasta.glob("*.md")):
        gerado, _ = _le_gerado(arq)
        d = decls.get(arq.stem)
        if gerado and (d is None or not tem_projecao(d)):
            arq.unlink()
            print(f"removido: .claude/agents/{arq.name} (declaração aposentada)")
        elif not gerado:
            print(f"divergente: órfão: .claude/agents/{arq.name} sem o cabeçalho de gerado", file=sys.stderr)
            return 1
    for a in avisos:
        print(f"aviso: {a}")
    return 0


# --- ato: rodar ------------------------------------------------------------------------------

class Falha(Exception):
    """`erro` é a primeira linha do erro do CLI, já mascarada, quando a falha veio dele: vai ao registro."""

    def __init__(self, codigo: int, msg: str, erro: str | None = None):
        super().__init__(msg)
        self.codigo, self.msg, self.erro = codigo, msg, erro


def _bin() -> Path:
    return Path(os.environ.get("PF_BIN") or _AQUI)


def carrega_config_federacao() -> dict:
    sobrescreve = os.environ.get("PF_FEDERACAO_CONFIG")
    if sobrescreve:
        try:
            return json.loads(sobrescreve)
        except Exception:
            pass
    caminho = _AQUI.parent / "registro" / "federacao-anthropic.json"
    if caminho.exists():
        try:
            return json.loads(caminho.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def _roda(argv: list[str], stdin: str | None = None, env: dict | None = None, timeout: int = 120,
          cwd: Path | str | None = None, cred: federacao.Credencial | None = None):
    try:
        p = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
            cwd=str(cwd) if cwd else None,
        )
        if cred:
            cred.registra_processo(p)
        try:
            stdout, stderr = p.communicate(input=stdin, timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            stdout, stderr = p.communicate()
            if cred and cred.falha:
                raise Falha(3, cred.falha.motivo)
            raise Falha(5, f"{Path(argv[0]).name}: passou de {timeout}s sem resposta")
        except OSError as e:
            raise Falha(3, f"{Path(argv[0]).name}: não executou ({e})")

        return subprocess.CompletedProcess(argv, p.returncode, stdout, stderr)
    except OSError as e:
        raise Falha(3, f"{Path(argv[0]).name}: não executou ({e})")


def abre_sessao(cadeira: str, origem: str, slug: str, conta: str) -> dict:
    """A sessão filha, com os atributos fixados ANTES de chamar o modelo (spec agente §11.1)."""
    p = _roda([str(_bin() / "sessao"), "abrir", cadeira, "--origem", origem, "--agente", slug,
               "--em-nome-de", cadeira, "--conta", conta, "--json"])
    try:
        obj = json.loads(p.stdout or "{}")
    except ValueError:
        obj = {}
    if p.returncode != 0 or not obj.get("sessao_id"):
        motivo = obj.get("erro") or (p.stderr.strip().splitlines() or ["sem retorno"])[0]
        raise Falha({4: 4, 2: 2}.get(p.returncode, 3), f"sessao abrir {cadeira} saiu {p.returncode}: {motivo}")
    return obj


def le_variantes(specs: list[str] | None) -> dict[str, str | None]:
    """`--peca <nome>=<arquivo>`, uma por peça: o conteúdo do arquivo entra no lugar da peça servida; `<nome>=`
    sem arquivo tira a peça. É o instrumento do par mínimo: os dois braços só diferem na peça trocada."""
    variantes: dict[str, str | None] = {}
    for spec in specs or []:
        nome, sep, caminho = spec.partition("=")
        nome, caminho = nome.strip(), caminho.strip()
        if not sep or not re.fullmatch(r"[a-z][a-z0-9-]*", nome):
            raise Falha(2, f"--peca {spec!r}: a forma é <nome>=<arquivo> (ou <nome>= para tirar a peça)")
        if nome in variantes:
            raise Falha(2, f"--peca {nome}: a mesma peça veio duas vezes")
        if not caminho:
            variantes[nome] = None
            continue
        try:
            texto = Path(caminho).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as e:
            raise Falha(2, f"--peca {nome}: não li {caminho} ({type(e).__name__})")
        if not texto.strip():
            raise Falha(2, f"--peca {nome}: {caminho} está vazio; para tirar a peça use {nome}=")
        variantes[nome] = texto.strip()
    return variantes


def marca_variantes(variantes: dict[str, str | None]) -> dict[str, str]:
    """O que o registro guarda de cada peça trocada: o sha do conteúdo novo, ou `fora` quando ela saiu."""
    import hashlib
    return {n: (hashlib.sha256(t.encode()).hexdigest()[:12] if t is not None else "fora") for n, t in variantes.items()}


def monta_lente(decl: dict, cadeira: str, chapeu: str, filha: dict, origem: str, tarefa: str,
                variantes: dict[str, str | None] | None = None) -> str:
    argv = [str(_bin() / "expediente"), "montar", "--perfil", "cadeirinha", "--chapeu", chapeu,
            "--modo", decl["modo"], "--json"]
    if decl.get("regua"):
        argv += ["--regua", *decl["regua"].split()]
    env = {**os.environ, "PF_CADEIRA": cadeira, "PF_SESSAO": filha["sessao_id"], "PF_ORIGEM_SESSAO": origem,
           "PF_ORDEM_ID": filha.get("ordem_id") or "-"}
    p = _roda(argv, stdin=tarefa, env=env, timeout=180)
    try:
        obj = json.loads(p.stdout or "{}")
    except ValueError:
        obj = {}
    if p.returncode != 0:
        motivo = obj.get("erro") or (p.stderr.strip().splitlines() or ["sem retorno"])[0]
        raise Falha(3, f"a lente não montou (expediente montar saiu {p.returncode}): {motivo[:300]}")
    variantes = variantes or {}
    servidas = [x for x in obj.get("pecas", []) if isinstance(x, dict)]
    faltam = sorted(set(variantes) - {x.get("peca") for x in servidas})
    if faltam:
        raise Falha(2, f"--peca {', '.join(faltam)}: a lente deste agente não tem essa peça; "
                       f"peças servidas: {', '.join(str(x.get('peca')) for x in servidas)}")
    pecas = []
    for x in servidas:
        conteudo = variantes[x["peca"]] if x.get("peca") in variantes else x.get("conteudo")
        if isinstance(conteudo, str) and conteudo.strip():
            pecas.append(conteudo)
    if not pecas:
        raise Falha(3, "a lente voltou sem peça servida")
    return "\n\n---\n\n".join(pecas)


def numera(texto: str) -> str:
    """As linhas do texto com o número na frente (`  3 | ...`). No modo varrer a âncora é o número da linha
    do texto recebido; o Qwen de 9 bilhões copia o número que lê e erra o que conta (medido em 30/09: sem
    numeração as âncoras saíram deslocadas; com ela, 4 de 4 nas duas rodadas)."""
    linhas = texto.splitlines()
    largura = max(3, len(str(len(linhas))))
    return "".join(f"{i:>{largura}} | {l}\n" for i, l in enumerate(linhas, 1))


def _sistema(decl: dict, lente: str) -> str:
    f = decl["fecho"]
    fecho = (f"FECHO do agente `{decl['slug']}`: a resposta começa com {f['comeca_com'].strip()} "
             f"e termina com {f['termina_com'].strip()}. Quem recebe: {f['recebe'].strip()}.")
    return f"{lente}\n\n---\n\n{fecho}" if lente.strip() else fecho      # sem lente, o prompt de sistema é só o fecho


def chama_ollama(decl: dict, sistema: str, tarefa: str) -> dict:
    t, m = decl["teto"], decl["modelo"]
    estimado = (len(sistema) + len(tarefa)) // 3                 # cauda alta: sobra para o lado seguro
    if estimado > t["prompt_eval_count_max"]:
        raise Falha(3, f"a lente mais a tarefa passam do teto (~{estimado} tokens > prompt_eval_count_max "
                       f"{t['prompt_eval_count_max']}); encurte a tarefa")
    pedido = {"model": m["versao"], "stream": False, "think": False,
              "messages": [{"role": "system", "content": sistema}, {"role": "user", "content": tarefa}],
              "options": {"num_ctx": t["num_ctx"], "temperature": 0,
                          # a saída tem teto próprio (`tokens_saida`, padrão 2048): sem ele, um modelo que não pára gera até
                          # o que sobra da janela (13 mil tokens, minutos de placa compartilhada com o embedder)
                          "num_predict": min(t.get("tokens_saida", 2048),
                                             max(256, min(t["tokens_execucao"], t["num_ctx"]) - estimado))}}
    req = urllib.request.Request(f"{OLLAMA_URL}/api/chat", data=json.dumps(pedido).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=t.get("segundos", 600)) as r:
            obj = json.loads(r.read())
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise Falha(3, f"ollama em {OLLAMA_URL} não respondeu: {type(e).__name__}: {e}")
    texto = (obj.get("message") or {}).get("content", "")
    if not texto.strip():
        raise Falha(5, "o modelo devolveu vazio: não se sabe se varreu")
    entrada, saida = obj.get("prompt_eval_count") or 0, obj.get("eval_count") or 0
    aviso = ""
    if entrada > t["prompt_eval_count_max"]:
        aviso = f"prompt_eval_count {entrada} passou de {t['prompt_eval_count_max']}"
    return {"retorno": texto, "uso": {"entrada": entrada, "saida": saida}, "aviso": aviso}


# O ambiente da conta fica fora do agente (#4083), peça a peça, medido no ar em 02/11/2026 com a porta lida primeiro:
#  - CLAUDE_CODE_DISABLE_CLAUDE_MDS=1 no processo tira o ~/.claude/CLAUDE.md da conta, que manda abrir sessão como
#    fabrica e competia com a lente (sem a lente, 8 turnos e 154 mil tokens num «ok»); a porta fica;
#  - --disallowedTools nega, pelo nome do servidor, os conectores do claude.ai que não são a porta, e a tool de porta
#    fora da declaração, nas três grafias.
# Fora, medido: --disable-slash-commands tira a porta junto com as skills (no ar em d38815f, revertido); --tools com
# lista explícita também, mesmo com o ToolSearch nela (78d7d51, sobre esta combinação); allowedMcpServers e
# --strict-mcp-config também (0b6c167, fa839ed, a937727); --bare não usa o
# login da assinatura; --setting-sources sem `user` tira o hook porta-sessao; --no-session-persistence apaga o
# transcript da medida.
SEM_ARRANQUE = {"CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1"}
# Os conectores da conta claude.ai que não são a porta, pelo prefixo medido em 02/11/2026. Conector novo na conta
# entra aqui, senão chega à janela do agente.
CONECTORES_DE_FORA = ("mcp__claude_ai_Claude_Docs", "mcp__claude_ai_Google_Drive", "mcp__claude_ai_Google_Sheets")
# Juiz sem lente (card #4115): a declaração com `pecas: []` roda sem persona, chapéu, rotinas nem cadernos, e o CLI
# sobe só com as ferramentas dela. `--tools` tira também a porta (medido em #4083), que o juiz não usa; o servidor
# dela sai pelo nome nas três grafias, e assim o juiz não depende da lista de tools do conector. Medido em
# 04/11/2026 no CLI 2.1.318: `--tools ""` sobe sem ferramenta nem conector, e a imagem em linha entra pelo
# stream-json (a entrada em stream-json pede a saída em stream-json e --verbose).
PORTAS_SERVIDOR = tuple(g.rstrip("_") for g in GRAFIAS)
IMAGENS = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}
ANEXO_MAX = 5 * 1024 * 1024                                 # o teto da API por imagem
MARCA_ANEXO = re.compile(r"\[\[anexo:(\d+)\]\]")


def sem_lente(decl) -> bool:
    return isinstance(decl, dict) and decl.get("pecas") == []


# Quem paga, por ligação (spec agente §2.3, card #4136). A ligação consultada de agente Claude sem ferramenta da
# porta paga pelo crédito de API, pela conta agente-consultado, quando o regime dela no arquivo de identificadores é
# federacao. A porta só aceita pessoa: agente com ferramenta dela fica no plano até o token delegado. Agendado,
# delegado, Qwen e Gemini não federam. Voltar ao plano é PR no arquivo, nunca queda em falha.
CONTA_CONSULTADO = "agente-consultado"
# Credenciais da Anthropic que o ambiente de quem chama pode trazer, mesmo vazias: na federação nenhuma passa ao
# filho, senão o CLI as usa antes das variáveis da federação.
SOMBRAS = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_PROFILE")


def usa_porta(decl) -> bool:
    """A declaração lista alguma ferramenta da porta, em qualquer das três grafias."""
    return any(isinstance(f, str) and f.startswith(GRAFIAS) for f in (decl.get("ferramentas") or []))


def conta_federada(decl, ligacao: str, config: dict) -> str | None:
    """A conta da federação que paga esta execução, ou None quando paga o plano."""
    if familia_de(decl) != "claude" or ligacao != "consultado" or usa_porta(decl):
        return None
    dados = (config.get("contas") or {}).get(CONTA_CONSULTADO) or {}
    return CONTA_CONSULTADO if dados.get("regime") == "federacao" else None


# O erro do CLI vai ao registro com o que parece credencial trocado por marca (a trava: token nem segredo em log).
MASCARAS = ((re.compile(r"eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*"), "<token>"),
            (re.compile(r"sk-ant-[A-Za-z0-9_-]+"), "<chave>"),
            (re.compile(r"(?i)\b(bearer\s+)\S+"), r"\1<token>"))
# A classificação casa texto exato. Troca: o tipo de erro da API e a frase do CLI na recusa da identidade. Crédito:
# os textos que a API documenta para saldo esgotado e para limite do workspace, até o gate anotar o texto real.
# «auth» solto pegava «oauth» e «author», e a falha comum virava motivo troca.
TROCA_RECUSADA = ("authentication_error", "Authentication failed")
CREDITO_ESGOTADO = ("credit balance is too low", "API usage limits")


def mascara(texto: str) -> str:
    for padrao, troca in MASCARAS:
        texto = padrao.sub(troca, texto)
    return texto


def primeira_linha_do_erro(stderr: str | None, resultado) -> str:
    """A primeira linha não vazia do stderr do CLI, senão a do resultado, mascarada."""
    for fonte in (stderr or "", str(resultado or "")):
        for linha in fonte.splitlines():
            if linha.strip():
                return mascara(linha.strip())[:500]
    return "sem retorno"


def negadas_do_agente(decl: dict) -> list[str]:
    """O que sai da janela do agente: as embutidas proibidas, os conectores de fora e a porta fora da declaração."""
    porta = tools_do_conector()
    if porta is None:
        raise Falha(3, "as tools da porta não vieram (acervo listar ferramental --tools): sem a lista, o agente "
                       "levaria a porta inteira, fora da declaração")
    fora = sorted(porta - set(decl["ferramentas"] or []))
    return [*PROIBIDAS, *FORA_DO_AGENTE, *CONECTORES_DE_FORA, *(g for t in fora for g in grafias(t))]


def le_anexos(caminhos: list[str] | None) -> list[dict]:
    """As imagens do `--anexo`, em base64 e na ordem dada. Erro de forma sai 2, antes de abrir sessão."""
    lidos = []
    for c in caminhos or []:
        arq = Path(c)
        tipo = IMAGENS.get(arq.suffix.lower())
        if tipo is None:
            raise Falha(2, f"--anexo {c}: só imagem ({', '.join(IMAGENS)})")
        try:
            dados = arq.read_bytes()
        except OSError as e:
            raise Falha(2, f"--anexo {c}: não abriu ({e})")
        if len(dados) > ANEXO_MAX:
            raise Falha(2, f"--anexo {c}: {len(dados)} bytes passam de {ANEXO_MAX}, o teto da API por imagem")
        lidos.append({"tipo": tipo, "dados": base64.b64encode(dados).decode("ascii"), "bytes": len(dados)})
    return lidos


def entrada_com_imagens(tarefa: str, anexos: list[dict]) -> str:
    """A mensagem de usuário em stream-json: o texto da tarefa em blocos, cada imagem no lugar de `[[anexo:N]]`
    (N conta do 1, na ordem do `--anexo`); a que não tem marca vai antes do texto, na ordem dada. A marca deixa
    quem chama pôr o que não muda entre voltas no começo da entrada, que é o que o cache do modelo guarda."""
    def imagem(n: int) -> dict:
        a = anexos[n - 1]
        return {"type": "image", "source": {"type": "base64", "media_type": a["tipo"], "data": a["dados"]}}
    marcadas = [int(n) for n in MARCA_ANEXO.findall(tarefa)]
    for n in marcadas:
        if not 1 <= n <= len(anexos):
            raise Falha(2, f"[[anexo:{n}]] sem --anexo correspondente ({len(anexos)} dado(s))")
    blocos = [imagem(n) for n in range(1, len(anexos) + 1) if n not in marcadas]
    pos = 0
    for m in MARCA_ANEXO.finditer(tarefa):
        if tarefa[pos:m.start()].strip():
            blocos.append({"type": "text", "text": tarefa[pos:m.start()]})
        blocos.append(imagem(int(m.group(1))))
        pos = m.end()
    if tarefa[pos:].strip():
        blocos.append({"type": "text", "text": tarefa[pos:]})
    return json.dumps({"type": "user", "message": {"role": "user", "content": blocos}}, ensure_ascii=False) + "\n"


def resultado_do_cli(saida: str, stream: bool) -> dict:
    """O objeto de resultado do `claude -p`: o JSON único, ou o evento `result` do stream-json."""
    if not stream:
        try:
            return json.loads(saida or "{}")
        except ValueError:
            return {}
    obj: dict = {}
    for linha in (saida or "").splitlines():
        try:
            ev = json.loads(linha)
        except ValueError:
            continue
        if isinstance(ev, dict) and ev.get("type") == "result":
            obj = ev
    return obj


def chama_claude(decl: dict, sistema: str, tarefa: str, anexos: list[dict] | None = None,
                 ligacao: str = "consultado") -> dict:
    t = decl["teto"]
    try:
        bin_claude = claude_cli.resolver()   # a trava da release, nunca o PATH (#2856 linha 248)
    except claude_cli.ClaudeAusente as e:
        raise Falha(3, str(e)) from e

    config_fed = carrega_config_federacao()
    conta_fed = conta_federada(decl, ligacao, config_fed)
    usa_fed = conta_fed is not None

    pasta_isolada = None
    cred_contexto = None
    cred_obj = None

    if usa_fed:
        pasta_isolada = Path(tempfile.mkdtemp(prefix="agente-wif-"))
        decl["_pasta_isolada"] = pasta_isolada
        try:
            cred_contexto = federacao.abre(conta_fed, pasta_isolada, config_fed)
            cred_obj = cred_contexto.__enter__()
        except federacao.FalhaFederacao as e:
            raise Falha(3, e.motivo) from e
        except Exception as e:
            raise Falha(3, "emissor") from e

    try:
        argv = [bin_claude, "-p", "--model", decl["modelo"]["versao"],
                "--max-turns", str(t["turnos"]), "--append-system-prompt", sistema]
        if sem_lente(decl):
            # O juiz sobe só com as ferramentas da declaração: `--tools` e a porta nomeada fora.
            argv += ["--disallowedTools", ",".join([*PROIBIDAS, *FORA_DO_AGENTE, *CONECTORES_DE_FORA, *PORTAS_SERVIDOR]),
                     "--tools", ",".join(decl["ferramentas"] or [])]
        else:
            argv += ["--disallowedTools", ",".join(negadas_do_agente(decl))]
            if decl["ferramentas"]:
                argv += ["--allowedTools", ",".join(g for f in decl["ferramentas"] for g in grafias(f))]
        if usa_fed:
            # na pasta isolada, sem a configuração nem os ganchos da conta (spec agente §3.1)
            argv += ["--setting-sources", "project,local"]
        if anexos:
            argv += ["--input-format", "stream-json", "--output-format", "stream-json", "--verbose"]
            entrada = entrada_com_imagens(tarefa, anexos)
        else:
            argv += ["--output-format", "json"]
            entrada = tarefa

        env_exec = {"DISABLE_AUTOUPDATER": "1", **SEM_ARRANQUE}
        if usa_fed and cred_obj and pasta_isolada:
            env_exec["CLAUDE_CONFIG_DIR"] = str(pasta_isolada)
            env_exec["ANTHROPIC_CONFIG_DIR"] = str(pasta_isolada)
            env_exec.update(cred_obj.env)
            env_final = {**{k: v for k, v in os.environ.items() if k not in SOMBRAS}, **env_exec}
            for sombra in SOMBRAS:
                if sombra not in cred_obj.env:          # o perfil de federação, se a lib o puser, é do verbo
                    env_final.pop(sombra, None)
        else:
            env_final = {**os.environ, **env_exec}

        p = _roda(argv, stdin=entrada, env=env_final, timeout=t.get("segundos", 900),
                  cwd=pasta_isolada if usa_fed else None, cred=cred_obj)

        if cred_obj and cred_obj.falha:
            raise Falha(3, cred_obj.falha.motivo)

        obj = resultado_do_cli(p.stdout, bool(anexos))
        if p.returncode != 0 or obj.get("is_error") or not isinstance(obj.get("result"), str):
            if cred_obj and cred_obj.falha:
                raise Falha(3, cred_obj.falha.motivo)
            erro = primeira_linha_do_erro(p.stderr, obj.get("result"))
            if usa_fed:
                texto_erro = f"{p.stderr or ''}\n{obj.get('result') or ''}"
                if any(m in texto_erro for m in TROCA_RECUSADA):
                    raise Falha(3, "troca", erro)
                if any(m.lower() in texto_erro.lower() for m in CREDITO_ESGOTADO):
                    raise Falha(3, "credito", erro)
            raise Falha(5, f"claude -p não concluiu (saiu {p.returncode}): {erro[:200]}", erro)
        # A régua é o transcript da sessão do Code, a mesma do fecho da fita (dono, 16/10/2026): uso por chamada,
        # cada requestId uma vez. O resumo final do `claude -p` fica de reserva quando o transcript não aparece,
        # e o registro diz qual das duas fontes valeu.
        sessao_code = obj.get("session_id") if isinstance(obj.get("session_id"), str) else None
        arq = None
        if sessao_code:
            if usa_fed and pasta_isolada:
                for cand in (pasta_isolada / "projects", pasta_isolada / ".claude" / "projects", pasta_isolada):
                    if cand.exists():
                        arq = transcript.da_sessao(sessao_code, raiz=cand)
                        if arq:
                            break
            if not arq:
                arq = transcript.da_sessao(sessao_code)
        lido = transcript.soma(arq) if arq else None
        pedidos = transcript.por_pedido(arq) if arq else None
        if lido:
            u = {"input_tokens": lido["entrada"], "output_tokens": lido["saida"],
                 "cache_creation_input_tokens": lido["cache_criacao"], "cache_read_input_tokens": lido["cache_leitura"]}
            fonte, chamadas = "transcript", len(pedidos or {})
        else:
            u, fonte, chamadas = obj.get("usage") or {}, "resumo", None
        # o cache conta: sem ele a entrada saía 4 tokens numa revisão de 4 mil de saída (medido em 01/10).
        # `entrada` é a soma, por chamada ao modelo, da janela inteira: cada turno relê o prefixo do cache e tudo
        # o que as tools já devolveram. As três parcelas vão ao registro para separar o lido do cache do novo
        # (pedido da gestão estratégica de 15/10/2026: o 1,3 milhão do parecerista era quase todo leitura de cache).
        nova = u.get("input_tokens", 0)
        criacao = u.get("cache_creation_input_tokens", 0)
        leitura = u.get("cache_read_input_tokens", 0)
        entrada = nova + criacao + leitura
        saida = u.get("output_tokens", 0)
        # DT 334: o aviso de tokens mede o pico da janela por chamada (maior entrada de uma chamada), não a soma com cache lido
        if pedidos:
            pico = max((p.get("input_tokens", 0) + p.get("cache_creation_input_tokens", 0) + p.get("cache_read_input_tokens", 0)) for p in pedidos.values())
        else:
            pico = entrada
        aviso = ""
        if pico > t["tokens_execucao"]:         # o CLI só corta por turnos: aqui se mede e se avisa
            aviso = f"tokens da execução {pico} passaram de tokens_execucao {t['tokens_execucao']} (medido, não cortado)"
        return {"retorno": obj["result"], "aviso": aviso,
                "uso": {"entrada": entrada, "saida": saida, "turnos": obj.get("num_turns"),
                        "entrada_nova": nova, "cache_criacao": criacao, "cache_leitura": leitura,
                        "chamadas": chamadas, "fonte": fonte, "sessao_code": sessao_code},
                "credencial": f"federacao:{cred_obj.conta_servico}" if (usa_fed and cred_obj) else "plano"}
    finally:
        if cred_contexto:
            with contextlib.suppress(Exception):
                cred_contexto.__exit__(None, None, None)


def _bin_agy() -> str:
    """O `agy` da conta (~/.local/bin, onde ele se atualiza sozinho); PF_AGY_BIN só em teste com stub."""
    alvo = os.environ.get("PF_AGY_BIN") or str(Path.home() / ".local" / "bin" / "agy")
    if not os.access(alvo, os.X_OK):
        raise Falha(3, f"agy não está instalado na conta ({alvo})")
    return alvo


SILENCIO_AGY_S = 180        # sem evento do agy neste prazo, o verbo o mata (#4098)
SEGUNDOS_AGY_PADRAO = 480   # abaixo dos 600 s do prazo da chamada, somados os 30 s de folga do corte


def _linhas_do_agy(p: subprocess.Popen, limite: float, segundos: int, motivo: list[str]) -> Iterator[str]:
    """As linhas do stdout do agy, uma a uma. Ler direto do pipe bloqueava com o agy calado, e o corte por tempo,
    que mora no laço de quem lê, nunca rodava: a chamada ia até a porta matá-la aos 600 s (#4098). Aqui a leitura
    é de uma thread e o verbo acorda a cada segundo: passou do teto de tempo, ou ficou sem evento além de
    SILENCIO_AGY_S, o gerador termina e `motivo` diz por quê."""
    fila: queue.Queue = queue.Queue()

    def le() -> None:
        for linha in p.stdout:
            fila.put(linha)
        fila.put(None)

    threading.Thread(target=le, daemon=True).start()
    ultima = time.monotonic()
    while True:
        try:
            linha = fila.get(timeout=1)
        except queue.Empty:
            agora = time.monotonic()
            if agora > limite:
                motivo.append(f"passou de {segundos}s")
                return
            if agora - ultima > SILENCIO_AGY_S:
                motivo.append(f"sem saída do agy por {SILENCIO_AGY_S}s")
                return
            continue
        if linha is None:
            return
        ultima = time.monotonic()
        yield linha


def chama_agy(decl: dict, sistema: str, tarefa: str) -> dict:
    """Gemini pelo `agy -p`, na conta de produção, com o login Google do dono e o conector claudinho-mcp dele
    (~/.gemini/config/mcp_config.json, cliente agy-cli). Medido no ar em 02/11/2026 (#4093):
     - o prompt vai no argv, colado à flag (`--print=<texto>`): o agy não lê stdin no modo print, e `-p` solto
       come a flag seguinte como prompt;
     - o agy não tem --append-system-prompt nem lista de tools permitidas: a lente entra no prompt, antes da
       tarefa, e o recorte de tools da declaração não se aplica; vale o que o PDP decide para a pessoa;
     - `--mode plan` e `--sandbox` tiram a edição e prendem o terminal embutido: o agente não escreve;
     - roda numa pasta vazia, para não ler AGENTS.md nem regra de projeto do diretório de quem chamou."""
    t = decl["teto"]
    segundos = t.get("segundos", SEGUNDOS_AGY_PADRAO)
    prompt = f"{sistema}\n\n---\n\nTAREFA\n\n{tarefa}"
    # stream-json, e não json: o agy não tem --max-turns nem teto de token, e o resumo só chega no fim. Cada passo
    # `agent_response` DONE traz o uso daquela chamada ao modelo; o verbo soma e mata o processo no teto da
    # declaração. Medido em 02/11/2026: sem o corte, uma leitura adversarial gastou 598 mil tokens em 23 chamadas
    # contra o teto de 100 mil.
    argv = [_bin_agy(), "--mode", "plan", "--sandbox", "--output-format", "stream-json",
            "--print-timeout", f"{segundos}s", f"--print={prompt}"]
    soma = {"entrada": 0, "saida": 0, "cache_leitura": 0, "pensamento": 0}
    chamadas, ferramentas, texto, final, cortado = 0, 0, [], None, ""
    limite = time.monotonic() + segundos + 30
    motivo_corte: list[str] = []
    with tempfile.TemporaryDirectory(prefix="agente-agy-") as vazia:
        try:
            p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, cwd=vazia,
                                 env={**os.environ, "DISABLE_AUTOUPDATER": "1"})
        except OSError as e:
            raise Falha(3, f"agy: não executou ({e})")
        try:
            for linha in _linhas_do_agy(p, limite, segundos, motivo_corte):
                try:
                    ev = json.loads(linha)
                except ValueError:
                    continue
                if ev.get("event") == "result":
                    final = ev.get("result") or {}
                    continue
                passo = ev.get("step_update") or {}
                if passo.get("step_type") == "agent_response" and isinstance(passo.get("text_delta"), str):
                    texto.append(passo["text_delta"])
                if passo.get("state") != "DONE":
                    continue
                if passo.get("step_type") == "tool":
                    ferramentas += 1
                u = passo.get("usage")
                if passo.get("step_type") == "agent_response" and isinstance(u, dict):
                    chamadas += 1
                    soma["entrada"] += u.get("input_tokens", 0) + u.get("cache_read_tokens", 0)
                    soma["saida"] += u.get("output_tokens", 0) + u.get("thinking_tokens", 0)
                    soma["cache_leitura"] += u.get("cache_read_tokens", 0)
                    soma["pensamento"] += u.get("thinking_tokens", 0)
                gasto = soma["entrada"] + soma["saida"]
                if gasto > t["tokens_execucao"]:
                    cortado = f"{gasto} tokens em {chamadas} chamadas passaram de tokens_execucao {t['tokens_execucao']}"
                elif ferramentas > t["turnos"]:
                    cortado = f"{ferramentas} chamadas de ferramenta passaram de turnos {t['turnos']}"
                elif time.monotonic() > limite:
                    cortado = f"passou de {segundos}s"
                if cortado:
                    p.kill()
                    break
            if motivo_corte and not cortado:
                cortado = motivo_corte[0]
        finally:
            if p.poll() is None:
                p.kill()
            erro = p.stderr.read() if p.stderr else ""
            p.wait()
    uso = {**soma, "turnos": chamadas, "ferramentas": ferramentas, "fonte": "stream",
           "conversa_agy": (final or {}).get("conversation_id")}
    if cortado:
        resto = f"; stderr: {erro.strip()[-200:]}" if (erro or "").strip() else ""
        raise Falha(5, f"agy cortado no teto da declaração: {cortado}; uso {json.dumps(uso)}{resto}")
    resposta = (final or {}).get("response") or "".join(texto)
    if p.returncode != 0 or (final or {}).get("status") != "SUCCESS" or not resposta.strip():
        motivo = ((erro or "").strip().splitlines() or [str((final or {}).get("status") or "sem retorno")])[0]
        raise Falha(5, f"agy -p não concluiu (saiu {p.returncode}): {motivo[:200]}")
    return {"retorno": resposta, "aviso": "", "uso": uso}


def chama_modelo(decl: dict, sistema: str, tarefa: str, anexos: list[dict] | None = None,
                 ligacao: str = "consultado") -> dict:
    m = decl["modelo"]
    if m["familia"] == "qwen" and m.get("local"):
        return chama_ollama(decl, sistema, tarefa)
    if m["familia"] == "claude":
        return chama_claude(decl, sistema, tarefa, anexos, ligacao=ligacao)
    if m["familia"] == "gemini":
        return chama_agy(decl, sistema, tarefa)
    raise Falha(3, f"a ligação {m['familia']} ainda não roda pelo agente rodar: a execução sob "
                   f"{conta_do_modelo(m)} é da ti (spec agente §Aberto)")


def registra(reg: dict) -> None:
    """Uma linha por execução, com os cinco atributos. Nunca derruba a execução."""
    try:
        pasta = raizes.instancia() / "var" / "log" / "agente"
        pasta.mkdir(parents=True, exist_ok=True)
        with open(pasta / f"agente-{datetime.now().date().isoformat()}.jsonl", "a", encoding="utf-8") as f:
            f.write(json.dumps(reg, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"agente: registro da execução não gravado ({e})", file=sys.stderr)


def ato_rodar(slug: str, cadeira_arg: str | None, chapeu_arg: str | None, como_json: bool,
              ligacao: str = "consultado", pecas: list[str] | None = None, anexos: list[str] | None = None) -> int:
    posto, rc = _posto_ou_erro()
    if posto is None:
        return rc
    decls, problemas = carrega(posto)
    if slug not in decls:
        print(f"agente: sem declaração {slug!r} em {posto}/agentes", file=sys.stderr)
        print("vizinho: agente listar", file=sys.stderr)
        return 1
    decl = decls[slug]
    if slug in problemas:
        return _erro(f"a declaração de {slug} está fora do molde ({'; '.join(problemas[slug])}); "
                     "agente projetar --conferir diz o resto", 4)
    decl = efetiva(decl, ligacao)                          # modelo, ferramentas e teto da ligação (spec agente §2)
    tarefa = sys.stdin.read() if not sys.stdin.isatty() else ""
    if not tarefa.strip():
        return _erro("a tarefa vem em stdin: agente rodar <slug> < tarefa", 2)
    try:
        variantes = le_variantes(pecas)                    # erro de forma sai antes de abrir sessão
        imagens = le_anexos(anexos)
        if imagens and decl["modelo"]["familia"] != "claude":
            raise Falha(2, f"--anexo só vale em modelo Claude; o de {slug} é {decl['modelo']['familia']}")
        if imagens:
            entrada_com_imagens(tarefa, imagens)           # confere as marcas [[anexo:N]] antes de abrir sessão
        if variantes and sem_lente(decl):
            raise Falha(2, f"--peca: {slug} roda sem lente, não há peça a trocar")
    except Falha as f:
        return _erro(f.msg, f.codigo)
    dono = decl["dono"]
    if dono["cadeira"] == "{cadeira}":
        if not cadeira_arg:
            return _erro(f"{slug} tem dono {{cadeira}}: passe --cadeira <slug>", 2)
        cadeira, chapeu = cadeira_arg, chapeu_arg or dono.get("chapeu")
        if not chapeu:
            return _erro(f"{slug} tem dono {{cadeira}} sem chapéu fixo: passe --chapeu <slug>", 2)
    else:
        if cadeira_arg:
            return _erro(f"--cadeira só vale no agente cujo dono é {{cadeira}}; o de {slug} é {dono['cadeira']}", 2)
        cadeira, chapeu = dono["cadeira"], dono["chapeu"]
    # §11.1: sem pessoa resolvida, nega antes de tudo — sem abrir sessão, sem chamar o modelo, sem cair para a conta.
    sujeito = os.environ.get("PF_SUJEITO", "").strip()
    origem = os.environ.get("PF_SESSAO", "").strip()
    if not sujeito or not origem:
        return _erro("sem pessoa resolvida (PF_SUJEITO) ou sem a sessão de quem chamou (PF_SESSAO): "
                     "nega por padrão, sem cair para a conta (spec agente §11.1)", 1)
    conta = conta_do_modelo(decl["modelo"])
    filha = None
    inicio = time.monotonic()
    credencial_esperada = "plano"
    cfg = carrega_config_federacao()
    conta_fed = conta_federada(decl, ligacao, cfg)
    if conta_fed:
        credencial_esperada = f"federacao:{cfg['contas'][conta_fed].get('conta_servico', '')}"

    try:
        if conta in CONTAS_SEGREGADAS:
            ok, motivo = isolacao_conforme(conta)
            if not ok:
                raise Falha(4, f"a conta {conta} não está conforme na última seg isolacao medir ({motivo})")
        filha = abre_sessao(cadeira, origem, slug, conta)
        lente = "" if sem_lente(decl) else monta_lente(decl, cadeira, chapeu, filha, origem, tarefa, variantes)
        r = chama_modelo(decl, _sistema(decl, lente), numera(tarefa) if decl["modo"] == "varrer" else tarefa, imagens, ligacao=ligacao)
    except Falha as f:
        if filha:
            _encerra(filha["sessao_id"])
        reg_falha = {"ts": _agora(), "agente": slug, "sujeito": sujeito, "em_nome_de": cadeira, "origem": origem,
                     "conta": conta, "sessao_id": (filha or {}).get("sessao_id"), "exit": f.codigo, "motivo": f.msg}
        if decl["modelo"]["familia"] == "claude":
            reg_falha["credencial"] = credencial_esperada
            if f.codigo == 3 and f.msg in ("emissor", "troca", "credito"):
                reg_falha["motivo"] = f.msg
            if f.erro:
                reg_falha["erro_cli"] = f.erro
        registra(reg_falha)
        pasta_limpar = decl.get("_pasta_isolada")
        if pasta_limpar and pasta_limpar.exists():
            shutil.rmtree(pasta_limpar, ignore_errors=True)
        return _erro(f.msg, f.codigo)
    _encerra(filha["sessao_id"])
    duracao = round(time.monotonic() - inicio, 1)
    reg_ok = {"ts": _agora(), "agente": slug, "sujeito": sujeito, "em_nome_de": cadeira, "origem": origem,
              "conta": conta, "sessao_id": filha["sessao_id"], "modelo": f"{decl['modelo']['familia']}:{decl['modelo']['versao']}",
              "uso": r["uso"], "segundos": duracao, "exit": 0,
              **({"variantes": marca_variantes(variantes)} if variantes else {}),
              **({"sem_lente": True} if sem_lente(decl) else {}),
              **({"anexos": [a["bytes"] for a in imagens]} if imagens else {})}
    if decl["modelo"]["familia"] == "claude":
        reg_ok["credencial"] = r.get("credencial", "plano")
    registra(reg_ok)
    pasta_limpar = decl.get("_pasta_isolada")
    if pasta_limpar and pasta_limpar.exists():
        shutil.rmtree(pasta_limpar, ignore_errors=True)
    if r["aviso"]:
        print(f"aviso: {r['aviso']}", file=sys.stderr)
    print(f"agente {slug}: sessao {filha['sessao_id']} origem {origem} conta {conta} "
          f"uso {json.dumps(r['uso'])} em {duracao}s", file=sys.stderr)
    if como_json:
        print(json.dumps({"agente": slug, "sessao_id": filha["sessao_id"], "origem": origem, "sujeito": sujeito,
                          "em_nome_de": cadeira, "conta": conta, "uso": r["uso"], "retorno": r["retorno"]},
                         ensure_ascii=False))
    else:
        print(r["retorno"])
    return 0


# --- ato: medir-federacao (card #4136, gate das Tarefas 4 e 6) ---------------------------------

def _jti_do_arquivo(arq: Path) -> str | None:
    """O jti do token em disco, sem o token: o identificador de uso único que a troca não aceita repetido."""
    try:
        corpo = arq.read_text(encoding="utf-8").split(".")[1]
        return json.loads(base64.urlsafe_b64decode(corpo + "=" * (-len(corpo) % 4))).get("jti")
    except (OSError, IndexError, ValueError):
        return None


def _ate_o_resultado(proc: subprocess.Popen) -> dict:
    for linha in proc.stdout:
        try:
            ev = json.loads(linha)
        except ValueError:
            continue
        if isinstance(ev, dict) and ev.get("type") == "result":
            return ev
    return {}


def ato_medir_federacao(espera: int, como_json: bool) -> int:
    """O gate da federação consultada: `claude -p` pela conta agente-consultado numa pasta vazia, sem ferramenta,
    sem login nem configuração da conta, com «responda só: ok». Com --espera, a segunda mensagem vai no mesmo
    processo depois da espera, e o jti tem de ter mudado. Não roda agente nenhum e não lê o regime: mede a
    troca antes de o regime mudar. Sai 0 respondido, 3 com motivo emissor|troca|credito, 5 o resto."""
    if not os.environ.get("PF_SUJEITO", "").strip():
        return _erro("sem pessoa resolvida (PF_SUJEITO): nega por padrão, a medida gasta crédito", 1)
    cfg = carrega_config_federacao()
    dados = (cfg.get("contas") or {}).get(CONTA_CONSULTADO)
    if not dados:
        return _erro(f"{CONTA_CONSULTADO} não está no arquivo de identificadores", 3)
    try:
        bin_claude = claude_cli.resolver()
    except claude_cli.ClaudeAusente as e:
        return _erro(str(e), 3)
    medida: dict = {"ts": _agora(), "agente": "medir-federacao", "sujeito": os.environ["PF_SUJEITO"].strip(),
                    "origem": os.environ.get("PF_SESSAO", "").strip() or None, "espera": espera,
                    "credencial": f"federacao:{dados.get('conta_servico', '')}", "respostas": []}
    codigo, motivo, erro = 0, "", ""
    argv = [bin_claude, "-p", "--model", "sonnet", "--max-turns", "2", "--tools", "",
            "--disallowedTools", ",".join([*PROIBIDAS, *FORA_DO_AGENTE, *CONECTORES_DE_FORA, *PORTAS_SERVIDOR]),
            "--setting-sources", "project,local",
            "--input-format", "stream-json", "--output-format", "stream-json", "--verbose"]
    mensagens = [("responda só: ok", 0)] + ([("responda só: ok de novo", espera)] if espera > 0 else [])
    pasta = Path(tempfile.mkdtemp(prefix="agente-wif-medir-"))
    try:
        with federacao.abre(CONTA_CONSULTADO, pasta, cfg) as cred:
            env = {**{k: v for k, v in os.environ.items() if k not in SOMBRAS}, "DISABLE_AUTOUPDATER": "1",
                   **SEM_ARRANQUE, "CLAUDE_CONFIG_DIR": str(pasta), "ANTHROPIC_CONFIG_DIR": str(pasta), **cred.env}
            proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    text=True, cwd=pasta, env=env)
            cred.registra_processo(proc)
            for i, (texto, antes) in enumerate(mensagens):
                if antes:
                    time.sleep(antes)
                jti = _jti_do_arquivo(cred.token_path)
                proc.stdin.write(json.dumps({"type": "user", "message": {"role": "user", "content": texto}},
                                            ensure_ascii=False) + "\n")
                proc.stdin.flush()
                if i == len(mensagens) - 1:
                    proc.stdin.close()
                r = _ate_o_resultado(proc)
                medida["respostas"].append({"jti": jti, "is_error": r.get("is_error"), "subtype": r.get("subtype"),
                                            "result": mascara(str(r.get("result") or ""))[:500]})
                if not r or r.get("is_error") or not str(r.get("result") or "").strip():
                    break
            if not proc.stdin.closed:
                proc.stdin.close()
            stderr = proc.stderr.read()
            proc.wait(timeout=60)
            medida["exit_cli"] = proc.returncode
            medida["stderr"] = mascara(stderr)[-4000:]
            if cred.falha:
                raise cred.falha
    except federacao.FalhaFederacao as e:
        codigo, motivo, erro = 3, e.motivo, mascara(e.detalhe)[:500]
    except (OSError, subprocess.TimeoutExpired) as e:
        codigo, motivo, erro = 5, "", f"{type(e).__name__}: {e}"
    finally:
        shutil.rmtree(pasta, ignore_errors=True)
    if codigo == 0:
        resp = medida["respostas"]
        ok = len(resp) == len(mensagens) and all(not r["is_error"] and r["result"].strip() for r in resp)
        if not ok:
            texto_erro = f"{medida.get('stderr', '')}\n" + "\n".join(r["result"] for r in resp)
            erro = primeira_linha_do_erro(medida.get("stderr"), (resp[-1]["result"] if resp else ""))
            if any(m in texto_erro for m in TROCA_RECUSADA):
                codigo, motivo = 3, "troca"
            elif any(m.lower() in texto_erro.lower() for m in CREDITO_ESGOTADO):
                codigo, motivo = 3, "credito"
            else:
                codigo = 5
        elif len(resp) > 1 and resp[0]["jti"] == resp[-1]["jti"]:
            codigo, erro = 5, "o jti não mudou entre as duas mensagens: a identidade não foi renovada"
    medida["exit"] = codigo
    if motivo:
        medida["motivo"] = motivo
    if erro:
        medida["erro_cli"] = erro
    registra(medida)
    print(json.dumps(medida, ensure_ascii=False, indent=None if como_json else 2))
    return codigo


def _agora() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _encerra(sessao_id: str) -> None:
    """A filha não é para reabrir: sai da chave viva. O duradouro fica (sessao encerrar)."""
    try:
        _roda([str(_bin() / "sessao"), "encerrar", sessao_id], timeout=30)
    except Falha:
        pass


# --- a linha de comando ----------------------------------------------------------------------

def medir_cache() -> int:
    """Par mínimo do transporte sem tools, prefixo grande, duas famílias (#2856 linha 503)."""
    import hashlib
    import tokenizador
    prefixo = "Material de referência para a medição. Responda somente ok.\n" + "\n".join(
        hashlib.sha256(f"dt503-{i}".encode()).hexdigest() for i in range(600))
    tokens, metodo = tokenizador.conta_tokens(prefixo)
    medidas = []
    with tempfile.TemporaryDirectory(prefix="agente-cache-") as pasta:
        for modelo in ("claude-haiku-4-5", "claude-sonnet-4-6"):
            for replica in (1, 2):
                p = _roda([claude_cli.resolver(), "-p", "--model", modelo, "--safe-mode",
                           "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
                           "--tools", "", "--system-prompt", prefixo, "--no-session-persistence",
                           "--output-format", "json"],
                          stdin="Responda somente: ok", cwd=Path(pasta), timeout=90)
                obj = resultado_do_cli(p.stdout, False)
                medidas.append({"modelo": modelo, "replica": replica, "exit": p.returncode,
                                "usage": obj.get("usage"), "modelUsage": obj.get("modelUsage"),
                                "is_error": obj.get("is_error"),
                                "erro": primeira_linha_do_erro(p.stderr, obj.get("result")) if p.returncode else None})
    medida = {"ato": "medir-cache", "em": _agora(), "prefixo_tokens": tokens,
              "metodo_tokens": metodo, "sha256": hashlib.sha256(prefixo.encode()).hexdigest(),
              "medidas": medidas}
    registra(medida)
    print(json.dumps(medida, ensure_ascii=False))
    return 0 if all(m["exit"] == 0 and m["usage"] and not m["is_error"] for m in medidas) else 5


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    uso.intercepta(argv, fonte=__file__)
    p = uso.Uso(descricao="a caixa de especialistas: lista, projeta e roda quem pensa, com modelo, ferramentas e teto fixos")
    atos = p.atos()
    a = atos.novo("listar", "as declarações do posto, uma por linha")
    a.add_argument("--modelo", choices=FAMILIAS, default=None)
    a.add_argument("--modo", choices=MODOS, default=None)
    a.add_argument("--json", action="store_true")
    a = atos.novo("ler", "a declaração inteira de um especialista")
    a.add_argument("slug")
    a = atos.novo("rodar", "abre a sessão filha, monta a lente e chama o modelo na conta dele (tarefa em stdin)")
    a.add_argument("slug")
    a.add_argument("--cadeira", default=None)
    a.add_argument("--chapeu", default=None)
    a.add_argument("--ligacao", choices=("consultado", "agendado"), default="consultado",
                   help="por onde a tarefa entra; o bot passa agendado (spec agente §4)")
    a.add_argument("--peca", action="append", default=None, metavar="<nome>=<arquivo>",
                   help="troca o conteúdo da peça da lente pelo do arquivo; <nome>= tira a peça (par mínimo)")
    a.add_argument("--anexo", action="append", default=None, metavar="<imagem>",
                   help="põe a imagem em linha na mensagem (só Claude): no lugar de [[anexo:N]] na tarefa, ou antes do texto")
    a.add_argument("--json", action="store_true")
    a = atos.novo("projetar", "gera as projeções do provedor; --conferir só mede")
    a.add_argument("--conferir", action="store_true")
    a.add_argument("--base", default=None)
    a = atos.novo("medir-federacao", "o gate da federação consultada: claude -p pela conta agente-consultado, sem agente")
    a.add_argument("--espera", type=int, default=0, metavar="<segundos>",
                   help="manda a segunda mensagem depois da espera, no mesmo processo, e confere o jti")
    a.add_argument("--json", action="store_true")
    atos.novo("medir-cache", "mede cache com prefixo próprio em duas famílias, sem ferramentas")
    ns = p.parse_args(argv)
    if ns.ato == "medir-cache":
        return medir_cache()
    if ns.ato == "medir-federacao":
        return ato_medir_federacao(ns.espera, ns.json)
    if ns.ato == "listar":
        return ato_listar(ns.modelo, ns.modo, ns.json)
    if ns.ato == "ler":
        return ato_ler(ns.slug)
    if ns.ato == "rodar":
        return ato_rodar(ns.slug, ns.cadeira, ns.chapeu, ns.json, ns.ligacao, ns.peca, ns.anexo)
    return ato_projetar(ns.conferir, ns.base)


if __name__ == "__main__":
    sys.exit(main())
