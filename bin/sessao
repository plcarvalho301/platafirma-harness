#!/opt/platafirma/current/venv/harness/bin/python
# sessao — autoriza e cunha a sessão
# capacidade: acesso
# dono: ia
# classe: A
# forma: objeto (abrir, ver, limpar) / lista (listar) / predicado (encerrar) / fluxo (longjob)
# use para: «de quem é esta sessão?», autorizar, cunhar, achar a fita; limpar sessões órfãs
# atos: abrir (escrita, sessao), ver (leitura, sessao), listar (leitura, sessao), encerrar (escrita, sessao), limpar (escrita, sessao), longjob (herdado do alvo)
# folhas: abrir|encerrar|limpar -> sessao/cunhagem · ver|listar -> sessao/estado · longjob -> sessao/execucao-longa
# escreve: sessao:{id} (hash no msg-mem; DEL em encerrar|limpar), ledger:{id}, giro:{id}, sessao.sessao (duravel)
# consome: msg-mem (hash sessao:{id}) e Postgres da sessao
# ambiente: PF_SUJEITO, PF_SESSAO_AUTORIZADA_POR, PF_SUPERFICIE[=desconhecida], PF_BIN, MEM_REDIS_HOST[=127.0.0.1], MEM_REDIS_PORT[=6380], SESSAO_PG_PORT[=5437], PF_ORDEM_ID, PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa], PF_SESSAO
# depende: msg-mem (modulo redis), Postgres da sessao (psycopg), persona, seg, longjob, reidratar
# substitui: monta-sessao <cadeira> na parte que cunha; redis-cli HSET sessao:*; psql -d sessao
# conforme: parcial — chave viva em hash e registro duravel
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any

_REPO_REAL = Path(__file__).resolve().parent.parent
BIN = os.environ.get("PF_BIN") or str(_REPO_REAL / "bin")
MEM_HOST = os.environ.get("MEM_REDIS_HOST", "127.0.0.1")
MEM_PORTA = int(os.environ.get("MEM_REDIS_PORT", "6380"))
PG_PORTA = os.environ.get("SESSAO_PG_PORT", "5437")
TTL_SESSAO_S = 172800          # 48 h — o mesmo da porta, para nao haver duas verdades
ATOS = ("abrir", "ver", "listar", "encerrar", "limpar", "longjob")
ATRIBUTOS_AGENTE = ("agente", "em_nome_de", "conta_agente")
PREFIXOS_CADEIRA = ("claudinho-", "claudinha-")
SUPERFICIES = (
    "claude.ai", "chat", "code", "desconhecida",
    "agy", "cursor", "codex", "fabrica", "fita",
)
_CAMPOS_BOOL = frozenset({"canonizada"})

_AJUDANTE_SESSAO = str(_REPO_REAL / "bin" / "_sessao")
if _AJUDANTE_SESSAO not in sys.path:
    sys.path.insert(0, _AJUDANTE_SESSAO)
try:
    import reidratar as _reidratar_mod
except ImportError:
    _reidratar_mod = None


# ------------------------------------------------------------------ util
def _agora_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime())


def _uuid_valido(s: str | None) -> str | None:
    try:
        return str(uuid.UUID(str(s).strip()))
    except (ValueError, AttributeError, TypeError):
        return None


def _superficie() -> str:
    sup = (os.environ.get("PF_SUPERFICIE") or "").strip() or "desconhecida"
    return sup if sup in SUPERFICIES else "desconhecida"


def _env_verbo() -> dict[str, str]:
    e = dict(os.environ)
    e["PATH"] = f"{BIN}:" + os.environ.get("PATH", "")
    return e


def _roda(argv: list[str], timeout: int = 20, stdin: str | None = None) -> tuple[int, str, str]:
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                           env=_env_verbo(), input=stdin, check=False)
        return p.returncode, p.stdout or "", p.stderr or ""
    except (OSError, subprocess.SubprocessError) as e:
        return 127, "", f"{type(e).__name__}: {e}"


def _sufixo(cadeira: str) -> str:
    cad = (cadeira or "").strip()
    for pref in PREFIXOS_CADEIRA:
        if cad.lower().startswith(pref):
            return cad[len(pref):].lower()
    return cad.lower()


class Saida:
    def __init__(self, como_json: bool):
        self.json = como_json

    def erro(self, msg: str, exit_code: int, **campos) -> int:
        if self.json:
            print(json.dumps({"erro": msg, **campos}, ensure_ascii=False))
        else:
            print(msg, file=sys.stderr)
        return exit_code


# ------------------------------------------------------------------ msg-mem (hash)
def _msgmem():
    try:
        import redis
    except ImportError:
        return None, "modulo `redis` ausente neste venv"
    try:
        _lib_dir = str(Path(__file__).resolve().parents[1] / "lib")
        if _lib_dir not in sys.path:
            sys.path.insert(0, _lib_dir)
        from memoria_de_trabalho import kwargs_redis_msg_mem  # noqa: PLC0415

        rc = redis.Redis(
            host=MEM_HOST,
            port=MEM_PORTA,
            decode_responses=True,
            socket_connect_timeout=2,
            socket_timeout=3,
            **kwargs_redis_msg_mem(),
        )
        rc.ping()
        return rc, None
    except Exception as e:  # noqa: BLE001
        return None, f"{type(e).__name__}"


def _cura_msgmem(motivo: str) -> str:
    return (f"msg-mem: ausente ({MEM_HOST}:{MEM_PORTA} — {motivo}); "
            "levanta com `infra estado` / `infra restart` na stack do msg-mem")


def _serializar_hash(campos: dict[str, Any]) -> dict[str, str]:
    saida: dict[str, str] = {}
    for k, v in campos.items():
        if v is None:
            continue
        if isinstance(v, bool):
            saida[str(k)] = "true" if v else "false"
        elif isinstance(v, (dict, list)):
            saida[str(k)] = json.dumps(v, ensure_ascii=False)
        else:
            saida[str(k)] = str(v)
    return saida


def _desserializar_hash(bruto: dict[str, Any]) -> dict[str, Any]:
    saida: dict[str, Any] = {}
    for k, v in bruto.items():
        ks = k.decode("utf-8", errors="replace") if isinstance(k, bytes) else str(k)
        vs = v.decode("utf-8", errors="replace") if isinstance(v, bytes) else str(v)
        if ks in _CAMPOS_BOOL:
            if vs == "true":
                saida[ks] = True
                continue
            if vs == "false":
                saida[ks] = False
                continue
        if vs.startswith(("{", "[")):
            try:
                saida[ks] = json.loads(vs)
                continue
            except ValueError:
                pass
        saida[ks] = vs
    return saida


def _le_chave(rc, sid: str) -> dict | None:
    bruto = rc.hgetall(f"sessao:{sid}")
    if not bruto:
        return None
    return _desserializar_hash(bruto)


def _grava_chave(rc, sid: str, ch: dict[str, Any], ttl_s: int = TTL_SESSAO_S) -> None:
    chave = f"sessao:{sid}"
    mapping = _serializar_hash(ch)
    if mapping:
        rc.hset(chave, mapping=mapping)
        rc.expire(chave, ttl_s)


# ------------------------------------------------------------------ organizacao
def _vocabulario() -> tuple[dict | None, str | None]:
    rc, out, err = _roda(["persona", "foto", "--json"], timeout=15)
    if rc not in (0, 1) or not out.strip():
        return None, (err or out).strip()[:200] or f"persona foto: exit {rc}"
    try:
        d = json.loads(out)
    except ValueError:
        return None, "persona foto: saida nao e JSON"
    return (d if isinstance(d, dict) else None), (None if isinstance(d, dict) else "persona foto: JSON inesperado")


def _canoniza(cadeira: str, voc: dict) -> str | None:
    suf = _sufixo(cadeira)
    if suf in voc:
        return suf
    alvo = cadeira.strip().lower()
    for slug, meta in voc.items():
        alias = (meta or {}).get("alias") if isinstance(meta, dict) else None
        if alias and alias.strip().lower() == alvo:
            return slug
    return None


# ------------------------------------------------------------------ registro duravel
def _senha_pg() -> tuple[str | None, str | None]:
    rc, out, err = _roda(["seg", "segredo", "ler", "harness-sessao/SESSAO_PG_PASSWORD"], timeout=10)
    if rc == 0 and out.strip():
        return out.strip(), None
    return None, f"seg segredo ler harness-sessao/SESSAO_PG_PASSWORD: {(err or out).strip()[:120] or f'exit {rc}'}"


def _registra_duravel(sid: str, slug: str, sujeito: str | None = None,
                      ordem_id: str | None = None) -> str | None:
    try:
        import psycopg
    except ImportError:
        return "psycopg ausente neste venv"
    senha, motivo = _senha_pg()
    if not senha:
        return motivo
    dsn = f"host=127.0.0.1 port={PG_PORTA} dbname=sessao user=sessao password={senha}"
    try:
        with psycopg.connect(dsn, connect_timeout=3) as con, con.cursor() as cur:
            if ordem_id:
                try:
                    cur.execute(
                        "INSERT INTO sessao.sessao (sessao_id, cadeira, chapeu, superficie, sujeito, ordem_id) "
                        "VALUES (%s,%s,%s,%s,%s,%s) ON CONFLICT (sessao_id) DO UPDATE SET "
                        "sujeito = COALESCE(sessao.sessao.sujeito, EXCLUDED.sujeito), "
                        "ordem_id = COALESCE(EXCLUDED.ordem_id, sessao.sessao.ordem_id)",
                        (sid, slug, None, _superficie(), sujeito or None, ordem_id))
                    con.commit()
                    return None
                except Exception:  # noqa: BLE001
                    con.rollback()
            cur.execute(
                "INSERT INTO sessao.sessao (sessao_id, cadeira, chapeu, superficie, sujeito) "
                "VALUES (%s,%s,%s,%s,%s) ON CONFLICT (sessao_id) DO UPDATE SET "
                "sujeito = COALESCE(sessao.sessao.sujeito, EXCLUDED.sujeito)",
                (sid, slug, None, _superficie(), sujeito or None))
            con.commit()
    except Exception as e:  # noqa: BLE001
        return f"Postgres da sessao: {type(e).__name__}"
    return None


# ------------------------------------------------------------------ ato: abrir
def _imprime_abrir(ch: dict, sid: str, cunhada: bool, registrada: bool, duravel: bool,
                   motivo_duravel: str | None, avisos: list[str], saida: Saida) -> None:
    porte = ("devolva este sessao_id em toda chamada de tool e na proxima abertura desta "
             "conversa")
    obj = {
        "sessao_id": sid, "cunhada_agora": cunhada,
        "sujeito": ch.get("sujeito"), "cadeira": ch.get("cadeira"),
        "canonizada": ch.get("canonizada"), "autorizada_por": ch.get("autorizada_por"),
        "ordem_id": ch.get("ordem_id"), "superficie": ch.get("superficie"),
        "aberto_em": ch.get("aberto_em"),
        "registrada": registrada, "duravel": duravel,
        "porte": porte, "avisos": avisos,
    }
    if ch.get("origem_sessao"):
        obj["origem_sessao"] = ch["origem_sessao"]
    for k in ATRIBUTOS_AGENTE:
        if ch.get(k):
            obj[k] = ch[k]
    if motivo_duravel:
        obj["duravel_motivo"] = motivo_duravel
        obj["avisos"] = [*avisos, f"registro durável indisponível: {motivo_duravel}"]
    if not ch.get("canonizada"):
        obj["regime"] = "nao canonizada — escrita restrita a cura"
    if saida.json:
        print(json.dumps(obj, ensure_ascii=False))
        return
    suj = str(ch.get("sujeito") or "")
    suj_disp = suj[:8] if _uuid_valido(suj) else suj
    print(f"sessao_id: {sid}   cunhada_agora: {'true' if cunhada else 'false'}")
    print(f"sujeito: {suj_disp}   cadeira: {ch.get('cadeira')}   canonizada: "
          f"{'true' if ch.get('canonizada') else 'false'}")
    print(f"autorizada_por: {ch.get('autorizada_por')}")
    print(f"ordem_id: {ch.get('ordem_id')}")
    if ch.get("origem_sessao"):
        print(f"origem_sessao: {ch['origem_sessao']}")
    for k in ATRIBUTOS_AGENTE:
        if ch.get(k):
            print(f"{k}: {ch[k]}")
    dur = "true" if duravel else f"false ({motivo_duravel})"
    print(f"registrada: {'true' if registrada else 'false'}   duravel: {dur}")
    if not ch.get("canonizada"):
        print("regime: nao canonizada — escrita restrita a cura")
    print(f"porte: {porte}")
    for a in avisos:
        print(f"(aviso: {a})")


def ato_abrir(cadeira: str, sessao_id: str | None, saida: Saida, dry_run: bool = False,
              origem: str | None = None, agente: dict | None = None,
              autorizada_por: str | None = None) -> int:
    if not (cadeira or "").strip():
        cadeira = (os.environ.get("PLATAFIRMA_CADEIRA") or "").strip()
    if not (cadeira or "").strip():
        voc_vazio, _ = _vocabulario()
        if voc_vazio:
            validas = " ".join(sorted(voc_vazio))
            return saida.erro(
                f"uso: sessao abrir <cadeira> [--sessao-id <uuid>] [--origem <uuid>] [--dry-run] [--json] — validas: {validas}",
                2,
                cadeiras_validas=sorted(voc_vazio),
            )
        return saida.erro("uso: sessao abrir <cadeira> [--sessao-id <uuid>] [--origem <uuid>] [--dry-run] [--json]", 2)
    sid_portado = None
    if sessao_id is not None:
        sid_portado = _uuid_valido(sessao_id)
        if not sid_portado:
            return saida.erro(f"--sessao-id {sessao_id!r} nao e RFC-4122 — chame sem `--sessao-id` "
                              "para cunhar uma sessao nova; um id invalido nunca vira id novo "
                              "", 2)
    origem_sessao = None
    if origem is not None:
        origem_sessao = _uuid_valido(origem)
        if not origem_sessao:
            return saida.erro(f"--origem {origem!r} nao e RFC-4122 — passe o sessao_id da sessao de quem "
                              "chamou; sem ele, abra sem `--origem`", 2)
        if sid_portado and origem_sessao == sid_portado:
            return saida.erro("--origem igual a --sessao-id: a sessao nao e origem de si mesma", 2)
    if agente is not None:
        ruim = [k for k, v in agente.items() if not re.fullmatch(r"[a-z][a-z0-9_-]*", v or "")]
        if ruim:
            return saida.erro("--agente, --em-nome-de e --conta vao juntos e cada um e um slug (minusculas, digitos, "
                              "- e _); fora do molde: " + ", ".join(ruim), 2)
    sujeito = (os.environ.get("PF_SUJEITO") or "").strip()
    if not sujeito:
        if dry_run:
            sujeito = "sonda"
        else:
            return saida.erro("sem sujeito: a porta nao autenticou — PF_SUJEITO vem do fluxo OAuth "
                              "(sub do token), nunca de arquivo ou unit (spec_acesso §2)", 3)
    avisos: list[str] = []
    voc, motivo_org = _vocabulario()
    canonizada = False
    if voc is not None:
        slug = _canoniza(cadeira, voc)
        if not slug:
            validas = " ".join(sorted(voc))
            return saida.erro(f"cadeira desconhecida: {cadeira!r} — validas: {validas}", 2,
                              cadeiras_validas=sorted(voc))
        canonizada = True
    else:
        slug = _sufixo(cadeira)
        if not slug:
            return saida.erro("uso: sessao abrir <cadeira>", 2)
        avisos.append(f"organizacao muda ({motivo_org}): cadeira gravada como rotulo "
                      f"normalizado {slug!r}, canonizada: false — regime restrito ate "
                      "a republicacao da abertura")
    decisao_porta = (autorizada_por or os.environ.get("PF_SESSAO_AUTORIZADA_POR") or "").strip()
    if decisao_porta:
        autorizada_por = decisao_porta
    elif dry_run:
        autorizada_por = "dry-run@sonda"
    else:
        return saida.erro(
            f"nao autorizado: abertura de sessao:{slug} exige decisao da porta "
            "(--autorizada-por ou PF_SESSAO_AUTORIZADA_POR); a decisao de acesso e tomada no core",
            4,
        )
    sid = sid_portado or str(uuid.uuid4())
    cunhada = sid_portado is None
    ordem_id = f"o{time.strftime('%Y%m%dT%H%M%S', time.gmtime())}-{uuid.uuid4().hex[:6]}"
    if dry_run:
        ch = {"sujeito": sujeito, "cadeira": slug, "canonizada": canonizada,
              "autorizada_por": autorizada_por, "ordem_id": ordem_id,
              "superficie": _superficie(), "aberto_em": _agora_iso(),
              "origem": "sessao abrir --dry-run"}
        if origem_sessao:
            ch["origem_sessao"] = origem_sessao
        if agente:
            ch.update(agente)
        motivo_dur = "dry-run: nao gravado"
        _imprime_abrir(ch, sid, cunhada, False, False, motivo_dur, avisos, saida)
        return 0

    rc_mem, motivo_mem = _msgmem()
    if rc_mem is None:
        return saida.erro(f"{_cura_msgmem(motivo_mem)} — sessao_id cunhado e NAO gravado: {sid}",
                          3, sessao_id=sid)
    chave = f"sessao:{sid}"
    try:
        existente = _le_chave(rc_mem, sid) if sid_portado else None
        if existente and existente.get("cadeira") and existente.get("cadeira") != slug:
            antiga = existente.get("cadeira")
            return saida.erro(f"sessao {sid} e da cadeira {antiga}, nao de {slug}: reabrir nao troca "
                              f"de cadeira — para abrir {slug}, chame sem `--sessao-id` (cunha uma "
                              f"sessao nova); para seguir em {antiga}, reabra com cadeira={antiga}",
                              4, sessao_id=sid, cadeira_da_sessao=antiga)
        if existente:
            campos_novos: dict[str, Any] = {"ordem_id": ordem_id}
            if not existente.get("sujeito"):
                campos_novos["sujeito"] = sujeito
            if existente.get("canonizada") is None or existente.get("origem") == "reidratada":
                campos_novos["canonizada"] = canonizada
            if not existente.get("autorizada_por") or existente.get("autorizada_por") in ("-", "reidratada"):
                campos_novos["autorizada_por"] = autorizada_por
            if origem_sessao and not existente.get("origem_sessao"):
                campos_novos["origem_sessao"] = origem_sessao
            for k, v in (agente or {}).items():
                if k not in existente:
                    campos_novos[k] = v
            _grava_chave(rc_mem, sid, campos_novos, TTL_SESSAO_S)
        else:
            ch = {"sujeito": sujeito, "cadeira": slug, "canonizada": canonizada,
                  "autorizada_por": autorizada_por, "ordem_id": ordem_id,
                  "superficie": _superficie(), "aberto_em": _agora_iso(),
                  "origem": "sessao abrir"}
            if origem_sessao:
                ch["origem_sessao"] = origem_sessao
            if agente:
                ch.update(agente)
            _grava_chave(rc_mem, sid, ch, TTL_SESSAO_S)
    except Exception as e:  # noqa: BLE001
        return saida.erro(f"{_cura_msgmem(type(e).__name__)} — sessao_id cunhado e NAO gravado: {sid}",
                          3, sessao_id=sid)
    if origem_sessao:
        try:
            viva = _le_chave(rc_mem, origem_sessao) is not None
        except Exception:  # noqa: BLE001
            viva = True
        if not viva:
            avisos.append(f"origem {origem_sessao} nao esta viva no msg-mem: ligada mesmo assim")
    motivo_dur = _registra_duravel(sid, slug, sujeito, ordem_id)
    try:
        relida = _le_chave(rc_mem, sid) or {}
    except Exception as e:  # noqa: BLE001
        relida = {}
        motivo_rel = type(e).__name__
    else:
        motivo_rel = "chave ausente ou diferente"
    if relida.get("cadeira") != slug or relida.get("ordem_id") != ordem_id:
        return saida.erro(f"gravou e nao confirma: {chave} ({motivo_rel}) — msg-mem instavel; "
                          f"sessao_id: {sid}", 5, sessao_id=sid)
    _imprime_abrir(relida, sid, cunhada, True, motivo_dur is None, motivo_dur, avisos, saida)
    return 0


def _marca_encerrada(sids: list[str]) -> None:
    if not sids:
        return
    try:
        import psycopg
    except ImportError as e:
        print(f"sessao.sessao.encerrada_em nao gravada: {type(e).__name__}", file=sys.stderr)
        return
    senha, motivo = _senha_pg()
    if not senha:
        print(f"sessao.sessao.encerrada_em nao gravada: {motivo}", file=sys.stderr)
        return
    dsn = f"host=127.0.0.1 port={PG_PORTA} dbname=sessao user=sessao password={senha}"
    try:
        with psycopg.connect(dsn, connect_timeout=3) as con, con.cursor() as cur:
            cur.execute(
                "UPDATE sessao.sessao SET encerrada_em = now() "
                "WHERE sessao_id = ANY(%s::uuid[]) AND encerrada_em IS NULL",
                (sids,))
            con.commit()
    except Exception as e:  # noqa: BLE001
        print(f"sessao.sessao.encerrada_em nao gravada: {type(e).__name__}", file=sys.stderr)


# ------------------------------------------------------------------ ato: ver
def ato_ver(sessao_id: str, saida: Saida) -> int:
    sid = _uuid_valido(sessao_id)
    if not sid:
        return saida.erro("uso: sessao ver <sessao_id> — <sessao_id> e um uuid RFC-4122", 2)
    rc_mem, motivo = _msgmem()
    if rc_mem is None:
        return saida.erro(_cura_msgmem(motivo), 3)
    try:
        ch = _le_chave(rc_mem, sid)
    except Exception as e:  # noqa: BLE001
        return saida.erro(_cura_msgmem(type(e).__name__), 3)
    if ch is None and _reidratar_mod is not None:
        try:
            ch = _reidratar_mod.reidratar(sid, rc_mem, _roda, pg_porta=PG_PORTA)
        except Exception:  # noqa: BLE001
            ch = None
    if ch is None:
        enc_em = None
        if _reidratar_mod is not None and hasattr(_reidratar_mod, "encerrada_em_duravel"):
            try:
                val = _reidratar_mod.encerrada_em_duravel(sid, _roda, pg_porta=PG_PORTA)
                if isinstance(val, str) and val:
                    enc_em = val
            except Exception:  # noqa: BLE001
                enc_em = None
        if enc_em:
            return saida.erro(f"sessao {sid} encerrada em {enc_em} — nao existe mais no msg-mem "
                              f"{MEM_HOST}:{MEM_PORTA} (TTL {TTL_SESSAO_S // 3600} h); "
                              "vizinho: `sessao listar`", 1,
                              encerrada=True, encerrada_em=enc_em,
                              varrido=f"msg-mem {MEM_HOST}:{MEM_PORTA}", vizinho="sessao listar")
        return saida.erro(f"sessao {sid} nao existe ou expirou — varrido: msg-mem "
                          f"{MEM_HOST}:{MEM_PORTA} (TTL {TTL_SESSAO_S // 3600} h); "
                          "vizinho: `sessao listar`", 1,
                          varrido=f"msg-mem {MEM_HOST}:{MEM_PORTA}", vizinho="sessao listar")
    regime = None if ch.get("canonizada", True) else "nao canonizada — escrita restrita a cura"
    if saida.json:
        obj = {"sessao_id": sid, **ch}
        if regime:
            obj["regime"] = regime
        print(json.dumps(obj, ensure_ascii=False))
        return 0
    suj = str(ch.get("sujeito") or "")
    print(f"sessao_id: {sid}")
    print(f"sujeito: {suj[:8] if _uuid_valido(suj) else suj or '-'}   cadeira: {ch.get('cadeira')}"
          f"   canonizada: {'true' if ch.get('canonizada', True) else 'false'}")
    print(f"autorizada_por: {ch.get('autorizada_por') or '-'}")
    print(f"ordem_id: {ch.get('ordem_id') or '-'}   superficie: {ch.get('superficie') or '-'}"
          f"   aberto_em: {ch.get('aberto_em') or '-'}")
    if ch.get("origem_sessao"):
        print(f"origem_sessao: {ch['origem_sessao']}")
    for k in ATRIBUTOS_AGENTE:
        if ch.get(k):
            print(f"{k}: {ch[k]}")
    if regime:
        print(f"regime: {regime}")
    return 0


# ------------------------------------------------------------------ ato: listar
def ato_listar(cadeira: str | None, saida: Saida) -> int:
    rc_mem, motivo = _msgmem()
    if rc_mem is None:
        return saida.erro(_cura_msgmem(motivo), 3)
    filtro = _sufixo(cadeira) if cadeira else None
    linhas = []
    try:
        for chave in rc_mem.scan_iter(match="sessao:*", count=200):
            sid = chave.split(":", 1)[1]
            if not _uuid_valido(sid):
                continue
            ch = _le_chave(rc_mem, sid) or {}
            if filtro and ch.get("cadeira") != filtro:
                continue
            linhas.append({"sessao_id": sid, "cadeira": ch.get("cadeira"),
                           "sujeito": ch.get("sujeito"), "aberto_em": ch.get("aberto_em"),
                           "canonizada": ch.get("canonizada", True),
                           **({"origem_sessao": ch["origem_sessao"]} if ch.get("origem_sessao") else {})})
    except Exception as e:  # noqa: BLE001
        return saida.erro(_cura_msgmem(type(e).__name__), 3)
    linhas.sort(key=lambda l: (l.get("cadeira") or "", l.get("aberto_em") or ""))
    if saida.json:
        print(json.dumps({"sessoes": linhas,
                          "motivo": None if linhas else "nenhuma sessao viva"}, ensure_ascii=False))
        return 0
    if not linhas:
        print("motivo: nenhuma sessao viva" + (f" na cadeira {filtro}" if filtro else ""))
        return 0
    for l in linhas:
        suj = str(l.get("sujeito") or "")
        print(f"{l['sessao_id']}  {l.get('cadeira') or '-':<20} "
              f"{suj[:8] if _uuid_valido(suj) else (suj or '-'):<10} {l.get('aberto_em') or '-'}"
              + ("" if l.get("canonizada", True) else "  [nao canonizada]"))
    return 0


# ------------------------------------------------------------------ ato: encerrar
def ato_encerrar(sessao_id: str, saida: Saida) -> int:
    sid = _uuid_valido(sessao_id)
    if not sid:
        return saida.erro("uso: sessao encerrar <sessao_id> — <sessao_id> e um uuid RFC-4122", 2)
    rc_mem, motivo = _msgmem()
    if rc_mem is None:
        return saida.erro(_cura_msgmem(motivo), 3)
    chaves = [f"sessao:{sid}", f"ledger:{sid}", f"giro:{sid}"]
    try:
        if not rc_mem.exists(chaves[0]):
            return saida.erro(f"sessao {sid} ja nao existia no msg-mem", 1)
        apagadas = [c for c in chaves if rc_mem.delete(c)]
        if rc_mem.exists(chaves[0]):
            return saida.erro(f"DEL sem confirmacao: {chaves[0]} ainda existe", 5)
    except Exception as e:  # noqa: BLE001
        return saida.erro(_cura_msgmem(type(e).__name__), 3)
    _marca_encerrada([sid])
    if saida.json:
        print(json.dumps({"encerrada": sid, "apagadas": apagadas,
                          "duravel": "sessao.sessao fica"}, ensure_ascii=False))
    else:
        print(f"encerrada: {sid}   apagadas: {' '.join(apagadas)}   (registro duravel fica)")
    return 0


# ------------------------------------------------------------------ ato: limpar
def ato_limpar(dry_run: bool, saida: Saida) -> int:
    rc_mem, motivo = _msgmem()
    if rc_mem is None:
        return saida.erro(_cura_msgmem(motivo), 3)
    varridas = 0
    sondas = 0
    apagadas = 0
    preservadas = 0
    chaves_para_apagar: list[str] = []
    try:
        for chave in rc_mem.scan_iter(match="sessao:*", count=500):
            varridas += 1
            sid = chave.split(":", 1)[1]
            if not _uuid_valido(sid):
                continue
            ch = _le_chave(rc_mem, sid)
            if ch is None:
                continue
            sujeito = str(ch.get("sujeito") or "").strip()
            if sujeito and sujeito != "-":
                preservadas += 1
            else:
                sondas += 1
                chaves_para_apagar.append(sid)

        if not dry_run:
            for sid in chaves_para_apagar:
                rc_mem.delete(f"sessao:{sid}", f"ledger:{sid}", f"giro:{sid}")
                apagadas += 1
            _marca_encerrada(chaves_para_apagar)
        else:
            apagadas = 0
    except Exception as e:  # noqa: BLE001
        return saida.erro(_cura_msgmem(type(e).__name__), 3)

    if saida.json:
        print(json.dumps({
            "dry_run": dry_run,
            "varridas": varridas,
            "sondas_encontradas": sondas,
            "apagadas": apagadas,
            "preservadas": preservadas,
        }, ensure_ascii=False))
    else:
        modo = " (dry-run)" if dry_run else ""
        print(f"limpar{modo}: varridas={varridas} sondas_encontradas={sondas} "
              f"apagadas={apagadas} preservadas={preservadas}")
    return 0


# ------------------------------------------------------------------ ato: limpar --rascunho
ORDEM_VALIDA = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
PLANO_MAX = 40


def _instancia() -> Path:
    return Path(os.environ.get("PLATAFIRMA_INSTANCIA") or "/srv/platafirma/casa")


def _inventario(alvo: Path) -> list[tuple[Path, int]]:
    if not alvo.is_dir():
        return [(alvo, alvo.lstat().st_size)]
    itens: list[tuple[Path, int]] = []
    for pai, dirs, arqs in os.walk(alvo, followlinks=False):
        for nome in arqs + [d for d in dirs if (Path(pai) / d).is_symlink()]:
            p = Path(pai) / nome
            try:
                itens.append((p, p.lstat().st_size))
            except OSError:
                itens.append((p, 0))
    return sorted(itens)


def ato_limpar_rascunho(subpasta: str, apply: bool, saida: Saida) -> int:
    ordem = (os.environ.get("PF_ORDEM_ID") or "").strip()
    if not ORDEM_VALIDA.fullmatch(ordem):
        return saida.erro(f"sem PF_ORDEM_ID valido ({ordem!r}): a raiz do rascunho e "
                          "<instancia>/var/tmp/<PF_ORDEM_ID da chamada>; sem ela nada e apagado", 4)
    tmp = Path(os.path.realpath(_instancia() / "var" / "tmp"))
    raiz = tmp / ordem
    if raiz.is_symlink():
        return saida.erro(f"{raiz} e link simbolico: a raiz do rascunho nao pode apontar para fora de "
                          f"{tmp}; nada apagado", 4)
    sub = (subpasta or "").strip()
    alvo = Path(os.path.realpath(raiz / sub)) if sub else raiz
    if alvo == raiz:
        return saida.erro(f"recusado: {sub!r} resolve para a raiz inteira do rascunho ({raiz}); nomeie "
                          "uma subpasta (ex.: `sessao limpar --rascunho reextrair`); nada apagado", 4)
    if raiz not in alvo.parents:
        return saida.erro(f"recusado: {sub!r} resolve para {alvo}, fora da raiz do rascunho ({raiz}); "
                          "`..`, caminho absoluto e link simbolico que saem da raiz nao valem; nada apagado", 4)
    if not os.path.lexists(alvo):
        return saida.erro(f"{alvo} nao existe; nada a apagar (raiz do rascunho: {raiz})", 1)
    itens = _inventario(alvo)
    total = sum(b for _, b in itens)
    rel = [str(p.relative_to(raiz)) for p, _ in itens]
    if apply:
        try:
            shutil.rmtree(alvo) if alvo.is_dir() else alvo.unlink()
        except OSError as e:
            return saida.erro(f"falhou ao apagar {alvo}: {type(e).__name__}: {e}", 5)
        if os.path.lexists(alvo):
            return saida.erro(f"apagou sem confirmacao: {alvo} ainda existe", 5)
    if saida.json:
        print(json.dumps({"rascunho": str(alvo.relative_to(raiz)), "raiz": str(raiz), "alvo": str(alvo),
                          "apagado": apply, "arquivos": len(itens), "bytes": total,
                          "plano": rel[:PLANO_MAX], "omitidos": max(0, len(rel) - PLANO_MAX)},
                         ensure_ascii=False))
        return 0
    print(f"rascunho: {'apagou' if apply else 'plano (nada apagado)'} {alvo}")
    for r in rel[:PLANO_MAX]:
        print(f"  {r}")
    if len(rel) > PLANO_MAX:
        print(f"  ... e mais {len(rel) - PLANO_MAX}")
    print(f"total: {len(itens)} arquivo(s), {total} bytes"
          + ("" if apply else f" — para apagar: sessao limpar --rascunho {sub} --apply"))
    return 0


# ------------------------------------------------------------------ ato: longjob
HERANCA_LONGJOB = (("agente", "PF_AGENTE"), ("em_nome_de", "PF_EM_NOME_DE"),
                   ("conta_agente", "PF_CONTA_AGENTE"), ("origem_sessao", "PF_ORIGEM_SESSAO"))


def _heranca_longjob(env: dict[str, str]) -> dict[str, str]:
    sid = _uuid_valido(env.get("PF_SESSAO"))
    if not sid:
        return {}
    rc_mem, motivo = _msgmem()
    if rc_mem is None:
        print(f"longjob: atributos do agente nao herdados — {_cura_msgmem(motivo)}", file=sys.stderr)
        return {}
    try:
        ch = _le_chave(rc_mem, sid) or {}
    except Exception as e:  # noqa: BLE001
        print(f"longjob: atributos do agente nao herdados — {_cura_msgmem(type(e).__name__)}", file=sys.stderr)
        return {}
    return {var: ch[k] for k, var in HERANCA_LONGJOB
            if isinstance(ch.get(k), str) and ch[k].strip() and not (env.get(var) or "").strip()}


def ato_longjob(resto: list[str]) -> int:
    alvo = _REPO_REAL / "bin" / "_sessao" / "longjob"
    if not alvo.is_file():
        print(f"longjob: nao existe {alvo}", file=sys.stderr)
        return 3
    env = _env_verbo()
    if resto[:1] == ["run"]:
        env.update(_heranca_longjob(env))
    os.execve(str(alvo), [str(alvo), *resto], env)
    return 3  # pragma: no cover


# ------------------------------------------------------------------ CLI
USO = """uso:
  sessao abrir     <cadeira> [--sessao-id <uuid>] [--origem <uuid>] [--agente <slug> --em-nome-de <cadeira> --conta <unix>] [--dry-run] [--json]
  sessao ver       <sessao_id> [--json]
  sessao listar    [--cadeira <slug>] [--json]
  sessao encerrar  <sessao_id>
  sessao limpar    [--dry-run] [--json]
  sessao limpar    --rascunho <subpasta> [--apply] [--json]
  sessao longjob   <args...>"""


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    como_json = "--json" in argv
    saida = Saida(como_json)
    if not argv or argv[0] in ("-h", "--help", "--ajuda"):
        print(USO, file=sys.stderr if not argv else sys.stdout)
        return 2 if not argv else 0
    ato = argv[0]
    if ato not in ATOS:
        return saida.erro(f"ato desconhecido: {ato!r} — atos: {' '.join(ATOS)}", 2)
    if ato == "longjob":
        return ato_longjob(argv[1:])
    p = argparse.ArgumentParser(prog=f"sessao {ato}", add_help=False)
    if ato == "abrir":
        p.add_argument("cadeira", nargs="?")
        p.add_argument("--cadeira", dest="cadeira_opt", default=None)
        p.add_argument("--sessao-id", dest="sessao_id", default=None)
        p.add_argument("--origem", dest="origem", default=None)
        p.add_argument("--agente", dest="agente", default=None)
        p.add_argument("--em-nome-de", dest="em_nome_de", default=None)
        p.add_argument("--conta", dest="conta_agente", default=None)
        p.add_argument("--autorizada-por", dest="autorizada_por", default=None)
        p.add_argument("--dry-run", action="store_true")
    elif ato in ("ver", "encerrar"):
        p.add_argument("sessao_id", nargs="?")
    elif ato == "listar":
        p.add_argument("--cadeira", default=None)
    elif ato == "limpar":
        p.add_argument("--dry-run", action="store_true")
        p.add_argument("--rascunho", nargs="?", const="", default=None)
        p.add_argument("--apply", action="store_true")
    p.add_argument("--json", action="store_true")
    try:
        ns, sobra = p.parse_known_args(argv[1:])
    except SystemExit:
        return saida.erro(USO, 2)
    if sobra:
        return saida.erro(f"sessao {ato}: argumento desconhecido {sobra[0]!r}\n{USO}", 2)
    if ato == "abrir":
        agente = None
        if ns.agente or ns.em_nome_de or ns.conta_agente:
            agente = {"agente": ns.agente or "", "em_nome_de": ns.em_nome_de or "",
                      "conta_agente": ns.conta_agente or ""}
        cad_arg = ns.cadeira or ns.cadeira_opt or os.environ.get("PLATAFIRMA_CADEIRA") or ""
        return ato_abrir(cad_arg, ns.sessao_id, saida, dry_run=ns.dry_run, origem=ns.origem,
                         agente=agente, autorizada_por=ns.autorizada_por)
    if ato == "ver":
        return ato_ver(ns.sessao_id or "", saida)
    if ato == "listar":
        return ato_listar(ns.cadeira, saida)
    if ato == "encerrar":
        return ato_encerrar(ns.sessao_id or "", saida)
    if ns.rascunho is not None:
        if ns.apply and ns.dry_run:
            return saida.erro("sessao limpar --rascunho: --apply e --dry-run se contradizem; sem --apply "
                              "ja e plano", 2)
        return ato_limpar_rascunho(ns.rascunho, ns.apply, saida)
    if ns.apply:
        return saida.erro("sessao limpar: --apply so vale com --rascunho <subpasta>; o limpar de "
                          "sondas apaga sem ele (use --dry-run para ver)", 2)
    return ato_limpar(dry_run=ns.dry_run, saida=saida)


if __name__ == "__main__":
    sys.exit(main())
