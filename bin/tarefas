#!/usr/bin/env bash
# tarefas — cliente do rastreador de trabalho da PlataFirma.
# capacidade: trabalho
# dono: claudinho-TI
# Backend: `platafirma-rastreador` (API própria), desde 16/08/2026. O Vikunja saiu.
#
# Loopback, e não a rota pública: `tarefas.platafirma.org` serve a superfície HUMANA
# atrás do gate do control-plane, e agente não atravessa oauth2-proxy. O agente entra
# pelo loopback da máquina, que já é a fronteira dele (card #469).
#
# SEM CREDENCIAL, por desenho: não há auth no código do módulo. Quem escreve declara o
# nome no cabeçalho de sujeito, e é ele que a transição carimba — `PF_CADEIRA` vira
# `x-auth-request-preferred-username`. Ausente, a escrita entra como anônima.
set -euo pipefail

# `/api` desde o contract do #196: a tela do rastreador saiu de dentro da imagem da API
# e virou servico proprio, e quem separa os dois e o gate da borda, que roteia por
# prefixo de path. A arvore de dado deixou de responder na raiz — sem o prefixo aqui,
# este verbo quebraria para toda cadeira no mesmo minuto.
# O loopback continua sendo a porta do agente (card #469): a borda gateia a superficie
# HUMANA, e um Bearer de agente nao atravessa oauth2-proxy.
BASE="${TAREFAS_BASE:-http://127.0.0.1:8120/api}"
QUEM="${PF_CADEIRA:-}"

uso() {
  cat >&2 <<'FIM'
uso:
  tarefas listar [--cadeira <c>] [--estado <e>] [--nivel <n>] [--json]
                                          itens abertos (fase != terminal)
  tarefas listar-tudo [mesmos filtros]    inclui os terminais
  tarefas ler <id>                        item em texto, com ancestrais e corpo
  tarefas criar "<título>" [--desc "<txt>"|--desc-stdin]
                [--nivel épico|feature|story|task] [--cadeira <c>] [--pai <id>]
  tarefas comentar <id> ["<txt>"]         anexa ao corpo do item; sem texto, lê stdin
  tarefas fechar <id> [--como <estado>]   default: entregue
  tarefas sub <pai> <filho>               declara <filho> filho de <pai>
  tarefas estados                         os estados do registro, com fase
  tarefas api <MÉTODO> <caminho>          escotilha, sem corpo
  tarefas api-corpo <MÉTODO> <caminho>    escotilha, corpo JSON em stdin

NÃO HÁ PROJETO neste modelo. `46` e `1` eram do Vikunja; o recorte agora é por eixo
(cadeira, estado, nível). Chamada antiga com projeto no lugar do primeiro argumento
segue funcionando: o número é ignorado, com aviso em stderr.
FIM
  exit 2
}

# --- transporte -------------------------------------------------------------

_hdr_sujeito() { [ -n "$QUEM" ] && printf '%s' "x-auth-request-preferred-username: $QUEM"; }

busca() { # busca MÉTODO /caminho
  if [ -n "$QUEM" ]; then
    curl -sfS -X "$1" "$BASE$2" -H "x-auth-request-preferred-username: $QUEM"
  else
    curl -sfS -X "$1" "$BASE$2"
  fi
}

envia() { # envia MÉTODO /caminho  (corpo JSON em stdin)
  if [ -n "$QUEM" ]; then
    curl -sfS -X "$1" "$BASE$2" -H 'Content-Type: application/json' \
         -H "x-auth-request-preferred-username: $QUEM" -d @-
  else
    curl -sfS -X "$1" "$BASE$2" -H 'Content-Type: application/json' -d @-
  fi
}

# --- corpo: o rastreador guarda HTML, como o Vikunja guardava ---------------

para_html() {
  python3 -c 'import html,sys
t = html.escape(sys.stdin.read().strip())
print("".join("<p>%s</p>" % b.replace("\n", "<br>") for b in t.split("\n\n") if b.strip()))'
}

para_texto() {
  sed -e 's#</p>#\n#g' -e 's#<br */\?>#\n#g' -e 's#</h[0-9]>#\n#g' \
      -e 's#<li>#  - #g' -e 's#</li>#\n#g' -e 's#</pre>#\n#g' \
      -e 's#<[^>]*>##g' \
      -e 's#&lt;#<#g' -e 's#&gt;#>#g' -e 's#&quot;#"#g' -e "s@&#39;@'@g" -e 's#&amp;#\&#g' | cat -s
}

# Argumento numérico solto na posição do antigo <projeto>: ignora e avisa. Existe para que
# `tarefas listar 46` e `tarefas criar 46 "título"` — que estão escritos em manifesto, em
# card e na cabeça de toda cadeira — não quebrem no dia da virada.
descarta_projeto() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) echo "aviso: '$1' era projeto do Vikunja e não existe mais; ignorado." >&2; return 0 ;;
  esac
}

# --- filtros ----------------------------------------------------------------

# A API filtra por cadeira, estado e nível. "Aberto" NÃO é filtro dela: é a fase do estado,
# que vem em cada item (`estado_fase`). Peneirar aqui e não lá é o certo — inventar um
# filtro `aberto=` no servidor duplicaria a régua de fase em dois lugares.
monta_query() { # monta_query "$@" -> ecoa a query string e devolve o resto em RESTO[]
  local q="" a
  RESTO=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --cadeira) q="$q&cadeira=$2"; shift 2 ;;
      --estado)  q="$q&estado=$2";  shift 2 ;;
      --nivel)   q="$q&nivel=$2";   shift 2 ;;
      --json)    RESTO+=("--json"); shift ;;
      *)         RESTO+=("$1"); shift ;;
    esac
  done
  printf '%s' "${q:+${q:1}}"
}

_tem_json() { local a; for a in "$@"; do [ "$a" = "--json" ] && return 0; done; return 1; }

linhas() { # id, marca de terminal, título
  jq -r '.itens[] | "\(.id)\t\(if .estado_fase == "terminal" then "x" else " " end)\t\(.titulo)"'
}

listar() { # listar [filtros] [--json]   — só os abertos
  local q; q=$(monta_query "$@")
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  corpo=$(printf '%s' "$corpo" | jq '{itens: [.itens[] | select(.estado_fase != "terminal")], estados, total} | .total = (.itens|length)')
  if _tem_json "${RESTO[@]:-}"; then printf '%s\n' "$corpo"; else printf '%s' "$corpo" | linhas; fi
}

listar_tudo() { # listar_tudo [filtros] [--json]
  local q; q=$(monta_query "$@")
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  if _tem_json "${RESTO[@]:-}"; then printf '%s\n' "$corpo"; else printf '%s' "$corpo" | linhas; fi
}

estados() {
  busca GET /registro | jq -r '(.estados // .)[] | "\(.estado)\t\(.fase)\t\(.nome)"'
}

# --- item -------------------------------------------------------------------

# `#N` e `N` são o MESMO número: o rastreador tem um identificador só por item, e é essa a
# razão de o Vikunja ter saído. O `#` é aceito porque a fila e os cards o escrevem.
so_id() { printf '%s' "${1#\#}"; }

ler() {
  local id; id=$(so_id "$1")
  busca GET "/itens/$id" | jq -r '
    "# \(.titulo)",
    "#\(.id) · \(.nivel_nome) · \(.estado_nome) (\(.estado_fase)) · cadeira: \(.cadeira // "—")"
    + (if (.ancestrais|length) > 0 then "\n  em: " + ([.ancestrais[] | "#\(.id) \(.titulo)"] | join(" > ")) else "" end),
    "",
    (.descricao // "")' | para_texto
}

criar() {
  descarta_projeto "${1:-}" && shift
  local titulo="${1:?uso: tarefas criar \"<título>\" [opções]}"; shift || true
  local desc="" nivel="task" cadeira="$QUEM" pai="" classe="planejado"
  while [ $# -gt 0 ]; do
    case "$1" in
      --desc)       desc="$2"; shift 2 ;;
      --desc-stdin) desc="$(cat)"; shift ;;
      --nivel)      nivel="$2"; shift 2 ;;
      --cadeira)    cadeira="$2"; shift 2 ;;
      --pai)        pai=$(so_id "$2"); shift 2 ;;
      --incidente)  classe="incidente"; shift ;;
      --prio)       echo "aviso: --prio não existe neste modelo; ignorado." >&2; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  # A API quer o nível como INTEIRO — a camada é ordem, e é ela que a restrição de pai
  # compara. O nome é o que a pessoa escreve; a tradução é aqui, num lugar só.
  local n
  case "$nivel" in
    épico|epico|0)   n=0 ;;
    feature|1)       n=1 ;;
    story|2)         n=2 ;;
    task|3)          n=3 ;;
    *) echo "nível desconhecido: $nivel (épico, feature, story, task)" >&2; exit 2 ;;
  esac
  local html=""
  [ -n "$desc" ] && html="$(printf '%s' "$desc" | para_html)"
  # `estado` é obrigatório no POST: item nasce declarando onde entra no funil, e não há
  # default do servidor. `captada` é a boca do funil para planejado; incidente entra em
  # `aberto` se o registro o tiver, e a recusa da API nomeia o estado válido quando não.
  local est="${PF_ESTADO_INICIAL:-captada}"
  jq -n --arg t "$titulo" --arg d "$html" --argjson n "$n" --arg c "$cadeira" \
        --arg p "$pai" --arg cl "$classe" --arg e "$est" \
     '{titulo:$t, nivel:$n, classe:$cl, estado:$e}
      + (if $d == "" then {} else {descricao:$d} end)
      + (if $c == "" then {} else {cadeira:$c} end)
      + (if $p == "" then {} else {pai:($p|tonumber)} end)' \
    | envia POST /itens \
    | jq -r '"item \(.id) criado: \(.titulo)"'
}

# COMENTÁRIO É TEXTO NO CORPO, por ordem do dono (16/08/2026). O modelo do rastreador não
# tem entidade de comentário, e a migração do acervo já pôs os comentários velhos dentro de
# `descricao` sob marcador. Escrever novo do mesmo jeito mantém uma forma só — e o dia em
# que comentário virar entidade, há um marcador único para varrer.
comentar() {
  local id; id=$(so_id "$1"); local txt="${2:-$(cat)}"
  local atual novo
  atual=$(busca GET "/itens/$id" | jq -r '.descricao // ""')
  novo=$(printf '%s\n\n<p>--- comentário · %s · %s ---</p>\n%s' \
         "$atual" "${QUEM:-anônimo}" "$(date -Iseconds)" "$(printf '%s' "$txt" | para_html)")
  jq -n --arg d "$novo" '{descricao:$d}' | envia PATCH "/itens/$id" \
    | jq -r '"comentário anexado ao item \(.id)"'
}

fechar() {
  local id; id=$(so_id "$1"); shift || true
  local como="entregue"
  [ "${1:-}" = "--como" ] && { como="$2"; shift 2; }
  jq -n --arg e "$como" '{estado:$e}' | envia PATCH "/itens/$id" \
    | jq -r '"item \(.id) → \(.estado_nome): \(.titulo)"'
}

# Filho declara o pai, e o pai tem de ser de nível estritamente MENOR — a restrição é do
# banco (`pai_nivel`, escrito por subconsulta), não deste verbo. Recusa vem nomeada da API.
subtarefa() {
  local pai filho; pai=$(so_id "$1"); filho=$(so_id "$2")
  jq -n --argjson p "$pai" '{pai:$p}' | envia PATCH "/itens/$filho" >/dev/null
  echo "item $filho agora é filho de $pai"
}

# --- despacho ---------------------------------------------------------------

cmd="${1:-}"; shift || uso

case "$cmd" in
  listar)      descarta_projeto "${1:-}" && shift; listar "$@" ;;
  listar-tudo) descarta_projeto "${1:-}" && shift; listar_tudo "$@" ;;
  ler)         ler "${1:?uso: tarefas ler <id>}" ;;
  criar)       criar "$@" ;;
  comentar)    comentar "${1:?uso: tarefas comentar <id> [\"<txt>\"]}" "${2:-$(cat)}" ;;
  fechar)      fechar "${1:?uso: tarefas fechar <id>}" "${@:2}" ;;
  sub)         subtarefa "${1:?pai}" "${2:?filho}" ;;
  estados)     estados ;;
  projetos)    echo "não há projeto neste modelo: o recorte é por eixo (cadeira, estado, nível)." >&2; exit 2 ;;
  api)         busca "${1:?método}" "${2:?caminho}" ;;
  api-corpo)   envia "${1:?método}" "${2:?caminho}" ;;
  *)           uso ;;
esac
