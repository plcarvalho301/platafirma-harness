#!/usr/bin/env bash
# tarefas — cliente do rastreador de trabalho da PlataFirma.
# capacidade: trabalho
# dono: gestao-estrategica
# use para: card, board, carteira, épico/feature/story, mover estado, sign-off
# atos: listar, listar-tudo, ler, criar, editar, modelo, comentar, comentarios, mover, fechar, apagar, assinar, dt, estados, sub
#
# Texto do controle (arq:0124 §3; arq:0125 U33; card #3446). Todo ato cai na face Entrega.
# Rótulo: verbo no infinitivo e objeto sem artigo, um verbo por tipo de ato (Listar uma coleção,
# Abrir um item; regra de produto, comentário #2216 do #3446). O objeto entra pelo slug, `{slug}`,
# quando o conceito é do tesauro; termo da casa (card, comentário, estado, débito técnico) vai
# escrito até o tesauro ter o braço da casa (arq:0124 §3, emenda de 12/10/2026). volta: diz se
# o efeito se desfaz; ato que só lê declara exatamente `sim — só lê`.
# face: listar=Entrega
# face: listar-tudo=Entrega
# face: ler=Entrega
# face: criar=Entrega
# face: editar=Entrega
# face: modelo=Entrega
# face: comentar=Entrega
# face: comentarios=Entrega
# face: mover=Entrega
# face: fechar=Entrega
# face: apagar=Entrega
# face: assinar=Entrega
# face: dt=Entrega
# face: estados=Entrega
# face: sub=Entrega
# rotulo: listar=Listar card aberto
# rotulo: listar-tudo=Listar card, fechado inclusive
# rotulo: ler=Abrir card
# rotulo: criar=Criar card
# rotulo: editar=Editar card
# rotulo: modelo=Abrir molde de card
# rotulo: comentar=Comentar card
# rotulo: comentarios=Listar comentário
# rotulo: mover=Mover card
# rotulo: fechar=Fechar card
# rotulo: apagar=Apagar card
# rotulo: assinar=Assinar card
# rotulo: dt=Administrar débito técnico
# rotulo: estados=Listar estado de card
# rotulo: sub=Subordinar card
# volta: listar=sim — só lê
# volta: listar-tudo=sim — só lê
# volta: ler=sim — só lê
# volta: criar=sim — tarefas apagar, enquanto o item está no funil
# volta: editar=nao
# volta: modelo=sim — só lê
# volta: comentar=nao
# volta: comentarios=sim — só lê
# volta: mover=sim — tarefas mover ao estado de antes, onde o fluxo deixa (a recusa diz para onde se pode ir)
# volta: fechar=nao
# volta: apagar=nao
# volta: assinar=nao
# volta: dt=nao
# volta: estados=sim — só lê
# volta: sub=nao
# Backend: `platafirma-rastreador` (API própria), desde 16/08/2026. O Vikunja saiu.
#
# Loopback, e não a rota pública: `tarefas.platafirma.org` serve a superfície HUMANA
# atrás do gate do control-plane, e agente não atravessa oauth2-proxy. O agente entra
# pelo loopback da máquina, que já é a fronteira dele (card #469).
#
# SEM CREDENCIAL, por desenho: não há auth no código do módulo. Quem escreve declara o
# nome no cabeçalho de sujeito, e é ele que a transição carimba — `PF_CADEIRA` vira
# `x-auth-request-preferred-username`. Ausente, a escrita entra como anônima.
set -euo pipefail

# `/api` desde o contract do #196: a tela do rastreador saiu de dentro da imagem da API
# e virou servico proprio, e quem separa os dois e o gate da borda, que roteia por
# prefixo de path. A arvore de dado deixou de responder na raiz — sem o prefixo aqui,
# este verbo quebraria para toda cadeira no mesmo minuto.
# O loopback continua sendo a porta do agente (card #469): a borda gateia a superficie
# HUMANA, e um Bearer de agente nao atravessa oauth2-proxy.
BASE="${TAREFAS_BASE:-http://127.0.0.1:8120/api}"

# ESCOTILHA: BASE ja termina em /api. O caminho natural (rota real, ex. /api/itens/2930)
# duplicava o prefixo -> /api/api/... -> 404 mudo ("falha ao falar"). Card do 8120.
# Normaliza na BORDA: aceita com ou sem /api; chamadores internos (que passam /itens/...)
# nao passam por aqui, nao regridem.
_apipath() {
  case "$1" in
    /api)   printf '/' ;;
    /api/*) printf '%s' "${1#/api}" ;;
    *)      printf '%s' "$1" ;;
  esac
}
QUEM="${PF_CADEIRA:-}"

# Pedido de ajuda nao e erro (dono, 12/09/2026): `--ajuda` sai por stdout com exit 0; so
# a chamada errada continua saindo por stderr com exit 2.
uso() {
  local codigo="${1:-2}" fd=2
  [ "$codigo" = 0 ] && fd=1
  cat >&$fd <<'FIM'
uso:
  tarefas listar [--cadeira <c>] [--estado <e>] [--nivel <n>] [--json]
                                          itens abertos (fase != terminal)
  tarefas listar-tudo [mesmos filtros]    inclui os terminais
  tarefas ler|ver <id>                    item em texto: cabeçalho, ancestrais,
                                          corpo e filhas diretas
  tarefas criar "<título>" [--desc "<txt>"|--desc-stdin]
                [--nivel épico|feature|story] [--cadeira <c>] [--pai <id>] [--incidente]
                                          default: story. Débito técnico não é card: `dt admitir`.
                                          Nascer fora de `captada`, ou sair dela, exige o
                                          corpo no padrão do nível (arq:0096)
  tarefas editar <id> [--titulo "<t>"] [--desc "<txt>"|--desc-stdin]
                                          troca título e/ou corpo (substitui o corpo
                                          inteiro); não mexe no estado — mover é `mover`
  tarefas modelo <épico|feature|story|task>
                                          esqueleto do corpo, com os rótulos que a API exige;
                                          épico e feature saem no two-pager
  tarefas modelo story derivada           a story que sai da formalização: aponta R<n>, D<n> ou Peça
  tarefas modelo comentario <tipo>        o comentário tipado: insumo, pergunta, buraco,
                                          requisito ou decisão
  tarefas modelo story refinada           o Plano: segunda camada da story, escrita pelo
                                          executor em em-refinamento-tecnico, depois de ler
                                          o código (arq:0096)
  tarefas comentar <id> ["<txt>"]         cria comentário (entidade própria — card #390,
                                          não altera o corpo do item); sem texto, lê stdin
  tarefas comentar <id> --fecha <n> "<resultado> — <destino>"
                                          escreve «fecho: …» como última linha do comentário n
                                          (comentário tipado; insumo não leva fecho)
  tarefas comentarios <id>                lista os comentários do item, em ordem
  tarefas mover <id> <estado> [--motivo "<txt>"] [--englobado-em <id>]
                                          move o card pelo fluxo; a recusa diz para onde
                                          se PODE ir a partir do estado atual. Item com
                                          pai devolve junto o derivado do pai e as irmãs
                                          abertas (arq:0095) — é a âncora do PARCIAL:
  tarefas fechar <id> [--como <estado>] [--cascata]
                                          fecha; default: entregue. Filha aberta na
                                          subárvore? a recusa NOMEIA quem seria encerrado
                                          junto, e `--cascata` confirma. Para mover, `mover`.
  tarefas apagar <id> [--cascata]        APAGA o item. Fora do miolo do fluxo (funil e
                                         terminal); `--cascata` leva a subárvore junto.
  tarefas assinar <id> --aprovador <c> [--decisao aprovado|recusado] [--motivo "<txt>"]
                                          sign-off. Sem --decisao, inscreve o aprovador
                                          como PENDENTE. `recusado` exige --motivo.
  tarefas sub <pai> <filho>               declara <filho> filho de <pai>
  tarefas dt <listar|admitir|matar|vencidos>
                                          balde de débito técnico: linhas numeradas no corpo
                                          do #2856 (rito §4); `dt` sem sub lista os atos
  tarefas estados                         os estados do registro, com fase
  tarefas api <MÉTODO> <caminho>          escotilha, sem corpo
  tarefas api-corpo <MÉTODO> <caminho>    escotilha, corpo JSON em stdin

NÃO HÁ PROJETO neste modelo. `46` e `1` eram do Vikunja; o recorte agora é por eixo
(cadeira, estado, nível). Chamada antiga com projeto no lugar do primeiro argumento
segue funcionando: o número é ignorado, com aviso em stderr.
FIM
  exit "$codigo"
}

# --- transporte -------------------------------------------------------------

_hdr_sujeito() { [ -n "$QUEM" ] && printf '%s' "x-auth-request-preferred-username: $QUEM"; }

# RECUSA DA API NÃO É SILENCIOSA — card #224. Era `-sfS`, e `-f` DESCARTA O CORPO: toda
# recusa de regra chegava à cadeira como `curl: (22) ... error: 400`, sem uma palavra sobre
# o que a máquina disse. Com `--fail-with-body` (curl 8.5 no host) o corpo vem, e é ele que
# carrega o texto da máquina — inclusive a lista de destinos que este card mandou escrever.
_recusa() { # lê o corpo do erro em $1 e devolve a mensagem da API
  local erro; erro=$(printf '%s' "$1" | jq -r '.erro // empty' 2>/dev/null || true)
  # A LISTA DE DESTINOS SAIU DE DENTRO DE `.erro` E VIROU CAMPO (card #245): no board ela
  # empurrava a coluna, e a API passou a devolver causa e lista separadas. Aqui elas se
  # recolam, porque quem lê terminal quer a frase inteira — o CLI não regride com a mudança
  # de forma. Recusa sem o campo (nascimento, validação de corpo) segue imprimindo só a causa.
  local frase; frase=$(printf '%s' "$1" | jq -r '.frase_destinos // empty' 2>/dev/null || true)
  [ -n "$frase" ] && erro="$erro · $frase"
  # A API fala em `?cascata=1` porque é o parâmetro DELA; quem está no terminal digita
  # `--cascata`. Traduzir na borda é o certo: a API não deve conhecer as flags dos seus
  # clientes, e mandar alguém montar query string na mão para responder uma pergunta que o
  # verbo já sabe fazer é devolver o trabalho que este verbo existe para tirar.
  erro="${erro//\`?cascata=1\`/\`--cascata\`}"
  # `-S` sai do curl porque a mensagem util e o CORPO, e a linha `curl: (22) ... 400` so
  # empurrava o texto da maquina para fora da tela. Falha SEM corpo (rede, servico fora)
  # nao fica muda: cai no ramo abaixo, com o endereco que nao respondeu.
  printf '%s\n' "${erro:-falha ao falar com o rastreador em $BASE (sem corpo de erro)}" >&2
  return 1
}

# RECUSA E' FALHA (medido 12/09/2026): `|| _recusa` imprimia a causa e a funcao seguia
# para o printf e devolvia 0 — `tarefas mover` recusado pela API saia "item null → : null"
# com exit 0. Falha silenciosa e' pior que exit 1: o log de erro nao a ve.
busca() { # busca MÉTODO /caminho
  local saida
  if [ -n "$QUEM" ]; then
    saida=$(curl -s --fail-with-body -X "$1" "$BASE$2" \
                 -H "x-auth-request-preferred-username: $QUEM") || { _recusa "$saida"; return 1; }
  else
    saida=$(curl -s --fail-with-body -X "$1" "$BASE$2") || { _recusa "$saida"; return 1; }
  fi
  printf '%s' "$saida"
}

envia() { # envia MÉTODO /caminho  (corpo JSON em stdin)
  local saida corpo; corpo=$(cat)
  if [ -n "$QUEM" ]; then
    saida=$(printf '%s' "$corpo" | curl -s --fail-with-body -X "$1" "$BASE$2" \
                 -H 'Content-Type: application/json' \
                 -H "x-auth-request-preferred-username: $QUEM" -d @-) || { _recusa "$saida"; return 1; }
  else
    saida=$(printf '%s' "$corpo" | curl -s --fail-with-body -X "$1" "$BASE$2" \
                 -H 'Content-Type: application/json' -d @-) || { _recusa "$saida"; return 1; }
  fi
  printf '%s' "$saida"
}

# --- corpo: o rastreador guarda HTML, como o Vikunja guardava ---------------

# Os rotulos dos modelos (`tarefas modelo`, todos os niveis e o Plano) saem em negrito e cada
# campo abre o proprio paragrafo; as linhas que seguem o rotulo (listas, passos) ficam no
# paragrafo dele, separadas por <br>. A validacao da API tira as tags e acha o rotulo no
# comeco da linha, entao `<strong>Negocio:</strong>` segue valendo. Linha em branco ainda
# separa paragrafo.
# Card #3410: rotulo que NAO esta na lista cai dentro do paragrafo do rotulo anterior, e foi o
# que se viu no corpo servido do #3408 (Solucao, Pecas, Aberto e Produtos documentais colados em
# Medida e em Fora). A lista leva os rotulos do two-pager e as linhas fixas do comentario tipado.
para_html() {
  python3 -c 'import html,re,sys
R = ["Problema encontrado", "Solução proposta", "Aceite × prova", "Raio de ataque", "Raio emendado", "Comportamento esperado", "Tarefas", "Sai quando", "Continuidade", "Estado medido", "Medido em", "Referencial", "Premissas", "Unidades", "Problema", "Resultado", "Medida", "Fora", "Quebra", "Negócio", "Ambiente", "Onde", "Passos", "Aceite", "Travas", "Entrega", "Plano", "Riscos", "Solução", "Peças", "Apetite", "Aberto", "Produtos documentais", "Traz", "Caso", "Remendo", "Confere", "Descartado", "Substitui", "fecho"]
R.sort(key=len, reverse=True)
L = re.compile("^(" + "|".join(map(re.escape, R)) + "):", re.I)
ps, p = [], []
for l in html.escape(sys.stdin.read().strip()).split("\n"):
    if not l.strip():
        if p:
            ps.append(p)
            p = []
        continue
    m = L.match(l)
    if m:
        if p:
            ps.append(p)
        p = ["<strong>%s:</strong>%s" % (m.group(1), l[m.end():])]
    else:
        p.append(l)
if p:
    ps.append(p)
print("".join("<p>%s</p>" % "<br>".join(x) for x in ps))'
}

para_texto() {
  sed -e 's#</p>#\n#g' -e 's#<br */\?>#\n#g' -e 's#</h[0-9]>#\n#g' \
      -e 's#<li>#  - #g' -e 's#</li>#\n#g' -e 's#</pre>#\n#g' \
      -e 's#<[^>]*>##g' \
      -e 's#&lt;#<#g' -e 's#&gt;#>#g' -e 's#&quot;#"#g' -e "s@&#39;@'@g" -e 's#&amp;#\&#g' | cat -s
}

# Argumento numérico solto na posição do antigo <projeto>: ignora e avisa. Existe para que
# `tarefas listar 46` e `tarefas criar 46 "título"` — que estão escritos em manifesto, em
# card e na cabeça de toda cadeira — não quebrem no dia da virada.
descarta_projeto() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) echo "aviso: '$1' era projeto do Vikunja e não existe mais; ignorado." >&2; return 0 ;;
  esac
}

# --- filtros ----------------------------------------------------------------

# A API filtra por cadeira, estado e nível. "Aberto" NÃO é filtro dela: é a fase do estado,
# que vem em cada item (`estado_fase`). Peneirar aqui e não lá é o certo — inventar um
# filtro `aberto=` no servidor duplicaria a régua de fase em dois lugares.
monta_query() { # monta_query "$@" -> ecoa a query string e devolve o resto em RESTO[]
  local q="" a
  RESTO=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --cadeira)
        local cad="$2"
        case "$cad" in
          claudinho-arquiteto|arquiteto|\
          claudinho-dados|dados|\
          claudinho-IA|claudinho-ia|ia|IA|\
          claudinha-produto|produto|\
          claudinho-TI|claudinho-ti|ti|TI|\
          claudinho-seguranca|seguranca|\
          claudinha-gestao-estrategica|gestao-estrategica|\
          claudinha-fabrica|fabrica|\
          claudinho-politicas-publicas|politicas-publicas) ;;
          *) echo "cadeira desconhecida: $cad" >&2; exit 2 ;;
        esac
        q="$q&cadeira=$cad"; shift 2 ;;
      --estado)
        local est="$2"
        case "$est" in
          captada|em-lapidacao|em-parecer|priorizada|em-refinamento-tecnico|refinada|\
          em-execucao|em-homologacao|entregue|recusada|cancelada|englobada|encerrada|\
          descartada|detectado|em-mitigacao|mitigado|resolvido) ;;
          *) echo "estado desconhecido: $est" >&2; exit 2 ;;
        esac
        q="$q&estado=$est"; shift 2 ;;
      --nivel)
        local n
        case "$2" in
          épico|epico|0) n=0 ;;
          feature|1)     n=1 ;;
          story|2)       n=2 ;;
          task|3)        n=3 ;;
          *) echo "nível desconhecido: $2 (épico, feature, story, task)" >&2; exit 2 ;;
        esac
        q="$q&nivel=$n"; shift 2 ;;
      --json)    RESTO+=("--json"); shift ;;
      *)         RESTO+=("$1"); shift ;;
    esac
  done
  printf '%s' "${q:+${q:1}}"
}

_tem_json() { local a; for a in "$@"; do [ "$a" = "--json" ] && return 0; done; return 1; }

linhas() { # id, marca de terminal, título
  jq -r '
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue", "recusada", "cancelada", "englobada", "encerrada", "resolvido"]
     | unique) as $term
    | .itens[]
    | . as $it
    | "\($it.id)\t\(if ($it.estado_derivado != null and ($term | index([$it.estado_derivado]) != null)) or ($it.estado_derivado == null and $it.estado_fase == "terminal") then "x" else " " end)\t\($it.titulo)"'
}

listar() { # listar [filtros] [--json]   — só os abertos
  local q; q=$(monta_query "$@")
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  corpo=$(printf '%s' "$corpo" | jq '
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue", "recusada", "cancelada", "englobada", "encerrada", "resolvido"]
     | unique) as $term
    | {
        itens: [
          .itens[]
          | . as $it
          | select(
              if $it.estado_derivado != null
              then ($term | index([$it.estado_derivado]) == null)
              else ($it.estado_fase != "terminal")
              end
            )
        ],
        estados,
        total
      }
    | .total = (.itens | length)')
  if _tem_json "$@"; then printf '%s\n' "$corpo"; else printf '%s' "$corpo" | linhas; fi
}

listar_tudo() { # listar_tudo [filtros] [--json]
  local q; q=$(monta_query "$@")
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  if _tem_json "$@"; then printf '%s\n' "$corpo"; else printf '%s' "$corpo" | linhas; fi
}

estados() {
  busca GET /registro | jq -r '(.estados // .)[] | "\(.estado)\t\(.fase)\t\(.nome)"'
}

# --- item -------------------------------------------------------------------

# `#N` e `N` são o MESMO número: o rastreador tem um identificador só por item, e é essa a
# razão de o Vikunja ter saído. O `#` é aceito porque a fila e os cards o escrevem.
so_id() { printf '%s' "${1#\#}"; }

# CARD #347: a leitura mostra quem falta assinar, e SEM chamada extra — o detalhe do item
# já devolve `sign_offs` desde o #466. Enquanto não estava aqui, a informação existia na API
# e não existia para quem lê pelo terminal, que é a superfície que a cadeira tem.
#
# PENDENTE PRIMEIRO, e a ordem é o ponto: é ele que segura o item em `Em parecer`, e é a
# única linha sobre a qual alguém pode agir agora. Respondido é registro; pendente é dívida.
ler() {
  local id; id=$(so_id "$1")
  busca GET "/itens/$id" | jq -r '
    "# \(.titulo)",
    "#\(.id) · \(.nivel_nome) · "
    + (if .estado_derivado != null
       then "\(.estado_derivado) [derivado; cru: \(.estado_nome) (\(.estado_fase))]"
       else "\(.estado_nome) (\(.estado_fase))"
       end)
    + " · cadeira: \(.cadeira // "—")"
    + (if (.ancestrais|length) > 0 then "\n  em: " + ([.ancestrais[] | "#\(.id) \(.titulo)"] | join(" > ")) else "" end),
    "",
    (if ((.sign_offs // []) | length) > 0 then
       (["sign-off:"]
        + [.sign_offs[] | select(.decisao == null) | "  PENDENTE  \(.aprovador)"]
        + [.sign_offs[] | select(.decisao != null)
           | "  \(.decisao | ascii_upcase)  \(.aprovador)"
             + (if .texto then " — \(.texto)" else "" end)]
        + [""])
       | join("\n")
     else empty end),
    (.descricao // "")' | para_texto
  # FILHAS — card lido sem ver o que pende embaixo não serve para repriorizar:
  # ler um épico/feature e não enxergar a subárvore era o furo. Puxa os filhos
  # diretos por `?pai=`, um por linha (id · estado · cadeira · título).
  # A API não filtra por pai (eixos: cadeira, estado, nível, origem). Puxa a lista
  # e peneira client-side por `.pai == id`. SÓ ABERTAS: terminal (entregue, englobada,
  # etc.) fica fora — a mesma régua de fase que `listar` aplica, pela mesma razão.
  # Filha entregue é auditoria, e auditoria é `listar-tudo`, não leitura de card.
  local filhas; filhas=$(filhas_abertas "$id")
  [ -n "$filhas" ] && printf '\nfilhas (abertas):\n%s\n' "$filhas"
  # Sem filha aberta o `[ -n ]` acima devolve 1 e, sendo o ultimo comando da funcao sob
  # `set -e`, o verbo saia com exit 1 DEPOIS de imprimir o card inteiro. Medido em
  # 11/09/2026: 24 dos 33 "erros" de tarefas no ops log eram isto (metrica casos).
  return 0
}

# Filhas DIRETAS ainda abertas de <id>, uma por linha (id · estado · cadeira · título).
# Compartilhada por `ler` e por `mover`: é a MESMA peneira nas duas, para que a linha
# `PARCIAL:` do relato (arq:0095) e a leitura do card nunca discordem sobre o que pende.
filhas_abertas() {
  busca GET "/itens" | jq -r --argjson id "$1" '
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue","recusada","cancelada","englobada","encerrada","resolvido"]
     | unique) as $term
    | .itens[]?
    | . as $it
    | select($it.pai == $id)
    | select(if $it.estado_derivado != null
             then ($term | index([$it.estado_derivado]) == null)
             else ($it.estado_fase != "terminal") end)
    | "  #\($it.id)\t\($it.estado)\t\($it.cadeira // "—")\t\($it.titulo)"'
}

# ENTREGA É DERIVADA DO PAI (arq:0095, dono 02/09/2026). Item executável movido devolve, no
# MESMO retorno, o estado derivado do pai e as irmãs abertas — é a âncora que a linha
# `PARCIAL:`/`ENTREGA:` do relato cola. Sem isto a forma exigiria segunda chamada, e regra
# que depende de segunda chamada morre como o bullet morreu (3 reincidências pós-b888bcb).
# Medido em 02/09/2026: 12 pais com filhas mistas no board, 10 com derivado `captada` —
# a story fechava, o relato dizia "entregue", e a frente restante nem lapidada estava.
pai_e_irmas() { # pai_e_irmas <id-do-pai>
  local pai; pai=$(so_id "$1")
  busca GET "/itens/$pai" | jq -r '
    "  pai #\(.id) [\(.nivel_nome)]: "
    + (if .estado_derivado != null then "\(.estado_derivado) [derivado]" else .estado_nome end)
    + " — \(.titulo)"'
  local abertas; abertas=$(filhas_abertas "$pai")
  if [ -n "$abertas" ]; then
    printf '  abertas no pai (entrega de negócio NÃO fechou):\n%s\n' "$abertas"
  else
    printf '  nenhuma filha aberta no pai — conferência da gestão estratégica ou da cadeira dona, depois o dono dá entregue\n'
  fi
}

# SIGN-OFF PELO VERBO — card #347. A rota existia desde o #466 e não tinha verbo, e a
# consequência é a que o card nomeia: `org:0019` manda claudinho-dados ASSINAR emenda de
# modelo, e assinar dependia de alguém lembrar de montar o JSON na mão. Regra que depende de
# lembrança é regra morta — é o mesmo defeito que o dono apontou no #348 sobre `tarefas
# mover`.
#
# PENDENTE É O CASO COMUM, e por isso `--decisao` é opcional: quem escreve o card INSCREVE
# os aprovadores antes de qualquer um deles responder ("o item permanece enquanto houver
# aprovador pendente", F9 §4.3). Verbo que exigisse decisão só saberia registrar o fim, e o
# começo — que é o que trava o item — continuaria no JSON na mão.
#
# `--motivo` E NÃO `--texto`, e a divergência do nome de campo da API é deliberada: `motivo`
# é a palavra que `mover`, `fechar` e `apagar` já usam neste verbo para "por que você fez
# isso". Duas palavras para a mesma coisa em quatro subcomandos vizinhos é o tipo de atrito
# que se paga em toda chamada.
assinar() {
  local id; id=$(so_id "$1"); shift
  local aprovador="" decisao="" motivo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --aprovador) aprovador="$2"; shift 2 ;;
      --decisao)   decisao="$2";   shift 2 ;;
      --motivo|--texto) motivo="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$aprovador" ] || { echo "uso: tarefas assinar <id> --aprovador <cadeira> [--decisao aprovado|recusado] [--motivo \"<txt>\"]" >&2; exit 2; }
  # A regra de "recusado exige motivo" (F9 §4.3, e CHECK no schema) mora na API e no banco.
  # Aqui NÃO se duplica: uma cópia local divergiria no dia em que a regra mudasse, e a
  # recusa da API já chega legível por `--fail-with-body`.
  jq -n --arg a "$aprovador" --arg d "$decisao" --arg t "$motivo" \
     '{aprovador:$a}
      + (if $d == "" then {} else {decisao:$d} end)
      + (if $t == "" then {} else {texto:$t} end)' \
    | envia POST "/itens/$id/sign-offs" \
    | jq -r '"sign-off de \(.aprovador) em #\(.item // '"$id"'): \(.decisao // "PENDENTE")"
             + (if .texto then " — \(.texto)" else "" end)'
}

criar() {
  descarta_projeto "${1:-}" && shift
  local titulo="${1:?uso: tarefas criar \"<título>\" [opções]}"; shift || true
  # DEFAULT É STORY (arq:0096, dono 02/09/2026): task é débito técnico e nasce só por
  # `tarefas dt admitir`. Medido antes da virada: 390 tasks, 156 órfãs, 13 stories com
  # filha task — o default `task` fazia da task uma "story sem nome".
  local desc="" nivel="story" cadeira="$QUEM" pai="" classe="planejado" via_dt="${TAREFAS_VIA_DT:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --desc)       desc="$2"; shift 2 ;;
      --desc-stdin) desc="$(cat)"; shift ;;
      --nivel)      nivel="$2"; shift 2 ;;
      --cadeira)    cadeira="$2"; shift 2 ;;
      --pai)        pai=$(so_id "$2"); shift 2 ;;
      --incidente)  classe="incidente"; shift ;;
      --prio)       echo "aviso: --prio não existe neste modelo; ignorado." >&2; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  # A API quer o nível como INTEIRO — a camada é ordem, e é ela que a restrição de pai
  # compara. O nome é o que a pessoa escreve; a tradução é aqui, num lugar só.
  local n
  case "$nivel" in
    épico|epico|0)   n=0 ;;
    feature|1)       n=1 ;;
    story|2)         n=2 ;;
    task|3)          n=3
                     if [ -z "$via_dt" ]; then
                       echo "recusado: task é débito técnico e nasce por \`tarefas dt admitir \"<problema>\" --solucao \"<txt>\" --medido-em <data> --evidencia <...>\`. Trabalho de execução é story (arq:0096)." >&2
                       exit 2
                     fi ;;
    *) echo "nível desconhecido: $nivel (épico, feature, story, task)" >&2; exit 2 ;;
  esac
  local html=""
  [ -n "$desc" ] && html="$(printf '%s' "$desc" | para_html)"
  # `estado` é obrigatório no POST: item nasce declarando onde entra no funil, e não há
  # default do servidor. `captada` é a boca do funil para planejado; incidente entra em
  # `aberto` se o registro o tiver, e a recusa da API nomeia o estado válido quando não.
  # incidente entra no funil de incidente (`detectado`), planejado na boca do funil
  # comum (`captada`). PF_ESTADO_INICIAL, se dado, vence o default da classe (#259).
  local est_default="captada"; [ "$classe" = "incidente" ] && est_default="detectado"
  local est="${PF_ESTADO_INICIAL:-$est_default}"
  jq -n --arg t "$titulo" --arg d "$html" --argjson n "$n" --arg c "$cadeira" \
        --arg p "$pai" --arg cl "$classe" --arg e "$est" \
     '{titulo:$t, classe:$cl, estado:$e}
      + (if $cl == "incidente" then {} else {nivel:$n} end)
      + (if $d == "" then {} else {descricao:$d} end)
      + (if $c == "" then {} else {cadeira:$c} end)
      + (if $p == "" then {} else {pai:($p|tonumber)} end)' \
    | envia POST /itens \
    | jq -r '"item \(.id) criado: \(.titulo)"'
}

# EDITAR É O PATCH DO CORPO COM NOME DE ATO — card #3134 (dono, 25/09/2026): toda chamada
# de API se encapsula em verbo. A rota sempre aceitou `titulo`/`descricao` no PATCH, mas a
# única porta até ela era a escotilha `api-corpo`, e cadeira não achava nem essa.
#
# NUNCA manda `estado`: editar não move. Mover é `mover`, que carrega motivo e cascata; um
# PATCH que trocasse corpo e estado juntos regrediria a coluna sem ninguém pedir. A régua do
# corpo por nível (arq:0096) é da API, como em `criar` — este verbo não a duplica.
editar() {
  local id; id=$(so_id "${1:?uso: tarefas editar <id> [--titulo \"<t>\"] [--desc \"<txt>\"|--desc-stdin]}"); shift
  local titulo="" desc="" tem_desc=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --titulo)     titulo="${2:?--titulo pede texto}"; shift 2 ;;
      --desc)       desc="${2:?--desc pede texto}"; tem_desc=1; shift 2 ;;
      --desc-stdin) desc="$(cat)"; tem_desc=1; shift ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  if [ -z "$titulo" ] && [ -z "$tem_desc" ]; then
    echo "uso: tarefas editar <id> [--titulo \"<t>\"] [--desc \"<txt>\"|--desc-stdin] — nada a editar" >&2
    exit 2
  fi
  if [ -n "$tem_desc" ] && [ -z "$(printf '%s' "$desc" | tr -d '[:space:]')" ]; then
    echo "recusado: corpo vazio apagaria a descrição do item. Para ver o esqueleto: tarefas modelo <nível>" >&2
    exit 2
  fi
  local html=""
  [ -n "$tem_desc" ] && html="$(printf '%s' "$desc" | para_html)"
  jq -n --arg t "$titulo" --arg d "$html" \
     '(if $t == "" then {} else {titulo:$t} end)
      + (if $d == "" then {} else {descricao:$d} end)' \
    | envia PATCH "/itens/$id" \
    | jq -r '"item \(.id) editado: \(.titulo) · estado \(.estado_nome) (inalterado)"'
}

# COMENTÁRIO É TEXTO NO CORPO, por ordem do dono (16/08/2026). O modelo do rastreador não
# tem entidade de comentário, e a migração do acervo já pôs os comentários velhos dentro de
# `descricao` sob marcador. Escrever novo do mesmo jeito mantém uma forma só — e o dia em
# que comentário virar entidade, há um marcador único para varrer.
# CARD #390: comentário é entidade própria (api/app.py `POST /itens/{id}/comentarios`),
# não mais texto colado em `descricao` — o PATCH que anexava ao corpo inflava a leitura
# do item a cada comentário e não dava id/ordem a nada (#382 assinado "anônimo" sem como
# provar, referências como "comentário 350" apontando pra NÚMERO DE LINHA, não objeto).
# `autor` não vem daqui: o servidor lê do MESMO cabeçalho que `mover`/`fechar` já usam
# (`x-auth-request-preferred-username`, via `$QUEM`) — `envia` já o manda quando presente.
comentar() {
  local id="${1:-}"
  [ -z "$id" ] && { echo "uso: tarefas comentar <id> [\"<txt>\"] (ou corpo em stdin)" >&2; exit 2; }
  id=$(so_id "$id") || exit 2
  if [ "${2:-}" = "--fecha" ]; then
    fechar_comentario "$id" "${3:-}" "${4:-}"
    return
  fi
  local txt="${2:-}"
  # Opção no lugar do texto não é corpo (#2856 linhas 49 e 50): `--stdin` manda ler o stdin; outra
  # opção de uma palavra só é recusada, em vez de gravada como comentário.
  if [[ "$txt" =~ ^--[a-zA-Z][a-zA-Z0-9-]*$ ]]; then
    [ "$txt" = "--stdin" ] || { echo "erro: tarefas comentar: opção desconhecida '$txt'; o corpo vai entre aspas ou em stdin." >&2; exit 2; }
    txt=""
  fi
  if [ -z "$txt" ] && [ ! -t 0 ]; then
    txt="$(cat)"
  fi
  local trim
  trim="$(printf '%s' "$txt" | tr -d '[:space:]')"
  if [ -z "$trim" ]; then
    echo "erro: tarefas comentar: corpo do comentário não pode ser vazio." >&2
    echo "uso: tarefas comentar <id> [\"<txt>\"] (ou corpo em stdin)" >&2
    exit 2
  fi
  local html; html=$(printf '%s' "$txt" | para_html)
  jq -n --arg c "$html" '{corpo:$c}' | envia POST "/itens/$id/comentarios" \
    | jq -r '"comentário #\(.id) criado no item \(.item)"'
}

# O FECHO NO PRÓPRIO COMENTÁRIO — card #3410 (dono, comentário #2088 do #3408: o estado do
# comentário mora nele). `tarefas comentar <card> --fecha <n> "<resultado> — <destino>"` escreve
# `fecho: …` como ÚLTIMA linha do comentário n, pela edição de comentário da API, que guarda o
# corpo anterior no ledger. As regras que o verbo aplica são as da forma do comentário (spec
# comentario-tipado, R5 e R6), que o rastreador não conhece até a F3: insumo nasce fechado e não
# leva fecho; comentário já fechado não fecha de novo; o resultado é do vocabulário do tipo e o
# destino é obrigatório. Comentário sem etiqueta de tipo (anterior ao molde) fecha com qualquer
# resultado, com aviso.
fechar_comentario() {
  local id="$1" cid="${2:-}" txt="${3:-}"
  local uso='uso: tarefas comentar <card> --fecha <n> "<resultado> — <destino>"'
  case "$cid" in ''|*[!0-9#]*) echo "$uso" >&2; exit 2 ;; esac
  cid=$(so_id "$cid")
  txt="$(printf '%s' "$txt" | sed -e 's/^[[:space:]]*[Ff]echo[[:space:]]*:[[:space:]]*//')"
  [ -n "$(printf '%s' "$txt" | tr -d '[:space:]')" ] || { echo "$uso" >&2; exit 2; }
  local lista; lista=$(busca GET "/itens/$id/comentarios") || exit 1
  local fecho_html; fecho_html=$(printf 'fecho: %s' "$txt" | para_html)
  local corpo rc=0
  corpo=$(printf '%s' "$lista" | CID="$cid" ITEM="$id" FECHO="$txt" FECHO_HTML="$fecho_html" python3 -c '
import html, json, os, re, sys
d = json.load(sys.stdin)
cid, item, fecho = int(os.environ["CID"]), os.environ["ITEM"], os.environ["FECHO"]
alvo = next((c for c in d.get("comentarios", []) if c.get("id") == cid), None)
if alvo is None:
    sys.stderr.write("comentário #%d não existe no item %s; os comentários saem em `tarefas comentarios %s`\n" % (cid, item, item))
    sys.exit(1)
texto = re.sub(r"</p>|<br\s*/?>", "\n", alvo["corpo"])
linhas = [l.strip() for l in html.unescape(re.sub(r"<[^>]+>", "", texto)).splitlines() if l.strip()]
if linhas and re.match(r"(?i)^fecho\s*:", linhas[-1]):
    sys.stderr.write("sem mudança: comentário #%d já está fechado — %s\n" % (cid, linhas[-1]))
    sys.exit(1)
if " — " not in fecho:
    sys.stderr.write("o fecho é «<resultado> — <destino>»: o destino diz onde a contribuição foi parar (spec comentario-tipado, R6)\n")
    sys.exit(2)
VOCAB = {"pergunta": ("respondida", "retirada"),
         "buraco": ("remendado", "cortado", "volta à lapidação"),
         "requisito": ("aceito", "fundido", "retirado"),
         "decisão": ("formalizada",)}
m = re.match(r"(?i)^(insumo|pergunta|buraco|requisito|decis[aã]o)\b", linhas[0] if linhas else "")
tipo = m.group(1).lower().replace("decisao", "decisão") if m else None
if tipo == "insumo":
    sys.stderr.write("recusado: insumo nasce fechado e não leva fecho (spec comentario-tipado, R5)\n")
    sys.exit(4)
resultado = fecho.split(" — ", 1)[0].strip().lower()
if tipo in VOCAB and not any(resultado.startswith(v) for v in VOCAB[tipo]):
    sys.stderr.write("recusado: o resultado de %s é um de: %s (spec comentario-tipado, R6)\n" % (tipo, ", ".join(VOCAB[tipo])))
    sys.exit(4)
if tipo is None:
    sys.stderr.write("aviso: o comentário #%d não abre com tipo (insumo, pergunta, buraco, requisito, decisão); o fecho foi escrito sem conferir o vocabulário\n" % cid)
print(json.dumps({"corpo": alvo["corpo"] + os.environ["FECHO_HTML"]}))
') || rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"
  printf '%s' "$corpo" | envia PATCH "/itens/$id/comentarios/$cid" >/dev/null || exit 1
  printf 'comentário #%s do item %s fechado — fecho: %s\n' "$cid" "$id" "$txt"
}

comentarios() {
  local id; id=$(so_id "$1")
  busca GET "/itens/$id/comentarios" | jq -r '
    if (.comentarios | length) == 0 then "(sem comentários)" else
      .comentarios[] | "--- #\(.id) · \(.autor // "anônimo") · \(.carimbo) ---\n\(.corpo)\n"
    end' | para_texto
}

# MOVER É O ATO, E O NOME É O ATO — card #224. A capacidade sempre existiu: o PATCH aceita
# qualquer estado do registro, e quem valida é a máquina. O que não existia era um verbo com
# o nome do que se faz, e o efeito observável disso foi medido no quadro de 17/08 — `Em
# execução` com UM item e `Entregue` com 145. Ninguém procura `fechar` para mover um card
# pelo fluxo, então ninguém operava fluxo pelo rastreador.
#
# `--motivo` é primeira classe porque a máquina o EXIGE em parte das transições (volta ao
# funil, §4.1; `recusada`, §6.3) e porque, sem ele aqui, a cadeira descobria a exigência
# levando erro. A lista de destinos válidos vem da API, derivada da própria máquina: este
# verbo não guarda tabela de arestas, e é isso que o mantém correto quando um estado novo
# entra no registro por INSERT.
mover() {
  local id; id=$(so_id "${1:?uso: tarefas mover <id> <estado> [--motivo \"...\"]}")
  local destino="${2:?uso: tarefas mover <id> <estado> [--motivo \"...\"]}"; shift 2
  local motivo="" elo="" q=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --motivo)       motivo="${2:?--motivo pede texto}"; shift 2 ;;
      --englobado-em) elo="${2:?--englobado-em pede o id que absorveu}"; shift 2 ;;
      # CONFIRMAÇÃO DA CASCATA (ordem do dono, 18/08/2026). O verbo não decide NADA aqui:
      # ele só carrega a declaração até a API, que é quem sabe se há filha aberta e quem
      # NOMEIA quais são na recusa. Repetir a regra do lado do CLI daria duas verdades, e a
      # que o dono veria seria a que perdeu a corrida.
      --cascata)      q="?cascata=1"; shift ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  local resp; resp=$(jq -n --arg e "$destino" --arg m "$motivo" --arg g "$elo" \
     '{estado:$e}
      + (if $m == "" then {} else {motivo:$m} end)
      + (if $g == "" then {} else {englobado_em:($g|tonumber)} end)' \
    | envia PATCH "/itens/$id$q") || return 1
  printf '%s' "$resp" | jq -r '"item \(.id) → "
             + (if .estado_derivado != null
                then "\(.estado_derivado) [derivado; cru: \(.estado_nome)]"
                else .estado_nome
                end)
             + ": \(.titulo)"
             + (if ((.propagacao.movidas // []) | length) > 0
                then "\n  filhas movidas junto: " + ([.propagacao.movidas[] | "#\(.id)"] | join(", "))
                else "" end)'
  # Tem pai → o relato precisa do pai (arq:0095). Sai sempre, em qualquer destino: a story
  # que entra em `em-execucao` também tem de saber quantas irmãs faltam.
  local pai; pai=$(printf '%s' "$resp" | jq -r '.pai // empty')
  [ -n "$pai" ] && pai_e_irmas "$pai"
  # AVISO À DONA (ordem do dono, 27/09/2026): fechou a última filha e o pai parou em
  # `em-homologacao` — a conferência da feature/épico é da gestão estratégica ou da cadeira
  # dona dele, e depois do dono. Quem executou a story nem sempre é a dona; sem o aviso, o dono pedia à mão.
  if [ -n "$pai" ] && [ "$(printf '%s' "$resp" | jq -r '.estado_natureza // ""')" = "terminal" ]; then
    avisa_dona "$pai" "$id"
  fi
  return 0
}

# avisa_dona <pai> <filha> -- pai em `em-homologacao` derivado: manda à cadeira dona do pai
# um pedido de conferência pela fila. Não derruba o `mover`: o card já andou; falha do aviso
# se declara na saída.
avisa_dona() {
  local pai; pai=$(so_id "$1"); local filha="$2" j
  j=$(busca GET "/itens/$pai") || return 0
  [ "$(printf '%s' "$j" | jq -r '.estado_derivado // ""')" = "em-homologacao" ] || return 0
  local dona; dona=$(printf '%s' "$j" | jq -r '.cadeira // ""')
  dona="${dona#claudinho-}"; dona="${dona#claudinha-}"; dona=$(printf '%s' "$dona" | tr 'A-Z' 'a-z')
  local eu="${QUEM#claudinho-}"; eu="${eu#claudinha-}"
  local nivel titulo; nivel=$(printf '%s' "$j" | jq -r '.nivel_nome'); titulo=$(printf '%s' "$j" | jq -r '.titulo')
  # QUEM CONFERE (dono, 27/09/2026): a conferência do pai com o dono é da gestão
  # estratégica, gestora do portfólio; a cadeira dona do card também pode, e nenhuma outra.
  # O aviso vai às duas; quem chamou o `mover` lê a linha aqui mesmo, sem carta.
  local destinos="gestao-estrategica"
  [ -n "$dona" ] && [ "$dona" != "gestao-estrategica" ] && destinos="$destinos $dona"
  local fila_bin="${PF_FILA_BIN:-$(dirname "$(readlink -f "$0")")/fila}"
  local d out
  for d in $destinos; do
    if [ "$d" = "$eu" ]; then
      printf '  pai #%s em em-homologacao: a conferência é sua — rode o `Sai quando:` e leve a linha ENTREGA: ao dono\n' "$pai"
      continue
    fi
    if [ ! -x "$fila_bin" ]; then
      printf '  aviso de conferência (%s) NÃO enviado: verbo fila ausente em %s\n' "$d" "$fila_bin"
      continue
    fi
    if out=$(printf 'A última filha aberta de #%s (%s: %s) fechou com #%s. %s está em em-homologacao e espera a conferência (gestão estratégica, ou a cadeira dona do card): rode o `Sai quando:` (feature) ou confira a `Medida:` (épico), comente o retorno no card e leve a linha ENTREGA: ao dono. Se faltar coisa, abra a story que falta — o pai volta a em-execucao sozinho.\n' \
          "$pai" "$nivel" "$titulo" "$filha" "$([ "$nivel" = feature ] && echo "A feature" || echo "O $nivel")" \
        | "$fila_bin" enviar "$d" --tipo pedido --assunto "#$pai em homologação: conferência antes do dono" --ref "#$pai" 2>&1); then
      printf '  aviso de conferência enviado: %s (%s)\n' "$d" "$(printf '%s' "$out" | head -1)"
    else
      printf '  aviso de conferência (%s) NÃO enviado: %s\n' "$d" "$(printf '%s' "$out" | head -1)"
    fi
  done
  return 0
}

# `fechar` CONTINUA EXISTINDO PARA FECHAR, e deixa de ser a porta de mover. Não morre: 145
# itens do acervo e os scripts da fita chamam por ele, e matar um verbo em uso para corrigir
# um nome é trocar um defeito de descoberta por uma quebra. `--como` com estado NÃO terminal
# passa a avisar e a delegar — o aviso vai a stderr, então nada que consome a saída quebra.
apagar() {
  # Ordem do dono, 17/08/2026: apagar card é caso de uso comum, não escotilha. A única
  # guarda é o miolo do fluxo, e quem a aplica é a API — este verbo não repete regra.
  local id; id=$(so_id "$1"); shift || true
  local q=""
  [ "${1:-}" = "--cascata" ] && q="?cascata=1"
  busca DELETE "/itens/$id$q" \
    | jq -r '"apagado(s): \(.quantos)", (.apagados[]? | "  #\(.id) [\(.estado)] \(.titulo)")'
}

fechar() {
  local id; id=$(so_id "$1"); shift || true
  local como="entregue"
  [ "${1:-}" = "--como" ] && { como="$2"; shift 2; }
  if ! busca GET "/registro" \
       | jq -e --arg e "$como" '.estados[]? | select(.estado==$e and .natureza=="terminal")' \
       >/dev/null 2>&1; then
    echo "aviso: \`$como\` não é estado terminal — \`fechar\` fecha; para mover pelo fluxo use \`tarefas mover $id $como\`" >&2
  fi
  mover "$id" "$como" "$@"
}

# ESQUELETO DO CORPO POR NÍVEL — arq:0096. É o que a recusa da API manda imprimir
# (`tarefas modelo <nível>`). Os rótulos aqui e em `logica.CAMPOS_DO_CORPO` são os
# mesmos: a API é quem recusa; este verbo só evita que a cadeira adivinhe a grafia.
#
# A STORY TEM DUAS CAMADAS (arq:0096, emenda de 28/09/2026). O contrato se escreve na
# lapidação; o Plano, o executor escreve em `em-refinamento-tecnico`, DEPOIS de ler o
# código, e é o que a story precisa para entrar em `em-execucao` (a trava é nessa entrada, não
# na saída do refinamento, para não quebrar a lapidação). Os dois moldes saem separados de propósito:
# impresso junto, o Plano seria preenchido na captação com palpite, e é justamente o que
# apodrece antes da execução (estado medido, arquivos por unidade, premissas).
# `tarefas modelo story refinada` imprime só o Plano; o aviso do `modelo story` vai a
# stderr para não entrar no corpo de quem copia o esqueleto.
modelo_plano() {
  cat <<'M'
Plano:
Medido em: <repo>@<sha de main> · <AAAA-MM-DD> — o estado que este plano leu; main andou, relê antes de executar
Estado medido: [executor] fato | valor | onde (repo@caminho:símbolo), uma linha cada — inclui o que o card supôs e o código desmente, o que não abriu, e a peça existente a reaproveitar · story que mede: a classe contada na população com a mesma régua do instrumento, antes de sortear (A2)
Premissas: [executor] o que decidi onde a story era ambígua, uma linha cada, corrigível — só se houver; o que as Travas mandam não decidir continua parando no card
Unidades: [executor] detalha as Tarefas do contrato · unidade | escreve (lista fechada repo@caminho) | depende de | fecha quando (comando + resultado esperado) — nenhum arquivo em duas unidades; unidade sem dependência corre em paralelo, e a linha é a mensagem de delegação do sub-agente · story que bloqueia outra: só as unidades que a outra chama (C2) · o que serve a dois consumidores roda uma vez, antes dos dois (C4) · C1–C5 e A2: lista antipadroes-de-quebra-de-execucao
Aceite × prova: [executor] cada linha do Aceite | o comando que a demonstra | o resultado que tem de dar
Raio emendado: [executor] repo@caminho | por que — o que o plano toca além do Raio de ataque; só se houver
Riscos: [executor] causa → saída, uma linha cada — só se houver
M
}

# O TWO-PAGER (card #3410; padrao styleguide-moldes-por-tipo §7; ordem dos rótulos do insumo
# #2092 do #3410). O Título é o título do card e não entra no corpo; o aviso vai a stderr pela
# mesma razão do aviso do Plano: quem copia o esqueleto copia stdout.
_avisa_two_pager() {
  echo "título: é o título do card — o que a pessoa passa a conseguir, até doze palavras. A API exige a aposta (Problema, Resultado, Medida, Fora) na saída de captada e a forma (Solução, Peças) na saída de em-lapidacao; Apetite e Aberto são livres, o índice fecha na formalização" >&2
}

# A STORY DERIVADA (levantamento 2026-10-11-moldes-do-discovery-e-da-formalizacao §7): não
# repete o que a ADR e a spec dizem; carrega a execução e aponta o item que atende.
modelo_story_derivada() {
  cat <<'M'
Negócio: #<feature> · R<a>, R<b> da spec <peça> | D<n> da arq:NNNN | Peça <n>, enquanto não há R nem D — só o ponteiro
Referencial: [agente] a ADR e a spec de que deriva, por slug; story que escreve o próprio derivado aponta os comentários decisão e requisito do card
Raio de ataque: [agente] lista literal dos arquivos a mexer, um por linha, repo@caminho — a fatia do documento que esta story atende; fora da lista não se toca
Comportamento esperado: [agente] caminho feliz técnico, literal — recebe X, executa Y, sai 0
Tarefas: as tasks que esta fita faz, uma por linha, na ordem de execução: o que faz · repo@caminho · como se confere — a task não tem card; a story é uma fita do executor, nem mais nem menos (arq:0060 §3; guia discovery, «A quebra»)
1. <task>
Ambiente: repo absoluto · como instalar · o que está de pé e não se derruba · credenciais (nunca impressas)
Onde: arquivo, função, linha aproximada · peça análoga a imitar, se existir
Passos: numerados, um por ação, comando literal
Aceite: o item derivado que a fatia atende (R<n> ou D<n>; a Peça enquanto não há nenhum dos dois) — o comando literal vai ao Plano, em Aceite × prova
Travas: trava que vem de ADR vira ponteiro D<n>; trava de execução fica escrita, imperativo + motivo
Entrega: branch fabrica/<card>-<slug> de main · quem escreveu mescla e sobe (código: release promover; documento: servido no acervo) · retorno no comentário
M
  echo "segunda camada: o executor escreve o Plano em em-refinamento-tecnico, e o Medido em leva a versão servida da spec que leu — tarefas modelo story refinada" >&2
}

# O COMENTÁRIO TIPADO (spec comentario-tipado; padrao styleguide-moldes-por-tipo §8): primeira
# linha, as linhas fixas do tipo logo abaixo, uma linha em branco e o argumento, sem teto. O
# fecho não faz parte do molde: escreve-o o autor do two-pager, com `comentar --fecha`.
modelo_comentario() {
  case "${1:-}" in
    insumo) cat <<'M'
insumo: <nome do documento ou o fato>
Traz: <o que muda para este card, numa linha>

<argumento: o que sustenta, com onde se leu ou mediu>
M
    ;;
    pergunta) cat <<'M'
pergunta (<cadeira a quem se pergunta>): <a pergunta>

<argumento: por que a pergunta importa e o que já se sabe>
M
    ;;
    buraco) cat <<'M'
buraco: <onde a solução quebra, em uma frase>
Caso: <a situação que quebra, medida no código (repo@caminho) ou na spec (espécie e seção)>
Remendo: <um detalhe, um corte, ou «volta à lapidação»>

<argumento: a evidência, o raciocínio, e o que pesa contra, inclusive o desenho recebido>
M
    ;;
    requisito) cat <<'M'
requisito: <o comportamento exigido, em uma frase>
Confere: <o comando ou a consulta, e o resultado que prova>

<argumento: por que é exigido e o que quebra sem ele>
M
    ;;
    decisão|decisao) cat <<'M'
decisão (<quem decidiu; do dono, registrada por uma cadeira: dono>): <a escolha, em uma frase>
Descartado: <as alternativas e por quê>
Substitui: <#N — só quando substitui outra decisão>

<argumento: o que levou à escolha>
M
    ;;
    *) echo "uso: tarefas modelo comentario <insumo|pergunta|buraco|requisito|decisão>" >&2; exit 2 ;;
  esac
  case "${1:-}" in
    pergunta|buraco|requisito)
      echo "nasce aberto: fecha quando o autor do two-pager escrever o fecho — tarefas comentar <card> --fecha <n> \"<resultado> — <destino>\"" >&2 ;;
  esac
}

modelo() {
  if [ "${1:-}" = story ] && [ -n "${2:-}" ]; then
    case "$2" in
      refinada|em-refinamento-tecnico|plano) modelo_plano; return 0 ;;
      derivada) modelo_story_derivada; return 0 ;;
      *) echo "uso: tarefas modelo story [refinada|derivada]   (o Plano é exigido na entrada de em-execucao)" >&2; exit 2 ;;
    esac
  fi
  case "${1:-}" in
    comentario|comentário) modelo_comentario "${2:-}"; return 0 ;;
  esac
  case "${1:-}" in
    épico|epico) cat <<'M'
Problema: como é hoje, como quem sofre veria, com um caso; até quatro frases, sem número (o número vai à Medida)
Solução: a solução contada como uso, por momento, até sete; quem lê só isto simula um dia usando a coisa
- Ao <momento>: quem faz o quê, e o que vê
Peças: as features, numeradas, uma linha cada; regra nova diz quem a cobra (verbo, lint, gate)
1. <feature>
Fora: o que este épico não entrega e alguém pediria, um por linha, com para onde vai; Fora não proíbe
- <item>: <para onde, quando>
Resultado: quem passa a conseguir o quê; o outcome que o card não fecha sozinho vai marcado «não fecha card»
Medida: escala · medidor · valor hoje · mínimo aceitável — uma linha
Apetite: (opcional) quanto vale gastar · o que se corta primeiro se não couber — previsão de quem escreve
Aberto: prosa do autor: o que está por decidir, cada item com quem responde; na aposta, o que sobra diz «fica aberto de propósito:» e o risco aceito
Quebra: escrita na formalização — <data>, depois as features, uma por linha, na ordem de execução
M
    _avisa_two_pager
    ;;
    feature) cat <<'M'
Problema: como é hoje, como quem sofre veria, com um caso; até quatro frases, sem número (o número vai à Medida)
Solução: a solução contada como uso, por momento, até sete; quem lê só isto simula um dia usando a coisa
- Ao <momento>: quem faz o quê, e o que vê
Peças: numeradas, uma linha cada: o que vai existir (lugar, ato ou regra); regra nova diz quem a cobra (verbo, lint, gate)
1. <peça>
Fora: o que esta frente não entrega e alguém pediria, um por linha, com para onde vai; Fora não proíbe
- <item>: <para onde, quando>
Resultado: quem passa a conseguir o quê; o outcome que o card não fecha sozinho vai marcado «não fecha card»
Medida: escala · medidor · valor hoje · mínimo aceitável — uma linha
Apetite: (opcional) quanto vale gastar · o que se corta primeiro se não couber — previsão de quem escreve
Aberto: prosa do autor: o que está por decidir, cada item com quem responde; na aposta, o que sobra diz «fica aberto de propósito:» e o risco aceito
Produtos documentais: um por linha, pelo que a feature muda (ADR, spec da peça criada ou atualizada, documento, dado, emenda); na formalização, cada linha ganha o link do servido
- <produto> · <quem escreve>
Sai quando: na lapidação, a frase que torna a feature entregue; na formalização, o comando ou a consulta que prova
Quebra: escrita na formalização — <data>, depois as stories, uma por linha, na ordem de execução; cada story é uma fita (guia discovery, «A quebra»)
M
    _avisa_two_pager
    ;;
    story) cat <<'M'
Negócio: #<feature> — só o ponteiro; nada de contexto de negócio aqui
Referencial: [agente] lista fechada das decisões que o agente consulta ANTES de mexer, por slug (arq:NNNN, spec_<slug>, minuta NNNN) — não é leitura recomendada
Raio de ataque: [agente] lista literal dos arquivos a mexer, um por linha, repo@caminho — fora da lista não se toca
Comportamento esperado: [agente] caminho feliz técnico, literal — recebe X, executa Y, sai 0; o estado de chegada que o Aceite prova
Tarefas: as tasks que esta fita faz, uma por linha, na ordem de execução: o que faz · repo@caminho · como se confere — a task não tem card; a story é uma fita do executor, nem mais nem menos (arq:0060 §3)
1. <task>
Ambiente: repo absoluto · como instalar · o que está de pé e não se derruba · credenciais (nunca impressas) · story que mede: o instrumento já no ar, ou o card dele como pré-requisito com dono e estimativa (C1)
Onde: arquivo, função, linha aproximada · peça análoga a imitar, se existir
Passos: numerados, um por ação, comando literal
Aceite: a conferência que fecha a story, que é o que o dono lê: o comando que prova + o número que tem de dar · story que mede: quem mede, quem decide e com que regra (C5) · story de instrumento: a chamada exata que o card consumidor fará (C3)
Travas: imperativo + motivo com fonte citada — o que não decidir, onde parar e comentar no card; merge e subida não são trava
Entrega: branch fabrica/<card>-<slug> de main · quem escreveu mescla e sobe (código: release promover; documento: servido no acervo) · retorno no comentário
M
    echo "segunda camada: o executor escreve o Plano em em-refinamento-tecnico, depois de ler o código — tarefas modelo story refinada" >&2
    ;;
    task) cat <<'M'
Problema encontrado: o fato medido (verbo | arquivo:linha, data)
Solução proposta: o que fazer — palpite serve, desde que escrito
Referencial: [agente] lista fechada das decisões que o agente consulta ANTES de mexer, por slug (arq:NNNN, spec_<slug>, minuta NNNN)
Raio de ataque: [agente] lista literal dos arquivos a mexer, um por linha, repo@caminho — fora da lista não se toca
Comportamento esperado: [agente] caminho feliz técnico, literal — recebe X, executa Y, sai 0
M
    ;;
    *) echo "uso: tarefas modelo <épico|feature|story|task> | story refinada | story derivada | comentario <tipo>" >&2; exit 2 ;;
  esac
}

# Filho declara o pai, e o pai tem de ser de nível estritamente MENOR — a restrição é do
# banco (`pai_nivel`, escrito por subconsulta), não deste verbo. Recusa vem nomeada da API.
subtarefa() {
  local pai filho; pai=$(so_id "${1:?uso: tarefas sub <pai> <filho>}"); filho=$(so_id "${2:?uso: tarefas sub <pai> <filho>}")
  jq -n --argjson p "$pai" '{pai:$p}' | envia PATCH "/itens/$filho" >/dev/null
  echo "item $filho agora é filho de $pai"
}

apagar_comentario() {
  local id cid
  id=$(so_id "${1:?uso: tarefas apagar-comentario <id> <cid>}")
  cid=$(so_id "${2:?uso: tarefas apagar-comentario <id> <cid>}")
  busca DELETE "/itens/$id/comentarios/$cid" | jq -r '"comentário #\(.apagado) apagado do item \(.item)"'
}

# --- débito técnico ---------------------------------------------------------

# RITO DO DÉBITO TÉCNICO — padrao rito-debito-tecnico, assinado pelo dono em 26/08/2026
# (card #179). DT é defeito ou dívida MEDIDA que não bloqueia ninguém hoje.
#
# O BALDE É UM CARD SÓ, E CADA DÉBITO É UMA LINHA (ordem do dono, 27/09/2026, card #3175).
# Até então cada DT era card filho do balde e a triagem de um diário de bordo punha dezenas
# de cards no quadro que o dono lê. Agora o corpo do #2856 tem duas seções, `## Abertos` e
# `## Saídas`, e cada débito é a linha `N. [AAAA-MM-DD] texto`, com a data da medição. O
# número não se reusa: `admitir` numera pelo maior número das duas seções.
#
# O rito mora neste verbo: `admitir` recusa sem medição (rito §1); `matar` só tira a linha
# por uma das quatro portas do rito §3, e toda porta exige âncora, porque nenhuma saída é
# silenciosa. Card próprio só nasce pela porta `card`, e quem o cria é a cadeira que assume,
# com o verbo `criar`; `matar --porta card` registra a passagem.
#
# A trilha própria de débito no rastreador é o #3176, parado por decisão do dono. Quando
# ela existir, este verbo passa a falar com ela, e o balde em linhas migra.
DT_PAI="${TAREFAS_DT_PAI:-2856}"

# Toda a leitura e a escrita das linhas passam por este programa: recebe o corpo em texto
# no stdin e o ato no argumento. Leitura imprime a tabela; escrita grava o corpo novo em
# $DT_SAIDA e imprime a linha do relato. Corpo sem as duas seções sai 3: o verbo não
# adivinha onde pôr a linha.
_dt_py() {
  python3 -c '
import datetime, os, re, sys

op = sys.argv[1]
pai = os.environ.get("DT_PAI", "?")
linhas = [l.rstrip() for l in sys.stdin.read().splitlines()]
ITEM = re.compile(r"^(\d+)\.\s+\[(\d{4}-\d{2}-\d{2})\]\s+(.*)$")
NUM = re.compile(r"^(\d+)\.\s")


def secao(nome):
    for i, l in enumerate(linhas):
        if l.strip().lower() == ("## " + nome).lower():
            return i
    return -1


def fim_da_secao(ini):
    for j in range(ini + 1, len(linhas)):
        if linhas[j].startswith("## "):
            return j
    return len(linhas)


ia, isd = secao("Abertos"), secao("Saídas")
if ia < 0 or isd < 0 or isd < ia:
    sys.stderr.write("corpo do balde #%s fora da forma: faltam as seções «## Abertos» e «## Saídas», nesta ordem\n" % pai)
    sys.exit(3)

hoje = datetime.date.fromisoformat(os.environ.get("DT_HOJE") or datetime.date.today().isoformat())
abertos = []
for i in range(ia + 1, fim_da_secao(ia)):
    m = ITEM.match(linhas[i])
    if m:
        abertos.append((i, int(m.group(1)), m.group(2), m.group(3)))


def idade(d):
    try:
        return (hoje - datetime.date.fromisoformat(d)).days
    except ValueError:
        return -1


def grava(ls):
    out = []
    for l in ls:
        if l.startswith("## "):
            while out and out[-1] == "":
                out.pop()
            if out:
                out.append("")
            out.extend([l, ""])
        elif l == "" and (not out or out[-1] == ""):
            continue
        else:
            out.append(l)
    while out and out[-1] == "":
        out.pop()
    with open(os.environ["DT_SAIDA"], "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


if op in ("listar", "vencidos"):
    sel = abertos if op == "listar" else [a for a in abertos if idade(a[2]) > 30]
    if os.environ.get("DT_DESDE"):
        sel = [a for a in sel if a[1] >= int(os.environ["DT_DESDE"])]
    if not sel:
        print("(balde vazio: nenhuma linha aberta em #%s)" % pai if op == "listar"
              else "pauta vazia: nenhuma linha acima de 30 dias em #%s" % pai)
        sys.exit(0)
    if op == "vencidos":
        print("PAUTA DA REVISÃO: linhas acima de 30 dias (rito §2)")
    print("n\tidade\tdébito")
    for _, n, d, r in sel:
        if os.environ.get("DT_CURTO") == "1":
            r = r.split(" · ", 1)[0]
            r = r if len(r) <= 200 else r[:199] + "…"
        print("%d\t%dd\t%s" % (n, idade(d), r))
    sys.exit(0)

if op == "admitir":
    nums = [int(m.group(1)) for l in linhas[ia + 1:] for m in [NUM.match(l)] if m]
    n = max(nums, default=0) + 1
    data, texto = os.environ["DT_DATA"], os.environ["DT_TXT"]
    pos = abertos[-1][0] + 1 if abertos else ia + 1
    linhas.insert(pos, "%d. [%s] %s" % (n, data, texto))
    grava(linhas)
    print("débito %d admitido no balde #%s: [%s] %s" % (n, pai, data, texto))
    sys.exit(0)

if op == "matar":
    n = int(os.environ["DT_N"])
    alvo = [a for a in abertos if a[1] == n]
    if not alvo:
        sys.stderr.write("linha %d não está aberta no balde #%s; as abertas saem em `tarefas dt listar`\n" % (n, pai))
        sys.exit(1)
    linha = linhas.pop(alvo[0][0])
    isd = secao("Saídas")
    fim = fim_da_secao(isd)
    for j in range(fim - 1, isd, -1):
        if linhas[j].strip().startswith("(nenhuma"):
            linhas.pop(j)
            fim -= 1
    saida = "%s → %s em %s: %s" % (linha, os.environ["DT_PORTA"], hoje.isoformat(), os.environ["DT_ANCORA"])
    linhas.insert(fim, saida)
    grava(linhas)
    print("débito %d saiu do balde #%s: %s em %s: %s" % (n, pai, os.environ["DT_PORTA"], hoje.isoformat(), os.environ["DT_ANCORA"]))
    sys.exit(0)

sys.stderr.write("ato interno desconhecido: %s\n" % op)
sys.exit(2)
' "$@"
}

# O corpo do balde em texto, como o `ler` o mostra.
_dt_corpo() {
  local j; j=$(busca GET "/itens/$DT_PAI") || return 1
  printf '%s' "$j" | jq -r '.descricao // ""' | para_texto
}

# Grava o corpo novo, que o `_dt_py` deixou em arquivo. Um PATCH só, sem estado.
_dt_grava() {
  local html; html=$(para_html < "$1")
  jq -n --arg d "$html" '{descricao:$d}' | envia PATCH "/itens/$DT_PAI" >/dev/null
}

# Roda um ato de escrita: lê o corpo, deixa o `_dt_py` montar o novo, grava, relata.
# Falha do programa ou da gravação sai com o código dele, e o corpo fica como estava.
_dt_escreve() { # _dt_escreve <ato>  (parâmetros do ato em DT_*)
  local corpo tmp msg rc=0
  corpo=$(_dt_corpo) || return 1
  tmp=$(mktemp)
  msg=$(printf '%s' "$corpo" | DT_PAI="$DT_PAI" DT_SAIDA="$tmp" _dt_py "$1") || rc=$?
  if [ "$rc" -ne 0 ]; then rm -f "$tmp"; return "$rc"; fi
  _dt_grava "$tmp" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  printf '%s\n' "$msg"
}

dt_listar() {
  # --desde <n> e --curto (#2856 linha 143): a lista inteira passa dos 50 KB que a porta serve.
  local desde="" curto=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --desde) [ $# -ge 2 ] || { echo "--desde exige o número da linha: tarefas dt listar --desde <n>" >&2; exit 2; }; desde="$2"; shift 2 ;;
      --curto) curto=1; shift ;;
      *) echo "opção desconhecida: $1 (uso: tarefas dt listar [--desde <n>] [--curto])" >&2; exit 2 ;;
    esac
  done
  case "$desde" in
    '') ;;
    *[!0-9]*) echo "--desde exige o número da linha: tarefas dt listar --desde <n>" >&2; exit 2 ;;
  esac
  local corpo; corpo=$(_dt_corpo) || return 1
  printf '%s' "$corpo" | DT_PAI="$DT_PAI" DT_DESDE="$desde" DT_CURTO="$curto" _dt_py listar
}

# `vencidos` É A PAUTA DA REVISÃO, GERADA (rito §2/§4): linhas acima de 30 dias pela data
# da medição. Sem montagem à mão e sem alerta: o verbo mede quando chamado, a revisão decide.
dt_vencidos() {
  local corpo; corpo=$(_dt_corpo) || return 1
  printf '%s' "$corpo" | DT_PAI="$DT_PAI" _dt_py vencidos
}

# `admitir` É O TESTE DE ADMISSÃO VIRANDO CÓDIGO (rito §1): sem --evidencia ou sem
# --medido-em em AAAA-MM-DD, RECUSA. Suspeita não é DT: vira medição ou morre.
dt_admitir() {
  local texto="${1:-}"; shift || true
  local medido_em="" evidencia="" verbo="" solucao="" cadeira=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --medido-em) medido_em="${2:-}"; shift 2 ;;
      --evidencia) evidencia="${2:-}"; shift 2 ;;
      --verbo)     verbo="${2:-}";     shift 2 ;;
      --solucao)   solucao="${2:-}";   shift 2 ;;
      --cadeira)   cadeira="${2:-}";   shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  if [ -z "$texto" ]; then
    echo "uso: tarefas dt admitir \"<o que falha>\" --medido-em <AAAA-MM-DD> --evidencia <onde se mediu> [--verbo <v>] [--solucao \"<txt>\"] [--cadeira <c>]" >&2
    exit 2
  fi
  if [ -z "$evidencia" ]; then
    echo "recusado: DT sem --evidencia não entra. Suspeita não é DT: meça (repro, retorno colado, arquivo:linha) ou não abra. (rito §1)" >&2
    exit 2
  fi
  if ! printf '%s' "$medido_em" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
    echo "recusado: DT sem --medido-em AAAA-MM-DD não entra. A linha do rito diz o que foi medido, QUANDO e onde, e a idade da linha sai dessa data. (rito §1)" >&2
    exit 2
  fi
  local linha="${verbo:+$verbo — }$texto · $evidencia"
  [ -n "$solucao" ] && linha="$linha · solução: $solucao"
  [ -n "$cadeira" ] && linha="$linha · cadeira: $cadeira"
  DT_DATA="$medido_em" DT_TXT="$linha" _dt_escreve admitir
}

# `matar` É A SAÍDA DO RITO (§3): quatro portas, nenhuma silenciosa.
#   card       ganhou dor ou dono; --card <id> do card que assume (a cadeira o cria antes)
#   obsoleto   o objeto não existe mais; --ancora com o retorno colado que prova, nunca memória
#   decisao    existe e custa mais do que dói; --ancora com a decisão do dono (quem assina é ele)
#   englobado  absorvido por card maior; --card <id> de quem engloba
dt_matar() {
  local n="${1:-}"; shift || true
  local porta="" ancora="" card=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --porta)  porta="${2:-}";  shift 2 ;;
      --ancora) ancora="${2:-}"; shift 2 ;;
      --card)   card="${2:-}";   shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  case "$n" in
    ''|*[!0-9]*) echo "uso: tarefas dt matar <n> --porta <card|obsoleto|decisao|englobado> [--card <id>] [--ancora \"<txt>\"]" >&2; exit 2 ;;
  esac
  local rotulo
  case "$porta" in
    card|englobado)
      if [ -z "$card" ]; then
        echo "recusado: a porta $porta exige --card <id> (o card que $([ "$porta" = card ] && echo assume || echo engloba)). (rito §3)" >&2
        exit 2
      fi
      card=$(so_id "$card")
      busca GET "/itens/$card" >/dev/null || { echo "recusado: o card #$card não se lê no rastreador" >&2; exit 1; }
      ancora="#$card${ancora:+ — $ancora}"
      rotulo=$([ "$porta" = card ] && echo "vira card" || echo "englobado") ;;
    obsoleto|decisao)
      if [ -z "$ancora" ]; then
        if [ "$porta" = obsoleto ]; then
          echo "recusado: morrer por obsolescência exige --ancora com o retorno colado que mostra que o objeto não existe mais; memória não ancora. (rito §3)" >&2
        else
          echo "recusado: morrer por decisão exige --ancora com a decisão do dono (quem assina essa porta é ele). (rito §3)" >&2
        fi
        exit 2
      fi
      rotulo=$([ "$porta" = obsoleto ] && echo "morre por obsolescência" || echo "morre por decisão do dono") ;;
    *)
      echo "recusado: --porta é card, obsoleto, decisao ou englobado — as quatro saídas do rito §3" >&2
      exit 2 ;;
  esac
  DT_N="$n" DT_PORTA="$rotulo" DT_ANCORA="$ancora" _dt_escreve matar
}

dt() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    listar)   dt_listar "$@" ;;
    admitir)  dt_admitir "$@" ;;
    matar)    dt_matar "$@" ;;
    vencidos) dt_vencidos "$@" ;;
    ''|*)
      cat >&2 <<'FIM'
uso:
  tarefas dt listar                       linhas abertas do balde, com a idade em dias;
                                          --desde <n> lê só da linha n em diante, --curto tira a evidência
  tarefas dt admitir "<o que falha>" --medido-em <AAAA-MM-DD> --evidencia <onde se mediu>
                [--verbo <v>] [--solucao "<txt>"] [--cadeira <c>]
                                          acrescenta a linha numerada; SEM --evidencia ou
                                          sem data, RECUSA — teste de admissão (rito §1)
  tarefas dt matar <n> --porta <card|obsoleto|decisao|englobado> [--card <id>] [--ancora "<txt>"]
                                          tira a linha pela porta do rito §3 e a registra
                                          em Saídas; card e englobado pedem --card, obsoleto
                                          e decisao pedem --ancora
  tarefas dt vencidos                     pauta da revisão: linhas acima de 30 dias (rito §2)

O balde é o corpo do card #{TAREFAS_DT_PAI:-2856}: seções «## Abertos» e «## Saídas», um
débito por linha «N. [AAAA-MM-DD] texto». Card próprio só pela porta card.
Rito: padrao rito-debito-tecnico
FIM
      exit 2 ;;
  esac
}

# --- despacho ---------------------------------------------------------------

# --ajuda UNIVERSAL, sem efeito colateral (card #2274, defeito 4). ANTES do despacho e
# varrendo TODOS os argumentos: `tarefas criar --ajuda` criava um card chamado "--ajuda"
# porque `--ajuda` caía como título posicional. Interceptar aqui cobre tanto `tarefas
# --ajuda` quanto `tarefas <sub> --ajuda`, e nenhum sub-ato chega a rodar. `uso` já sai 2.
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso 0 ;;
  esac
done

cmd="${1:-}"; shift || uso

case "$cmd" in
  listar)      descarta_projeto "${1:-}" && shift; listar "$@" ;;
  listar-tudo) descarta_projeto "${1:-}" && shift; listar_tudo "$@" ;;
  ler|ver)     ler "${1:?uso: tarefas ler <id>}" ;;
  criar)       criar "$@" ;;
  editar)      editar "$@" ;;
  comentar)    comentar "$@" ;;
  comentarios) comentarios "${1:?uso: tarefas comentarios <id>}" ;;
  mover)       mover "$@" ;;
  fechar)      fechar "${1:?uso: tarefas fechar <id>}" "${@:2}" ;;
  apagar)      apagar "${1:?uso: tarefas apagar <id> [--cascata]}" "${@:2}" ;;
  apagar-comentario) apagar_comentario "${1:?uso: tarefas apagar-comentario <id> <cid>}" "${2:?cid}" ;;
  assinar)     assinar "${1:?uso: tarefas assinar <id> --aprovador <cadeira> [--decisao aprovado|recusado] [--motivo \"<txt>\"]}" "${@:2}" ;;
  sub)         subtarefa "${1:?pai}" "${2:?filho}" ;;
  modelo)      modelo "${1:-}" "${2:-}" ;;
  estados)     estados ;;
  dt)          dt "$@" ;;
  projetos)    echo "não há projeto neste modelo: o recorte é por eixo (cadeira, estado, nível)." >&2; exit 2 ;;
  api)         busca "${1:?método}" "$(_apipath "${2:?caminho}")" ;;
  api-corpo)   envia "${1:?método}" "$(_apipath "${2:?caminho}")" ;;
  *)           uso ;;
esac
