#!/usr/bin/env bash
# tarefas — cliente do rastreador de tarefas da PlataFirma.
# Verbo genérico de propósito: hoje o backend é Vikunja; o nome não o cita para
# que a troca de backend não obrigue a reescrever chamada em persona nenhuma.
#
# Credencial: VIKUNJA_API_TOKEN, do ambiente ou de $TAREFAS_ENV
# (default ~/AI/platafirma-core/.env). Base: $TAREFAS_BASE.
set -euo pipefail

ENVFILE="${TAREFAS_ENV:-$HOME/AI/platafirma-core/.env}"
BASE="${TAREFAS_BASE:-https://tarefas.platafirma.org/api/v1}"

if [ -z "${VIKUNJA_API_TOKEN:-}" ]; then
  [ -r "$ENVFILE" ] || {
    echo "sem credencial: $ENVFILE não existe ou não é legível" >&2
    echo "(ou exporte VIKUNJA_API_TOKEN no ambiente)" >&2
    exit 1
  }
  set -a; . "$ENVFILE"; set +a
fi
AUTH="Authorization: Bearer ${VIKUNJA_API_TOKEN:?VIKUNJA_API_TOKEN vazio em $ENVFILE}"

uso() {
  cat >&2 <<'FIM'
uso:
  tarefas projetos                        id e nome de cada projeto
  tarefas listar <projeto> [--todos]      cards abertos (--todos inclui fechados)
  tarefas ler <id>                        card em texto, com labels e descrição
  tarefas criar <projeto> "<título>" [--desc "<txt>"|--desc-stdin] [--prio N]
  tarefas comentar <id> ["<txt>"]         sem texto, lê de stdin
  tarefas fechar <id>                     marca done (GET, muta, POST inteiro)
  tarefas sub <pai> <filho>               declara <filho> subtarefa de <pai>
  tarefas api <MÉTODO> <caminho> [-]      escotilha: corpo JSON em stdin com "-"
FIM
  exit 2
}

api() { # api MÉTODO /caminho [-]
  local m="$1" p="$2"
  if [ "${3:-}" = "-" ]; then
    curl -sfS -X "$m" "$BASE$p" -H "$AUTH" -H 'Content-Type: application/json' -d @-
  else
    curl -sfS -X "$m" "$BASE$p" -H "$AUTH"
  fi
}

# texto -> HTML: o rastreador guarda descrição e comentário em HTML.
para_html() {
  python3 -c 'import html,sys
t = html.escape(sys.stdin.read().strip())
print("".join("<p>%s</p>" % b.replace("\n", "<br>") for b in t.split("\n\n") if b.strip()))'
}

# HTML -> texto legível no terminal.
para_texto() {
  sed -e 's#</p>#\n#g' -e 's#<br */\?>#\n#g' -e 's#</h[0-9]>#\n#g' \
      -e 's#<li>#  - #g' -e 's#</li>#\n#g' -e 's#</pre>#\n#g' \
      -e 's#<[^>]*>##g' \
      -e 's#&lt;#<#g' -e 's#&gt;#>#g' -e 's#&quot;#"#g' -e 's#&amp;#\&#g' | cat -s
}

cmd="${1:-}"; shift || uso

case "$cmd" in
  projetos)
    api GET /projects | jq -r '.[] | "\(.id)\t\(.title)"'
    ;;

  listar)
    proj="${1:?uso: tarefas listar <projeto> [--todos]}"
    todos="${2:-}"
    api GET "/projects/$proj/tasks?per_page=200" \
      | jq -r --arg t "$todos" '
          .[] | select($t == "--todos" or .done == false)
          | "\(.id)\t\(if .done then "x" else " " end)\t\(.title)"'
    ;;

  ler)
    id="${1:?uso: tarefas ler <id>}"
    api GET "/tasks/$id" | jq -r '
      "# \(.title)\n\(.identifier) · projeto=\(.project_id) · done=\(.done) · labels: \([.labels[]?.title]|join(", "))\n\n\(.description // "")"' \
      | para_texto
    ;;

  criar)
    proj="${1:?uso: tarefas criar <projeto> \"<título>\" [--desc ...]}"; titulo="${2:?título}"; shift 2
    desc=""; prio=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --desc)       desc="$2"; shift 2 ;;
        --desc-stdin) desc="$(cat)"; shift ;;
        --prio)       prio="$2"; shift 2 ;;
        *) echo "opção desconhecida: $1" >&2; exit 2 ;;
      esac
    done
    html=""; [ -n "$desc" ] && html="$(printf '%s' "$desc" | para_html)"
    jq -n --arg t "$titulo" --arg d "$html" --argjson p "$prio" \
       '{title:$t, description:$d, priority:$p}' \
      | api PUT "/projects/$proj/tasks" - \
      | jq -r '"card \(.id) criado: \(.title)"'
    ;;

  comentar)
    id="${1:?uso: tarefas comentar <id> [\"<txt>\"]}"
    if [ $# -ge 2 ]; then txt="$2"; else txt="$(cat)"; fi
    jq -n --arg c "$(printf '%s' "$txt" | para_html)" '{comment:$c}' \
      | api PUT "/tasks/$id/comments" - \
      | jq -r --arg id "$id" '"comentário \(.id) publicado no card \($id)"'
    ;;

  fechar)
    id="${1:?uso: tarefas fechar <id>}"
    api GET "/tasks/$id" | jq '.done = true' | api POST "/tasks/$id" - \
      | jq -r '"card \(.id) fechado: \(.title)"'
    ;;

  sub)
    pai="${1:?uso: tarefas sub <pai> <filho>}"; filho="${2:?filho}"
    jq -n --argjson o "$filho" '{other_task_id:$o, relation_kind:"subtask"}' \
      | api PUT "/tasks/$pai/relations" - >/dev/null
    echo "card $filho agora é subtarefa de $pai"
    ;;

  api)
    m="${1:?uso: tarefas api <MÉTODO> <caminho> [-]}"; p="${2:?caminho}"
    api "$m" "$p" "${3:-}"
    ;;

  *) uso ;;
esac
