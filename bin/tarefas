#!/usr/bin/env bash
# tarefas — cliente do rastreador de tarefas da PlataFirma.
# capacidade: trabalho
# dono: claudinho-TI
# Verbo genérico de propósito: hoje o backend é Vikunja; o nome não o cita para
# que a troca de backend não obrigue a reescrever chamada em persona nenhuma.
#
# Credencial: primeiro token achado em $TAREFAS_ENV, ~/AI/platafirma-core/.env
# ou ~/.claude/vikunja.env (conta da fabrica). Base: $TAREFAS_BASE.
set -euo pipefail

BASE="${TAREFAS_BASE:-https://tarefas.platafirma.org/api/v1}"

_argv_tem_json() { # varre "$@" por --json — usado só pra decidir o FORMATO da falha
  local a
  for a in "$@"; do [ "$a" = "--json" ] && return 0; done
  return 1
}

# Escaping mínimo à mão (mesmo padrão de bin/monta-sessao) em vez de "jq -Rs ." —
# este caminho é justamente o de falha, e depender de jq pra reportar uma falha
# (que pode ser a própria causa da falha, ou simplesmente não estar disponível
# no ambiente) é frágil. String de entrada aqui é sempre estática, sem controle
# de caractere, mas escapamos mesmo assim por hábito de não confiar em input.
_json_esc() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

carrega_credencial() { # carrega_credencial "$@" — argv só pra saber se --json foi pedido
  [ -n "${VIKUNJA_API_TOKEN:-}" ] && return 0
  local f
  for f in "${TAREFAS_ENV:-}" "$HOME/AI/platafirma-core/.env" "$HOME/.claude/vikunja.env"; do
    [ -n "$f" ] && [ -r "$f" ] || continue
    set -a; . "$f"; set +a
    # ~/.claude/vikunja.env (conta da fabrica) nomeia a chave sem o infixo API.
    VIKUNJA_API_TOKEN="${VIKUNJA_API_TOKEN:-${VIKUNJA_TOKEN:-}}"
    [ -n "$VIKUNJA_API_TOKEN" ] && { BASE="${VIKUNJA_BASE:-$BASE}"; return 0; }
  done
  local msg="sem credencial: nenhum de \$TAREFAS_ENV, ~/AI/platafirma-core/.env, ~/.claude/vikunja.env traz token (ou exporte VIKUNJA_API_TOKEN)."
  # --json: stdout nunca fica vazio numa falha — mesma regra do LOTE 1 nos outros verbos.
  # Sem --json, comportamento intocado: só a mensagem solta em stderr, como sempre foi.
  if _argv_tem_json "$@"; then
    printf '{"erro": "%s"}\n' "$(_json_esc "$msg")"
  fi
  echo "$msg" >&2
  exit 1
}

uso() {
  cat >&2 <<'FIM'
uso:
  tarefas projetos                        id e nome de cada projeto
  tarefas listar <projeto>                cards abertos
  tarefas listar-tudo <projeto>           inclui os fechados
  tarefas ler <id>|#<index>               card em texto, com labels e descrição
  tarefas criar <projeto> "<título>" [--desc "<txt>"|--desc-stdin] [--prio N]
  tarefas comentar <id> ["<txt>"]         sem texto, lê de stdin
  tarefas fechar <id>                     marca done (GET, muta, POST inteiro)
  tarefas sub <pai> <filho>               declara <filho> subtarefa de <pai>
  tarefas api <MÉTODO> <caminho>          escotilha, sem corpo
  tarefas api-corpo <MÉTODO> <caminho>    escotilha, corpo JSON em stdin
FIM
  exit 2
}

# --- transporte -------------------------------------------------------------

busca() { # busca MÉTODO /caminho
  curl -sfS -X "$1" "$BASE$2" -H "Authorization: Bearer $VIKUNJA_API_TOKEN"
}

envia() { # envia MÉTODO /caminho  (corpo JSON em stdin)
  curl -sfS -X "$1" "$BASE$2" -H "Authorization: Bearer $VIKUNJA_API_TOKEN" \
       -H 'Content-Type: application/json' -d @-
}

# --- descrição: o rastreador guarda em HTML ---------------------------------

para_html() {
  python3 -c 'import html,sys
t = html.escape(sys.stdin.read().strip())
print("".join("<p>%s</p>" % b.replace("\n", "<br>") for b in t.split("\n\n") if b.strip()))'
}

para_texto() {
  sed -e 's#</p>#\n#g' -e 's#<br */\?>#\n#g' -e 's#</h[0-9]>#\n#g' \
      -e 's#<li>#  - #g' -e 's#</li>#\n#g' -e 's#</pre>#\n#g' \
      -e 's#<[^>]*>##g' \
      -e 's#&lt;#<#g' -e 's#&gt;#>#g' -e 's#&quot;#"#g' -e 's#&amp;#\&#g' | cat -s
}

# --- verbos -----------------------------------------------------------------

linhas_de_card() { # filtra o JSON de uma lista de cards em id / marca / título
  jq -r "$1"' | "\(.id)\t\(if .done then "x" else " " end)\t\(.title)"'
}

# per_page tem teto de 50 no servidor: pedir 200 devolve 50 em silêncio. Toda
# listagem pagina até x-pagination-total-pages, ou some com card sem avisar.
paginas() { # paginas /caminho?query — concatena todas as páginas num só array
  local caminho="$1" pag=1 total=1 corpo hdr rc
  while [ "$pag" -le "$total" ]; do
    hdr=$(mktemp)
    corpo=$(curl -sfS -D "$hdr" "$BASE$caminho&per_page=50&page=$pag" \
            -H "Authorization: Bearer $VIKUNJA_API_TOKEN")
    rc=$?
    # Checagem explícita, não "set -e" implícito: esta função é chamada de dentro de
    # contextos testados (ex.: "saida=$(paginas ...) && ... || ...", em listar()), e
    # bash suspende errexit pra toda a árvore de chamadas nesse caso — sem o "$rc"
    # explícito, um curl falho no meio da paginação passaria batido, o loop terminaria
    # "normal" (total já resolvido, pag>total) e "jq -s 'add // []'" transformaria a
    # ausência de dado em "[]", indistinguível de projeto genuinamente vazio.
    if [ "$rc" -ne 0 ]; then rm -f "$hdr"; return "$rc"; fi
    [ "$pag" = 1 ] && total=$(awk -F': *' 'tolower($1)=="x-pagination-total-pages"{gsub(/\r/,"",$2);print $2}' "$hdr")
    total="${total:-1}"; rm -f "$hdr"; printf '%s\n' "$corpo"; pag=$((pag+1))
  done | jq -s 'add // []'
}

# id negativo é filtro salvo, não projeto: /projects/-8/tasks devolve 404.
projetos()     { busca GET /projects | jq -r '.[] | select(.id > 0) | "\(.id)\t\(.title)"'; }

# --json: "paginas" já devolve o array JSON pronto — sem --json, o mesmo array
# passa por linhas_de_card pra virar texto tabulado (comportamento inalterado).
listar() { # listar <projeto> [--json]
  local proj="$1"; shift || true
  local json=""
  local a
  for a in "$@"; do [ "$a" = "--json" ] && json=1; done
  if [ -n "$json" ]; then
    # "paginas" pode falhar no meio da paginação (curl de uma página não-primeira) e,
    # por causa de "jq -s 'add // []'" no fim do pipe, ainda assim deixar ALGO em stdout
    # (array vazio, ou só as páginas que deram certo antes de falhar) — indistinguível de
    # sucesso pra quem só olha stdout. O exit code de "paginas" (pipefail) já é o certo;
    # aqui só garantimos que a FALHA também aparece em stdout como objeto, nunca como um
    # "[]" que passa por sucesso vazio.
    local saida rc
    saida=$(paginas "/projects/$proj/tasks?filter=done%20%3D%20false") && rc=0 || rc=$?
    if [ "$rc" -eq 0 ]; then
      printf '%s\n' "$saida"
    else
      printf '{"erro": "busca ao rastreador falhou (paginas saiu %s) — ver stderr"}\n' "$rc"
      return "$rc"
    fi
  else
    paginas "/projects/$proj/tasks?filter=done%20%3D%20false" | linhas_de_card '.[]'
  fi
}

# --json: card carrega titulo/fechado/fechado_em. Vikunja nao usa JSON null
# pra "nao fechado" -- done_at vem como o zero-value do Go, "0001-01-01T00:
# 00:00Z", que normalizamos pra null de verdade (a regua do card #394: campo
# presente e nulo, nunca ausente, nunca a data zero disfarcada de data real).
listar_tudo() { # listar_tudo <projeto> [--json]
  local proj="$1"; shift || true
  local json=""
  local a
  for a in "$@"; do [ "$a" = "--json" ] && json=1; done
  if [ -n "$json" ]; then
    local saida rc
    saida=$(paginas "/projects/$proj/tasks?") && rc=0 || rc=$?
    if [ "$rc" -eq 0 ]; then
      printf '%s\n' "$saida" | jq -c '[.[] | {
        id, titulo: .title, fechado: .done,
        fechado_em: (if .done_at == "0001-01-01T00:00:00Z" then null else .done_at end)
      }]'
    else
      printf '{"erro": "busca ao rastreador falhou (paginas saiu %s) — ver stderr"}\n' "$rc"
      return "$rc"
    fi
  else
    paginas "/projects/$proj/tasks?" | linhas_de_card '.[]'
  fi
}

# "#267" é o index dentro do projeto (o que a fila cita); "360" é o id (a chave).
# Os dois números convivem no mesmo card — sem esta distinção a busca vira caça.
por_index() { paginas "/projects/${PROJETO_PADRAO:-46}/tasks?filter=index%20%3D%20$1" \
                | jq -r '.[0].id // empty'; }

ler() {
  local alvo="$1"
  case "$alvo" in \#*) alvo=$(por_index "${alvo#\#}") ;; esac
  [ -n "$alvo" ] || { echo "não achei card com esse #index" >&2; exit 1; }
  busca GET "/tasks/$alvo" | jq -r '
    "# \(.title)\n\(.identifier) · projeto=\(.project_id) · done=\(.done) · labels: \([.labels[]?.title]|join(", "))\n\n\(.description // "")"' \
    | para_texto
}

criar() {
  local proj="$1" titulo="$2"; shift 2
  local desc="" prio=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --desc)       desc="$2"; shift 2 ;;
      --desc-stdin) desc="$(cat)"; shift ;;
      --prio)       prio="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  local html=""
  [ -n "$desc" ] && html="$(printf '%s' "$desc" | para_html)"
  jq -n --arg t "$titulo" --arg d "$html" --argjson p "$prio" \
     '{title:$t, description:$d, priority:$p}' \
    | envia PUT "/projects/$proj/tasks" \
    | jq -r '"card \(.id) criado: \(.title)"'
}

comentar() {
  local id="$1" txt="${2:-$(cat)}"
  jq -n --arg c "$(printf '%s' "$txt" | para_html)" '{comment:$c}' \
    | envia PUT "/tasks/$id/comments" \
    | jq -r --arg id "$id" '"comentário \(.id) publicado no card \($id)"'
}

fechar() {
  busca GET "/tasks/$1" | jq '.done = true' | envia POST "/tasks/$1" \
    | jq -r '"card \(.id) fechado: \(.title)"'
}

subtarefa() {
  jq -n --argjson o "$2" '{other_task_id:$o, relation_kind:"subtask"}' \
    | envia PUT "/tasks/$1/relations" >/dev/null
  echo "card $2 agora é subtarefa de $1"
}

# --- despacho ---------------------------------------------------------------

carrega_credencial "$@"
cmd="${1:-}"; shift || uso

case "$cmd" in
  projetos)    projetos ;;
  listar)      listar      "${1:?uso: tarefas listar <projeto>}" "${@:2}" ;;
  listar-tudo) listar_tudo "${1:?uso: tarefas listar-tudo <projeto>}" "${@:2}" ;;
  ler)         ler         "${1:?uso: tarefas ler <id>}" ;;
  criar)       criar "${1:?projeto}" "${2:?título}" "${@:3}" ;;
  comentar)    comentar "${1:?uso: tarefas comentar <id> [\"<txt>\"]}" "${2:-$(cat)}" ;;
  fechar)      fechar      "${1:?uso: tarefas fechar <id>}" ;;
  sub)         subtarefa "${1:?pai}" "${2:?filho}" ;;
  api)         busca "${1:?método}" "${2:?caminho}" ;;
  api-corpo)   envia "${1:?método}" "${2:?caminho}" ;;
  *)           uso ;;
esac
