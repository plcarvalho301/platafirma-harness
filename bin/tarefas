#!/usr/bin/env bash
# tarefas — cliente do rastreador de trabalho da PlataFirma.
# capacidade: trabalho
# dono: gestao-estrategica
# use para: card, board, carteira, épico/feature/story, mover estado, sign-off
# atos: listar, listar-tudo, ler, criar, editar, modelo, comentar, comentarios, mover, fechar, apagar, assinar, dt, estados, sub, ordenar, bloquear, desbloquear, carteira, espera-dono (leitura, trabalho)
# mecanismo: espera-dono=casca
#
# Texto do controle (arq:0124 §3; arq:0125 U33; card #3446). Todo ato cai na face Entrega.
# Rótulo: verbo no infinitivo e objeto sem artigo, um verbo por tipo de ato (Listar uma coleção,
# Abrir um item; regra de produto, comentário #2216 do #3446). O objeto entra pelo slug, `{slug}`,
# quando o conceito é do tesauro; termo da casa (card, comentário, estado, débito técnico) vai
# escrito até o tesauro ter o braço da casa (arq:0124 §3, emenda de 12/10/2026). volta: diz se
# o efeito se desfaz; ato que só lê declara exatamente `sim — só lê`.
# face: listar=Entrega
# face: listar-tudo=Entrega
# face: ler=Entrega
# face: criar=Entrega
# face: editar=Entrega
# face: modelo=Entrega
# face: comentar=Entrega
# face: comentarios=Entrega
# face: mover=Entrega
# face: fechar=Entrega
# face: apagar=Entrega
# face: assinar=Entrega
# face: dt=Entrega
# face: estados=Entrega
# face: sub=Entrega
# face: ordenar=Entrega
# face: bloquear=Entrega
# face: desbloquear=Entrega
# face: carteira=Entrega
# rotulo: listar=Listar card aberto
# rotulo: listar-tudo=Listar card, fechado inclusive
# rotulo: ler=Abrir card
# rotulo: criar=Criar card
# rotulo: editar=Editar card
# rotulo: modelo=Abrir molde de card
# rotulo: comentar=Comentar card
# rotulo: comentarios=Listar comentário
# rotulo: mover=Mover card
# rotulo: fechar=Fechar card
# rotulo: apagar=Apagar card
# rotulo: assinar=Assinar card
# rotulo: dt=Administrar débito técnico
# rotulo: estados=Listar estado de card
# rotulo: sub=Subordinar card
# rotulo: ordenar=Ordenar card
# rotulo: bloquear=Bloquear card
# rotulo: desbloquear=Desbloquear card
# rotulo: carteira=Ler carteira
# volta: listar=sim — só lê
# volta: listar-tudo=sim — só lê
# volta: ler=sim — só lê
# volta: criar=sim — tarefas apagar, enquanto o item está no funil
# volta: editar=nao
# volta: modelo=sim — só lê
# volta: comentar=nao
# volta: comentarios=sim — só lê
# volta: mover=sim — tarefas mover ao estado de antes, onde o fluxo deixa (a recusa diz para onde se pode ir)
# volta: fechar=nao
# volta: apagar=nao
# volta: assinar=nao
# volta: dt=nao
# volta: estados=sim — só lê
# volta: sub=nao
# volta: ordenar=sim — tarefas ordenar do card ao lado do vizinho de antes (o posto antigo não volta, o lugar sim)
# volta: bloquear=sim — tarefas desbloquear
# volta: desbloquear=sim — tarefas bloquear
# volta: carteira=sim — só lê
# Backend: `platafirma-rastreador` (API própria), desde 16/08/2026. O Vikunja saiu.
#
# Loopback, e não a rota pública: `tarefas.platafirma.org` serve a superfície HUMANA
# atrás do gate do control-plane, e agente não atravessa oauth2-proxy. O agente entra
# pelo loopback da máquina, que já é a fronteira dele (card #469).
#
# SEM CREDENCIAL, por desenho: não há auth no código do módulo. Quem escreve declara o
# nome no cabeçalho de sujeito, e é ele que a transição carimba — `PF_CADEIRA` vira
# `x-auth-request-preferred-username`. Ausente, a escrita entra como anônima.
set -euo pipefail

# `/api` desde o contract do #196: a tela do rastreador saiu de dentro da imagem da API
# e virou servico proprio, e quem separa os dois e o gate da borda, que roteia por
# prefixo de path. A arvore de dado deixou de responder na raiz — sem o prefixo aqui,
# este verbo quebraria para toda cadeira no mesmo minuto.
# O loopback continua sendo a porta do agente (card #469): a borda gateia a superficie
# HUMANA, e um Bearer de agente nao atravessa oauth2-proxy.
BASE="${TAREFAS_BASE:-http://127.0.0.1:8120/api}"

# ESCOTILHA: BASE ja termina em /api. O caminho natural (rota real, ex. /api/itens/2930)
# duplicava o prefixo -> /api/api/... -> 404 mudo ("falha ao falar"). Card do 8120.
# Normaliza na BORDA: aceita com ou sem /api; chamadores internos (que passam /itens/...)
# nao passam por aqui, nao regridem.
_apipath() {
  case "$1" in
    /api)   printf '/' ;;
    /api/*) printf '%s' "${1#/api}" ;;
    *)      printf '%s' "$1" ;;
  esac
}
QUEM="${PF_CADEIRA:-}"

# Pedido de ajuda nao e erro (dono, 12/09/2026): `--ajuda` sai por stdout com exit 0; so
# a chamada errada continua saindo por stderr com exit 2.
uso() {
  local codigo="${1:-2}" fd=2
  [ "$codigo" = 0 ] && fd=1
  cat >&$fd <<'FIM'
uso:
  tarefas listar [--cadeira <c>] [--estado <e>] [--nivel <n>] [--originacao <o>] [--executor <c>]
                [--paradas] [--json]
                                          itens abertos (fase != terminal), na ordem do posto;
                                          as paradas (despriorizada) ficam de fora salvo --paradas
                                          ou --estado despriorizada
  tarefas listar --quadro discovery|delivery [--paradas] [--json]
                                          a projeção pronta do rastreador (R35): id, estado
                                          mostrado, cadeira, executor e título, na ordem dele;
                                          sem --paradas, a despriorizada sai do delivery e a
                                          saída diz quantas saíram
  tarefas listar-tudo [mesmos filtros]    inclui os terminais
  tarefas ler|ver <id>                    item em texto: cabeçalho (originação, executor,
                                          quem bloqueia e por quem é bloqueado), ancestrais,
                                          corpo e filhas abertas em ordem de dependência
  tarefas criar "<título>" [--desc "<txt>"|--desc-stdin]
                [--nivel épico|feature|story] [--cadeira <c>] [--pai <id>] [--incidente]
                [--originacao negocio|tecnico|incidente] [--executor <c>]
                                          default: story. Débito técnico não é card: `dt admitir`.
                                          Nascer fora de `captada`, ou sair dela, exige o
                                          corpo no padrão do nível (arq:0096)
  tarefas editar <id> [--titulo "<t>"] [--desc "<txt>"|--desc-stdin]
                [--cadeira <c>|--sem-cadeira] [--nivel épico|feature|story|task]
                [--originacao negocio|tecnico|incidente] [--executor <c>]
                                          troca título, corpo, cadeira, nível, originação e/ou executor (o corpo é
                                          substituído inteiro); não mexe no estado — mover é
                                          `mover`. Cadeira e nível inválidos a API recusa
  tarefas modelo <épico|feature|story|task>
                                          esqueleto do corpo, com os rótulos que a API exige;
                                          épico e feature saem no two-pager
  tarefas modelo story derivada           a story que sai da formalização: aponta R<n>, D<n> ou Peça
  tarefas modelo comentario <tipo>        o comentário tipado: insumo, pergunta, buraco,
                                          requisito ou decisão
  tarefas modelo story refinada           o Plano: segunda camada da story, escrita pelo
                                          executor em em-refinamento-tecnico, depois de ler
                                          o código (arq:0096)
  tarefas comentar <id> ["<txt>"]         cria comentário (entidade própria — card #390,
                                          não altera o corpo do item); sem texto, lê stdin
  tarefas comentar <id> --fecha <n> "<resultado> — <destino>"
                                          escreve «fecho: …» como última linha do comentário n
                                          (comentário tipado; insumo não leva fecho)
  tarefas comentarios <id> [--indice] [--id <n>]... [--desde <n>] [--ultimos <k>]
                                          lista os comentários do item, em ordem. A porta corta a
                                          saída em ~50 KB: em card longo, --indice dá uma linha por
                                          comentário (id, autor, data, tamanho, começo); --id lê
                                          só aquele(s); --desde <n> os de id >= n; --ultimos <k> os
                                          k mais novos
  tarefas mover <id> <estado> [--motivo "<txt>"] [--englobado-em <id>]
                                          move o card pelo fluxo; a recusa diz para onde
                                          se PODE ir a partir do estado atual. Item com
                                          pai devolve junto o derivado do pai e as irmãs
                                          abertas (arq:0095) — é a âncora do PARCIAL:
  tarefas mover <pai> priorizada --decisao <n>
                                          a aposta: <n> é o comentário de decisão do PRÓPRIO
                                          pai; sem ele a API recusa dizendo como informar (R36)
  tarefas fechar <id> [--como <estado>] [--cascata]
                                          fecha; default: entregue. Filha aberta na
                                          subárvore? a recusa NOMEIA quem seria encerrado
                                          junto, e `--cascata` confirma. Para mover, `mover`.
  tarefas apagar <id> [--cascata]        APAGA o item. Fora do miolo do fluxo (funil e
                                         terminal); `--cascata` leva a subárvore junto.
  tarefas assinar <id> --aprovador <c> [--decisao aprovado|recusado] [--motivo "<txt>"]
                                          sign-off. Sem --decisao, inscreve o aprovador
                                          como PENDENTE. `recusado` exige --motivo.
  tarefas sub <pai> [<filho>]             declara <filho> filho de <pai>, ou lista as filhas de <pai>
  tarefas ordenar <id> --antes-de <id> | --depois-de <id>
                                          põe o card ao lado do vizinho na ordem única da casa;
                                          o servidor calcula o posto (R21)
  tarefas bloquear <a> <b>                <a> bloqueia <b>; o que fecharia ciclo a API recusa e o
                                          caminho sai na recusa (R23)
  tarefas desbloquear <a> <b>             retira o vínculo "<a> bloqueia <b>"
  tarefas carteira [--desde <AAAA-MM-DD>] a fatia por originação das stories e tasks entregues
                                          desde a data (padrão: a segunda-feira desta semana), a
                                          linha do balde ao lado e as paradas com idade (R25)
  tarefas mover <id> despriorizada --motivo <código>
                                          o motivo é código da lista do registro; sem ele, ou com
                                          código fora dela, a recusa imprime a lista (R24)
  tarefas dt <listar|admitir|matar|vencidos|indicadores>
                                          balde de débito técnico: dado do rastreador, uma linha
                                          por débito (rito §4); `dt` sem sub lista os atos
  tarefas estados                         os estados do registro, com fase
  tarefas espera-dono                     o que espera o dono: pergunta dirigida a ele, card
                                          pronto para a aposta e pai em homologação; à parte,
                                          o que está com as cadeiras — abertos por card, com a
                                          marca de órfão (R30)
  tarefas api <MÉTODO> <caminho>          escotilha, sem corpo
  tarefas api-corpo <MÉTODO> <caminho>    escotilha, corpo JSON em stdin

NÃO HÁ PROJETO neste modelo. `46` e `1` eram do Vikunja; o recorte agora é por eixo
(cadeira, estado, nível). Chamada antiga com projeto no lugar do primeiro argumento
segue funcionando: o número é ignorado, com aviso em stderr.
FIM
  exit "$codigo"
}

# --- transporte -------------------------------------------------------------

_hdr_sujeito() { [ -n "$QUEM" ] && printf '%s' "x-auth-request-preferred-username: $QUEM"; }

# RECUSA DA API NÃO É SILENCIOSA — card #224. Era `-sfS`, e `-f` DESCARTA O CORPO: toda
# recusa de regra chegava à cadeira como `curl: (22) ... error: 400`, sem uma palavra sobre
# o que a máquina disse. Com `--fail-with-body` (curl 8.5 no host) o corpo vem, e é ele que
# carrega o texto da máquina — inclusive a lista de destinos que este card mandou escrever.
_recusa() { # lê o corpo do erro em $1 e devolve a mensagem da API
  local erro; erro=$(printf '%s' "$1" | jq -r '.erro // empty' 2>/dev/null || true)
  # A LISTA DE DESTINOS SAIU DE DENTRO DE `.erro` E VIROU CAMPO (card #245): no board ela
  # empurrava a coluna, e a API passou a devolver causa e lista separadas. Aqui elas se
  # recolam, porque quem lê terminal quer a frase inteira — o CLI não regride com a mudança
  # de forma. Recusa sem o campo (nascimento, validação de corpo) segue imprimindo só a causa.
  local frase; frase=$(printf '%s' "$1" | jq -r '.frase_destinos // empty' 2>/dev/null || true)
  [ -n "$frase" ] && erro="$erro · $frase"
  # A API fala em `?cascata=1` porque é o parâmetro DELA; quem está no terminal digita
  # `--cascata`. Traduzir na borda é o certo: a API não deve conhecer as flags dos seus
  # clientes, e mandar alguém montar query string na mão para responder uma pergunta que o
  # verbo já sabe fazer é devolver o trabalho que este verbo existe para tirar.
  erro="${erro//\`?cascata=1\`/\`--cascata\`}"
  # CARD #3597 (R16, R31): `exige` é o nome do campo que falta — hoje só `registro-de-negocio`
  # —, para quem lê agir sem reparsear a frase; a tradução é a linha de comando que resolve.
  local exige; exige=$(printf '%s' "$1" | jq -r '.exige // empty' 2>/dev/null || true)
  if [ "$exige" = "registro-de-negocio" ]; then
    erro="$erro · tarefas criar \"<título>\" --estado priorizada --registro \"<porquê>\" (item existente: tarefas comentar <id> \"registro de negócio: <porquê>\" e repita o ato)"
  fi
  # CARD #3526 (R23): o vínculo que fecharia ciclo volta com `caminho` (ids), e a recusa o mostra.
  local caminho; caminho=$(printf '%s' "$1" | jq -r '(.caminho // []) | map("#\(if type == "object" then .id else . end)") | join(" → ")' 2>/dev/null || true)
  [ -n "$caminho" ] && erro="$erro · caminho: $caminho"
  # `-S` sai do curl porque a mensagem util e o CORPO, e a linha `curl: (22) ... 400` so
  # empurrava o texto da maquina para fora da tela. Falha SEM corpo (rede, servico fora)
  # nao fica muda: cai no ramo abaixo, com o endereco que nao respondeu.
  printf '%s\n' "${erro:-falha ao falar com o rastreador em $BASE (sem corpo de erro)}" >&2
  # CARD #3526 (R24): despriorizar sem código da lista (ou com código fora dela) volta com
  # `motivos`, [{codigo, nome}]. A lista é do registro; o verbo só a imprime, uma por linha.
  local motivos; motivos=$(printf '%s' "$1" | jq -r '(.motivos // [])[] | "  \(.codigo)\t\(.nome)"' 2>/dev/null || true)
  [ -n "$motivos" ] && printf 'motivos (um destes códigos em --motivo):\n%s\n' "$motivos" >&2
  return 1
}

# RECUSA E' FALHA (medido 12/09/2026): `|| _recusa` imprimia a causa e a funcao seguia
# para o printf e devolvia 0 — `tarefas mover` recusado pela API saia "item null → : null"
# com exit 0. Falha silenciosa e' pior que exit 1: o log de erro nao a ve.
busca() { # busca MÉTODO /caminho
  local saida
  if [ -n "$QUEM" ]; then
    saida=$(curl -s --fail-with-body -X "$1" "$BASE$2" \
                 -H "x-auth-request-preferred-username: $QUEM") || { _recusa "$saida"; return 1; }
  else
    saida=$(curl -s --fail-with-body -X "$1" "$BASE$2") || { _recusa "$saida"; return 1; }
  fi
  printf '%s' "$saida"
}

envia() { # envia MÉTODO /caminho  (corpo JSON em stdin)
  local saida corpo; corpo=$(cat)
  if [ -n "$QUEM" ]; then
    saida=$(printf '%s' "$corpo" | curl -s --fail-with-body -X "$1" "$BASE$2" \
                 -H 'Content-Type: application/json' \
                 -H "x-auth-request-preferred-username: $QUEM" -d @-) || { _recusa "$saida"; return 1; }
  else
    saida=$(printf '%s' "$corpo" | curl -s --fail-with-body -X "$1" "$BASE$2" \
                 -H 'Content-Type: application/json' -d @-) || { _recusa "$saida"; return 1; }
  fi
  printf '%s' "$saida"
}

# --- corpo: o rastreador guarda HTML, como o Vikunja guardava ---------------

# Os rotulos dos modelos (`tarefas modelo`, todos os niveis e o Plano) saem em negrito e cada
# campo abre o proprio paragrafo; as linhas que seguem o rotulo (listas, passos) ficam no
# paragrafo dele, separadas por <br>. A validacao da API tira as tags e acha o rotulo no
# comeco da linha, entao `<strong>Negocio:</strong>` segue valendo. Linha em branco ainda
# separa paragrafo.
# Card #3410: rotulo que NAO esta na lista cai dentro do paragrafo do rotulo anterior, e foi o
# que se viu no corpo servido do #3408 (Solucao, Pecas, Aberto e Produtos documentais colados em
# Medida e em Fora). A lista leva os rotulos do two-pager e as linhas fixas do comentario tipado.
# Card #3740: a lista ganhou os rotulos de decisao e de insumo (Decidiu, Ficha, Golden...), e URL
# solta http/https vira <a href>. E' a MESMA conversao de platafirma-rastreador@api/logica.py
# (R34): o algoritmo e a regex da URL sao os mesmos, sem aspa simples porque o Python mora
# dentro de aspas simples do shell (\x22 e \x27; a crase, \x60, tambem termina o endereco, e
# o sublinhado e o asterisco finais saem do link, como a pontuacao).
# Card #4058: a lista de rótulos não mora aqui; vem do molde da API (`GET /modelo`), a fonte
# única. Sem a lista, a conversão não roda: gravar corpo com rótulo errado é pior que recusar.
para_html() {
  local rotulos
  rotulos=$(busca GET /modelo | jq -c '.rotulos_da_conversao') \
    || { echo "sem a lista de rótulos do molde (GET /modelo no rastreador)" >&2; return 1; }
  ROTULOS="$rotulos" python3 -c 'import html,json,os,re,sys
R = json.loads(os.environ["ROTULOS"])
R.sort(key=len, reverse=True)
L = re.compile("^(" + "|".join(map(re.escape, R)) + "):", re.I)
U = re.compile(r"https?://(?:(?!&(?:lt|gt|quot|#x27);)[^\s<>\x22\x27\x60])+", re.I)
E = re.compile(r"&#?\w+;$")
def liga(m):
    u, r = m.group(0), ""
    while u and (u[-1] in ".,:!?_*" or (u[-1] == ";" and not E.search(u)) or (u[-1] == ")" and u.count(")") > u.count("("))):
        u, r = u[:-1], u[-1] + r
    if u.endswith("//"):
        return m.group(0)
    return "<a href=\"%s\">%s</a>%s" % (u, u, r)
ps, p = [], []
for l in html.escape(sys.stdin.read().strip()).split("\n"):
    if not l.strip():
        if p:
            ps.append(p)
            p = []
        continue
    l = U.sub(liga, l)
    m = L.match(l)
    if m:
        if p:
            ps.append(p)
        p = ["<strong>%s:</strong>%s" % (m.group(1), l[m.end():])]
    else:
        p.append(l)
if p:
    ps.append(p)
print("".join("<p>%s</p>" % "<br>".join(x) for x in ps))'
}

para_texto() {
  sed -e 's#</p>#\n#g' -e 's#<br */\?>#\n#g' -e 's#</h[0-9]>#\n#g' \
      -e 's#<li>#  - #g' -e 's#</li>#\n#g' -e 's#</pre>#\n#g' \
      -e 's#<[^>]*>##g' \
      -e 's#&lt;#<#g' -e 's#&gt;#>#g' -e 's#&quot;#"#g' -e "s@&#39;@'@g" -e 's#&amp;#\&#g' | cat -s
}

# Argumento numérico solto na posição do antigo <projeto>: ignora e avisa. Existe para que
# `tarefas listar 46` e `tarefas criar 46 "título"` — que estão escritos em manifesto, em
# card e na cabeça de toda cadeira — não quebrem no dia da virada.
descarta_projeto() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) echo "aviso: '$1' era projeto do Vikunja e não existe mais; ignorado." >&2; return 0 ;;
  esac
}

# --- filtros ----------------------------------------------------------------

# A API filtra por cadeira, estado e nível. "Aberto" NÃO é filtro dela: é a fase do estado,
# que vem em cada item (`estado_fase`). Peneirar aqui e não lá é o certo — inventar um
# filtro `aberto=` no servidor duplicaria a régua de fase em dois lugares.
monta_query() { # monta_query "$@" -> ecoa a query string e devolve o resto em RESTO[]
  local q="" a
  RESTO=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --cadeira)
        # A LISTA DE CADEIRAS NÃO MORA AQUI (#2856 linha 125): a API a conhece e recusa o nome
        # desconhecido com a própria mensagem. Uma cópia no verbo ficava para trás a cada
        # cadeira nova (engenharia, direito e inteligência foram recusadas por isso).
        local cad="${2:?--cadeira pede o nome da cadeira}"
        q="$q&cadeira=$cad"; shift 2 ;;
      --estado)
        # A LISTA DE ESTADOS NÃO MORA AQUI (card #3526, R10 da spec tarefas): estado novo entra no
        # registro por INSERT (`despriorizada` entrou pela 016), e uma cópia no verbo recusaria o
        # estado que a API já serve. A API recusa o desconhecido com a própria mensagem, que
        # traz a lista dos válidos.
        local est="${2:?--estado pede o nome do estado}"
        q="$q&estado=$est"; shift 2 ;;
      # ORIGINAÇÃO É O `tipo_demanda` DO ITEM (card #3521): o verbo usa a palavra da spec e a API,
      # a coluna. O valor fora do registro sai 422 por lá, com os válidos; a lista não está aqui.
      --originacao)
        local orig="${2:?--originacao pede negocio, tecnico ou incidente}"
        q="$q&tipo_demanda=$orig"; shift 2 ;;
      --executor)
        local exe="${2:?--executor pede o nome da cadeira}"
        q="$q&executor=$exe"; shift 2 ;;
      --paradas) RESTO+=("--paradas"); shift ;;
      --nivel)
        local n
        case "$2" in
          épico|epico|0) n=0 ;;
          feature|1)     n=1 ;;
          story|2)       n=2 ;;
          task|3)        n=3 ;;
          *) echo "nível desconhecido: $2 (épico, feature, story, task)" >&2; exit 2 ;;
        esac
        q="$q&nivel=$n"; shift 2 ;;
      --json)    RESTO+=("--json"); shift ;;
      *)         RESTO+=("$1"); shift ;;
    esac
  done
  printf '%s' "${q:+${q:1}}"
}

_tem_json() { local a; for a in "$@"; do [ "$a" = "--json" ] && return 0; done; return 1; }
_tem_flag() { local f="$1" a; shift; for a in "$@"; do [ "$a" = "$f" ] && return 0; done; return 1; }

linhas() { # id, marca de terminal, título
  jq -r '
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue", "recusada", "cancelada", "englobada", "encerrada", "resolvido"]
     | unique) as $term
    | .itens[]
    | . as $it
    | "\($it.id)\t\(if ($it.estado_derivado != null and ($term | index([$it.estado_derivado]) != null)) or ($it.estado_derivado == null and $it.estado_fase == "terminal") then "x" else " " end)\t\($it.titulo)"'
}

# QUADRO (R35 da spec tarefas, card #3619): `--quadro` bypassa `/itens` e vai direto à
# projeção pronta do rastreador (`GET /quadro/{tipo}`) — o verbo não guarda lista de estados
# de quadro nenhuma (Travas do card); quem confere o `tipo` é a API, e a recusa dela chega
# como vier. Sem --paradas, pede `?dormentes=excluir` e, se algo saiu, diz quantas.
listar_quadro() {
  local tipo="" paradas=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --quadro)  tipo="${2:?--quadro pede discovery ou delivery}"; shift 2 ;;
      --paradas) paradas=1; shift ;;
      --json)    json=1; shift ;;
      *) echo "tarefas listar --quadro: opção desconhecida: $1 (só --paradas e --json)" >&2; exit 2 ;;
    esac
  done
  local q=""
  [ "$paradas" -eq 1 ] || q="?dormentes=excluir"
  local corpo; corpo=$(busca GET "/quadro/$tipo$q") || return 1
  if [ "$json" -eq 1 ]; then
    printf '%s\n' "$corpo"
    return 0
  fi
  printf '%s' "$corpo" | jq -r '.itens[] | "#\(.id)\t\(.estado_mostrado)\t\(.cadeira // "—")\t\(.executor // "—")\t\(.titulo)"'
  local escondidas; escondidas=$(printf '%s' "$corpo" | jq -r '.dormentes_excluidos // 0')
  [ "$escondidas" != 0 ] && printf '%s dormente(s) escondida(s)\n' "$escondidas"
  return 0
}

listar() { # listar [filtros] [--paradas] [--json] [--quadro discovery|delivery]   — só os abertos
  _tem_flag --quadro "$@" && { listar_quadro "$@"; return; }
  local q; q=$(monta_query "$@")
  # AS PARADAS FICAM DE FORA (card #3526, R25): `despriorizada` é aberta (fase funil), mas é o que
  # ninguém está fazendo, e na fila de trabalho ela atrapalha. Entra com `--paradas`, ou quando o
  # estado é pedido pelo nome. A ordem da listagem é a do posto, que a API entrega pronta.
  local ocultar=true
  _tem_flag --paradas "$@" && ocultar=false
  case "&$q&" in *"&estado=despriorizada&"*) ocultar=false ;; esac
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  corpo=$(printf '%s' "$corpo" | jq --argjson ocultar "$ocultar" '
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue", "recusada", "cancelada", "englobada", "encerrada", "resolvido"]
     | unique) as $term
    | {
        itens: [
          .itens[]
          | . as $it
          | select(
              if $it.estado_derivado != null
              then ($term | index([$it.estado_derivado]) == null)
              else ($it.estado_fase != "terminal")
              end
            )
          | select(($ocultar | not) or ($it.estado != "despriorizada"))
        ],
        estados,
        total
      }
    | .total = (.itens | length)')
  if _tem_json "$@"; then printf '%s\n' "$corpo"; else printf '%s' "$corpo" | linhas; fi
}

listar_tudo() { # listar_tudo [filtros] [--json]
  local q; q=$(monta_query "$@")
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  if _tem_json "$@"; then printf '%s\n' "$corpo"; else printf '%s' "$corpo" | linhas; fi
}

estados() {
  busca GET /registro | jq -r '(.estados // .)[] | select(.retirado != true) | "\(.estado)\t\(.fase)\t\(.nome)"'
}

# Estados de fase ou natureza terminal lidos do registro (card #3750).
_estados_terminais() {
  busca GET /registro | jq -c '((if type == "array" then . else (.estados // []) end) | [.[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado] | unique)' 2>/dev/null || echo '[]'
}

# --- item -------------------------------------------------------------------

# `#N` e `N` são o MESMO número: o rastreador tem um identificador só por item, e é essa a
# razão de o Vikunja ter saído. O `#` é aceito porque a fila e os cards o escrevem.
so_id() { printf '%s' "${1#\#}"; }

# CARD #347: a leitura mostra quem falta assinar, e SEM chamada extra — o detalhe do item
# já devolve `sign_offs` desde o #466. Enquanto não estava aqui, a informação existia na API
# e não existia para quem lê pelo terminal, que é a superfície que a cadeira tem.
#
# PENDENTE PRIMEIRO, e a ordem é o ponto: é ele que segura o item em `Em parecer`, e é a
# única linha sobre a qual alguém pode agir agora. Respondido é registro; pendente é dívida.
ler() {
  local id; id=$(so_id "$1")
  # UMA LEITURA SERVE A TUDO (card #3526): o detalhe do item já traz o vínculo (`bloqueia`,
  # `bloqueado_por`, #3523) e, quando o item tem filha, `filhas` em ordem de dependência. Antes as
  # filhas vinham de uma segunda chamada que puxava o board inteiro e peneirava por pai.
  local j; j=$(busca GET "/itens/$id") || return 1
  local term; term=$(_estados_terminais) || term='[]'
  printf '%s' "$j" | jq -r --argjson term "$term" '
    "# \(.titulo)",
    "#\(.id) · \(.nivel_nome) · "
    + (if .estado_derivado != null
       then "\(.estado_derivado) [derivado; cru: \(.estado_nome) (\(.estado_fase))]"
       else "\(.estado_nome) (\(.estado_fase))"
       end)
    + " · cadeira: \(.cadeira // "—")"
    + (if .tipo_demanda then " · originação: \(.tipo_demanda)" else "" end)
    + (if .executor then " · executor: \(.executor)" else "" end)
    + (if (.ancestrais|length) > 0 then "\n  em: " + ([.ancestrais[] | "#\(.id) \(.titulo)"] | join(" > ")) else "" end)
    + (if ((.bloqueia // []) | length) > 0
       then "\n  bloqueia: " + ([.bloqueia[] | "#\(.id) (\(.estado))"] | join(", ")) else "" end)
    + (if ((.bloqueado_por // []) | length) > 0
       then "\n  bloqueado por: " + ([.bloqueado_por[] | "#\(.id) (\(.estado))"] | join(", ")) else "" end)
    + (([(.bloqueado_por // [])[] | select(.estado as $e | ($term | index([$e])) == null)] | if length > 0
       then "\n  travada por: " + ([.[] | "#\(.id) (\(.estado))"] | join(", ")) else "" end)),
    "",
    (if ((.sign_offs // []) | length) > 0 then
       (["sign-off:"]
        + [.sign_offs[] | select(.decisao == null) | "  PENDENTE  \(.aprovador)"]
        + [.sign_offs[] | select(.decisao != null)
           | "  \(.decisao | ascii_upcase)  \(.aprovador)"
             + (if .texto then " — \(.texto)" else "" end)]
        + [""])
       | join("\n")
     else empty end),
    (.descricao // "")' | para_texto
  # FILHAS — card lido sem ver o que pende embaixo não serve para repriorizar:
  # ler um épico/feature e não enxergar a subárvore era o furo. Puxa os filhos
  # diretos, um por linha (id · estado · cadeira · título), na ordem de dependência que a API
  # já entrega em `.filhas` (card #3523), com a travada marcada. SÓ ABERTAS: terminal
  # (entregue, englobada, etc.) fica fora — a mesma régua de fase que `listar` aplica, pela
  # mesma razão. Filha entregue é auditoria, e auditoria é `listar-tudo`, não leitura de card.
  local filhas; filhas=$(filhas_do_json "$j")
  [ -n "$filhas" ] && printf '\nfilhas (abertas):\n%s\n' "$filhas"
  # Sem filha aberta o `[ -n ]` acima devolve 1 e, sendo o ultimo comando da funcao sob
  # `set -e`, o verbo saia com exit 1 DEPOIS de imprimir o card inteiro. Medido em
  # 11/09/2026: 24 dos 33 "erros" de tarefas no ops log eram isto (metrica casos).
  return 0
}

# Filhas DIRETAS ainda abertas, uma por linha (id · estado · cadeira · título), lidas do campo
# `filhas` do detalhe do pai (JSON em $1): a API as entrega em ordem de dependência, com o posto
# desempatando, e `travada` quando algum bloqueador ainda não fechou (card #3523). Compartilhada
# por `ler` e por `mover`: é a MESMA peneira nas duas, para que a linha `PARCIAL:` do relato
# (arq:0095) e a leitura do card nunca discordem sobre o que pende. O que é terminal sai do
# registro (um GET pequeno), e não do board inteiro, que é o que esta função puxava antes.
filhas_do_json() {
  local termos; termos=$(busca GET /registro | jq -c '[.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]') || return 1
  printf '%s' "$1" | jq -r --argjson term "$termos" '
    ($term + ["entregue","recusada","cancelada","englobada","encerrada","resolvido"] | unique) as $t
    | .filhas[]?
    | . as $f
    | select($t | index([$f.estado_derivado // $f.estado]) == null)
    | "  #\($f.id)\t\($f.estado)\t\($f.cadeira // "—")\t\($f.titulo)"
      + (if $f.travada
         then "  [travada por " + ([($f.bloqueada_por // [])[] | "#\(if type == "object" then .id else . end)"] | join(", ")) + "]"
         else "" end)'
}

# ENTREGA É DERIVADA DO PAI (arq:0095, dono 02/09/2026). Item executável movido devolve, no
# MESMO retorno, o estado derivado do pai e as irmãs abertas — é a âncora que a linha
# `PARCIAL:`/`ENTREGA:` do relato cola. Sem isto a forma exigiria segunda chamada, e regra
# que depende de segunda chamada morre como o bullet morreu (3 reincidências pós-b888bcb).
# Medido em 02/09/2026: 12 pais com filhas mistas no board, 10 com derivado `captada` —
# a story fechava, o relato dizia "entregue", e a frente restante nem lapidada estava.
pai_e_irmas() { # pai_e_irmas <id-do-pai>
  local pai; pai=$(so_id "$1")
  local jp; jp=$(busca GET "/itens/$pai") || return 0
  printf '%s' "$jp" | jq -r '
    "  pai #\(.id) [\(.nivel_nome)]: "
    + (if .estado_derivado != null then "\(.estado_derivado) [derivado]" else .estado_nome end)
    + " — \(.titulo)"'
  local abertas; abertas=$(filhas_do_json "$jp")
  if [ -n "$abertas" ]; then
    printf '  abertas no pai (entrega de negócio NÃO fechou):\n%s\n' "$abertas"
  else
    printf '  nenhuma filha aberta no pai — conferência da gestão estratégica ou da cadeira dona, depois o dono dá entregue\n'
  fi
}

# SIGN-OFF PELO VERBO — card #347. A rota existia desde o #466 e não tinha verbo, e a
# consequência é a que o card nomeia: `org:0019` manda claudinho-dados ASSINAR emenda de
# modelo, e assinar dependia de alguém lembrar de montar o JSON na mão. Regra que depende de
# lembrança é regra morta — é o mesmo defeito que o dono apontou no #348 sobre `tarefas
# mover`.
#
# PENDENTE É O CASO COMUM, e por isso `--decisao` é opcional: quem escreve o card INSCREVE
# os aprovadores antes de qualquer um deles responder ("o item permanece enquanto houver
# aprovador pendente", F9 §4.3). Verbo que exigisse decisão só saberia registrar o fim, e o
# começo — que é o que trava o item — continuaria no JSON na mão.
#
# `--motivo` E NÃO `--texto`, e a divergência do nome de campo da API é deliberada: `motivo`
# é a palavra que `mover`, `fechar` e `apagar` já usam neste verbo para "por que você fez
# isso". Duas palavras para a mesma coisa em quatro subcomandos vizinhos é o tipo de atrito
# que se paga em toda chamada.
assinar() {
  local id; id=$(so_id "$1"); shift
  local aprovador="" decisao="" motivo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --aprovador) aprovador="$2"; shift 2 ;;
      --decisao)   decisao="$2";   shift 2 ;;
      --motivo|--texto) motivo="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$aprovador" ] || { echo "uso: tarefas assinar <id> --aprovador <cadeira> [--decisao aprovado|recusado] [--motivo \"<txt>\"]" >&2; exit 2; }
  # A regra de "recusado exige motivo" (F9 §4.3, e CHECK no schema) mora na API e no banco.
  # Aqui NÃO se duplica: uma cópia local divergiria no dia em que a regra mudasse, e a
  # recusa da API já chega legível por `--fail-with-body`.
  jq -n --arg a "$aprovador" --arg d "$decisao" --arg t "$motivo" \
     '{aprovador:$a}
      + (if $d == "" then {} else {decisao:$d} end)
      + (if $t == "" then {} else {texto:$t} end)' \
    | envia POST "/itens/$id/sign-offs" \
    | jq -r '"sign-off de \(.aprovador) em #\(.item // '"$id"'): \(.decisao // "PENDENTE")"
             + (if .texto then " — \(.texto)" else "" end)'
}

criar() {
  descarta_projeto "${1:-}" && shift
  local titulo="${1:?uso: tarefas criar \"<título>\" [opções]}"; shift || true
  # DEFAULT É STORY (arq:0096, dono 02/09/2026): task é débito técnico e nasce só por
  # `tarefas dt admitir`. Medido antes da virada: 390 tasks, 156 órfãs, 13 stories com
  # filha task — o default `task` fazia da task uma "story sem nome".
  local desc="" nivel="story" cadeira="$QUEM" pai="" classe="planejado" via_dt="${TAREFAS_VIA_DT:-}"
  local originacao="" executor="" registro="" estado_opt=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --desc)       desc="$2"; shift 2 ;;
      --desc-stdin) desc="$(cat)"; shift ;;
      --nivel)      nivel="$2"; shift 2 ;;
      --cadeira)    cadeira="$2"; shift 2 ;;
      # Originação e executor (card #3526, R19): sem eles a API herda — a originação do pai, ou
      # negocio; o executor igual à cadeira. Valor fora do registro a API recusa (422).
      --originacao) originacao="${2:?--originacao pede negocio, tecnico ou incidente}"; shift 2 ;;
      --executor)   executor="${2:?--executor pede o nome da cadeira}"; shift 2 ;;
      --pai)        pai=$(so_id "$2"); shift 2 ;;
      --incidente)  classe="incidente"; shift ;;
      # CARD #3597 (R16, R31 da spec tarefas): story sem pai que vai a `priorizada` ou adiante
      # exige o comentário `registro-de-negocio` já gravado — a API grava item, transição e o
      # comentário na mesma transação quando `registro` chega no corpo (#2647 do #3417).
      --registro)   registro="$2"; shift 2 ;;
      # Vence o default da classe e `PF_ESTADO_INICIAL` (#259): nascer direto em `priorizada`
      # com `--registro` não depende de variável de ambiente para isso.
      --estado)     estado_opt="$2"; shift 2 ;;
      --prio)       echo "aviso: --prio não existe neste modelo; ignorado." >&2; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  # A API quer o nível como INTEIRO — a camada é ordem, e é ela que a restrição de pai
  # compara. O nome é o que a pessoa escreve; a tradução é aqui, num lugar só.
  local n
  case "$nivel" in
    épico|epico|0)   n=0 ;;
    feature|1)       n=1 ;;
    story|2)         n=2 ;;
    task|3)          n=3
                     if [ -z "$via_dt" ]; then
                       echo "recusado: task é débito técnico e nasce por \`tarefas dt admitir \"<problema>\" --solucao \"<txt>\" --medido-em <data> --evidencia <...>\`. Trabalho de execução é story (arq:0096)." >&2
                       exit 2
                     fi ;;
    *) echo "nível desconhecido: $nivel (épico, feature, story, task)" >&2; exit 2 ;;
  esac
  local html=""
  [ -n "$desc" ] && html="$(printf '%s' "$desc" | para_html)"
  local d_json="null"
  [ -n "$html" ] && d_json="$(printf '%s' "$html" | jq -Rs .)"
  # `estado` é obrigatório no POST: item nasce declarando onde entra no funil, e não há
  # default do servidor. `captada` é a boca do funil para planejado; incidente entra em
  # `aberto` se o registro o tiver, e a recusa da API nomeia o estado válido quando não.
  # incidente entra no funil de incidente (`detectado`), planejado na boca do funil
  # comum (`captada`). PF_ESTADO_INICIAL, se dado, vence o default da classe (#259).
  local est_default="captada"; [ "$classe" = "incidente" ] && est_default="detectado"
  local est="${estado_opt:-${PF_ESTADO_INICIAL:-$est_default}}"
  jq -n --arg t "$titulo" --argjson d "$d_json" --argjson n "$n" --arg c "$cadeira" \
        --arg p "$pai" --arg cl "$classe" --arg e "$est" \
        --arg o "$originacao" --arg x "$executor" --arg r "$registro" \
     '{titulo:$t, classe:$cl, estado:$e}
      + (if $cl == "incidente" then {} else {nivel:$n} end)
      + (if $d == null or $d == "" then {} else {descricao:$d} end)
      + (if $c == "" then {} else {cadeira:$c} end)
      + (if $p == "" then {} else {pai:($p|tonumber)} end)
      + (if $o == "" then {} else {tipo_demanda:$o} end)
      + (if $x == "" then {} else {executor:$x} end)
      + (if $r == "" then {} else {registro:$r} end)' \
    | envia POST /itens \
    | jq -r '"item \(.id) criado: \(.titulo)"'
}

# EDITAR É O PATCH DO CORPO COM NOME DE ATO — card #3134 (dono, 25/09/2026): toda chamada
# de API se encapsula em verbo. A rota sempre aceitou `titulo`/`descricao` no PATCH, mas a
# única porta até ela era a escotilha `api-corpo`, e cadeira não achava nem essa.
#
# NUNCA manda `estado`: editar não move. Mover é `mover`, que carrega motivo e cascata; um
# PATCH que trocasse corpo e estado juntos regrediria a coluna sem ninguém pedir. A régua do
# corpo por nível (arq:0096) é da API, como em `criar` — este verbo não a duplica.
editar() {
  local id; id=$(so_id "${1:?uso: tarefas editar <id> [--titulo \"<t>\"] [--desc \"<txt>\"|--desc-stdin]}"); shift
  local titulo="" desc="" tem_desc="" cadeira="" tem_cadeira=0 nivel="" originacao="" executor=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --titulo)     titulo="${2:?--titulo pede texto}"; shift 2 ;;
      # Originação e executor (card #3526, R19; colunas do #3521). A API confere a originação contra
      # o registro (422) e não tem lista para o executor: este verbo não repete nenhuma das duas.
      --originacao) originacao="${2:?--originacao pede negocio, tecnico ou incidente}"; shift 2 ;;
      --executor)   executor="${2:?--executor pede o nome da cadeira}"; shift 2 ;;
      --desc)       desc="${2:?--desc pede texto}"; tem_desc=1; shift 2 ;;
      --desc-stdin) desc="$(cat)"; tem_desc=1; shift ;;
      # A cadeira e o nível do card mudam por aqui (#2856 linhas 112 e 113): a API aceita os dois no
      # PATCH, e é ela quem recusa nome ou camada inválidos — este verbo não repete a lista.
      --cadeira)    cadeira="${2:?--cadeira pede o nome da cadeira}"; tem_cadeira=1; shift 2 ;;
      --sem-cadeira) cadeira=""; tem_cadeira=1; shift ;;
      --nivel)
        case "${2:?--nivel pede épico, feature, story ou task}" in
          épico|epico|0) nivel=0 ;;
          feature|1)     nivel=1 ;;
          story|2)       nivel=2 ;;
          task|3)        nivel=3 ;;
          *) echo "nível desconhecido: $2 (épico, feature, story, task)" >&2; exit 2 ;;
        esac
        shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  if [ -z "$titulo" ] && [ -z "$tem_desc" ] && [ "$tem_cadeira" -eq 0 ] && [ -z "$nivel" ] \
     && [ -z "$originacao" ] && [ -z "$executor" ]; then
    echo "uso: tarefas editar <id> [--titulo \"<t>\"] [--desc \"<txt>\"|--desc-stdin] [--cadeira <c>|--sem-cadeira] [--nivel épico|feature|story|task] [--originacao negocio|tecnico|incidente] [--executor <c>] — nada a editar" >&2
    exit 2
  fi
  if [ -n "$tem_desc" ] && [ -z "$(printf '%s' "$desc" | tr -d '[:space:]')" ]; then
    echo "recusado: corpo vazio apagaria a descrição do item. Para ver o esqueleto: tarefas modelo <nível>" >&2
    exit 2
  fi
  local html=""
  [ -n "$tem_desc" ] && html="$(printf '%s' "$desc" | para_html)"
  local d_json="null"
  [ -n "$tem_desc" ] && d_json="$(printf '%s' "$html" | jq -Rs .)"
  # `cadeira: null` tira a cadeira (a API trata o nulo explícito como pedido); ausente não mexe.
  jq -n --arg t "$titulo" --argjson d "$d_json" --argjson tc "$tem_cadeira" --arg c "$cadeira" --arg n "$nivel" \
        --arg o "$originacao" --arg x "$executor" \
     '(if $t == "" then {} else {titulo:$t} end)
      + (if $d == null then {} else {descricao:$d} end)
      + (if $tc == 1 then {cadeira: (if $c == "" then null else $c end)} else {} end)
      + (if $n == "" then {} else {nivel: ($n|tonumber)} end)
      + (if $o == "" then {} else {tipo_demanda:$o} end)
      + (if $x == "" then {} else {executor:$x} end)' \
    | envia PATCH "/itens/$id" \
    | jq -r --argjson tc "$tem_cadeira" --arg n "$nivel" --arg o "$originacao" --arg x "$executor" '
        "item \(.id) editado: \(.titulo)"
        + (if $tc == 1 then " · cadeira \(.cadeira // "nenhuma")" else "" end)
        + (if $n != "" then " · nível \(.nivel_nome // .nivel)" else "" end)
        + (if $o != "" then " · originação \(.tipo_demanda // "?")" else "" end)
        + (if $x != "" then " · executor \(.executor // "?")" else "" end)
        + " · estado \(.estado_nome) (inalterado)"'
}

# COMENTÁRIO É TEXTO NO CORPO, por ordem do dono (16/08/2026). O modelo do rastreador não
# tem entidade de comentário, e a migração do acervo já pôs os comentários velhos dentro de
# `descricao` sob marcador. Escrever novo do mesmo jeito mantém uma forma só — e o dia em
# que comentário virar entidade, há um marcador único para varrer.
# CARD #390: comentário é entidade própria (api/app.py `POST /itens/{id}/comentarios`),
# não mais texto colado em `descricao` — o PATCH que anexava ao corpo inflava a leitura
# do item a cada comentário e não dava id/ordem a nada (#382 assinado "anônimo" sem como
# provar, referências como "comentário 350" apontando pra NÚMERO DE LINHA, não objeto).
# `autor` não vem daqui: o servidor lê do MESMO cabeçalho que `mover`/`fechar` já usam
# (`x-auth-request-preferred-username`, via `$QUEM`) — `envia` já o manda quando presente.
comentar() {
  local id="${1:-}"
  [ -z "$id" ] && { echo "uso: tarefas comentar <id> [\"<txt>\"] (ou corpo em stdin)" >&2; exit 2; }
  id=$(so_id "$id") || exit 2
  if [ "${2:-}" = "--fecha" ]; then
    fechar_comentario "$id" "${3:-}" "${4:-}"
    return
  fi
  local txt="${2:-}"
  # Opção no lugar do texto não é corpo (#2856 linhas 49 e 50): `--stdin` manda ler o stdin; outra
  # opção de uma palavra só é recusada, em vez de gravada como comentário.
  if [[ "$txt" =~ ^--[a-zA-Z][a-zA-Z0-9-]*$ ]]; then
    [ "$txt" = "--stdin" ] || { echo "erro: tarefas comentar: opção desconhecida '$txt'; o corpo vai entre aspas ou em stdin." >&2; exit 2; }
    txt=""
  fi
  if [ -z "$txt" ] && [ ! -t 0 ]; then
    txt="$(cat)"
  fi
  local trim
  trim="$(printf '%s' "$txt" | tr -d '[:space:]')"
  if [ -z "$trim" ]; then
    echo "erro: tarefas comentar: corpo do comentário não pode ser vazio." >&2
    echo "uso: tarefas comentar <id> [\"<txt>\"] (ou corpo em stdin)" >&2
    exit 2
  fi
  local html; html=$(printf '%s' "$txt" | para_html)
  local corpo saida status body
  corpo=$(jq -n --arg c "$html" '{corpo:$c}')
  # CARD #3614: a recusa de tipo (épico/feature sem tipo na primeira linha, ou tipo fora
  # da fase aceita) traz `aceitos` — mesmo campo e mesmo estilo que `fechar_comentario`
  # já imprime para o fecho fora do vocabulário; `_recusa`, genérico a todo verbo, não
  # sabe rotular «tipo aceito».
  if [ -n "$QUEM" ]; then
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios" \
                 -H 'Content-Type: application/json' \
                 -H "x-auth-request-preferred-username: $QUEM" -d @- -w '\n%{http_code}')
  else
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios" \
                 -H 'Content-Type: application/json' -d @- -w '\n%{http_code}')
  fi
  status="${saida##*$'\n'}"
  body="${saida%$'\n'*}"
  case "$status" in
    201)
      printf '%s' "$body" | jq -r '"comentário #\(.id) criado no item \(.item)"'
      ;;
    400)
      printf '%s' "$body" | jq -r '
        .erro,
        ((.aceitos // [])[] | "  tipo aceito: \(.codigo) (\(.nome))")
      ' >&2
      exit 4 ;;
    *)
      local msg; msg=$(printf '%s' "$body" | jq -r '.erro // empty' 2>/dev/null || true)
      printf '%s\n' "${msg:-falha ao falar com o rastreador em $BASE (status ${status:-desconhecido})}" >&2
      exit 1 ;;
  esac
}

# O FECHO VAI DIRETO À ROTA PRÓPRIA — card #3593 (R6, R7 da spec comentario-tipado):
# `POST /itens/{id}/comentarios/{cid}/fecho` grava resultado, destino, quem e quando com
# `SELECT … FOR UPDATE`. Até a #3597, este verbo lia a primeira linha do comentário e
# conferia o vocabulário à mão; a regra mora na API desde a F3 (R5 a R7), e o verbo passa a
# só partir o argumento em resultado/destino e traduzir o status HTTP: 400 (sem tipo, ou
# resultado fora do vocabulário) e 403 (quem fecha não pode) saem 4; 409 (já fechado) e 404
# (não existe) saem 1, porque não há nada a repetir.
fechar_comentario() {
  local id="$1" cid="${2:-}" txt="${3:-}"
  local uso='uso: tarefas comentar <card> --fecha <n> "<resultado> — <destino>"'
  case "$cid" in ''|*[!0-9#]*) echo "$uso" >&2; exit 2 ;; esac
  cid=$(so_id "$cid")
  txt="$(printf '%s' "$txt" | sed -e 's/^[[:space:]]*[Ff]echo[[:space:]]*:[[:space:]]*//' \
                             -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$txt" in
    *" — "*) ;;
    *) echo "$uso" >&2
       echo "o fecho é «<resultado> — <destino>»: o destino diz onde a contribuição foi parar (spec comentario-tipado, R6)" >&2
       exit 2 ;;
  esac
  local resultado destino
  resultado="$(printf '%s' "${txt%% — *}" | sed -e 's/[[:space:]]*$//')"
  destino="$(printf '%s' "${txt#* — }" | sed -e 's/^[[:space:]]*//')"
  [ -n "$resultado" ] && [ -n "$destino" ] || { echo "$uso" >&2; exit 2; }
  local corpo saida status body
  corpo=$(jq -n --arg r "$resultado" --arg d "$destino" '{resultado:$r, destino:$d}')
  # CARD #3597: só este ato pede o status HTTP (`-w`) — 400, 403, 409 e 404 são saída
  # esperada com texto próprio, não `_recusa`, e `envia`/`busca` não servem aqui.
  if [ -n "$QUEM" ]; then
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios/$cid/fecho" \
                 -H 'Content-Type: application/json' \
                 -H "x-auth-request-preferred-username: $QUEM" -d @- -w '\n%{http_code}')
  else
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios/$cid/fecho" \
                 -H 'Content-Type: application/json' -d @- -w '\n%{http_code}')
  fi
  status="${saida##*$'\n'}"
  body="${saida%$'\n'*}"
  case "$status" in
    200)
      printf '%s' "$body" | jq -r \
        '"comentário #\(.id) do item \(.item) fechado — fecho: \(.fecho_resultado) — \(.fecho_destino)"'
      ;;
    400|403)
      printf '%s' "$body" | jq -r '
        .erro,
        ((.aceitos // [])[] | "  resultado aceito: \(.codigo) (\(.nome))"),
        (if (.quem_pode // []) != [] then "  quem pode fechar: " + (.quem_pode | join(", ")) else empty end)
      ' >&2
      exit 4 ;;
    409)
      printf '%s' "$body" | jq -r '
        "sem mudança: \(.erro)",
        (if .fecho_atual then "  já fechado: \(.fecho_atual.resultado) — \(.fecho_atual.destino) (\(.fecho_atual.por // "—"), \(.fecho_atual.em))" else empty end)
      ' >&2
      exit 1 ;;
    404)
      printf '%s' "$body" | jq -r '.erro' >&2
      exit 1 ;;
    *)
      local msg; msg=$(printf '%s' "$body" | jq -r '.erro // empty' 2>/dev/null || true)
      printf '%s\n' "${msg:-falha ao falar com o rastreador em $BASE (status ${status:-desconhecido})}" >&2
      exit 1 ;;
  esac
}

# Sem opção, lista tudo, no formato de sempre (o lint de card lê esta saída). A porta corta a saída
# de um verbo em ~50 KB, e card com muita conversa passa disso: o corte engole os comentários do
# fim, justamente os mais novos. Daí as fatias — a API devolve tudo de uma vez, quem recorta é este
# verbo, e cada recorte cabe na porta.
comentarios() {
  local uso='uso: tarefas comentarios <id> [--indice] [--id <n>]... [--desde <n>] [--ultimos <k>]'
  local id; id=$(so_id "${1:?$uso}"); shift
  local ids='[]' desde=0 ultimos=0 indice=false
  local numero='^[0-9]+$'
  while [ $# -gt 0 ]; do
    case "$1" in
      --indice) indice=true; shift ;;
      --id|--desde|--ultimos)
        [[ "${2:-}" =~ $numero ]] || { echo "tarefas comentarios: $1 pede um número" >&2; echo "$uso" >&2; exit 2; }
        case "$1" in
          --id) ids=$(jq -c --argjson n "$2" '. + [$n]' <<<"$ids") ;;
          --desde) desde=$2 ;;
          --ultimos) ultimos=$2 ;;
        esac
        shift 2 ;;
      *) echo "tarefas comentarios: opção desconhecida: $1" >&2; echo "$uso" >&2; exit 2 ;;
    esac
  done
  local saida bytes
  saida=$(busca GET "/itens/$id/comentarios" | jq -r \
    --argjson ids "$ids" --argjson desde "$desde" --argjson ultimos "$ultimos" --argjson indice "$indice" '
    .comentarios as $todos
    | ($todos
       | (if ($ids | length) > 0 then map(select(.id as $i | any($ids[]; . == $i))) else . end)
       | map(select(.id >= $desde))
       | (if $ultimos > 0 then .[-$ultimos:] else . end)) as $sel
    | if ($todos | length) == 0 then "(sem comentários)"
      elif ($sel | length) == 0 then
        "(nenhum comentário na seleção; o item tem \($todos | length), de #\($todos[0].id) a #\($todos[-1].id))"
      elif $indice then
        $sel[] | "#\(.id) · \(.autor // "anônimo") · \(.carimbo) · \(.corpo | length) car. · \(.corpo[0:100] | gsub("\n"; " "))"
      else
        $sel[] | "--- #\(.id) · \(.autor // "anônimo") · \(.carimbo) ---\n\(.corpo)\n"
      end' | para_texto)
  bytes=$(printf '%s' "$saida" | wc -c)
  if [ "$bytes" -gt 45000 ]; then
    echo "aviso: ${bytes} bytes; a porta corta a saída em 50000 e perde o fim. Leia por partes: tarefas comentarios $id --indice, depois --id <n>, --desde <n> ou --ultimos <k>"
  fi
  printf '%s\n' "$saida"
}

# MOVER É O ATO, E O NOME É O ATO — card #224. A capacidade sempre existiu: o PATCH aceita
# qualquer estado do registro, e quem valida é a máquina. O que não existia era um verbo com
# o nome do que se faz, e o efeito observável disso foi medido no quadro de 17/08 — `Em
# execução` com UM item e `Entregue` com 145. Ninguém procura `fechar` para mover um card
# pelo fluxo, então ninguém operava fluxo pelo rastreador.
#
# `--motivo` é primeira classe porque a máquina o EXIGE em parte das transições (volta ao
# funil, §4.1; `recusada`, §6.3) e porque, sem ele aqui, a cadeira descobria a exigência
# levando erro. A lista de destinos válidos vem da API, derivada da própria máquina: este
# verbo não guarda tabela de arestas, e é isso que o mantém correto quando um estado novo
# entra no registro por INSERT.
mover() {
  local id; id=$(so_id "${1:?uso: tarefas mover <id> <estado> [--motivo \"...\"]}")
  local destino="${2:?uso: tarefas mover <id> <estado> [--motivo \"...\"]}"; shift 2
  local motivo="" elo="" decisao="" q=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --motivo)       motivo="${2:?--motivo pede texto}"; shift 2 ;;
      --englobado-em) elo="${2:?--englobado-em pede o id que absorveu}"; shift 2 ;;
      # A APOSTA (R36 da spec tarefas, card #3619): <n> é o id do comentário de decisão do
      # PRÓPRIO pai. O verbo só leva o número — quem confere que é decisão do próprio pai, é
      # do tipo certo e sustenta a aposta é a máquina (R19, D3 da arq:0127); sem ele a recusa
      # diz como informar.
      --decisao)      decisao="${2:?--decisao pede o número do comentário de decisão}"; shift 2 ;;
      # CONFIRMAÇÃO DA CASCATA (ordem do dono, 18/08/2026). O verbo não decide NADA aqui:
      # ele só carrega a declaração até a API, que é quem sabe se há filha aberta e quem
      # NOMEIA quais são na recusa. Repetir a regra do lado do CLI daria duas verdades, e a
      # que o dono veria seria a que perdeu a corrida.
      --cascata)      q="?cascata=1"; shift ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  local resp; resp=$(jq -n --arg e "$destino" --arg m "$motivo" --arg g "$elo" --arg d "$decisao" \
     '{estado:$e}
      + (if $m == "" then {} else {motivo:$m} end)
      + (if $g == "" then {} else {englobado_em:($g|tonumber)} end)
      + (if $d == "" then {} else {decisao:($d|tonumber)} end)' \
    | envia PATCH "/itens/$id$q") || return 1
  printf '%s' "$resp" | jq -r '"item \(.id) → "
             + (if .estado_derivado != null
                then "\(.estado_derivado) [derivado; cru: \(.estado_nome)]"
                else .estado_nome
                end)
             + ": \(.titulo)"
             + (if ((.propagacao.movidas // []) | length) > 0
                then "\n  filhas movidas junto: " + ([.propagacao.movidas[] | "#\(.id)"] | join(", "))
                else "" end)'
  # Se o item estiver travado por bloqueador aberto e entrou em em-execucao (card #3750):
  if [ "$destino" = "em-execucao" ]; then
    local bpor
    bpor=$(printf '%s' "$resp" | jq -c '.bloqueado_por // empty' 2>/dev/null)
    if [ -z "$bpor" ]; then
      local ji
      ji=$(busca GET "/itens/$id" 2>/dev/null) || ji=""
      [ -n "$ji" ] && bpor=$(printf '%s' "$ji" | jq -c '.bloqueado_por // empty' 2>/dev/null)
    fi
    if [ -n "$bpor" ] && [ "$bpor" != "[]" ]; then
      local term; term=$(_estados_terminais) || term='[]'
      local travada
      travada=$(printf '%s' "$bpor" | jq -r --argjson term "$term" '
        [.[] | select(.estado as $e | ($term | index([$e])) == null)]
        | if length > 0
          then "  travada por: " + ([.[] | "#\(.id) (\(.estado))"] | join(", "))
          else empty
          end')
      [ -n "$travada" ] && printf '%s\n' "$travada"
    fi
  fi
  # Tem pai → o relato precisa do pai (arq:0095). Sai sempre, em qualquer destino: a story
  # que entra em `em-execucao` também tem de saber quantas irmãs faltam.
  local pai; pai=$(printf '%s' "$resp" | jq -r '.pai // empty')
  [ -n "$pai" ] && pai_e_irmas "$pai"
  # AVISO À DONA (ordem do dono, 27/09/2026): fechou a última filha e o pai parou em
  # `em-homologacao` — a conferência da feature/épico é da gestão estratégica ou da cadeira
  # dona dele, e depois do dono. Quem executou a story nem sempre é a dona; sem o aviso, o dono pedia à mão.
  if [ -n "$pai" ] && [ "$(printf '%s' "$resp" | jq -r '.estado_natureza // ""')" = "terminal" ]; then
    avisa_dona "$pai" "$id"
  fi
  return 0
}

# avisa_dona <pai> <filha> -- pai em `em-homologacao` derivado: manda à cadeira dona do pai
# um pedido de conferência pela fila. Não derruba o `mover`: o card já andou; falha do aviso
# se declara na saída.
avisa_dona() {
  local pai; pai=$(so_id "$1"); local filha="$2" j
  j=$(busca GET "/itens/$pai") || return 0
  [ "$(printf '%s' "$j" | jq -r '.estado_derivado // ""')" = "em-homologacao" ] || return 0
  local dona; dona=$(printf '%s' "$j" | jq -r '.cadeira // ""')
  dona="${dona#claudinho-}"; dona="${dona#claudinha-}"; dona=$(printf '%s' "$dona" | tr 'A-Z' 'a-z')
  local eu="${QUEM#claudinho-}"; eu="${eu#claudinha-}"
  local nivel titulo; nivel=$(printf '%s' "$j" | jq -r '.nivel_nome'); titulo=$(printf '%s' "$j" | jq -r '.titulo')
  # QUEM CONFERE (dono, 27/09/2026): a conferência do pai com o dono é da gestão
  # estratégica, gestora do portfólio; a cadeira dona do card também pode, e nenhuma outra.
  # O aviso vai às duas; quem chamou o `mover` lê a linha aqui mesmo, sem carta.
  local destinos="gestao-estrategica"
  [ -n "$dona" ] && [ "$dona" != "gestao-estrategica" ] && destinos="$destinos $dona"
  local fila_bin="${PF_FILA_BIN:-$(dirname "$(readlink -f "$0")")/fila}"
  local d out
  for d in $destinos; do
    if [ "$d" = "$eu" ]; then
      printf '  pai #%s em em-homologacao: a conferência é sua — rode o `Sai quando:` e leve a linha ENTREGA: ao dono\n' "$pai"
      continue
    fi
    if [ ! -x "$fila_bin" ]; then
      printf '  aviso de conferência (%s) NÃO enviado: verbo fila ausente em %s\n' "$d" "$fila_bin"
      continue
    fi
    if out=$(printf 'A última filha aberta de #%s (%s: %s) fechou com #%s. %s está em em-homologacao e espera a conferência (gestão estratégica, ou a cadeira dona do card): rode o `Sai quando:` (feature) ou confira a `Medida:` (épico), comente o retorno no card e leve a linha ENTREGA: ao dono. Se faltar coisa, abra a story que falta — o pai volta a em-execucao sozinho.\n' \
          "$pai" "$nivel" "$titulo" "$filha" "$([ "$nivel" = feature ] && echo "A feature" || echo "O $nivel")" \
        | "$fila_bin" enviar "$d" --tipo pedido --assunto "#$pai em homologação: conferência antes do dono" --ref "#$pai" 2>&1); then
      printf '  aviso de conferência enviado: %s (%s)\n' "$d" "$(printf '%s' "$out" | head -1)"
    else
      printf '  aviso de conferência (%s) NÃO enviado: %s\n' "$d" "$(printf '%s' "$out" | head -1)"
    fi
  done
  return 0
}

# `fechar` CONTINUA EXISTINDO PARA FECHAR, e deixa de ser a porta de mover. Não morre: 145
# itens do acervo e os scripts da fita chamam por ele, e matar um verbo em uso para corrigir
# um nome é trocar um defeito de descoberta por uma quebra. `--como` com estado NÃO terminal
# passa a avisar e a delegar — o aviso vai a stderr, então nada que consome a saída quebra.
apagar() {
  # Ordem do dono, 17/08/2026: apagar card é caso de uso comum, não escotilha. A única
  # guarda é o miolo do fluxo, e quem a aplica é a API — este verbo não repete regra.
  local id; id=$(so_id "$1"); shift || true
  local q=""
  [ "${1:-}" = "--cascata" ] && q="?cascata=1"
  busca DELETE "/itens/$id$q" \
    | jq -r '"apagado(s): \(.quantos)", (.apagados[]? | "  #\(.id) [\(.estado)] \(.titulo)")'
}

fechar() {
  local id; id=$(so_id "$1"); shift || true
  local como="entregue"
  [ "${1:-}" = "--como" ] && { como="$2"; shift 2; }
  if ! busca GET "/registro" \
       | jq -e --arg e "$como" '.estados[]? | select(.estado==$e and .natureza=="terminal")' \
       >/dev/null 2>&1; then
    echo "aviso: \`$como\` não é estado terminal — \`fechar\` fecha; para mover pelo fluxo use \`tarefas mover $id $como\`" >&2
  fi
  mover "$id" "$como" "$@"
}

# O MOLDE DE CARD MORA NA API (card #4058, incidente de 30/10/2026): `platafirma-rastreador@
# api/molde.py` é a fonte única, servida em `GET /modelo/<variante>`. Este verbo só imprime o
# que vem dela: o esqueleto em stdout (é o que se copia para o corpo) e o aviso em stderr.
# Nenhuma cópia do molde mora aqui.
modelo() {
  local variante=""
  case "${1:-}" in
    épico|epico) variante=epico ;;
    feature)     variante=feature ;;
    task)        variante=task ;;
    story)
      case "${2:-}" in
        '')                                    variante=story ;;
        refinada|em-refinamento-tecnico|plano) variante=story-refinada ;;
        derivada)                              variante=story-derivada ;;
        *) echo "uso: tarefas modelo story [refinada|derivada]   (o Plano é exigido na entrada de em-execucao)" >&2; exit 2 ;;
      esac ;;
    comentario|comentário)
      case "${2:-}" in
        insumo|pergunta|buraco|requisito) variante="comentario-$2" ;;
        decisão|decisao)                  variante=comentario-decisao ;;
        *) echo "uso: tarefas modelo comentario <insumo|pergunta|buraco|requisito|decisão>" >&2; exit 2 ;;
      esac ;;
    *) echo "uso: tarefas modelo <épico|feature|story|task> | story refinada | story derivada | comentario <tipo>" >&2; exit 2 ;;
  esac
  local j; j=$(busca GET "/modelo/$variante") || return 1
  printf '%s' "$j" | jq -j '.texto'
  local aviso; aviso=$(printf '%s' "$j" | jq -r '.aviso // empty')
  [ -n "$aviso" ] && printf '%s\n' "$aviso" >&2
  return 0
}

# Filho declara o pai, e o pai tem de ser de nível estritamente MENOR — a restrição é do
# banco (`pai_nivel`, escrito por subconsulta), não deste verbo. Recusa vem nomeada da API.
subtarefa() {
  local pai; pai=$(so_id "${1:?uso: tarefas sub <pai> [<filho>]}")
  if [ -z "${2:-}" ]; then
    local j; j=$(busca GET "/itens/$pai") || return 1
    printf '%s' "$j" | jq -r '
      .filhas[]? | "#\(.id)\t\(.estado)\t\(.cadeira // "—")\t\(.titulo)"'
    return 0
  fi
  local filho; filho=$(so_id "$2")
  jq -n --argjson p "$pai" '{pai:$p}' | envia PATCH "/itens/$filho" >/dev/null
  echo "item $filho agora é filho de $pai"
}

apagar_comentario() {
  local id cid
  id=$(so_id "${1:?uso: tarefas apagar-comentario <id> <cid>}")
  cid=$(so_id "${2:?uso: tarefas apagar-comentario <id> <cid>}")
  busca DELETE "/itens/$id/comentarios/$cid" | jq -r '"comentário #\(.apagado) apagado do item \(.item)"'
}

# --- débito técnico ---------------------------------------------------------

# BALDE DE DÉBITO TÉCNICO — padrao rito-debito-tecnico, assinado pelo dono em 26/08/2026
# (card #179). DT é defeito ou dívida MEDIDA que não bloqueia ninguém hoje.
#
# O BALDE É DADO DO RASTREADOR, E NÃO TEXTO DE CARD (R26 da spec tarefas; cards #3551 e #3552).
# Cada débito é uma linha da tabela `balde`, com o número que já tinha no corpo do #2856 (ordem
# do dono, 27/09/2026, card #3175: um balde só, uma linha por débito, sem card por conserto). O
# verbo é cliente fino: a forma de cada campo, o jeito de saída e a segunda saída quem confere é
# a API (`api/balde.py`). O que fica aqui é o que ela não vê, a stack contra o catálogo do
# acervo (R11), e a tabela que a cadeira lê.
#
# O rito mora neste verbo: `admitir` recusa sem medição (rito §1) e sem os campos que deixam a
# linha pronta para um modelo barato consertar; `matar` tira a linha por um de três jeitos
# (R12), e cada jeito exige a âncora que lhe cabe, porque nenhuma saída é silenciosa. Card
# próprio só nasce pelo jeito `englobada`, e quem o cria é a cadeira que assume, com o verbo
# `criar`.

# O catálogo de stacks é do acervo (`acervo stack ver`, a mesma fonte do deploy), um nome por
# linha. Catálogo que não responde sai 5, «não deu para olhar», e não «stack inventada»: dizer
# que a stack não existe porque a fonte está fora é a falha que a R13 proíbe para o rastreador.
_dt_stacks() {
  local acervo_bin="${PF_ACERVO_BIN:-$(dirname "$(readlink -f "$0")")/acervo}" j
  if [ ! -x "$acervo_bin" ]; then
    echo "catálogo de stacks fora do ar: verbo acervo ausente em $acervo_bin" >&2
    return 5
  fi
  j=$("$acervo_bin" stack ver --json 2>/dev/null) || {
    echo "catálogo de stacks fora do ar: acervo stack ver --json falhou" >&2
    return 5
  }
  j=$(printf '%s' "$j" | jq -r '.[].slug' 2>/dev/null) || j=""
  if [ -z "$j" ]; then
    echo "catálogo de stacks fora do ar: acervo stack ver --json voltou sem stack" >&2
    return 5
  fi
  printf '%s\n' "$j"
}

# A tabela das linhas: número, idade em dias pela data da medição, stack e o texto. A API devolve
# as abertas da mais antiga para a mais nova (R27) e a tabela guarda essa ordem. Raio, esperado e
# onde só se acrescentam quando o texto da linha ainda não os traz: as linhas de antes da F6 têm os
# três no texto, e repeti-los dobrava a linha (#2856 linha 316). `curto` tira
# raio, esperado e onde, que são o que faz a lista inteira passar dos 50 KB que a porta serve
# (#2856 linha 143); a saída leva o jeito e a âncora. Sem linha, não imprime nada.
_dt_tabela() { # _dt_tabela <situacao> <stack|""> <desde> <curto 0|1> <idade-minima>
  local q="situacao=$1" j rows
  [ -n "$2" ] && q="$q&stack=$2"
  j=$(busca GET "/balde?$q") || return 1
  rows=$(printf '%s' "$j" | jq -r --argjson desde "${3:-0}" --argjson curto "$4" --argjson minima "$5" '
    def uma: gsub("[\\t\\r\\n]+"; " ");
    def parte($rotulo; $v): if $v == null or $v == "" then "" else " · " + $rotulo + ": " + ($v | uma) end;
    .linhas[] | select(.numero >= $desde and .idade_dias > $minima)
    | (.texto | uma) as $t
    | "\(.numero)\t\(.idade_dias)d\t\(.stack)\t"
      + (if $curto == 1 then ($t | if length <= 200 then . else .[0:199] + "…" end)
         else $t
              + parte("Raio"; (.raio // [] | map(uma) | map(select(. as $r | ($t | contains($r)) | not)) | join(", ")))
              + parte("Esperado"; (.esperado as $e | if $e == null or $e == "" or ($t | contains($e | uma)) then null else $e end))
              + parte("Onde"; (.onde as $o | if $o == null or $o == "" or ($t | contains($o | uma)) then null else $o end))
              + (if .saida_jeito then " · saiu " + .saida_jeito + ": " + (.saida_ancora | uma) else "" end)
         end)') || return 1
  [ -n "$rows" ] && printf 'n\tidade\tstack\tdébito\n%s\n' "$rows"
  return 0
}

dt_listar() {
  # --desde <n> e --curto (#2856 linha 143): a lista inteira passa dos 50 KB que a porta serve.
  local desde="" curto=0 stack="" situacao=abertas
  while [ $# -gt 0 ]; do
    case "$1" in
      --desde) [ $# -ge 2 ] || { echo "--desde exige o número da linha: tarefas dt listar --desde <n>" >&2; exit 2; }; desde="$2"; shift 2 ;;
      --curto) curto=1; shift ;;
      --stack) [ $# -ge 2 ] || { echo "--stack exige o nome da stack: tarefas dt listar --stack <stack>" >&2; exit 2; }; stack="$2"; shift 2 ;;
      --situacao) [ $# -ge 2 ] || { echo "--situacao exige abertas, saidas ou todas" >&2; exit 2; }; situacao="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1 (uso: tarefas dt listar [--stack <s>] [--desde <n>] [--curto] [--situacao abertas|saidas|todas])" >&2; exit 2 ;;
    esac
  done
  case "$desde" in
    '') ;;
    *[!0-9]*) echo "--desde exige o número da linha: tarefas dt listar --desde <n>" >&2; exit 2 ;;
  esac
  case "$stack" in
    '') ;;
    *[!a-z0-9-]*) echo "--stack é um nome de stack, em minúsculas e sem espaço: $stack" >&2; exit 2 ;;
  esac
  case "$situacao" in
    abertas|saidas|todas) ;;
    *) echo "--situacao é abertas, saidas ou todas: $situacao" >&2; exit 2 ;;
  esac
  local t; t=$(_dt_tabela "$situacao" "$stack" "$desde" "$curto" -1) || return 1
  if [ -z "$t" ]; then
    local rotulo="no balde"
    [ "$situacao" = abertas ] && rotulo="aberta"
    [ "$situacao" = saidas ] && rotulo="que saiu"
    echo "(balde vazio: nenhuma linha $rotulo${stack:+ na stack $stack})"
    return 0
  fi
  printf '%s\n' "$t"
}

# `vencidos` É A PAUTA DA REVISÃO, GERADA (rito §2/§4): linhas acima de 30 dias pela data
# da medição. Sem montagem à mão e sem alerta: o verbo mede quando chamado, a revisão decide.
dt_vencidos() {
  local t; t=$(_dt_tabela abertas "" 0 0 30) || return 1
  if [ -z "$t" ]; then
    echo "pauta vazia: nenhuma linha acima de 30 dias no balde"
    return 0
  fi
  printf 'PAUTA DA REVISÃO: linhas acima de 30 dias (rito §2)\n%s\n' "$t"
}

# `indicadores` É A CONSULTA QUE A TELINHA DO BALDE TAMBÉM LÊ (R28): por stack, os abertos e a
# idade do mais velho; na semana, as entradas e as saídas por jeito. Nada se calcula aqui.
dt_indicadores() {
  local dias=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dias) [ $# -ge 2 ] || { echo "--dias exige o número de dias: tarefas dt indicadores --dias <n>" >&2; exit 2; }; dias="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1 (uso: tarefas dt indicadores [--dias <n>])" >&2; exit 2 ;;
    esac
  done
  case "$dias" in
    '') ;;
    *[!0-9]*) echo "--dias exige o número de dias: tarefas dt indicadores --dias <n>" >&2; exit 2 ;;
  esac
  local j; j=$(busca GET "/balde/indicadores${dias:+?dias=$dias}") || return 1
  printf '%s' "$j" | jq -r '
    "stack\tabertos\tmais velho",
    (.por_stack[] | "\(.stack)\t\(.abertos)\t\(.mais_velho_dias)d (#\(.mais_velho_numero))"),
    "semana (\(.semana.dias) dias): \(.semana.entradas) entradas, \(.semana.saidas_total) saídas"
      + (if (.semana.saidas | length) > 0
         then " (" + ([.semana.saidas | to_entries[] | "\(.key) \(.value)"] | join(", ")) + ")"
         else "" end)'
}

# `admitir` É O TESTE DE ADMISSÃO VIRANDO CÓDIGO (rito §1, R11): sem --evidencia ou sem --medido-em
# em AAAA-MM-DD, RECUSA, e sem --raio, --esperado e --stack também: a linha nasce pronta para
# execução, e o modelo barato que a conserta não reconstrói o que faltou. Suspeita não é DT:
# vira medição ou morre. A forma de cada campo é da API; a stack se confere aqui, no catálogo.
dt_admitir() {
  local texto="${1:-}"; shift || true
  local medido_em="" evidencia="" esperado="" stack="" verbo="" solucao="" cadeira=""
  local raios=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --medido-em) medido_em="${2:-}"; shift 2 ;;
      --evidencia) evidencia="${2:-}"; shift 2 ;;
      --raio)      raios+=("${2:-}");  shift 2 ;;
      --esperado)  esperado="${2:-}";  shift 2 ;;
      --stack)     stack="${2:-}";     shift 2 ;;
      --verbo)     verbo="${2:-}";     shift 2 ;;
      --solucao)   solucao="${2:-}";   shift 2 ;;
      --cadeira)   cadeira="${2:-}";   shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  if [ -z "$texto" ]; then
    echo "uso: tarefas dt admitir \"<o que falha>\" --medido-em <AAAA-MM-DD> --evidencia <onde se mediu> --raio <repo@caminho> [--raio ...] --esperado \"<comportamento esperado>\" --stack <stack> [--verbo <v>] [--solucao \"<txt>\"]" >&2
    exit 2
  fi
  if [ -z "$evidencia" ]; then
    echo "recusado: DT sem --evidencia não entra. Suspeita não é DT: meça (repro, retorno colado, arquivo:linha) ou não abra. (rito §1)" >&2
    exit 2
  fi
  if ! printf '%s' "$medido_em" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
    echo "recusado: DT sem --medido-em AAAA-MM-DD não entra. A linha do rito diz o que foi medido, QUANDO e onde, e a idade da linha sai dessa data. (rito §1)" >&2
    exit 2
  fi
  if [ "${#raios[@]}" -eq 0 ]; then
    echo "recusado: DT sem --raio <repo@caminho> não entra: o raio literal, um ou mais, é onde o conserto mexe. (R11)" >&2
    exit 2
  fi
  if [ -z "$esperado" ]; then
    echo "recusado: DT sem --esperado não entra: o comportamento esperado, verificável, é o que fecha o conserto. (R11)" >&2
    exit 2
  fi
  if [ -z "$stack" ]; then
    echo "recusado: DT sem --stack não entra: a stack é posta por quem capta e não se deriva do raio. (R11)" >&2
    exit 2
  fi
  [ -z "$cadeira" ] || echo "aviso: --cadeira está deprecado e foi ignorado: a cadeira que admite vem do sujeito da chamada (PF_CADEIRA)" >&2
  local catalogo; catalogo=$(_dt_stacks) || exit $?
  if ! printf '%s\n' "$catalogo" | grep -Fxq -- "$stack"; then
    printf 'recusado: a stack `%s` não está no catálogo de stacks do acervo. Stacks do catálogo: %s. (R11)\n' \
      "$stack" "$(printf '%s' "$catalogo" | paste -sd, - | sed 's/,/, /g')" >&2
    exit 4
  fi
  local linha="${verbo:+$verbo — }$texto"
  [ -z "$solucao" ] || linha="$linha · solução: $solucao"
  local corpo r
  corpo=$(jq -nc --arg texto "$linha" --arg esperado "$esperado" --arg stack "$stack" \
            --arg medido_em "$medido_em" --arg onde "$evidencia" \
            '{texto: $texto, raio: $ARGS.positional, esperado: $esperado, stack: $stack, medido_em: $medido_em, onde: $onde}' \
            --args "${raios[@]}")
  r=$(printf '%s' "$corpo" | envia POST /balde) || return 1
  printf '%s' "$r" | jq -r '"débito \(.numero) admitido no balde: [\(.medido_em)] \(.texto) · stack \(.stack)"'
}

# `matar` É A SAÍDA DO RITO (§3, R12): três jeitos, nenhum silencioso, cada um com a âncora que
# lhe cabe. A API confere a forma da âncora e que o card englobador existe; segunda saída é 409.
#   resolvida  consertada; --commit <sha> do commit que consertou
#   cancelada  o objeto não existe mais, ou existe e custa mais do que dói; --motivo com o
#              retorno colado que prova, ou a decisão do dono (quem assina é ele)
#   englobada  ganhou dor e virou card, ou foi absorvida por card maior; --card <id>
# As quatro portas do rito antigo (`--porta card|obsoleto|decisao|englobado`, com `--ancora`)
# seguem aceitas, com aviso, até o guia defeito sair da tabela «a porta antiga» (card #3552).
dt_matar() {
  local n="${1:-}"; shift || true
  local como="" commit="" motivo="" card="" porta="" ancora=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --como)   como="${2:-}";   shift 2 ;;
      --commit) commit="${2:-}"; shift 2 ;;
      --motivo) motivo="${2:-}"; shift 2 ;;
      --card)   card="${2:-}";   shift 2 ;;
      --porta)  porta="${2:-}";  shift 2 ;;
      --ancora) ancora="${2:-}"; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  case "$n" in
    ''|*[!0-9]*) echo "uso: tarefas dt matar <n> --como resolvida --commit <sha> | --como cancelada --motivo \"<txt>\" | --como englobada --card <id>" >&2; exit 2 ;;
  esac
  if [ -n "$porta" ]; then
    if [ -n "$como" ]; then
      echo "recusado: --porta é a forma antiga e não vai junto com --como; use só --como resolvida|cancelada|englobada" >&2
      exit 2
    fi
    case "$porta" in
      card|englobado) como=englobada ;;
      obsoleto)
        if [[ "$ancora" =~ ^consertado:[[:space:]]*([0-9a-f]{7,40})([^0-9a-f]|$) ]]; then
          como=resolvida; commit="${BASH_REMATCH[1]}"
        else
          como=cancelada; motivo="$ancora"
        fi ;;
      decisao) como=cancelada; motivo="$ancora" ;;
      *)
        echo "recusado: --porta é card, obsoleto, decisao ou englobado (forma antiga); use --como resolvida|cancelada|englobada" >&2
        exit 2 ;;
    esac
    echo "aviso: --porta está deprecado (guia defeito, Matar): use --como $como" >&2
  fi
  local ancora_api
  case "$como" in
    resolvida)
      [ -n "$commit" ] || { echo "recusado: resolvida exige --commit <sha>, o commit que consertou. (R12)" >&2; exit 2; }
      ancora_api="$commit" ;;
    cancelada)
      [ -n "$motivo" ] || { echo "recusado: cancelada exige --motivo: o retorno colado que mostra que o objeto não existe mais, ou a decisão do dono. Memória não ancora. (R12)" >&2; exit 2; }
      ancora_api="$motivo" ;;
    englobada)
      [ -n "$card" ] || { echo "recusado: englobada exige --card <id>, o card que assume ou engloba a linha. (R12)" >&2; exit 2; }
      ancora_api=$(so_id "$card") ;;
    '')
      echo "uso: tarefas dt matar <n> --como resolvida --commit <sha> | --como cancelada --motivo \"<txt>\" | --como englobada --card <id>" >&2
      exit 2 ;;
    *)
      echo "recusado: --como é resolvida, cancelada ou englobada, os três jeitos de sair do balde. (R12)" >&2
      exit 2 ;;
  esac
  local r
  r=$(jq -nc --arg jeito "$como" --arg ancora "$ancora_api" '{jeito: $jeito, ancora: $ancora}' \
        | envia POST "/balde/$n/saida") || return 1
  printf '%s' "$r" | jq -r '"débito \(.numero) saiu do balde: \(.saida_jeito) em \(.saida_em[0:10]): \(.saida_ancora)"'
}

dt() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    listar)      dt_listar "$@" ;;
    admitir)     dt_admitir "$@" ;;
    matar)       dt_matar "$@" ;;
    vencidos)    dt_vencidos "$@" ;;
    indicadores) dt_indicadores "$@" ;;
    ''|*)
      cat >&2 <<'FIM'
uso:
  tarefas dt listar [--stack <s>] [--desde <n>] [--curto] [--situacao abertas|saidas|todas]
                                          linhas abertas do balde, as mais antigas primeiro, com a
                                          idade em dias e a stack; --desde <n> lê só da linha n em
                                          diante, --curto tira raio, esperado e onde
  tarefas dt admitir "<o que falha>" --medido-em <AAAA-MM-DD> --evidencia <onde se mediu>
                --raio <repo@caminho> [--raio ...] --esperado "<comportamento esperado>"
                --stack <stack> [--verbo <v>] [--solucao "<txt>"]
                                          acrescenta a linha numerada; SEM evidência, data, raio,
                                          esperado ou stack, RECUSA (sai 2), e stack fora do
                                          catálogo do acervo sai 4 com a lista — teste de admissão
                                          (rito §1, R11)
  tarefas dt matar <n> --como resolvida --commit <sha>
                       --como cancelada --motivo "<txt>"
                       --como englobada --card <id>
                                          tira a linha por um dos três jeitos (rito §3, R12) e a
                                          registra com a âncora e a data; cada jeito pede a sua
                                          âncora. `--porta` segue aceito, com aviso (deprecado)
  tarefas dt vencidos                     pauta da revisão: linhas acima de 30 dias (rito §2)
  tarefas dt indicadores [--dias <n>]     por stack, os abertos e a idade do mais velho; na semana
                                          (7 dias, ou os de --dias), as entradas e as saídas por jeito

O balde é dado do rastreador (tabela `balde`), uma linha por débito, com o número que já
tinha no corpo do #2856. Card próprio só pelo jeito englobada.
Rito: padrao rito-debito-tecnico
FIM
      exit 2 ;;
  esac
}

# --- ordem, vínculo e carteira (card #3526; R21, R23 e R25 da spec tarefas) -------------

# ORDENAR põe o card ao lado de um vizinho na ordem única da casa. O cliente escolhe a vizinhança e
# o SERVIDOR calcula o posto (card #3522): um `posto` no corpo seria o cliente calculando. Um lado
# só: com os dois o corpo não diria qual vale, e o verbo recusa antes de chamar.
ordenar() {
  local id; id=$(so_id "${1:?uso: tarefas ordenar <id> --antes-de <id> | --depois-de <id>}"); shift
  local lado="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --antes-de|--depois-de)
        [ -z "$lado" ] || { echo "recusado: --antes-de e --depois-de juntos não dizem onde o card fica; escolha um" >&2; exit 2; }
        lado="${1#--}"; lado="${lado//-/_}"
        ref=$(so_id "${2:?$1 pede o id do vizinho}"); shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  case "$id" in ''|*[!0-9]*) lado="" ;; esac
  case "$ref" in ''|*[!0-9]*) lado="" ;; esac
  [ -n "$lado" ] || { echo "uso: tarefas ordenar <id> --antes-de <id> | --depois-de <id>" >&2; exit 2; }
  jq -n --arg l "$lado" --argjson r "$ref" '{($l): $r}' \
    | envia POST "/itens/$id/posto" \
    | jq -r --arg l "$lado" --arg r "$ref" \
        '"item \(.id) ficou \(if $l == "antes_de" then "antes" else "depois" end) de #\($r) (posto \(.posto)): \(.titulo)"'
}

# Os dois lados do vínculo de <id>, como a API os devolve ao declarar e ao retirar.
_vinculos_texto() { # _vinculos_texto <id>   (JSON da API em stdin)
  jq -r --arg id "$1" '
    def lado: if ((. // []) | length) > 0 then ([.[] | "#\(.id)"] | join(", ")) else "ninguém" end;
    "#\($id) bloqueia: \(.bloqueia | lado)",
    "#\($id) bloqueado por: \(.bloqueado_por | lado)"'
}

# BLOQUEAR e DESBLOQUEAR (R23). O ciclo quem recusa é o banco, pela API: 409 com o caminho que o
# fecharia, e a recusa o imprime (`_recusa`). Declarar o que já existe é no-op lá.
bloquear() { # bloquear <bloqueador> <bloqueado>
  local a b
  a=$(so_id "${1:?uso: tarefas bloquear <a> <b> — <a> bloqueia <b>}")
  b=$(so_id "${2:?uso: tarefas bloquear <a> <b> — <a> bloqueia <b>}")
  case "$a$b" in ''|*[!0-9]*) echo "uso: tarefas bloquear <a> <b> — <a> bloqueia <b>" >&2; exit 2 ;; esac
  jq -n --argjson b "$b" '{bloqueado:$b}' | envia POST "/itens/$a/bloqueia" | _vinculos_texto "$a"
}

desbloquear() { # desbloquear <bloqueador> <bloqueado>
  local a b
  a=$(so_id "${1:?uso: tarefas desbloquear <a> <b> — retira \"<a> bloqueia <b>\"}")
  b=$(so_id "${2:?uso: tarefas desbloquear <a> <b> — retira \"<a> bloqueia <b>\"}")
  case "$a$b" in ''|*[!0-9]*) echo "uso: tarefas desbloquear <a> <b> — retira \"<a> bloqueia <b>\"" >&2; exit 2 ;; esac
  busca DELETE "/itens/$a/bloqueia/$b" | _vinculos_texto "$a"
}

# CARTEIRA (R25): o que a firma entregou na semana, por originação, e o que está parado.
#
# AGREGA NO VERBO, sobre `GET /api/itens`, sem rota nova no rastreador: a consulta direta é da F8
# (#3482). Conta story e task ENTREGUES (`entregue`, e `resolvido` que é o fecho do incidente) cuja
# entrada no terminal — `ultimo_movimento` — é de `--desde` em diante, fora as de origem `prova`,
# por `tipo_demanda`. A linha do balde conta as saídas do balde (`GET /api/balde`) no mesmo período e fica AO LADO,
# sem somar: débito que sai não é card entregue. As paradas são as despriorizadas, com a idade (hoje
# menos `ultimo_movimento`, em dias): sob pai apostado — o estado ESCRITO do pai direto em
# `priorizada` ou adiante, que a projeção traz em `pai_estado` —, sem pai (autônomas) e as que
# esperam um pai ainda não apostado. A lista de estados e a ordem vêm do registro.
carteira() { # carteira [--desde AAAA-MM-DD]
  local desde="" hoje="${TAREFAS_HOJE:-$(date +%F)}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --desde) desde="${2:?--desde pede AAAA-MM-DD}"; shift 2 ;;
      *) echo "opção desconhecida: $1 (uso: tarefas carteira [--desde AAAA-MM-DD])" >&2; exit 2 ;;
    esac
  done
  # Sem --desde, a segunda-feira da semana de hoje.
  [ -n "$desde" ] || desde=$(date -d "$hoje -$(( $(date -d "$hoje" +%u) - 1 )) days" +%F)
  printf '%s' "$desde" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' \
    || { echo "--desde pede AAAA-MM-DD: $desde" >&2; exit 2; }
  local lista registro balde saidas
  lista=$(busca GET "/itens?nivel=2&nivel=3") || return 1
  registro=$(busca GET /registro) || return 1
  # As saídas se contam na API (R26: o balde é dado, não corpo de card), pela data em que a linha
  # saiu. Rastreador que não respondeu não derruba a fatia.
  if saidas=$(busca GET "/balde?situacao=saidas" 2>/dev/null \
                | jq -r --arg desde "$desde" '[.linhas[] | select((.saida_em // "")[0:10] >= $desde)] | length' 2>/dev/null) \
     && [ -n "$saidas" ]; then
    balde="  balde"$'\t'"$saidas saídas desde $desde (ao lado, não soma)"
  else
    balde="  balde"$'\t'"ilegível: o balde não se leu"
  fi
  printf '%s' "$lista" | jq -r --arg desde "$desde" --arg hoje "$hoje" --arg balde "$balde" \
      --argjson reg "$registro" '
    def entregue: .estado == "entregue" or .estado == "resolvido";
    def idade: ((($hoje | strptime("%Y-%m-%d") | mktime)
                 - ((.ultimo_movimento // $hoje)[0:10] | strptime("%Y-%m-%d") | mktime)) / 86400 | floor);
    def linha: "    #\(.id)\t\(idade)d\t\(.titulo)";
    ($reg.estados | map({key: .estado, value: .ordem}) | from_entries) as $ordem
    | ($ordem.priorizada // 0) as $aposta
    | .itens as $its
    | [$its[] | select(entregue and ((.origem // "") != "prova")
                       and ((.ultimo_movimento // "")[0:10] >= $desde))] as $ent
    | [$its[] | select(.estado == "despriorizada")] as $par
    | [$par[] | select(.pai != null and .pai_estado != null and (($ordem[.pai_estado] // 0) >= $aposta))] as $sob
    | [$par[] | select(.pai == null)] as $livres
    | [$par[] | select(.pai != null and (.pai_estado == null or (($ordem[.pai_estado] // 0) < $aposta)))] as $espera
    | "carteira desde \($desde) — story e task entregues, fora de origem prova",
      (["negocio", "tecnico", "incidente"][] as $t
         | "  \($t)\t\([$ent[] | select(.tipo_demanda == $t)] | length)"),
      (([$ent[] | select(.tipo_demanda == null)] | length) as $sem
         | if $sem > 0 then "  sem originação gravada\t\($sem)" else empty end),
      $balde,
      "",
      "paradas (despriorizada): \($par | length)",
      "  sob pai apostado\t\($sob | length)", ($sob[] | linha),
      "  sem pai (autônomas)\t\($livres | length)", ($livres[] | linha),
      (if ($espera | length) > 0
       then "  sob pai ainda não apostado\t\($espera | length)", ($espera[] | linha)
       else empty end)'
}

# ESPERA-DONO (R30 da spec tarefas, cards #3595 e #3597) — a mesma consulta que a tela da F7
# (#3481) lê, em duas partes: do dono (pergunta dirigida a ele, card pronto para a aposta,
# pai em homologação) e, à parte, com as cadeiras (os demais abertos, por card, com a marca
# de órfão). Lê pela rota própria `GET /espera-dono`; o verbo não calcula nada — a mesma
# régua do R28 dos indicadores do balde.
#
# `--json` devolve o corpo da API como veio, sem reformatar: a borda o serve a casca em /api/espera-dono
# (card #3899; mecanismo comum da arq:0124 §3, `# mecanismo: espera-dono=casca`).
espera_dono() {
  local j; j=$(busca GET /espera-dono) || return 1
  case "${1:-}" in
    --json) printf '%s\n' "$j"; return 0 ;;
    "") ;;
    *) echo "uso: tarefas espera-dono [--json]" >&2; exit 2 ;;
  esac
  printf '%s' "$j" | jq -r '
    "do dono (\(.do_dono.total)):",
    (if .do_dono.total == 0 then "  nada" else empty end),
    (.do_dono.perguntas[] | "  pergunta #\(.id) · #\(.item) \(.titulo) [\(.cadeira // "—")] — \(.primeira_linha)"),
    (.do_dono.prontos_para_aposta[] | "  pronto para a aposta · #\(.id) [\(.cadeira // "—")] \(.titulo)"),
    (.do_dono.em_homologacao[] | "  em homologação · #\(.id) [\(.cadeira // "—")] \(.titulo)"),
    "",
    "com as cadeiras (\(.com_cadeiras.abertos) abertos, \(.com_cadeiras.orfaos) órfãos):",
    (if (.com_cadeiras.cards | length) == 0 then "  nada" else empty end),
    (.com_cadeiras.cards[] | "  #\(.id) [\(.cadeira // "—")] \(.titulo)",
      (.abertos[] | "    #\(.id) \(.tipo)" + (if .orfao then " · órfão" else "" end) + " — \(.primeira_linha)"))
  '
}

# --- despacho ---------------------------------------------------------------

# --ajuda UNIVERSAL, sem efeito colateral (card #2274, defeito 4). ANTES do despacho e
# varrendo TODOS os argumentos: `tarefas criar --ajuda` criava um card chamado "--ajuda"
# porque `--ajuda` caía como título posicional. Interceptar aqui cobre tanto `tarefas
# --ajuda` quanto `tarefas <sub> --ajuda`, e nenhum sub-ato chega a rodar. `uso` já sai 2.
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso 0 ;;
  esac
done

cmd="${1:-}"; shift || uso

case "$cmd" in
  listar)      descarta_projeto "${1:-}" && shift; listar "$@" ;;
  listar-tudo) descarta_projeto "${1:-}" && shift; listar_tudo "$@" ;;
  ler|ver)     ler "${1:?uso: tarefas ler <id>}" ;;
  criar)       criar "$@" ;;
  editar)      editar "$@" ;;
  comentar)    comentar "$@" ;;
  comentarios) comentarios "${1:?uso: tarefas comentarios <id> [--indice] [--id <n>]... [--desde <n>] [--ultimos <k>]}" "${@:2}" ;;
  mover)       mover "$@" ;;
  fechar)      fechar "${1:?uso: tarefas fechar <id>}" "${@:2}" ;;
  apagar)      apagar "${1:?uso: tarefas apagar <id> [--cascata]}" "${@:2}" ;;
  apagar-comentario) apagar_comentario "${1:?uso: tarefas apagar-comentario <id> <cid>}" "${2:?cid}" ;;
  assinar)     assinar "${1:?uso: tarefas assinar <id> --aprovador <cadeira> [--decisao aprovado|recusado] [--motivo \"<txt>\"]}" "${@:2}" ;;
  sub)         subtarefa "${1:?uso: tarefas sub <pai> [<filho>]}" "${2:-}" ;;
  ordenar)     ordenar "${1:?uso: tarefas ordenar <id> --antes-de <id> | --depois-de <id>}" "${@:2}" ;;
  bloquear)    bloquear "${1:?uso: tarefas bloquear <a> <b>}" "${2:?uso: tarefas bloquear <a> <b>}" ;;
  desbloquear) desbloquear "${1:?uso: tarefas desbloquear <a> <b>}" "${2:?uso: tarefas desbloquear <a> <b>}" ;;
  carteira)    carteira "$@" ;;
  espera-dono) espera_dono "$@" ;;
  modelo)      modelo "${1:-}" "${2:-}" ;;
  estados)     estados ;;
  dt)          dt "$@" ;;
  projetos)    echo "não há projeto neste modelo: o recorte é por eixo (cadeira, estado, nível)." >&2; exit 2 ;;
  api)         busca "${1:?método}" "$(_apipath "${2:?caminho}")" ;;
  api-corpo)   envia "${1:?método}" "$(_apipath "${2:?caminho}")" ;;
  *)           uso ;;
esac
