#!/usr/bin/env bash
# tarefas — conduz o card, da demanda captada à entrega
# capacidade: tarefas
# dono: gestao-estrategica
# use para: SEMPRE que o assunto for card, épico, feature, story, incidente ou débito técnico; captar demanda, «cria um card»; lapidar, dar parecer, apostar, formalizar, priorizar, pôr em execução, concluir, validar e entregar card, «move para refinamento», «comenta no card»; declarar, mitigar e fechar incidente; «o que está comigo?», «lê o card», «os comentários do card», sign-off; e sempre que o pacto quebrar ou uma execução cair
# atos: listar, listar-tudo, ler, criar, editar, modelo, comentar, comentarios, mover, fechar, apagar, assinar, dt, estados, sub, ordenar, bloquear, desbloquear, carteira, inventario, espera-dono (leitura, trabalho)
# mecanismo: espera-dono=casca
#
# Texto do controle (arq:0124 §3; arq:0125 U33; card #3446). Todo ato cai na face Entrega.
# Rótulo: verbo no infinitivo e objeto sem artigo, um verbo por tipo de ato (Listar uma coleção,
# Abrir um item; regra de produto, comentário #2216 do #3446). O objeto entra pelo slug, `{slug}`,
# quando o conceito é do tesauro; termo da casa (card, comentário, estado, débito técnico) vai
# escrito até o tesauro ter o braço da casa (arq:0124 §3, emenda de 12/10/2026). volta: diz se
# o efeito se desfaz; ato que só lê declara exatamente `sim — só lê`.
# face: listar=Entrega
# face: listar-tudo=Entrega
# face: ler=Entrega
# face: criar=Entrega
# face: editar=Entrega
# face: modelo=Entrega
# face: comentar=Entrega
# face: comentarios=Entrega
# face: mover=Entrega
# face: fechar=Entrega
# face: apagar=Entrega
# face: assinar=Entrega
# face: dt=Entrega
# face: estados=Entrega
# face: sub=Entrega
# face: ordenar=Entrega
# face: bloquear=Entrega
# face: desbloquear=Entrega
# face: carteira=Entrega
# face: inventario=Entrega
# rotulo: listar=Listar card aberto
# rotulo: listar-tudo=Listar card do funil, parado inclusive
# rotulo: ler=Abrir card
# rotulo: criar=Criar card
# rotulo: editar=Editar card
# rotulo: modelo=Abrir molde de card
# rotulo: comentar=Comentar card
# rotulo: comentarios=Listar comentário
# rotulo: mover=Mover card
# rotulo: fechar=Fechar card
# rotulo: apagar=Apagar card
# rotulo: assinar=Assinar card
# rotulo: dt=Administrar débito técnico
# rotulo: estados=Listar estado de card
# rotulo: sub=Subordinar card
# rotulo: ordenar=Ordenar card
# rotulo: bloquear=Bloquear card
# rotulo: desbloquear=Desbloquear card
# rotulo: carteira=Ler carteira
# rotulo: inventario=Administrar inventário de feature
# volta: listar=sim — só lê
# volta: listar-tudo=sim — só lê
# volta: ler=sim — só lê
# volta: criar=sim — tarefas apagar, enquanto o item está no funil
# volta: editar=nao
# volta: modelo=sim — só lê
# volta: comentar=nao
# volta: comentarios=sim — só lê
# volta: mover=sim — tarefas mover ao estado de antes, onde o fluxo deixa (a recusa diz para onde se pode ir)
# volta: fechar=nao
# volta: apagar=nao
# volta: assinar=nao
# volta: dt=nao
# volta: estados=sim — só lê
# volta: sub=nao
# volta: ordenar=sim — tarefas ordenar do card ao lado do vizinho de antes (o posto antigo não volta, o lugar sim)
# volta: bloquear=sim — tarefas desbloquear
# volta: desbloquear=sim — tarefas bloquear
# volta: carteira=sim — só lê
# volta: inventario=nao
# Backend: `platafirma-rastreador` (API própria), desde 16/08/2026. O Vikunja saiu.
#
# Loopback, e não a rota pública: `tarefas.platafirma.org` serve a superfície HUMANA
# atrás do gate do control-plane, e agente não atravessa oauth2-proxy. O agente entra
# pelo loopback da máquina, que já é a fronteira dele (card #469).
#
# SEM CREDENCIAL, por desenho: não há auth no código do módulo. Quem escreve declara o
# nome no cabeçalho de sujeito, e é ele que a transição carimba — `PF_CADEIRA` (ou
# `PF_SUJEITO` da conexão quando a abertura está degradada, DT 928) vira
# `x-auth-request-preferred-username`. Ausentes ambos, a escrita entra como anônima.
set -euo pipefail

# `/api` desde o contract do #196: a tela do rastreador saiu de dentro da imagem da API
# e virou servico proprio, e quem separa os dois e o gate da borda, que roteia por
# prefixo de path. A arvore de dado deixou de responder na raiz — sem o prefixo aqui,
# este verbo quebraria para toda cadeira no mesmo minuto.
# O loopback continua sendo a porta do agente (card #469): a borda gateia a superficie
# HUMANA, e um Bearer de agente nao atravessa oauth2-proxy.
BASE="${TAREFAS_BASE:-http://127.0.0.1:8120/api}"

# ESCOTILHA: BASE ja termina em /api. O caminho natural (rota real, ex. /api/itens/2930)
# duplicava o prefixo -> /api/api/... -> 404 mudo ("falha ao falar"). Card do 8120.
# Normaliza na BORDA: aceita com ou sem /api; chamadores internos (que passam /itens/...)
# nao passam por aqui, nao regridem.
_apipath() {
  case "$1" in
    /api)   printf '/' ;;
    /api/*) printf '%s' "${1#/api}" ;;
    *)      printf '%s' "$1" ;;
  esac
}
QUEM="${PF_CADEIRA:-${PF_SUJEITO:-}}"

# Pedido de ajuda nao e erro (dono, 12/09/2026): `--ajuda` sai por stdout com exit 0; so
# a chamada errada continua saindo por stderr com exit 2.
uso() {
  local codigo="${1:-2}" fd=2
  [ "$codigo" = 0 ] && fd=1
  cat >&$fd <<'FIM'
uso:
  tarefas listar [--cadeira <c>] [--estado <e>] [--nivel <n>] [--originacao <o>] [--executor <c>]
                [--paradas] [--json] [--campos id,pai,estado,nivel]
                                          itens abertos (fase != terminal), na ordem do posto;
                                          as paradas (despriorizada) ficam de fora salvo --paradas
                                          ou --estado despriorizada
  tarefas listar --quadro discovery|delivery [--paradas] [--json]
                                          a projeção pronta do rastreador (R35): id, estado
                                          mostrado, cadeira, executor e título, na ordem dele;
                                          sem --paradas, a despriorizada sai do delivery e a
                                          saída diz quantas saíram
  tarefas listar-tudo [mesmos filtros] [--ultimos <n>] o funil inteiro, paradas inclusive;
                                          com --ultimos, ordena por data decrescente e inclui
                                          data na saída
                                          CARD EM ESTADO TERMINAL (entregue, encerrado, cancelado,
                                          englobado, descartado) NÃO SAI EM ATO DE LEITURA NENHUM:
                                          listar, listar-tudo, ler, comentarios, sub, espera-dono,
                                          --quadro e api GET o tiram da lista, e o pedido direto
                                          dele sai recusado com exit 1 (ordem do dono, 17/11/2026)
  tarefas ler|ver <id> [--cabecalho] [--todas-filhas]
                                          item em texto: cabeçalho (originação, executor,
                                          quem bloqueia e por quem é bloqueado), ancestrais,
                                          corpo e filhas abertas em ordem de dependência (na
                                          story, as tasks dela, todas, com o estado de cada uma);
                                          com --cabecalho, devolve só o cabeçalho
  tarefas criar "<título>" [--desc "<txt>"|--desc-stdin]
                [--nivel épico|feature|story|task|ideia] [--cadeira <c>] [--pai <id>] [--incidente]
                [--originacao negocio|tecnico|incidente] [--executor <c>]
                [--estado <estado>] [--registro "<porquê>"]
                                          default: story. Débito técnico não é card: `dt admitir`.
                                          `--nivel ideia` guarda uma ideia, ou um balde de ideias
                                          de um tema, só com o título: nasce em captada, não tem
                                          pai nem filha, e cada nova ideia do tema entra em
                                          `comentar <id>` como insumo. Sai só por
                                          `mover <id> englobada --englobado-em <card>` ou
                                          `mover <id> descartada --motivo "<txt>"`
                                          `--nivel task` cria o passo de uma story e exige
                                          `--pai <story>`; o título é o que fazer, e a API
                                          recusa pai que não seja story (R37). Para ajustar
                                          a task, `editar`; para concluí-la, `mover <id> entregue`;
                                          as tasks de uma story saem em `ler <story>`
                                          O estado de nascimento vem de --estado, ou de
                                          PF_ESTADO_INICIAL, ou é captada (story/task:
                                          priorizada; incidente: detectado).
                                          Story sem pai em priorizada ou adiante exige
                                          --registro, gravado como registro de negócio na
                                          mesma transação (R16, arq:0127 D8).
                                          Nascer fora de `captada`, ou sair dela, exige o
                                          corpo no padrão do nível (arq:0096)
  tarefas editar <id> [--titulo "<t>"] [--desc "<txt>"|--desc-stdin]
                [--cadeira <c>|--sem-cadeira] [--nivel épico|feature|story|task|ideia]
                [--originacao negocio|tecnico|incidente] [--executor <c>]
                [--trecho --antes "<txt>" --depois "<txt>" [--bruto]]
                                          troca título, corpo, cadeira, nível, originação e/ou executor (o corpo é
                                          substituído inteiro); não mexe no estado — mover é
                                          `mover`. Cadeira e nível inválidos a API recusa.
                                          `--trecho` (card #4110) troca o corpo só num ponto: `--antes`
                                          tem de ocorrer UMA vez no corpo gravado e vira `--depois`
                                          (vazio apaga); o resto sai idêntico e o pedido leva só o
                                          trecho. O corpo gravado é HTML: o trecho recebe o mesmo
                                          escape do corpo, linha em branco fecha parágrafo e quebra
                                          simples é <br>. Trecho que cruza rótulo em negrito ou link não
                                          casa (a API recusa e diz quantas vezes ele ocorreu): `--bruto`
                                          manda `--antes` e `--depois` como estão, em HTML
  tarefas modelo <épico|feature|story|task>
                                          esqueleto do corpo, com os rótulos que a API exige;
                                          épico e feature saem no two-pager
  tarefas modelo story derivada           a story que sai da formalização: aponta R<n>, D<n> ou Peça
  tarefas modelo comentario <tipo>        o comentário tipado: insumo, pergunta, buraco,
                                          requisito ou decisão
  tarefas modelo story refinada           o Plano: segunda camada da story, escrita pela
                                          cadeira dona em em-refinamento-tecnico, depois de
                                          ler o código; a executora, quando é outra, revisa
                                          antes de começar (classe story)
  tarefas comentar <id> ["<txt>"]         cria comentário (entidade própria — card #390,
                                          não altera o corpo do item); sem texto, lê stdin
  tarefas comentar <id> --fecha <n> "<resultado> — <destino>"
                                          escreve «fecho: …» como última linha do comentário n
                                          (comentário tipado; insumo não leva fecho)
  tarefas comentar <id> --edita <n> ["<txt>"]
                                          troca o corpo do comentário n (lê stdin se sem texto,
                                          converte em HTML como na criação; a API recusa trocar
                                          o tipo ou mexer no fecho, R13)
  tarefas comentarios <id> [--indice] [--busca <termo>] [--arvore] [--id <n>]... [--desde <n>] [--ultimos <k>]
                                          lista os comentários do item, em ordem. --busca <termo>
                                          filtra as linhas que casam (id, card e linha); --arvore
                                          desce a subárvore inteira. A porta corta a saída em ~50 KB:
                                          --indice dá uma linha por comentário; --id lê só aquele(s);
                                          --desde <n> os de id >= n; --ultimos <k> os k mais novos
  tarefas mover <id> <estado> [--motivo "<txt>"] [--englobado-em <id>]
                                          move o card pelo fluxo; a recusa diz para onde
                                          se PODE ir a partir do estado atual. Item com
                                          pai devolve junto o derivado do pai e as irmãs
                                          abertas (arq:0095) — é a âncora do PARCIAL:
                                          No sucesso traz ainda, depois deles, a linha do
                                          processo que conduz o estado de destino, quando o
                                          catálogo o liga (card #4359)
  tarefas mover <pai> priorizada --decisao <n>
                                          a aposta: <n> é o comentário de decisão do PRÓPRIO
                                          pai; sem ele a API recusa dizendo como informar (R36)
  tarefas fechar <id> [--como <estado>] [--cascata]
                                          fecha; default: entregue. Filha aberta na
                                          subárvore? a recusa NOMEIA quem seria encerrado
                                          junto, e `--cascata` confirma. Para mover, `mover`.
  tarefas apagar <id> [--cascata]        APAGA o item. Fora do miolo do fluxo (funil e
                                         terminal); `--cascata` leva a subárvore e
                                         os itens englobados por ele junto.
  tarefas assinar <id> --aprovador <c> [--decisao aprovado|recusado] [--motivo "<txt>"]
                                          sign-off. Sem --decisao, inscreve o aprovador
                                          como PENDENTE. `recusado` exige --motivo.
  tarefas sub <pai> [<filho>] | <filho> --sem-pai
                                          declara <filho> filho de <pai>, lista as filhas ou desvincula pai
  tarefas ordenar <id> --antes-de <id> | --depois-de <id>
                                          põe o card ao lado do vizinho na ordem única da casa;
                                          o servidor calcula o posto (R21)
  tarefas bloquear <a> <b>                <a> bloqueia <b>; o que fecharia ciclo a API recusa e o
                                          caminho sai na recusa (R23)
  tarefas desbloquear <a> <b>             retira o vínculo "<a> bloqueia <b>"
  tarefas carteira [--desde <AAAA-MM-DD>] a fatia por originação das stories entregues
                                          desde a data (padrão: a segunda-feira desta semana), a
                                          linha do balde ao lado e as paradas com idade (R25)
  tarefas mover <id> despriorizada --motivo <código>
                                          o motivo é código da lista do registro; sem ele, ou com
                                          código fora dela, a recusa imprime a lista (R24)
  tarefas dt <listar|ler|admitir|matar|vencidos|indicadores>
                                          ler <n>: linha completa; listar --linha <n> ou --stack <stack>
                                          balde de débito técnico: dado do rastreador, uma linha
                                          por débito (rito §4); `dt` sem sub lista os atos
  tarefas estados                         os estados do registro, com fase
  tarefas inventario <ler|criar|editar|validar|cortar|ligar|desligar>
                                          o inventário da feature (peças, regras de negócio e produtos
                                          documentais), dado do rastreador. A chave é
                                          <feature>.<p|r|d><n>, como 4314.r3, e o número e o evento de
                                          cada ato são do banco. `inventario` sem sub mostra o uso
  tarefas espera-dono                     o que espera o dono: pergunta dirigida a ele, card
                                          pronto para a aposta e pai em homologação; à parte,
                                          o que está com as cadeiras — abertos por card, com a
                                          marca de órfão (R30)
  tarefas api <MÉTODO> <caminho>          escotilha, sem corpo
  tarefas api-corpo <MÉTODO> <caminho>    escotilha, corpo JSON em stdin

NÃO HÁ PROJETO neste modelo. `46` e `1` eram do Vikunja; o recorte agora é por eixo
(cadeira, estado, nível). Chamada antiga com projeto no lugar do primeiro argumento
segue funcionando: o número é ignorado, com aviso em stderr.
FIM
  exit "$codigo"
}

# --- transporte -------------------------------------------------------------

_hdr_sujeito() { [ -n "$QUEM" ] && printf '%s' "x-auth-request-preferred-username: $QUEM"; }

# RECUSA DA API NÃO É SILENCIOSA — card #224. Era `-sfS`, e `-f` DESCARTA O CORPO: toda
# recusa de regra chegava à cadeira como `curl: (22) ... error: 400`, sem uma palavra sobre
# o que a máquina disse. Com `--fail-with-body` (curl 8.5 no host) o corpo vem, e é ele que
# carrega o texto da máquina — inclusive a lista de destinos que este card mandou escrever.
_recusa() { # lê o corpo do erro em $1 (e opcionalmente $2=http_code $3=rota $4=curl_err) e devolve a mensagem da API
  local corpo="${1:-}" http_code="${2:-}" rota="${3:-}" curl_err="${4:-}"
  local erro; erro=$(printf '%s' "$corpo" | jq -r '.erro // .detail // empty' 2>/dev/null || true)
  if [ -z "$erro" ] && [ -n "$(printf '%s' "$corpo" | tr -d '[:space:]')" ]; then
    erro=$(printf '%s' "$corpo" | tr '\r\n' ' ' | cut -c1-300)
  fi
  # A LISTA DE DESTINOS SAIU DE DENTRO DE `.erro` E VIROU CAMPO (card #245): no board ela
  # empurrava a coluna, e a API passou a devolver causa e lista separadas. Aqui elas se
  # recolam, porque quem lê terminal quer a frase inteira — o CLI não regride com a mudança
  # de forma. Recusa sem o campo (nascimento, validação de corpo) segue imprimindo só a causa.
  local frase; frase=$(printf '%s' "$1" | jq -r '.frase_destinos // empty' 2>/dev/null || true)
  [ -n "$frase" ] && erro="$erro · $frase"
  # A API fala em `?cascata=1` porque é o parâmetro DELA; quem está no terminal digita
  # `--cascata`. Traduzir na borda é o certo: a API não deve conhecer as flags dos seus
  # clientes, e mandar alguém montar query string na mão para responder uma pergunta que o
  # verbo já sabe fazer é devolver o trabalho que este verbo existe para tirar.
  erro="${erro//\`?cascata=1\`/\`--cascata\`}"
  # CARD #3597 (R16, R31): `exige` é o nome do campo que falta — hoje só `registro-de-negocio`
  # —, para quem lê agir sem reparsear a frase; a tradução é a linha de comando que resolve.
  local exige; exige=$(printf '%s' "$1" | jq -r '.exige // empty' 2>/dev/null || true)
  if [ "$exige" = "registro-de-negocio" ]; then
    erro="$erro · tarefas criar \"<título>\" --registro \"<porquê>\" (com --estado priorizada exige corpo no padrão; item existente: tarefas comentar <id> \"registro de negócio: <porquê>\" e repita o ato)"
  fi
  # CARD #3526 (R23): o vínculo que fecharia ciclo volta com `caminho` (ids), e a recusa o mostra.
  # #4250: o passo do caminho que é task sai como `t<n>` quando a API manda a chave dele.
  local caminho; caminho=$(printf '%s' "$1" | jq -r '(.caminho // []) | map(if type == "object" and ((.chave // "") | tostring | test("\\.t[0-9]+$")) then (.chave | tostring | sub("^[0-9]+\\."; "")) else "#\(if type == "object" then .id else . end)" end) | join(" → ")' 2>/dev/null || true)
  [ -n "$caminho" ] && erro="$erro · caminho: $caminho"
  # `-S` sai do curl porque a mensagem util e o CORPO, e a linha `curl: (22) ... 400` so
  # empurrava o texto da maquina para fora da tela. Falha SEM corpo (rede, servico fora)
  # nao fica muda: cai no ramo abaixo, com o endereco que nao respondeu.
  if [ -z "$erro" ]; then
    local onde="${rota:+ ($rota)}" detalhe="sem corpo de erro"
    if [ -n "$http_code" ] && [ "$http_code" != "000" ]; then
      detalhe="HTTP $http_code, sem corpo de erro"
    elif [ -n "$curl_err" ]; then
      detalhe="$curl_err"
    fi
    erro="falha ao falar com o rastreador em $BASE${onde} ($detalhe)"
  fi
  printf '%s\n' "$erro" >&2
  # CARD #3526 (R24): despriorizar sem código da lista (ou com código fora dela) volta com
  # `motivos`, [{codigo, nome}]. A lista é do registro; o verbo só a imprime, uma por linha.
  local motivos; motivos=$(printf '%s' "$corpo" | jq -r '(.motivos // [])[] | "  \(.codigo)\t\(.nome)"' 2>/dev/null || true)
  [ -n "$motivos" ] && printf 'motivos (um destes códigos em --motivo):\n%s\n' "$motivos" >&2
  return 1
}

# RECUSA E' FALHA (medido 12/09/2026): `|| _recusa` imprimia a causa e a funcao seguia
# para o printf e devolvia 0 — `tarefas mover` recusado pela API saia "item null → : null"
# com exit 0. Falha silenciosa e' pior que exit 1: o log de erro nao a ve.
_exec_curl_cru() { # _exec_curl_cru MÉTODO /caminho [corpo_em_stdin=0|1]  — sem o portão do funil
  local metodo="$1" caminho="$2" com_corpo="${3:-0}"
  local err_arq rc=0 bruto="" http_code="" saida="" curl_err=""
  local -a args=(-sS --fail-with-body -w $'\n%{http_code}' -X "$metodo" "$BASE$caminho")
  [ -n "$QUEM" ] && args+=(-H "x-auth-request-preferred-username: $QUEM")
  if [ "$com_corpo" -eq 1 ]; then
    args+=(-H 'Content-Type: application/json' -d @-)
  fi
  err_arq=$(mktemp)
  if [ "$com_corpo" -eq 1 ]; then
    bruto=$(curl "${args[@]}" 2>"$err_arq") || rc=$?
  else
    bruto=$(curl "${args[@]}" 2>"$err_arq") || rc=$?
  fi
  curl_err=$(tr '\r\n' ' ' <"$err_arq" | sed 's/[[:space:]]*$//')
  rm -f "$err_arq"
  if [ "$rc" -ne 0 ]; then
    http_code="${bruto##*$'\n'}"
    case "$http_code" in
      [0-9][0-9][0-9])
        if [ "$bruto" != "$http_code" ]; then
          saida="${bruto%$'\n'*}"
        else
          saida=""
        fi
        ;;
      *) http_code=""; saida="$bruto" ;;
    esac
    _recusa "$saida" "$http_code" "$metodo $caminho" "$curl_err"
    return 1
  fi
  local ultima="${bruto##*$'\n'}"
  case "$ultima" in
    [0-9][0-9][0-9])
      if [ "$bruto" != "$ultima" ]; then
        printf '%s' "${bruto%$'\n'*}"
      else
        printf '%s' "$bruto"
      fi
      ;;
    *) printf '%s' "$bruto" ;;
  esac
}

busca() { # busca MÉTODO /caminho
  _exec_curl "$1" "$2" 0
}

envia() { # envia MÉTODO /caminho  (corpo JSON em stdin)
  _exec_curl "$1" "$2" 1
}

# --- portão do funil -----------------------------------------------------------

# CARD FORA DO FUNIL NÃO APARECE EM LEITURA (ordem do dono, 17/11/2026): para quem usa o
# gatilho de tarefas, card em estado terminal (entregue, encerrado, cancelado, englobado,
# descartado, recusado, resolvido, e o que mais o registro marcar terminal) não aparece sob
# hipótese nenhuma. O portão mora AQUI, no transporte, e não em cada ato: todo GET que um ato
# de leitura faz ao rastreador passa por ele, e o ato novo que ler card já nasce coberto.
# O despacho liga o portão (`_SO_FUNIL=1`) só nos atos de leitura; os de escrita seguem
# vendo o card terminal, porque mover de volta, apagar e reabrir dependem disso.
#   - card terminal pedido pelo id ou pela chave: recusa, exit 1, sem título nem corpo;
#   - card englobado lido pelo número antigo (a API devolve o englobante com `resolvido_de`):
#     recusa, nomeando o englobante, que é o que se lê;
#   - subrecurso de card terminal (`/itens/<n>/comentarios`): recusa;
#   - lista, quadro, espera-dono, filhas, ancestrais e vínculos: o card terminal sai da lista,
#     e o objeto que só o apontava vira null; os totais se recontam.
# Objeto de card sem estado na resposta (o `pai` do quadro, as linhas de espera-dono) se
# confere pelo detalhe dele, um GET por id distinto.
_SO_FUNIL=0
_FUNIL_TERMOS=""
JQ_FUNIL='
def card_id: if ((.item // null) | type) == "number" then .item else .id end;
def ehcard: type == "object" and has("titulo") and ((card_id | type) == "number");
def temestado: has("estado") or has("estado_fase") or has("estado_mostrado") or has("estado_derivado");
def terminal($t; $ids):
  . as $o
  | if (($o.item // null) | type) == "number" then (($ids | index([$o.item])) != null)
    elif ($o.estado_derivado // null) != null then (($t | index([$o.estado_derivado])) != null)
    elif ($o | temestado) then ($o.estado_fase == "terminal" or $o.estado_natureza == "terminal"
                         or (($t | index([$o.estado // $o.estado_mostrado])) != null))
    else (($ids | index([$o.id])) != null) end;
def fora($t; $ids): ehcard and terminal($t; $ids);
def podar($t; $ids):
  walk(if type == "array" then map(select(fora($t; $ids) | not))
       elif type == "object" then with_entries(if ((.value | type) == "object") and (.value | fora($t; $ids)) then .value = null else . end)
       else . end);
def sem_inventario: if type == "object" then del(.inventario) else . end;
def podar_card($t; $ids):
  (if type == "object" then (.inventario // null) else null end) as $inv
  | sem_inventario | podar($t; $ids)
  | if $inv != null then .inventario = $inv else . end;
def recontar:
  (if type == "object" and has("itens") and has("total") and ((.itens | type) == "array") then .total = (.itens | length) else . end)
  | (if type == "object" and ((.do_dono // null) | type) == "object" and (.do_dono | has("total"))
     then .do_dono.total = ([.do_dono | to_entries[] | select(.key != "total") | .value | arrays | length] | add // 0) else . end)
  | (if type == "object" and ((.com_cadeiras // null) | type) == "object" and ((.com_cadeiras.cards // null) | type) == "array"
     then (if (.com_cadeiras | has("abertos")) then .com_cadeiras.abertos = ([.com_cadeiras.cards[].abertos[]?] | length) else . end)
          | (if (.com_cadeiras | has("parados")) then .com_cadeiras.parados = ([.com_cadeiras.cards[].abertos[]? | select(.parado == true)] | length) else . end)
     else . end);
'

# Os estados terminais: o que o registro marca com fase ou natureza terminal, mais a lista fixa
# que `listar` já usa (o registro pode ter retirado o estado e o card antigo ainda o carregar).
_funil_termos() {
  if [ -z "$_FUNIL_TERMOS" ]; then
    _FUNIL_TERMOS=$(_exec_curl_cru GET /registro 2>/dev/null | jq -c '
      [(if type == "array" then . else (.estados // []) end)[]?
       | select(.fase == "terminal" or .natureza == "terminal") | .estado]' 2>/dev/null) || _FUNIL_TERMOS=""
    [ -n "$_FUNIL_TERMOS" ] || _FUNIL_TERMOS='[]'
    _FUNIL_TERMOS=$(jq -c '. + ["entregue","recusada","cancelada","englobada","encerrada","resolvido","descartada"] | unique' <<<"$_FUNIL_TERMOS")
  fi
  printf '%s' "$_FUNIL_TERMOS"
}

_funil_recusa() { # _funil_recusa <json do card>
  local msg
  msg=$(printf '%s' "$1" | jq -r "$JQ_ROT"'
    "\(rot) está fora do funil (\(.estado_derivado // .estado // .estado_mostrado // "terminal")): card em estado terminal não aparece em leitura do verbo tarefas"' 2>/dev/null)
  [ -n "$msg" ] || msg="card fora do funil: card em estado terminal não aparece em leitura do verbo tarefas"
  printf '%s\n' "$msg" >&2
  return 1
}

# O card pedido é terminal? Recusa. $1 é o JSON do detalhe.
_funil_confere() {
  local j="$1" t; t=$(_funil_termos)
  local englobante; englobante=$(printf '%s' "$j" | jq -r 'if type == "object" and (.resolvido_de // null) != null then .id else empty end' 2>/dev/null || true)
  if [ -n "$englobante" ]; then
    local orig; orig=$(printf '%s' "$j" | jq -r '.resolvido_de')
    printf '#%s está fora do funil (englobada em #%s): card em estado terminal não aparece em leitura do verbo tarefas; leia #%s\n' "$orig" "$englobante" "$englobante" >&2
    return 1
  fi
  if printf '%s' "$j" | jq -e --argjson t "$t" "$JQ_FUNIL"'fora($t; [])' >/dev/null 2>&1; then
    _funil_recusa "$j"
    return 1
  fi
  return 0
}

# Poda a resposta de uma rota de leitura. $1 é o corpo.
_funil_podar() {
  local corpo="$1" t ids='[]' i ji
  t=$(_funil_termos)
  _funil_confere "$corpo" || return 1
  # Card citado sem estado na resposta: confere pelo detalhe dele.
  local sem_estado
  sem_estado=$(printf '%s' "$corpo" | jq -r "$JQ_FUNIL"'
    [sem_inventario | .. | objects | select(ehcard and ((((.item // null) | type) == "number") or (temestado | not))) | card_id] | unique | .[]' 2>/dev/null || true)
  for i in $sem_estado; do
    ji=$(_exec_curl_cru GET "/itens/$i" 2>/dev/null) || continue
    if printf '%s' "$ji" | jq -e --argjson t "$t" "$JQ_FUNIL"'(.resolvido_de // null) != null or fora($t; [])' >/dev/null 2>&1; then
      ids=$(jq -c --argjson n "$i" '. + [$n]' <<<"$ids")
    fi
  done
  printf '%s' "$corpo" | jq -c --argjson t "$t" --argjson ids "$ids" "$JQ_FUNIL"'podar_card($t; $ids) | recontar'
}

# O transporte que os atos chamam. Com o portão desligado, ou fora de GET, ou fora das rotas
# de card, é o transporte cru.
_exec_curl() { # _exec_curl MÉTODO /caminho [corpo_em_stdin=0|1]
  local metodo="$1" caminho="$2"
  if [ "$_SO_FUNIL" != 1 ] || [ "${metodo^^}" != GET ]; then
    _exec_curl_cru "$@"
    return
  fi
  local rota="${caminho%%\?*}"
  case "$rota" in
    /itens|/itens/*|/quadro|/quadro/*|/espera-dono|/espera-dono/*) ;;
    *) _exec_curl_cru "$@"; return ;;
  esac
  # Os termos se leem ANTES da rota pedida, e a rota pedida é a última chamada do caminho comum.
  _funil_termos >/dev/null
  if [[ "$rota" =~ ^/itens/([0-9]+)/ ]]; then
    local jc; jc=$(_exec_curl_cru GET "/itens/${BASH_REMATCH[1]}") || return 1
    _funil_confere "$jc" || return 1
  fi
  local corpo; corpo=$(_exec_curl_cru "$@") || return 1
  _funil_podar "$corpo"
}

# --- corpo: o rastreador guarda HTML, como o Vikunja guardava ---------------

# Os rotulos dos modelos (`tarefas modelo`, todos os niveis e o Plano) saem em negrito e cada
# campo abre o proprio paragrafo; as linhas que seguem o rotulo (listas, passos) ficam no
# paragrafo dele, separadas por <br>. A validacao da API tira as tags e acha o rotulo no
# comeco da linha, entao `<strong>Negocio:</strong>` segue valendo. Linha em branco ainda
# separa paragrafo.
# Card #3410: rotulo que NAO esta na lista cai dentro do paragrafo do rotulo anterior, e foi o
# que se viu no corpo servido do #3408 (Solucao, Pecas, Aberto e Produtos documentais colados em
# Medida e em Fora). A lista leva os rotulos do two-pager e as linhas fixas do comentario tipado.
# Card #3740: a lista ganhou os rotulos de decisao e de insumo (Decidiu, Ficha, Golden...), e URL
# solta http/https vira <a href>. E' a MESMA conversao de platafirma-rastreador@api/logica.py
# (R34): o algoritmo e a regex da URL sao os mesmos, sem aspa simples porque o Python mora
# dentro de aspas simples do shell (\x22 e \x27; a crase, \x60, tambem termina o endereco, e
# o sublinhado e o asterisco finais saem do link, como a pontuacao).
# DT 292: a conversão mora exclusivamente em `api/logica.py:para_html` (platafirma-rastreador),
# exposta por `POST /para-html`. O verbo não mantém cópia local do algoritmo.
para_html() {
  local texto resp html
  texto=$(cat)
  resp=$(jq -Rn --arg t "$texto" '{texto: $t}' | envia POST /para-html) \
    || { echo "erro ao converter corpo na API (POST /para-html no rastreador)" >&2; return 1; }
  html=$(printf '%s' "$resp" | jq -r '.html // empty' 2>/dev/null)
  if [ -z "$html" ] && [ -n "$(printf '%s' "$texto" | tr -d '[:space:]')" ]; then
    echo "resposta invalida de POST /para-html no rastreador" >&2
    return 1
  fi
  printf '%s\n' "$html"
}

# Card #4110: o trecho de `editar --trecho`. O corpo gravado é HTML (`para_html`, acima) e o
# trecho casa contra ele byte a byte: o texto do trecho recebe o MESMO escape do corpo inteiro
# (`html.escape`) e a mesma quebra — linha em branco fecha parágrafo, quebra simples é <br>.
# Rótulo em negrito e URL em link NÃO se convertem aqui: trecho que cruza um deles não casa e a
# API recusa dizendo quantas vezes ele ocorreu; `--bruto` manda o trecho como está.
trecho_html() {
  FRAG="$1" python3 -c 'import html,os,re
t = html.escape(os.environ["FRAG"].replace("\r\n", "\n"))
print(re.sub(r"\n{2,}", "</p><p>", t).replace("\n", "<br>"), end="")'
}

# DT 783: quando um servidor sem resolução de HTML recusa `antes` com «ocorre 0 vezes»,
# resolve `antes` e `depois` (como `tarefas ler` exibe: listas `1. `/`  - `, tags inline
# `<code>`/`<strong>` omitidas, « » e …) contra o `.descricao` do item e devolve o par HTML.
_resolve_trecho_no_corpo() { # _resolve_trecho_no_corpo <json_item> <antes> <depois>
  ITEM_J="$1" ANTES_RAW="$2" DEPOIS_RAW="$3" python3 -c '
import html, json, os, re, sys

corpo = (json.loads(os.environ["ITEM_J"]).get("descricao") or "")
antes_txt = os.environ["ANTES_RAW"].replace("\r\n", "\n")
depois_txt = os.environ["DEPOIS_RAW"].replace("\r\n", "\n")
if not corpo or not antes_txt.strip():
    sys.exit(1)

TAG_INLINE = r"(?:</?(?:code|strong|em|a|span|b|i)(?:\s[^>]*)?>)*"
TAG_ABRE = r"(?:<(?:code|strong|em|a|span|b|i)(?:\s[^>]*)?>)*"
TAG_FECHA = r"(?:</(?:code|strong|em|a|span|b|i)>)*"
MARC_RE = re.compile(r"^(\s*(?:\d+\.|[-*])\s+)(.*)$")

def tok_re(tok):
    if tok.isspace():
        return r"(?:\s|&nbsp;)+"
    mapa = {"&": r"(?:&amp;|&)", "<": r"(?:&lt;|<)", ">": r"(?:&gt;|>)",
            "\"": r"(?:&quot;|&#34;|\")", "\x27": r"(?:&#x27;|&#39;|\x27)"}
    return "".join(mapa.get(c, re.escape(c)) for c in tok)

def linha_re(s):
    toks = re.findall(r"\s+|\w+|[^\w\s]", s)
    return f"{TAG_ABRE}{TAG_INLINE.join(tok_re(t) for t in toks)}{TAG_FECHA}" if toks else ""

linhas = [l for l in antes_txt.split("\n") if l != ""]
if not linhas:
    sys.exit(1)
partes, marcs = [], []
for idx, l in enumerate(linhas):
    m = MARC_RE.match(l)
    if m:
        mc, r = m.group(1), m.group(2)
        marcs.append((mc, r))
        pm, pr = linha_re(mc), linha_re(r)
        partes.append(f"(?:(?P<_li0><li(?:\\s[^>]*)?>\\s*)|(?:{pm})){pr}" if idx == 0 else f"(?:<li(?:\\s[^>]*)?>\\s*|{pm}){pr}")
    else:
        marcs.append(("", l))
        partes.append(linha_re(l))

sep_re = r"\s*(?:<br\s*/?>|</?(?:p|li|ol|ul|blockquote|h[1-6]|pre)(?:\s[^>]*)?>|\s)+\s*"
achados = list(re.finditer(sep_re.join(partes), corpo))
if len(achados) != 1:
    sys.exit(1)
m = achados[0]
li0 = m.groupdict().get("_li0") or ""
em_li = bool(li0)
ini, fim = m.start() + len(li0), m.end()
trecho_h = corpo[ini:fim]
if corpo.count(trecho_h) != 1:
    sys.exit(1)
antes_base = "\n".join(r if em_li else (mc + r) for mc, r in marcs)
linhas_dep = [l for l in depois_txt.split("\n") if l != ""] if depois_txt else []
if em_li and linhas_dep:
    linhas_dep_limpas = [MARC_RE.match(l).group(2) if MARC_RE.match(l) else l for l in linhas_dep]
    depois_base = "\n".join(linhas_dep_limpas)
else:
    linhas_dep_limpas = linhas_dep
    depois_base = depois_txt

if depois_txt == "":
    depois_h = ""
elif len(linhas) == 1 and len(linhas_dep) == 1 and depois_base.startswith(antes_base):
    depois_h = trecho_h + html.escape(depois_base[len(antes_base):])
else:
    depois_h = "<br>".join(html.escape(l) for l in linhas_dep_limpas)
    for mt in re.finditer(r"<(code|strong|em)(\s[^>]*)?>([^<>]+)</\1>", trecho_h):
        tg, at, mi = mt.group(1), mt.group(2) or "", mt.group(3)
        bl = f"<{tg}{at}>{mi}</{tg}>"
        if bl not in depois_h:
            depois_h = re.sub(rf"(?<![</>a-zA-Z0-9_]){re.escape(mi)}(?![</>a-zA-Z0-9_])", bl, depois_h, count=1)

print(json.dumps({"antes": trecho_h, "depois": depois_h}))
'
}

para_texto() {
  python3 -c '
import html, re, sys

texto = sys.stdin.read()
pilha = []

def _sub(m):
    tag = m.group(0)
    low = tag.lower()
    if low == "</p>" or re.fullmatch(r"<br\s*/?>", low) or re.fullmatch(r"</h[0-9]>", low) or low == "</pre>":
        return "\n"
    if low == "</li>":
        return "\n"
    if re.fullmatch(r"<ol(?:\s[^>]*)?>", low):
        sm = re.search(r"\bstart=[\"\x27]?(\d+)", low)
        pilha.append(["ol", int(sm.group(1)) if sm else 1])
        return ""
    if low == "</ol>":
        for i in range(len(pilha) - 1, -1, -1):
            if pilha[i][0] == "ol":
                del pilha[i:]
                break
        return ""
    if re.fullmatch(r"<ul(?:\s[^>]*)?>", low):
        pilha.append(["ul", 0])
        return ""
    if low == "</ul>":
        for i in range(len(pilha) - 1, -1, -1):
            if pilha[i][0] == "ul":
                del pilha[i:]
                break
        return ""
    if re.fullmatch(r"<li(?:\s[^>]*)?>", low):
        if pilha and pilha[-1][0] == "ol":
            n = pilha[-1][1]
            pilha[-1][1] += 1
            indent = "  " * (len(pilha) - 1)
            return f"{indent}{n}. "
        indent = "  " * max(1, len(pilha))
        return f"{indent}- "
    return ""

saida = re.sub(r"<[^>]*>", _sub, texto)
saida = html.unescape(saida)
saida = re.sub(r"\n{3,}", "\n\n", saida)
print(saida, end="")
'
}

# Argumento numérico solto na posição do antigo <projeto>: ignora e avisa. Existe para que
# `tarefas listar 46` e `tarefas criar 46 "título"` — que estão escritos em manifesto, em
# card e na cabeça de toda cadeira — não quebrem no dia da virada.
descarta_projeto() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) echo "aviso: '$1' era projeto do Vikunja e não existe mais; ignorado." >&2; return 0 ;;
  esac
}

# --- filtros ----------------------------------------------------------------

# A API filtra por cadeira, estado e nível. "Aberto" NÃO é filtro dela: é a fase do estado,
# que vem em cada item (`estado_fase`). Peneirar aqui e não lá é o certo — inventar um
# filtro `aberto=` no servidor duplicaria a régua de fase em dois lugares.
monta_query() { # monta_query "$@" -> ecoa a query string
  local q=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --cadeira)
        # A LISTA DE CADEIRAS NÃO MORA AQUI (#2856 linha 125): a API a conhece e recusa o nome
        # desconhecido com a própria mensagem. Uma cópia no verbo ficava para trás a cada
        # cadeira nova (engenharia, direito e inteligência foram recusadas por isso).
        local cad="${2:?--cadeira pede o nome da cadeira}"
        q="$q&cadeira=$cad"; shift 2 ;;
      --estado)
        # A LISTA DE ESTADOS NÃO MORA AQUI (card #3526, R10 da spec tarefas): estado novo entra no
        # registro por INSERT (`despriorizada` entrou pela 016), e uma cópia no verbo recusaria o
        # estado que a API já serve. A API recusa o desconhecido com a própria mensagem, que
        # traz a lista dos válidos.
        local est="${2:?--estado pede o nome do estado}"
        q="$q&estado=$est"; shift 2 ;;
      # ORIGINAÇÃO É O `tipo_demanda` DO ITEM (card #3521): o verbo usa a palavra da spec e a API,
      # a coluna. O valor fora do registro sai 422 por lá, com os válidos; a lista não está aqui.
      --originacao)
        local orig="${2:?--originacao pede negocio, tecnico ou incidente}"
        q="$q&tipo_demanda=$orig"; shift 2 ;;
      --executor)
        local exe="${2:?--executor pede o nome da cadeira}"
        q="$q&executor=$exe"; shift 2 ;;
      --pai)
        local p_id; p_id=$(so_id "${2:?--pai pede o id do pai}")
        q="$q&pai=$p_id"; shift 2 ;;
      --paradas) shift ;;
      --nivel)
        local n
        case "${2:-}" in
          épico|epico|0) n=0 ;;
          feature|1)     n=1 ;;
          story|2)       n=2 ;;
          task|3)        n=3 ;;
          ideia|4)       n=4 ;;
          *) echo "nível desconhecido: ${2:-} (épico, feature, story, task, ideia)" >&2; exit 2 ;;
        esac
        q="$q&nivel=$n"; shift 2 ;;
      --campos) [ $# -ge 2 ] && [ -n "$2" ] || { echo "--campos exige lista" >&2; exit 2; }; shift 2 ;;
      --ultimos) [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]] || { echo "--ultimos exige número" >&2; exit 2; }; shift 2 ;;
      --json)    shift ;;
      *)
        echo "opção desconhecida: $1" >&2
        echo "uso: tarefas listar|listar-tudo [--cadeira <c>] [--estado <e>] [--nivel <n>] [--originacao <o>] [--executor <c>] [--paradas] [--json] [--campos <lista>] [--ultimos <n>]" >&2
        exit 2 ;;
    esac
  done
  printf '%s' "${q:+${q:1}}"
}

_tem_json() { local a; for a in "$@"; do [ "$a" = "--json" ] && return 0; done; return 1; }
_tem_flag() { local f="$1" a; shift; for a in "$@"; do [ "$a" = "$f" ] && return 0; done; return 1; }

# A task sai como `t<n>` e leva a story no fim da linha, porque a listagem não tem o contexto que a
# leitura da story dá (#4250); o card sai pelo id, como sempre.
linhas() { # id (t<n> na task), marca de terminal, título
  jq -r "$JQ_ROT"'
    def da_story: if ((.chave // "") | test("\\.t[0-9]+$")) then " · story #\(.pai)" else "" end;
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue", "recusada", "cancelada", "englobada", "encerrada", "resolvido"]
     | unique) as $term
    | .itens[]
    | . as $it
    | "\($it | rotn)\t\(if ($it.estado_derivado != null and ($term | index([$it.estado_derivado]) != null)) or ($it.estado_derivado == null and $it.estado_fase == "terminal") then "x" else " " end)\t\($it.titulo)\($it | da_story)"'
}

linhas_com_data() { # id (t<n> na task), marca de terminal, data (AAAA-MM-DD), título
  jq -r "$JQ_ROT"'
    def da_story: if ((.chave // "") | test("\\.t[0-9]+$")) then " · story #\(.pai)" else "" end;
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue", "recusada", "cancelada", "englobada", "encerrada", "resolvido"]
     | unique) as $term
    | .itens[]
    | . as $it
    | "\($it | rotn)\t\(if ($it.estado_derivado != null and ($term | index([$it.estado_derivado]) != null)) or ($it.estado_derivado == null and $it.estado_fase == "terminal") then "x" else " " end)\t\(($it.ultimo_movimento // $it.criado_em // "")[0:10])\t\($it.titulo)\($it | da_story)"'
}

# QUADRO (R35 da spec tarefas, card #3619): `--quadro` bypassa `/itens` e vai direto à
# projeção pronta do rastreador (`GET /quadro/{tipo}`) — o verbo não guarda lista de estados
# de quadro nenhuma (Travas do card); quem confere o `tipo` é a API, e a recusa dela chega
# como vier. Sem --paradas, pede `?dormentes=excluir` e, se algo saiu, diz quantas.
listar_quadro() {
  local tipo="" paradas=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --quadro)  tipo="${2:?--quadro pede discovery ou delivery}"; shift 2 ;;
      --paradas) paradas=1; shift ;;
      --json)    json=1; shift ;;
      *) echo "tarefas listar --quadro: opção desconhecida: $1 (só --paradas e --json)" >&2; exit 2 ;;
    esac
  done
  local q=""
  [ "$paradas" -eq 1 ] || q="?dormentes=excluir"
  local corpo; corpo=$(busca GET "/quadro/$tipo$q") || return 1
  if [ "$json" -eq 1 ]; then
    printf '%s\n' "$corpo"
    return 0
  fi
  printf '%s' "$corpo" | jq -r "$JQ_ROT"'.itens[] | "\(rot)\t\(.estado_mostrado)\t\(.cadeira // "—")\t\(.executor // "—")\t\(.titulo)"'
  local escondidas; escondidas=$(printf '%s' "$corpo" | jq -r '.dormentes_excluidos // 0')
  [ "$escondidas" != 0 ] && printf '%s dormente(s) escondida(s)\n' "$escondidas"
  return 0
}

_projetar_campos() {
  local campos="" a
  while [ $# -gt 0 ]; do
    case "$1" in
      --campos) [ $# -ge 2 ] && [ -n "$2" ] || { echo "--campos exige lista separada por vírgula" >&2; return 2; }; campos="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ -z "$campos" ]; then cat; return; fi
  jq --arg campos "$campos" '
    ($campos | split(",")) as $ks
    | if any($ks[]; test("^[a-z_]+$") | not) then error("campo inválido") else . end
    | .itens |= map(. as $i | reduce $ks[] as $k ({}; .[$k] = $i[$k]))'
}

listar() { # listar [filtros] [--paradas] [--json] [--quadro discovery|delivery]   — só os abertos
  _tem_flag --quadro "$@" && { listar_quadro "$@"; return; }
  local q; q=$(monta_query "$@")
  # AS PARADAS FICAM DE FORA (card #3526, R25): `despriorizada` é aberta (fase funil), mas é o que
  # ninguém está fazendo, e na fila de trabalho ela atrapalha. Entra com `--paradas`, ou quando o
  # estado é pedido pelo nome. A ordem da listagem é a do posto, que a API entrega pronta.
  local ocultar=true
  _tem_flag --paradas "$@" && ocultar=false
  case "&$q&" in *"&estado=despriorizada&"*) ocultar=false ;; esac
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  corpo=$(printf '%s' "$corpo" | jq --argjson ocultar "$ocultar" '
    ([.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]
     + ["entregue", "recusada", "cancelada", "englobada", "encerrada", "resolvido"]
     | unique) as $term
    | {
        itens: [
          .itens[]
          | . as $it
          | select(
              if $it.estado_derivado != null
              then ($term | index([$it.estado_derivado]) == null)
              else ($it.estado_fase != "terminal")
              end
            )
          | select(($ocultar | not) or ($it.estado != "despriorizada"))
        ],
        estados,
        total
      }
    | .total = (.itens | length)')
  if _tem_json "$@" || _tem_flag --campos "$@"; then printf '%s\n' "$corpo" | _projetar_campos "$@"; else printf '%s' "$corpo" | linhas; fi
}

listar_tudo() { # listar_tudo [filtros] [--json] [--ultimos <n>]
  local ultimos=""
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --ultimos)
        [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]] || { echo "--ultimos exige número" >&2; exit 2; }
        ultimos="$2"
        shift 2
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  local q; q=$(monta_query "${args[@]}")
  if [ -n "$ultimos" ]; then
    q="${q:+${q}&}limite_terminal=${ultimos}"
  fi
  local corpo; corpo=$(busca GET "/itens${q:+?$q}")
  if [ -n "$ultimos" ]; then
    corpo=$(printf '%s' "$corpo" | jq --argjson n "$ultimos" '
      .itens |= (sort_by(.ultimo_movimento // .criado_em // "") | reverse | .[0:$n])
      | .total = (.itens | length)')
  fi
  if _tem_json "${args[@]}" || _tem_flag --campos "${args[@]}"; then
    printf '%s\n' "$corpo" | _projetar_campos "${args[@]}"
  else
    if [ -n "$ultimos" ]; then
      printf '%s' "$corpo" | linhas_com_data
    else
      printf '%s' "$corpo" | linhas
    fi
  fi
}

estados() {
  busca GET /registro | jq -r '(.estados // .)[] | select(.retirado != true) | "\(.estado)\t\(.fase)\t\(.nome)"'
}

# Estados de fase ou natureza terminal lidos do registro (card #3750).
_estados_terminais() {
  busca GET /registro | jq -c '((if type == "array" then . else (.estados // []) end) | [.[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado] | unique)' 2>/dev/null || echo '[]'
}

# --- item -------------------------------------------------------------------

# `#N` e `N` são o MESMO número: o rastreador tem um identificador só por item, e é essa a
# razão de o Vikunja ter saído. O `#` é aceito porque a fila e os cards o escrevem.
#
# A TASK TEM CHAVE POR STORY (card #4245): `<story>.t<n>`, como `4216.t1`. O rastreador guarda o
# id dela numa sequência própria, que nenhuma superfície mostra; aqui a chave que a pessoa
# digita vira o id que as rotas endereçam, por `GET /itens/chave/<chave>`. Chave que não existe
# sai como a recusa do rastreador (404), e não como id inventado.
# DT 690: aceita `<story>-t<n>` além de `<story>.t<n>`, e resolve `t<n>` (o id curto que `criar`
# e `sub` devolvem) pelo `--pai`/última story operada na sessão ou pelas tasks abertas em `/itens`.
_arq_pai_sessao() {
  printf '/tmp/pf-tarefas-pai-%s' "$(printf '%s' "${PF_SESSAO:-}|${BASE}" | sha256sum | cut -c1-16)"
}

_lembra_pai() {
  local p="${1:-}"
  [[ "$p" =~ ^[0-9]+$ ]] && printf '%s' "$p" > "$(_arq_pai_sessao)" 2>/dev/null || true
}

so_id() {
  local a="${1#\#}"
  if [[ "$a" =~ ^[EeFfSs]?#?([0-9]+)[.-][tT]([0-9]+)$ ]]; then
    a="${BASH_REMATCH[1]}.t${BASH_REMATCH[2]}"
  elif [[ "$a" =~ ^[EeFfSs]#?([0-9]+)$ ]]; then
    a="${BASH_REMATCH[1]}"
  elif [[ "$a" =~ ^[tT]([0-9]+)$ ]]; then
    local tn="${BASH_REMATCH[1]}" p_ctx="${TAREFAS_PAI:-}" r="" id_res=""
    if [ -n "$p_ctx" ]; then
      a="${p_ctx}.t${tn}"
    else
      local arq_p; arq_p=$(_arq_pai_sessao)
      [ -f "$arq_p" ] && p_ctx=$(cat "$arq_p" 2>/dev/null || true)
      if [[ "$p_ctx" =~ ^[0-9]+$ ]]; then
        if r=$(_exec_curl GET "$(_apipath "/itens/chave/${p_ctx}.t${tn}")" 0 2>/dev/null); then
          id_res=$(printf '%s' "$r" | jq -r '.id // empty' 2>/dev/null || true)
          if [ -n "$id_res" ]; then
            printf '%s' "$id_res"
            return 0
          fi
        fi
      fi
      local lj; lj=$(_exec_curl GET "$(_apipath "/itens?nivel=3")" 0 2>/dev/null || true)
      if [ -n "$lj" ]; then
        id_res=$(printf '%s' "$lj" | jq -r --arg tn "$tn" --arg q "$QUEM" '
          [(.itens // [])[] | select((.chave // "") | test("^[0-9]+\\.t" + $tn + "$"))] as $all
          | (if ($q != "") then [$all[] | select(.executor == $q or .cadeira == $q)] else [] end) as $por_q
          | (if ($por_q | length) > 0 then $por_q else $all end) as $cand
          | [$cand[] | select([(.ancestrais // [])[]? | select(.nivel == 2 and (.estado == "em-execucao" or .estado == "em-refinamento-tecnico"))] | length > 0)] as $ativos
          | (if ($ativos | length) > 0 then $ativos else $cand end)
          | sort_by(.ultimo_movimento // .criado_em // "", .id) | last | .id // empty
        ' 2>/dev/null || true)
        if [ -n "$id_res" ]; then
          printf '%s' "$id_res"
          return 0
        fi
      fi
      a="${p_ctx:+${p_ctx}.}t${tn}"
    fi
  fi
  case "$a" in
    [0-9]*.t[0-9]*|t[0-9]*)
      [[ "$a" =~ ^([0-9]+)\.t[0-9]+$ ]] && _lembra_pai "${BASH_REMATCH[1]}"
      local r; r=$(busca GET "/itens/chave/$a") || return 1
      printf '%s' "$r" | jq -r '.id' ;;
    *) printf '%s' "$a" ;;
  esac
}

# O NOME QUE SE EXIBE DA TASK É SÓ `t<n>` (ordem do dono, 13/11/2026, card #4245): a task é sempre
# filha de uma story, que o contexto já diz, e `<story>.t<n>` é o que se DIGITA (`so_id`) e o que o
# banco guarda. `rot` é a forma de listagem (`#id` no card, `t<n>` na task); `rotn`, a do relato
# (`id` sem sustenido no card, `t<n>` na task). Quem exibe item prefixa o programa jq com isto.
#
# INCIDENTE #4250 (13/11/2026): fora do banco, a task se chama SÓ `t<n>`, em toda saída do verbo,
# e nenhuma linha imprime o id dela (ordem do dono: «não é pra voltar esse número inteiro em nenhuma
# interface»). Onde a API devolve o item sem `chave` (o bloqueador de uma task, a filha movida junto,
# o apagado), `rotx($m)` acha a chave num mapa id → chave montado do detalhe que já está na mão; e
# onde só se tem o id (o argumento resolvido por `so_id`, o item de um comentário), `rotulo_de`
# pergunta ao rastreador. `mapa_chaves` monta o mapa a partir do detalhe de um item e das filhas dele.
JQ_ROT='def rot: if ((.chave // "") | test("\\.t[0-9]+$")) then (.chave | sub("^[0-9]+\\."; "")) else "#\(.id)" end;
def rotn: if ((.chave // "") | test("\\.t[0-9]+$")) then (.chave | sub("^[0-9]+\\."; "")) else (.id | tostring) end;
def rotk($k): if (($k // "") | tostring | test("\\.t[0-9]+$")) then ($k | tostring | sub("^[0-9]+\\."; "")) else null end;
def rotx($m): (if type == "object" then . else {id: .} end) as $o
  | (rotk($o.chave // ($m[($o.id | tostring)])) // "#\($o.id)");
def mapa_chaves: ((reduce ((.filhas // [])[], (.bloqueia // [])[], (.bloqueado_por // [])[]) as $f
  ({}; if ($f | type) == "object" and $f.chave then .[($f.id | tostring)] = $f.chave else . end))
  + (if .id and .chave then {(.id | tostring): .chave} else {} end));
'

# O nome de exibição de um item pelo id (#4250): `t<n>` na task, `#id` no card; com `n` no segundo
# argumento, o card sai sem sustenido (a forma do relato, como `rotn`). Sem resposta do rastreador,
# devolve o que recebeu, como foi digitado.
rotulo_de() { # rotulo_de <id> [n]
  local j
  if j=$(busca GET "/itens/$1" 2>/dev/null) && [ -n "$j" ]; then
    if [ -n "${2:-}" ]; then printf '%s' "$j" | jq -r "$JQ_ROT"'rotn'
    else printf '%s' "$j" | jq -r "$JQ_ROT"'rot'; fi
  else
    if [ -n "${2:-}" ]; then printf '%s' "$1"; else printf '#%s' "$1"; fi
  fi
}

# O mapa id → chave de um item e da vizinhança dele (filhas e vínculos), para as saídas que recebem
# o item sem chave. Falha vira mapa vazio: o pior caso é o sustenido do card, nunca uma recusa.
mapa_de() { # mapa_de <id>
  local j m
  j=$(busca GET "/itens/$1" 2>/dev/null) || { printf '{}'; return 0; }
  m=$(printf '%s' "$j" | jq -c "$JQ_ROT"'mapa_chaves' 2>/dev/null) || m='{}'
  [ -n "$m" ] || m='{}'
  printf '%s' "$m"
}

# CARD #347: a leitura mostra quem falta assinar, e SEM chamada extra — o detalhe do item
# já devolve `sign_offs` desde o #466. Enquanto não estava aqui, a informação existia na API
# e não existia para quem lê pelo terminal, que é a superfície que a cadeira tem.
#
# PENDENTE PRIMEIRO, e a ordem é o ponto: é ele que segura o item em `Em parecer`, e é a
# única linha sobre a qual alguém pode agir agora. Respondido é registro; pendente é dívida.
ler() {
  local id="" so_cabecalho=0 direto=0 todas_filhas=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --cabecalho) so_cabecalho=1; shift ;;
      --direto) direto=1; shift ;;
      --todas-filhas) todas_filhas=1; shift ;;
      *)
        if [ -z "$id" ]; then
          id=$(so_id "$1")
          shift
        else
          echo "tarefas ler: argumento desconhecido: $1" >&2
          exit 2
        fi
        ;;
    esac
  done
  [ -n "$id" ] || { echo "uso: tarefas ler <id> [--cabecalho] [--direto] [--todas-filhas]" >&2; exit 2; }
  # UMA LEITURA SERVE A TUDO (card #3526): o detalhe do item já traz o vínculo (`bloqueia`,
  # `bloqueado_por`, #3523) e, quando o item tem filha, `filhas` em ordem de dependência. Antes as
  # filhas vinham de uma segunda chamada que puxava o board inteiro e peneirava por pai.
  local q=""
  [ "$direto" -eq 1 ] && q="?direto=1"
  local j; j=$(busca GET "/itens/$id$q") || return 1
  local p_lembrar; p_lembrar=$(printf '%s' "$j" | jq -r 'if .nivel == 2 then .id elif .nivel == 3 then .pai else empty end' 2>/dev/null || true)
  [ -n "$p_lembrar" ] && _lembra_pai "$p_lembrar"
  local term; term=$(_estados_terminais) || term='[]'
  if [ "$so_cabecalho" -eq 1 ]; then
    printf '%s' "$j" | jq -r --argjson term "$term" "$JQ_ROT"'
      "# \(.titulo)",
      "\(rot) · \(.nivel_nome) · "
      + (if .estado_derivado != null
         then "\(.estado_derivado) [derivado; cru: \(.estado_nome) (\(.estado_fase))]"
         else "\(.estado_nome) (\(.estado_fase))"
         end)
      + " · cadeira: \(.cadeira // "—")"
      + (if .tipo_demanda then " · originação: \(.tipo_demanda)" else "" end)
      + (if .executor then " · executor: \(.executor)" else "" end)
      + (if (.ancestrais|length) > 0 then "\n  em: " + ([.ancestrais[] | "#\(.id) \(.titulo)"] | join(" > ")) else "" end)
      + (if .resolvido_de then "\n  resolvido de: #\(.resolvido_de) (englobado neste item; use --direto para ler o original)" else "" end)
      + (if ((.bloqueia // []) | length) > 0
         then "\n  bloqueia: " + ([.bloqueia[] | "\(rot) (\(.estado))"] | join(", ")) else "" end)
      + (if ((.bloqueado_por // []) | length) > 0
         then "\n  bloqueado por: " + ([.bloqueado_por[] | "\(rot) (\(.estado))"] | join(", ")) else "" end)
      + (([(.bloqueado_por // [])[] | select(.estado as $e | ($term | index([$e])) == null)] | if length > 0
         then "\n  travada por: " + ([.[] | "\(rot) (\(.estado))"] | join(", ")) else "" end))' | para_texto
    return 0
  fi
  printf '%s' "$j" | jq -r --argjson term "$term" "$JQ_ROT"'
    "# \(.titulo)",
    "\(rot) · \(.nivel_nome) · "
    + (if .estado_derivado != null
       then "\(.estado_derivado) [derivado; cru: \(.estado_nome) (\(.estado_fase))]"
       else "\(.estado_nome) (\(.estado_fase))"
       end)
    + " · cadeira: \(.cadeira // "—")"
    + (if .tipo_demanda then " · originação: \(.tipo_demanda)" else "" end)
    + (if .executor then " · executor: \(.executor)" else "" end)
    + (if (.ancestrais|length) > 0 then "\n  em: " + ([.ancestrais[] | "#\(.id) \(.titulo)"] | join(" > ")) else "" end)
    + (if .resolvido_de then "\n  resolvido de: #\(.resolvido_de) (englobado neste item; use --direto para ler o original)" else "" end)
    + (if ((.bloqueia // []) | length) > 0
       then "\n  bloqueia: " + ([.bloqueia[] | "\(rot) (\(.estado))"] | join(", ")) else "" end)
    + (if ((.bloqueado_por // []) | length) > 0
       then "\n  bloqueado por: " + ([.bloqueado_por[] | "\(rot) (\(.estado))"] | join(", ")) else "" end)
    + (([(.bloqueado_por // [])[] | select(.estado as $e | ($term | index([$e])) == null)] | if length > 0
       then "\n  travada por: " + ([.[] | "\(rot) (\(.estado))"] | join(", ")) else "" end)),
    "",
    (if ((.sign_offs // []) | length) > 0 then
       (["sign-off:"]
        + [.sign_offs[] | select(.decisao == null) | "  PENDENTE  \(.aprovador)"]
        + [.sign_offs[] | select(.decisao != null)
           | "  \(.decisao | ascii_upcase)  \(.aprovador)"
             + (if .texto then " — \(.texto)" else "" end)]
        + [""])
       | join("\n")
     else empty end),
    (.descricao // "")' | para_texto
  # Story #4317 (feature 4314): a feature mostra a linha das contagens do inventário, sem os
  # itens, e a story mostra as regras que cumpre, inteiras, e os produtos documentais que muda.
  _inventario_na_leitura "$j"
  # FILHAS — card lido sem ver o que pende embaixo não serve para repriorizar:
  # ler um épico/feature e não enxergar a subárvore era o furo. Puxa os filhos
  # diretos, um por linha (id · estado · cadeira · título), na ordem de dependência que a API
  # já entrega em `.filhas` (card #3523), com a travada marcada. SÓ ABERTAS: terminal
  # (entregue, englobada, etc.) fica fora — a mesma régua de fase que `listar` aplica, pela
  # mesma razão. Filha entregue é auditoria, e auditoria é `listar-tudo`, não leitura de card.
  # Card #4223 (R37): as filhas de uma STORY são as tasks dela, e saem todas, na ordem, com o
  # estado de cada uma (`tasks_do_json`); as de feature e de épico seguem só as abertas.
  if [ "$(printf '%s' "$j" | jq -r '.nivel')" = "2" ]; then
    local tasks; tasks=$(tasks_do_json "$j" "$term")
    if [ -n "$tasks" ]; then printf '\n%s\n' "$tasks"; fi
  elif [ "$todas_filhas" -eq 1 ]; then
    local filhas; filhas=$(filhas_do_json "$j" --todas)
    if [ -n "$filhas" ]; then printf '\nfilhas (todas):\n%s\n' "$filhas"; fi
  else
    local filhas; filhas=$(filhas_do_json "$j")
    if [ -n "$filhas" ]; then printf '\nfilhas (abertas):\n%s\n' "$filhas"; fi
  fi
  # Sem filha aberta o `[ -n ]` acima devolve 1 e, sendo o ultimo comando da funcao sob
  # `set -e`, o verbo saia com exit 1 DEPOIS de imprimir o card inteiro. Medido em
  # 11/09/2026: 24 dos 33 "erros" de tarefas no ops log eram isto (metrica casos).
  return 0
}

# Filhas DIRETAS ainda abertas, uma por linha (id · estado · cadeira · título), lidas do campo
# `filhas` do detalhe do pai (JSON em $1): a API as entrega em ordem de dependência, com o posto
# desempatando, e `travada` quando algum bloqueador ainda não fechou (card #3523). Compartilhada
# por `ler` e por `mover`: é a MESMA peneira nas duas, para que a linha `PARCIAL:` do relato
# (arq:0095) e a leitura do card nunca discordem sobre o que pende. O que é terminal sai do
# registro (um GET pequeno), e não do board inteiro, que é o que esta função puxava antes.
filhas_do_json() {
  local termos="[]" incluir_todas=0
  if [ "${2:-}" = "--todas" ]; then
    incluir_todas=1
  else
    termos=$(busca GET /registro | jq -c '[.estados[]? | select(.fase == "terminal" or .natureza == "terminal") | .estado]') || return 1
  fi
  printf '%s' "$1" | jq -r --argjson term "$termos" --argjson todas "$incluir_todas" "$JQ_ROT"'
    ($term + ["entregue","recusada","cancelada","englobada","encerrada","resolvido"] | unique) as $t
    | mapa_chaves as $m
    | .filhas[]?
    | . as $f
    | select($todas == 1 or ($t | index([$f.estado_derivado // $f.estado]) == null))
    | "  \($f | rot)\t\($f.estado)\t\($f.cadeira // "—")\t\($f.titulo)"
      + (if $f.travada
         then "  [travada por " + ([($f.bloqueada_por // [])[] | rotx($m)] | join(", ")) + "]"
         else "" end)'
}

# AS TASKS DA STORY (card #4223, R37 da spec tarefas): a task é o passo da story, filha direta
# dela, e a leitura da story as traz TODAS, abertas e concluídas, na ordem que a API entrega em
# `.filhas` (dependência, com o posto desempatando), cada uma com o estado. Não há peneira de
# terminal aqui: ao contrário das filhas de feature e de épico, o que a cadeira que retoma a story
# precisa ver é onde a fita anterior parou, e isso está nas concluídas também. $1 é o JSON da
# story, $2 a lista de estados terminais (a mesma de `ler`).
tasks_do_json() {
  printf '%s' "$1" | jq -r --argjson term "${2:-[]}" "$JQ_ROT"'
    def aberta: (.estado as $e | ($term | index([$e])) == null);
    def rotulo: if aberta then "aberta" elif .estado == "entregue" then "concluída" else .estado end;
    mapa_chaves as $m
    | [.filhas[]?] as $ts
    | if ($ts | length) == 0 then empty else
        "tasks (\([$ts[] | select(aberta)] | length) abertas de \($ts | length)):",
        ($ts | to_entries[] | .key as $i | .value
           | "  \($i + 1). \(rot)\t\(rotulo)\t\(.estado)\t\(.titulo)"
             + (if .travada
                then "  [travada por " + ([(.bloqueada_por // [])[] | rotx($m)] | join(", ")) + "]"
                else "" end))
      end'
}

# ENTREGA É DERIVADA DO PAI (arq:0095, dono 02/09/2026). Item executável movido devolve, no
# MESMO retorno, o estado derivado do pai e as irmãs abertas — é a âncora que a linha
# `PARCIAL:`/`ENTREGA:` do relato cola. Sem isto a forma exigiria segunda chamada, e regra
# que depende de segunda chamada morre como o bullet morreu (3 reincidências pós-b888bcb).
# Medido em 02/09/2026: 12 pais com filhas mistas no board, 10 com derivado `captada` —
# a story fechava, o relato dizia "entregue", e a frente restante nem lapidada estava.
pai_e_irmas() { # pai_e_irmas <id-do-pai>
  local pai; pai=$(so_id "$1")
  local jp; jp=$(busca GET "/itens/$pai") || return 0
  printf '%s' "$jp" | jq -r '
    "  pai #\(.id) [\(.nivel_nome)]: "
    + (if .estado_derivado != null then "\(.estado_derivado) [derivado]" else .estado_nome end)
    + " — \(.titulo)"'
  local abertas; abertas=$(filhas_do_json "$jp")
  if [ -n "$abertas" ]; then
    printf '  abertas no pai (entrega de negócio NÃO fechou):\n%s\n' "$abertas"
  else
    printf '  nenhuma filha aberta no pai — conferência da gestão estratégica ou da cadeira dona, depois o dono dá entregue\n'
  fi
}

# SIGN-OFF PELO VERBO — card #347. A rota existia desde o #466 e não tinha verbo, e a
# consequência é a que o card nomeia: `org:0019` manda claudinho-dados ASSINAR emenda de
# modelo, e assinar dependia de alguém lembrar de montar o JSON na mão. Regra que depende de
# lembrança é regra morta — é o mesmo defeito que o dono apontou no #348 sobre `tarefas
# mover`.
#
# PENDENTE É O CASO COMUM, e por isso `--decisao` é opcional: quem escreve o card INSCREVE
# os aprovadores antes de qualquer um deles responder ("o item permanece enquanto houver
# aprovador pendente", F9 §4.3). Verbo que exigisse decisão só saberia registrar o fim, e o
# começo — que é o que trava o item — continuaria no JSON na mão.
#
# `--motivo` E NÃO `--texto`, e a divergência do nome de campo da API é deliberada: `motivo`
# é a palavra que `mover`, `fechar` e `apagar` já usam neste verbo para "por que você fez
# isso". Duas palavras para a mesma coisa em quatro subcomandos vizinhos é o tipo de atrito
# que se paga em toda chamada.
assinar() {
  local id; id=$(so_id "$1"); shift
  local aprovador="" decisao="" motivo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --aprovador) aprovador="$2"; shift 2 ;;
      --decisao)   decisao="$2";   shift 2 ;;
      --motivo|--texto) motivo="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$aprovador" ] || { echo "uso: tarefas assinar <id> --aprovador <cadeira> [--decisao aprovado|recusado] [--motivo \"<txt>\"]" >&2; exit 2; }
  # A regra de "recusado exige motivo" (F9 §4.3, e CHECK no schema) mora na API e no banco.
  # Aqui NÃO se duplica: uma cópia local divergiria no dia em que a regra mudasse, e a
  # recusa da API já chega legível por `--fail-with-body`.
  jq -n --arg a "$aprovador" --arg d "$decisao" --arg t "$motivo" \
     '{aprovador:$a}
      + (if $d == "" then {} else {decisao:$d} end)
      + (if $t == "" then {} else {texto:$t} end)' \
    | envia POST "/itens/$id/sign-offs" \
    | jq -r --arg it "$(rotulo_de "$id")" '"sign-off de \(.aprovador) em \($it): \(.decisao // "PENDENTE")"
             + (if .texto then " — \(.texto)" else "" end)'
}

criar() {
  descarta_projeto "${1:-}" && shift
  local titulo="${1:?uso: tarefas criar \"<título>\" [opções]}"; shift || true
  # DEFAULT É STORY (arq:0096, dono 02/09/2026). Medido antes da virada: 390 tasks, 156 órfãs, 13
  # stories com filha task — o default `task` fazia da task uma "story sem nome". Desde o #4223
  # a task é o passo da story e só nasce com `--nivel task --pai <story>`; débito técnico
  # é `tarefas dt admitir`, que não passa por aqui.
  local desc="" nivel="story" cadeira="$QUEM" pai="" classe="planejado"
  local originacao="" executor="" registro="" estado_opt=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --desc)       desc="$2"; shift 2 ;;
      --desc-stdin) desc="$(cat)"; shift ;;
      --nivel)      nivel="$2"; shift 2 ;;
      --cadeira)    cadeira="$2"; shift 2 ;;
      # Originação e executor (card #3526, R19): sem eles a API herda — a originação do pai, ou
      # negocio; o executor igual à cadeira. Valor fora do registro a API recusa (422).
      --originacao) originacao="${2:?--originacao pede negocio, tecnico ou incidente}"; shift 2 ;;
      --executor)   executor="${2:?--executor pede o nome da cadeira}"; shift 2 ;;
      --pai)        pai=$(so_id "$2"); shift 2 ;;
      --incidente)  classe="incidente"; shift ;;
      # CARD #3597 (R16, R31 da spec tarefas): story sem pai que vai a `priorizada` ou adiante
      # exige o comentário `registro-de-negocio` já gravado — a API grava item, transição e o
      # comentário na mesma transação quando `registro` chega no corpo (#2647 do #3417).
      --registro)   registro="$2"; shift 2 ;;
      # Vence o default da classe e `PF_ESTADO_INICIAL` (#259): nascer direto em `priorizada`
      # com `--registro` não depende de variável de ambiente para isso.
      --estado)     estado_opt="$2"; shift 2 ;;
      --prio)       echo "aviso: --prio não existe neste modelo; ignorado." >&2; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  # A API quer o nível como INTEIRO — a camada é ordem, e é ela que a restrição de pai
  # compara. O nome é o que a pessoa escreve; a tradução é aqui, num lugar só.
  local n
  case "$nivel" in
    épico|epico|0)   n=0 ;;
    feature|1)       n=1 ;;
    story|2)         n=2 ;;
    # Card #4223 (R37 da spec tarefas): a task é o passo da story. Sem `--pai` o verbo diz o
    # comando; com pai que não é story a recusa é da API, que é quem sabe o nível do pai.
    task|3)          n=3
                     if [ -z "$pai" ]; then
                       echo "recusado: a task é o passo da story e nasce sob ela: \`tarefas criar \"<o que fazer>\" --nivel task --pai <story>\`. Débito técnico é \`tarefas dt admitir\`." >&2
                       exit 2
                     fi
                     _lembra_pai "$pai" ;;
    # Card #4339: a ideia guarda um tema sem compromisso, nasce em captada só com o título e não
    # tem pai nem filha. Quem recusa `--pai` é a API, que é quem sabe a regra.
    ideia|4)         n=4 ;;
    *) echo "nível desconhecido: $nivel (épico, feature, story, task, ideia)" >&2; exit 2 ;;
  esac
  local html=""
  [ -n "$desc" ] && html="$(printf '%s' "$desc" | para_html)"
  local tem_d=0
  [ -n "$html" ] && tem_d=1
  # `estado` é obrigatório no POST: item nasce declarando onde entra no funil, e não há
  # default do servidor. `captada` é a boca do funil para planejado; incidente entra em
  # `aberto` se o registro o tiver, e a recusa da API nomeia o estado válido quando não.
  # incidente entra no funil de incidente (`detectado`), planejado na boca do funil
  # comum (`captada`). PF_ESTADO_INICIAL, se dado, vence o default da classe (#259).
  local est_default="captada"; [ "$classe" = "incidente" ] && est_default="detectado"
  local est="${estado_opt:-${PF_ESTADO_INICIAL:-$est_default}}"
  jq -n --arg t "$titulo" --arg d "$html" --argjson tem_d "$tem_d" --argjson n "$n" --arg c "$cadeira" \
        --arg p "$pai" --arg cl "$classe" --arg e "$est" \
        --arg o "$originacao" --arg x "$executor" --arg r "$registro" \
     '{titulo:$t, classe:$cl, estado:$e}
      + (if $cl == "incidente" then {} else {nivel:$n} end)
      + (if $tem_d == 1 then {descricao:$d} else {} end)
      + (if $c == "" then {} else {cadeira:$c} end)
      + (if $p == "" then {} else {pai:($p|tonumber)} end)
      + (if $o == "" then {} else {tipo_demanda:$o} end)
      + (if $x == "" then {} else {executor:$x} end)
      + (if $r == "" then {} else {registro:$r} end)' \
    | envia POST /itens \
    | jq -r "$JQ_ROT"'"item \(rotn) criado: \(.titulo)"'
}

# EDITAR É O PATCH DO CORPO COM NOME DE ATO — card #3134 (dono, 25/09/2026): toda chamada
# de API se encapsula em verbo. A rota sempre aceitou `titulo`/`descricao` no PATCH, mas a
# única porta até ela era a escotilha `api-corpo`, e cadeira não achava nem essa.
#
# NUNCA manda `estado`: editar não move. Mover é `mover`, que carrega motivo e cascata; um
# PATCH que trocasse corpo e estado juntos regrediria a coluna sem ninguém pedir. A régua do
# corpo por nível (arq:0096) é da API, como em `criar` — este verbo não a duplica.
editar() {
  local alvo="${1:?uso: tarefas editar <id> [--titulo \"<t>\"] [--desc \"<txt>\"|--desc-stdin]}"; shift
  local titulo="" desc="" tem_desc="" cadeira="" tem_cadeira=0 nivel="" originacao="" executor="" pai_ed=""
  local trecho=0 antes="" tem_antes=0 depois="" tem_depois=0 bruto=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --titulo)     titulo="${2:?--titulo pede texto}"; shift 2 ;;
      # Originação e executor (card #3526, R19; colunas do #3521). A API confere a originação contra
      # o registro (422) e não tem lista para o executor: este verbo não repete nenhuma das duas.
      --originacao) originacao="${2:?--originacao pede negocio, tecnico ou incidente}"; shift 2 ;;
      --executor)   executor="${2:?--executor pede o nome da cadeira}"; shift 2 ;;
      --pai)        pai_ed=$(so_id "${2:?--pai pede o id da story}"); _lembra_pai "$pai_ed"; shift 2 ;;
      --desc)       desc="${2:?--desc pede texto}"; tem_desc=1; shift 2 ;;
      --desc-stdin) desc="$(cat)"; tem_desc=1; shift ;;
      # Card #4110: o corpo por trecho. `--depois` pode ser vazio (apaga o trecho), por isso
      # não usa `${2:?}`, que recusaria o vazio.
      --trecho)     trecho=1; shift ;;
      --antes)      [ $# -ge 2 ] || { echo "--antes pede texto" >&2; exit 2; }
                    antes="$2"; tem_antes=1; shift 2 ;;
      --depois)     [ $# -ge 2 ] || { echo "--depois pede texto (vazio apaga o trecho)" >&2; exit 2; }
                    depois="$2"; tem_depois=1; shift 2 ;;
      --bruto)      bruto=1; shift ;;
      # A cadeira e o nível do card mudam por aqui (#2856 linhas 112 e 113): a API aceita os dois no
      # PATCH, e é ela quem recusa nome ou camada inválidos — este verbo não repete a lista.
      --cadeira)    cadeira="${2:?--cadeira pede o nome da cadeira}"; tem_cadeira=1; shift 2 ;;
      --sem-cadeira) cadeira=""; tem_cadeira=1; shift ;;
      --nivel)
        case "${2:?--nivel pede épico, feature, story, task ou ideia}" in
          épico|epico|0) nivel=0 ;;
          feature|1)     nivel=1 ;;
          story|2)       nivel=2 ;;
          task|3)        nivel=3 ;;
          ideia|4)       nivel=4 ;;
          *) echo "nível desconhecido: $2 (épico, feature, story, task, ideia)" >&2; exit 2 ;;
        esac
        shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  local id; id=$(TAREFAS_PAI="${pai_ed:-${TAREFAS_PAI:-}}" so_id "$alvo") || exit 1
  if [ -z "$titulo" ] && [ -z "$tem_desc" ] && [ "$tem_cadeira" -eq 0 ] && [ -z "$nivel" ] \
     && [ -z "$originacao" ] && [ -z "$executor" ] && [ "$trecho" -eq 0 ]; then
    echo "uso: tarefas editar <id> [--titulo \"<t>\"] [--desc \"<txt>\"|--desc-stdin] [--cadeira <c>|--sem-cadeira] [--nivel épico|feature|story|task|ideia] [--originacao negocio|tecnico|incidente] [--executor <c>] — nada a editar" >&2
    exit 2
  fi
  # Card #4110. As recusas de forma saem aqui, sem chamar a API; a contagem do `antes` no corpo
  # gravado só a API sabe, e é ela quem recusa zero ou mais de uma ocorrência.
  if [ "$trecho" -eq 0 ] && [ $((tem_antes + tem_depois + bruto)) -gt 0 ]; then
    echo "recusado: --antes, --depois e --bruto só valem com --trecho" >&2; exit 2
  fi
  if [ "$trecho" -eq 1 ]; then
    if [ -n "$tem_desc" ]; then
      echo "recusado: --trecho não combina com --desc nem --desc-stdin: ou troca o corpo inteiro, ou um trecho" >&2; exit 2
    fi
    if [ "$tem_antes" -eq 0 ] || [ "$tem_depois" -eq 0 ]; then
      echo "recusado: --trecho pede --antes \"<txt>\" e --depois \"<txt>\" (depois vazio apaga o trecho)" >&2; exit 2
    fi
    if [ -z "$antes" ]; then
      echo "recusado: --antes vazio casaria em todo lugar" >&2; exit 2
    fi
  fi
  if [ -n "$tem_desc" ] && [ -z "$(printf '%s' "$desc" | tr -d '[:space:]')" ]; then
    echo "recusado: corpo vazio apagaria a descrição do item. Para ver o esqueleto: tarefas modelo <nível>" >&2
    exit 2
  fi
  local html=""
  [ -n "$tem_desc" ] && html="$(printf '%s' "$desc" | para_html)"
  local tem_d=0
  [ -n "$tem_desc" ] && tem_d=1
  # O trecho vai como está só com --bruto; senão, no mesmo escape do corpo (`trecho_html`).
  local antes_h="$antes" depois_h="$depois"
  if [ "$trecho" -eq 1 ] && [ "$bruto" -eq 0 ]; then
    antes_h=$(trecho_html "$antes") \
      || { echo "não consegui converter o trecho para o formato do corpo (python3)" >&2; exit 1; }
    depois_h=$(trecho_html "$depois") \
      || { echo "não consegui converter o trecho para o formato do corpo (python3)" >&2; exit 1; }
  fi
  # `cadeira: null` tira a cadeira (a API trata o nulo explícito como pedido); ausente não mexe.
  local corpo_patch resp_patch err_patch rc_patch=0
  corpo_patch=$(jq -n --arg t "$titulo" --arg d "$html" --argjson tem_d "$tem_d" --argjson tc "$tem_cadeira" --arg c "$cadeira" --arg n "$nivel" \
        --arg o "$originacao" --arg x "$executor" \
        --argjson tr "$trecho" --arg ta "$antes_h" --arg td "$depois_h" \
     '(if $t == "" then {} else {titulo:$t} end)
      + (if $tr == 1 then {descricao_trecho:{antes:$ta, depois:$td}} else {} end)
      + (if $tem_d == 1 then {descricao:$d} else {} end)
      + (if $tc == 1 then {cadeira: (if $c == "" then null else $c end)} else {} end)
      + (if $n == "" then {} else {nivel: ($n|tonumber)} end)
      + (if $o == "" then {} else {tipo_demanda:$o} end)
      + (if $x == "" then {} else {executor:$x} end)')
  err_patch=$(mktemp)
  resp_patch=$(printf '%s' "$corpo_patch" | envia PATCH "/itens/$id" 2>"$err_patch") || rc_patch=$?
  if [ "$rc_patch" -ne 0 ] && [ "$trecho" -eq 1 ] && [ "$bruto" -eq 0 ] && grep -q "ocorre 0 vezes" "$err_patch"; then
    local item_j par_res
    if item_j=$(busca GET "/itens/$id" 2>/dev/null) && par_res=$(_resolve_trecho_no_corpo "$item_j" "$antes" "$depois" 2>/dev/null); then
      antes_h=$(printf '%s' "$par_res" | jq -r '.antes')
      depois_h=$(printf '%s' "$par_res" | jq -r '.depois')
      corpo_patch=$(printf '%s' "$corpo_patch" | jq --arg ta "$antes_h" --arg td "$depois_h" '.descricao_trecho = {antes:$ta, depois:$td}')
      rc_patch=0
      resp_patch=$(printf '%s' "$corpo_patch" | envia PATCH "/itens/$id" 2>"$err_patch") || rc_patch=$?
    fi
  fi
  if [ "$rc_patch" -ne 0 ]; then
    cat "$err_patch" >&2
    rm -f "$err_patch"
    return "$rc_patch"
  fi
  rm -f "$err_patch"
  printf '%s' "$resp_patch" \
    | jq -r --argjson tc "$tem_cadeira" --arg n "$nivel" --arg o "$originacao" --arg x "$executor" "$JQ_ROT"'
        "item \(rotn) editado: \(.titulo)"
        + (if $tc == 1 then " · cadeira \(.cadeira // "nenhuma")" else "" end)
        + (if $n != "" then " · nível \(.nivel_nome // .nivel)" else "" end)
        + (if $o != "" then " · originação \(.tipo_demanda // "?")" else "" end)
        + (if $x != "" then " · executor \(.executor // "?")" else "" end)
        + " · estado \(.estado_nome) (inalterado)"'
}

# COMENTÁRIO É TEXTO NO CORPO, por ordem do dono (16/08/2026). O modelo do rastreador não
# tem entidade de comentário, e a migração do acervo já pôs os comentários velhos dentro de
# `descricao` sob marcador. Escrever novo do mesmo jeito mantém uma forma só — e o dia em
# que comentário virar entidade, há um marcador único para varrer.
# CARD #390: comentário é entidade própria (api/app.py `POST /itens/{id}/comentarios`),
# não mais texto colado em `descricao` — o PATCH que anexava ao corpo inflava a leitura
# do item a cada comentário e não dava id/ordem a nada (#382 assinado "anônimo" sem como
# provar, referências como "comentário 350" apontando pra NÚMERO DE LINHA, não objeto).
# `autor` não vem daqui: o servidor lê do MESMO cabeçalho que `mover`/`fechar` já usam
# (`x-auth-request-preferred-username`, via `$QUEM`) — `envia` já o manda quando presente.
comentar() {
  local id="${1:-}"
  [ -z "$id" ] && { echo "uso: tarefas comentar <id> [\"<txt>\"] (ou corpo em stdin)" >&2; exit 2; }
  id=$(so_id "$id") || exit 2
  if [ "${2:-}" = "--fecha" ]; then
    fechar_comentario "$id" "${3:-}" "${4:-}"
    return
  fi
  if [ "${2:-}" = "--edita" ]; then
    editar_comentario "$id" "${3:-}" "${4:-}"
    return
  fi
  local txt="${2:-}"
  # Opção no lugar do texto não é corpo (#2856 linhas 49 e 50): `--stdin` manda ler o stdin; outra
  # opção de uma palavra só é recusada, em vez de gravada como comentário.
  if [[ "$txt" =~ ^--[a-zA-Z][a-zA-Z0-9-]*$ ]]; then
    [ "$txt" = "--stdin" ] || { echo "erro: tarefas comentar: opção desconhecida '$txt'; o corpo vai entre aspas ou em stdin." >&2; exit 2; }
    txt=""
  fi
  if [ -z "$txt" ] && [ ! -t 0 ]; then
    txt="$(cat)"
  fi
  local trim
  trim="$(printf '%s' "$txt" | tr -d '[:space:]')"
  if [ -z "$trim" ]; then
    echo "erro: tarefas comentar: corpo do comentário não pode ser vazio." >&2
    echo "uso: tarefas comentar <id> [\"<txt>\"] (ou corpo em stdin)" >&2
    exit 2
  fi
  local html; html=$(printf '%s' "$txt" | para_html)
  local corpo saida status body
  corpo=$(jq -n --arg c "$html" '{corpo:$c}')
  # CARD #3614: a recusa de tipo (épico/feature sem tipo na primeira linha, ou tipo fora
  # da fase aceita) traz `aceitos` — mesmo campo e mesmo estilo que `fechar_comentario`
  # já imprime para o fecho fora do vocabulário; `_recusa`, genérico a todo verbo, não
  # sabe rotular «tipo aceito».
  if [ -n "$QUEM" ]; then
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios" \
                 -H 'Content-Type: application/json' \
                 -H "x-auth-request-preferred-username: $QUEM" -d @- -w '\n%{http_code}')
  else
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios" \
                 -H 'Content-Type: application/json' -d @- -w '\n%{http_code}')
  fi
  status="${saida##*$'\n'}"
  body="${saida%$'\n'*}"
  case "$status" in
    201)
      printf '%s' "$body" | jq -r --arg it "$(rotulo_de "$id" n)" '"comentário #\(.id) criado no item \($it)"'
      ;;
    400)
      printf '%s' "$body" | jq -r '
        .erro,
        ((.aceitos // [])[] | "  tipo aceito: \(.codigo) (\(.nome))")
      ' >&2
      exit 4 ;;
    *)
      local msg; msg=$(printf '%s' "$body" | jq -r '.erro // empty' 2>/dev/null || true)
      printf '%s\n' "${msg:-falha ao falar com o rastreador em $BASE (status ${status:-desconhecido})}" >&2
      exit 1 ;;
  esac
}

# O FECHO VAI DIRETO À ROTA PRÓPRIA — card #3593 (R6, R7 da spec comentario-tipado):
# `POST /itens/{id}/comentarios/{cid}/fecho` grava resultado, destino, quem e quando com
# `SELECT … FOR UPDATE`. Até a #3597, este verbo lia a primeira linha do comentário e
# conferia o vocabulário à mão; a regra mora na API desde a F3 (R5 a R7), e o verbo passa a
# só partir o argumento em resultado/destino e traduzir o status HTTP: 400 (sem tipo, ou
# resultado fora do vocabulário) e 403 (quem fecha não pode) saem 4; 409 (já fechado) e 404
# (não existe) saem 1, porque não há nada a repetir.
# DT 743: troca o corpo de um comentário existente via `PATCH /itens/{id}/comentarios/{cid}`.
# A API (card #3410, R13 da spec comentario-tipado) guarda o corpo anterior no ledger e recusa
# com 400 se a edição trocar o tipo gravado ou alterar a linha de fecho.
editar_comentario() {
  local id="$1" cid="${2:-}" txt="${3:-}"
  local uso='uso: tarefas comentar <id> --edita <n> ["<txt>"] (ou corpo em stdin)'
  cid="${cid#\#}"
  case "$cid" in ''|*[!0-9]*) echo "$uso" >&2; exit 2 ;; esac
  if [[ "$txt" =~ ^--[a-zA-Z][a-zA-Z0-9-]*$ ]]; then
    [ "$txt" = "--stdin" ] || { echo "erro: tarefas comentar --edita: opção desconhecida '$txt'; o corpo vai entre aspas ou em stdin." >&2; exit 2; }
    txt=""
  fi
  if [ -z "$txt" ] && [ ! -t 0 ]; then
    txt="$(cat)"
  fi
  local trim
  trim="$(printf '%s' "$txt" | tr -d '[:space:]')"
  if [ -z "$trim" ]; then
    echo "erro: tarefas comentar --edita: corpo do comentário não pode ser vazio." >&2
    echo "$uso" >&2
    exit 2
  fi
  local html; html=$(printf '%s' "$txt" | para_html) || return 1
  local corpo saida status body
  corpo=$(jq -n --arg c "$html" '{corpo:$c}')
  if [ -n "$QUEM" ]; then
    saida=$(printf '%s' "$corpo" | curl -s -X PATCH "$BASE/itens/$id/comentarios/$cid" \
                 -H 'Content-Type: application/json' \
                 -H "x-auth-request-preferred-username: $QUEM" -d @- -w '\n%{http_code}')
  else
    saida=$(printf '%s' "$corpo" | curl -s -X PATCH "$BASE/itens/$id/comentarios/$cid" \
                 -H 'Content-Type: application/json' -d @- -w '\n%{http_code}')
  fi
  status="${saida##*$'\n'}"
  body="${saida%$'\n'*}"
  case "$status" in
    200)
      printf '%s' "$body" | jq -r --arg it "$(rotulo_de "$id" n)" '"comentário #\(.id) do item \($it) editado"'
      ;;
    400)
      printf '%s' "$body" | jq -r '.erro // .detail // empty' >&2
      exit 4 ;;
    *)
      local msg; msg=$(printf '%s' "$body" | jq -r '.erro // .detail // empty' 2>/dev/null || true)
      printf '%s\n' "${msg:-falha ao falar com o rastreador em $BASE (status ${status:-desconhecido})}" >&2
      exit 1 ;;
  esac
}

fechar_comentario() {
  local id="$1" cid="${2:-}" txt="${3:-}"
  local uso='uso: tarefas comentar <card> --fecha <n> "<resultado> — <destino>"'
  case "$cid" in ''|*[!0-9#]*) echo "$uso" >&2; exit 2 ;; esac
  cid=$(so_id "$cid")
  txt="$(printf '%s' "$txt" | sed -e 's/^[[:space:]]*[Ff]echo[[:space:]]*:[[:space:]]*//' \
                             -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$txt" in
    *" — "*) ;;
    *) echo "$uso" >&2
       echo "o fecho é «<resultado> — <destino>»: o destino diz onde a contribuição foi parar (spec comentario-tipado, R6)" >&2
       exit 2 ;;
  esac
  local resultado destino
  resultado="$(printf '%s' "${txt%% — *}" | sed -e 's/[[:space:]]*$//')"
  destino="$(printf '%s' "${txt#* — }" | sed -e 's/^[[:space:]]*//')"
  [ -n "$resultado" ] && [ -n "$destino" ] || { echo "$uso" >&2; exit 2; }
  local corpo saida status body
  corpo=$(jq -n --arg r "$resultado" --arg d "$destino" '{resultado:$r, destino:$d}')
  # CARD #3597: só este ato pede o status HTTP (`-w`) — 400, 403, 409 e 404 são saída
  # esperada com texto próprio, não `_recusa`, e `envia`/`busca` não servem aqui.
  if [ -n "$QUEM" ]; then
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios/$cid/fecho" \
                 -H 'Content-Type: application/json' \
                 -H "x-auth-request-preferred-username: $QUEM" -d @- -w '\n%{http_code}')
  else
    saida=$(printf '%s' "$corpo" | curl -s -X POST "$BASE/itens/$id/comentarios/$cid/fecho" \
                 -H 'Content-Type: application/json' -d @- -w '\n%{http_code}')
  fi
  status="${saida##*$'\n'}"
  body="${saida%$'\n'*}"
  case "$status" in
    200)
      printf '%s' "$body" | jq -r --arg it "$(rotulo_de "$id" n)" \
        '"comentário #\(.id) do item \($it) fechado — fecho: \(.fecho_resultado) — \(.fecho_destino)"'
      ;;
    400|403)
      printf '%s' "$body" | jq -r '
        .erro,
        ((.aceitos // [])[] | "  resultado aceito: \(.codigo) (\(.nome))"),
        (if (.quem_pode // []) != [] then "  quem pode fechar: " + (.quem_pode | join(", ")) else empty end)
      ' >&2
      exit 4 ;;
    409)
      printf '%s' "$body" | jq -r '
        "sem mudança: \(.erro)",
        (if .fecho_atual then "  já fechado: \(.fecho_atual.resultado) — \(.fecho_atual.destino) (\(.fecho_atual.por // "—"), \(.fecho_atual.em))" else empty end)
      ' >&2
      exit 1 ;;
    404)
      printf '%s' "$body" | jq -r '.erro' >&2
      exit 1 ;;
    *)
      local msg; msg=$(printf '%s' "$body" | jq -r '.erro // empty' 2>/dev/null || true)
      printf '%s\n' "${msg:-falha ao falar com o rastreador em $BASE (status ${status:-desconhecido})}" >&2
      exit 1 ;;
  esac
}

# Sem opção, lista tudo, no formato de sempre (o lint de card lê esta saída). A porta corta a saída
# de um verbo em ~50 KB, e card com muita conversa passa disso: o corte engole os comentários do
# fim, justamente os mais novos. Daí as fatias — a API devolve tudo de uma vez, quem recorta é este
# verbo, e cada recorte cabe na porta.
comentarios() {
  local uso='uso: tarefas comentarios <id> [--indice] [--busca <termo>] [--arvore] [--id <n>]... [--desde <n>] [--ultimos <k>]'
  local id='' ids='[]' desde=0 ultimos=0 indice=false arvore=false busca_termo=''
  local numero='^[0-9]+$'
  while [ $# -gt 0 ]; do
    case "$1" in
      --indice) indice=true; shift ;;
      --arvore) arvore=true; shift ;;
      --busca)
        [ -n "${2:-}" ] || { echo "tarefas comentarios: --busca pede um termo" >&2; echo "$uso" >&2; exit 2; }
        busca_termo="$2"; shift 2 ;;
      --id|--desde|--ultimos)
        [[ "${2:-}" =~ $numero ]] || { echo "tarefas comentarios: $1 pede um número" >&2; echo "$uso" >&2; exit 2; }
        case "$1" in
          --id) ids=$(jq -c --argjson n "$2" '. + [$n]' <<<"$ids") ;;
          --desde) desde=$2 ;;
          --ultimos) ultimos=$2 ;;
        esac
        shift 2 ;;
      --*) echo "tarefas comentarios: opção desconhecida: $1" >&2; echo "$uso" >&2; exit 2 ;;
      *)
        [ -z "$id" ] || { echo "tarefas comentarios: argumento inesperado: $1" >&2; echo "$uso" >&2; exit 2; }
        id=$(so_id "$1") || return 1
        shift ;;
    esac
  done
  [ -n "$id" ] || { echo "$uso" >&2; exit 2; }
  # Portão do funil: o card terminal sai recusado aqui, limpo, antes dos encadeamentos abaixo
  # (que, recusados no meio do pipe, imprimiam o traceback do conversor junto da recusa).
  if [ "$_SO_FUNIL" = 1 ]; then busca GET "/itens/$id" >/dev/null || return 1; fi
  local saida bytes
  if [ "$arvore" = "true" ] || [ -n "$busca_termo" ]; then
    local -a fila=("$id")
    local -A visitado=()
    visitado["$id"]=1
    local idx=0 linhas_acum='' bloco=''
    while [ "$idx" -lt "${#fila[@]}" ]; do
      local cid="${fila[$idx]}"
      idx=$((idx + 1))
      local card_rot=''
      if [ "$arvore" = "true" ]; then
        local item_j
        item_j=$(busca GET "/itens/$cid") || return 1
        card_rot=$(printf '%s' "$item_j" | jq -r "$JQ_ROT"'rot')
        local fid
        while IFS= read -r fid; do
          [ -n "$fid" ] || continue
          if [ -z "${visitado[$fid]:-}" ]; then
            visitado["$fid"]=1
            fila+=("$fid")
          fi
        done < <(printf '%s' "$item_j" | jq -r '.filhas[]?.id // empty')
      else
        card_rot=$(rotulo_de "$cid")
      fi
      local com_j
      com_j=$(busca GET "/itens/$cid/comentarios") || return 1
      if [ -n "$busca_termo" ]; then
        bloco=$(printf '%s' "$com_j" | jq -c \
          --argjson ids "$ids" --argjson desde "$desde" --argjson ultimos "$ultimos" '
          .comentarios
          | (if ($ids | length) > 0 then map(select(.id as $i | any($ids[]; . == $i))) else . end)
          | map(select(.id >= $desde))
          | (if $ultimos > 0 then .[-$ultimos:] else . end)' \
          | BUSCA_TERMO="$busca_termo" CARD_ROT="$card_rot" python3 -c '
import html, json, os, re, sys
q = os.environ["BUSCA_TERMO"].casefold()
card = os.environ["CARD_ROT"]
for c in json.load(sys.stdin):
    txt = re.sub(r"(?i)<br */?>|</p>|</li>|</h[0-9]>|</pre>", "\n", c.get("corpo") or "")
    txt = html.unescape(re.sub(r"<[^>]*>", "", txt))
    for linha in txt.splitlines():
        if q in linha.casefold():
            cid = c["id"]
            print(f"#{cid} · {card} · {linha}")
')
      elif [ "$indice" = "true" ]; then
        bloco=$(printf '%s' "$com_j" | jq -c \
          --argjson ids "$ids" --argjson desde "$desde" --argjson ultimos "$ultimos" '
          .comentarios
          | (if ($ids | length) > 0 then map(select(.id as $i | any($ids[]; . == $i))) else . end)
          | map(select(.id >= $desde))
          | (if $ultimos > 0 then .[-$ultimos:] else . end)' \
          | CARD_ROT="$card_rot" python3 -c '
import html, json, os, re, sys
card = os.environ["CARD_ROT"]
for c in json.load(sys.stdin):
    raw = c.get("corpo") or ""
    txt = html.unescape(re.sub(r"<[^>]*>", " ", raw))
    prev = " ".join(txt.split())[:100]
    autor = c.get("autor") or "anônimo"
    cid = c["id"]
    carimbo = c.get("carimbo", "")
    print(f"{card} · #{cid} · {autor} · {carimbo} · {len(raw)} car. · {prev}")
')
      else
        bloco=$(printf '%s' "$com_j" | jq -r \
          --argjson ids "$ids" --argjson desde "$desde" --argjson ultimos "$ultimos" \
          --arg card "$card_rot" '
          .comentarios as $todos
          | ($todos
             | (if ($ids | length) > 0 then map(select(.id as $i | any($ids[]; . == $i))) else . end)
             | map(select(.id >= $desde))
             | (if $ultimos > 0 then .[-$ultimos:] else . end)) as $sel
          | $sel[] | "--- \($card) · #\(.id) · \(.autor // "anônimo") · \(.carimbo) ---\n\(.corpo)\n"' | para_texto)
      fi
      if [ -n "$bloco" ]; then
        if [ -n "$linhas_acum" ]; then
          linhas_acum+=$'\n'"$bloco"
        else
          linhas_acum="$bloco"
        fi
      fi
    done
    if [ -n "$linhas_acum" ]; then
      saida="$linhas_acum"
    elif [ -n "$busca_termo" ]; then
      saida="(nenhum comentário encontrado para \"$busca_termo\")"
    else
      saida="(sem comentários)"
    fi
  else
    if [ "$indice" = "true" ]; then
      saida=$(busca GET "/itens/$id/comentarios" | jq -c \
        --argjson ids "$ids" --argjson desde "$desde" --argjson ultimos "$ultimos" '
        .comentarios as $todos
        | ($todos
           | (if ($ids | length) > 0 then map(select(.id as $i | any($ids[]; . == $i))) else . end)
           | map(select(.id >= $desde))
           | (if $ultimos > 0 then .[-$ultimos:] else . end)) as $sel
        | if ($todos | length) == 0 then {vazio: "(sem comentários)"}
          elif ($sel | length) == 0 then
            {vazio: "(nenhum comentário na seleção; o item tem \($todos | length), de #\($todos[0].id) a #\($todos[-1].id))"}
          else {itens: $sel}
          end' | python3 -c '
import html, json, re, sys
d = json.load(sys.stdin)
if "vazio" in d:
    print(d["vazio"])
else:
    for c in d["itens"]:
        raw = c.get("corpo") or ""
        txt = html.unescape(re.sub(r"<[^>]*>", " ", raw))
        prev = " ".join(txt.split())[:100]
        autor = c.get("autor") or "anônimo"
        cid = c["id"]
        carimbo = c.get("carimbo", "")
        print(f"#{cid} · {autor} · {carimbo} · {len(raw)} car. · {prev}")
')
    else
      saida=$(busca GET "/itens/$id/comentarios" | jq -r \
        --argjson ids "$ids" --argjson desde "$desde" --argjson ultimos "$ultimos" '
        .comentarios as $todos
        | ($todos
           | (if ($ids | length) > 0 then map(select(.id as $i | any($ids[]; . == $i))) else . end)
           | map(select(.id >= $desde))
           | (if $ultimos > 0 then .[-$ultimos:] else . end)) as $sel
        | if ($todos | length) == 0 then "(sem comentários)"
          elif ($sel | length) == 0 then
            "(nenhum comentário na seleção; o item tem \($todos | length), de #\($todos[0].id) a #\($todos[-1].id))"
          else
            $sel[] | "--- #\(.id) · \(.autor // "anônimo") · \(.carimbo) ---\n\(.corpo)\n"
          end' | para_texto)
    fi
  fi
  bytes=$(printf '%s' "$saida" | wc -c)
  if [ "$bytes" -gt 45000 ]; then
    echo "aviso: ${bytes} bytes; a porta corta a saída em 50000 e perde o fim. Leia por partes: tarefas comentarios $id --indice, depois --id <n>, --desde <n> ou --ultimos <k>"
  fi
  printf '%s\n' "$saida"
}

# MOVER É O ATO, E O NOME É O ATO — card #224. A capacidade sempre existiu: o PATCH aceita
# qualquer estado do registro, e quem valida é a máquina. O que não existia era um verbo com
# o nome do que se faz, e o efeito observável disso foi medido no quadro de 17/08 — `Em
# execução` com UM item e `Entregue` com 145. Ninguém procura `fechar` para mover um card
# pelo fluxo, então ninguém operava fluxo pelo rastreador.
#
# `--motivo` é primeira classe porque a máquina o EXIGE em parte das transições (volta ao
# funil, §4.1; `recusada`, §6.3) e porque, sem ele aqui, a cadeira descobria a exigência
# levando erro. A lista de destinos válidos vem da API, derivada da própria máquina: este
# verbo não guarda tabela de arestas, e é isso que o mantém correto quando um estado novo
# entra no registro por INSERT.
# DTs 323, 404 e 592: valida a tabela/lista de Unidades do Plano na entrada em `em-execucao`.
# Identifica a coluna `arquivos` (ou fallback `escreve`) pelo cabeçalho da tabela Markdown (ex.:
# `| # | escreve | arquivos | verificacao | depende |`), ignora texto descritivo do que a unidade
# escreve, parênteses `(...)` e o rótulo literal `escreve`, aceita `—`/`nenhum` quando a unidade
# não escreve arquivo, e cita explicitamente o nome da coluna lida quando recusa arquivo fora do raio.
_validar_unidades_plano() {
  local id="$1" j
  j=$(busca GET "/itens/$id" 2>/dev/null) || return 0
  [ -n "$j" ] || return 0
  ITEM_JSON="$j" python3 -c '
import fnmatch, html, json, os, re, sys, unicodedata

try:
    dados = json.loads(os.environ.get("ITEM_JSON", "") or "{}")
except Exception:
    sys.exit(0)

desc = dados.get("descricao") or ""
if not isinstance(desc, str) or not desc.strip():
    sys.exit(0)

if "<" in desc and ">" in desc:
    t = re.sub(r"</p>|<br\s*/?>|</h[0-9]>|</li>|</pre>", "\n", desc, flags=re.I)
    t = re.sub(r"<li>", "  - ", t, flags=re.I)
    t = re.sub(r"<[^>]*>", "", t)
    texto = html.unescape(t)
else:
    texto = desc

linhas = [l.rstrip() for l in texto.splitlines()]

def _norm(s: str) -> str:
    s = unicodedata.normalize("NFD", s.strip().lower())
    return "".join(c for c in s if unicodedata.category(c) != "Mn")

re_hdr_md = re.compile(r"^\s*#{1,4}\s+(.+?)\s*$")
re_rotulo = re.compile(r"^\s*([A-ZÁÉÍÓÚÂÊÔÃÕÇ][A-Za-z0-9áéíóúâêôãõçÁÉÍÓÚÂÊÔÃÕÇ _/-]{1,40}):\s*(.*)$")

secoes = {}
atual = None
for l in linhas:
    m_md = re_hdr_md.match(l)
    if m_md:
        h = _norm(m_md.group(1)).rstrip(":")
        if "arquivos no raio" in h or h in ("raio", "raio de ataque", "raio emendado"):
            atual = "raio"
            secoes.setdefault("raio", [])
        elif h == "unidades" or h.startswith("unidades "):
            atual = "unidades"
            secoes.setdefault("unidades", [])
        else:
            atual = None
        continue
    m_rot = re_rotulo.match(l)
    if m_rot and not l.lstrip().startswith(("-", "*", "|")):
        r = _norm(m_rot.group(1))
        resto = m_rot.group(2).strip()
        if r in ("raio de ataque", "raio emendado", "arquivos no raio", "raio"):
            atual = "raio"
            secoes.setdefault("raio", [])
            if resto:
                secoes["raio"].append(resto)
            continue
        elif r == "unidades":
            atual = "unidades"
            secoes.setdefault("unidades", [])
            if resto:
                secoes["unidades"].append(resto)
            continue
        elif r in ("premissas", "regras novas", "travas", "fora", "solucao", "problema", "sai quando", "onde", "traz"):
            atual = None
            continue
    if atual:
        secoes[atual].append(l)

if "raio" not in secoes or "unidades" not in secoes:
    sys.exit(0)

VAZIOS = {"", "-", "—", "–", "nenhum", "nenhuma", "nada", "n/a", "nao", "não", "so le", "só lê", "nao escreve", "não escreve"}
NOMES_CONHECIDOS = {"dockerfile", "makefile", "verdes", "procfile", "gemfile", "rakefile", "justfile", "caddyfile"}

ASPAS = "`\x27\x22"

def _parece_caminho(tok: str) -> bool:
    t = tok.strip().strip(ASPAS).rstrip(".,;:")
    if not t or _norm(t) in VAZIOS or _norm(t) == "escreve":
        return False
    if " " in t or "\t" in t:
        return False
    if "@" in t or "/" in t:
        return True
    if _norm(t) in NOMES_CONHECIDOS:
        return True
    if re.match(r"^[A-Za-z0-9_.-]+\.[A-Za-z0-9]{1,10}$", t):
        return True
    return False

def _limpar_celula_arquivos(celula: str) -> list[str]:
    # DT 323 e DT 404: tira observações entre parênteses (ex.: `(e o lock, pelo npm)`) e rótulo `escreve`
    s = celula.strip()
    while True:
        novo = re.sub(r"\([^()]*\)", " ", s)
        if novo == s:
            break
        s = novo
    s = re.sub(r"[()]", " ", s)
    s = re.sub(r"^\s*escreve\s*:?\s*", "", s, flags=re.I).strip()
    if _norm(s.strip(ASPAS + " ")) in VAZIOS:
        return []
    partes = re.split(r"[,;]+|\s+", s)
    arqs = []
    for p in partes:
        p_limpo = p.strip().strip(ASPAS).rstrip(".,;:")
        if not p_limpo or _norm(p_limpo) in VAZIOS or _norm(p_limpo) == "escreve":
            continue
        if _parece_caminho(p_limpo):
            arqs.append(p_limpo)
    return arqs

raio_entradas = []
for l in secoes["raio"]:
    s = l.strip()
    if not s or s.startswith("<!--"):
        continue
    if s.startswith("|"):
        cels = [c.strip() for c in s.strip("|").split("|")]
        if not cels or all(re.match(r"^:?-+:?$", c) for c in cels if c):
            continue
        if _norm(cels[0]) in ("arquivo", "arquivos", "caminho", "raio", "#"):
            continue
        s = cels[0]
    else:
        s = re.sub(r"^[-*+]\s+", "", s)
    s = re.sub(r"\([^()]*\)", " ", s)
    s = re.split(r"\s+[—–-]\s+|\s+#\s+", s, maxsplit=1)[0].strip()
    for cand in re.split(r"[,;]+|\s+", s):
        c = cand.strip().strip(ASPAS).rstrip(".,;:")
        if _parece_caminho(c):
            raio_entradas.append(c)

if not raio_entradas:
    sys.exit(0)

def _no_raio(arq: str) -> bool:
    arq_sem_repo = arq.split("@", 1)[1] if "@" in arq else arq
    for r in raio_entradas:
        r_sem_repo = r.split("@", 1)[1] if "@" in r else r
        if arq == r or arq_sem_repo == r_sem_repo or arq == r_sem_repo or arq_sem_repo == r:
            return True
        if "*" in r or "?" in r:
            if fnmatch.fnmatch(arq, r) or fnmatch.fnmatch(arq_sem_repo, r_sem_repo):
                return True
        r_dir = r_sem_repo.rstrip("/")
        if r_dir and arq_sem_repo.startswith(r_dir + "/"):
            return True
    return False

linhas_u = [l.strip() for l in secoes["unidades"] if "|" in l and not l.strip().startswith("<!--")]
if not linhas_u:
    sys.exit(0)

def _partir_linha(l: str) -> list[str]:
    s = l.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|"):
        s = s[:-1]
    return [c.strip() for c in s.split("|")]

def _eh_separador(cels: list[str]) -> bool:
    return bool(cels) and all(re.match(r"^:?-{2,}:?$", c) for c in cels if c != "")

def _eh_cabecalho(cels: list[str]) -> bool:
    nomes = {_norm(c) for c in cels}
    chaves = {"arquivos", "arquivo", "escreve", "verificacao", "depende", "prova", "unidade", "unidades"}
    if not (nomes & chaves):
        return False
    prim = _norm(cels[0]) if cels else ""
    if re.match(r"^(u?\d+)\b", prim) and prim not in ("#", "id", "n", "no", "num", "numero", "unidade"):
        return False
    return True

col_idx = None
col_nome = "arquivos"
inicio = 0

prim_cels = _partir_linha(linhas_u[0])
if _eh_cabecalho(prim_cels):
    inicio = 1
    if len(linhas_u) > 1 and _eh_separador(_partir_linha(linhas_u[1])):
        inicio = 2
    norm_cels = [_norm(c) for c in prim_cels]
    # DT 592: prioriza a coluna `arquivos` pelo cabeçalho; usa `escreve` só como fallback se não houver `arquivos`
    for i, nc in enumerate(norm_cels):
        if nc in ("arquivos", "arquivo", "arquivos no raio", "caminhos"):
            col_idx = i
            col_nome = prim_cels[i].strip() or "arquivos"
            break
    if col_idx is None:
        for i, nc in enumerate(norm_cels):
            if nc == "escreve" or nc.startswith("escreve "):
                col_idx = i
                col_nome = prim_cels[i].strip() or "escreve"
                break
    if col_idx is None:
        col_idx = 2 if len(prim_cels) >= 5 else 1
        col_nome = prim_cels[col_idx].strip() if col_idx < len(prim_cels) else "arquivos"

for l in linhas_u[inicio:]:
    cels = _partir_linha(l)
    if not cels or _eh_separador(cels) or _eh_cabecalho(cels):
        continue
    uid_bruto = cels[0].strip()
    m_u = re.match(r"^(U?\d+)\b", uid_bruto, flags=re.I)
    uid = m_u.group(1) if m_u else (uid_bruto.split()[0] if uid_bruto else "?")
    if uid.isdigit():
        uid = f"U{uid}"
    idx = col_idx
    nome_lido = col_nome
    if idx is None:
        # Fallback sem cabeçalho: se tem >= 4 colunas e a 2ª coluna é descrição sem caminhos enquanto a 3ª tem caminhos/vazio
        if len(cels) >= 4 and not _limpar_celula_arquivos(cels[1]) and _norm(cels[1].strip(ASPAS + " ")) not in VAZIOS and (
            _limpar_celula_arquivos(cels[2]) or _norm(cels[2].strip(ASPAS + " ")) in VAZIOS
        ):
            idx = 2
            nome_lido = "arquivos"
        else:
            idx = 1
            nome_lido = "arquivos"
    if idx >= len(cels):
        continue
    arqs = _limpar_celula_arquivos(cels[idx])
    for arq in arqs:
        if not _no_raio(arq):
            sys.stderr.write(
                f"recusado: Unidade {uid} toca \x27{arq}\x27 (coluna \x27{nome_lido}\x27 de ### Unidades) "
                f"fora de ### Arquivos no Raio (use \x27—\x27 ou \x27nenhum\x27 quando a unidade não escreve arquivo)\n"
            )
            sys.exit(1)
'
}

# ponteiro_do_estagio <nivel> <estado> -- a linha do processo que conduz o estado de destino do
# card movido (card #4359). A ligação mora na ficha do processo, no catálogo da casa (propriedade
# `conduz`, valores `<nivel>:<estado>`); o verbo só a lê e não guarda tabela de estado para
# processo, porque uma cópia aqui seria a segunda verdade. O ponteiro INFORMA E NÃO BARRA: infra
# ausente, saída diferente de 0, JSON ou fichas ilegíveis e teto estourado não imprimem nada, nem
# aviso nem stderr, e não mudam o código de saída do `mover`. O executável do infra se troca por
# PF_INFRA_BIN (o ponto de substituição da prova), e o teto da consulta inteira, em segundos, por
# PF_PONTEIRO_TETO. As classes lidas são `processo` e as filhas dela; o caminho do documento sai do
# endereço da shape da classe, com <slug> trocado pela chave sem o prefixo.
ponteiro_do_estagio() {
  local nivel="${1:-}" estado="${2:-}"
  [ -n "$nivel" ] && [ -n "$estado" ] || return 0
  PYTHONUTF8=1 PYTHONIOENCODING=utf-8 \
  PF_PONTEIRO_INFRA="${PF_INFRA_BIN:-$(dirname "$(readlink -f "$0")")/infra}" \
    python3 - "$nivel:$estado" "${PF_PONTEIRO_TETO:-20}" 2>/dev/null <<'PY' || true
import json
import os
import signal
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

alvo, teto = sys.argv[1], float(sys.argv[2])
infra = os.environ["PF_PONTEIRO_INFRA"]
fim = time.monotonic() + teto


def rodar(*args):
    restante = fim - time.monotonic()
    if restante <= 0:
        raise TimeoutError("teto")
    # grupo de processos à parte: o infra passa a vez a um python que lança outro, e só o grupo
    # inteiro some quando o teto estoura (o neto órfão seguraria o banco por até o teto da peça)
    p = subprocess.Popen([infra, "rodar", "ontologia", "--", *args, "--json"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         encoding="utf-8", start_new_session=True)
    try:
        saida, _ = p.communicate(timeout=restante)
    except BaseException:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        p.communicate()
        raise
    if p.returncode != 0:
        raise RuntimeError("catalogo")
    return json.loads(saida)


def limpo(valor):
    return valor.strip().strip("'\"")


def conduz_por_ficha(texto):
    achados, chave, lista = {}, None, False
    for linha in texto.splitlines():
        s = linha.strip()
        if linha.startswith("- chave:"):
            chave, lista = limpo(linha.split(":", 1)[1]), False
        elif chave is None:
            continue
        elif s.startswith("conduz:"):
            resto = limpo(s.split(":", 1)[1])
            achados.setdefault(chave, [])
            if resto:
                achados[chave].append(resto)
            lista = not resto
        elif lista and s.startswith("- "):
            achados[chave].append(limpo(s[2:]))
        else:
            lista = False
    return achados


def endereco_da_classe(texto):
    blocos, atual = {}, None
    for linha in texto.splitlines():
        s = linha.strip()
        if linha in ("  golden:", "  referencia:"):
            atual = s[:-1]
        elif atual and linha.startswith("    "):
            if s.startswith("endereco:"):
                blocos.setdefault(atual, limpo(s.split(":", 1)[1]))
        elif linha.startswith("  ") and not linha.startswith("   "):
            atual = None
    endereco = blocos.get("golden") or blocos.get("referencia")
    if not endereco:
        raise RuntimeError("sem endereco")
    return endereco


try:
    filhas = rodar("listar", "shape", "--filhas", "processo")["chaves"]
    classes = ["processo"] + [c for c in filhas if c != "processo"]
    with ThreadPoolExecutor(max_workers=len(classes)) as pool:
        lidas = list(pool.map(
            lambda c: (c, conduz_por_ficha(rodar("ler", c, "--fichas")["yaml"])), classes))
    ligados = sorted((c, k) for c, fichas in lidas for k, valores in fichas.items() if alvo in valores)
    linhas = []
    for classe, chave in ligados:
        endereco = endereco_da_classe(rodar("ler", "shape", classe)["yaml"])
        slug = chave.split(":", 1)[-1]
        linhas.append(f"  processo do estágio: {chave} — leia {endereco.replace('<slug>', slug)}")
    if linhas:
        print("\n".join(linhas))
except Exception:
    pass
PY
  return 0
}

mover() {
  local id; id=$(so_id "${1:?uso: tarefas mover <id> <estado> [--motivo \"...\"]}")
  local destino="${2:?uso: tarefas mover <id> <estado> [--motivo \"...\"]}"; shift 2
  local motivo="" elo="" decisao="" q=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --motivo)       motivo="${2:?--motivo pede texto}"; shift 2 ;;
      --englobado-em) elo="${2:?--englobado-em pede o id que absorveu}"; shift 2 ;;
      # A APOSTA (R36 da spec tarefas, card #3619): <n> é o id do comentário de decisão do
      # PRÓPRIO pai. O verbo só leva o número — quem confere que é decisão do próprio pai, é
      # do tipo certo e sustenta a aposta é a máquina (R19, D3 da arq:0127); sem ele a recusa
      # diz como informar.
      --decisao)      decisao="${2:?--decisao pede o número do comentário de decisão}"; shift 2 ;;
      # CONFIRMAÇÃO DA CASCATA (ordem do dono, 18/08/2026). O verbo não decide NADA aqui:
      # ele só carrega a declaração até a API, que é quem sabe se há filha aberta e quem
      # NOMEIA quais são na recusa. Repetir a regra do lado do CLI daria duas verdades, e a
      # que o dono veria seria a que perdeu a corrida.
      --cascata)      q="?cascata=1"; shift ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  if [ "$destino" = "em-execucao" ]; then
    _validar_unidades_plano "$id" || return 1
  fi
  # DT-35: só avisa a dona quando este mover de fato fecha a filha e faz o pai entrar em
  # `em-homologacao`. Re-mover filha já terminal ou mover com o pai já em `em-homologacao`
  # não pode reenviar a carta.
  local ja_era_terminal=0 pai_ja_em_homologacao=0
  local term_dest; term_dest=$(_estados_terminais) || term_dest='[]'
  if printf '%s' "$term_dest" | jq -e --arg e "$destino" 'index($e) != null' >/dev/null 2>&1; then
    local antes_item; antes_item=$(busca GET "/itens/$id" 2>/dev/null) || antes_item=""
    if [ -n "$antes_item" ]; then
      if [ "$(printf '%s' "$antes_item" | jq -r '.estado_natureza // ""' 2>/dev/null)" = "terminal" ] \
         || printf '%s' "$antes_item" | jq -e --argjson t "$term_dest" '(.estado // "") as $e | ($t | index($e)) != null' >/dev/null 2>&1; then
        ja_era_terminal=1
      else
        local pai_antes; pai_antes=$(printf '%s' "$antes_item" | jq -r '.pai // empty' 2>/dev/null)
        if [ -n "$pai_antes" ]; then
          local antes_pai; antes_pai=$(busca GET "/itens/$pai_antes" 2>/dev/null) || antes_pai=""
          if [ "$(printf '%s' "$antes_pai" | jq -r '.estado_derivado // ""' 2>/dev/null)" = "em-homologacao" ]; then
            pai_ja_em_homologacao=1
          fi
        fi
      fi
    fi
  fi
  local resp; resp=$(jq -n --arg e "$destino" --arg m "$motivo" --arg g "$elo" --arg d "$decisao" \
     '{estado:$e}
      + (if $m == "" then {} else {motivo:$m} end)
      + (if $g == "" then {} else {englobado_em:($g|tonumber)} end)
      + (if $d == "" then {} else {decisao:($d|tonumber)} end)' \
    | envia PATCH "/itens/$id$q") || return 1
  # #4250: a filha movida junto é task quando o item é story, e a API a devolve só com o id; o
  # mapa vem do detalhe do item, lido só quando houve filha movida.
  local mapa='{}'
  if printf '%s' "$resp" | jq -e '((.propagacao.movidas // []) | length) > 0' >/dev/null 2>&1; then
    mapa=$(mapa_de "$id")
  fi
  printf '%s' "$resp" | jq -r --argjson m "$mapa" "$JQ_ROT"'"item \(rotn) → "
             + (if .estado_derivado != null
                then "\(.estado_derivado) [derivado; cru: \(.estado_nome)]"
                else .estado_nome
                end)
             + ": \(.titulo)"
             + (if ((.propagacao.movidas // []) | length) > 0
                then "\n  filhas movidas junto: " + ((mapa_chaves + $m) as $mm | [.propagacao.movidas[] | rotx($mm)] | join(", "))
                else "" end)'
  # Se o item estiver travado por bloqueador aberto e entrou em em-execucao (card #3750):
  if [ "$destino" = "em-execucao" ]; then
    local bpor
    bpor=$(printf '%s' "$resp" | jq -c '.bloqueado_por // empty' 2>/dev/null)
    if [ -z "$bpor" ]; then
      local ji
      ji=$(busca GET "/itens/$id" 2>/dev/null) || ji=""
      [ -n "$ji" ] && bpor=$(printf '%s' "$ji" | jq -c '.bloqueado_por // empty' 2>/dev/null)
    fi
    if [ -n "$bpor" ] && [ "$bpor" != "[]" ]; then
      local term; term=$(_estados_terminais) || term='[]'
      local travada
      travada=$(printf '%s' "$bpor" | jq -r --argjson term "$term" "$JQ_ROT"'
        [.[] | select(.estado as $e | ($term | index([$e])) == null)]
        | if length > 0
          then "  travada por: " + ([.[] | "\(rot) (\(.estado))"] | join(", "))
          else empty
          end')
      [ -n "$travada" ] && printf '%s\n' "$travada"
    fi
  fi
  # Tem pai → o relato precisa do pai (arq:0095). Sai sempre, em qualquer destino: a story
  # que entra em `em-execucao` também tem de saber quantas irmãs faltam.
  local pai; pai=$(printf '%s' "$resp" | jq -r '.pai // empty')
  [ -n "$pai" ] && pai_e_irmas "$pai"
  # PONTEIRO DO PROCESSO DO ESTÁGIO (card #4359): só aqui, no caminho de sucesso, depois do pai e das
  # irmãs; a recusa já saiu em `envia` e nunca chega a esta linha. Nível e estado vêm do retorno do PATCH,
  # que os traz; sem eles não há ponteiro. A consulta nunca muda o código de saída.
  local nivel_novo estado_novo
  nivel_novo=$(printf '%s' "$resp" | jq -r '.nivel_nome // empty' 2>/dev/null) || nivel_novo=""
  estado_novo=$(printf '%s' "$resp" | jq -r '.estado // empty' 2>/dev/null) || estado_novo=""
  ponteiro_do_estagio "$nivel_novo" "$estado_novo"
  # AVISO À DONA (ordem do dono, 27/09/2026): fechou a última filha e o pai parou em
  # `em-homologacao` — a conferência da feature/épico é da gestão estratégica ou da cadeira
  # dona dele, e depois do dono. Quem executou a story nem sempre é a dona; sem o aviso, o dono pedia à mão.
  if [ -n "$pai" ] && [ "$(printf '%s' "$resp" | jq -r '.estado_natureza // ""')" = "terminal" ] \
     && [ "$ja_era_terminal" -eq 0 ] && [ "$pai_ja_em_homologacao" -eq 0 ]; then
    avisa_dona "$pai" "$id"
  fi
  # Story #4342: o próprio ato grava escopo_atual na lousa por HSET atômico.
  if [ -n "${PF_SESSAO:-}" ] && [[ "$id" =~ ^[0-9]+$ ]]; then
    local lousa_py
    lousa_py="$(dirname "$(readlink -f "$0")")/../lib/postura/lousa.py"
    [ -f "$lousa_py" ] && python3 "$lousa_py" gravar-sessao escopo_atual "card:${id}" >/dev/null 2>&1 || true
  fi
  return 0
}

# avisa_dona <pai> <filha> -- pai em `em-homologacao` derivado: manda à cadeira dona do pai
# um pedido de conferência pela fila. Não derruba o `mover`: o card já andou; falha do aviso
# se declara na saída.
avisa_dona() {
  local pai; pai=$(so_id "$1"); local filha="$2" j
  j=$(busca GET "/itens/$pai") || return 0
  [ "$(printf '%s' "$j" | jq -r '.estado_derivado // ""')" = "em-homologacao" ] || return 0
  local dona; dona=$(printf '%s' "$j" | jq -r '.cadeira // ""')
  dona="${dona#claudinho-}"; dona="${dona#claudinha-}"; dona=$(printf '%s' "$dona" | tr 'A-Z' 'a-z')
  local eu="${QUEM#claudinho-}"; eu="${eu#claudinha-}"
  local nivel titulo; nivel=$(printf '%s' "$j" | jq -r '.nivel_nome'); titulo=$(printf '%s' "$j" | jq -r '.titulo')
  # #4250: a filha que fecha a story é task, e a carta a nomeia como `t<n>`, nunca pelo id.
  local nome_filha; nome_filha=$(rotulo_de "$filha")
  # QUEM CONFERE (dono, 27/09/2026): a conferência do pai com o dono é da gestão
  # estratégica, gestora do portfólio; a cadeira dona do card também pode, e nenhuma outra.
  # O aviso vai às duas; quem chamou o `mover` lê a linha aqui mesmo, sem carta.
  local destinos="gestao-estrategica"
  [ -n "$dona" ] && [ "$dona" != "gestao-estrategica" ] && destinos="$destinos $dona"
  local fila_bin="${PF_FILA_BIN:-$(dirname "$(readlink -f "$0")")/fila}"
  local d out
  for d in $destinos; do
    if [ "$d" = "$eu" ]; then
      printf '  pai #%s em em-homologacao: a conferência é sua — rode o `Sai quando:` e leve a linha ENTREGA: ao dono\n' "$pai"
      continue
    fi
    if [ ! -x "$fila_bin" ]; then
      printf '  aviso de conferência (%s) NÃO enviado: verbo fila ausente em %s\n' "$d" "$fila_bin"
      continue
    fi
    if out=$(printf 'A última filha aberta de #%s (%s: %s) fechou com %s. %s está em em-homologacao e espera a conferência (gestão estratégica, ou a cadeira dona do card): rode o `Sai quando:` (feature) ou confira a `Medida:` (épico), comente o retorno no card e leve a linha ENTREGA: ao dono. Se faltar coisa, abra a story que falta — o pai volta a em-execucao sozinho.\n' \
          "$pai" "$nivel" "$titulo" "$nome_filha" "$([ "$nivel" = feature ] && echo "A feature" || echo "O $nivel")" \
        | "$fila_bin" enviar "$d" --tipo pedido --assunto "#$pai em homologação: conferência antes do dono" --ref "#$pai" 2>&1); then
      printf '  aviso de conferência enviado: %s (%s)\n' "$d" "$(printf '%s' "$out" | head -1)"
    else
      printf '  aviso de conferência (%s) NÃO enviado: %s\n' "$d" "$(printf '%s' "$out" | head -1)"
    fi
  done
  return 0
}

# `fechar` CONTINUA EXISTINDO PARA FECHAR, e deixa de ser a porta de mover. Não morre: 145
# itens do acervo e os scripts da fita chamam por ele, e matar um verbo em uso para corrigir
# um nome é trocar um defeito de descoberta por uma quebra. `--como` com estado NÃO terminal
# passa a avisar e a delegar — o aviso vai a stderr, então nada que consome a saída quebra.
apagar() {
  # Ordem do dono, 17/08/2026: apagar card é caso de uso comum, não escotilha. A única
  # guarda é o miolo do fluxo, e quem a aplica é a API — este verbo não repete regra.
  local id; id=$(so_id "$1"); shift || true
  local q=""
  [ "${1:-}" = "--cascata" ] && q="?cascata=1"
  # #4250: o mapa id → chave sai antes do DELETE, porque depois dele o item não se lê mais.
  local mapa; mapa=$(mapa_de "$id")
  busca DELETE "/itens/$id$q" \
    | jq -r --argjson m "$mapa" "$JQ_ROT"'"apagado(s): \(.quantos)", (.apagados[]? | "  \(rotx($m)) [\(.estado)] \(.titulo)")'
}

fechar() {
  local digitado="$1" id; id=$(so_id "$1"); shift || true
  local como="entregue"
  [ "${1:-}" = "--como" ] && { como="$2"; shift 2; }
  if ! busca GET "/registro" \
       | jq -e --arg e "$como" '.estados[]? | select(.estado==$e and .natureza=="terminal")' \
       >/dev/null 2>&1; then
    echo "aviso: \`$como\` não é estado terminal — \`fechar\` fecha; para mover pelo fluxo use \`tarefas mover $digitado $como\`" >&2
  fi
  mover "$id" "$como" "$@"
}

# O MOLDE DE CARD MORA NA API (card #4058, incidente de 30/10/2026): `platafirma-rastreador@
# api/molde.py` é a fonte única, servida em `GET /modelo/<variante>`. Este verbo só imprime o
# que vem dela: o esqueleto em stdout (é o que se copia para o corpo) e o aviso em stderr.
# Nenhuma cópia do molde mora aqui.
modelo() {
  local variante=""
  case "${1:-}" in
    épico|epico) variante=epico ;;
    feature)     variante=feature ;;
    task)        variante=task ;;
    story)
      case "${2:-}" in
        '')                                    variante=story ;;
        refinada|em-refinamento-tecnico|plano) variante=story-refinada ;;
        derivada)                              variante=story-derivada ;;
        *) echo "uso: tarefas modelo story [refinada|derivada]   (o Plano é exigido na entrada de em-execucao)" >&2; exit 2 ;;
      esac ;;
    comentario|comentário)
      case "${2:-}" in
        insumo|pergunta|buraco|requisito) variante="comentario-$2" ;;
        decisão|decisao)                  variante=comentario-decisao ;;
        *) echo "uso: tarefas modelo comentario <insumo|pergunta|buraco|requisito|decisão>" >&2; exit 2 ;;
      esac ;;
    *) echo "uso: tarefas modelo <épico|feature|story|task> | story refinada | story derivada | comentario <tipo>" >&2; exit 2 ;;
  esac
  local j; j=$(busca GET "/modelo/$variante") || return 1
  if [ "$variante" = "story-refinada" ]; then
    # DTs 404 e 592: se o molde servido trouxer tabela de Unidades desalinhada (ex.: `escreve` sem
    # coluna `arquivos` ou `escreve <repo@caminho>` dentro da célula de caminhos), normaliza para
    # que `modelo story refinada` e o gate de `mover em-execucao` falem a mesma coluna `arquivos`.
    MODELO_JSON="$j" python3 -c '
import json, os, re, sys
j = json.loads(os.environ["MODELO_JSON"])
t = j.get("texto") or ""
if "Unidades" in t:
    t = re.sub(r"\|\s*#\s*\|\s*unidade\s*\|\s*escreve\s*\|", "| # | escreve | arquivos |", t, flags=re.I)
    t = re.sub(r"\|\s*escreve\s*:\s*(<[^|>]+>)", r"| \1", t, flags=re.I)
sys.stdout.write(t)
'
  else
    printf '%s' "$j" | jq -j '.texto'
  fi
  local aviso; aviso=$(printf '%s' "$j" | jq -r '.aviso // empty')
  [ -n "$aviso" ] && printf '%s\n' "$aviso" >&2
  return 0
}

# Filho declara o pai, e o pai tem de ser de nível estritamente MENOR — a restrição é do
# banco (`pai_nivel`, escrito por subconsulta), não deste verbo. Recusa vem nomeada da API.
subtarefa() {
  local sem_pai=0 a1="${1:-}" a2="${2:-}"
  if [ "$a1" = "--sem-pai" ]; then
    sem_pai=1; a1="$a2"; a2=""
  elif [ "$a2" = "--sem-pai" ]; then
    sem_pai=1; a2=""
  fi
  local id; id=$(so_id "${a1:?uso: tarefas sub <pai> [<filho>] | tarefas sub <filho> --sem-pai}")
  if [ "$sem_pai" -eq 1 ]; then
    jq -n '{pai:null}' | envia PATCH "/itens/$id" >/dev/null
    echo "item $(rotulo_de "$id" n) agora está sem pai"
    return 0
  fi
  if [ -z "$a2" ]; then
    local j; j=$(busca GET "/itens/$id") || return 1
    _lembra_pai "$id"
    printf '%s' "$j" | jq -r "$JQ_ROT"'
      .filhas[]? | "\(rot)\t\(.estado)\t\(.cadeira // "—")\t\(.titulo)"'
    return 0
  fi
  local filho; filho=$(so_id "$a2")
  jq -n --argjson p "$id" '{pai:$p}' | envia PATCH "/itens/$filho" >/dev/null
  echo "item $(rotulo_de "$filho" n) agora é filho de $(rotulo_de "$id" n)"
}

apagar_comentario() {
  local id cid
  id=$(so_id "${1:?uso: tarefas apagar-comentario <id> <cid>}")
  cid=$(so_id "${2:?uso: tarefas apagar-comentario <id> <cid>}")
  local nome; nome=$(rotulo_de "$id" n)
  busca DELETE "/itens/$id/comentarios/$cid" | jq -r --arg it "$nome" '"comentário #\(.apagado) apagado do item \($it)"'
}

# --- débito técnico ---------------------------------------------------------

# BALDE DE DÉBITO TÉCNICO — padrao rito-debito-tecnico, assinado pelo dono em 26/08/2026
# (card #179). DT é defeito ou dívida MEDIDA que não bloqueia ninguém hoje.
#
# O BALDE É DADO DO RASTREADOR, E NÃO TEXTO DE CARD (R26 da spec tarefas; cards #3551 e #3552).
# Cada débito é uma linha da tabela `balde`, com o número que já tinha no corpo do #2856 (ordem
# do dono, 27/09/2026, card #3175: um balde só, uma linha por débito, sem card por conserto). O
# verbo é cliente fino: a forma de cada campo, o jeito de saída e a segunda saída quem confere é
# a API (`api/balde.py`). O que fica aqui é o que ela não vê, a stack contra o catálogo do
# acervo (R11), e a tabela que a cadeira lê.
#
# O rito mora neste verbo: `admitir` recusa sem medição (rito §1) e sem os campos que deixam a
# linha pronta para um modelo barato consertar; `matar` tira a linha por um de três jeitos
# (R12), e cada jeito exige a âncora que lhe cabe, porque nenhuma saída é silenciosa. Card
# próprio só nasce pelo jeito `englobada`, e quem o cria é a cadeira que assume, com o verbo
# `criar`.

# O catálogo de stacks é do acervo (`acervo stack ver`, a mesma fonte do deploy), um nome por
# linha. Catálogo que não responde sai 5, «não deu para olhar», e não «stack inventada»: dizer
# que a stack não existe porque a fonte está fora é a falha que a R13 proíbe para o rastreador.
_dt_stacks() {
  local acervo_bin="${PF_ACERVO_BIN:-$(dirname "$(readlink -f "$0")")/acervo}" j
  if [ ! -x "$acervo_bin" ]; then
    echo "catálogo de stacks fora do ar: verbo acervo ausente em $acervo_bin" >&2
    return 5
  fi
  j=$("$acervo_bin" stack ver --json 2>/dev/null) || {
    echo "catálogo de stacks fora do ar: acervo stack ver --json falhou" >&2
    return 5
  }
  j=$(printf '%s' "$j" | jq -r '.[].slug' 2>/dev/null) || j=""
  if [ -z "$j" ]; then
    echo "catálogo de stacks fora do ar: acervo stack ver --json voltou sem stack" >&2
    return 5
  fi
  printf '%s\n' "$j"
}

# A tabela das linhas: número, idade em dias pela data da medição, stack e o texto. A API devolve
# as abertas da mais antiga para a mais nova (R27) e a tabela guarda essa ordem. Raio, esperado e
# onde só se acrescentam quando o texto da linha ainda não os traz: as linhas de antes da F6 têm os
# três no texto, e repeti-los dobrava a linha (#2856 linha 316). `curto` tira
# raio, esperado e onde, que são o que faz a lista inteira passar dos 50 KB que a porta serve
# (#2856 linha 143); a saída leva o jeito e a âncora. Sem linha, não imprime nada.
# DT 271: calcula o tamanho do corpo do balde (#2856) em KiB e emite AVISO acima de 100 KiB.
_dt_balde_kib() { # _dt_balde_kib <json_balde> [consultar_item=0|1]
  local j="${1:-}" consultar="${2:-0}" bytes="" b_j=0 b_it=0 item_j="" desc=""
  bytes=$(printf '%s' "$j" | jq -r '.corpo_bytes // .tamanho_bytes // .bytes // empty' 2>/dev/null || true)
  if ! [[ "$bytes" =~ ^[0-9]+$ ]]; then
    b_j=$(printf '%s' "$j" | wc -c | tr -d '[:space:]')
    if [ "$consultar" = "1" ]; then
      item_j=$(curl -fsS "$BASE/itens/2856" 2>/dev/null || true)
      if [ -n "$item_j" ]; then
        desc=$(printf '%s' "$item_j" | jq -r '.descricao // .corpo // empty' 2>/dev/null || true)
        [ -n "$desc" ] && b_it=$(printf '%s' "$desc" | wc -c | tr -d '[:space:]')
      fi
    fi
    bytes="$b_j"
    [ "${b_it:-0}" -gt "${bytes:-0}" ] && bytes="$b_it"
  fi
  local kib=$(( (bytes + 1023) / 1024 ))
  printf 'corpo #2856: %s KiB\n' "$kib"
  if [ "$kib" -gt 100 ]; then
    printf 'AVISO: balde de DTs com %s KiB (teto 100 KiB)\n' "$kib"
  fi
}

_dt_tabela() { # _dt_tabela <situacao> <stack|""> <desde> <curto 0|1> <idade-minima> [<tipo>]
  local q="situacao=$1" j rows
  [ -n "$2" ] && q="$q&stack=$2"
  [ -n "${6:-}" ] && q="$q&tipo=$6"
  j=$(busca GET "/balde?$q") || return 1
  rows=$(printf '%s' "$j" | jq -r --argjson desde "${3:-0}" --argjson curto "$4" --argjson minima "$5" '
    def uma: gsub("[\\t\\r\\n]+"; " ");
    def parte($rotulo; $v): if $v == null or $v == "" then "" else " · " + $rotulo + ": " + ($v | uma) end;
    .linhas[] | select(.numero >= $desde and .idade_dias > $minima)
    | (.texto | uma) as $t
    | "\(.numero)\t\(.idade_dias)d\t\(.stack)\t"
      + (if $curto == 1 then ($t | if length <= 200 then . else .[0:199] + "…" end)
         else $t
              + parte("Tipo"; (if .tipo != null and .tipo != "" and .tipo != "debito-tecnico" then .tipo else null end))
              + parte("Raio"; (.raio // [] | map(uma) | map(select(. as $r | ($t | contains($r)) | not)) | join(", ")))
              + parte("Esperado"; (.esperado as $e | if $e == null or $e == "" or ($t | contains($e | uma)) then null else $e end))
              + parte("Onde"; (.onde as $o | if $o == null or $o == "" or ($t | contains($o | uma)) then null else $o end))
              + (if .saida_jeito then " · saiu " + .saida_jeito + ": " + (.saida_ancora | uma) else "" end)
         end)') || return 1
  if [ -n "$rows" ]; then
    printf 'n\tidade\tstack\tdébito\n%s\n' "$rows"
    if [ "$4" = "1" ]; then
      _dt_balde_kib "$j" 1
    fi
  fi
  return 0
}

dt_listar() {
  # --desde <n> e --curto (#2856 linha 143): a lista inteira passa dos 50 KB que a porta serve.
  local desde="" curto=0 stack="" situacao=abertas linha="" tipo="${TAREFAS_BALDE_TIPO:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --linha) [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]] || { echo "--linha exige um número" >&2; return 2; }; linha="$2"; shift 2 ;;
      --desde) [ $# -ge 2 ] || { echo "--desde exige o número da linha: tarefas dt listar --desde <n>" >&2; exit 2; }; desde="$2"; shift 2 ;;
      --curto) curto=1; shift ;;
      --stack) [ $# -ge 2 ] || { echo "--stack exige o nome da stack: tarefas dt listar --stack <stack>" >&2; exit 2; }; stack="$2"; shift 2 ;;
      --situacao) [ $# -ge 2 ] || { echo "--situacao exige abertas, saidas ou todas" >&2; exit 2; }; situacao="$2"; shift 2 ;;
      --tipo) [ $# -ge 2 ] || { echo "--tipo exige debito-tecnico, achado ou desvio" >&2; exit 2; }; tipo="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1 (uso: tarefas dt listar [--stack <s>] [--tipo debito-tecnico|achado|desvio] [--desde <n>] [--curto] [--situacao abertas|saidas|todas])" >&2; exit 2 ;;
    esac
  done
  case "$desde" in
    '') ;;
    *[!0-9]*) echo "--desde exige o número da linha: tarefas dt listar --desde <n>" >&2; exit 2 ;;
  esac
  case "$stack" in
    '') ;;
    *[!a-z0-9-]*) echo "--stack é um nome de stack, em minúsculas e sem espaço: $stack" >&2; exit 2 ;;
  esac
  case "$situacao" in
    abertas|saidas|todas) ;;
    *) echo "--situacao é abertas, saidas ou todas: $situacao" >&2; exit 2 ;;
  esac
  # ROTA FECHADA (incidente #4424): o débito que saiu (resolvida, cancelada, englobada) está fora do
  # funil, como o card terminal: não aparece em leitura do verbo, sob hipótese nenhuma (ordem do
  # dono, 17/11/2026). `saidas` e `todas` seguem aceitas pela gramática, para o erro dizer o que
  # fazer, e recusam antes de qualquer chamada à API.
  if [ "$situacao" != abertas ]; then
    echo "recusado: débito que saiu (resolvida, cancelada, englobada) está fora do funil e não aparece em leitura do verbo tarefas; --situacao $situacao serviria esses débitos. Leia os abertos: tarefas dt listar [--situacao abertas]" >&2
    return 4
  fi
  case "$tipo" in
    ''|debito-tecnico|achado|desvio) ;;
    *) echo "--tipo é debito-tecnico, achado ou desvio: $tipo" >&2; exit 2 ;;
  esac
  local t
  if [ -n "$linha" ]; then
    t=$(_dt_tabela "$situacao" "$stack" 0 0 -1 "$tipo" | awk -F '\t' -v n="$linha" 'NR == 1 || $1 == n') || return 1
    [ "$(printf '%s\n' "$t" | wc -l)" -gt 1 ] || { echo "linha $linha não encontrada entre as abertas do balde (débito que saiu está fora do funil e não aparece em leitura)" >&2; return 1; }
  else
    t=$(_dt_tabela "$situacao" "$stack" "$desde" "$curto" -1 "$tipo")
  fi || return 1
  if [ -z "$t" ]; then
    local rotulo="no balde"
    [ "$situacao" = abertas ] && rotulo="aberta"
    [ "$situacao" = saidas ] && rotulo="que saiu"
    echo "(balde vazio: nenhuma linha $rotulo${stack:+ na stack $stack})"
    return 0
  fi
  if [ -n "$linha" ]; then
    printf '%s\n' "$t" | fold -s -w 160
  else
    printf '%s\n' "$t"
  fi
}

# `vencidos` É A PAUTA DA REVISÃO, GERADA (rito §2/§4): linhas acima de 30 dias pela data
# da medição. Sem montagem à mão e sem alerta: o verbo mede quando chamado, a revisão decide.
dt_vencidos() {
  local t; t=$(_dt_tabela abertas "" 0 0 30) || return 1
  if [ -z "$t" ]; then
    echo "pauta vazia: nenhuma linha acima de 30 dias no balde"
    return 0
  fi
  printf 'PAUTA DA REVISÃO: linhas acima de 30 dias (rito §2)\n%s\n' "$t"
}

# `indicadores` É A CONSULTA QUE A TELINHA DO BALDE TAMBÉM LÊ (R28): por stack, os abertos e a
# idade do mais velho; na semana, as entradas e as saídas por jeito. Nada se calcula aqui.
dt_indicadores() {
  local dias=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dias) [ $# -ge 2 ] || { echo "--dias exige o número de dias: tarefas dt indicadores --dias <n>" >&2; exit 2; }; dias="$2"; shift 2 ;;
      *) echo "opção desconhecida: $1 (uso: tarefas dt indicadores [--dias <n>])" >&2; exit 2 ;;
    esac
  done
  case "$dias" in
    '') ;;
    *[!0-9]*) echo "--dias exige o número de dias: tarefas dt indicadores --dias <n>" >&2; exit 2 ;;
  esac
  local j; j=$(busca GET "/balde/indicadores${dias:+?dias=$dias}") || return 1
  printf '%s' "$j" | jq -r '
    "stack\tabertos\tmais velho",
    (.por_stack[] | "\(.stack)\t\(.abertos)\t\(.mais_velho_dias)d (#\(.mais_velho_numero))"),
    "semana (\(.semana.dias) dias): \(.semana.entradas) entradas, \(.semana.saidas_total) saídas"
      + (if (.semana.saidas | length) > 0
         then " (" + ([.semana.saidas | to_entries[] | "\(.key) \(.value)"] | join(", ")) + ")"
         else "" end)'
  if printf '%s' "$j" | jq -e '(.corpo_bytes // .tamanho_bytes // .bytes) != null' >/dev/null 2>&1; then
    _dt_balde_kib "$j" 0
  fi
}

# `admitir` É O TESTE DE ADMISSÃO VIRANDO CÓDIGO (rito §1, R11): sem --evidencia ou sem --medido-em
# em AAAA-MM-DD, RECUSA, e sem --raio, --esperado e --stack também: a linha nasce pronta para
# execução, e o modelo barato que a conserta não reconstrói o que faltou. Suspeita não é DT:
# vira medição ou morre. A forma de cada campo é da API; a stack se confere aqui, no catálogo.
_dt_tem_ajuda() {
  local a
  for a in "$@"; do
    case "$a" in
      --ajuda|--help|-h) return 0 ;;
    esac
  done
  return 1
}

_dt_admitir_uso() {
  local codigo="${1:-2}" fd=2
  [ "$codigo" = 0 ] && fd=1
  cat >&$fd <<'FIM'
uso: tarefas dt admitir "<o que falha>" --medido-em <AAAA-MM-DD> --evidencia <onde se mediu> --raio <repo@caminho> [--raio ...] --esperado "<comportamento esperado>" --stack <stack> [--tipo debito-tecnico|achado|desvio] [--verbo <v>] [--solucao "<txt>"]
  obrigatórios: "<o que falha>", --medido-em <AAAA-MM-DD>, --evidencia <onde se mediu>, --raio <repo@caminho>, --esperado "<comportamento esperado>", --stack <stack>
FIM
  exit "$codigo"
}

dt_admitir() {
  _dt_tem_ajuda "$@" && _dt_admitir_uso 0
  local texto="${1:-}"; shift || true
  local medido_em="" evidencia="" esperado="" stack="" verbo="" solucao="" cadeira="" tipo="${TAREFAS_BALDE_TIPO:-}"
  local raios=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --medido-em) medido_em="${2:-}"; shift 2 ;;
      --evidencia) evidencia="${2:-}"; shift 2 ;;
      --raio)      raios+=("${2:-}");  shift 2 ;;
      --esperado)  esperado="${2:-}";  shift 2 ;;
      --stack)     stack="${2:-}";     shift 2 ;;
      --tipo)      tipo="${2:-}";      shift 2 ;;
      --verbo)     verbo="${2:-}";     shift 2 ;;
      --solucao)   solucao="${2:-}";   shift 2 ;;
      --cadeira)   cadeira="${2:-}";   shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$texto" ] || _dt_admitir_uso 2
  case "$tipo" in
    ''|debito-tecnico|achado|desvio) ;;
    *) echo "recusado: --tipo tem de ser debito-tecnico, achado ou desvio: $tipo" >&2; exit 2 ;;
  esac
  if [ -z "$evidencia" ]; then
    echo "recusado: DT sem --evidencia não entra. Suspeita não é DT: meça (repro, retorno colado, arquivo:linha) ou não abra. (rito §1)" >&2
    exit 2
  fi
  if ! printf '%s' "$medido_em" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
    echo "recusado: DT sem --medido-em AAAA-MM-DD não entra. A linha do rito diz o que foi medido, QUANDO e onde, e a idade da linha sai dessa data. (rito §1)" >&2
    exit 2
  fi
  if [ "${#raios[@]}" -eq 0 ]; then
    echo "recusado: DT sem --raio <repo@caminho> não entra: o raio literal, um ou mais, é onde o conserto mexe. (R11)" >&2
    exit 2
  fi
  if [ -z "$esperado" ]; then
    echo "recusado: DT sem --esperado não entra: o comportamento esperado, verificável, é o que fecha o conserto. (R11)" >&2
    exit 2
  fi
  if [ -z "$stack" ]; then
    echo "recusado: DT sem --stack não entra: a stack é posta por quem capta e não se deriva do raio. (R11)" >&2
    exit 2
  fi
  [ -z "$cadeira" ] || echo "aviso: --cadeira está deprecado e foi ignorado: a cadeira que admite vem do sujeito da chamada (PF_CADEIRA)" >&2
  local catalogo; catalogo=$(_dt_stacks) || exit $?
  if ! printf '%s\n' "$catalogo" | grep -Fxq -- "$stack"; then
    printf 'recusado: a stack `%s` não está no catálogo de stacks do acervo. Stacks do catálogo: %s. (R11)\n' \
      "$stack" "$(printf '%s' "$catalogo" | paste -sd, - | sed 's/,/, /g')" >&2
    exit 4
  fi
  local linha="${verbo:+$verbo — }$texto"
  [ -z "$solucao" ] || linha="$linha · solução: $solucao"
  local corpo r
  corpo=$(jq -nc --arg texto "$linha" --arg esperado "$esperado" --arg stack "$stack" \
            --arg medido_em "$medido_em" --arg onde "$evidencia" --arg tipo "$tipo" \
            '{texto: $texto, raio: $ARGS.positional, esperado: $esperado, stack: $stack, medido_em: $medido_em, onde: $onde} + (if $tipo == "" then {} else {tipo: $tipo} end)' \
            --args "${raios[@]}")
  r=$(printf '%s' "$corpo" | envia POST /balde) || return 1
  printf '%s' "$r" | jq -r '((if .tipo == "achado" then "achado" elif .tipo == "desvio" then "desvio" else "débito" end) + " \(.numero) admitido no balde: [\(.medido_em)] \(.texto) · stack \(.stack)")'
}

# `matar` É A SAÍDA DO RITO (§3, R12): três jeitos, nenhum silencioso, cada um com a âncora que
# lhe cabe. A API confere a forma da âncora e que o card englobador existe; segunda saída é 409.
#   resolvida  consertada; --commit <sha> do commit que consertou
#   cancelada  o objeto não existe mais, ou existe e custa mais do que dói; --motivo com o
#              retorno colado que prova, ou a decisão do dono (quem assina é ele)
#   englobada  ganhou dor e virou card, ou foi absorvida por card maior; --card <id>
# As quatro portas do rito antigo (`--porta card|obsoleto|decisao|englobado`, com `--ancora`)
# seguem aceitas, com aviso, até o guia defeito sair da tabela «a porta antiga» (card #3552).
dt_matar() {
  local n="${1:-}"; shift || true
  local como="" commit="" motivo="" card="" porta="" ancora=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --como)   como="${2:-}";   shift 2 ;;
      --commit) commit="${2:-}"; shift 2 ;;
      --motivo) motivo="${2:-}"; shift 2 ;;
      --card)   card="${2:-}";   shift 2 ;;
      --porta)  porta="${2:-}";  shift 2 ;;
      --ancora) ancora="${2:-}"; shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  case "$n" in
    ''|*[!0-9]*) echo "uso: tarefas dt matar <n> --como resolvida --commit <sha> | --como cancelada --motivo \"<txt>\" | --como englobada --card <id>" >&2; exit 2 ;;
  esac
  if [ -n "$porta" ]; then
    if [ -n "$como" ]; then
      echo "recusado: --porta é a forma antiga e não vai junto com --como; use só --como resolvida|cancelada|englobada" >&2
      exit 2
    fi
    case "$porta" in
      card|englobado) como=englobada ;;
      obsoleto)
        if [[ "$ancora" =~ ^consertado:[[:space:]]*([0-9a-f]{7,40})([^0-9a-f]|$) ]]; then
          como=resolvida; commit="${BASH_REMATCH[1]}"
        else
          como=cancelada; motivo="$ancora"
        fi ;;
      decisao) como=cancelada; motivo="$ancora" ;;
      *)
        echo "recusado: --porta é card, obsoleto, decisao ou englobado (forma antiga); use --como resolvida|cancelada|englobada" >&2
        exit 2 ;;
    esac
    echo "aviso: --porta está deprecado (guia defeito, Matar): use --como $como" >&2
  fi
  local ancora_api
  case "$como" in
    resolvida)
      [ -n "$commit" ] || { echo "recusado: resolvida exige --commit <sha>, o commit que consertou. (R12)" >&2; exit 2; }
      ancora_api="$commit" ;;
    cancelada)
      [ -n "$motivo" ] || { echo "recusado: cancelada exige --motivo: o retorno colado que mostra que o objeto não existe mais, ou a decisão do dono. Memória não ancora. (R12)" >&2; exit 2; }
      ancora_api="$motivo" ;;
    englobada)
      [ -n "$card" ] || { echo "recusado: englobada exige --card <id>, o card que assume ou engloba a linha. (R12)" >&2; exit 2; }
      ancora_api=$(so_id "$card") ;;
    '')
      echo "uso: tarefas dt matar <n> --como resolvida --commit <sha> | --como cancelada --motivo \"<txt>\" | --como englobada --card <id>" >&2
      exit 2 ;;
    *)
      echo "recusado: --como é resolvida, cancelada ou englobada, os três jeitos de sair do balde. (R12)" >&2
      exit 2 ;;
  esac
  local r
  r=$(jq -nc --arg jeito "$como" --arg ancora "$ancora_api" '{jeito: $jeito, ancora: $ancora}' \
        | envia POST "/balde/$n/saida") || return 1
  printf '%s' "$r" | jq -r '((if .tipo == "achado" then "achado" elif .tipo == "desvio" then "desvio" else "débito" end) + " \(.numero) saiu do balde: \(.saida_jeito) em \(.saida_em[0:10]): \(.saida_ancora)")'
}

dt_restack() {
  local n="${1:-}" stack="" motivo=""
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "uso: tarefas dt restack <n> --stack <s> [--motivo \"<txt>\"]" >&2; exit 2; }
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --stack)  stack="${2:?--stack pede o nome da stack}"; shift 2 ;;
      --motivo) motivo="${2:?--motivo pede texto}"; shift 2 ;;
      *) echo "tarefas dt restack: opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$stack" ] || { echo "uso: tarefas dt restack <n> --stack <s> [--motivo \"<txt>\"]" >&2; exit 2; }
  local stacks
  stacks=$(_dt_stacks) || return $?
  if ! printf '%s\n' "$stacks" | grep -Fxq "$stack"; then
    local lista; lista=$(printf '%s\n' "$stacks" | paste -sd, -)
    echo "recusado: stack '$stack' fora do catálogo do acervo (válidas: $lista). (R11)" >&2
    exit 4
  fi
  local r
  r=$(jq -nc --arg stack "$stack" '{stack: $stack}' | envia PATCH "/balde/$n") || return 1
  if [ -n "$motivo" ]; then
    printf '%s' "$r" | jq -r --arg m "$motivo" '"débito \(.numero) movido para a stack \(.stack): \($m)"'
  else
    printf '%s' "$r" | jq -r '"débito \(.numero) movido para a stack \(.stack)"'
  fi
}

_dt_uso() {
  local codigo="${1:-2}" fd=2
  [ "$codigo" = 0 ] && fd=1
  cat >&$fd <<'FIM'
uso:
  tarefas dt listar [--stack <s>] [--desde <n>] [--curto] [--situacao abertas|saidas|todas]
                                          linhas abertas do balde, as mais antigas primeiro, com a
                                          idade em dias e a stack; --desde <n> lê só da linha n em
                                          diante, --curto tira raio, esperado e onde
  tarefas dt admitir "<o que falha>" --medido-em <AAAA-MM-DD> --evidencia <onde se mediu>
                --raio <repo@caminho> [--raio ...] --esperado "<comportamento esperado>"
                --stack <stack> [--verbo <v>] [--solucao "<txt>"]
                                          acrescenta a linha numerada; SEM evidência, data, raio,
                                          esperado ou stack, RECUSA (sai 2), e stack fora do
                                          catálogo do acervo sai 4 com a lista — teste de admissão
                                          (rito §1, R11)
  tarefas dt matar <n> --como resolvida --commit <sha>
                       --como cancelada --motivo "<txt>"
                       --como englobada --card <id>
                                          tira a linha por um dos três jeitos (rito §3, R12) e a
                                          registra com a âncora e a data; cada jeito pede a sua
                                          âncora. `--porta` segue aceito, com aviso (deprecado)
  tarefas dt restack <n> --stack <s> [--motivo "<txt>"]
                                          troca a stack da linha mantendo número e idade
  tarefas dt vencidos                     pauta da revisão: linhas acima de 30 dias (rito §2)
  tarefas dt indicadores [--dias <n>]     por stack, os abertos e a idade do mais velho; na semana
                                          (7 dias, ou os de --dias), as entradas e as saídas por jeito

O balde é dado do rastreador (tabela `balde`), uma linha por débito, com o número que já
tinha no corpo do #2856. Card próprio só pelo jeito englobada.
Rito: padrao rito-debito-tecnico
FIM
  exit "$codigo"
}

dt() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    --ajuda|--help|-h) _dt_uso 0 ;;
    listar)      _dt_tem_ajuda "$@" && { echo "uso: tarefas dt listar [--stack <s>] [--desde <n>] [--curto] [--situacao abertas|saidas|todas] [--linha <n>]"; return 0; }; dt_listar "$@" ;;
    ler)         _dt_tem_ajuda "$@" && { echo "uso: tarefas dt ler <n>"; return 0; }; [ $# -eq 1 ] && [[ "$1" =~ ^[0-9]+$ ]] || { echo "uso: tarefas dt ler <n>" >&2; return 2; }; dt_listar --linha "$1" ;;
    admitir)     dt_admitir "$@" ;;
    restack)     _dt_tem_ajuda "$@" && { echo "uso: tarefas dt restack <n> --stack <s> [--motivo \"<txt>\"]"; return 0; }; dt_restack "$@" ;;
    matar)       _dt_tem_ajuda "$@" && { echo "uso: tarefas dt matar <n> --como resolvida --commit <sha> | --como cancelada --motivo \"<txt>\" | --como englobada --card <id>"; return 0; }; dt_matar "$@" ;;
    vencidos)    _dt_tem_ajuda "$@" && { echo "uso: tarefas dt vencidos"; return 0; }; dt_vencidos "$@" ;;
    indicadores) _dt_tem_ajuda "$@" && { echo "uso: tarefas dt indicadores [--dias <n>]"; return 0; }; dt_indicadores "$@" ;;
    ''|*)        _dt_uso 2 ;;
  esac
}

# --- ordem, vínculo e carteira (card #3526; R21, R23 e R25 da spec tarefas) -------------

# ORDENAR põe o card ao lado de um vizinho na ordem única da casa. O cliente escolhe a vizinhança e
# o SERVIDOR calcula o posto (card #3522): um `posto` no corpo seria o cliente calculando. Um lado
# só: com os dois o corpo não diria qual vale, e o verbo recusa antes de chamar.
ordenar() {
  local id; id=$(so_id "${1:?uso: tarefas ordenar <id> --antes-de <id> | --depois-de <id>}"); shift
  local lado="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --antes-de|--depois-de)
        [ -z "$lado" ] || { echo "recusado: --antes-de e --depois-de juntos não dizem onde o card fica; escolha um" >&2; exit 2; }
        lado="${1#--}"; lado="${lado//-/_}"
        ref=$(so_id "${2:?$1 pede o id do vizinho}"); shift 2 ;;
      *) echo "opção desconhecida: $1" >&2; exit 2 ;;
    esac
  done
  case "$id" in ''|*[!0-9]*) lado="" ;; esac
  case "$ref" in ''|*[!0-9]*) lado="" ;; esac
  [ -n "$lado" ] || { echo "uso: tarefas ordenar <id> --antes-de <id> | --depois-de <id>" >&2; exit 2; }
  local rot_ref
  rot_ref=$(rotulo_de "$ref")
  jq -n --arg l "$lado" --argjson r "$ref" '{($l): $r}' \
    | envia POST "/itens/$id/posto" \
    | jq -r --arg l "$lado" --arg r "$rot_ref" "$JQ_ROT"'
        "item \(rotn) ficou \(if $l == "antes_de" then "antes" else "depois" end) de \($r) (posto \(.posto)): \(.titulo)"'
}

# Os dois lados do vínculo de <id>, como a API os devolve ao declarar e ao retirar. A task sai como
# `t<n>` dos dois lados (#4250): o nome de <id> e o mapa id → chave das duas pontas se leem ANTES do
# ato (`_vinculos_contexto`), para a escrita ser a última chamada ao rastreador.
_vinculos_contexto() { # _vinculos_contexto <a> <b>  → "<nome de a>\t<mapa JSON>"
  local nome ma mb
  nome=$(rotulo_de "$1"); ma=$(mapa_de "$1"); mb=$(mapa_de "$2")
  printf '%s\t%s' "$nome" "$(jq -cn --argjson a "$ma" --argjson b "$mb" '$a + $b' 2>/dev/null || printf '{}')"
}

_vinculos_texto() { # _vinculos_texto <nome de id> <mapa JSON>   (JSON da API em stdin)
  local nome="$1" mapa="${2:-}"
  [ -n "$mapa" ] || mapa='{}'
  jq -r --arg nome "$nome" --argjson m "$mapa" "$JQ_ROT"'
    def lado: if ((. // []) | length) > 0 then ([.[] | rotx($m)] | join(", ")) else "ninguém" end;
    "\($nome) bloqueia: \(.bloqueia | lado)",
    "\($nome) bloqueado por: \(.bloqueado_por | lado)"'
}

# BLOQUEAR e DESBLOQUEAR (R23). O ciclo quem recusa é o banco, pela API: 409 com o caminho que o
# fecharia, e a recusa o imprime (`_recusa`). Declarar o que já existe é no-op lá.
bloquear() { # bloquear <bloqueador> <bloqueado>
  local a b
  a=$(so_id "${1:?uso: tarefas bloquear <a> <b> — <a> bloqueia <b>}")
  b=$(so_id "${2:?uso: tarefas bloquear <a> <b> — <a> bloqueia <b>}")
  case "$a$b" in ''|*[!0-9]*) echo "uso: tarefas bloquear <a> <b> — <a> bloqueia <b>" >&2; exit 2 ;; esac
  local ctx; ctx=$(_vinculos_contexto "$a" "$b")
  jq -n --argjson b "$b" '{bloqueado:$b}' | envia POST "/itens/$a/bloqueia" | _vinculos_texto "${ctx%%$'\t'*}" "${ctx#*$'\t'}"
}

desbloquear() { # desbloquear <bloqueador> <bloqueado>
  local a b
  a=$(so_id "${1:?uso: tarefas desbloquear <a> <b> — retira \"<a> bloqueia <b>\"}")
  b=$(so_id "${2:?uso: tarefas desbloquear <a> <b> — retira \"<a> bloqueia <b>\"}")
  case "$a$b" in ''|*[!0-9]*) echo "uso: tarefas desbloquear <a> <b> — retira \"<a> bloqueia <b>\"" >&2; exit 2 ;; esac
  local ctx; ctx=$(_vinculos_contexto "$a" "$b")
  busca DELETE "/itens/$a/bloqueia/$b" | _vinculos_texto "${ctx%%$'\t'*}" "${ctx#*$'\t'}"
}

# CARTEIRA (R25): o que a firma entregou na semana, por originação, e o que está parado.
#
# AGREGA NO VERBO, sobre `GET /api/itens`, sem rota nova no rastreador: a consulta direta é da F8
# (#3482). Conta story ENTREGUE (`entregue`, e `resolvido` que é o fecho do incidente) cuja
# entrada no terminal — `ultimo_movimento` — é de `--desde` em diante, fora as de origem `prova`,
# por `tipo_demanda`. A linha do balde conta as saídas do balde (`GET /api/balde`) no mesmo período e fica AO LADO,
# sem somar: débito que sai não é card entregue. As paradas são as despriorizadas, com a idade (hoje
# menos `ultimo_movimento`, em dias): sob pai apostado — o estado ESCRITO do pai direto em
# `priorizada` ou adiante, que a projeção traz em `pai_estado` —, sem pai (autônomas) e as que
# esperam um pai ainda não apostado. A lista de estados e a ordem vêm do registro.
carteira() { # carteira [--desde AAAA-MM-DD]
  local desde="" hoje="${TAREFAS_HOJE:-$(date +%F)}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --desde) desde="${2:?--desde pede AAAA-MM-DD}"; shift 2 ;;
      *) echo "opção desconhecida: $1 (uso: tarefas carteira [--desde AAAA-MM-DD])" >&2; exit 2 ;;
    esac
  done
  # Sem --desde, a segunda-feira da semana de hoje.
  [ -n "$desde" ] || desde=$(date -d "$hoje -$(( $(date -d "$hoje" +%u) - 1 )) days" +%F)
  printf '%s' "$desde" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' \
    || { echo "--desde pede AAAA-MM-DD: $desde" >&2; exit 2; }
  local lista registro balde saidas
  # Card #4223 (R25 emendado): a carteira conta só stories; a task é passo da story e não entra.
  # O portão do funil não poda esta lista: a carteira CONTA as entregues e não mostra nenhuma
  # (sai só o número por originação); as linhas que ela mostra são as paradas, que são funil.
  lista=$(_exec_curl_cru GET "/itens?nivel=2") || return 1
  registro=$(busca GET /registro) || return 1
  # As saídas se contam na API (R26: o balde é dado, não corpo de card), pela data em que a linha
  # saiu. Rastreador que não respondeu não derruba a fatia.
  if saidas=$(busca GET "/balde?situacao=saidas" 2>/dev/null \
                | jq -r --arg desde "$desde" '[.linhas[] | select((.saida_em // "")[0:10] >= $desde)] | length' 2>/dev/null) \
     && [ -n "$saidas" ]; then
    balde="  balde"$'\t'"$saidas saídas desde $desde (ao lado, não soma)"
  else
    balde="  balde"$'\t'"ilegível: o balde não se leu"
  fi
  printf '%s' "$lista" | jq -r --arg desde "$desde" --arg hoje "$hoje" --arg balde "$balde" \
      --argjson reg "$registro" '
    def entregue: .estado == "entregue" or .estado == "resolvido";
    def idade: ((($hoje | strptime("%Y-%m-%d") | mktime)
                 - ((.ultimo_movimento // $hoje)[0:10] | strptime("%Y-%m-%d") | mktime)) / 86400 | floor);
    def linha: "    #\(.id)\t\(idade)d\t\(.titulo)";
    ($reg.estados | map({key: .estado, value: .ordem}) | from_entries) as $ordem
    | ($ordem.priorizada // 0) as $aposta
    | .itens as $its
    | [$its[] | select(entregue and ((.origem // "") != "prova")
                       and ((.ultimo_movimento // "")[0:10] >= $desde))] as $ent
    | [$its[] | select(.estado == "despriorizada")] as $par
    | [$par[] | select(.pai != null and .pai_estado != null and (($ordem[.pai_estado] // 0) >= $aposta))] as $sob
    | [$par[] | select(.pai == null)] as $livres
    | [$par[] | select(.pai != null and (.pai_estado == null or (($ordem[.pai_estado] // 0) < $aposta)))] as $espera
    | "carteira desde \($desde) — stories entregues, fora de origem prova",
      (["negocio", "tecnico", "incidente"][] as $t
         | "  \($t)\t\([$ent[] | select(.tipo_demanda == $t)] | length)"),
      (([$ent[] | select(.tipo_demanda == null)] | length) as $sem
         | if $sem > 0 then "  sem originação gravada\t\($sem)" else empty end),
      $balde,
      "",
      "paradas (despriorizada): \($par | length)",
      "  sob pai apostado\t\($sob | length)", ($sob[] | linha),
      "  sem pai (autônomas)\t\($livres | length)", ($livres[] | linha),
      (if ($espera | length) > 0
       then "  sob pai ainda não apostado\t\($espera | length)", ($espera[] | linha)
       else empty end)'
}

# ESPERA-DONO (R30 da spec tarefas, cards #3595 e #3597) — a mesma consulta que a tela da F7
# (#3481) lê, em duas partes: do dono (pergunta dirigida a ele, card pronto para a aposta,
# pai em homologação) e, à parte, com as cadeiras (os demais abertos, por card, com a marca
# de órfão). Lê pela rota própria `GET /espera-dono`; o verbo não calcula nada — a mesma
# régua do R28 dos indicadores do balde.
#
# `--json` devolve o corpo da API como veio, sem reformatar: a borda o serve a casca em /api/espera-dono
# (card #3899; mecanismo comum da arq:0124 §3, `# mecanismo: espera-dono=casca`).
espera_dono() {
  local j; j=$(busca GET /espera-dono) || return 1
  case "${1:-}" in
    --json) printf '%s\n' "$j"; return 0 ;;
    "") ;;
    *) echo "uso: tarefas espera-dono [--json]" >&2; exit 2 ;;
  esac
  printf '%s' "$j" | jq -r '
    "do dono (\(.do_dono.total)):",
    (if .do_dono.total == 0 then "  nada" else empty end),
    (.do_dono.regras_pendentes // [] | .[] |
      "  regra pendente · #\(.id) [\(.cadeira // "—")] \(.titulo)",
      (.regras[] | "    - \(.)")),
    (.do_dono.perguntas[] | "  pergunta #\(.id) · #\(.item) \(.titulo) [\(.cadeira // "—")] — \(.primeira_linha)"),
    (.do_dono.prontos_para_aposta[] | "  pronto para a aposta · #\(.id) [\(.cadeira // "—")] \(.titulo)"),
    (.do_dono.em_homologacao[] | "  em homologação · #\(.id) [\(.cadeira // "—")] \(.titulo)"),
    "",
    "com as cadeiras (\(.com_cadeiras.abertos) abertos, \(.com_cadeiras.orfaos) órfãos\(if (.com_cadeiras.parados // 0) > 0 then ", \(.com_cadeiras.parados) parados" else "" end)):",
    (if (.com_cadeiras.cards | length) == 0 then "  nada" else empty end),
    (.com_cadeiras.cards[] | "  #\(.id) [\(.cadeira // "—")] \(.titulo)" + (if .orfao then " · órfão" else "" end),
      (.abertos[] | "    #\(.id) \(.tipo)" + (if .parado then " · parado" elif .orfao then " · órfão" else "" end) + " — \(.primeira_linha)"))
  '
}

# --- inventário da feature -------------------------------------------------------

# (story #4317, feature 4314; sql/033). Peça, regra de negócio e produto documental da feature
# são dado do rastreador, cada um com a chave <feature>.<p|r|d><n> (4314.r3). O verbo só fala com
# a API: o número, a validação desfeita pela frase mudada e o evento de cada ato são do banco.
# O nome do verbo e a forma de chamar dos outros atos não mudam (a feature 4268 refaz os verbos).

JQ_INV='
def porque: if .porque then "    porque: \(.porque)" else empty end;
def casos: (.casos // [])[] | "    caso: \(.)";
def mecanismo: if .mecanismo then "    mecanismo: \(.mecanismo)" else empty end;
def regra:
  "  \(.chave) · "
  + (if .cortada then "cortada"
     elif .validada then "validada (\(.validada_por), \((.validada_em // "")[0:10]))"
     else "não validada" end)
  + " · " + (if .peca_numero != null then "rege p\(.peca_numero)" else "feature inteira" end)
  + " · \(.frase)",
  porque, casos, mecanismo;
def peca:
  "  \(.chave) · \(.descricao)"
  + (if .classe_declarada then " · classe: \(.classe_declarada)" else "" end)
  + (if .sobre then " · sobre: \(.sobre)" else "" end)
  + (if .cortada then " · cortada" else "" end);
def documento:
  "  \(.chave) · \(.ato_documental // "—")/\(.natureza // "—") · \(.descricao)"
  + (if .classe_declarada then " · classe: \(.classe_declarada)" else "" end)
  + (if .sobre then " · sobre: \(.sobre)" else "" end)
  + (if .cortada then " · cortada" else "" end);
'

_inventario_na_leitura() { # <json do card>: contagens na feature; regras e documentos na story
  local j="$1" nivel
  nivel=$(printf '%s' "$j" | jq -r '.nivel // empty')
  case "$nivel" in
    1) printf '%s' "$j" | jq -r '(.inventario.linha // empty) | "\n" + .' ;;
    2) printf '%s' "$j" | jq -r "$JQ_INV"'
         (.inventario // {}) as $i
         | (if (($i.regras // []) | length) > 0
            then "", "regras que esta story cumpre:", ($i.regras[] | regra) else empty end),
           (if (($i.documentos // []) | length) > 0
            then "", "produtos documentais que esta story muda:", ($i.documentos[] | documento) else empty end)' ;;
  esac
  return 0
}

_inv_uso() {
  cat >&2 <<'FIM'
uso:
  tarefas inventario ler <feature> [--lista peca|regra|documento] [--cortados]
  tarefas inventario criar <feature> peca|regra|documento [campos]
  tarefas inventario editar <chave> [campos]
  tarefas inventario validar <chave> [--frase "<txt>"]
  tarefas inventario cortar <chave>
  tarefas inventario ligar <chave> <story>
  tarefas inventario desligar <chave> <story>
campos da peça: --descricao --classe --sobre --sem-regra
campos da regra: --frase --porque --mecanismo --caso "<caso → resultado>" (repete)
                 --peca <n> | --feature-inteira  --mora-em <n>
campos do produto documental: --descricao --classe --ato nasce|muda|sai
                 --natureza golden|referencia --escrito-por --sobre
A chave é <feature>.<p|r|d><n>, como 4314.r3. O número sai do banco; a regra sem --peca e sem
--feature-inteira é recusada; --frase em validar é a que o dono leu.
FIM
  exit 2
}

_inv_chave() { # <chave> → INV_FEATURE, INV_LETRA, INV_N e INV_LISTA
  local chave="${1:-}"
  if ! [[ "$chave" =~ ^([0-9]+)\.([prd])([0-9]+)$ ]]; then
    echo "tarefas inventario: chave inválida: '$chave' (esperado <feature>.<p|r|d><n>, como 4314.r3)" >&2
    exit 2
  fi
  INV_FEATURE="${BASH_REMATCH[1]}"; INV_LETRA="${BASH_REMATCH[2]}"; INV_N="${BASH_REMATCH[3]}"
  case "$INV_LETRA" in p) INV_LISTA=pecas ;; r) INV_LISTA=regras ;; d) INV_LISTA=documentos ;; esac
}

_inv_lista() { # o nome da lista, no singular ou no plural → o plural da API
  case "${1:-}" in
    peca|pecas|peça|peças) printf 'pecas' ;;
    regra|regras) printf 'regras' ;;
    documento|documentos|produto-documental) printf 'documentos' ;;
    *) echo "tarefas inventario: lista desconhecida: '${1:-}' (peca, regra ou documento)" >&2; exit 2 ;;
  esac
}

_inv_campo() { # <json> <campo> <valor em texto> → o json com o campo
  jq -c --arg k "$2" --arg v "$3" '. + {($k): $v}' <<<"$1"
}

_inv_campos() { # as flags de campo viram o corpo JSON do item
  local json='{}' casos='[]' campo
  while [ $# -gt 0 ]; do
    case "$1" in
      --descricao)  json=$(_inv_campo "$json" descricao "${2:?--descricao pede o texto}"); shift 2 ;;
      --classe)     json=$(_inv_campo "$json" classe_declarada "${2:?--classe pede a classe}"); shift 2 ;;
      --sobre)      json=$(_inv_campo "$json" sobre "${2:?--sobre pede <classe>:<chave>}"); shift 2 ;;
      --frase)      json=$(_inv_campo "$json" frase "${2:?--frase pede o texto}"); shift 2 ;;
      --porque)     json=$(_inv_campo "$json" porque "${2:?--porque pede o texto}"); shift 2 ;;
      --mecanismo)  json=$(_inv_campo "$json" mecanismo "${2:?--mecanismo pede o texto}"); shift 2 ;;
      --ato)        json=$(_inv_campo "$json" ato_documental "${2:?--ato pede nasce, muda ou sai}"); shift 2 ;;
      --natureza)   json=$(_inv_campo "$json" natureza "${2:?--natureza pede golden ou referencia}"); shift 2 ;;
      --escrito-por) json=$(_inv_campo "$json" escrito_por "${2:?--escrito-por pede a cadeira}"); shift 2 ;;
      --caso)       casos=$(jq -c --arg v "${2:?--caso pede o texto}" '. + [$v]' <<<"$casos"); shift 2 ;;
      --peca|--mora-em)
        campo="${1#--}"; campo="${campo//-/_}"
        [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "tarefas inventario: $1 pede o número do item na lista" >&2; exit 2; }
        json=$(jq -c --arg k "$campo" --argjson v "$2" '. + {($k): $v}' <<<"$json"); shift 2 ;;
      --sem-regra)  json=$(jq -c '. + {sem_regra: true}' <<<"$json"); shift ;;
      --feature-inteira) json=$(jq -c '. + {feature_inteira: true}' <<<"$json"); shift ;;
      *) echo "tarefas inventario: campo desconhecido: $1" >&2; exit 2 ;;
    esac
  done
  [ "$casos" = '[]' ] || json=$(jq -c --argjson c "$casos" '. + {casos: $c}' <<<"$json")
  printf '%s' "$json"
}

inv_ler() {
  local feature="" lista="" cortados=0 q=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --lista)    lista=$(_inv_lista "${2:?--lista pede peca, regra ou documento}"); shift 2 ;;
      --cortados) cortados=1; shift ;;
      *)
        if [ -z "$feature" ]; then feature=$(so_id "$1"); shift
        else echo "tarefas inventario ler: argumento desconhecido: $1" >&2; exit 2; fi ;;
    esac
  done
  [ -n "$feature" ] || _inv_uso
  [ -z "$lista" ] || q="?lista=$lista"
  if [ "$cortados" -eq 1 ]; then
    if [ -n "$q" ]; then q="$q&cortados=1"; else q="?cortados=1"; fi
  fi
  local j; j=$(busca GET "/itens/$feature/inventario$q") || return 1
  printf '%s' "$j" | jq -r "$JQ_INV"'
    .linha,
    (.itens
     | (if ((.pecas // []) | length) > 0 then "", "peças:", (.pecas[] | peca) else empty end),
       (if ((.regras // []) | length) > 0 then "", "regras:", (.regras[] | regra) else empty end),
       (if ((.documentos // []) | length) > 0 then "", "produtos documentais:", (.documentos[] | documento) else empty end))'
}

inv_criar() {
  [ $# -ge 2 ] || _inv_uso
  local feature lista corpo
  feature=$(so_id "$1"); lista=$(_inv_lista "$2"); shift 2
  corpo=$(_inv_campos "$@")
  printf '%s' "$corpo" | envia POST "/itens/$feature/inventario/$lista" | jq -r '"\(.chave) criado"'
}

inv_editar() {
  [ $# -ge 1 ] || _inv_uso
  _inv_chave "$1"; shift
  local corpo; corpo=$(_inv_campos "$@")
  printf '%s' "$corpo" | envia PATCH "/itens/$INV_FEATURE/inventario/$INV_LISTA/$INV_N" \
    | jq -r '"\(.chave) editado" + (if .validada == false then " · não validada" else "" end)'
}

inv_validar() {
  [ $# -ge 1 ] || _inv_uso
  _inv_chave "$1"; shift
  [ "$INV_LETRA" = r ] || { echo "tarefas inventario validar: só regra se valida" >&2; exit 2; }
  local frase="" corpo='{}'
  while [ $# -gt 0 ]; do
    case "$1" in
      --frase) frase="${2:?--frase pede a frase que o dono leu}"; shift 2 ;;
      *) echo "tarefas inventario validar: argumento desconhecido: $1" >&2; exit 2 ;;
    esac
  done
  [ -z "$frase" ] || corpo=$(jq -cn --arg f "$frase" '{frase: $f}')
  printf '%s' "$corpo" | envia POST "/itens/$INV_FEATURE/inventario/regras/$INV_N/validar" \
    | jq -r '"\(.chave) validada por \(.validada_por) em \(.validada_em)"'
}

inv_cortar() {
  [ $# -eq 1 ] || _inv_uso
  _inv_chave "$1"
  printf '{}' | envia POST "/itens/$INV_FEATURE/inventario/$INV_LISTA/$INV_N/cortar" | jq -r '"\(.chave) cortado"'
}

_inv_story() { # <story> → o número dela, ou sai 2
  local story; story=$(so_id "${1:-}")
  [[ "$story" =~ ^[0-9]+$ ]] || { echo "tarefas inventario: a story é o número dela: '${1:-}'" >&2; exit 2; }
  printf '%s' "$story"
}

inv_ligar() {
  [ $# -eq 2 ] || _inv_uso
  _inv_chave "$1"
  local story; story=$(_inv_story "$2")
  jq -cn --argjson s "$story" '{story: $s}' \
    | envia POST "/itens/$INV_FEATURE/inventario/$INV_LISTA/$INV_N/stories" \
    | jq -r --arg s "$story" '"\(.chave) ligada à story \($s)"'
}

inv_desligar() {
  [ $# -eq 2 ] || _inv_uso
  _inv_chave "$1"
  local story; story=$(_inv_story "$2")
  busca DELETE "/itens/$INV_FEATURE/inventario/$INV_LISTA/$INV_N/stories/$story" \
    | jq -r --arg s "$story" '"\(.chave) desligada da story \($s)"'
}

inventario() {
  local sub="${1:-}"
  [ $# -eq 0 ] || shift
  case "$sub" in
    ler)      inv_ler "$@" ;;
    criar)    inv_criar "$@" ;;
    editar)   inv_editar "$@" ;;
    validar)  inv_validar "$@" ;;
    cortar)   inv_cortar "$@" ;;
    ligar)    inv_ligar "$@" ;;
    desligar) inv_desligar "$@" ;;
    *)        _inv_uso ;;
  esac
}

# --- despacho ---------------------------------------------------------------

# --ajuda UNIVERSAL, sem efeito colateral (card #2274, defeito 4). ANTES do despacho e
# varrendo TODOS os argumentos: `tarefas criar --ajuda` criava um card chamado "--ajuda"
# porque `--ajuda` caía como título posicional. Interceptar aqui cobre tanto `tarefas
# --ajuda` quanto `tarefas <sub> --ajuda`, e nenhum sub-ato chega a rodar. `uso` já sai 2.
# Exceção (DT #682): `tarefas dt ...` trata `--ajuda` dentro do subcomando para imprimir
# o uso específico de `dt` ou do sub-ato (`dt admitir --ajuda`, etc.).
if [ "${1:-}" != "dt" ] && [ "${1:-}" != "achado" ] && [ "${1:-}" != "desvio" ]; then
  for _a in "$@"; do
    case "$_a" in
      --ajuda|--help|-h) uso 0 ;;
    esac
  done
fi

cmd="${1:-}"; shift || uso

# Portão do funil (ordem do dono, 17/11/2026): ligado em todo ato que só lê card. `sub` liga
# só quando lista as filhas (um argumento); `api` e `api-corpo`, só em GET.
case "$cmd" in
  listar|listar-tudo|ler|ver|comentarios|carteira|espera-dono) _SO_FUNIL=1 ;;
  sub) if [ $# -eq 1 ] && [ "${1:-}" != "--sem-pai" ]; then _SO_FUNIL=1; fi ;;
  api|api-corpo) _m="${1:-}"; if [ "${_m^^}" = GET ]; then _SO_FUNIL=1; fi ;;
esac

case "$cmd" in
  listar)      descarta_projeto "${1:-}" && shift; listar "$@" ;;
  listar-tudo) descarta_projeto "${1:-}" && shift; listar_tudo "$@" ;;
  ler|ver)     ler "$@" ;;
  criar)       criar "$@" ;;
  editar)      editar "$@" ;;
  comentar)    comentar "$@" ;;
  comentarios) comentarios "$@" ;;
  mover)       mover "$@" ;;
  fechar)      fechar "${1:?uso: tarefas fechar <id>}" "${@:2}" ;;
  apagar)      apagar "${1:?uso: tarefas apagar <id> [--cascata]}" "${@:2}" ;;
  apagar-comentario) apagar_comentario "${1:?uso: tarefas apagar-comentario <id> <cid>}" "${2:?cid}" ;;
  assinar)     assinar "${1:?uso: tarefas assinar <id> --aprovador <cadeira> [--decisao aprovado|recusado] [--motivo \"<txt>\"]}" "${@:2}" ;;
  sub)         subtarefa "${1:?uso: tarefas sub <pai> [<filho>]}" "${2:-}" ;;
  ordenar)     ordenar "${1:?uso: tarefas ordenar <id> --antes-de <id> | --depois-de <id>}" "${@:2}" ;;
  bloquear)    bloquear "${1:?uso: tarefas bloquear <a> <b>}" "${2:?uso: tarefas bloquear <a> <b>}" ;;
  desbloquear) desbloquear "${1:?uso: tarefas desbloquear <a> <b>}" "${2:?uso: tarefas desbloquear <a> <b>}" ;;
  carteira)    carteira "$@" ;;
  inventario)  inventario "$@" ;;
  espera-dono) espera_dono "$@" ;;
  modelo)      modelo "${1:-}" "${2:-}" ;;
  estados)     estados ;;
  dt)          dt "$@" ;;
  achado)      TAREFAS_BALDE_TIPO=achado dt "$@" ;;
  desvio)      TAREFAS_BALDE_TIPO=desvio dt "$@" ;;
  projetos)    echo "não há projeto neste modelo: o recorte é por eixo (cadeira, estado, nível)." >&2; exit 2 ;;
  api)         busca "${1:?método}" "$(_apipath "${2:?caminho}")" ;;
  api-corpo)   envia "${1:?método}" "$(_apipath "${2:?caminho}")" ;;
  # fora da porta, de propósito (#4119): fora de `atos:`, chama-se pelo malote
  psql)        exec "$(dirname "$(readlink -f "$0")")/_tarefas/psql" "$@" ;;
  *)           uso ;;
esac
