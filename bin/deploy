#!/usr/bin/env bash
# deploy — promove ao ar o que esta declarado no compose de uma stack.
# capacidade: mudanca
# dono: claudinho-TI
# use para: subir stack, promover ref, rotas do túnel, segredos, reverter
# atos: ato=<stack> e args=up / down / ps / logs / config / pull / build / promover / rotas / acessos / segredos / reverter; sem ato lista as stacks
# forma: log
# cauda: sim
# ambiente: PF_RELEASE_RAIZ[=/opt/platafirma] · PLATAFIRMA_RELEASE[=$PF_RELEASE_RAIZ/current] · PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] · DEPLOY_PONTOS[=$PLATAFIRMA_INSTANCIA/var/deploy] · DEPLOY_ENV_DIR[=$XDG_RUNTIME_DIR/platafirma, /run/user/<uid>/platafirma] · DEPLOY_TOPO_ARQUIVO (diagnostico) · DOCKER_HOST
#
# Existe porque `infra compose` tinha o `-f` fixo no core e ignorava o cwd: chamado
# de outro repo, promovia o control-plane inteiro. Aqui a stack e argumento
# obrigatorio, lido do registro; nao ha alvo default e nao ha "tudo".
#
# Onde cada pedaco mora (desenho #3010 §3-§4). Nada daqui le a bancada:
#   base do compose  release, arvore imutavel da familia: $PF_RELEASE_RAIZ/<familia>/<sha>/<caminho>
#                    (o registro declara o caminho relativo a raiz do repo, ou sob $PLATAFIRMA_RELEASE/<curto>/)
#   sobreposicao     instancia: $PLATAFIRMA_INSTANCIA/deploy/<stack>/compose.override.yaml (config I, binds em /srv)
#   segredo          instancia: $PLATAFIRMA_INSTANCIA/segredos/<stack>/<NOME>, materializado em --env-file no
#                    tmpfs ($DEPLOY_ENV_DIR/<stack>.env) so enquanto o docker compose roda
#   projeto compose  preservado: campo `projeto` do registro, senao `name:` do compose base; sem os
#                    dois, recusa — nome inventado pelo docker troca os volumes nomeados
# Nao ha worktree de deploy: a release ja e o checkout imutavel.
set -euo pipefail

. "$(dirname "$(readlink -f "$0")")/../lib/raizes.sh"

export PF_RELEASE_RAIZ PLATAFIRMA_RELEASE PLATAFIRMA_INSTANCIA
export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/$(id -u)/docker.sock}"

# A topologia se le UMA vez e mora em memoria; nenhuma funcao abaixo toca disco de novo.
# FONTE-VERDADE: a tabela acervo.stack, servida por `acervo stack ver --json`. A rota
# `acervo listar topologia --completo` foi eliminada na migracao arq:0106 (a gramatica
# nova so tem as particoes obra/casa/registro; `topologia` deixou de existir como
# particao, e `stack` nao e especie de acervo.especie_tipo). `acervo stack ver` continua
# vigente e serve a MESMA tabela como array puro [{...}], que o jq abaixo embrulha em
# {stacks: {...}}. Edicao humana: `acervo stack import|rm`. DEPLOY_TOPO_ARQUIVO=<caminho>
# ainda le de um JSON, so para diagnostico.
if [ -n "${DEPLOY_TOPO_ARQUIVO:-}" ]; then
  [ -r "$DEPLOY_TOPO_ARQUIVO" ] || { echo "arquivo de topologia ilegivel: $DEPLOY_TOPO_ARQUIVO" >&2; exit 1; }
  TOPO_JSON="$(cat "$DEPLOY_TOPO_ARQUIVO")"
else
  TOPO_JSON="$(acervo stack ver --json 2>/dev/null \
    | jq '{stacks: (map({key: .slug, value: .}) | from_entries)}')"
  [ -n "$TOPO_JSON" ] && [ "$(jq -r '.stacks | length' <<<"$TOPO_JSON" 2>/dev/null)" -gt 0 ] \
    || { echo "topologia vazia do verbo — acervo stack ver --json falhou" >&2; exit 1; }
fi

stacks()   { jq -r '.stacks | keys[]' <<<"$TOPO_JSON"; }
campo()    { jq -r --arg s "$1" --arg c "$2" '.stacks[$s][$c] // empty' <<<"$TOPO_JSON"; }
# `compose` e `profiles` aceitam string ou lista: uma linha por item, sempre.
lista()    { jq -r --arg s "$1" --arg c "$2" \
               '.stacks[$s][$c] // empty | if type=="array" then .[] else . end' <<<"$TOPO_JSON"; }

uso() {
  cat >&2 <<FIM
uso:
  deploy <stack> <acao> [args...]   acao = up | down | ps | logs | config | pull | build
  deploy <stack> promover [rev]     sobe da arvore da release nessa rev (sem rev: current da familia)
  deploy <stack> rotas              qual hostname do tunel entra em qual servico
  deploy <stack> acessos            quem pode entrar em cada superficie gateada
  deploy <stack> segredos           segredos que a stack exige, e se estao ali
  deploy <stack> reverter [--executar [rev]]  como se desfaz, em quanto tempo e por quem
  deploy <stack>                    mostra o declarado da stack, sem tocar em nada
  deploy                            lista as stacks do registro

base: $PF_RELEASE_RAIZ/<familia>/<sha>/<compose> · sobreposicao: $PLATAFIRMA_INSTANCIA/deploy/<stack>/compose.override.yaml
segredos: $PLATAFIRMA_INSTANCIA/segredos/<stack>/ (env-file em tmpfs, apagado na saida)

stacks registradas:
FIM
  while read -r s; do
    printf '  %-14s %s\n' "$s" "$(campo "$s" papel)" >&2
  done < <(stacks)
  cat >&2 <<FIM

Nao existe alvo default e nao existe "todas": stack e argumento obrigatorio.
Fonte: acervo.stack (acervo stack ver); edicao: acervo stack import|def|rm
FIM
  exit 2
}

# --- reversao (#184) -------------------------------------------------------
# Aprovar mudanca sem saber desfaze-la e metade do controle: o gate antes do push
# ja diz "pode subir", e ninguem declarava o caminho de volta. Fica no MESMO lugar
# que ja declara rota, acesso e segredo, porque plano de reversao publicado como
# texto na wiki desincroniza no primeiro deploy — o mesmo motivo dos outros tres.
# O ponto de volta da STACK e da instancia (qual sha da release os conteineres rodam);
# o do CODIGO mora na release, ao lado do current da familia.
PONTOS="${DEPLOY_PONTOS:-$PLATAFIRMA_INSTANCIA/var/deploy}"

rev() { jq -r --arg s "$1" --arg c "$2" '.stacks[$s].reversao[$c] // empty' <<<"$TOPO_JSON"; }

ponto_anterior() {
  local f="$PONTOS/$1.anterior"
  [ -r "$f" ] && cat "$f" || echo ""
}

gravar_atual() { mkdir -p "$PONTOS"; printf '%s\n' "$1" > "$PONTOS/$STACK.atual"; }

reversao_resumo() {
  jq -e --arg s "$1" '.stacks[$s] | has("reversao")' <<<"$TOPO_JSON" >/dev/null \
    || { echo "NAO DECLARADA — ninguem mediu a volta desta stack"; return; }
  printf '%s, ~%s min, %s (ensaiada: %s)' "$(rev "$1" via)" "$(rev "$1" janela_min)" \
    "$(rev "$1" quem)" "$(rev "$1" provado_em | grep -q . && rev "$1" provado_em || echo nunca)"
}

command -v jq >/dev/null || { echo "jq ausente — o registro e JSON e nao se le na mao" >&2; exit 1; }

# --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4). So o
# PRIMEIRO argumento: o resto e repassado cru ao `docker compose`, que tem seu
# proprio --help. Sem isto, `deploy --ajuda` tratava "--ajuda" como nome de stack.
case "${1:-}" in --ajuda|--help|-h) uso ;; esac

[ $# -ge 1 ] || uso
STACK="$1"; shift || true

case "$STACK" in
  */*|.*|*..*) echo "erro: '$STACK' e slug de stack, nao caminho" >&2; exit 4 ;;
esac
if ! jq -e --arg s "$STACK" '.stacks | has($s)' <<<"$TOPO_JSON" >/dev/null || [ -z "$(lista "$STACK" compose)" ]; then
  echo "erro: stack \"$STACK\" nao esta no registro (ou nao declara compose) — nao invento caminho de compose." >&2
  echo "      registradas: $(stacks | tr '\n' ' ')" >&2
  exit 2
fi

REPO="$(campo "$STACK" repo)"
[ -n "$REPO" ] || { echo "erro: stack \"$STACK\" nao declara repo no registro — nao sei de que familia da release ela sobe." >&2; exit 3; }
CURTO="${REPO#platafirma-}"
OVERRIDE="$PLATAFIRMA_INSTANCIA/deploy/$STACK/compose.override.yaml"
SEGREDOS_STACK="$PLATAFIRMA_INSTANCIA/segredos/$STACK"
ENV_DIR="${DEPLOY_ENV_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/platafirma}"
ENV_FILE=""; ENV_TMP=""

limpar_env() { rm -f ${ENV_FILE:+"$ENV_FILE"} ${ENV_TMP:+"$ENV_TMP"}; }
trap limpar_env EXIT

# --- a release: de qual arvore imutavel a stack sobe ---------------------------
# Sem rev, o current da familia RESOLVIDO ao sha: o que sobe e um sha, nao um ponteiro que
# anda sozinho na proxima promocao. Com rev, a arvore que o release ja materializou.
arvore_de() {  # $1=sha ou vazio ; imprime a arvore ou falha
  local sha="${1:-}"
  if [ -z "$sha" ]; then
    realpath -e "$PF_RELEASE_RAIZ/$REPO/current" 2>/dev/null
  elif [ -d "$PF_RELEASE_RAIZ/$REPO/$sha" ]; then
    printf '%s\n' "$PF_RELEASE_RAIZ/$REPO/$sha"
  else
    return 1
  fi
}

# rev -> sha de 40 hex pelo espelho da familia (sha, tag, ramo do origin), como o release resolve.
resolver_rev() {  # $1=rev ; imprime o sha ou falha
  local rev="$1" esp="$PF_RELEASE_RAIZ/$REPO/.repo.git" sha="" r
  if [[ "$rev" =~ ^[0-9a-f]{40}$ ]]; then printf '%s\n' "$rev"; return 0; fi
  [ -d "$esp" ] || return 1
  for r in "${rev}^{commit}" "refs/tags/${rev}^{commit}" "refs/remotes/origin/${rev#origin/}^{commit}"; do
    sha="$(git --git-dir="$esp" rev-parse --verify -q "$r" 2>/dev/null || true)"
    [ -z "$sha" ] || break
  done
  if [ -n "$sha" ]; then
    printf '%s\n' "$sha"
    return 0
  fi
  return 1
}

# Compose declarado -> caminho relativo a raiz da familia. Relativo vale como relativo a raiz do
# repo; absoluto so sob os atalhos da release. O resto nao e base: a base mora na release.
rel_na_familia() {  # $1=declarado
  case "$1" in
    "$PLATAFIRMA_RELEASE/$CURTO/"*)             printf '%s\n' "${1#"$PLATAFIRMA_RELEASE/$CURTO/"}" ;;
    "$PF_RELEASE_RAIZ/$REPO/current/"*) printf '%s\n' "${1#"$PF_RELEASE_RAIZ/$REPO/current/"}" ;;
    "~"*|/*|*..*)                       return 1 ;;
    *)                                  printf '%s\n' "$1" ;;
  esac
}

# Uma stack pode precisar de mais de um arquivo (base + overlay de GPU) e de perfil
# declarado: servico sob `profiles:` no compose e INVISIVEL sem --profile, e o verbo
# nao acusa nada — foi assim que `rag-api` ficou fora de `deploy rag up`, com o
# comando saindo 0 e sem subir a API.
COMPOSE_ARGS=(); COMPOSE=""; ARVORE=""
montar_compose() {  # $1=arvore da release
  ARVORE="$1"; COMPOSE_ARGS=(); COMPOSE=""
  local c rel ov
  while read -r c; do
    [ -n "$c" ] || continue
    rel="$(rel_na_familia "$c")" || {
      echo "erro: compose declarado fora da release: $c" >&2
      echo "      a base mora na release: caminho relativo a raiz de $REPO, ou sob $PLATAFIRMA_RELEASE/$CURTO/." >&2
      echo "      config da instancia vai na sobreposicao: $OVERRIDE" >&2
      exit 3; }
    c="$ARVORE/$rel"
    [ -r "$c" ] || { echo "erro: compose declarado e ilegivel: $c" >&2; exit 1; }
    [ -n "$COMPOSE" ] || COMPOSE="$c"   # o primeiro manda no diretorio de projeto e no que se imprime
    COMPOSE_ARGS+=(-f "$c")
  done < <(lista "$STACK" compose)

  # `docker compose` carrega docker-compose.override.yml sozinho quando descobre o
  # arquivo pelo cwd — e NAO carrega quando ha `-f`, que e sempre o nosso caso. O
  # override some em silencio e o `up` recria o servico sem os volumes dele: foi
  # assim que o mediawiki subiu sem o bind do LocalSettings.php em 10/08/2026 e a
  # wiki voltou na tela de instalacao. Override existente e nao declarado no
  # registro para o verbo aqui, em vez de virar incidente depois do `up`.
  for c in "${COMPOSE_ARGS[@]}"; do
    [ "$c" = "-f" ] && continue
    ov="$(dirname "$c")/docker-compose.override.yml"
    [ -r "$ov" ] || continue
    case " ${COMPOSE_ARGS[*]} " in *" $ov "*) continue;; esac
    echo "erro: existe override nao declarado no registro: $ov" >&2
    echo "      com -f o docker compose NAO o carrega sozinho, e o \"up\" subiria sem ele." >&2
    echo "      conserto: declarar os dois no registro (acervo stack), campo compose (aceita lista)." >&2
    exit 3
  done

  # a sobreposicao da instancia entra por ultimo: vence a base no que declara
  [ ! -r "$OVERRIDE" ] || COMPOSE_ARGS+=(-f "$OVERRIDE")
}

projeto_declarado() {
  local p; p="$(campo "$STACK" projeto)"
  if [ -z "$p" ] && [ -n "$COMPOSE" ]; then
    p="$(python3 -c 'import sys, yaml; print((yaml.safe_load(open(sys.argv[1])) or {}).get("name") or "")' "$COMPOSE" 2>/dev/null || true)"
  fi
  printf '%s' "$p"
}

PROJETO=""
fixar_projeto() {
  PROJETO="$(projeto_declarado)"
  [ -n "$PROJETO" ] || {
    echo "recusa: projeto compose de \"$STACK\" nao declarado (campo projeto no registro, ou name: em $COMPOSE)." >&2
    echo "        sem ele o docker deriva o nome do diretorio da release, e os volumes nomeados viram outros." >&2
    exit 3; }
}

# Segredo para compose (desenho #3010 §3): um arquivo por variavel em $SEGREDOS_STACK, escrito num
# env-file 0600 no tmpfs e apagado na saida (trap). Nenhum `.env` em arvore de repo. Arquivo cujo
# nome nao e de variavel (chave, pem, yaml) e bind da sobreposicao, nao linha de env. Nome e
# presenca, nunca valor: nenhuma linha deste verbo imprime o conteudo.
materializar_env() {
  local f nome valor
  ( umask 077; mkdir -p "$ENV_DIR" )
  chmod 700 "$ENV_DIR"
  ENV_TMP="$(mktemp "$ENV_DIR/.$STACK.env.XXXXXX")"
  if [ -d "$SEGREDOS_STACK" ]; then
    for f in "$SEGREDOS_STACK"/*; do
      [ -f "$f" ] || continue
      nome="$(basename "$f")"
      [[ "$nome" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      valor="$(cat "$f")"
      case "$valor" in
        *$'\n'*) echo "aviso: segredo $STACK/$nome tem mais de uma linha — fica fora do env-file (e bind, nao variavel)" >&2; continue ;;
        *"'"*)   echo "recusa: segredo $STACK/$nome tem aspas simples e nao cabe literal no env-file — nada subiu" >&2; exit 3 ;;
      esac
      printf "%s='%s'\n" "$nome" "$valor" >> "$ENV_TMP"
    done
  fi
  ENV_FILE="$ENV_DIR/$STACK.env"
  mv -f "$ENV_TMP" "$ENV_FILE"; ENV_TMP=""
}

# Caminho declarado de config da instancia: relativo e relativo a $2 (a sobreposicao da stack
# para rotas e gate; o cofre da stack para segredos); absoluto so vale sob a instancia ou a
# release. `~` e qualquer outro absoluto recusam: dado de registro que ainda aponta o home da
# conta se reescreve por `acervo stack def`, nunca se segue em silencio (desenho #3010 §3-§4).
resolve() {  # $1=declarado $2=base do relativo ; falha fora das raizes de producao
  case "$1" in
    "~"*|*..*)                                                  return 1 ;;
    "$PLATAFIRMA_INSTANCIA/"*|"$PF_RELEASE_RAIZ/"*|"$PLATAFIRMA_RELEASE/"*)     printf '%s\n' "$1" ;;
    /*)                                                         return 1 ;;
    *)                                                          printf '%s\n' "$2/$1" ;;
  esac
}

fora_das_raizes() {  # $1=campo $2=declarado $3=base do relativo
  echo "recusa: $1 de \"$STACK\" declarado fora das raizes de producao: $2" >&2
  echo "        vale relativo a $3, ou absoluto sob $PLATAFIRMA_INSTANCIA ou $PF_RELEASE_RAIZ." >&2
  echo "        conserto: reescrever pelo acervo stack def (nunca UPDATE a mao)." >&2
  exit 3
}

# Segredo declarado e ausente para o `up` aqui: a stack nao sobe pela metade (falha alta).
exigir_segredos() {
  jq -e --arg s "$STACK" '.stacks[$s] | has("segredos")' <<<"$TOPO_JSON" >/dev/null || return 0
  local item alvo falta=0
  while read -r item; do
    [ -n "$item" ] || continue
    alvo="$(resolve "$item" "$SEGREDOS_STACK")" || fora_das_raizes segredo "$item" "$SEGREDOS_STACK"
    [ -e "$alvo" ] && continue
    echo "  AUSENTE : $item" >&2; falta=$((falta+1))
  done < <(lista "$STACK" segredos)
  [ "$falta" -eq 0 ] || { echo "recusa: faltam $falta segredo(s) de \"$STACK\" — ver: deploy $STACK segredos" >&2; exit 1; }
}

compose() {
  local env_args=()
  [ -z "$ENV_FILE" ] || env_args=(--env-file "$ENV_FILE")
  docker compose -p "$PROJETO" "${COMPOSE_ARGS[@]}" "${env_args[@]+"${env_args[@]}"}" \
    "${PERFIL_ARGS[@]+"${PERFIL_ARGS[@]}"}" "$@"
}

# De qual sha da release a stack sobe, e se os conteineres acompanham o current. O sha que
# subiu e gravado por este verbo; conteiner que ninguem subiu por aqui nao vira afirmacao.
servido() {
  local arv atual subiu=""
  arv="$(arvore_de "")" || { echo "familia $REPO sem current na release ($PF_RELEASE_RAIZ/$REPO/current)"; return; }
  atual="$(basename "$arv")"
  if [ -r "$PONTOS/$STACK.atual" ]; then subiu="$(cat "$PONTOS/$STACK.atual")"; fi
  if [ -z "$subiu" ]; then echo "${atual:0:7} no current de $REPO (nenhum up/promover gravado por este verbo)"
  elif [ "$subiu" = "$atual" ]; then echo "${atual:0:7} (conteineres no current de $REPO)"
  else echo "conteineres em ${subiu:0:7}, current de $REPO em ${atual:0:7} — alinhar: deploy $STACK promover"; fi
}

PERFIL_ARGS=()
while read -r pf; do
  [ -n "$pf" ] || continue
  PERFIL_ARGS+=(--profile "$pf")
done < <(lista "$STACK" profiles)

# Sem acao: mostra o declarado. Ver nao muda nada, entao nao precisa de confirmacao.
if [ $# -eq 0 ]; then
  printf 'stack   : %s\n' "$STACK"
  printf 'papel   : %s\n' "$(campo "$STACK" papel)"
  printf 'repo    : %s\n' "$REPO"
  printf 'compose : %s\n' "$(lista "$STACK" compose | tr '\n' ' ')"
  printf 'sobrepoe: %s\n' "$([ -r "$OVERRIDE" ] && echo "$OVERRIDE" || echo "nenhuma ($OVERRIDE)")"
  printf 'perfis  : %s\n' "$(lista "$STACK" profiles | tr '\n' ' ')"
  printf 'critico : %s\n' "$(campo "$STACK" critico)"
  if ARV="$(arvore_de "")"; then
    montar_compose "$ARV"
    PROJETO="$(projeto_declarado)"
    printf 'projeto : %s\n' "${PROJETO:-NAO DECLARADO — up recusa}"
    printf 'servicos: %s\n' "$(docker compose ${PROJETO:+-p "$PROJETO"} "${COMPOSE_ARGS[@]}" "${PERFIL_ARGS[@]+"${PERFIL_ARGS[@]}"}" config --services 2>/dev/null | tr '\n' ' ')"
  fi
  printf 'servido : %s\n' "$(servido)"
  printf 'reverter: %s\n' "$(reversao_resumo "$STACK")"
  exit 0
fi

ACAO="$1"

# Ler o declarado nao muda nada e nao pede confirmacao. Os tres sub-atos abaixo
# existem porque o procedimento derivado da wiki nao pode publicar estes dados como
# valor: sem verbo que os devolva, o texto desincroniza no primeiro deploy.
if [ "$ACAO" = "rotas" ]; then
  ING="$(campo "$STACK" rotas)"
  [ -n "$ING" ] || { echo "stack \"$STACK\" nao declara ingress no registro (campo rotas)."; exit 0; }
  ING="$(resolve "$ING" "$PLATAFIRMA_INSTANCIA/deploy/$STACK")" || fora_das_raizes rotas "$(campo "$STACK" rotas)" "$PLATAFIRMA_INSTANCIA/deploy/$STACK"
  [ -r "$ING" ] || { echo "erro: ingress declarado e ilegivel: $ING" >&2; exit 1; }
  printf 'ingress : %s\n' "$ING"
  yq -r '.ingress[] | [(.hostname // "(catch-all)"), (.path // "-"), .service] | @tsv' "$ING" \
    | while IFS=$'\t' read -r h p sv; do printf '  %-32s %-10s %s\n' "$h" "$p" "$sv"; done
  echo
  echo "Rota fora deste arquivo nao aparece aqui: o tunel do ops-mcp e configurado no"
  echo "dashboard da Cloudflare, e nenhum arquivo do repositorio o descreve."
  exit 0
fi

if [ "$ACAO" = "acessos" ]; then
  # O gate de uma stack nem sempre mora no compose dela, e ate o #469 este verbo supunha
  # que sim. O do `rastreador` e uma instancia de oauth2-proxy que vive na stack CORE:
  # sem o ponteiro abaixo, `deploy rastreador acessos` respondia "nenhuma superficie
  # gateada declarada" sobre uma superficie que ESTA gateada — verde vazio, que e pior
  # que erro, porque passa no aceite sem provar nada. Mesmo padrao do campo `rotas`, que
  # ja aponta para fora do repo quando o ingress mora noutra stack.
  #
  # O filtro por nome do servico e o que impede a leitura de mentir na outra direcao:
  # o compose do core tem TRES instancias de oauth2-proxy, e sem filtrar, `acessos` da
  # stack rastreador listaria o gate da wiki e o do harness como se fossem dela. A
  # convencao passa a ser carregada: o servico do gate leva o nome da stack no dele.
  GATE="$(campo "$STACK" gate)"
  FILTRO=""
  if [ -n "$GATE" ]; then
    GATE="$(resolve "$GATE" "$PLATAFIRMA_INSTANCIA/deploy/$STACK")" || fora_das_raizes gate "$(campo "$STACK" gate)" "$PLATAFIRMA_INSTANCIA/deploy/$STACK"
    [ -r "$GATE" ] || { echo "erro: gate declarado e ilegivel: $GATE" >&2; exit 1; }
    printf 'gate    : %s\n' "$GATE"
    printf '          (declarado no registro: o gate desta stack NAO mora no compose dela)\n\n'
    ACESSOS_ARGS=(-f "$GATE")
    FILTRO="$STACK"
  else
    ARV="$(arvore_de "")" || { echo "erro: familia $REPO sem current na release — nada a ler" >&2; exit 1; }
    montar_compose "$ARV"; fixar_projeto; materializar_env
    ACESSOS_ARGS=(-p "$PROJETO" "${COMPOSE_ARGS[@]}" --env-file "$ENV_FILE")
  fi
  # O compose resolvido normaliza volume para objeto (source/target), nao string, e o
  # `yq` daqui e o de Go: sem --arg e sem env.VAR. Ler isso em shell rendeu falha muda,
  # entao a leitura e em python, que ja tem o YAML.
  docker compose "${ACESSOS_ARGS[@]}" "${PERFIL_ARGS[@]+"${PERFIL_ARGS[@]}"}" config 2>/dev/null \
  | python3 -c '
import sys, yaml
cfg = yaml.safe_load(sys.stdin) or {}
# argv[1] so vem preenchido quando o registro declarou `gate`: e o nome da stack, e serve
# para nao atribuir a ela o gate de uma superficie vizinha no mesmo compose.
filtro = sys.argv[1] if len(sys.argv) > 1 else ""
achou = False
for nome, sv in (cfg.get("services") or {}).items():
    if filtro and filtro not in nome:
        continue
    alvo = next((a.split("=", 1)[1] for a in (sv.get("command") or [])
                 if isinstance(a, str) and "authenticated-emails-file" in a), None)
    if not alvo:
        continue
    achou = True
    host = next((v.get("source") for v in (sv.get("volumes") or [])
                 if isinstance(v, dict) and v.get("target") == alvo), None)
    print(f"superficie: {nome}  (allowlist)")
    print(f"  arquivo : {host or alvo}")
    try:
        with open(host, encoding="utf-8") as f:
            entra = [l.strip() for l in f if l.strip() and not l.startswith("#")]
        for e in entra:
            print(f"  entra   : {e}")
        if not entra:
            print("  entra   : (arquivo vazio — o gate recusa todo mundo)")
    except (OSError, TypeError):
        print("  entra   : (arquivo nao legivel daqui)")
for nome, sv in (cfg.get("services") or {}).items():
    if filtro and filtro not in nome:
        continue
    env = sv.get("environment") or {}
    texto = " ".join(f"{k}={v}" for k, v in env.items()) if isinstance(env, dict) else " ".join(map(str, env))
    if "OIDC" in texto.upper() or "OPENID" in texto.upper():
        achou = True
        print(f"superficie: {nome}  (gate proprio: OIDC contra o realm)")
        print("  entra   : quem o realm autorizar. Enumerar exige credencial de admin do")
        print("            Keycloak, que este verbo nao usa — e a allowlist nao cobre esta.")
if not achou:
    print("nenhuma superficie gateada declarada no compose desta stack.")
' "$FILTRO"
  exit 0
fi

if [ "$ACAO" = "segredos" ]; then
  if ! jq -e --arg s "$STACK" '.stacks[$s] | has("segredos")' <<<"$TOPO_JSON" >/dev/null; then
    echo "stack \"$STACK\" nao declara segredos no registro — ausencia de declaracao, nao"
    echo "ausencia de segredo: ninguem mediu esta stack ainda."
    exit 2
  fi
  falta=0; n=0
  while read -r item; do
    [ -n "$item" ] || continue
    n=$((n+1)); alvo="$(resolve "$item" "$SEGREDOS_STACK")" || fora_das_raizes segredo "$item" "$SEGREDOS_STACK"
    if [ -e "$alvo" ]; then
      printf '  ok      : %-58s %s\n' "$item" "$(stat -c '%A %U:%G' "$alvo")"
    else
      printf '  AUSENTE : %s\n' "$item"; falta=$((falta+1))
    fi
  done < <(lista "$STACK" segredos)
  [ "$n" -gt 0 ] || echo "  (declarado: esta stack nao exige segredo)"
  echo
  echo "cofre da stack: $SEGREDOS_STACK"
  echo "Nome e presenca, nunca valor: nenhuma linha deste verbo le o conteudo."
  [ "$falta" -eq 0 ] || { echo "faltam $falta arquivo(s) — a stack nao sobe inteira assim." >&2; exit 1; }
  exit 0
fi

if [ "$ACAO" = "reverter" ]; then
  shift
  if ! jq -e --arg s "$STACK" '.stacks[$s] | has("reversao")' <<<"$TOPO_JSON" >/dev/null; then
    echo "stack \"$STACK\" nao declara reversao no registro — ausencia de DECLARACAO, nao"
    echo "ausencia de caminho de volta: ninguem mediu esta stack ainda."
    echo "conserto: declarar reversao via acervo stack (via, janela_min, estado, quem, provado_em)."
    exit 2
  fi
  VIA="$(rev "$STACK" via)"; ANTERIOR="$(ponto_anterior "$STACK")"
  ATUAL="?"
  if [ -r "$PONTOS/$STACK.atual" ]; then ATUAL="$(cat "$PONTOS/$STACK.atual")"
  elif ARV="$(arvore_de "")"; then ATUAL="$(basename "$ARV")"; fi

  if [ "${1:-}" != "--executar" ]; then
    printf 'stack       : %s\n' "$STACK"
    printf 'via         : %s\n' "$VIA"
    printf 'quem        : %s\n' "$(rev "$STACK" quem)"
    printf 'janela      : ~%s min (estimativa declarada, NAO medicao)\n' "$(rev "$STACK" janela_min)"
    printf 'ensaiada em : %s\n' "$(rev "$STACK" provado_em | grep -q . && rev "$STACK" provado_em || echo 'NUNCA — a volta desta stack nunca foi provada')"
    printf 'servindo    : %s\n' "$ATUAL"
    printf 'ponto de volta: %s\n' "${ANTERIOR:-nenhum gravado — so ha ponto depois do primeiro \`promover\` deste verbo}"
    echo
    echo "o que NAO volta com o codigo:"
    printf '  %s\n' "$(rev "$STACK" estado)"
    echo
    echo "nota:"
    printf '  %s\n' "$(rev "$STACK" nota)"
    echo
    if [ "$VIA" = "promover" ]; then
      echo "executar: deploy $STACK reverter --executar [rev]"
      echo "          sem rev, volta ao ponto gravado acima; a rev tem de estar materializada na release."
      echo "          o codigo dos verbos volta por outro ato: release reverter $REPO"
    else
      echo "executar: NAO por este verbo. A volta desta stack e declarada por \"$VIA\": volte o"
      echo "          codigo com release reverter $REPO e suba de novo com deploy $STACK up -d."
    fi
    exit 0
  fi

  shift
  [ "$VIA" = "promover" ] || {
    echo "recusa: reversao de \"$STACK\" e via \"$VIA\", nao \"promover\"." >&2
    echo "        rode sem --executar para o plano." >&2
    exit 1; }
  ALVO="${1:-$ANTERIOR}"
  [ -n "$ALVO" ] || {
    echo "recusa: sem rev e sem ponto de volta gravado — nao invento para onde voltar." >&2
    echo "        passe o commit: deploy $STACK reverter --executar <rev>" >&2
    exit 1; }
  SHA="$(resolver_rev "$ALVO")" && ARV="$(arvore_de "$SHA")" || {
    echo "recusa: $ALVO nao esta materializado na release de $REPO ($PF_RELEASE_RAIZ/$REPO/<sha>)." >&2
    echo "        a arvore imutavel nasce do release: release promover $REPO $ALVO" >&2
    exit 1; }
  montar_compose "$ARV"; fixar_projeto; exigir_segredos; materializar_env
  mkdir -p "$PONTOS"; echo "$ATUAL" > "$PONTOS/$STACK.revertido-de"
  printf 'revertido: %s (projeto %s)\n  %s -> %s\n' "$ARVORE" "$PROJETO" "$ATUAL" "$SHA"
  echo "o que NAO voltou: $(rev "$STACK" estado)"
  cd "$(dirname "$COMPOSE")"
  rc=0; compose up -d --build --force-recreate || rc=$?
  [ "$rc" -ne 0 ] || gravar_atual "$SHA"
  exit "$rc"
fi

# `promover` sobe a stack da arvore imutavel da release num ato so. Existe porque cada
# passo isolado PASSA e o conjunto falha calado: config em bind mount de arquivo unico
# troca de inode entre arvores, o mount fica preso ao inode velho, e `reload` rele o
# arquivo antigo sem erro nenhum — sintaxe valida, teste ok, comportamento inalterado.
# Por isso recria (--force-recreate) sempre.
if [ "$ACAO" = "promover" ]; then
  shift
  REV=""
  if [ $# -gt 0 ] && [[ "$1" != -* ]]; then REV="$1"; shift; fi
  if [ -z "$REV" ]; then
    ARV="$(arvore_de "")" || {
      echo "recusa: familia $REPO sem current na release — promova antes: release promover $REPO <rev>" >&2; exit 1; }
    SHA="$(basename "$ARV")"
  else
    SHA="$(resolver_rev "$REV")" && ARV="$(arvore_de "$SHA")" || {
      echo "recusa: rev \"$REV\" nao esta materializada na release de $REPO." >&2
      echo "        a arvore imutavel nasce do release: release promover $REPO $REV" >&2
      exit 1; }
  fi
  montar_compose "$ARV"; fixar_projeto; exigir_segredos; materializar_env
  # Ponto de retorno ANTES de mexer: sem isto, `reverter` so funciona com o operador
  # lembrando de cor o SHA de onde saiu — e ninguem lembra as onze da noite, com o
  # servico fora. Erro reversivel e defeito; erro irreversivel e perda.
  ANTES=""
  if [ -r "$PONTOS/$STACK.atual" ]; then ANTES="$(cat "$PONTOS/$STACK.atual")"; fi
  mkdir -p "$PONTOS"
  if [ -n "$ANTES" ] && [ "$ANTES" != "$SHA" ]; then echo "$ANTES" > "$PONTOS/$STACK.anterior"; fi
  printf 'release: %s (projeto %s)\n  %s -> %s\n' "$ARVORE" "$PROJETO" "${ANTES:-(nenhum up gravado)}" "$SHA"
  cd "$(dirname "$COMPOSE")"
  # `--build` porque recriar contêiner NAO reconstroi imagem: quando o commit
  # promovido muda algo que entra por COPY no Dockerfile, o contêiner novo sobe
  # com a imagem velha e o servico quebra sem o verbo acusar nada. Custa o tempo
  # de um build com cache nas stacks que declaram `build:`, e nada nas outras.
  rc=0; compose up -d --build --force-recreate "$@" || rc=$?
  [ "$rc" -ne 0 ] || gravar_atual "$SHA"
  exit "$rc"
fi

ARV="$(arvore_de "")" || {
  echo "erro: familia $REPO sem current na release ($PF_RELEASE_RAIZ/$REPO/current) — promova: release promover $REPO <rev>" >&2
  exit 1; }
montar_compose "$ARV"; fixar_projeto
[ "$ACAO" != "up" ] || exigir_segredos
materializar_env
cd "$(dirname "$COMPOSE")"
rc=0; compose "$@" || rc=$?
if [ "$rc" -eq 0 ] && [ "$ACAO" = "up" ]; then gravar_atual "$(basename "$ARVORE")"; fi
exit "$rc"
