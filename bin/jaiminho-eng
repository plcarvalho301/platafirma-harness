#!/bin/bash
# jaiminho-eng — gira a cadeira engenharia no motor agy (Antigravity/Gemini), conta org:0020
# capacidade: mensagem
# dono: claudinho-TI
# atos: perguntar | continuar | estado | logs | login
#
# Cadeira engenharia no motor `agy` (org:0020). NAO e um verbo novo: e o mesmo
# `bin/jaiminho`, apontado por env para o container, a persona e o volume desta conta.
# Existe como arquivo proprio porque `chat` roteia participante por NOME do binario
# (VERBO_DO_PARTICIPANTE), e porque `jaiminho-eng perguntar` e o que a recepcao
# chama — ninguem deveria precisar lembrar de exportar variaveis para girar.
#
# NOME vs CONTA: o participante e `jaiminho-eng` na camada harness (persona, chat,
# cadeiras.py). A service account subjacente segue sendo `jaiminho-fabrica` (client no
# realm, sujeito no PAP, container, volumes, deploy em /srv/pf/agy/jaiminho-fabrica) ate
# a reconformacao geral renomear a identidade — card #3106. Por isso PF_JAIMINHO_CONTAINER
# aponta o container REAL (nome velho): renomear so a camada harness nao renomeia a conta.
#
# Sub-atos: os mesmos de `jaiminho` — perguntar | continuar | estado | logs | login.
set -euo pipefail
# Persona e verbo saem da MESMA arvore deste arquivo (a release servida), por readlink:
# nunca de raiz montada a mao.
HARNESS="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PF_JAIMINHO_CONTAINER="jaiminho-fabrica"
# Daemon do braco desde o #2286: rootless da conta `jaiminho` (uid 1003). Declarado e
# nao adivinhado — sem isto o verbo pergunta ao daemon do `claudinho`, nao acha o
# container e sugere `up -d`, que sobe um SEGUNDO braco. `claudinho` nao tem sudo, entao
# hoje isto NAO da alcance: da a RECUSA CERTA, com o endereco de quem alcanca.
export PF_JAIMINHO_DOCKER_HOST="${PF_JAIMINHO_DOCKER_HOST:-unix:///run/user/1003/docker.sock}"
export PF_JAIMINHO_DAEMON_DONO="jaiminho (uid 1003), deploy em /srv/pf/agy/jaiminho-fabrica"
export PF_JAIMINHO_PERSONA="$HARNESS/personas/persona-jaiminho-eng.md"
export PF_JAIMINHO_TRABALHO="/home/jaiminho/trabalho"
exec "$HARNESS/bin/jaiminho" "$@"
