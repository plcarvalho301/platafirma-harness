#!/usr/bin/env python3
# conferir — compara o que esta DECLARADO com o que esta SERVIDO, por classe de alvo.
# capacidade: verificacao
# dono: claudinho-TI
# componente: docker, git
"""Classes:

  servico [nome]   container gerido por compose: de onde sobe, SHA e sujeira do ref,
                   paridade entre o `environment` declarado e o ambiente do processo.
  verbo   [nome]   verbo do PATH da plataforma: origem (symlink de repo, copia, so no
                   host, divergente), cabecalho de tres linhas, e a conta de
                   arq:0037 — um verbo por capacidade.
  skill   [nome]   skill servida no claude.ai: o blob que o carimbo do arquivo montado
                   declara, contra o blob da fonte no harness. O servido vive do outro
                   lado da fronteira — a sessao le o carimbo e passa em --servido.
  procedencia [nome]
                   caminho de execucao alcancavel por ~/AI/bin: resolve para dentro do
                   harness, ou consta como excecao em docs/procedencia-do-harness.md,
                   com dono e motivo. Nao julga cabecalho nem capacidade — so onde o
                   arquivo executado mora.
  repo    [nome]   clone de trabalho em ~/AI: o que esta rastreado contra a regua de
                   arq:0042. Com `--staged`, julga so o que o commit em curso
                   acrescenta, no repo do diretorio corrente — e o que o pre-commit
                   chama, para que gate e conferencia leiam a mesma regua.
                   arq:0042 — materia de acervo, estado extraivel, blob que nao e fonte
                   editada a mao, render sem fonte irma e diretorio de topo nao
                   declarado no README.

  sessao  [cadeira] pacote de abertura SERVIDO: tokens medidos com o tokenizador
                   do harness, sha do conteudo servido e frescor, por peca. Sem
                   card #2404 tirou a comparacao automatica — medicao, nao
                   veredito. Sem
                   tokenizador, sai 2 — pacote de abertura se mede, nao se estima.
  superficie [--staged]
                   equalizacao das superficies. Mede o PRODUTOR do `.mcp.json` de
                   cada uma — quem escreve o arquivo —, nunca os cwd vivos: cwd e
                   efemero, e o `.mcp.json` e rastreado no repo, entao ler os
                   wt-*/ e fitas/*/ era ler N copias do mesmo arquivo. Cada
                   superficie declara `produtor` em superficies.json: `codigo`
                   (dict no fonte, lido por AST) ou `arquivo-rastreado` (o
                   .mcp.json da raiz; o produtor e o git). Superficie verificavel
                   SEM produtor declarado reprova. Instancia viva sai como
                   OBSERVACAO de deriva, com nome de arquivo, e nao muda veredito;
                   zero instancia nao e conector faltando. Julga tambem capacidade
                   sem meio e texto de cadeira citando tool fora de todo conector.
  front   [nome]   conformidade de deploy de front por arq:0057, alem do que
                   arq:0056 ja mede: (1) tela de aplicacao (index.html+Dockerfile)
                   FORA de `platafirma-ui`; (2) artefato de front que monte segredo
                   de outra camada (env_file/environment/volume de segredo no compose
                   da tela) OU sirva rota de API (`proxy_pass` no nginx da tela). Nao
                   e a classe `superficie`, que mede produtor de `.mcp.json`.
  arranque [nome]  texto de arranque em cwd (`CLAUDE.md` sob ~/AI): e PONTEIRO para
                   `conduta/arranque.md`, ou copia com bloco proprio? Reprova so a
                   copia; nao julga a redacao do arranque, que e da dona do texto.
                   Com `--staged`, julga so o CLAUDE.md do commit em curso.
  chapeu  [<cadeira>[/<slug>]]
                   chapeu de camada C (`abertura/<cadeira>/<slug>/chapeu.md`) contra
                   os predicados de `personas/TEMPLATE-chapeu.md`: eco da base,
                   secoes obrigatorias com a terceira coluna de (b) preenchida e os
                   dois textos fixos. Sem tokenizador sai 2 — chapeu se mede, nao
                   se estima. Sem alvo, julga todos os do disco.
  ferramental [--json]
                   golden record acervo.ferramental contra o host: (a) 1:1
                   capacidade<->verbo integro e cada verbo declarado resolve em
                   ~/AI/bin (arq:0037); (b) paridade de transicao: todo stack do
                   registro/stacks.json ja absorvido em acervo.stack — pre-condicao
                   de o arquivo poder morrer. NAO confere instancia->stack: stack e
                   conveniencia de deploy, nao invariante de capacidade; instancia
                   avulsa (ollama no harness) e normal. So olha.
  commit  <arquivo> mensagem de commit em curso: os ids que ela CITA, contra o
                   rastreador. Recusa id inexistente e id de item fechado — os dois
                   predicados da F9 do rastreador, §5.1, e so eles. Ausencia de id
                   NAO recusa. E o que o hook `commit-msg` chama, com o caminho que o
                   git lhe passa em $1 (use `-` para ler de stdin).
                   Opt-in POR REPO: so julga onde houver `.conferir-commit` na raiz.
                   Sem o arquivo, sai 0 sem dizer nada — `core.hooksPath` e um
                   diretorio compartilhado por 20 clones, e hook novo la dentro liga
                   em todos ao mesmo tempo. Rollout e ato declarado, nao efeito colateral.
  existe  <tipo> <nome>
                   fato de existencia com ancora colavel — o produtor da linha
                   `NEGATIVA:` do gate de abertura/dono.md (mesa ia #8, 26/08/2026).
                   Tipos: cadeira (subdirs de abertura/, prefixo claudinho-/
                   claudinha- aceito e descartado), verbo (~/AI/bin), card
                   (rastreador, via `tarefas ler`), arquivo (sob ~/AI; com
                   `git log -1` quando rastreado) e mesa (item #N da cadeira
                   corrente, via `mesa ver`). A PRIMEIRA linha da saida E a
                   ancora: `existe:`/`nao-existe:` + evidencia. Sai 0 (existe),
                   1 (nao existe), 2 (indeterminavel — fonte fora do ar ou uso
                   errado; nunca colapsa em 1: ausencia de resposta nao e
                   evidencia de ausencia, e `indeterminavel` NAO ancora negativa).

Classes conhecidas e ainda sem implementacao sao listadas como tais: ausencia se
declara, nunca se omite.

Sai 0 quando nao ha divergencia, 1 quando ha, 2 quando a chamada esta errada.
Nao muda nada: so olha.
"""
import datetime
import json
import re
import os
import subprocess
import sys
import urllib.error
import urllib.request

RAIZ = os.path.expanduser("~/AI")
DEPLOY = os.path.join(RAIZ, "deploy")
BIN = os.path.join(RAIZ, "bin")

MAPA = os.path.join(RAIZ, "platafirma-arquitetura", "docs", "arquitetura-negocio-operacao.md")

CLASSES_ABERTAS = {
    "canal": "regua do design system e de claudinha-produto e ainda nao existe",
    "casco": "avaliacao CIS ja tem verbo proprio (oscap-casco), de claudinho-seguranca",
    "alcance": ("mede a cadeia de acesso sujeito->fonte em 5 saltos (identidade, "
                "PDP, credencial, rede, ACL do alvo); os 5 sao desenho de "
                "claudinho-seguranca ainda nao fixado (card #2452 sob #191) — "
                "o instrumento e de TI, a fonte-de-verdade de cada salto e dele"),
}


def uso(erro=None):
    if erro:
        print(f"erro: {erro}\n", file=sys.stderr)
    print(__doc__.strip(), file=sys.stderr)
    print("\nuso: conferir <classe> [alvo]", file=sys.stderr)
    print("     classes implementadas : servico . verbo . repo . skill . procedencia . superficie . commit . arranque . chapeu . ferramental . front . existe", file=sys.stderr)
    for c, motivo in CLASSES_ABERTAS.items():
        print(f"     classe declarada, sem implementacao : {c} — {motivo}", file=sys.stderr)
    sys.exit(2)


def sh(args, cwd=None):
    p = subprocess.run(args, capture_output=True, text=True, cwd=cwd)
    return p.returncode, p.stdout.strip(), p.stderr.strip()


# --- classe: servico --------------------------------------------------------

def containers(filtro=None):
    _, out, _ = sh(["docker", "ps", "--format", "{{.Names}}"])
    for nome in out.splitlines():
        if filtro and filtro != nome:
            continue
        _, j, _ = sh(["docker", "inspect", nome])
        try:
            d = json.loads(j)[0]
        except Exception:
            continue
        lab = d["Config"].get("Labels") or {}
        wd = lab.get("com.docker.compose.project.working_dir")
        if not wd:
            continue
        yield {
            "nome": nome,
            "servico": lab.get("com.docker.compose.service", "?"),
            "working_dir": wd,
            "config_files": lab.get("com.docker.compose.project.config_files", ""),
            "env": {l.split("=", 1)[0]: l.split("=", 1)[1] for l in d["Config"]["Env"] if "=" in l},
        }


def git_estado(caminho):
    rc, topo, _ = sh(["git", "-C", caminho, "rev-parse", "--show-toplevel"])
    if rc != 0:
        return None
    _, sha, _ = sh(["git", "-C", topo, "rev-parse", "--short", "HEAD"])
    _, porcelain, _ = sh(["git", "-C", topo, "status", "--porcelain"])
    linhas = [l for l in porcelain.splitlines() if l.strip()]
    # nao-rastreado e lixo de runtime; rastreado modificado e edicao que so existe aqui.
    modificado = [l for l in linhas if not l.startswith("??")]
    _, ref, _ = sh(["git", "-C", topo, "rev-parse", "--abbrev-ref", "HEAD"])
    _, atras, _ = sh(["git", "-C", topo, "rev-list", "--count", "HEAD..origin/main"])
    return {"topo": topo, "sha": sha, "ref": ref, "modificado": modificado,
            "nao_rastreado": len(linhas) - len(modificado),
            "atras": int(atras) if atras.isdigit() else None}


def env_declarado(c):
    arquivos = [f for f in c["config_files"].split(",") if f]
    base = ["docker", "compose"]
    for f in arquivos:
        base += ["-f", f]
    # `--profile "*"`: sem isso, servico sob profile (o rag-api esta em `serving`) some do
    # config renderizado e a conferencia acusa ausencia que nao existe.
    rc, out, err = sh(base + ["--profile", "*", "config", "--format", "json"], cwd=c["working_dir"])
    if rc != 0:
        rc, out, err = sh(base + ["config", "--format", "json"], cwd=c["working_dir"])
    if rc != 0:
        return None, err.splitlines()[-1] if err else "docker compose config falhou"
    try:
        cfg = json.loads(out)
    except Exception as e:
        return None, str(e)
    svc = (cfg.get("services") or {}).get(c["servico"])
    if svc is None:
        return None, f"servico {c['servico']} ausente no config renderizado"
    return {k: ("" if v is None else str(v)) for k, v in (svc.get("environment") or {}).items()}, None


def conferir_servico(alvo, como_json=False):
    houve = False
    vistos = 0
    servicos = []
    for c in containers(alvo):
        vistos += 1
        dentro_de_deploy = os.path.realpath(c["working_dir"]).startswith(os.path.realpath(DEPLOY))
        g = git_estado(c["working_dir"])
        divergencias = []
        if not como_json:
            print(f"\n### {c['nome']}  (servico {c['servico']})")
            print(f"    sobe de : {c['working_dir']}")
        if not dentro_de_deploy:
            houve = True
            divergencias.append("nao e worktree de deploy — producao sobe de clone de trabalho")
            if not como_json:
                print("    DERIVA  : nao e worktree de deploy — producao sobe de clone de trabalho")
        if g:
            if not como_json:
                print(f"    ref     : {g['ref']}@{g['sha']}")
                if g["atras"]:
                    print(f"    ATRAS   : {g['atras']} commits atras de origin/main")
            if g["modificado"]:
                houve = True
                divergencias.append(
                    f"{len(g['modificado'])} arquivo(s) rastreado(s) so existem aqui: "
                    + ", ".join(g["modificado"][:5])
                )
                if not como_json:
                    print(f"    EDITADO : {len(g['modificado'])} arquivo(s) rastreado(s) so existem aqui")
                    for l in g["modificado"][:5]:
                        print(f"              {l}")
            if not como_json and g["nao_rastreado"]:
                print(f"    lixo    : {g['nao_rastreado']} caminho(s) nao rastreado(s)")

        decl, erro = env_declarado(c)
        if decl is None:
            houve = True
            divergencias.append(f"nao consegui renderizar o compose — {erro}")
            if not como_json:
                print(f"    ENV     : nao consegui renderizar o compose — {erro}")
            servicos.append({"nome": c["nome"], "servico": c["servico"], "divergencias": divergencias})
            continue
        servido = c["env"]
        for k in sorted(decl):
            if k not in servido:
                houve = True
                divergencias.append(f"{k} declarado e nao servido (declarado={decl[k]!r})")
                if not como_json:
                    print(f"    AUSENTE : {k} declarado e nao servido (declarado={decl[k]!r})")
            elif servido[k] != decl[k]:
                houve = True
                divergencias.append(f"{k} declarado={decl[k]!r} servido={servido[k]!r}")
                if not como_json:
                    print(f"    DIFERE  : {k} declarado={decl[k]!r} servido={servido[k]!r}")
        if not any(k not in servido or servido[k] != decl[k] for k in decl):
            if not como_json:
                print(f"    env     : {len(decl)} variaveis, todas conferem")
        servicos.append({"nome": c["nome"], "servico": c["servico"], "divergencias": divergencias})
    if alvo and vistos == 0:
        msg = f"nenhum container em execucao com o nome {alvo!r} — nao confundir com conferido"
        if como_json:
            print(json.dumps({"erro": msg}))
        else:
            print(f"\n{msg}")
        return 1
    if not como_json:
        print()
    else:
        print(json.dumps({"resultado": "divergente" if houve else "ok", "servicos": servicos}))
    return 1 if houve else 0


# --- classe: verbo ----------------------------------------------------------

def e_script(caminho):
    try:
        with open(caminho, "rb") as f:
            return f.read(2) == b"#!"
    except OSError:
        return False


def cabecalho(caminho):
    """Le as tres linhas declaradas do contrato. Ausencia se reporta, nao se adivinha."""
    campos = {"proposito": None, "capacidade": None, "dono": None, "componente": None}
    try:
        with open(caminho, "r", errors="replace") as f:
            linhas = [next(f, "") for _ in range(8)]
    except OSError:
        return campos
    for i, l in enumerate(linhas):
        s = l.strip()
        if not s.startswith("#"):
            continue
        s = s.lstrip("#").strip()
        low = s.lower()
        if low.startswith("capacidade:"):
            campos["capacidade"] = s.split(":", 1)[1].strip()
        elif low.startswith("componente:"):
            campos["componente"] = s.split(":", 1)[1].strip()
        elif low.startswith("dono:"):
            campos["dono"] = s.split(":", 1)[1].strip()
        elif i == 1 and ("—" in s or " - " in s):
            campos["proposito"] = s
    return campos


def origem(nome, caminho):
    """Classifica de onde o verbo vem. Copia identica continua sendo copia."""
    if os.path.islink(caminho):
        destino = os.path.realpath(caminho)
        if destino.startswith(os.path.realpath(RAIZ)) and "/opt/" not in destino:
            return "symlink", destino
        return "terceiro", destino
    if not e_script(caminho):
        return "terceiro", "binario instalado"
    achados = []
    for base, _, arquivos in os.walk(RAIZ):
        if "/.git" in base or base.startswith(os.path.join(RAIZ, "opt")) or base == BIN:
            continue
        if nome in arquivos:
            achados.append(os.path.join(base, nome))
    if not achados:
        return "so-no-host", "sem contraparte em repo"
    rc, _, _ = sh(["diff", "-q", caminho, achados[0]])
    return ("copia" if rc == 0 else "divergente"), achados[0]


def capacidades_do_mapa():
    """Le os nomes de capacidade da tabela do mapa da mesa. Fonte e o repo de
    arquitetura; nao ha copia local — capacidade so existe se a mesa a lavrou."""
    import re
    try:
        texto = open(MAPA, errors="replace").read()
    except OSError:
        return None
    return set(re.findall(r"^\| `([a-z/-]+)` \|", texto, re.M))


def normaliza(cap):
    """Formas equivalentes do mesmo termo. BizBOK nomeia a capacidade por extenso
    (`gestao-de-motores`); o mapa da mesa lavra a contracao (`motor`). As duas valem,
    e nenhuma das duas e erro — o dicionario nao e do verificador."""
    c = (cap or "").strip().lower()
    for prefixo in ("gestao-de-", "gestao-do-", "gestao-da-", "gestao-dos-", "gestao-das-"):
        if c.startswith(prefixo):
            c = c[len(prefixo):]
            break
    formas = {c}
    if c.endswith("es"):
        formas.add(c[:-2])
    if c.endswith("s"):
        formas.add(c[:-1])
    return formas


def canonica(cap, validas):
    """Devolve o termo como o mapa o lavrou, ou None se nenhuma forma bater."""
    if validas is None or not cap:
        return None
    minhas = normaliza(cap)
    for v in validas:
        if normaliza(v) & minhas:
            return v
    return None


def conferir_verbo(alvo, como_json=False):
    houve = False
    validas = capacidades_do_mapa()
    porcapacidade = {}
    vistos = 0
    verbos_json = []
    for nome in sorted(os.listdir(BIN)):
        caminho = os.path.join(BIN, nome)
        if alvo and alvo != nome:
            continue
        classe, onde = origem(nome, caminho)
        if classe == "terceiro":
            continue
        # symlink cujo destino tem outro nome e ALIAS de um verbo ja contado: aparece
        # declarado, mas nao entra na conta de arq:0037 — senao a deprecacao de um verbo
        # o faz reprovar por existir duas vezes.
        #
        # SO E ALIAS SE O DESTINO TAMBEM ESTIVER EXPOSTO EM BIN sob o proprio nome
        # (20/08/2026). Sem esta segunda condicao, `fila` -> `fila_streams.py` caia como
        # alias por causa do sufixo `.py` e nao entrava na conta de capacidade nenhuma —
        # verbo unico do proprio ato, medido como se nao existisse. O nome de arquivo
        # carrega o sufixo porque o modulo TAMBEM e importado (`ops-server/server.py` e
        # `controle/tests/test_contrato_fila.py` fazem `import fila_streams`); o symlink
        # e o verbo. Alias de verdade e nome que DUPLICA outro ja exposto, e e so esse
        # caso que arq:0037 precisa isentar.
        if (classe == "symlink" and os.path.basename(onde) != nome
                and os.path.basename(onde) in os.listdir(BIN)):
            vistos += 1
            if not como_json:
                print(f"\n### {nome}")
                print(f"    alias   : de {os.path.basename(onde)} — nao conta na capacidade")
            else:
                verbos_json.append({
                    "nome": nome, "origem": "alias", "capacidade": None,
                    "conforme": True,
                    "motivos": [f"alias de {os.path.basename(onde)} — nao conta na capacidade"],
                })
            continue
        vistos += 1
        cab = cabecalho(caminho)
        faltando = [k for k in ("proposito", "capacidade", "dono") if not cab[k]]
        motivos = []
        conforme = True
        if not como_json:
            print(f"\n### {nome}")
            print(f"    origem  : {classe} — {onde}")
        if classe in ("so-no-host", "divergente"):
            houve = True
            conforme = False
            motivos.append("sem origem unica — copia nao e forma valida de instalacao")
            if not como_json:
                print("    ORIGEM  : sem origem unica — copia nao e forma valida de instalacao")
        elif classe == "copia":
            houve = True
            conforme = False
            motivos.append("copia identica por sorte, nao por mecanismo — trocar por symlink")
            if not como_json:
                print("    ORIGEM  : copia identica por sorte, nao por mecanismo — trocar por symlink")
        if faltando:
            houve = True
            conforme = False
            motivos.append(f"cabecalho incompleto: faltam {', '.join(faltando)}")
            if not como_json:
                print(f"    CABECAL : faltam {', '.join(faltando)}")
        else:
            if not como_json:
                comp = f" componente={cab['componente']}" if cab["componente"] else ""
                print(f"    cabecal : capacidade={cab['capacidade']} dono={cab['dono']}{comp}")
        cap = cab["capacidade"]
        canon = None
        if cap and cap != "orfa":
            if validas is None:
                if not como_json:
                    print("    aviso   : mapa de capacidades ilegivel — nao validei o nome")
            else:
                canon = canonica(cap, validas)
                if canon is None:
                    houve = True
                    conforme = False
                    motivos.append(f"capacidade {cap!r} nao esta no mapa da mesa")
                    if not como_json:
                        print(f"    CAPACID : {cap!r} nao esta no mapa da mesa — capacidade nao se inventa no cabecalho")
                elif canon != cap:
                    if not como_json:
                        print(f"    termo   : {cap!r} = {canon!r} no mapa (forma extensa e contracao valem)")
        porcapacidade.setdefault(canon or cab["capacidade"] or "(nao declarada)", []).append(nome)
        if como_json:
            verbos_json.append({
                "nome": nome, "origem": classe, "capacidade": canon or cab["capacidade"],
                "conforme": conforme, "motivos": motivos,
            })

    if alvo and vistos == 0:
        msg = f"{alvo!r} nao e verbo da plataforma em {BIN} — ou nao existe, ou e ferramenta de terceiro"
        if como_json:
            print(json.dumps({"erro": msg}))
        else:
            print(f"\n{msg}")
        return 1

    arq0037 = []
    if not alvo:
        if not como_json:
            print("\n## arq:0037 — um verbo por capacidade")
        for cap, verbos in sorted(porcapacidade.items()):
            # `orfa` e capacidade declarada como ausente: conta como nao conforme, sempre.
            fora_do_mapa = (validas is not None and cap not in ("(nao declarada)", "orfa")
                            and canonica(cap, validas) is None)
            conforme = len(verbos) == 1 and cap not in ("(nao declarada)", "orfa") and not fora_do_mapa
            marca = "ok " if conforme else "NAO"
            if marca == "NAO":
                houve = True
            if not como_json:
                print(f"    {marca}  {cap:<16} {len(verbos)}  {' '.join(verbos)}")
            else:
                arq0037.append({"capacidade": cap, "conforme": conforme, "verbos": verbos})
    if not como_json:
        print()
    else:
        print(json.dumps({"resultado": "divergente" if houve else "ok", "verbos": verbos_json, "arq0037": arq0037}))
    return 1 if houve else 0


# --- classe: repo -----------------------------------------------------------
# Regua de arq:0042. O que o instrumento NAO faz: nao olha historico. Conformacao e para
# frente (0042, "Conformacao e para frente"), entao o alvo e `git ls-files`, nunca
# `rev-list --all`; peso de pack nao e divergencia e nao entra na conta.
# Limite declarado: render gerado so se detecta por marca no cabecalho do arquivo.
# Ferramenta que nao assina o que gera passa, e passa em silencio.

EXT_ACERVO = {".epub", ".pdf", ".docx", ".doc", ".pptx", ".ppt", ".xlsx", ".xls",
              ".mobi", ".azw3", ".djvu", ".mp3", ".mp4", ".zip", ".tar", ".gz", ".7z"}
EXT_GRANEL = {".jsonl", ".tsv", ".csv", ".dump", ".parquet", ".sqlite", ".db"}
EXT_RENDER = {".svg", ".png"}
# Artefato regeneravel a partir do proprio fonte versionado: nunca e fonte, e nao tem
# piso de tamanho — 1 KB de bytecode versionado ja e a classe errada de arquivo.
EXT_GERADO = {".pyc", ".pyo", ".class", ".o", ".so", ".egg-info"}
DIR_GERADO = ("__pycache__/", "node_modules/", ".venv/", "dist/", "build/",
              ".pytest_cache/", ".mypy_cache/", ".ruff_cache/", ".tox/")
EXT_FONTE_RENDER = {".mmd", ".mermaid", ".d2", ".drawio", ".dot", ".puml", ".xml"}
PISO_ARQUIVO = 1024 * 1024   # acima disto nao e fonte editada a mao
PISO_GRANEL = 256 * 1024     # dump, manifesto e indice: estado extraivel, mora no banco
MARCA_GERADOR = (b"Generated by", b"generated by", b"Generator:", b"Do not edit")
# SVG com `mxfile` embutido e o formato editavel do drawio: abre, edita e salva no
# mesmo arquivo. E fonte, nao render, e por isso nao entra em MARCA_GERADOR.
MARCA_EDITAVEL = (b"mxfile", b"mxGraphModel")
FORA = {"archi_base", "i-have-adhd", "ollama-orchestrator"}   # outro dono: dubious ownership


def alvos_de_repo(alvo, staged=False):
    # No hook o alvo e o repo de onde o commit sai, e o cwd ja e a raiz dele.
    if staged:
        _, raiz, _ = sh(["git", "rev-parse", "--show-toplevel"])
        if not raiz:
            return []
        return [(os.path.basename(raiz), raiz)]
    return list(repos_de_trabalho(alvo))


def repos_de_trabalho(alvo=None):
    for nome in sorted(os.listdir(RAIZ)):
        if (alvo and nome != alvo) or nome in FORA:
            continue
        caminho = os.path.join(RAIZ, nome)
        if os.path.isdir(os.path.join(caminho, ".git")):
            yield nome, caminho


def excecoes(raiz):
    # `.conferir-repo` na raiz, linha `permite: <prefixo>  # motivo`. A excecao vale por
    # estar escrita no repo, nao por ser justa: fica no diff, e quem a escreveu responde.
    regras = []
    try:
        with open(os.path.join(raiz, ".conferir-repo"), encoding="utf-8") as f:
            for linha in f:
                linha = linha.split("#", 1)[0].strip()
                if linha.startswith("permite:"):
                    regras.append(linha.split(":", 1)[1].strip())
    except OSError:
        pass
    return regras


GENEROS = ("procedimento", "referencia", "referência", "explicacao", "explicação")
CAMPOS = ("**Gênero:**", "**Público:**", "**Derivada na wiki:**")


def documentos_de_operacao(raiz):
    """Os que o repo DECLARA como documento de operacao, em `docs/.operacao`.

    Declarado, nunca inferido: heuristica sobre `docs/*.md` reprovaria handoff, spec e
    ADR, que nao sao operacao e nao levam cabecalho. Repo sem o arquivo nao e medido —
    ausencia de declaracao nao vira reprovacao em massa.
    """
    alvo = os.path.join(raiz, "docs", ".operacao")
    try:
        with open(alvo, encoding="utf-8") as f:
            linhas = [l.split("#", 1)[0].strip() for l in f]
    except OSError:
        return []
    return [l for l in linhas if l]


def cabecalho_de_operacao(caminho):
    """Devolve o motivo da reprova, ou None quando o cabecalho esta la e completo."""
    try:
        with open(caminho, encoding="utf-8", errors="replace") as f:
            cabeca = "".join(f.readline() for _ in range(12))
    except OSError:
        return "arquivo declarado em docs/.operacao e nao existe"
    faltam = [c for c in CAMPOS if c not in cabeca]
    if faltam:
        return "sem " + ", ".join(faltam)
    linha = next((l for l in cabeca.splitlines() if "**Gênero:**" in l), "")
    valor = linha.split("**Gênero:**", 1)[1].split("·")[0].strip().lower()
    if valor not in GENEROS:
        return f"genero {valor!r} fora de procedimento|referencia|explicacao"
    return None


def gerado_por_ferramenta(caminho):
    try:
        with open(caminho, "rb") as f:
            cabeca = f.read(8192)
    except OSError:
        return False
    if any(m in cabeca for m in MARCA_EDITAVEL):
        return False
    return any(m in cabeca for m in MARCA_GERADOR)


def conferir_repo(alvo, staged=False, como_json=False):
    houve = False
    vistos = 0
    repos_json = []
    for nome, raiz in alvos_de_repo(alvo, staged):
        vistos += 1
        divergiu = False
        _, out, _ = sh(["git", "ls-files", "-z"], cwd=raiz)
        arquivos = [p for p in out.split("\0") if p]
        if staged:
            # Julga so o que este commit acrescenta ou muda. Divergencia preexistente
            # do repo e assunto de `conferir repo`, nao motivo para barrar commit alheio.
            _, st, _ = sh(["git", "diff", "--cached", "--name-only",
                           "--diff-filter=ACMR", "-z"], cwd=raiz)
            sob_juizo = [p for p in st.split("\0") if p]
        else:
            sob_juizo = arquivos
        bases = {os.path.splitext(a)[0]: os.path.splitext(a)[1].lower() for a in arquivos}
        fontes = {b for b, e in bases.items() if e in EXT_FONTE_RENDER}
        regras = excecoes(raiz)
        try:
            with open(os.path.join(raiz, "README.md"), encoding="utf-8", errors="replace") as f:
                readme = f.read()
        except OSError:
            readme = None

        peso = 0
        topos = {a.split("/", 1)[0] + "/" for a in arquivos if "/" in a}
        achados = {"GERADO": [], "ACERVO": [], "GRANEL": [], "GORDO": [], "RENDER": []}
        sem_cabecalho = []
        for rel in documentos_de_operacao(raiz):
            if staged and rel not in sob_juizo:
                continue
            motivo = cabecalho_de_operacao(os.path.join(raiz, rel))
            if motivo:
                sem_cabecalho.append((rel, motivo))
        for rel in sob_juizo:
            caminho = os.path.join(raiz, rel)
            try:
                tam = os.path.getsize(caminho)
            except OSError:
                continue
            peso += tam
            if any(rel.startswith(r) for r in regras):
                continue
            ext = os.path.splitext(rel)[1].lower()
            if ext in EXT_GERADO or any(d in rel + "/" for d in DIR_GERADO):
                achados["GERADO"].append((rel, tam))
            elif ext in EXT_ACERVO:
                achados["ACERVO"].append((rel, tam))
            elif ext in EXT_GRANEL and tam > PISO_GRANEL:
                achados["GRANEL"].append((rel, tam))
            elif tam > PISO_ARQUIVO:
                achados["GORDO"].append((rel, tam))
            if ext in EXT_RENDER:
                base = os.path.splitext(rel)[0]
                if gerado_por_ferramenta(caminho) and base not in fontes:
                    achados["RENDER"].append((rel, tam))
                elif rel.endswith(".drawio.svg"):
                    # Fonte e render no mesmo arquivo: o drawio reabre o proprio SVG.
                    pass
                elif base not in fontes:
                    # Fonte no mesmo diretorio com nome-base que so difere de sufixo:
                    # a 0042 exige o mesmo nome-base para render e fonte.
                    irma = [f for f in fontes
                            if os.path.dirname(f) == os.path.dirname(base)
                            and base.startswith(f) and base != f]
                    if irma:
                        achados["RENDER"].append((rel, tam))

        if not como_json:
            print(f"\n### {nome}")
            if staged:
                print(f"    commit  : {len(sob_juizo)} arquivo(s) sob juizo")
            else:
                print(f"    peso    : {peso / 1048576:.1f} MB rastreados em {len(arquivos)} arquivos")
        for rotulo in ("GERADO", "ACERVO", "GRANEL", "GORDO", "RENDER"):
            itens = achados[rotulo]
            if not itens:
                continue
            houve = divergiu = True
            if not como_json:
                for rel, tam in sorted(itens, key=lambda x: -x[1])[:8]:
                    print(f"    {rotulo:<8}: {tam / 1048576:>7.2f} MB  {rel}")
                if len(itens) > 8:
                    soma = sum(t for _, t in itens[8:]) / 1048576
                    print(f"    {rotulo:<8}: + {len(itens) - 8} outros, {soma:.1f} MB")
        if sem_cabecalho:
            houve = divergiu = True
            if not como_json:
                for rel, motivo in sorted(sem_cabecalho):
                    print(f"    CABECALHO: {rel} — {motivo}")
                print("    arq:0049 — documento de operacao abre declarando genero e publico,")
                print("    e nomeia a pagina de Operar: que deriva dele (ou declara que nao ha).")
        readme_ok = None
        if staged:
            if not como_json and divergiu:
                print("\n    arq:0042 — isto nao e fonte editada a mao. Ou o arquivo tem morada")
                print("    fora do git, ou a excecao se declara em `.conferir-repo` na raiz:")
                print("        permite: <prefixo-de-caminho>   # motivo")
                print("    Passar por cima: git commit --no-verify (fica so no teu terminal).")
        else:
            if readme is None:
                houve = divergiu = True
                readme_ok = False
                if not como_json:
                    print("    README  : ausente — e nele que o conjunto dos diretorios de topo se declara")
            else:
                mudos = sorted(t for t in topos if t not in readme)
                if mudos:
                    houve = divergiu = True
                    readme_ok = False
                    if not como_json:
                        print(f"    TOPO    : nao declarado no README: {' '.join(mudos)}")
                else:
                    readme_ok = True
            if not como_json and not divergiu:
                print("    regua   : conforme a arq:0042")
        if como_json:
            repos_json.append({
                "nome": nome,
                "achados": {k: [{"caminho": r, "bytes": t} for r, t in v] for k, v in achados.items()},
                "sem_cabecalho": [{"caminho": r, "motivo": m} for r, m in sem_cabecalho],
                "readme_ok": readme_ok,
            })

    if alvo and vistos == 0:
        msg = f"{alvo!r} nao e clone de trabalho em {RAIZ}"
        if como_json:
            print(json.dumps({"erro": msg}))
        else:
            print(f"\n{msg}")
        return 1
    if not como_json:
        print()
    else:
        print(json.dumps({"resultado": "divergente" if houve else "ok", "repos": repos_json}))
    return 1 if houve else 0


# --- classe: commit ---------------------------------------------------------
# O elo item<->commit do DORA (card #471).
#
# A REGUA NAO MORA AQUI, e nem no hook: mora no rastreador. Este codigo NAO tem copia do
# formato da citacao nem da nocao de "item fechado" — ele manda a mensagem para
# `POST /commits/conferir` e imprime o veredito. Gate e conferencia que leem reguas
# diferentes divergem em silencio no primeiro ajuste que so um dos dois receber, e a
# convencao de citacao e do produto, nao do harness.
#
# TRES LIMITES DECLARADOS, e cada um custou uma medicao:
#
#   1. OPT-IN POR REPO, por `.conferir-commit` na raiz — mesmo padrao do `.conferir-repo`.
#      `core.hooksPath` aponta um DIRETORIO: um arquivo novo em `hooks/` liga o gate no
#      mesmo instante em todos os clones e worktrees que apontam para la (20, medidos), sem
#      aviso e sem rollout. Repo sem o arquivo sai 0 e calado.
#
#   2. FAIL-OPEN COM AVISO quando o rastreador nao responde, seguindo o precedente escrito
#      no `pre-commit` para `conferir` ausente ("commit segue sem gate", exit 0). O motivo
#      e medido: `deploy rastreador down` e ato de ROTINA declarado no registro de stacks
#      (`"critico": false`), e fail-closed transformaria manutencao normal de qualquer
#      cadeira em parada da casa — com `--no-verify` como saida obvia, que desligaria
#      JUNTO o `conferir repo --staged` que hoje funciona.
#      O custo do fail-open tambem e declarado: a serie do DORA fica com buracos nas
#      janelas em que a API esteve fora, e buraco de serie nao se ve depois.
#
#   3. AUSENCIA DE ID NAO RECUSA. A F9 enumera dois predicados de recusa — id inexistente
#      e id de item fechado — e nao ha terceiro. Medido: 332 dos 400 commits do harness
#      desde 01/08 nao citam id nenhum. Gate que reprova o que ja estava la vira
#      `--no-verify` por habito, e ai nao gateia mais nada.
#
# Limite que vale repetir, porque nenhuma metrica construida sobre este gate pode ignora-lo:
# hook e local, `git commit --no-verify` passa por cima e nao ha gate no push do forge.
# Isto mede quem nao burlou; nao mede a casa.

DECLARACAO_DE_COMMIT = ".conferir-commit"
BASE_RASTREADOR = "http://127.0.0.1:8120"
TIMEOUT_RASTREADOR = 3.0


def declaracao_de_commit(raiz):
    """`.conferir-commit` na raiz do repo: opt-in do gate, e onde o rastreador responde.

    Forma, igual a do `.conferir-repo` — chave, dois pontos, valor, `#` comenta:

        base: http://127.0.0.1:8120   # onde o rastreador atende
        timeout: 3                    # segundos

    Devolve None quando o arquivo nao existe: nao e erro, e "este repo nao pediu gate".
    """
    caminho = os.path.join(raiz, DECLARACAO_DE_COMMIT)
    if not os.path.exists(caminho):
        return None
    decl = {"base": BASE_RASTREADOR, "timeout": TIMEOUT_RASTREADOR}
    try:
        with open(caminho, encoding="utf-8") as f:
            for linha in f:
                linha = linha.split("#", 1)[0].strip()
                if ":" not in linha:
                    continue
                chave, valor = linha.split(":", 1)
                chave, valor = chave.strip(), valor.strip()
                if chave == "base" and valor:
                    decl["base"] = valor.rstrip("/")
                elif chave == "timeout" and valor:
                    try:
                        decl["timeout"] = float(valor)
                    except ValueError:
                        pass
    except OSError:
        pass
    return decl


def pergunta_ao_rastreador(base, mensagem, timeout):
    """Manda a mensagem e devolve (veredito, erro). Um dos dois e None, nunca os dois."""
    corpo = json.dumps({"mensagem": mensagem}).encode("utf-8")
    req = urllib.request.Request(
        f"{base}/commits/conferir", data=corpo, method="POST",
        headers={"content-type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:  # noqa: S310 — loopback declarado
            return json.loads(r.read().decode("utf-8")), None
    except urllib.error.HTTPError as e:
        return None, f"{base} respondeu HTTP {e.code}"
    except urllib.error.URLError as e:
        return None, f"{base} nao respondeu ({e.reason})"
    except (TimeoutError, OSError) as e:
        return None, f"{base} nao respondeu ({type(e).__name__})"
    except (ValueError, KeyError) as e:
        return None, f"{base} respondeu o que nao e veredito ({type(e).__name__})"


def conferir_commit(alvo, como_json=False):
    if not alvo:
        if como_json:
            print(json.dumps({"erro": "uso: conferir commit <arquivo-da-mensagem>|-"}))
            return 2
        uso("commit exige o caminho do arquivo da mensagem (ou `-` para stdin)")

    _, raiz, _ = sh(["git", "rev-parse", "--show-toplevel"])
    if not raiz:
        msg = "fora de um repositorio git: nao ha mensagem de commit para julgar"
        if como_json:
            print(json.dumps({"erro": msg}))
        else:
            print(f"erro: {msg}", file=sys.stderr)
        return 2

    decl = declaracao_de_commit(raiz)
    if decl is None:
        # Nao e conformidade: e ausencia de opt-in, e se declara como tal.
        if como_json:
            print(json.dumps({
                "resultado": "nao-declarado",
                "repo": os.path.basename(raiz),
                "motivo": f"{DECLARACAO_DE_COMMIT} nao existe na raiz — este repo nao pediu o gate",
            }))
        return 0

    try:
        if alvo == "-":
            mensagem = sys.stdin.read()
        else:
            with open(alvo, encoding="utf-8", errors="replace") as f:
                mensagem = f.read()
    except OSError as e:
        msg = f"nao consegui ler a mensagem em {alvo!r}: {e}"
        if como_json:
            print(json.dumps({"erro": msg}))
        else:
            print(f"erro: {msg}", file=sys.stderr)
        return 2

    veredito, erro = pergunta_ao_rastreador(decl["base"], mensagem, decl["timeout"])
    if veredito is None:
        # FAIL-OPEN, com aviso. Ver o limite 2 no cabecalho desta classe.
        if como_json:
            print(json.dumps({"resultado": "sem-gate", "motivo": erro}))
        else:
            print(f"conferir commit: {erro} — commit segue sem gate de id.", file=sys.stderr)
        return 0

    recusas = veredito.get("recusas") or []
    avisos = veredito.get("avisos") or []
    if como_json:
        print(json.dumps({
            "resultado": "divergente" if recusas else "ok",
            "repo": os.path.basename(raiz),
            "base": decl["base"],
            "ids": veredito.get("ids") or [],
            "recusas": recusas,
            "avisos": avisos,
        }, ensure_ascii=False))
    else:
        for a in avisos:
            print(f"conferir commit: aviso — {a.get('texto', a)}", file=sys.stderr)
        if recusas:
            print("\ncommit: a mensagem cita id que o rastreador recusa.\n", file=sys.stderr)
            for r in recusas:
                print(f"    RECUSA  item {r.get('id')} — {r.get('texto')}", file=sys.stderr)
            print("\n    card #471 — a citacao no commit e o elo item<->deploy do", file=sys.stderr)
            print("    DORA, e ela so vale se o id existir e o item estiver aberto. Ou corrija", file=sys.stderr)
            print("    o trailer `Item: <id>` no rodape da mensagem, ou tire-o: mensagem sem", file=sys.stderr)
            print("    citacao NAO e recusada.", file=sys.stderr)
            print("    Passar por cima: git commit --no-verify (fica so no teu terminal).\n", file=sys.stderr)
    return 1 if recusas else 0


# --- despacho ---------------------------------------------------------------


# --- classe: skill ----------------------------------------------------------

HARNESS = os.path.expanduser("~/AI/platafirma-harness")


def _texto_da_fita():
    """Arquivos que a FITA carrega: pacote de abertura mais skills plantadas.

    Nao e a lista do que existe no harness — e a do que atravessa para o giro
    headless. Texto que a fita nao carrega pode nomear tool MCP a vontade.
    """
    alvos = []
    for sub in ("personas", "tool-manifest"):
        d = os.path.join(HARNESS, sub)
        if not os.path.isdir(d):
            continue
        for nome in sorted(os.listdir(d)):
            if nome.endswith(".md"):
                alvos.append(os.path.join(d, nome))
    skills = os.path.join(HARNESS, "skills")
    if os.path.isdir(skills):
        for nome in sorted(os.listdir(skills)):
            md = os.path.join(skills, nome, "SKILL.md")
            if not os.path.isfile(md):
                continue
            with open(md, encoding="utf-8", errors="replace") as f:
                cabeca = f.read(2000)
            # So a skill plantada atravessa: `cadeiras:` ausente ou `nenhuma`
            # significa que ela nunca chega na fita (bin/chat, planta_skills).
            m = re.search(r"^cadeiras:\s*(.+)$", cabeca, re.M)
            if m and "nenhuma" not in m.group(1).lower():
                alvos.append(md)
    return alvos


def _quebradas_no_staged(padrao, servidas):
    """Linhas ADICIONADAS pelo commit em curso, nos arquivos que a fita carrega."""
    carregados = {os.path.relpath(c, HARNESS) for c in _texto_da_fita()}
    rc, saida, _ = sh(["git", "-C", HARNESS, "diff", "--cached", "--unified=0"])
    if rc != 0:
        return []
    achados, arquivo, linha_n = [], None, 0
    for linha in saida.split("\n"):
        if linha.startswith("+++ b/"):
            arquivo = linha[6:].strip()
            continue
        if linha.startswith("@@"):
            m = re.search(r"\+(\d+)", linha)
            linha_n = int(m.group(1)) if m else 0
            continue
        if not linha.startswith("+") or linha.startswith("+++"):
            continue
        if arquivo in carregados:
            for t in _tools_citadas(linha[1:], padrao):
                if t not in servidas:
                    achados.append((arquivo, linha_n, t))
        linha_n += 1
    return achados


# --- arranque em cwd: ponteiro, nunca copia ---------------------------------
# Regua de claudinha-gestao-estrategica, escrita em conduta/arranque.md. Aqui so
# o mecanismo. Existe porque regua descritiva nao dispara: foi copia por habito
# que produziu as 27 worktrees divergentes, e nada impedia a proxima de recomecar
# a serie sem ninguem medir quando recomecou.
PONTEIRO_ARRANQUE = "conduta/arranque.md"

# Sinal de que o arquivo TEM bloco de arranque proprio, em vez de so apontar.
# Dois sinais bastam: um sozinho aparece em texto que fala de arranque de
# passagem, e reprovar por mencao unica transformaria o gate em ruido.
SINAIS_ARRANQUE = (
    re.compile(r"monta[_-]sessao", re.I),
    re.compile(r"vasculh", re.I),
    re.compile(r"de onde sai a cadeira", re.I),
    re.compile(r"primeira a[cç][aã]o", re.I),
    re.compile(r"improvis\w* cadeira", re.I),
    re.compile(r"PF_CADEIRA.{0,30}export", re.I | re.S),
)

# Diretorios de ~/AI que NAO sao nossos: dono outro, git de outro, CLAUDE.md que
# nao responde a esta regua. Ignorar em silencio seria pior — consta aqui com nome.
FORA_DA_REGUA = ("archi_base", "ollama-orchestrator", "mdm_rh", "i-have-adhd")

# INSTANCIA EFEMERA, nao produtor (#23, espelho do 708cb3d que curou `conferir superficie`).
# `fitas/*/CLAUDE.md` e reescrito por `bin/chat:claude_md_da_fita` a cada giro, nao e
# rastreado, e o veredito dele oscilava com quantas fitas existiam no disco — media o
# passado (um cwd de ontem), nao quem decide o texto de toda fita futura. Sai do veredito
# e vira OBSERVACAO de deriva. O produtor e medido a parte, por nome.
INSTANCIA_EFEMERA = ("fitas",)
# O produtor das fitas: funcao que gera o CLAUDE.md. Nao se le por AST (e f-string, nao
# dict literal); declara-se por nome, como superficie declara `codigo`/`arquivo-rastreado`.
PRODUTOR_FITA = "platafirma-harness/bin/chat:claude_md_da_fita"


def _claude_mds(raiz=None, incluir_efemero=False):
    """CLAUDE.md sob ~/AI, ate 2 niveis. Nao segue link e nao entra em .git.

    Por padrao devolve so o PRODUTOR — o CLAUDE.md rastreado, um por repo (#23). A
    instancia efemera (`fitas/*`) so entra com `incluir_efemero=True`, e ai como
    observacao de deriva, nunca como veredito."""
    raiz = raiz or os.path.expanduser("~/AI")
    achados = []
    for topo in sorted(os.listdir(raiz)):
        if topo.startswith(".") or topo in FORA_DA_REGUA:
            continue
        if topo in INSTANCIA_EFEMERA and not incluir_efemero:
            continue
        base = os.path.join(raiz, topo)
        if not os.path.isdir(base) or os.path.islink(base):
            continue
        for cand in (os.path.join(base, "CLAUDE.md"),):
            if os.path.isfile(cand):
                achados.append(cand)
        for sub in sorted(os.listdir(base)):
            if sub.startswith("."):
                continue
            cand = os.path.join(base, sub, "CLAUDE.md")
            if os.path.isfile(cand) and not os.path.islink(os.path.join(base, sub)):
                achados.append(cand)
    return achados


def _julga_arranque(texto):
    """`aponta` . `copia` . `sem-arranque`. Apontar vence: arquivo que aponta e
    ainda explica algo do proprio cwd nao e copia — a copia e a que substitui."""
    if PONTEIRO_ARRANQUE in texto:
        return "aponta", 0
    n = sum(1 for r in SINAIS_ARRANQUE if r.search(texto))
    return ("copia" if n >= 2 else "sem-arranque"), n


def _rastreado_em(caminho):
    """Branch que rastreia o arquivo, ou None. Copia em arquivo rastreado nao se
    conserta escrevendo no cwd: o proximo checkout desfaz. Conserta-se no branch."""
    d, nome = os.path.dirname(caminho), os.path.basename(caminho)
    rc, _, _ = sh(["git", "-C", d, "ls-files", "--error-unmatch", nome])
    if rc != 0:
        return None
    rc, out, _ = sh(["git", "-C", d, "rev-parse", "--abbrev-ref", "HEAD"])
    return (out.strip() or "?") if rc == 0 else "?"


def conferir_arranque(alvo=None, staged=False, como_json=False):
    """Texto de arranque em cwd: ponteiro para a peca, nunca copia dela.

    Nao julga a REDACAO do arranque — isso e da dona do texto. Julga uma coisa
    so: o cwd repete o bloco em redacao propria onde deveria haver o ponteiro.
    """
    if staged:
        rc, saida, _ = sh(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"])
        if rc != 0:
            print(json.dumps({"erro": "git diff --cached falhou"}) if como_json
                  else "git diff --cached falhou")
            return 1
        rc2, topo, _ = sh(["git", "rev-parse", "--show-toplevel"])
        base = topo.strip() if rc2 == 0 else os.getcwd()
        alvos = [os.path.join(base, n) for n in saida.split("\n")
                 if n.strip().endswith("CLAUDE.md") and os.path.isfile(os.path.join(base, n))]
    else:
        alvos = _claude_mds()
        if alvo:
            alvos = [c for c in alvos if alvo in c]
            if not alvos:
                msg = f"nenhum CLAUDE.md sob ~/AI casa com {alvo!r}"
                print(json.dumps({"erro": msg}, ensure_ascii=False) if como_json else msg)
                return 2

    linhas, copias = [], []
    for c in alvos:
        try:
            with open(c, encoding="utf-8", errors="replace") as f:
                texto = f.read()
        except OSError:
            continue
        veredito, n = _julga_arranque(texto)
        rel = os.path.relpath(c, os.path.expanduser("~/AI"))
        item = {"arquivo": rel, "veredito": veredito, "sinais": n}
        if veredito == "copia":
            item["rastreado_em"] = _rastreado_em(c)
            copias.append(item)
        linhas.append(item)

    # OBSERVACAO de deriva (nao veredito): a instancia efemera das fitas. So no passe amplo
    # (sem alvo, sem --staged). Fita cujo CLAUDE.md nao aponta e sinal de que o produtor
    # `bin/chat:claude_md_da_fita` derivou, ou de um cwd de giro antigo — nao muda veredito.
    deriva = []
    if not staged and not alvo:
        for c2 in _claude_mds(incluir_efemero=True):
            rel2 = os.path.relpath(c2, os.path.expanduser("~/AI"))
            if rel2.split(os.sep)[0] not in INSTANCIA_EFEMERA:
                continue
            try:
                with open(c2, encoding="utf-8", errors="replace") as f:
                    v2, n2 = _julga_arranque(f.read())
            except OSError:
                continue
            if v2 != "aponta":
                deriva.append({"arquivo": rel2, "veredito": v2, "sinais": n2})

    ok = not copias
    if como_json:
        print(json.dumps({
            "veredito": "em dia" if ok else "divergente",
            "ponteiro": PONTEIRO_ARRANQUE,
            "medidos": len(linhas),
            "copias": copias,
            "arquivos": linhas,
            "produtor_fita": PRODUTOR_FITA,
            "deriva_efemera": deriva,
        }, ensure_ascii=False, indent=2))
        return 0 if ok else 1

    print(f"arranque em cwd (ponteiro: {PONTEIRO_ARRANQUE})")
    print(f"  medidos                          : {len(linhas)}")
    for e in ("aponta", "sem-arranque"):
        print(f"  {e:<33}: {sum(1 for x in linhas if x['veredito'] == e)}")
    print(f"  COPIA (bloco proprio, sem apontar): {len(copias)}")
    for x in copias:
        onde = f"rastreado em {x['rastreado_em']}" if x["rastreado_em"] else "nao rastreado"
        print(f"      {x['arquivo']} — {onde}")
    if copias:
        print("  conserto: trocar o bloco pelo ponteiro. Onde e rastreado, o conserto e")
        print("            commit no branch — escrever no cwd o proximo checkout desfaz.")
    print(f"  veredito                         : {'em dia' if ok else 'divergente'}")
    if not staged and not alvo:
        print("  --- observacao (nao entra no veredito) ---")
        print(f"  produtor das fitas               : {PRODUTOR_FITA}")
        if deriva:
            print(f"  fitas DERIVADAS do produtor      : {len(deriva)}")
            for x in deriva:
                print(f"      {x['arquivo']} — {x['veredito']} ({x['sinais']} sinais)")
        else:
            print("  fitas derivadas do produtor      : 0 (todas apontam)")
    return 0 if ok else 1


def _canonico_da_cadeira(cadeira):
    """`TI` -> `claudinho-TI`. Fonte: a linha 1 da persona, a mesma que o montador
    e o `descansar` leem. Sem persona legivel, devolve o que veio."""
    if not cadeira:
        return cadeira
    if cadeira.startswith(("claudinho-", "claudinha-")):
        return cadeira
    caminho = os.path.join(HARNESS, "personas", f"persona-{cadeira}.md")
    try:
        with open(caminho, encoding="utf-8") as f:
            primeira = f.readline()
    except OSError:
        return cadeira
    m = re.search(r"\b(claudinh[oa]-[\w-]+)", primeira)
    return m.group(1) if m else cadeira


def _conectores_do_produtor(prod):
    """Nomes de conector que o PRODUTOR de uma superficie escreve. (nomes, erro).

    Dois tipos, e nenhum depende de haver cwd vivo:
      codigo            — dict literal no fonte (ex. CONECTORES em bin/chat), lido
                          por AST. Sem importar o modulo: `bin/chat` tem efeito no
                          import e o gate nao pode dispara-lo.
      arquivo-rastreado — o proprio `.mcp.json` da raiz do repo, que o git replica
                          para cada worktree. O produtor, aqui, e o git.
    """
    tipo = prod.get("tipo")
    if tipo == "arquivo-rastreado":
        caminho = os.path.join(HARNESS, prod.get("caminho", ".mcp.json"))
        try:
            with open(caminho, encoding="utf-8") as f:
                return set(json.load(f).get("mcpServers", {})), None
        except (OSError, ValueError) as e:
            return set(), f"{prod.get('caminho')}: {e}"
    if tipo == "bash-heredoc-json":
        # entrada.sh nao e Python: escreve o mcp_config.json do agy via heredoc bash
        # (`cat > arquivo <<MARCADOR ... MARCADOR`), reescrito a cada boot. O parser
        # aqui e do HEREDOC, nunca do mcp_config.json que ele produz dentro do
        # conteiner — a distincao importa: medir o script e medir o que TODO boot
        # futuro grava; ler o arquivo produzido seria medir uma instancia, e essa
        # ja existe como o check de endpoint (#165), que prova mais (conecta de
        # verdade) do que uma leitura de arquivo provaria.
        caminho = os.path.join(HARNESS, prod.get("arquivo", ""))
        marcador = prod.get("marcador", "JSON")
        try:
            texto = open(caminho, encoding="utf-8").read()
        except OSError as e:
            return set(), f"{prod.get('arquivo')}: {e}"
        quebra = chr(10)
        marca_abre = "<<" + marcador
        pos = texto.find(marca_abre)
        if pos == -1:
            return set(), f"heredoc <<{marcador} nao encontrado em {prod.get('arquivo')}"
        linhas_apos = texto[pos + len(marca_abre):].split(quebra)[1:]
        corpo, fechou = [], False
        for linha in linhas_apos:
            if linha.strip() == marcador:
                fechou = True
                break
            corpo.append(linha)
        if not fechou:
            return set(), f"heredoc <<{marcador} nao fechou em {prod.get('arquivo')}"
        try:
            dado = json.loads(quebra.join(corpo))
        except ValueError as e:
            return set(), f"heredoc de {prod.get('arquivo')} nao e JSON valido: {e}"
        return set(dado.get("mcpServers", {})), None
    if tipo == "codigo":
        caminho = os.path.join(HARNESS, prod.get("arquivo", ""))
        simbolo = prod.get("simbolo", "")
        try:
            import ast
            arvore = ast.parse(open(caminho, encoding="utf-8").read())
        except (OSError, SyntaxError) as e:
            return set(), f"{prod.get('arquivo')}: {e}"
        for no in ast.walk(arvore):
            if not isinstance(no, ast.Assign):
                continue
            for alvo in no.targets:
                if isinstance(alvo, ast.Name) and alvo.id == simbolo:
                    if isinstance(no.value, ast.Dict):
                        nomes = set()
                        for k in no.value.keys:
                            if isinstance(k, ast.Constant) and isinstance(k.value, str):
                                nomes.add(k.value)
                        return nomes, None
                    return set(), f"{simbolo} nao e dict literal"
        return set(), f"{simbolo} nao encontrado em {prod.get('arquivo')}"
    return set(), f"tipo de produtor desconhecido: {tipo!r}"


# CARD #165. `agy` (Jaiminho, Antigravity CLI) e a unica superficie cujo conector
# escrevemos NOS e le um CLI de TERCEIRO — o schema dele nao e o nosso, e chave
# desconhecida ele descarta CALADA (nem sobe o servidor, nem loga erro). O achado
# que originou o card: `httpUrl` (chave do gemini-cli) no lugar de `serverUrl`
# (schema do Antigravity CLI) ficou dois dias sem ninguem notar porque a checagem
# estrutural — o conector EXISTE no dict, com o nome certo — nao prova que o
# CLIENTE consegue le-lo. So bater no endpoint prova.
#
# POR ISSO A MEDIDA E `initialize`, NUNCA LER mcp_config.json: o arquivo bem
# formado com a chave errada e EXATAMENTE o que passou calado da ultima vez. Um
# `initialize` (handshake MCP, sem tocar tool nenhuma) DE DENTRO DO CONTEINER
# distingue 200 (conectou) de 401/timeout/conexao recusada sem ambiguidade.
_MCP_INITIALIZE = json.dumps({
    "jsonrpc": "2.0", "id": 1, "method": "initialize",
    "params": {"protocolVersion": "2025-06-18", "capabilities": {},
               "clientInfo": {"name": "conferir", "version": "0"}},
})


def _verifica_endpoint_mcp(container, url):
    """(codigo_http | None, erro | None). `docker exec` porque a porta da ponte
    nao e publicada no host (`docker inspect` confirma: só existe na rede do
    contêiner) — bater nela de fora nem é possível, teria de ser sempre daqui."""
    try:
        p = subprocess.run(
            ["docker", "exec", container, "curl", "-s", "-o", "/dev/null",
             "-w", "%{http_code}", "--max-time", "10", "-X", "POST", url,
             "-H", "Content-Type: application/json",
             "-H", "Accept: application/json, text/event-stream",
             "-d", _MCP_INITIALIZE],
            capture_output=True, text=True, timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as e:
        return None, f"{type(e).__name__}: {e}"
    if p.returncode != 0:
        return None, (p.stderr or p.stdout or f"docker exec saiu {p.returncode}").strip()[:200]
    codigo = (p.stdout or "").strip()
    return (codigo, None) if codigo else (None, "sem resposta")


def conferir_superficie(alvo=None, staged=False, como_json=False):
    """Equalizacao das superficies: mesmo comportamento, mesmos conectores.

    Julga tres coisas, e nenhuma delas e opiniao:
      1. superficie verificavel do host cujo `.mcp.json` NAO serve os conectores
         que ela declara — meio prometido e nao servido;
      2. capacidade declarada como `nas_tres` cujo meio cita tool que nenhum
         conector serve — capacidade sem meio em lugar nenhum;
      3. texto que a fita carrega citando tool que NENHUM conector da fita serve.

    O (3) e o gate: depois de 15/08 as tools do MCP existem na fita, entao citar
    `run_command` deixou de ser quebra. Quebra agora e citar o que nao existe em
    conector nenhum — inclusive tool que um dia saia do servidor.

    claude.ai nao e verificavel daqui, e isso sai declarado — nao confundir
    "nao medido" com "em dia".
    """
    registro = os.path.join(HARNESS, "registro", "superficies.json")  # arq:0073: dado agora em registro/
    try:
        with open(registro, encoding="utf-8") as f:
            reg = json.load(f)
    except (OSError, ValueError) as e:
        msg = f"registro de superficies ilegivel ({registro}): {e}"
        print(json.dumps({"erro": msg}) if como_json else msg)
        return 1

    conectores = reg.get("conectores", {})
    servidas = {t for c in conectores.values() for t in c.get("serve", [])}
    # Conhecidas = servidas hoje + aposentadas. Sao as unicas que o gate sabe
    # julgar; nome que nunca esteve no registro passa, e isso esta declarado.
    conhecidas = servidas | set(reg.get("aposentadas", {}).get("nomes", []))
    padrao = re.compile(r"\bmcp__[\w-]+__(\w+)\b|\b(" +
                        "|".join(re.escape(t) for t in sorted(conhecidas)) + r")\b")

    nao_servidos, sem_meio, quebradas = [], [], []

    # 1. o meio prometido esta mesmo servido na superficie
    #
    # ZERO INSTANCIA NAO E DIVERGENCIA. A fabrica so existe no host enquanto ha
    # worktree aberta; limpas as worktrees, nao ha `.mcp.json` a ler e o conjunto
    # de conectores achados vem vazio — o que, sem esta guarda, era relatado como
    # "falta claudinho-mcp" e reprovava o commit de QUALQUER cadeira. Foi o que
    # travou claudinha-gestao-estrategica em 16/08/2026. Superficie sem instancia
    # viva sai como NAO MEDIDA, com o motivo, porque nao medido nao e em dia — e
    # tambem nao e defeito.
    # PRODUTOR, NAO INSTANCIA. Quem escreve o `.mcp.json` de cada superficie e o
    # que se mede; cwd vivo e amostra do passado. Ler os wt-*/.mcp.json era ler N
    # copias do MESMO arquivo rastreado no repo — tautologia cujo veredito
    # dependia de quantas worktrees existiam no momento. Zero worktree fazia o
    # gate acusar "falta claudinho-mcp" e reprovar o commit de toda cadeira.
    sem_produtor, deriva = [], []
    for nome, sup in reg.get("superficies", {}).items():
        if not sup.get("verificavel_do_host"):
            continue
        exigidos = set(sup.get("conectores", []))
        prod = sup.get("produtor")
        if not prod:
            sem_produtor.append(nome)
            continue
        produzidos, erro = _conectores_do_produtor(prod)
        if erro:
            nao_servidos.append((nome, f"produtor ilegivel: {erro}"))
            continue
        for falta in sorted(exigidos - produzidos):
            nao_servidos.append((nome, falta))
        # Instancia viva vira OBSERVACAO: deriva entre o que o produtor escreve
        # hoje e o que um cwd de ontem carrega e informacao util, mas nao veredito.
        for caminho in _mcp_jsons_da_superficie(nome):
            try:
                with open(caminho, encoding="utf-8") as f:
                    tem = set(json.load(f).get("mcpServers", {}))
            except (OSError, ValueError):
                continue
            if tem != produzidos:
                deriva.append((os.path.relpath(caminho, os.path.expanduser("~/AI")),
                               sorted(produzidos - tem), sorted(tem - produzidos)))

    # 1b. ENDPOINT de verdade — so pra superficie que declara `verificacao.modo:
    # endpoint` (hoje so `agy`, #165). As outras seguem so com a checagem
    # estrutural do produtor: e um CLI nosso lendo arquivo nosso, e ai a checagem
    # estrutural ja bastava antes do #165 e continua bastando.
    endpoints_falhos = []
    for nome, sup in reg.get("superficies", {}).items():
        verif = sup.get("verificacao")
        if not verif or verif.get("modo") != "endpoint":
            continue
        container = verif.get("via")
        for cnome in sup.get("conectores", []):
            url = conectores.get(cnome, {}).get("url")
            if not url:
                endpoints_falhos.append((nome, cnome, "sem url declarada em `conectores`"))
                continue
            codigo, erro = _verifica_endpoint_mcp(container, url)
            if erro:
                endpoints_falhos.append((nome, cnome, f"nao respondeu: {erro}"))
            elif codigo != "200":
                endpoints_falhos.append((nome, cnome, f"initialize devolveu {codigo}"))

    # 2. capacidade cujo meio cita tool que conector nenhum serve
    for cap, dado in reg.get("capacidades", {}).items():
        for m in re.finditer(r"\b(\w+)\b", dado.get("meio", "")):
            t = m.group(1)
            if t in servidas or t.islower() is False:
                continue
        alvo_tools = [t for t in re.findall(r"\b\w+\b", dado.get("meio", ""))
                      if t.endswith("_search") or t in servidas]
        if dado.get("nas_tres") and not alvo_tools and "verbo" not in dado.get("meio", ""):
            sem_meio.append(cap)

    # 3. texto da fita citando tool fora de todo conector
    if staged:
        quebradas = _quebradas_no_staged(padrao, servidas)
    else:
        for caminho in _texto_da_fita():
            try:
                with open(caminho, encoding="utf-8", errors="replace") as f:
                    linhas = f.read().split("\n")
            except OSError:
                continue
            for n, linha in enumerate(linhas, 1):
                for t in _tools_citadas(linha, padrao):
                    if t not in servidas:
                        quebradas.append((os.path.relpath(caminho, HARNESS), n, t))

    # Superficie que o host nao ve sai NOMEADA, do registro — nao hardcoded. Foi
    # registro com tres de quatro que deixou `code-seco` fora da conta enquanto o
    # veredito dizia "em dia": nao medido nao e em dia, e o que nao consta some.
    nao_medido = [f"{n} — {d.get('porque', 'sem motivo declarado')}"
                  for n, d in sorted(reg.get("superficies", {}).items())
                  if not d.get("verificavel_do_host")]

    # GATE DE COMMIT vs SAUDE DE HOST (card #2823). So `quebradas` e incremental:
    # linhas ADICIONADAS pelo commit em curso. `nao_servidos/sem_meio/sem_produtor/
    # endpoints_falhos` sao sempre recalculados sobre o host vivo — passivo herdado,
    # alheio ao commit. Sob --staged o gate julga SO o que o commit acrescenta; a
    # saude de host segue computada e exibida, como OBSERVACAO, mas nao trava. Sem
    # --staged (rodado avulso), tudo trava como antes. Cumpre a promessa do hook
    # ("passivo herdado nao trava a casa") sem cegar `conferir superficie` avulso.
    saude_host = bool(nao_servidos or sem_meio or sem_produtor or endpoints_falhos)
    if staged:
        ok = not quebradas
    else:
        ok = not (quebradas or saude_host)
    if como_json:
        print(json.dumps({
            "veredito": "em dia" if ok else "divergente",
            "modo_gate": "incremental (--staged): saude de host nao trava" if staged
                         else "completo: saude de host trava",
            "saude_host_ok": not saude_host,
            "conector_prometido_nao_servido": [
                {"superficie": s_, "conector": c} for s_, c in nao_servidos],
            "endpoint_nao_conectou": [
                {"superficie": s_, "conector": c, "motivo": m} for s_, c, m in endpoints_falhos],
            "capacidade_sem_meio": sem_meio,
            "superficie_sem_produtor_declarado": sem_produtor,
            "deriva_em_instancia_viva": [
                {"arquivo": a, "falta": f, "sobra": so} for a, f, so in deriva],
            "tool_fora_de_todo_conector": [
                {"arquivo": a, "linha": n, "tool": t} for a, n, t in quebradas],
            "nao_medido": nao_medido,
        }, ensure_ascii=False, indent=2))
        return 0 if ok else 1

    sups = " . ".join(sorted(reg.get("superficies", {})))
    obs = " (obs.)" if staged else ""
    print(f"superficies: {sups}")
    if staged:
        print("  modo: --staged — gate julga so o commit; saude de host nao trava")
    print(f"  conector prometido e nao servido{obs}: {len(nao_servidos)}")
    for s_, c in nao_servidos:
        print(f"      {s_} — falta {c}")
    print(f"  endpoint declarado e nao conectou{obs}: {len(endpoints_falhos)}")
    for s_, c, m in endpoints_falhos:
        print(f"      {s_}.{c} — {m}")
    print(f"  superficie sem produtor declarado{obs}: {len(sem_produtor)}")
    for n_ in sem_produtor:
        print(f"      {n_} — verificavel e ninguem declara quem escreve o .mcp.json")
    print(f"  capacidade sem meio{obs}              : {len(sem_meio)}")
    for c in sem_meio:
        print(f"      {c}")
    print(f"  tool fora de todo conector       : {len(quebradas)}")
    porarq = {}
    for a, n, t in quebradas:
        porarq.setdefault(a, []).append(t)
    for a in sorted(porarq):
        print(f"      {a}: {', '.join(sorted(set(porarq[a])))}")
    print(f"  deriva em instancia viva (obs.)  : {len(deriva)}")
    for a, f_, so in deriva:
        print(f"      {a} — falta {f_ or '-'} . sobra {so or '-'}")
    print(f"  NAO MEDIDO do host               : {len(nao_medido)}")
    for x in nao_medido:
        print(f"      {x.split(' — ')[0]} — {x.split(' — ', 1)[1][:96]}")
    print(f"  veredito                         : {'em dia' if ok else 'divergente'}")
    return 0 if ok else 1


def _mcp_jsons_da_superficie(nome):
    """Onde cada superficie declara os conectores. Fita: o cwd de cada cadeira.
    Fabrica: as worktrees wt-*. Ausencia de arquivo e ausencia de conector."""
    raiz = os.path.expanduser("~/AI")
    if nome == "fita":
        base = os.path.join(raiz, "fitas")
        if not os.path.isdir(base):
            return []
        return [os.path.join(base, c, ".mcp.json") for c in sorted(os.listdir(base))
                if os.path.isfile(os.path.join(base, c, ".mcp.json"))]
    if nome == "fabrica":
        return [os.path.join(raiz, d, ".mcp.json") for d in sorted(os.listdir(raiz))
                if d.startswith("wt-")
                and os.path.isfile(os.path.join(raiz, d, ".mcp.json"))]
    return []


def _tools_citadas(linha, padrao):
    for m in padrao.finditer(linha):
        yield m.group(1) or m.group(2)



def _obtem_descricao_servida_mcp(url=None, token=None):
    """(descricao_ou_none, erro_ou_none). Consulta o servidor MCP em runtime."""
    url = url or os.environ.get("OPS_MCP_URL", "http://127.0.0.1:8010/mcp")
    if not token:
        token = os.environ.get("PF_OPS_TOKEN") or os.environ.get("OPS_AUTH_TOKEN")
    if not token:
        dir_conf = os.path.join(os.path.expanduser("~/.config"), "ops")
        arq_conf = os.path.join(dir_conf, "env")
        if os.path.isfile(arq_conf):
            try:
                with open(arq_conf, encoding="utf-8") as f:
                    for linha in f:
                        if linha.startswith("OPS_AUTH_TOKEN="):
                            token = linha.split("=", 1)[1].strip().strip("'\"")
                            break
            except OSError:
                pass

    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    init_payload = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
            "protocolVersion": "2024-11-05",
            "capabilities": {},
            "clientInfo": {"name": "conferir", "version": "0"},
        },
    }
    req = urllib.request.Request(url, data=json.dumps(init_payload).encode("utf-8"), headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            sess_id = r.headers.get("mcp-session-id")
    except urllib.error.HTTPError as e:
        return None, f"MCP initialize devolveu HTTP {e.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return None, f"servidor MCP em {url} não respondeu ({e})"

    if sess_id:
        headers["mcp-session-id"] = sess_id

    init_notif = {"jsonrpc": "2.0", "method": "notifications/initialized"}
    try:
        req_notif = urllib.request.Request(url, data=json.dumps(init_notif).encode("utf-8"), headers=headers)
        with urllib.request.urlopen(req_notif, timeout=3):
            pass
    except Exception:
        pass

    list_payload = {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}
    req_list = urllib.request.Request(url, data=json.dumps(list_payload).encode("utf-8"), headers=headers)
    try:
        with urllib.request.urlopen(req_list, timeout=5) as r:
            corpo = r.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        return None, f"tools/list devolveu HTTP {e.code}"
    except Exception as e:
        return None, f"falha ao listar tools no MCP: {e}"

    dados_json = None
    for linha in corpo.splitlines():
        if linha.startswith("data:"):
            try:
                dados_json = json.loads(linha[5:].strip())
                break
            except ValueError:
                pass
    if dados_json is None:
        try:
            dados_json = json.loads(corpo)
        except ValueError:
            return None, f"resposta de tools/list não é JSON válido: {corpo[:100]}"

    tools = dados_json.get("result", {}).get("tools", [])
    for t in tools:
        if t.get("name") == "recuperar":
            return t.get("description", ""), None

    return None, f"tool 'recuperar' não encontrada entre as tools servidas por {url}"


def _extrai_slugs_de_descricao(texto: str) -> set[str]:
    slugs = set()
    for linha in texto.splitlines():
        m = re.match(r"^\s*-\s*([a-z0-9_-]+)\s*(?:\((?:exata|semantica)\))?:", linha)
        if m:
            slugs.add(m.group(1).lower())
    return slugs


def _fontes_da_tabela_catalogo(caminho_catalogo=None):
    if caminho_catalogo is None:
        cand1 = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "docs", "catalogo-de-fontes.md")
        cand2 = os.path.join(HARNESS, "docs", "catalogo-de-fontes.md")
        caminho = cand1 if os.path.isfile(cand1) else cand2
    else:
        caminho = caminho_catalogo

    if not os.path.isfile(caminho):
        return set(), f"arquivo {caminho} não existe"
    try:
        texto = open(caminho, encoding="utf-8").read()
    except OSError as e:
        return set(), f"não consegui ler {caminho}: {e}"

    linhas = texto.splitlines()
    inicio = -1
    for idx, l in enumerate(linhas):
        if re.match(r"^##\s+Fontes da plataforma", l.strip()):
            inicio = idx
            break
    if inicio == -1:
        return set(), "seção '## Fontes da plataforma' não encontrada no catálogo"

    tabela = []
    for idx in range(inicio + 1, len(linhas)):
        l = linhas[idx]
        if l.startswith("## ") and not l.strip().startswith("## Fontes da plataforma"):
            break
        if l.strip().startswith("|"):
            tabela.append(l.strip())

    if not tabela or len(tabela) < 2:
        return set(), "tabela de fontes no catálogo está vazia"

    dados = []
    for l in tabela[1:]:
        celulas = [c.strip() for c in l.strip("|").split("|")]
        if all(re.match(r"^:?-+:?$", c) for c in celulas if c):
            continue
        dados.append(celulas)

    if not dados:
        return set(), "tabela de fontes no catálogo está vazia"

    slugs = set()
    for celulas in dados:
        if not celulas or not celulas[0]:
            continue
        raw = celulas[0]
        slug = raw.split("·")[0].split("(")[0].split()[0].strip().lower().replace("`", "")
        if slug:
            slugs.add(slug)

    if not slugs:
        return set(), "tabela de fontes no catálogo está vazia"

    return slugs, None


def conferir_superficie_descricao(alvo=None, como_json=False, caminho_catalogo=None, mcp_url=None, descricao_fornecida=None):
    """Caso 1 de conferir superficie: descrição de roteamento servida em runtime × tabela de fontes do índice."""
    slugs_indice, motivo_tabela = _fontes_da_tabela_catalogo(caminho_catalogo)
    if motivo_tabela:
        if como_json:
            print(json.dumps({
                "caso": "descricao",
                "veredito": "nao-medido",
                "motivo": motivo_tabela,
                "slugs_indice": [],
                "slugs_servidos": [],
                "so_no_indice": [],
                "so_no_servido": [],
            }, ensure_ascii=False, indent=2))
        else:
            print("superficie (caso descricao):")
            print(f"  NAO MEDIDO: {motivo_tabela}")
            print("  veredito  : nao-medido")
        return 0

    if descricao_fornecida is not None:
        desc_servida, err_servido = descricao_fornecida, None
    else:
        desc_servida, err_servido = _obtem_descricao_servida_mcp(url=mcp_url)

    if err_servido:
        if como_json:
            print(json.dumps({
                "caso": "descricao",
                "veredito": "nao-medido",
                "motivo": err_servido,
                "slugs_indice": sorted(slugs_indice),
                "slugs_servidos": [],
                "so_no_indice": [],
                "so_no_servido": [],
            }, ensure_ascii=False, indent=2))
        else:
            print("superficie (caso descricao):")
            print(f"  NAO MEDIDO: {err_servido}")
            print("  veredito  : nao-medido")
        return 0

    slugs_servidos = _extrai_slugs_de_descricao(desc_servida)
    so_no_indice = sorted(slugs_indice - slugs_servidos)
    so_no_servido = sorted(slugs_servidos - slugs_indice)
    ok = (slugs_indice == slugs_servidos) and bool(slugs_indice)

    if como_json:
        print(json.dumps({
            "caso": "descricao",
            "veredito": "em dia" if ok else "divergente",
            "slugs_indice": sorted(slugs_indice),
            "slugs_servidos": sorted(slugs_servidos),
            "so_no_indice": so_no_indice,
            "so_no_servido": so_no_servido,
        }, ensure_ascii=False, indent=2))
        return 0 if ok else 1

    print("superficie (caso descricao):")
    print(f"  fontes no índice : {len(slugs_indice)} ({', '.join(sorted(slugs_indice))})")
    print(f"  fontes no servido: {len(slugs_servidos)} ({', '.join(sorted(slugs_servidos))})")
    if so_no_indice:
        print(f"  SÓ NO ÍNDICE     : {len(so_no_indice)} ({', '.join(so_no_indice)})")
    else:
        print("  só no índice     : 0")
    if so_no_servido:
        print(f"  SÓ NO SERVIDO    : {len(so_no_servido)} ({', '.join(so_no_servido)})")
    else:
        print("  só no servido    : 0")
    print(f"  veredito         : {'em dia' if ok else 'divergente'}")
    return 0 if ok else 1


def conferir_skill(nome, servido=None, como_json=False):
    """Compara o blob carimbado no arquivo servido com o blob da fonte.

    A travessia ate o claude.ai e manual e nao deixa registro do lado do host: o
    carimbo prova de onde a copia veio, nao que ela subiu. Sem --servido, imprime
    o blob da fonte e onde ler o carimbo — ausencia de dado, nao conformidade.
    """
    if not nome:
        if como_json:
            print(json.dumps({"erro": "uso: conferir skill <nome> [--servido <blob>]"}))
        else:
            rc, out, _ = sh(["ls", os.path.join(HARNESS, "skills")])
            print("skills na fonte:", " ".join(out.split()) if rc == 0 else "(nenhuma)")
            print("uso: conferir skill <nome> [--servido <blob>]")
        return 2

    caminho = f"skills/{nome}/SKILL.md"
    rc, fonte, err = sh(["git", "-C", HARNESS, "rev-parse", f"HEAD:{caminho}"])
    if rc != 0:
        msg = f"skill {nome!r} nao existe na fonte ({caminho}): {err}"
        if como_json:
            print(json.dumps({"erro": msg}))
        else:
            print(msg)
        return 1

    if not como_json:
        print(f"skill: {nome}")
        print(f"  fonte   : {fonte}  ({caminho} em HEAD do harness)")
    if not servido:
        if como_json:
            print(json.dumps({
                "skill": nome, "fonte_blob": fonte, "servido_blob": None,
                "veredito": "indeterminado",
                "detalhe": ("servido nao informado — ler o campo `origem:` do front-matter em "
                            "/mnt/skills/user/<nome>/SKILL.md e repassar em --servido"),
            }))
        else:
            print("  servido : NAO INFORMADO — ler o campo `origem:` do front-matter em")
            print("            /mnt/skills/user/<nome>/SKILL.md e repassar em --servido.")
            print("  veredito: indeterminado (nao confundir com em dia)")
        return 2

    servido = servido.strip()
    curto = servido[:12]
    if fonte.startswith(servido) or servido.startswith(fonte[:12]):
        if como_json:
            print(json.dumps({
                "skill": nome, "fonte_blob": fonte, "servido_blob": curto,
                "veredito": "em_dia", "detalhe": None,
            }))
        else:
            print(f"  servido : {curto}")
            print("  veredito: em dia")
        return 0

    if not como_json:
        print(f"  servido : {curto}")
    # O carimbo grava o hash do BLOB, nao o do commit: `git log a..b` nao se aplica.
    # O atraso se mede achando o commit mais recente em que o blob ainda era o servido.
    rc, hist, _ = sh(["git", "-C", HARNESS, "log", "--format=%H %h %ci %s", "--", caminho])
    desde = None
    depois = []
    for linha in hist.splitlines():
        sha, curto_c, resto = linha.split(" ", 2)
        rc2, blob, _ = sh(["git", "-C", HARNESS, "rev-parse", f"{sha}:{caminho}"])
        if rc2 == 0 and blob.startswith(servido[:12]):
            desde = f"{curto_c} {resto}"
            break
        depois.append(f"{curto_c} {resto}")
    if desde:
        detalhe = f"{len(depois)} commit(s) desde que o servido subiu; servido corresponde a: {desde}"
        if not como_json:
            print(f"  veredito: DIVERGENTE — {len(depois)} commit(s) desde que o servido subiu")
            print(f"            servido corresponde a: {desde}")
            for linha in depois[:6]:
                print(f"            + {linha}")
    else:
        detalhe = "o blob servido nao existe na historia da fonte (copia editada a mao, ou historia reescrita)"
        if not como_json:
            print("  veredito: DIVERGENTE — o blob servido nao existe na historia da fonte")
            print("            (copia editada a mao, ou historia reescrita)")
    if como_json:
        print(json.dumps({
            "skill": nome, "fonte_blob": fonte, "servido_blob": curto,
            "veredito": "divergente", "detalhe": detalhe,
        }))
    return 1


# --- classe: front ----------------------------------------------------------
# arq:0057, secao "Conformidade": o instrumento reprova, ALEM do que arq:0056 ja mede,
# duas coisas — e sao as duas que esta classe mede, nenhuma a mais:
#
#   (1) tela de aplicacao FORA de `platafirma-ui`;
#   (2) artefato de front que MONTE SEGREDO de outra camada OU SIRVA ROTA DE API.
#
# NAO e a classe `superficie`: aquela mede o PRODUTOR do `.mcp.json` de cada superficie
# de conector (dominio MCP). Esta mede o LAYOUT do deploy de front — onde a tela mora e o
# que o artefato de front monta. Homonimos, dominios distintos; juntar os dois num verbo
# so era colidir dois sentidos de "superficie".
#
# O QUE E "TELA DE APLICACAO", medido pela arvore viva (arq:0057, "Aplicacao ao front"):
# `platafirma-ui/app/<superficie>/` sai como SERVICO por superficie. Uma tela e um
# diretorio com `index.html` E um `Dockerfile` que serve estatico (nginx) — nao a
# biblioteca (`src/`+`dist/`, que e a imagem versionada, nao uma superficie de aplicacao).
# A regra (1) reprova esse par onde ele more FORA de `platafirma-ui` — que e o caso que a
# migracao #187/#194/#196 desfez ao tirar `tela/` de `platafirma-rastreador` e faria
# reaparecer se alguem recriasse tela dentro de um repo de back.
#
# A regra (2) le, por tela em `platafirma-ui/app/<superficie>/`, o docker-compose e o
# nginx.conf da superficie:
#   - SEGREDO DE OUTRA CAMADA: `env_file`, `environment`, ou volume que monte `.env`/segredo
#     no compose da tela. O aceite do #195 e explicito: a stack de front "sem env_file, sem
#     .env, sem volume de segredo". O worktree de deploy do back copia o `.env` inteiro; a
#     tela nao tem `.env` para copiar, e e por construcao.
#   - ROTA DE API: `proxy_pass` no nginx da tela (encaminhar para um upstream de API). Quem
#     separa `/` de `/api` e o gate, no core — a casca da tela nao roteia dado. `try_files`
#     servindo `index.html` numa rota de VISAO (`/itens/{id}/ver`) NAO e servir API: e a
#     mesma casca noutro endereco. `proxy_pass` e o que reprova.
#
# So olha: le arvore e arquivo, nao sobe nada. Sai 0 sem divergencia, 1 com, 2 na chamada
# errada — como toda classe deste verbo.

UI_REPO = "platafirma-ui"
# `deploy/` sao WORKTREES de deploy (clones detached de outro repo, git worktree). Uma
# tela ali e a MESMA tela do repo de origem, servida para promover — nao uma segunda
# morada. Le-la como layout de origem e ler o clone de deploy como se fosse o repo, e
# foi o falso positivo medido ao instrumentar (deploy/rastreador-tela). Fora da varredura.
FRONT_FORA_DA_VARREDURA = ("deploy",)
# arq:0057, secao "Aberto", NOMINALMENTE: "Morada de `platafirma-core-landing` e de
# `harness-controle-tela`: superficies de front FORA do rastreador, NAO INVENTARIADAS
# contra este criterio." O #197, item 3, remata: vira card proprio, inventariar antes
# de ter o mecanismo e garimpo. Logo estas telas saem do VEREDITO deste card e entram
# como OBSERVACAO — reprova-las aqui seria julgar o que a decisao deixou aberto.
FRONT_ABERTAS = ("platafirma-core",)

# Sinais de "monta segredo de outra camada" num docker-compose de tela. `environment` e
# `env_file` sao as duas portas declaradas do compose; volume de `.env`/segredo e a terceira,
# por bind. A regra e por construcao (arq:0057, "a regua e por construcao, nao por frequencia").
_RE_ENV_FILE = re.compile(r"^[^#\n]*\benv_file\s*:", re.M)
_RE_ENVIRON = re.compile(r"^[^#\n]*\benvironment\s*:", re.M)
_RE_VOL_SEGREDO = re.compile(r"^[^#\n]*-\s*[^#\n]*(?:\.env|/run/secrets|secrets?/)", re.M | re.I)
# `proxy_pass` no nginx: encaminhar para upstream e servir rota de outra camada. E o unico
# sinal de "serve rota de API" — a casca por `try_files` nao encaminha nada.
_RE_PROXY_PASS = re.compile(r"^[^#\n]*\bproxy_pass\b\s+\S", re.M)


def _telas_de_front(raiz=None):
    """Diretorios de tela de aplicacao sob ~/AI: (dir_rel, repo, tem_index, tem_dockerfile).

    Uma tela e um diretorio que tem `index.html` E um `Dockerfile` que serve estatico. Varre
    os repos de topo ate 3 niveis (repo/app/<superficie>), sem seguir link nem entrar em
    .git/node_modules. A biblioteca (`dist/` da raiz do UI) tem index.html mas nao Dockerfile
    proprio de superficie no mesmo diretorio — nao casa, e e o certo: nao e tela de aplicacao.
    """
    raiz = raiz or os.path.expanduser("~/AI")
    achados = []
    for topo in sorted(os.listdir(raiz)):
        if topo.startswith(".") or topo in FORA_DA_REGUA:
            continue
        if topo in FRONT_FORA_DA_VARREDURA:  # worktrees de deploy: mesma tela do repo de origem
            continue
        base = os.path.join(raiz, topo)
        if not os.path.isdir(base) or os.path.islink(base):
            continue
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = [d for d in dirnames
                           if not d.startswith(".") and d not in ("node_modules", "provas")]
            if dirpath.replace(base, "").count(os.sep) > 3:
                dirnames[:] = []
                continue
            tem_index = "index.html" in filenames
            tem_docker = "Dockerfile" in filenames
            if tem_index and tem_docker:
                achados.append((
                    os.path.relpath(dirpath, raiz), topo, tem_index, tem_docker,
                ))
    return achados


def _le(caminho):
    try:
        with open(caminho, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def _viola_segredo_ou_api(dir_abs):
    """(monta_segredo, serve_api, detalhe) para uma tela em dir_abs.

    monta_segredo: compose da tela com env_file/environment/volume de segredo.
    serve_api    : nginx da tela com proxy_pass.
    """
    detalhe = []
    monta_segredo = False
    serve_api = False
    for nome in sorted(os.listdir(dir_abs)):
        p = os.path.join(dir_abs, nome)
        if not os.path.isfile(p):
            continue
        low = nome.lower()
        if low.endswith((".yml", ".yaml")) or low.startswith("docker-compose"):
            t = _le(p)
            if _RE_ENV_FILE.search(t):
                monta_segredo = True
                detalhe.append(f"{nome}: env_file")
            if _RE_ENVIRON.search(t):
                monta_segredo = True
                detalhe.append(f"{nome}: environment")
            if _RE_VOL_SEGREDO.search(t):
                monta_segredo = True
                detalhe.append(f"{nome}: volume de segredo (.env/secrets)")
        if low.endswith(".conf") or "nginx" in low:
            t = _le(p)
            if _RE_PROXY_PASS.search(t):
                serve_api = True
                detalhe.append(f"{nome}: proxy_pass")
    return monta_segredo, serve_api, detalhe


def conferir_front(alvo=None, como_json=False):
    """Conformidade de front do arq:0057, alem do que arq:0056 ja mede.

    (1) tela de aplicacao fora de `platafirma-ui`;
    (2) artefato de front que monte segredo de outra camada ou sirva rota de API.

    Nao julga o contrato de arq:0056 (custom element `pf-*`, token) — isso e de outra
    regua. Julga o LAYOUT do deploy de front, e so ele.
    """
    telas = _telas_de_front()
    if alvo:
        telas = [t for t in telas if alvo in t[0]]

    raiz = os.path.expanduser("~/AI")
    fora = []       # regra 1: tela fora de platafirma-ui (e NAO declarada aberta pela 0057)
    montam = []     # regra 2a: monta segredo de outra camada
    servem = []     # regra 2b: serve rota de API
    conformes = []
    abertas = []    # superficies que a 0057 declara ABERTAS: observacao, nao veredito
    for dir_rel, repo, _i, _d in telas:
        dir_abs = os.path.join(raiz, dir_rel)
        monta_segredo, serve_api, detalhe = _viola_segredo_ou_api(dir_abs)
        if repo in FRONT_ABERTAS:
            abertas.append({"tela": dir_rel, "repo": repo})
            continue  # arq:0057 "Aberto": nao inventariada contra este criterio
        if repo != UI_REPO:
            fora.append({"tela": dir_rel, "repo": repo})
            # tela fora do UI ja reprova por (1); ainda assim medimos (2) para o relato.
        if monta_segredo:
            montam.append({"tela": dir_rel, "repo": repo, "detalhe": detalhe})
        if serve_api:
            servem.append({"tela": dir_rel, "repo": repo, "detalhe": detalhe})
        if repo == UI_REPO and not monta_segredo and not serve_api:
            conformes.append(dir_rel)

    ok = not (fora or montam or servem)
    if como_json:
        print(json.dumps({
            "veredito": "em dia" if ok else "divergente",
            "regra_1_tela_fora_do_ui": fora,
            "regra_2_monta_segredo": montam,
            "regra_2_serve_rota_api": servem,
            "telas_conformes": conformes,
            "superficies_abertas_0057": abertas,
            "medidas": len(telas),
            "ui_repo": UI_REPO,
        }, ensure_ascii=False, indent=2))
        return 0 if ok else 1

    print(f"front — conformidade de deploy (arq:0057), alem de arq:0056")
    print(f"  telas de aplicacao medidas       : {len(telas)}")
    print(f"  (1) TELA FORA de {UI_REPO:<16}: {len(fora)}")
    for x in fora:
        print(f"      {x['tela']} — mora em {x['repo']}, nao em {UI_REPO}")
    print(f"  (2) MONTA SEGREDO de outra camada: {len(montam)}")
    for x in montam:
        print(f"      {x['tela']} — {', '.join(x['detalhe'])}")
    print(f"  (2) SERVE ROTA DE API            : {len(servem)}")
    for x in servem:
        print(f"      {x['tela']} — {', '.join(x['detalhe'])}")
    print(f"  conformes (em {UI_REPO}, sem segredo, sem proxy): {len(conformes)}")
    print(f"  veredito                         : {'em dia' if ok else 'divergente'}")
    if abertas:
        print("  --- observacao (nao entra no veredito; arq:0057 secao Aberto) ---")
        print(f"  superficies declaradas ABERTAS   : {len(abertas)} (vira card proprio, #197 item 3)")
        for x in abertas:
            print(f"      {x['tela']} — {x['repo']}")
    return 0 if ok else 1


# --- classe: procedencia ----------------------------------------------------
# Mede uma coisa so: onde para cada caminho de execucao de ~/AI/bin. Nao e arq:0037
# (cabecalho e conta de capacidade sao de `conferir verbo`) e nao e arq:0042.
#
# A lista de excecoes NAO mora aqui: mora em docs/procedencia-do-harness.md. Excecao
# no codigo vira detalhe de implementacao, e o que ela cala e decisao de dono —
# tem que estar escrita onde alguem revise, com nome ao lado.

DOC_PROCEDENCIA = os.path.join(HARNESS, "docs", "procedencia-do-harness.md")
CLASSES_DE_EXCECAO = {"binario-de-terceiro"}


def _dono_e_motivo(comentario):
    """Extrai `dono:` e `motivo:` do comentario da linha. Falta de um dos dois
    invalida a excecao — meia excecao cala o alarme sem dizer de quem e a decisao."""
    baixo = comentario.lower()
    i, j = baixo.find("dono:"), baixo.find("motivo:")
    if i < 0 or j < 0 or j < i:
        return None, None
    dono = comentario[i + len("dono:"):j].strip().strip("·-—|,;").strip()
    motivo = comentario[j + len("motivo:"):].strip()
    return (dono or None), (motivo or None)


def excecoes_de_procedencia(caminho=DOC_PROCEDENCIA):
    """Le o documento de excecoes: (por_nome, por_classe, erros).

    Ausencia do arquivo nao e ausencia de excecao — e ausencia de lista, e reprova.
    """
    por_nome, por_classe, erros = {}, {}, []
    try:
        texto = open(caminho, errors="replace").read()
    except OSError:
        return por_nome, por_classe, [
            f"lista de excecoes ausente em {caminho} — ela e parte do predicado, nao anexo dele"]
    for n, linha in enumerate(texto.splitlines(), 1):
        s = linha.strip()
        for marca, destino in (("permite-classe:", por_classe), ("permite:", por_nome)):
            if not s.startswith(marca):
                continue
            corpo = s[len(marca):]
            nome, _, comentario = corpo.partition("#")
            nome = nome.strip()
            dono, motivo = _dono_e_motivo(comentario)
            if nome.startswith("<") or nome.endswith(">"):
                break            # ilustracao de forma no proprio documento, nao excecao
            if not nome:
                erros.append(f"linha {n}: `{marca}` sem nome")
            elif not dono or not motivo:
                erros.append(f"linha {n}: excecao {nome!r} sem dono e/ou motivo declarados")
            elif destino is por_classe and nome not in CLASSES_DE_EXCECAO:
                erros.append(f"linha {n}: classe {nome!r} nao existe — conhecidas: "
                             + ", ".join(sorted(CLASSES_DE_EXCECAO)))
            else:
                destino[nome] = (dono, motivo)
            break
    return por_nome, por_classe, erros


def conferir_procedencia(alvo, como_json=False):
    por_nome, por_classe, erros = excecoes_de_procedencia()
    houve = bool(erros)
    raiz = os.path.realpath(HARNESS)
    dentro = fora = coberto = 0
    entradas = []
    vistos = 0

    for nome in sorted(os.listdir(BIN)):
        if alvo and alvo != nome:
            continue
        vistos += 1
        caminho = os.path.join(BIN, nome)
        destino = os.path.realpath(caminho)
        e_link = os.path.islink(caminho)
        if not os.path.exists(caminho):
            veredito, detalhe = "quebrado", f"symlink sem destino: {destino}"
        elif destino == raiz or destino.startswith(raiz + os.sep):
            veredito, detalhe = "harness", destino
        elif nome in por_nome:
            veredito, detalhe = "excecao", "%s — %s (dono: %s)" % (destino, por_nome[nome][1], por_nome[nome][0])
        elif not e_link and not e_script(caminho) and "binario-de-terceiro" in por_classe:
            veredito, detalhe = "excecao-classe", "binario-de-terceiro (dono: %s)" % por_classe["binario-de-terceiro"][0]
        elif not e_link:
            veredito, detalhe = "fora", "arquivo comum em ~/AI/bin — copia nao e forma valida de instalacao"
        else:
            veredito, detalhe = "fora", destino

        if veredito == "harness":
            dentro += 1
        elif veredito in ("excecao", "excecao-classe"):
            coberto += 1
        else:
            fora += 1
            houve = True
        entradas.append({"nome": nome, "veredito": veredito, "destino": destino, "detalhe": detalhe})

    if alvo and vistos == 0:
        msg = f"{alvo!r} nao e entrada de {BIN}"
        print(json.dumps({"erro": msg}) if como_json else f"\n{msg}")
        return 1

    if como_json:
        print(json.dumps({
            "resultado": "divergente" if houve else "ok",
            "lista_de_excecoes": DOC_PROCEDENCIA,
            "erros_da_lista": erros,
            "entradas": entradas,
            "conta": {"harness": dentro, "excecao": coberto, "fora": fora},
        }))
        return 1 if houve else 0

    print(f"\n## procedencia dos caminhos de execucao em {BIN}")
    print(f"    lista de excecoes: {DOC_PROCEDENCIA}")
    for e in erros:
        print(f"    LISTA   : {e}")
    for e in entradas:
        if e["veredito"] == "harness" and not alvo:
            continue
        marca = {"harness": "ok      ", "excecao": "excecao ", "excecao-classe": "excecao ",
                 "quebrado": "QUEBRADO", "fora": "FORA    "}[e["veredito"]]
        print(f"    {marca}: {e['nome']:<16} {e['detalhe']}")
    print(f"\n    {dentro} dentro do harness . {coberto} excecao declarada . {fora} fora")
    if fora:
        print("    Caminho de execucao fora do harness sem linha em docs/procedencia-do-harness.md.")
        print("    Ou o arquivo se muda para o harness, ou a excecao se declara la — com dono e motivo.")
    print()
    return 1 if houve else 0


def _norm(texto):
    return " ".join(texto.split())


def _chapeus_do_disco(alvo=None):
    """[(cadeira, slug, caminho)]. Descoberta, nunca lista fixa: chapeu escrito por
    outra cadeira entra na conferencia sem ninguem emendar codigo."""
    if not os.path.isdir(CHAPEUS):
        return []
    cadeira_alvo = slug_alvo = None
    if alvo:
        cadeira_alvo, _, slug_alvo = alvo.partition("/")
        slug_alvo = slug_alvo or None
    achados = []
    for cadeira in sorted(os.listdir(CHAPEUS)):
        d = os.path.join(CHAPEUS, cadeira)
        if not os.path.isdir(d) or (cadeira_alvo and cadeira != cadeira_alvo):
            continue
        for nome in sorted(os.listdir(d)):
            if not nome.endswith(".md") or nome.startswith("."):
                continue
            slug = nome[:-3]
            if slug_alvo and slug != slug_alvo:
                continue
            achados.append((cadeira, slug, os.path.join(d, nome)))
    return achados


def _eco_da_base(texto, cadeira):
    """Predicado 1: nenhuma frase da base reaparece. Mede n-grama de 10 palavras —
    abaixo disso, frase de servico casa por acaso e o predicado vira ruido."""
    base = os.path.join(PERSONAS_DIR, f"persona-{cadeira}.md")
    if not os.path.isfile(base):
        return None, f"base ausente: {base}"
    pal_base = _norm(open(base, encoding="utf-8").read()).lower().split()
    grams = {" ".join(pal_base[i:i + 10]) for i in range(len(pal_base) - 9)}
    pal = _norm(texto).lower().split()
    ecos = [" ".join(pal[i:i + 10]) for i in range(len(pal) - 9)
            if " ".join(pal[i:i + 10]) in grams]
    return ecos, None


def _terceira_coluna(texto):
    """(b) so paga a carga quando o rotulo tem decisao associada. Linha de tabela com
    a terceira celula vazia e glossario, e glossario nao muda resposta nenhuma."""
    dentro, vazias = False, []
    for linha in texto.splitlines():
        if linha.startswith("## "):
            dentro = linha.startswith("## b)")
            continue
        if not dentro or not linha.strip().startswith("|"):
            continue
        celulas = [c.strip() for c in linha.strip().strip("|").split("|")]
        if len(celulas) < 3 or set("".join(celulas)) <= set("-: "):
            continue
        if celulas[0].lower().startswith("rótulo"):
            continue
        if not celulas[2]:
            vazias.append(celulas[0][:40])
    return vazias


def conferir_chapeu(alvo=None, como_json=False):
    achados = _chapeus_do_disco(alvo)
    if not achados:
        msg = f"nenhum chapeu encontrado{' para ' + alvo if alvo else ''} em {CHAPEUS}"
        print(json.dumps({"erro": msg}) if como_json else msg)
        return 2
    medir, motivo = _tokenizador()
    if not medir:
        msg = f"sem tokenizador, nao ha medicao: {motivo}"
        print(json.dumps({"erro": msg}) if como_json else msg)
        return 2

    linhas, reprovados = [], 0
    for cadeira, slug, caminho in achados:
        texto = open(caminho, encoding="utf-8").read()
        faltas = []
        tokens = medir(texto)
        norm = _norm(texto)
        for nome, fixo in FIXOS_CHAPEU.items():
            if _norm(fixo) not in norm:
                # Distingue ausencia de divergencia: "nao escreveu" e "escreveu
                # diferente" pedem correcao de dono diferente, e a mensagem que
                # confunde as duas manda o leitor procurar no lugar errado.
                abertura = " ".join(_norm(fixo).split()[:12])
                como = "DIVERGE do canonico" if abertura in norm else "ausente"
                faltas.append(f"texto fixo {como}: {nome}")
        for nome, cabecalho in SECOES_CHAPEU:
            if cabecalho not in texto:
                faltas.append(f"secao ausente: {nome}")
        vazias = _terceira_coluna(texto)
        if vazias:
            faltas.append("(b) sem 'o que decide': " + ", ".join(vazias))
        if not texto.startswith("---\n"):
            faltas.append("sem front-matter")
        ecos, err = _eco_da_base(texto, cadeira)
        if err:
            faltas.append(err)
        elif ecos:
            faltas.append(f"eco da base ({len(ecos)}): «{ecos[0]}»")
        veredito = "em dia" if not faltas else "REPROVA"
        reprovados += bool(faltas)
        linhas.append({"cadeira": cadeira, "slug": slug, "caminho": caminho,
                       "tokens": tokens,
                       "veredito": veredito, "faltas": faltas})

    if como_json:
        print(json.dumps({"chapeus": linhas, "reprovados": reprovados,
                          "medicao": "tokenizador qwen2.5"}, ensure_ascii=False))
        return 1 if reprovados else 0
    for l in linhas:
        print(f"\n### {l['cadeira']}/{l['slug']}")
        print(f"    tokens : {l['tokens']}")
        for f in l["faltas"]:
            print(f"    FALTA  : {f}")
        print(f"    veredito: {l['veredito']}")
    print(f"\nchapeus julgados: {len(linhas)} · reprovados: {reprovados} "
          f"· medicao: tokenizador qwen2.5")
    return 1 if reprovados else 0


# --- classe: ferramental ----------------------------------------------------
# Reconcilia a ESPINHA (capacidade->verbo->instancia) do golden record
# acervo.ferramental contra o host. A tabela e a fonte; o host obedece. NAO julga
# stack-de-deploy: essa entidade esta no ok de claudinho-dados (schema dela).
# So olha. 0 sem divergencia, 1 com, 2 chamada errada.

FERRAMENTAL_PG = "rag-extractor-pg"
FERRAMENTAL_DB = "rag_extractor"
FERRAMENTAL_USR = "rag"
STACKS_JSON = os.path.join(RAIZ, "platafirma-harness", "registro", "stacks.json")


def _ferramental_psql(sql):
    """(linhas|None, erro|None). Le a tabela via docker exec, como o resto do verbo."""
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    p = subprocess.run(
        ["docker", "exec", "-i", FERRAMENTAL_PG, "psql", "-U", FERRAMENTAL_USR,
         "-d", FERRAMENTAL_DB, "-tAF|", "-c", sql],
        capture_output=True, text=True, env=env)
    if p.returncode != 0:
        return None, (p.stderr or p.stdout or f"psql saiu {p.returncode}").strip()[:200]
    return [l for l in p.stdout.splitlines() if l.strip()], None


def conferir_ferramental(alvo, como_json=False):
    achados = []  # (severidade, texto): 'FALHA' muda veredito; 'DERIVA' so observa.

    # (0) 1:1 capacidade<->verbo integro (invariante de schema, arq:0037).
    linhas, erro = _ferramental_psql(
        "select c.slug, v.slug from acervo.ferramental_capacidade c "
        "full outer join acervo.ferramental_verbo v on v.capacidade_id=c.id "
        "where c.id is null or v.id is null")
    if erro:
        msg = f"nao consegui ler acervo.ferramental: {erro}"
        if como_json:
            print(json.dumps({"classe": "ferramental", "erro": msg}, ensure_ascii=False))
        else:
            print(f"conferir ferramental: {msg}", file=sys.stderr)
        return 2
    for l in linhas:
        cap, vb = (l.split("|") + [""])[:2]
        if not vb:
            achados.append(("FALHA", f"capacidade {cap!r} sem verbo (quebra 1:1)"))
        elif not cap:
            achados.append(("FALHA", f"verbo {vb!r} sem capacidade (quebra 1:1)"))

    # (a) cada verbo declarado resolve em ~/AI/bin.
    verbos, erro = _ferramental_psql(
        "select slug, coalesce(sot,'') from acervo.ferramental_verbo order by slug")
    if erro:
        return 2
    for l in verbos:
        slug, sot = (l.split("|") + [""])[:2]
        # so cobra PATH de verbo cujo sot aponta bin/ (ollama/matrix tem sot em stacks.json).
        if not sot.startswith("bin/"):
            continue
        if not os.path.exists(os.path.join(BIN, slug)):
            achados.append(("FALHA", f"verbo {slug!r} declarado (sot={sot}) nao existe em ~/AI/bin"))

    # instancia -> stack NAO se confere aqui: stack e recorte de conveniencia de
    # deploy (o que sobe junto num compose), arbitrario. Nao existe regra
    # "capacidade X mora na stack Y"; instancia rodar avulsa (ollama no harness)
    # e estado normal, nao divergencia. O mapa instancia_roda_em_stack fica como
    # INFORMACAO consultavel (JOIN), nunca como invariante que reprova.
    # (c) Paridade de TRANSICAO: stack no stacks.json que a tabela acervo.stack ainda
    #     nao absorveu. E a pre-condicao de morte do arquivo — enquanto houver falta
    #     aqui, stacks.json NAO morre. Some quando o seed cobrir os 11.
    try:
        with open(STACKS_JSON) as f:
            no_arquivo = set(json.load(f).get("stacks", {}).keys())
    except (OSError, ValueError):
        no_arquivo = set()
        achados.append(("DERIVA", f"nao li {STACKS_JSON} para conferir paridade de transicao"))
    if no_arquivo:
        na_tabela, erro = _ferramental_psql("select slug from acervo.stack")
        se_tab = set(x.strip() for x in (na_tabela or []))
        faltam = sorted(no_arquivo - se_tab)
        if faltam:
            achados.append(("FALHA",
                f"{len(faltam)} stack(s) no stacks.json ausente(s) em acervo.stack: "
                f"{', '.join(faltam)} — stacks.json nao morre ate a tabela absorver todos"))

    falhas = [t for sev, t in achados if sev == "FALHA"]
    derivas = [t for sev, t in achados if sev == "DERIVA"]

    if como_json:
        print(json.dumps({
            "classe": "ferramental",
            "veredito": "em dia" if not falhas else "divergente",
            "falhas": falhas, "observacoes_deriva": derivas,
        }, ensure_ascii=False, indent=2))
    else:
        if falhas:
            print("conferir ferramental: DIVERGENTE")
            for t in falhas:
                print(f"  FALHA  {t}")
        else:
            print("conferir ferramental: em dia (espinha capacidade->verbo->instancia integra)")
        for t in derivas:
            print(f"  deriva {t}")
    return 1 if falhas else 0


EXISTE_TIPOS = ("cadeira", "verbo", "card", "arquivo", "mesa")


def conferir_existe(tipo, nome, como_json=False):
    """Fato de existencia com ancora colavel — produtor da linha `NEGATIVA:`
    (gate de abertura/dono.md; mesa ia #8, 26/08/2026).

    A primeira linha da saida e a ancora. Exit 0 existe, 1 nao existe, 2
    indeterminavel — fonte fora do ar NUNCA vira 1: ausencia de resposta nao e
    evidencia de ausencia, e `indeterminavel` nao ancora negativa.
    """
    raiz_bin = os.path.join(RAIZ, "bin")

    def sai(existe, evidencia, extra=None):
        marca = "existe" if existe else "nao-existe"
        linha = f"{marca}: {tipo} {nome} — {evidencia}"
        if como_json:
            print(json.dumps({"existe": existe, "tipo": tipo, "nome": nome,
                              "ancora": linha, "extra": extra}, ensure_ascii=False))
        else:
            print(linha)
            if extra:
                print(f"  {extra}")
        return 0 if existe else 1

    def indeterminavel(motivo):
        linha = f"indeterminavel: {tipo} {nome} — {motivo}"
        if como_json:
            print(json.dumps({"existe": None, "tipo": tipo, "nome": nome,
                              "ancora": linha}, ensure_ascii=False))
        else:
            print(linha)
            print("  nao saber e informacao — isto NAO ancora uma NEGATIVA.")
        return 2

    if tipo not in EXISTE_TIPOS or not nome:
        print(f"uso: conferir existe <{'|'.join(EXISTE_TIPOS)}> <nome> [--json]",
              file=sys.stderr)
        return 2

    if tipo == "cadeira":
        alvo = nome
        for pref in ("claudinho-", "claudinha-"):
            if alvo.lower().startswith(pref):
                alvo = alvo[len(pref):]
        aber = os.path.join(RAIZ, "platafirma-harness", "abertura")
        if not os.path.isdir(aber):
            return indeterminavel(f"{aber} inacessivel")
        cadeiras = sorted(p for p in os.listdir(aber)
                          if os.path.isdir(os.path.join(aber, p)))
        return sai(alvo in cadeiras,
                   f"abertura/ lista {len(cadeiras)}: {', '.join(cadeiras)}")

    if tipo == "verbo":
        caminho = os.path.join(raiz_bin, nome)
        if os.path.exists(caminho):
            return sai(True, f"~/AI/bin/{nome} -> {os.path.realpath(caminho)}")
        return sai(False, f"~/AI/bin nao resolve {nome!r}")

    if tipo == "card":
        ident = nome.lstrip("#")
        rc, out, err = sh([os.path.join(raiz_bin, "tarefas"), "ler", ident])
        # Existencia pelo CABECALHO no stdout, nunca pelo rc: `tarefas ler`
        # imprime o item e sai 1 (medido 26/08/2026, card 2789).
        linhas = [l.strip() for l in out.splitlines() if l.strip()]
        cab = next((l for l in linhas if l.startswith(f"#{ident} ")), None)
        if cab:
            return sai(True, f"tarefas ler {ident}: {cab[:120]}")
        msg = (((err or out).strip().splitlines()) or [f"exit {rc}"])[0]
        baixa = msg.lower()
        if any(t in baixa for t in ("nao encontrad", "não encontrad",
                                     "inexistente", "nao existe", "não existe")):
            return sai(False, f"tarefas ler {ident}: {msg[:120]}")
        return indeterminavel(f"tarefas ler saiu {rc} sem cabecalho #{ident}: {msg[:120]}")

    if tipo == "arquivo":
        p = nome if os.path.isabs(nome) else os.path.join(RAIZ, nome)
        p = os.path.normpath(p)
        if os.path.exists(p):
            st = os.stat(p)
            quando = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
            rc, out, _ = sh(["git", "-C", os.path.dirname(p) if os.path.isfile(p) else p,
                             "log", "-1", "--format=%h %cs", "--", p])
            extra = f"git log -1: {out}" if rc == 0 and out else None
            return sai(True, f"{st.st_size} B, mtime {quando}", extra)
        pai = os.path.dirname(p)
        while pai and pai != os.path.sep and not os.path.isdir(pai):
            pai = os.path.dirname(pai)
        return sai(False, f"nao ha {p}; ultimo diretorio existente: {pai or '/'}")

    if tipo == "mesa":
        rc, out, err = sh([os.path.join(raiz_bin, "mesa"), "ver"])
        if rc != 0:
            msg = ((err or out).strip().splitlines() or [""])[0]
            return indeterminavel(f"mesa ver saiu {rc}: {msg[:120]}")
        n = nome.lstrip("#")
        for linha in out.splitlines():
            if linha.strip().startswith(f"#{n} "):
                return sai(True, f"mesa ver: {linha.strip()[:120]}")
        return sai(False, "mesa ver nao lista #%s (cadeira %s)"
                   % (n, os.environ.get("PF_CADEIRA", "?")))

    return 2


def main(argv):
    # --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4): varre
    # todos os argumentos antes do despacho; nenhuma classe chega a rodar. uso() sai 2.
    if any(x in ("--ajuda", "--help", "-h") for x in argv[1:]):
        uso()
    como_json = "--json" in argv
    if como_json:
        argv = [a for a in argv if a != "--json"]
    if len(argv) < 2:
        if como_json:
            print(json.dumps({"erro": "uso: conferir <classe> [alvo] [--json]"}))
        uso()
    classe, alvo = argv[1], (argv[2] if len(argv) > 2 else None)
    if classe in CLASSES_ABERTAS:
        if como_json:
            print(json.dumps({
                "erro": f"classe {classe!r} e conhecida e ainda nao tem implementacao: {CLASSES_ABERTAS[classe]}",
            }))
        else:
            print(f"classe {classe!r} e conhecida e ainda nao tem implementacao: {CLASSES_ABERTAS[classe]}")
            print("nao confundir ausencia de implementacao com conformidade.")
        return 2
    if classe == "servico":
        return conferir_servico(alvo, como_json=como_json)
    if classe == "verbo":
        return conferir_verbo(alvo, como_json=como_json)
    if classe == "procedencia":
        return conferir_procedencia(alvo, como_json=como_json)
    if classe == "repo":
        if alvo == "--staged":
            return conferir_repo(None, staged=True, como_json=como_json)
        return conferir_repo(alvo, como_json=como_json)
    if classe == "sessao":
        registrar = None
        if "--registrar" in argv:
            i = argv.index("--registrar")
            registrar = argv[i + 1] if len(argv) > i + 1 else None
            if not registrar:
                print("uso: conferir sessao [<cadeira>] --registrar <id-da-fita>")
                return 2
            if alvo == "--registrar":
                alvo = None
        return conferir_sessao(alvo, como_json=como_json, registrar=registrar)
    if classe == "chapeu":
        return conferir_chapeu(alvo, como_json=como_json)
    if classe == "ferramental":
        return conferir_ferramental(alvo, como_json=como_json)
    if classe == "commit":
        return conferir_commit(alvo, como_json=como_json)
    if classe == "arranque":
        if alvo == "--staged":
            return conferir_arranque(None, staged=True, como_json=como_json)
        return conferir_arranque(alvo, como_json=como_json)
    if classe == "superficie":
        caso = "conectores"
        if "--caso" in argv:
            i = argv.index("--caso")
            if len(argv) > i + 1:
                caso = argv[i + 1]
                argv = [a for idx, a in enumerate(argv) if idx not in (i, i + 1)]
            else:
                if como_json:
                    print(json.dumps({"erro": "uso: conferir superficie [--caso <caso>]"}))
                else:
                    uso("uso: conferir superficie [--caso conectores|descricao]")
                return 2

        alvo_superficie = argv[2] if len(argv) > 2 else None
        if caso == "conectores":
            if alvo_superficie == "--staged" or "--staged" in argv:
                return conferir_superficie(None, staged=True, como_json=como_json)
            return conferir_superficie(alvo_superficie, como_json=como_json)
        elif caso == "descricao":
            return conferir_superficie_descricao(alvo_superficie, como_json=como_json)
        elif caso == "credencial":
            msg = "caso 'credencial' e conhecido e fica fora deste release (caso 2)"
            if como_json:
                print(json.dumps({"erro": msg}))
            else:
                print(msg, file=sys.stderr)
            return 2
        else:
            msg = f"caso desconhecido para superficie: {caso!r} (esperado: conectores ou descricao)"
            if como_json:
                print(json.dumps({"erro": msg}))
            else:
                uso(msg)
            return 2
    if classe == "front":
        return conferir_front(alvo, como_json=como_json)
    if classe == "existe":
        return conferir_existe(alvo, argv[3] if len(argv) > 3 else None,
                               como_json=como_json)
    if classe == "skill":
        servido = None
        if "--servido" in argv:
            i = argv.index("--servido")
            servido = argv[i + 1] if len(argv) > i + 1 else None
            if alvo == "--servido":
                alvo = None
        return conferir_skill(alvo, servido, como_json=como_json)
    if como_json:
        print(json.dumps({"erro": f"classe desconhecida: {classe}"}))
    uso(f"classe desconhecida: {classe}")


if __name__ == "__main__":
    if os.path.basename(sys.argv[0]) == "conferir-servido":
        print("aviso: `conferir-servido` foi absorvido por `conferir servico` e sai do PATH "
              "no proximo ciclo.\n", file=sys.stderr)
        sys.exit(conferir_servico(sys.argv[1] if len(sys.argv) > 1 else None))
    sys.exit(main(sys.argv))
