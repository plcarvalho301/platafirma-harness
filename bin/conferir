#!/usr/bin/env bash
# conferir — compara o que esta DECLARADO com o que esta SERVIDO, por classe de alvo
# capacidade: verificacao
# dono: ti
# classe: C
# use para: 'existe X?' (ancora de NEGATIVA); as classes de bancada estao deprecadas e apontam para `lint <classe>`
# atos: existe (leitura, operacao), repo (leitura, operacao), commit (leitura, operacao), arranque (leitura, operacao), verbo (leitura, operacao), servico (leitura, operacao), skill (leitura, operacao), procedencia (leitura, operacao), superficie (leitura, operacao), front (leitura, operacao), sessao (leitura, operacao), chapeu (leitura, operacao), ferramental (leitura, operacao), pdp (leitura, operacao), alcance (leitura, operacao), vocabulario (leitura, operacao)
# forma: predicado
# le: existe=repo,rastreador,arquivo-local
# le: repo=repo
# le: commit=rastreador,arquivo-local
# le: arranque=repo
# le: verbo=release
# le: servico=release
# le: skill=release
# le: procedencia=release
# le: superficie=release
# le: front=release
# le: sessao=release
# le: chapeu=release
# le: ferramental=release,acervo.casa
# le: pdp=release
# le: alcance=release
# le: vocabulario=repo,arquivo-local
# escreve: existe=nada
# escreve: repo=nada
# escreve: commit=nada
# escreve: arranque=nada
# escreve: verbo=nada
# escreve: servico=nada
# escreve: skill=nada
# escreve: procedencia=nada
# escreve: superficie=nada
# escreve: front=nada
# escreve: sessao=nada
# escreve: chapeu=nada
# escreve: ferramental=nada
# escreve: pdp=nada
# escreve: alcance=nada
# escreve: vocabulario=nada
# ambiente: PF_BIN_DIR[=$HOME/AI/bin] porta · PF_SESSAO porta (lida, chave do aviso de deprecado)
# depende: python3 · release (classes do servido) · a implementacao em bin/_release/conferir/conferir.py
# substitui: nada (despachante)
# conforme: parcial
#
# Despachante (arq:0110 §1): a implementacao e sub-ato e mora em bin/_release/conferir/conferir.py,
# fora do PATH. As classes do SERVIDO sao de `release conferir` (spec_release §4); aqui respondem
# com aviso de deprecado, uma vez por sessao (arq:0110 §11), e delegam. As classes de BANCADA
# respondem com aviso de deprecado apontando `lint <classe>` (spec_lint / arq:0110 §11).
set -euo pipefail

BIN_DIR="${PF_BIN_DIR:-$HOME/AI/bin}"
AQUI="$(dirname "$(readlink -f "$0")")"
IMPL="$AQUI/_release/conferir/conferir.py"

CLASSES_SERVIDO="verbo servico skill procedencia superficie ferramental front sessao chapeu pdp alcance card"
CLASSES_BANCADA="existe repo commit arranque vocabulario diagrama"

avisa_deprecado() {  # uma vez por sessao (arq:0110 §11)
  local classe="$1"
  local sess_dir="/tmp/platafirma-avisos-${PF_SESSAO:-${USER:-default}}"
  mkdir -p "$sess_dir" 2>/dev/null || true
  local trava="$sess_dir/conferir_$classe"
  if [ ! -f "$trava" ]; then
    touch "$trava" 2>/dev/null || true
    printf 'conferir: `conferir %s` esta deprecado; a forma conforme e `release conferir %s` (spec_release §8).\n' "$classe" "$classe" >&2
  fi
}

avisa_deprecado_bancada() {  # uma vez por sessao (arq:0110 §11)
  local classe="$1"
  local sess_dir="/tmp/platafirma-avisos-${PF_SESSAO:-${USER:-default}}"
  mkdir -p "$sess_dir" 2>/dev/null || true
  local trava="$sess_dir/conferir_bancada_$classe"
  if [ ! -f "$trava" ]; then
    touch "$trava" 2>/dev/null || true
    printf 'conferir: `conferir %s` esta deprecado; a forma conforme e `lint %s` (spec_lint / arq:0110 §11).\n' "$classe" "$classe" >&2
  fi
}

[ -x "$IMPL" ] || [ -f "$IMPL" ] || {
  printf 'conferir: dependencia ausente: implementacao %s nao encontrada\n' "$IMPL" >&2
  exit 3
}

if [ $# -eq 0 ]; then
  exec python3 "$IMPL"
fi

classe="$1"
case "$classe" in
  --ajuda|--help|-h) exec python3 "$IMPL" --ajuda ;;
esac

for c in $CLASSES_SERVIDO; do
  if [ "$classe" = "$c" ]; then
    avisa_deprecado "$classe"
    if command -v release >/dev/null 2>&1; then
      exec release conferir "$@"
    elif [ -x "$BIN_DIR/release" ]; then
      exec "$BIN_DIR/release" conferir "$@"
    fi
    exec python3 "$IMPL" "$@"
  fi
done

for c in $CLASSES_BANCADA; do
  if [ "$classe" = "$c" ]; then
    if [ "$classe" != "existe" ]; then
      avisa_deprecado_bancada "$classe"
    fi
    exec python3 "$IMPL" "$@"
  fi
done

exec python3 "$IMPL" "$@"
