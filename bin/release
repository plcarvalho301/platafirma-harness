#!/usr/bin/env bash
# release — o canônico produção: o que está no ar, desde quando, e como voltar
# capacidade: infra/promocao-de-mudanca
# dono: ti
# classe: B
# forma: predicado (estado, conferir) / lista (listar, procurar) / texto (ler) / fluxo (promover, reverter)
# atos: estado (leitura, operacao) · listar (leitura, operacao) · ler (leitura, operacao) ·
#       procurar (leitura, operacao) · conferir (leitura, operacao) · promover (escrita, operacao) ·
#       reverter (escrita, operacao)
# escreve: var/prod/<repo> (checkout, current) · ~/AI/bin (symlinks) · var/release/<repo> · stacks via deploy
# ambiente: PF_PROD_RAIZ[=$HOME/AI/var/prod] porta · PF_BIN_DIR[=$HOME/AI/bin] porta · PF_CADEIRA porta (lida) · HOME
# depende: git · gh (promover) · deploy · rede ao forge (promover) · porta (hora de arranque) · systemd de usuário
# substitui: readlink current · git -C var/prod/… describe|rev-parse|ls-files|show|grep · ln -sfn + mv -T · chmod -R a-w · conferir <classe> · deploy <stack> promover|reverter
# conforme: parcial
set -uo pipefail

PROD_RAIZ="${PF_PROD_RAIZ:-${PF_OPT_DIR:-$HOME/AI/var/prod}}"
ABERTURA_DIR="${PF_ABERTURA_DIR:-$HOME/AI/var/abertura-publicada}"
CURRENT_LINK="$PROD_RAIZ/current"
PONTOS="${RELEASE_PONTOS:-$HOME/AI/var/release}"
AI_DIR="${PF_AI_DIR:-$HOME/AI}"
BIN_DIR="${PF_BIN_DIR:-$HOME/AI/bin}"
CADEIRA="${PF_CADEIRA:-}"

HARNESS_REPO="${PF_HARNESS:-$AI_DIR/platafirma-harness}"
CORE_REPO="${PF_CORE:-$AI_DIR/platafirma-core}"
CONHECIMENTO_REPO="${PF_CONHECIMENTO:-$AI_DIR/platafirma-conhecimento}"

STACKS_DEFAULT=(
  "core"
  "motor"
  "rag"
  "acervo-api"
  "conhecimento"
  "harness-controle"
  "jaiminho"
  "chat"
  "rastreador"
  "rastreador-tela"
  "harness-sessao"
  "searxng"
)

# Resolução de binário real: evitar shims no PATH da porta
if [ -n "${PF_GIT_BIN:-}" ]; then
  GIT="$PF_GIT_BIN"
else
  GIT="$(command -v /usr/bin/git /bin/git 2>/dev/null | head -1)"
  [ -x "$GIT" ] || GIT=/usr/bin/git
fi

if [ ! -x "$GIT" ]; then
  printf 'release: dependência ausente: git não encontrado\n' >&2
  exit 3
fi

uso_texto() {
  cat >&2 <<'FIM'
uso:
  release estado     [<repo>] [--json]
  release listar     <repo> [<prefixo>] [--json]
  release ler        <repo> <caminho>
  release procurar   <repo> --termo <termo> [<prefixo>] [--json]
  release conferir   <classe> [<alvo>] [--ref <rev>] [--json]
  release promover   <repo> [<rev>] [--ensaio]
  release reverter   <repo> [<rev>] [--ensaio]

raiz servida: PF_PROD_RAIZ[=$HOME/AI/var/prod]
exit: 0 achou/fez · 1 nao existe · 2 uso · 3 dependencia · 4 politica · 5 indeterminavel
FIM
}

uso() {
  uso_texto
  exit 2
}

validar_slug() {
  local s="$1"
  [ -n "$s" ] || return 2
  case "$s" in
    */*|.*|*..*) return 4 ;;
  esac
  case "$s" in
    *[!A-Za-z0-9._-]*) return 4 ;;
  esac
  return 0
}

listar_familias() {
  local fams=()
  if [ -d "$PROD_RAIZ" ]; then
    for d in "$PROD_RAIZ"/*; do
      [ -d "$d" ] || continue
      local b; b="$(basename "$d")"
      [ "$b" != "current" ] || continue
      fams+=("$b")
    done
  fi
  if [ -d "$ABERTURA_DIR" ]; then
    fams+=("abertura")
  fi
  printf '%s\n' "${fams[@]}"
}

listar_stacks() {
  printf '%s\n' "${STACKS_DEFAULT[@]}"
}

# Resolução de identidade e validação da forma do servido
# Retorna: 0 ok, 1 sem current / nao existe, 2 familia desconhecida, 4 fora da raiz, 5 indeterminavel
resolver_identidade() {
  local repo="$1"
  TARGET_DIR=""
  SHA=""
  SHA_CURTO=""
  TAG=""
  QUANDO=""

  validar_slug "$repo" || {
    local rc=$?
    return "$rc"
  }

  if [ "$repo" = "abertura" ]; then
    local current_link="$ABERTURA_DIR/current"
    if [ ! -e "$current_link" ] && [ ! -L "$current_link" ]; then
      return 1
    fi
    if [ -L "$current_link" ] && [ ! -e "$current_link" ]; then
      printf 'release: indeterminável: current pendurado em %s\n' "$current_link" >&2
      return 5
    fi
    TARGET_DIR="$(realpath "$current_link" 2>/dev/null)" || {
      printf 'release: indeterminável: erro ao resolver realpath de %s\n' "$current_link" >&2
      return 5
    }
    if [ -w "$TARGET_DIR" ]; then
      printf 'release: indeterminável: %s não é servido (diretório gravável — servido é somente-leitura)\n' "$TARGET_DIR" >&2
      return 5
    fi
    if [ -f "$TARGET_DIR/MANIFEST.json" ]; then
      SHA="$(jq -r '.sha // .sha_curto // empty' "$TARGET_DIR/MANIFEST.json" 2>/dev/null || true)"
      QUANDO="$(jq -r '.publicado_em // empty' "$TARGET_DIR/MANIFEST.json" 2>/dev/null || true)"
    fi
    [ -n "$SHA" ] || SHA="$(basename "$TARGET_DIR")"
    SHA_CURTO="${SHA:0:7}"
    [ -n "$QUANDO" ] || QUANDO="$(date -r "$TARGET_DIR" "+%Y-%m-%d %H:%M:%SZ" 2>/dev/null || date -u "+%Y-%m-%d %H:%M:%SZ")"
    TAG=""
    return 0
  fi

  local repo_dir="$PROD_RAIZ/$repo"
  if [ ! -d "$repo_dir" ]; then
    return 2
  fi

  local current_link="$repo_dir/current"
  if [ ! -e "$current_link" ] && [ ! -L "$current_link" ]; then
    return 1
  fi
  if [ -L "$current_link" ] && [ ! -e "$current_link" ]; then
    printf 'release: indeterminável: current pendurado em %s\n' "$current_link" >&2
    return 5
  fi

  TARGET_DIR="$(realpath "$current_link" 2>/dev/null)" || {
    printf 'release: indeterminável: erro ao resolver realpath de %s\n' "$current_link" >&2
    return 5
  }
  if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
    printf 'release: indeterminável: destino de current não existe: %s\n' "$current_link" >&2
    return 5
  fi

  # Forma do servido:
  # 1. Deve ter .git
  if [ ! -e "$TARGET_DIR/.git" ]; then
    printf 'release: indeterminável: %s não é servido (sem .git)\n' "$TARGET_DIR" >&2
    return 5
  fi

  # 2. Deve ser checkout destacado (sem ramo)
  if "$GIT" -C "$TARGET_DIR" symbolic-ref HEAD >/dev/null 2>&1; then
    local ramo
    ramo="$("$GIT" -C "$TARGET_DIR" symbolic-ref --short HEAD 2>/dev/null || echo '?')"
    printf 'release: indeterminável: %s não é servido (tem ramo: %s — servido é checkout destacado)\n' "$TARGET_DIR" "$ramo" >&2
    return 5
  fi

  # 3. Deve ser somente-leitura
  if [ -w "$TARGET_DIR" ]; then
    printf 'release: indeterminável: %s não é servido (diretório gravável — servido é somente-leitura)\n' "$TARGET_DIR" >&2
    return 5
  fi

  SHA="$("$GIT" -C "$TARGET_DIR" rev-parse HEAD 2>/dev/null || echo '')"
  SHA_CURTO="${SHA:0:7}"
  TAG="$("$GIT" -C "$TARGET_DIR" describe --tags --exact-match "$SHA" 2>/dev/null || echo '')"

  QUANDO=""
  if [ -f "$PONTOS/$repo/atual" ]; then
    QUANDO="$(awk '{print $2}' "$PONTOS/$repo/atual" 2>/dev/null || cat "$PONTOS/$repo/atual" 2>/dev/null)"
  fi
  if [ -z "$QUANDO" ]; then
    QUANDO="$(date -r "$TARGET_DIR" "+%Y-%m-%d %H:%M:%SZ" 2>/dev/null || date -u "+%Y-%m-%d %H:%M:%SZ")"
  fi

  return 0
}

cmd_estado() {
  local como_json=0
  local repo_alvo=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; shift ;;
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo_alvo" ]; then
          repo_alvo="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  if [ -n "$repo_alvo" ]; then
    validar_slug "$repo_alvo" || {
      local rc=$?
      if [ "$rc" -eq 4 ]; then
        printf 'release: erro: nome de família inválido: '\''%s'\''\n' "$repo_alvo" >&2
        exit 4
      else
        uso_texto
        exit 2
      fi
    }
  fi

  local fams=()
  if [ -n "$repo_alvo" ]; then
    fams=("$repo_alvo")
  else
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      fams+=("$l")
    done < <(listar_familias)
  fi

  local json_records=()

  for f in "${fams[@]}"; do
    local rc=0
    resolver_identidade "$f" || rc=$?
    if [ "$rc" -eq 2 ]; then
      if [ -n "$repo_alvo" ]; then
        printf 'release: erro: família desconhecida: %s\n' "$repo_alvo" >&2
        printf 'famílias disponíveis:\n' >&2
        for fa in $(listar_familias); do
          printf '  %s\n' "$fa" >&2
        done
        uso_texto
        exit 2
      fi
      continue
    elif [ "$rc" -eq 4 ]; then
      printf 'release: erro: alvo fora da raiz ou símbolo que escapa: %s\n' "$f" >&2
      exit 4
    elif [ "$rc" -eq 5 ]; then
      exit 5
    elif [ "$rc" -eq 1 ]; then
      if [ -n "$repo_alvo" ]; then
        printf 'varrido: servido %s (família sem current)\n' "$repo_alvo" >&2
        printf 'vizinho: repo estado %s\n' "$repo_alvo" >&2
        exit 1
      fi
      continue
    fi

    local porta_str=""
    if [ "$f" = "platafirma-harness" ]; then
      porta_str="porta: sem leitura"
      if command -v systemctl >/dev/null 2>&1; then
        local ts
        ts="$(systemctl --user show ops-mcp -p ActiveEnterTimestamp --value 2>/dev/null || echo '')"
        if [ -n "$ts" ] && [ "$ts" != "n/a" ]; then
          porta_str="porta reiniciada $ts"
        fi
      fi
    fi

    local anterior_str=""
    local ant_sha=""
    if [ -f "$PONTOS/$f/anterior" ]; then
      ant_sha="$(cat "$PONTOS/$f/anterior" 2>/dev/null || echo '')"
      if [ -n "$ant_sha" ]; then
        anterior_str="anterior: ${ant_sha:0:7}"
      fi
    fi

    if [ "$como_json" -eq 1 ]; then
      json_records+=("$(python3 -c '
import sys, json
print(json.dumps({
  "familia": sys.argv[1],
  "sha": sys.argv[2],
  "sha_curto": sys.argv[3],
  "tag": sys.argv[4] or None,
  "no_ar_desde": sys.argv[5],
  "porta": sys.argv[6] or None,
  "anterior": sys.argv[7] or None
}))
' "$f" "$SHA" "$SHA_CURTO" "$TAG" "$QUANDO" "$porta_str" "$ant_sha")")
    else
      if [ "$f" = "abertura" ]; then
        printf '%-24s %-8s              publicada %s\n' "$f" "$SHA_CURTO" "$QUANDO"
      else
        printf '%-24s %-8s' "$f" "$SHA_CURTO"
        if [ -n "$TAG" ]; then
          printf '  %-11s' "$TAG"
        else
          printf '             '
        fi
        printf ' no ar desde %s' "$QUANDO"
        if [ -n "$porta_str" ]; then
          printf '  %s' "$porta_str"
        fi
        if [ -n "$anterior_str" ]; then
          printf '  %s' "$anterior_str"
        fi
        echo
      fi
    fi
  done

  if [ "$como_json" -eq 1 ]; then
    if [ -n "$repo_alvo" ]; then
      if [ "${#json_records[@]}" -gt 0 ]; then
        printf '%s\n' "${json_records[0]}"
      fi
    else
      python3 -c '
import sys, json
records = [json.loads(line) for line in sys.stdin.read().splitlines() if line]
obj = {"familias": {r["familia"]: r for r in records}}
print(json.dumps(obj, indent=2))
' <<<"$(printf '%s\n' "${json_records[@]}")"
    fi
  fi
  return 0
}

cmd_listar() {
  local como_json=0
  local repo=""
  local prefixo=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; shift ;;
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || {
    printf 'release: erro: repo obrigatório para listar\n' >&2
    uso_texto
    exit 2
  }

  validar_slug "$repo" || {
    local rc=$?
    if [ "$rc" -eq 4 ]; then
      printf 'release: erro: nome de família inválido: '\''%s'\''\n' "$repo" >&2
      exit 4
    else
      uso_texto
      exit 2
    fi
  }

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      printf 'release: erro: prefixo fora da raiz ou símbolo que escapa: %s\n' "$prefixo" >&2
      exit 4
    fi
  fi

  local rc=0
  resolver_identidade "$repo" || rc=$?
  if [ "$rc" -eq 1 ]; then
    printf 'varrido: servido %s (família sem current)\n' "$repo" >&2
    printf 'vizinho: repo listar %s %s\n' "$repo" "${prefixo:-}" >&2
    exit 1
  elif [ "$rc" -eq 2 ]; then
    printf 'release: erro: família desconhecida: %s\n' "$repo" >&2
    printf 'famílias disponíveis:\n' >&2
    for fa in $(listar_familias); do
      printf '  %s\n' "$fa" >&2
    done
    uso_texto
    exit 2
  elif [ "$rc" -ne 0 ]; then
    exit "$rc"
  fi

  local files
  if [ -n "$prefixo" ]; then
    files="$("$GIT" -C "$TARGET_DIR" ls-files -- "$prefixo" 2>/dev/null || true)"
  else
    files="$("$GIT" -C "$TARGET_DIR" ls-files 2>/dev/null || true)"
  fi

  if [ -z "$files" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"familia": sys.argv[1], "arquivos": [], "total": 0, "motivo": "nenhum arquivo encontrado sob '\''" + sys.argv[2] + "'\''"}, indent=2))' "$repo" "${prefixo:-.}"
    else
      printf 'motivo: nenhum arquivo encontrado sob '\''%s'\''\n' "${prefixo:-.}"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c 'import sys, json; arqs = [l for l in sys.stdin.read().splitlines() if l]; print(json.dumps({"familia": sys.argv[1], "arquivos": arqs, "total": len(arqs)}, indent=2))' "$repo" <<<"$files"
  else
    printf '%s\n' "$files"
  fi
  return 0
}

cmd_ler() {
  local repo=""
  local caminho=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] && [ -n "$caminho" ] || {
    printf 'release: erro: repo e caminho são obrigatórios para ler\n' >&2
    uso_texto
    exit 2
  }

  validar_slug "$repo" || {
    local rc=$?
    if [ "$rc" -eq 4 ]; then
      printf 'release: erro: nome de família inválido: '\''%s'\''\n' "$repo" >&2
      exit 4
    else
      uso_texto
      exit 2
    fi
  }

  if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
    printf 'release: erro: caminho fora da raiz ou símbolo que escapa: %s\n' "$caminho" >&2
    exit 4
  fi

  local rc=0
  resolver_identidade "$repo" || rc=$?
  if [ "$rc" -eq 1 ]; then
    printf 'varrido: servido %s (família sem current)\n' "$repo" >&2
    printf 'vizinho: repo ler %s %s\n' "$repo" "$caminho" >&2
    exit 1
  elif [ "$rc" -eq 2 ]; then
    printf 'release: erro: família desconhecida: %s\n' "$repo" >&2
    printf 'famílias disponíveis:\n' >&2
    for fa in $(listar_familias); do
      printf '  %s\n' "$fa" >&2
    done
    uso_texto
    exit 2
  elif [ "$rc" -ne 0 ]; then
    exit "$rc"
  fi

  local alvo_arquivo="$TARGET_DIR/$caminho"
  if [ ! -f "$alvo_arquivo" ]; then
    printf 'varrido: servido %s (%s, promovido %s)\n' "$repo" "$TARGET_DIR" "$QUANDO" >&2
    printf 'vizinho: repo ler %s %s\n' "$repo" "$caminho" >&2
    exit 1
  fi

  cat "$alvo_arquivo"
  if [ -n "$TAG" ]; then
    printf 'versão: current@%s (%s)\n' "$SHA_CURTO" "$TAG" >&2
  else
    printf 'versão: current@%s\n' "$SHA_CURTO" >&2
  fi
  return 0
}

cmd_procurar() {
  local como_json=0
  local repo=""
  local termo=""
  local prefixo=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; shift ;;
      --termo)
        shift
        [ $# -gt 0 ] || { printf 'release: erro: --termo exige um valor\n' >&2; uso_texto; exit 2; }
        termo="$1"
        shift
        ;;
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || { printf 'release: erro: repo obrigatório para procurar\n' >&2; uso_texto; exit 2; }
  [ -n "$termo" ] || { printf 'release: erro: --termo <termo> é obrigatório para procurar\n' >&2; uso_texto; exit 2; }

  validar_slug "$repo" || {
    local rc=$?
    if [ "$rc" -eq 4 ]; then
      printf 'release: erro: nome de família inválido: '\''%s'\''\n' "$repo" >&2
      exit 4
    else
      uso_texto
      exit 2
    fi
  }

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      printf 'release: erro: prefixo fora da raiz ou símbolo que escapa: %s\n' "$prefixo" >&2
      exit 4
    fi
  fi

  local rc=0
  resolver_identidade "$repo" || rc=$?
  if [ "$rc" -eq 1 ]; then
    printf 'varrido: servido %s (família sem current)\n' "$repo" >&2
    printf 'vizinho: repo procurar %s --termo %s\n' "$repo" "$termo" >&2
    exit 1
  elif [ "$rc" -eq 2 ]; then
    printf 'release: erro: família desconhecida: %s\n' "$repo" >&2
    printf 'famílias disponíveis:\n' >&2
    for fa in $(listar_familias); do
      printf '  %s\n' "$fa" >&2
    done
    uso_texto
    exit 2
  elif [ "$rc" -ne 0 ]; then
    exit "$rc"
  fi

  local out
  if [ -n "$prefixo" ]; then
    out="$("$GIT" -C "$TARGET_DIR" grep -n -- "$termo" -- "$prefixo" 2>/dev/null || true)"
  else
    out="$("$GIT" -C "$TARGET_DIR" grep -n -- "$termo" 2>/dev/null || true)"
  fi

  if [ -z "$out" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"familia": sys.argv[1], "termo": sys.argv[2], "ocorrencias": [], "total": 0, "motivo": "termo não encontrado no servido"}, indent=2))' "$repo" "$termo"
    else
      printf 'motivo: termo '\''%s'\'' não encontrado no servido %s\n' "$termo" "$repo"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
linhas = [l for l in sys.stdin.read().splitlines() if l]
ocorr = []
for l in linhas:
    partes = l.split(":", 2)
    if len(partes) >= 3:
        ocorr.append({"caminho": partes[0], "linha": int(partes[1]) if partes[1].isdigit() else partes[1], "texto": partes[2]})
    else:
        ocorr.append({"linha_crua": l})
print(json.dumps({"familia": sys.argv[1], "termo": sys.argv[2], "ocorrencias": ocorr, "total": len(ocorr)}, indent=2))
' "$repo" "$termo" <<<"$out"
  else
    printf '%s\n' "$out"
  fi
  return 0
}

cmd_conferir() {
  if [ $# -eq 0 ]; then
    printf 'release: erro: classe obrigatória para conferir\n' >&2
    uso_texto
    exit 2
  fi
  local classe="$1"
  shift

  local conferir_bin=""
  if command -v conferir >/dev/null 2>&1; then
    conferir_bin="conferir"
  elif [ -x "$BIN_DIR/conferir" ]; then
    conferir_bin="$BIN_DIR/conferir"
  elif [ -x "$(dirname "$0")/conferir" ]; then
    conferir_bin="$(dirname "$0")/conferir"
  fi

  if [ -n "$conferir_bin" ]; then
    exec "$conferir_bin" "$classe" "$@"
  else
    printf 'release: erro: dependência ausente: conferir não encontrado\n' >&2
    exit 3
  fi
}

cmd_promover() {
  local ensaio=0
  local tag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ensaio) ensaio=1; shift ;;
      -*) printf 'release: erro: opção desconhecida: %s\n' "$1" >&2; exit 2 ;;
      *) tag="$1"; shift ;;
    esac
  done
  [ -n "$tag" ] || { printf 'release: erro: tag obrigatória. uso: release promover <tag> [--ensaio]\n' >&2; exit 2; }

  local alvo="$PROD_RAIZ/$tag"
  local antes=""
  if [ -L "$CURRENT_LINK" ]; then
    antes="$(basename "$(readlink -f "$CURRENT_LINK")")"
  fi

  echo "== release promover $tag =="
  echo "1. gravando ponto de volta anterior..."
  mkdir -p "$PONTOS"
  if [ -n "$antes" ]; then
    echo "$antes" > "$PONTOS/release.anterior"
    echo "   ponto anterior gravado: $antes"
  else
    echo "   nenhum ponto anterior a gravar"
  fi

  echo "2. checkout dos 3 repos em $alvo..."
  if [ -d "$alvo" ]; then
    chmod -R u+w "$alvo" 2>/dev/null || true
  fi
  mkdir -p "$alvo"

  # Checkout harness
  if [ -d "$HARNESS_REPO" ]; then
    if [ ! -d "$alvo/harness/.git" ]; then
      "$GIT" clone --shared "$HARNESS_REPO" "$alvo/harness"
    else
      "$GIT" -C "$alvo/harness" fetch -q origin || true
    fi
    "$GIT" -C "$alvo/harness" checkout -q --detach "$tag"
  fi

  # Checkout core
  if [ -d "$CORE_REPO" ]; then
    if [ ! -d "$alvo/core/.git" ]; then
      "$GIT" clone --shared "$CORE_REPO" "$alvo/core"
    else
      "$GIT" -C "$alvo/core" fetch -q origin || true
    fi
    "$GIT" -C "$alvo/core" checkout -q --detach "$tag"
  fi

  # Checkout conhecimento
  if [ -d "$CONHECIMENTO_REPO" ]; then
    if [ ! -d "$alvo/conhecimento/.git" ]; then
      "$GIT" clone --shared "$CONHECIMENTO_REPO" "$alvo/conhecimento"
    else
      "$GIT" -C "$alvo/conhecimento" fetch -q origin || true
    fi
    "$GIT" -C "$alvo/conhecimento" checkout -q --detach "$tag"
  fi

  # Link do politica-acesso sob $alvo para PDP_DIR se harness existir
  if [ -d "$alvo/harness/politica-acesso" ]; then
    ln -sfn "harness/politica-acesso" "$alvo/politica-acesso"
  fi

  # Protege o release contra gravacao acidental
  chmod -R a-w "$alvo"
  echo "   repos em $alvo: harness, core, conhecimento (somente leitura)"

  echo "3. troca atomica do symlink current..."
  ln -sfn "$tag" "$PROD_RAIZ/current.tmp"
  mv -Tf "$PROD_RAIZ/current.tmp" "$CURRENT_LINK"
  echo "   current -> $tag"

  echo "4. assentando symlinks de ~/AI/bin/ para $CURRENT_LINK/harness/bin/..."
  mkdir -p "$BIN_DIR"
  if [ -d "$CURRENT_LINK/harness/bin" ]; then
    for f in "$CURRENT_LINK/harness/bin"/*; do
      [ -f "$f" ] || continue
      base="$(basename "$f")"
      ln -sfn "$CURRENT_LINK/harness/bin/$base" "$BIN_DIR/$base"
    done
    for d in "$CURRENT_LINK/harness/bin"/_*; do
      [ -d "$d" ] || continue
      base="$(basename "$d")"
      ln -sfn "$CURRENT_LINK/harness/bin/$base" "$BIN_DIR/$base"
    done
  fi

  echo "5. deploy <stack> promover $tag para cada stack..."
  local falhas=0
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    echo "   promovendo stack: $s"
    if [ "$ensaio" -eq 1 ] || [ "${PF_ENSAIO:-0}" = "1" ]; then
      echo "   (modo ensaio: deploy real nao executado)"
      continue
    fi
    if command -v deploy >/dev/null 2>&1; then
      deploy "$s" promover "$tag" || {
        echo "   aviso: deploy $s promover $tag falhou ou foi recusado" >&2
        falhas=$((falhas + 1))
      }
    else
      echo "   (deploy verbo nao executavel neste ambiente; simulado)"
    fi
  done < <(listar_stacks)

  echo "== release $tag promovido com sucesso =="
}

cmd_reverter() {
  local ensaio=0
  local executar=0
  local tag_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --executar) executar=1; shift ;;
      --ensaio)   ensaio=1; shift ;;
      -*) printf 'release: erro: opção desconhecida: %s\n' "$1" >&2; exit 2 ;;
      *)  tag_arg="$1"; shift ;;
    esac
  done

  local anterior=""
  if [ -r "$PONTOS/release.anterior" ]; then
    anterior="$(cat "$PONTOS/release.anterior" 2>/dev/null || echo '')"
  fi

  local atual="(nenhum)"
  if [ -L "$CURRENT_LINK" ] || [ -e "$CURRENT_LINK" ]; then
    atual="$(basename "$(readlink -f "$CURRENT_LINK")")"
  fi

  if [ "$executar" -ne 1 ]; then
    printf 'release: plano de reversao\n'
    printf '  current servindo : %s\n' "$atual"
    printf '  ponto de volta   : %s\n' "${anterior:-nenhum gravado}"
    printf '  janela           : ~1-5 min\n'
    printf '  quem             : claudinho-TI\n'
    echo
    printf 'executar: PF_SIM=1 release reverter --executar [tag]\n'
    printf '          sem tag, volta ao ponto gravado acima.\n'
    return 0
  fi

  local alvo="${tag_arg:-$anterior}"
  [ -n "$alvo" ] || {
    echo "recusa: sem tag e sem ponto de volta gravado — nao invento para onde voltar." >&2
    echo "        passe a tag: PF_SIM=1 release reverter --executar <tag>" >&2
    exit 1
  }

  if [ "${PF_SIM:-}" != "1" ]; then
    echo "recusa: reverter volta current para $alvo e recria servicos." >&2
    echo "        confirme com: PF_SIM=1 release reverter --executar $alvo" >&2
    exit 1
  fi

  echo "== release reverter: $atual -> $alvo =="
  mkdir -p "$PONTOS"
  echo "$atual" > "$PONTOS/release.revertido-de"

  if [ ! -d "$PROD_RAIZ/$alvo" ]; then
    echo "recusa: diretorio $PROD_RAIZ/$alvo nao existe para reverter." >&2
    exit 1
  fi

  ln -sfn "$alvo" "$PROD_RAIZ/current.tmp"
  mv -Tf "$PROD_RAIZ/current.tmp" "$CURRENT_LINK"
  echo "1. current revertido -> $alvo"

  # Re-aponta ~/AI/bin/*
  if [ -d "$CURRENT_LINK/harness/bin" ]; then
    mkdir -p "$BIN_DIR"
    for f in "$CURRENT_LINK/harness/bin"/*; do
      [ -f "$f" ] || continue
      base="$(basename "$f")"
      ln -sfn "$CURRENT_LINK/harness/bin/$base" "$BIN_DIR/$base"
    done
    for d in "$CURRENT_LINK/harness/bin"/_*; do
      [ -d "$d" ] || continue
      base="$(basename "$d")"
      ln -sfn "$CURRENT_LINK/harness/bin/$base" "$BIN_DIR/$base"
    done
    echo "2. ~/AI/bin/* revertido -> $CURRENT_LINK/harness/bin/*"
  fi

  echo "3. revertendo stacks..."
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    echo "   revertendo stack: $s"
    if [ "$ensaio" -eq 1 ] || [ "${PF_ENSAIO:-0}" = "1" ]; then
      echo "   (modo ensaio: deploy real nao executado)"
      continue
    fi
    if command -v deploy >/dev/null 2>&1; then
      deploy "$s" reverter --executar "$alvo" 2>/dev/null || \
      deploy "$s" promover "$alvo" 2>/dev/null || true
    fi
  done < <(listar_stacks)

  echo "== release revertido para $alvo =="
}

# Se nenhum argumento passado, imprime usage e sai 2
if [ $# -eq 0 ]; then
  uso
fi

# Tratamento universal de --ajuda / -h / --help
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

cmd="$1"
shift

case "$cmd" in
  estado)   cmd_estado "$@" ;;
  listar)   cmd_listar "$@" ;;
  ler)      cmd_ler "$@" ;;
  procurar) cmd_procurar "$@" ;;
  conferir) cmd_conferir "$@" ;;
  promover) cmd_promover "$@" ;;
  reverter) cmd_reverter "$@" ;;
  *)
    printf 'release: erro: ato desconhecido '\''%s'\''\n' "$cmd" >&2
    printf 'atos: estado · listar · ler · procurar · conferir · promover · reverter\n' >&2
    uso_texto
    exit 2
    ;;
esac
