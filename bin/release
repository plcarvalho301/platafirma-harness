#!/usr/bin/env bash
# release — o canônico produção: o que está no ar, desde quando, e como voltar
# capacidade: infra/promocao-de-mudanca
# dono: ti
# classe: B
# use para: saber que sha esta no ar e desde quando (estado), ler/listar/procurar um arquivo do que esta servido (ler, listar, procurar), medir o servido contra a regua de uma classe (conferir), por um sha ou tag no ar (promover) e voltar ao anterior (reverter)
# atos: estado (leitura, operacao), listar (leitura, operacao), ler (leitura, operacao), procurar (leitura, operacao), conferir (leitura, operacao), promover (escrita, operacao), reverter (escrita, operacao)
# forma: texto
# le: estado=release,arquivo-local
# le: listar=release
# le: ler=release
# le: procurar=release
# le: conferir=release,arquivo-local
# le: promover=release,acervo.casa
# le: reverter=release,arquivo-local
# escreve: estado=nada
# escreve: listar=nada
# escreve: ler=nada
# escreve: procurar=nada
# escreve: conferir=nada
# escreve: promover=release,arquivo-local
# escreve: reverter=release,arquivo-local
# (recursos pelo enum de ferramental_recurso; porta, forge e stack pendem id proprio - dados)
# ambiente: PF_RELEASE_RAIZ[=/opt/platafirma] porta · PLATAFIRMA_RELEASE[=$PF_RELEASE_RAIZ/current] porta (atalhos; verbos irmãos em harness/bin) · PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] porta (pontos em var/release/<familia>) · PF_ABERTURA_DIR[=$PLATAFIRMA_INSTANCIA/var/abertura-publicada] porta · PLATAFIRMA_FAMILIAS[=registro/familias.json desta árvore] porta · PLATAFIRMA_VENVS[=registro/venvs.json desta árvore] porta · PLATAFIRMA_TERCEIROS[=registro/terceiros.json desta árvore] porta · PLATAFIRMA_UV porta (override do binário do uv) · PLATAFIRMA_PYTHON[=/usr/bin/python3.12] porta (python de sistema dos venvs) · XDG_RUNTIME_DIR[=/run/user/<uid>] porta · DBUS_SESSION_BUS_ADDRESS[=unix:path=$XDG_RUNTIME_DIR/bus] porta (os dois só quando ausentes, para o infra achar a unit) · PF_CADEIRA porta (lida) · HOME
# uv: resolvido nesta ordem, e só nela: $PLATAFIRMA_UV, /usr/local/bin/uv, /usr/bin/uv, `command -v uv`. Nenhum achado: exit 3 dizendo como instalar uv de sistema. O PATH do wrapper /usr/local/bin/platafirma não tem ~/.local/bin (medido 15/09).
# python dos venvs: $PLATAFIRMA_PYTHON, default /usr/bin/python3.12, com UV_PYTHON_PREFERENCE=only-system e UV_PYTHON_DOWNLOADS=never; nunca o python gerenciado pelo uv no home da conta (caminho, caminho real ou home do venv sob $HOME ou em */uv/python/*: exit 3, override incluído). Ausente, ou lock que pede outra versão: exit 3, current intacto. PLATAFIRMA_UV e PLATAFIRMA_PYTHON só em caminho absoluto. XDG_RUNTIME_DIR herdado de outra conta (diretório existente que não é desta) é trocado pelo desta.
# depende: git · deploy (promover/reverter de família com stack) · acervo (registro de stacks) · python3 · jq · uv (venv do lock; ordem acima) · python de sistema (venvs) · sha256sum + curl (artefato de terceiro pinado; curl só quando o cache em <release>/terceiros não tem) · rede ao forge (promover) · porta (hora de arranque) · infra (restart da porta, destacado) · publicar-abertura (motor da familia abertura, #3054). O restart da porta e deste verbo (spec_release §2, rev 6): o observador pf-porta-watch nao disparou em 15/09, 2 de 2 promocoes
# substitui: readlink current · git -C /opt/platafirma/<familia>/… describe|rev-parse|ls-files|show|grep · git worktree add --detach · ln -sfn + mv -T · chmod -R a-w · conferir <classe> · deploy <stack> promover|reverter
# conforme: parcial
set -euo pipefail

# As duas raízes de produção (desenho #3010 §1): release em /opt, instância em /srv. Nada
# deste verbo lê a bancada — nem para achar a URL de uma família nova.
AQUI="$(dirname "$(readlink -f "$0")")"
. "$AQUI/../lib/raizes.sh"
. "$AQUI/../lib/venv.sh"   # resolver_uv, python_gerenciado, resolver_python, construir_venv (card #3150 passo 2: mesmo construtor para teste)

PROD_RAIZ="$PF_RELEASE_RAIZ"                     # <familia>/{.repo.git,<sha>,current,anterior} e venv/
ATALHOS="$PF_RELEASE_RAIZ/current"               # DIRETÓRIO de atalhos estáveis (arq:0102 D6)
ABERTURA_DIR="${PF_ABERTURA_DIR:-$PLATAFIRMA_INSTANCIA/var/abertura-publicada}"
PONTOS="$PLATAFIRMA_INSTANCIA/var/release"               # registro de promoções; o ponto de volta mora em /opt
BIN_DIR="$PLATAFIRMA_RELEASE/harness/bin"                # verbos irmãos servidos
FAMILIAS="${PLATAFIRMA_FAMILIAS:-$AQUI/../registro/familias.json}"   # familia -> URL do forge
VENVS="${PLATAFIRMA_VENVS:-$AQUI/../registro/venvs.json}"            # venv -> familia + lock
TERCEIROS="${PLATAFIRMA_TERCEIROS:-$AQUI/../registro/terceiros.json}" # artefato -> familia + destino + sha256 + url
TERCEIROS_CACHE="$PF_RELEASE_RAIZ/terceiros/sha256"          # conteúdo endereçado pelo pino
CADEIRA="${PF_CADEIRA:-}"
FAMILIA_BIN="platafirma-harness"   # a única família que serve verbos no PATH e reinicia a porta
ESPELHO=".repo.git"                 # espelho bare por família; fora do glob de famílias

# Resolução de binário real: evitar shims no PATH da porta
GIT="$(command -v /usr/bin/git /bin/git 2>/dev/null | head -1)"
[ -x "$GIT" ] || GIT=/usr/bin/git

if [ ! -x "$GIT" ]; then
  printf 'release: dependência ausente: git não encontrado\n' >&2
  exit 3
fi

CLASSES_SERVIDO=(
  "verbo"
  "servico"
  "skill"
  "procedencia"
  "superficie"
  "ferramental"
  "front"
  "sessao"
  "chapeu"
  "pdp"
  "alcance"
  "card"
)

uso_texto() {
  cat >&2 <<'FIM'
uso:
  release estado     [<repo>] [--json]
  release listar     <repo> [<prefixo>] [--json]
  release ler        <repo> <caminho>
  release procurar   <repo> --termo <termo> [<prefixo>] [--json]
  release conferir   <classe> [<alvo>] [--ref <rev>] [--json]
  release promover   <repo> [<rev>] [--ensaio] [--aceitar-suite-indisponivel]
  release reverter   <repo> [<rev>] [--ensaio]
  release promover   abertura [<rev>] [--ensaio]   publica a abertura do harness na rev (sem rev: origin/main)
  release reverter   abertura [<sha>] [--ensaio]   volta a abertura a um sha ja publicado (sem sha: o anterior)
  release promover   abertura --so-caderno [--ensaio]   so promove se o diff current->origin/main
                                                         em abertura/ for so caderno.md de cadeira/chapeu
                                                         (gatilho automatico do timer abertura-caderno)

raiz servida: PF_RELEASE_RAIZ[=/opt/platafirma] · instancia: PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa]
promover: <rev> (sha ou tag) obrigatória em família com stack; sem rev, avança para origin/main
main: promover E reverter só servem rev alcançável por origin/main (arq:0109 §1); fora dela, exit 4
exit: 0 achou/fez · 1 nao existe · 2 uso · 3 dependencia · 4 politica · 5 indeterminavel
conferir: cada classe conta uma LISTA de itens com veredito de 3 estados
          (conforme/divergente/indeterminavel, com desde e motivo — arq:0110 par.4,
          card #3142); o exit agrega essa lista e so entao pisa no 0/1/5 acima: 0
          tudo conforme, 1 ha divergente (pesa mais que indeterminavel), 5 nenhum
          divergente e ha indeterminavel. Classe desconhecida ou uso incorreto
          segue saindo 2 antes de existir item nenhum. Contrato completo, linha-
          ancora e a lista de classes que ja usam o Veredito comum (e as que ainda
          nao): bin/_release/conferir/README.md
FIM
}

uso() {
  uso_texto
  exit 2
}

validar_slug() {
  local s="$1"
  [ -n "$s" ] || return 2
  case "$s" in
    */*|.*|*..*) return 4 ;;
  esac
  case "$s" in
    *[!A-Za-z0-9._-]*) return 4 ;;
  esac
  return 0
}

is_hex_sha() {
  local s="$1"
  [[ "$s" =~ ^[0-9a-fA-F]{40}$ ]]
}

curto_ou() {  # $1=sha ou vazio  $2=texto quando vazio
  if [ -n "$1" ]; then printf '%s' "${1:0:7}"; else printf '%s' "$2"; fi
}

# verbos irmãos: só pelo PATH ou pelo bin da release no ar ($PLATAFIRMA_RELEASE/harness/bin) — nunca
# pelo diretório deste script (na bancada, o vizinho seria o da bancada, e um teste chamaria o
# deploy real)
achar_verbo() {  # $1=nome ; imprime caminho ou nada
  if command -v "$1" >/dev/null 2>&1; then printf '%s' "$1"
  elif [ -x "$BIN_DIR/$1" ]; then printf '%s' "$BIN_DIR/$1"
  fi
}

listar_familias() {
  local fams=()
  if [ -d "$PROD_RAIZ" ]; then
    for d in "$PROD_RAIZ"/*; do
      [ -d "$d" ] || continue
      local b; b="$(basename "$d")"
      # current/ (atalhos) e venv/ nao sao familia; v<N>… e o layout por tag anterior a
      # primeira promocao por familia, expurgado depois do aceite (desenho #3010 §2)
      case "$b" in current|venv|v[0-9]*) continue ;; esac
      fams+=("$b")
    done
  fi
  if [ -d "$ABERTURA_DIR" ]; then
    fams+=("abertura")
  fi
  printf '%s\n' "${fams[@]}"
}

RESOLVER_MOTIVO=""

# Ponto de volta de uma família: o symlink <familia>/anterior ao lado do current (plano release);
# na falta dele, o registro em $PLATAFIRMA_INSTANCIA/var/release/<familia>/anterior (a abertura só tem este).
ponto_de_volta() {  # $1=familia ; imprime o sha (ou o texto gravado) ou nada
  local f="$1"
  if [ -L "$PROD_RAIZ/$f/anterior" ]; then
    basename "$(readlink "$PROD_RAIZ/$f/anterior")"
  elif [ -f "$PONTOS/$f/anterior" ]; then
    cat "$PONTOS/$f/anterior" 2>/dev/null || true
  fi
}

# Resolução de identidade e validação da forma do servido
# Retorna: 0 ok, 1 sem current, 2 familia desconhecida, 4 fora da raiz, 5 indeterminavel
resolver_identidade() {
  local repo="$1"
  TARGET_DIR=""
  SHA=""
  SHA_CURTO=""
  TAG=""
  QUANDO=""
  RESOLVER_MOTIVO=""

  validar_slug "$repo" || {
    local rc=$?
    return "$rc"
  }

  if [ "$repo" = "abertura" ]; then
    local current_link="$ABERTURA_DIR/current"
    if [ ! -e "$current_link" ] && [ ! -L "$current_link" ]; then
      RESOLVER_MOTIVO="sem current"
      return 1
    fi
    if [ -L "$current_link" ] && [ ! -e "$current_link" ]; then
      RESOLVER_MOTIVO="current pendurado em $current_link"
      return 5
    fi
    TARGET_DIR="$(realpath "$current_link" 2>/dev/null || true)"
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
      RESOLVER_MOTIVO="erro ao resolver realpath de $current_link"
      return 5
    fi
    if [ -w "$TARGET_DIR" ]; then
      RESOLVER_MOTIVO="diretório gravável ($TARGET_DIR) — servido é somente-leitura"
      return 5
    fi
    if [ -f "$TARGET_DIR/MANIFEST.json" ]; then
      SHA="$(jq -r '.sha // empty' "$TARGET_DIR/MANIFEST.json" 2>/dev/null || echo '')"
      QUANDO="$(jq -r '.publicado_em // empty' "$TARGET_DIR/MANIFEST.json" 2>/dev/null || echo '')"
    fi
    if ! is_hex_sha "$SHA"; then
      RESOLVER_MOTIVO="manifesto de abertura com sha inválido ($SHA)"
      return 5
    fi
    SHA_CURTO="${SHA:0:7}"
    [ -n "$QUANDO" ] || QUANDO="$(date -r "$TARGET_DIR" "+%Y-%m-%d %H:%M:%SZ" 2>/dev/null || date -u "+%Y-%m-%d %H:%M:%SZ")"
    TAG=""
    return 0
  fi

  local repo_dir="$PROD_RAIZ/$repo"
  if [ ! -d "$repo_dir" ]; then
    RESOLVER_MOTIVO="família desconhecida"
    return 2
  fi

  local current_link="$repo_dir/current"
  if [ ! -e "$current_link" ] && [ ! -L "$current_link" ]; then
    RESOLVER_MOTIVO="sem current"
    return 1
  fi
  if [ -L "$current_link" ] && [ ! -e "$current_link" ]; then
    RESOLVER_MOTIVO="current pendurado em $current_link"
    return 5
  fi

  TARGET_DIR="$(realpath "$current_link" 2>/dev/null || true)"
  if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
    RESOLVER_MOTIVO="destino de current não existe ($current_link)"
    return 5
  fi

  # 1. Deve ter .git (diretório ou arquivo de worktree)
  if [ ! -e "$TARGET_DIR/.git" ]; then
    RESOLVER_MOTIVO="sem .git em $TARGET_DIR"
    return 5
  fi

  # 2. Deve ser checkout destacado (sem ramo)
  if "$GIT" -C "$TARGET_DIR" symbolic-ref HEAD >/dev/null 2>&1; then
    local ramo
    ramo="$("$GIT" -C "$TARGET_DIR" symbolic-ref --short HEAD 2>/dev/null || echo '?')"
    RESOLVER_MOTIVO="tem ramo: $ramo — servido é checkout destacado"
    return 5
  fi

  # 3. Deve ser somente-leitura
  if [ -w "$TARGET_DIR" ]; then
    RESOLVER_MOTIVO="diretório gravável ($TARGET_DIR) — servido é somente-leitura"
    return 5
  fi

  # 4. Confere sha e nome do diretório
  SHA="$("$GIT" -C "$TARGET_DIR" rev-parse HEAD 2>/dev/null || echo '')"
  if ! is_hex_sha "$SHA"; then
    RESOLVER_MOTIVO="HEAD não é sha válido ($SHA)"
    return 5
  fi
  local target_base; target_base="$(basename "$TARGET_DIR")"
  if [ "$target_base" != "$SHA" ]; then
    RESOLVER_MOTIVO="nome do diretório ($target_base) difere do HEAD ($SHA)"
    return 5
  fi

  SHA_CURTO="${SHA:0:7}"
  TAG="$("$GIT" -C "$TARGET_DIR" describe --tags --exact-match "$SHA" 2>/dev/null || echo '')"

  QUANDO=""
  if [ -f "$PONTOS/$repo/atual" ]; then
    QUANDO="$(awk '{print $2}' "$PONTOS/$repo/atual" 2>/dev/null || true)"
  fi
  if [ -z "$QUANDO" ]; then
    QUANDO="$(date -r "$TARGET_DIR" "+%Y-%m-%d %H:%M:%SZ" 2>/dev/null || date -u "+%Y-%m-%d %H:%M:%SZ")"
  fi

  return 0
}

# ---- recusas comuns aos atos com <repo> ----------------------------------------
recusar_familia_desconhecida() {
  printf 'release: erro: família desconhecida: %s\n' "$1" >&2
  printf 'famílias disponíveis:\n' >&2
  for fa in $(listar_familias); do
    printf '  %s\n' "$fa" >&2
  done
  uso_texto
  exit 2
}

validar_repo_ou_sair() {
  validar_slug "$1" || {
    local rc=$?
    if [ "$rc" -eq 4 ]; then
      printf 'release: erro: nome de família inválido: '\''%s'\''\n' "$1" >&2
      exit 4
    else
      uso_texto
      exit 2
    fi
  }
}

cmd_estado() {
  local como_json=0
  local repo_alvo=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; shift ;;
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo_alvo" ]; then
          repo_alvo="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  if [ -n "$repo_alvo" ]; then
    validar_repo_ou_sair "$repo_alvo"
  fi

  local fams=()
  if [ -n "$repo_alvo" ]; then
    fams=("$repo_alvo")
  else
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      fams+=("$l")
    done < <(listar_familias)
  fi

  local pior_exit=0
  local json_records=()

  for f in "${fams[@]}"; do
    local rc=0
    resolver_identidade "$f" || rc=$?

    if [ -n "$repo_alvo" ]; then
      if [ "$rc" -eq 2 ]; then
        recusar_familia_desconhecida "$repo_alvo"
      elif [ "$rc" -eq 4 ]; then
        printf 'release: erro: alvo fora da raiz ou símbolo que escapa: %s\n' "$f" >&2
        exit 4
      elif [ "$rc" -eq 1 ]; then
        printf 'varrido: servido %s (família sem current)\n' "$repo_alvo" >&2
        printf 'vizinho: repo estado %s\n' "$repo_alvo" >&2
        exit 1
      elif [ "$rc" -eq 5 ]; then
        printf 'release: indeterminável: %s\n' "$RESOLVER_MOTIVO" >&2
        exit 5
      fi
    else
      if [ "$rc" -eq 1 ]; then
        if [ "$pior_exit" -lt 1 ]; then pior_exit=1; fi
        if [ "$como_json" -eq 1 ]; then
          json_records+=("$(python3 -c 'import sys, json; print(json.dumps({"familia": sys.argv[1], "estado": "sem current"}))' "$f")")
        else
          printf '%-24s sem current\n' "$f"
        fi
        continue
      elif [ "$rc" -eq 5 ]; then
        pior_exit=5
        if [ "$como_json" -eq 1 ]; then
          json_records+=("$(python3 -c 'import sys, json; print(json.dumps({"familia": sys.argv[1], "estado": "indeterminavel", "motivo": sys.argv[2]}))' "$f" "$RESOLVER_MOTIVO")")
        else
          printf '%-24s indeterminável: %s\n' "$f" "$RESOLVER_MOTIVO"
        fi
        continue
      elif [ "$rc" -ne 0 ]; then
        if [ "$pior_exit" -lt "$rc" ]; then pior_exit="$rc"; fi
        continue
      fi
    fi

    local porta_str=""
    if [ "$f" = "$FAMILIA_BIN" ]; then
      local porta_ts=""
      if command -v systemctl >/dev/null 2>&1; then
        porta_ts="$(systemctl --user show ops-mcp -p ActiveEnterTimestamp --value 2>/dev/null || echo '')"
      fi
      if [ -n "$porta_ts" ] && [ "$porta_ts" != "n/a" ]; then
        local sec_porta=0 sec_promo=0
        sec_porta="$(date -d "$porta_ts" +%s 2>/dev/null || echo 0)"
        sec_promo="$(date -d "$QUANDO" +%s 2>/dev/null || echo 0)"
        if [ "$sec_promo" -gt 0 ] && [ "$sec_porta" -ge "$sec_promo" ]; then
          porta_str="porta reiniciada $porta_ts"
        elif [ "$sec_promo" -gt 0 ]; then
          porta_str="porta: anterior à promoção ($porta_ts)"
        else
          porta_str="porta reiniciada $porta_ts"
        fi
      else
        porta_str="porta: sem leitura"
      fi
    fi

    local anterior_str=""
    local ant_sha=""
    ant_sha="$(ponto_de_volta "$f")"
    if [ -n "$ant_sha" ]; then
      if is_hex_sha "$ant_sha"; then
        anterior_str="anterior: ${ant_sha:0:7}"
      else
        anterior_str="anterior: ilegível"
      fi
    fi

    if [ "$como_json" -eq 1 ]; then
      json_records+=("$(python3 -c '
import sys, json
print(json.dumps({
  "familia": sys.argv[1],
  "sha": sys.argv[2],
  "sha_curto": sys.argv[3],
  "tag": sys.argv[4] or None,
  "no_ar_desde": sys.argv[5],
  "porta": sys.argv[6] or None,
  "anterior": sys.argv[7] or None
}))
' "$f" "$SHA" "$SHA_CURTO" "$TAG" "$QUANDO" "$porta_str" "$ant_sha")")
    else
      if [ "$f" = "abertura" ]; then
        printf '%-24s %-8s              publicada %s\n' "$f" "$SHA_CURTO" "$QUANDO"
      else
        printf '%-24s %-8s' "$f" "$SHA_CURTO"
        if [ -n "$TAG" ]; then
          printf '  %-11s' "$TAG"
        else
          printf '             '
        fi
        printf ' no ar desde %s' "$QUANDO"
        if [ -n "$porta_str" ]; then
          printf '  %s' "$porta_str"
        fi
        if [ -n "$anterior_str" ]; then
          printf '  %s' "$anterior_str"
        fi
        echo
        if [ "$f" = "$FAMILIA_BIN" ]; then
          local gate_linha; gate_linha="$(ler_ultimo_gate "$f" "$SHA")"
          [ -n "$gate_linha" ] && printf '%-24s   gate: %s\n' '' "$gate_linha"
        fi
      fi
    fi
  done

  if [ "$como_json" -eq 1 ]; then
    if [ -n "$repo_alvo" ]; then
      if [ "${#json_records[@]}" -gt 0 ]; then
        printf '%s\n' "${json_records[0]}"
      fi
    else
      python3 -c '
import sys, json
records = [json.loads(line) for line in sys.stdin.read().splitlines() if line]
obj = {"familias": {r["familia"]: r for r in records}}
print(json.dumps(obj, indent=2))
' <<<"$(printf '%s\n' "${json_records[@]}")"
    fi
  fi

  return "$pior_exit"
}

cmd_listar() {
  local como_json=0
  local repo=""
  local prefixo=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; shift ;;
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || {
    printf 'release: erro: repo obrigatório para listar\n' >&2
    uso_texto
    exit 2
  }

  validar_repo_ou_sair "$repo"

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      printf 'release: erro: prefixo fora da raiz ou símbolo que escapa: %s\n' "$prefixo" >&2
      exit 4
    fi
  fi

  local rc=0
  resolver_identidade "$repo" || rc=$?
  if [ "$rc" -eq 1 ]; then
    printf 'varrido: servido %s (família sem current)\n' "$repo" >&2
    printf 'vizinho: repo listar %s %s\n' "$repo" "${prefixo:-}" >&2
    exit 1
  elif [ "$rc" -eq 2 ]; then
    recusar_familia_desconhecida "$repo"
  elif [ "$rc" -eq 5 ]; then
    printf 'release: indeterminável: %s\n' "$RESOLVER_MOTIVO" >&2
    exit 5
  elif [ "$rc" -ne 0 ]; then
    exit "$rc"
  fi

  local files
  if [ -n "$prefixo" ]; then
    files="$("$GIT" -C "$TARGET_DIR" ls-files -- "$prefixo" 2>/dev/null || true)"
  else
    files="$("$GIT" -C "$TARGET_DIR" ls-files 2>/dev/null || true)"
  fi

  if [ -z "$files" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"familia": sys.argv[1], "arquivos": [], "total": 0, "motivo": "nenhum arquivo encontrado sob '\''" + sys.argv[2] + "'\''"}, indent=2))' "$repo" "${prefixo:-.}"
    else
      printf 'motivo: nenhum arquivo encontrado sob '\''%s'\''\n' "${prefixo:-.}"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c 'import sys, json; arqs = [l for l in sys.stdin.read().splitlines() if l]; print(json.dumps({"familia": sys.argv[1], "arquivos": arqs, "total": len(arqs)}, indent=2))' "$repo" <<<"$files"
  else
    printf '%s\n' "$files"
  fi
  return 0
}

cmd_ler() {
  local repo=""
  local caminho=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] && [ -n "$caminho" ] || {
    printf 'release: erro: repo e caminho são obrigatórios para ler\n' >&2
    uso_texto
    exit 2
  }

  validar_repo_ou_sair "$repo"

  if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
    printf 'release: erro: caminho fora da raiz ou símbolo que escapa: %s\n' "$caminho" >&2
    exit 4
  fi

  local rc=0
  resolver_identidade "$repo" || rc=$?
  if [ "$rc" -eq 1 ]; then
    printf 'varrido: servido %s (família sem current)\n' "$repo" >&2
    printf 'vizinho: repo ler %s %s\n' "$repo" "$caminho" >&2
    exit 1
  elif [ "$rc" -eq 2 ]; then
    recusar_familia_desconhecida "$repo"
  elif [ "$rc" -eq 5 ]; then
    printf 'release: indeterminável: %s\n' "$RESOLVER_MOTIVO" >&2
    exit 5
  elif [ "$rc" -ne 0 ]; then
    exit "$rc"
  fi

  local alvo_arquivo="$TARGET_DIR/$caminho"
  if [ ! -f "$alvo_arquivo" ]; then
    printf 'varrido: servido %s (%s, promovido %s)\n' "$repo" "$TARGET_DIR" "$QUANDO" >&2
    printf 'vizinho: repo ler %s %s\n' "$repo" "$caminho" >&2
    exit 1
  fi

  cat "$alvo_arquivo"
  if [ -n "$TAG" ]; then
    printf 'versão: current@%s (%s)\n' "$SHA_CURTO" "$TAG" >&2
  else
    printf 'versão: current@%s\n' "$SHA_CURTO" >&2
  fi
  return 0
}

cmd_procurar() {
  local como_json=0
  local repo=""
  local termo=""
  local prefixo=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; shift ;;
      --termo)
        shift
        [ $# -gt 0 ] || { printf 'release: erro: --termo exige um valor\n' >&2; uso_texto; exit 2; }
        termo="$1"
        shift
        ;;
      -*)
        printf 'release: erro: opção desconhecida: %s\n' "$1" >&2
        uso_texto
        exit 2
        ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          printf 'release: erro: argumento extra: %s\n' "$1" >&2
          uso_texto
          exit 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || { printf 'release: erro: repo obrigatório para procurar\n' >&2; uso_texto; exit 2; }
  [ -n "$termo" ] || { printf 'release: erro: --termo <termo> é obrigatório para procurar\n' >&2; uso_texto; exit 2; }

  validar_repo_ou_sair "$repo"

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      printf 'release: erro: prefixo fora da raiz ou símbolo que escapa: %s\n' "$prefixo" >&2
      exit 4
    fi
  fi

  local rc=0
  resolver_identidade "$repo" || rc=$?
  if [ "$rc" -eq 1 ]; then
    printf 'varrido: servido %s (família sem current)\n' "$repo" >&2
    printf 'vizinho: repo procurar %s --termo %s\n' "$repo" "$termo" >&2
    exit 1
  elif [ "$rc" -eq 2 ]; then
    recusar_familia_desconhecida "$repo"
  elif [ "$rc" -eq 5 ]; then
    printf 'release: indeterminável: %s\n' "$RESOLVER_MOTIVO" >&2
    exit 5
  elif [ "$rc" -ne 0 ]; then
    exit "$rc"
  fi

  local out=""
  if [ -n "$prefixo" ]; then
    out="$("$GIT" -C "$TARGET_DIR" grep -n -F -- "$termo" -- "$prefixo" 2>/dev/null || true)"
  else
    out="$("$GIT" -C "$TARGET_DIR" grep -n -F -- "$termo" 2>/dev/null || true)"
  fi

  if [ -z "$out" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"familia": sys.argv[1], "termo": sys.argv[2], "ocorrencias": [], "total": 0, "motivo": "termo não encontrado no servido"}, indent=2))' "$repo" "$termo"
    else
      printf 'motivo: termo '\''%s'\'' não encontrado no servido %s\n' "$termo" "$repo"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
linhas = [l for l in sys.stdin.read().splitlines() if l]
ocorr = []
for l in linhas:
    partes = l.split(":", 2)
    if len(partes) >= 3:
        ocorr.append({"caminho": partes[0], "linha": int(partes[1]) if partes[1].isdigit() else partes[1], "texto": partes[2]})
    else:
        ocorr.append({"linha_crua": l})
print(json.dumps({"familia": sys.argv[1], "termo": sys.argv[2], "ocorrencias": ocorr, "total": len(ocorr)}, indent=2))
' "$repo" "$termo" <<<"$out"
  else
    printf '%s\n' "$out"
  fi
  return 0
}

cmd_conferir() {
  if [ $# -eq 0 ]; then
    printf 'release: erro: classe obrigatória para conferir\n' >&2
    uso_texto
    exit 2
  fi
  local classe="$1"
  shift

  case "$classe" in
    existe)
      printf 'release: erro: '\''existe'\'' não é classe do servido — use '\''conferir existe'\''\n' >&2
      exit 2
      ;;
    repo|commit|arranque)
      printf 'release: erro: '\''%s'\'' é classe de bancada — use '\''lint %s'\'' ou '\''conferir %s'\''\n' "$classe" "$classe" "$classe" >&2
      exit 2
      ;;
  esac

  local valida=0
  for c in "${CLASSES_SERVIDO[@]}"; do
    if [ "$classe" = "$c" ]; then
      valida=1
      break
    fi
  done

  if [ "$valida" -ne 1 ]; then
    printf 'release: erro: classe desconhecida: '\''%s'\''\n' "$classe" >&2
    printf 'classes do servido: %s\n' "$(IFS=' · '; echo "${CLASSES_SERVIDO[*]}")" >&2
    exit 2
  fi

  # a implementacao e sub-ato deste verbo (arq:0110 §1): bin/_release/conferir/conferir.py
  local impl; impl="$(dirname "$(readlink -f "$0")")/_release/conferir/conferir.py"
  if [ ! -f "$impl" ]; then
    printf 'release: dependência ausente: implementacao de conferir nao encontrada em %s\n' "$impl" >&2
    exit 3
  fi

  # --ref <rev>: a classe `verbo` mede a revisao candidata a promocao (arq:0110 §9), materializada
  # em worktree destacado a partir do espelho da familia que serve verbos; as demais medem current.
  local ref="" resto=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --ref) shift; [ $# -gt 0 ] || { printf 'release: erro: --ref exige uma rev\n' >&2; exit 2; }; ref="$1"; shift ;;
      *) resto+=("$1"); shift ;;
    esac
  done
  if [ -n "$ref" ]; then
    if [ "$classe" != "verbo" ]; then
      printf 'release: erro: --ref so mede a classe verbo nesta rev; %s mede o current\n' "$classe" >&2
      exit 2
    fi
    local esp; esp="$(espelho_de "$FAMILIA_BIN")"
    if [ ! -d "$esp" ]; then
      printf 'release: erro: familia %s sem espelho — promova uma vez antes de medir por --ref\n' "$FAMILIA_BIN" >&2
      exit 2
    fi
    atualizar_espelho "$esp" || true
    local sha; sha="$(resolver_rev "$FAMILIA_BIN" "$ref")" || {
      printf 'release: recusa: rev '\''%s'\'' nao esta no forge de %s\n' "$ref" "$FAMILIA_BIN" >&2
      exit 4
    }
    local wt; wt="$(mktemp -d "${TMPDIR:-/tmp}/pf-release-ref.XXXXXX")"
    if ! "$GIT" --git-dir="$esp" worktree add -q --detach "$wt/arvore" "$sha" 2>/dev/null; then
      rm -rf "$wt"; printf 'release: indeterminavel: nao consegui materializar %s para medir\n' "${sha:0:7}" >&2; exit 5
    fi
    printf 'ref:       %s materializada em %s (classe verbo mede a rev, nao o current)\n' "${sha:0:7}" "$wt/arvore" >&2
    local rc=0
    PF_PROD_RAIZ="$PROD_RAIZ" PF_BIN_DIR="$wt/arvore/bin" PF_HARNESS_DIR="$wt/arvore" PF_CONFERIR_ORIGEM=0 python3 "$impl" "$classe" "${resto[@]}" || rc=$?
    "$GIT" --git-dir="$esp" worktree remove --force "$wt/arvore" 2>/dev/null || true
    rm -rf "$wt"
    exit "$rc"
  fi
  # o servido vai explicito (raiz, bin e arvore do harness no ar): a implementacao nao deriva
  # raiz nenhuma sozinha, e as classes daqui medem a release, nunca a bancada
  PF_PROD_RAIZ="$PROD_RAIZ" PF_BIN_DIR="$BIN_DIR" PF_HARNESS_DIR="$PLATAFIRMA_RELEASE/harness" \
    exec python3 "$impl" "$classe" "${resto[@]}"
}

# ---- promoção: helpers -----------------------------------------------------------

# stacks da família no registro (acervo.stack), só as que promovem por `deploy promover`.
# Sai em STACKS_PROMOVER (via promover) e STACKS_FORA (reversao declarada por outra via: fora da promocao).
STACKS_PROMOVER=()
STACKS_FORA=()
ler_stacks_da_familia() {
  local repo="$1" json=""
  STACKS_PROMOVER=()
  STACKS_FORA=()
  local acervo_bin; acervo_bin="$(achar_verbo acervo)"
  if [ -z "$acervo_bin" ]; then
    printf 'release: dependência ausente: acervo (registro de stacks) não encontrado\n' >&2
    return 3
  fi
  json="$("$acervo_bin" ler casa stack "$repo" --json 2>/dev/null)" || {
    printf 'release: dependência ausente: acervo ler casa stack não respondeu (registro de stacks)\n' >&2
    return 3
  }
  local linhas
  linhas="$(python3 -c '
import sys, json
repo = sys.argv[1]
d = json.loads(sys.stdin.read())
if isinstance(d, dict): d = [d]
for s in d:
    if s.get("repo") != repo: continue
    via = ((s.get("reversao") or {}).get("via")) or "?"
    print("%s %s" % (s.get("slug"), via))
' "$repo" <<<"$json")" || {
    printf 'release: dependência com outro contrato: registro de stacks não é JSON legível\n' >&2
    return 3
  }
  local slug via
  while read -r slug via; do
    [ -n "$slug" ] || continue
    if [ "$via" = "promover" ]; then STACKS_PROMOVER+=("$slug"); else STACKS_FORA+=("$slug"); fi
  done <<<"$linhas"
  return 0
}

espelho_de() { printf '%s/%s/%s' "$PROD_RAIZ" "$1" "$ESPELHO"; }

# O espelho so tem tres leituras legitimas: sha, tag e ramo do ORIGIN (refs/remotes/origin/*).
# refs/heads/* do espelho e referencia fossil (arq:0074): nasce no `clone --bare` e nunca mais
# e atualizado (o fetch so escreve refs/remotes/origin/* e refs/tags/*). Resolver `main` contra
# ele promoveu o passado (incidente 14/09: `promover harness main` -> ac68756, com origin/main
# em 26afbf0). Producao e checkout de origin/main (arq:0109 §1); nada aponta pro fossil.
# Detectou fossil, expurga no mesmo ato (arq:0074): toda atualizacao do espelho apaga refs/heads/*.
expurgar_fossil_espelho() {  # $1=esp
  local esp="$1" ref
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    "$GIT" --git-dir="$esp" update-ref -d "$ref" 2>/dev/null || true
  done < <("$GIT" --git-dir="$esp" for-each-ref --format='%(refname)' refs/heads/ 2>/dev/null)
}

atualizar_espelho() {  # $1=esp ; fetch do origin + expurgo do fossil; 0 ok, 3 forge fora do ar
  local esp="$1"
  "$GIT" --git-dir="$esp" fetch -q --prune origin '+refs/heads/*:refs/remotes/origin/*' '+refs/tags/*:refs/tags/*' 2>/dev/null || return 3
  expurgar_fossil_espelho "$esp"
  return 0
}

# URL do forge da família, declarada na release (registro/familias.json: familia -> URL).
# Nunca lida de clone: a bancada pode não existir, e a produção não percebe (desenho #3010 §6).
url_da_familia() {  # $1=familia ; imprime a URL ou nada; 3 se o registro não se lê
  [ -r "$FAMILIAS" ] || return 3
  jq -r --arg f "$1" '.[$f] // empty | select(type == "string")' "$FAMILIAS" 2>/dev/null || return 3
}

# garante o espelho bare da família; primeira vez clona da URL declarada no registro de famílias
garantir_espelho() {
  local repo="$1" ensaio="$2" esp url="" rc_url=0; esp="$(espelho_de "$repo")"
  url="$(url_da_familia "$repo")" || rc_url=$?
  if [ "$rc_url" -ne 0 ]; then
    printf 'release: dependência ausente: registro de famílias ilegível (%s)\n' "$FAMILIAS" >&2
    return 3
  fi
  if [ -d "$esp" ]; then
    # espelho nascido de outra origem (clone de bancada, forge antigo) volta ao que a release declara
    if [ -n "$url" ] && [ "$("$GIT" --git-dir="$esp" remote get-url origin 2>/dev/null || true)" != "$url" ]; then
      "$GIT" --git-dir="$esp" remote set-url origin "$url" 2>/dev/null \
        || "$GIT" --git-dir="$esp" remote add origin "$url" 2>/dev/null || true
      printf 'espelho:   origin realinhado ao registro de famílias (%s)\n' "$url"
    fi
    # card #3150 comentario C7: o fetch entra ANTES de resolver a rev, tambem em
    # ensaio (nao so na promocao real) — sha recem-mesclado so aparece depois do
    # fetch, e sem ele o ensaio sempre dava "rev nao resolve no forge", medido 2x
    # numa mesma promocao real (card #3150, comentario do passo 1). Ensaio nao troca
    # current nem materializa nada; fetch e so leitura do espelho, sem risco.
    atualizar_espelho "$esp" || {
      printf 'release: dependência ausente: forge fora do ar (fetch em %s falhou)\n' "$esp" >&2
      return 3
    }
    return 0
  fi
  if [ -z "$url" ]; then
    printf 'release: erro: família fora do registro de famílias — %s não declara %s\n' "$FAMILIAS" "$repo" >&2
    return 2
  fi
  if [ "$ensaio" -eq 1 ]; then
    printf 'espelho:   família nova — clonaria %s em %s\n' "$url" "$esp"
    return 0
  fi
  mkdir -p "$PROD_RAIZ/$repo"
  "$GIT" clone -q --bare "$url" "$esp" 2>/dev/null || {
    printf 'release: dependência ausente: forge fora do ar (clone de %s falhou)\n' "$url" >&2
    return 3
  }
  atualizar_espelho "$esp" || true
  return 0
}

# resolve <rev> para sha no espelho por tres portas, nesta ordem: sha (7-40 hex), tag, ramo do
# origin (`main` e `origin/main` sao a mesma coisa: refs/remotes/origin/main). Sem rev, origin/main.
# Nunca consulta refs/heads/* do espelho — e fossil, e garantir_espelho o expurga (arq:0074, 0109 §1).
resolver_rev() {
  local repo="$1" rev="$2" esp; esp="$(espelho_de "$repo")"
  local sha=""
  if [ -z "$rev" ]; then
    sha="$("$GIT" --git-dir="$esp" rev-parse --verify -q 'refs/remotes/origin/main^{commit}' 2>/dev/null || true)"
    [ -n "$sha" ] || return 1
    printf '%s' "$sha"; return 0
  fi
  if [[ "$rev" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    sha="$("$GIT" --git-dir="$esp" rev-parse --verify -q "${rev}^{commit}" 2>/dev/null || true)"
  fi
  [ -n "$sha" ] || sha="$("$GIT" --git-dir="$esp" rev-parse --verify -q "refs/tags/${rev}^{commit}" 2>/dev/null || true)"
  [ -n "$sha" ] || sha="$("$GIT" --git-dir="$esp" rev-parse --verify -q "refs/remotes/origin/${rev}^{commit}" 2>/dev/null || true)"
  [ -n "$sha" ] || sha="$("$GIT" --git-dir="$esp" rev-parse --verify -q "refs/remotes/${rev}^{commit}" 2>/dev/null || true)"
  [ -n "$sha" ] || return 1
  printf '%s' "$sha"
}

# rev tem de descender de origin/main (produção é checkout de origin/main, arq:0109 §1)
descende_de_main() {
  local repo="$1" sha="$2" esp; esp="$(espelho_de "$repo")"
  "$GIT" --git-dir="$esp" merge-base --is-ancestor "$sha" origin/main 2>/dev/null
}

# O GATE de main, e nao so o texto da ADR: arq:0109 §1 diz que produção serve EXCLUSIVAMENTE
# main, e quem serve sao promover E reverter. So promover media; reverter aceitava qualquer sha
# ja materializado e o punha em current (medido 15/09 no fixture do lote 2: exit 0, current
# movido para sha que so existe em ramo). Reverter reabria a porta que promover fecha, por tres
# vias: materializar nunca apaga, entao todo sha que um dia esteve no ar segue revertivel; o
# ponto de volta gravado pode ser de antes do gate; e sha que estava em main pode sair dela
# (force-push, rebase) sem que o diretorio materializado saiba.
# A medida e LOCAL, no espelho: reverter e caminho de incidente e nao depende de forge de pe.
# Espelho que nao conhece o sha ganha UM fetch best-effort; sem espelho, ou ainda sem
# conhecer, RECUSA — descendencia que nao se mediu nao se afirma, e a saida e promover main.
exigir_descende_de_main() {  # $1=repo(familia do espelho) $2=sha $3=ato $4=alvo do comando
  local repo="$1" sha="$2" ato="$3" alvo="$4" esp; esp="$(espelho_de "$repo")"
  if [ -d "$esp" ]; then
    descende_de_main "$repo" "$sha" && return 0
    atualizar_espelho "$esp" >/dev/null 2>&1 || true
    descende_de_main "$repo" "$sha" && return 0
  else
    printf 'release: recusa: sem espelho em %s — descendência de origin/main não medida (arq:0109 §1)\n' "$esp" >&2
    printf 'caminho: release promover %s <sha|tag de main> clona o espelho e mede\n' "$alvo" >&2
    return 4
  fi
  printf 'release: recusa: %s não descende de origin/main — produção é checkout de origin/main (arq:0109 §1)\n' "${sha:0:7}" >&2
  printf 'caminho: release %s %s <sha|tag de main>  ·  release estado %s diz o que está no ar\n' "$ato" "$alvo" "$alvo" >&2
  return 4
}

# materializa <PF_RELEASE_RAIZ>/<repo>/<sha> como worktree destacado e somente-leitura; idempotente
materializar() {
  local repo="$1" sha="$2" esp dest; esp="$(espelho_de "$repo")"; dest="$PROD_RAIZ/$repo/$sha"
  if [ -d "$dest" ]; then
    return 0
  fi
  "$GIT" --git-dir="$esp" worktree prune 2>/dev/null || true
  "$GIT" --git-dir="$esp" worktree add -q --detach "$dest" "$sha" 2>/dev/null || {
    chmod -R u+w "$dest" 2>/dev/null || true
    rm -rf "$dest"
    printf 'release: indeterminável: não consegui materializar %s em %s\n' "${sha:0:7}" "$dest" >&2
    return 5
  }
  chmod -R a-w "$dest"
  return 0
}

trocar_link() {  # $1=alvo $2=link — troca atômica de um symlink (tmp + rename)
  local alvo="$1" link="$2" tmp
  tmp="$(mktemp -d "$(dirname "$link")/.$(basename "$link").XXXXXX")"; rmdir "$tmp"
  ln -s "$alvo" "$tmp"
  mv -T "$tmp" "$link"
}

# anterior e current trocados atômicos, anterior primeiro: em nenhum instante o current muda
# sem que o ponto de volta já esteja gravado ao lado dele (spec_release §2)
trocar_current() {  # $1=repo $2=sha $3=sha_que_sai(ou vazio)
  local repo="$1" sha="$2" ant="${3:-}"
  if [ -n "$ant" ]; then trocar_link "$ant" "$PROD_RAIZ/$repo/anterior"; fi
  trocar_link "$sha" "$PROD_RAIZ/$repo/current"
}

gravar_pontos() {  # $1=repo $2=sha_anterior(ou vazio) $3=sha_novo
  local repo="$1" ant="$2" novo="$3" quando
  quando="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$PONTOS/$repo"
  if [ -n "$ant" ]; then printf '%s\n' "$ant" > "$PONTOS/$repo/anterior"; fi
  printf '%s %s\n' "$novo" "$quando" > "$PONTOS/$repo/atual"
  printf '%s %s %s\n' "$quando" "${ant:--}" "$novo" >> "$PONTOS/$repo/historico"
}

# Atalhos estáveis (arq:0102 D6; desenho #3010 §2): $PF_RELEASE_RAIZ/current é DIRETÓRIO, uma
# entrada por família (<curto> -> ../<familia>/current), mais politica-acesso -> harness/politica-acesso
# e venv/<nome> -> ../../venv/<nome>-<hash>. Código, units e PATH citam /opt/platafirma/current/<curto>/…,
# que atravessa promoções sem ninguém reescrever caminho. Não há diretório de symlinks de verbos:
# o PATH é $PLATAFIRMA_RELEASE/harness/bin, injetado por quem executa (unit, porta, profile.d).
assentar_atalhos() {  # $1=repo
  local repo="$1" curto="${1#platafirma-}"
  if [ -L "$ATALHOS" ]; then
    # layout por tag (current -> v0.1.0): vira diretório; o que a tag servia segue atalhado
    # para ela até a própria família ser promovida, para nada cair na virada
    local velho tmpd e
    velho="$(readlink -f "$ATALHOS" || true)"
    tmpd="$(mktemp -d "$PROD_RAIZ/.atalhos.XXXXXX")"
    if [ -n "$velho" ] && [ -d "$velho" ]; then
      for e in "$velho"/*; do
        [ -e "$e" ] || continue
        ln -s "$e" "$tmpd/$(basename "$e")"
      done
    fi
    chmod 755 "$tmpd"
    rm "$ATALHOS"
    mv -T "$tmpd" "$ATALHOS"
    printf 'atalhos:   %s era symlink para %s (layout por tag) — virou diretório de atalhos\n' "$ATALHOS" "${velho:-?}"
  fi
  mkdir -p "$ATALHOS"
  trocar_link "../$repo/current" "$ATALHOS/$curto"
  printf 'atalho:    %s -> ../%s/current\n' "$ATALHOS/$curto" "$repo"
  if [ "$repo" = "$FAMILIA_BIN" ]; then
    trocar_link "harness/politica-acesso" "$ATALHOS/politica-acesso"
  fi
  local v nome
  for v in "${VENVS_PRONTOS[@]+"${VENVS_PRONTOS[@]}"}"; do
    nome="${v%-*}"
    mkdir -p "$ATALHOS/venv"
    trocar_link "../../venv/$v" "$ATALHOS/venv/$nome"
    printf 'atalho:    %s -> ../../venv/%s\n' "$ATALHOS/venv/$nome" "$v"
  done
}

# venv/<nome>-<hash-do-lock>, construído do lockfile da rev antes de trocar current (desenho #3010
# §2). O hash é do CONTEÚDO do lock: rev que não mexe no lock reaproveita o venv pronto. Declaração
# em registro/venvs.json: {"<nome>": {"familia": "<familia>", "lock": "<caminho na árvore>"}}.
# Venv falho sai 3 com current intacto; `.pronto` só se grava no fim, então venv pela metade é
# refeito, nunca servido.
#
# O hash cobre também a identidade do python de sistema (caminho real + major.minor): venv
# construído contra outro python (o gerenciado pelo uv no home da conta, medido 15/09 em ops e
# rag) não é reaproveitado por ter o mesmo lock — a próxima promoção constrói ao lado, e o
# atalho só troca depois de pronto. Venv velho fica no disco, como a árvore de rev velha.
VENVS_PRONTOS=()

# resolver_uv, python_gerenciado, resolver_python, construir_venv: movidos para
# lib/venv.sh (card #3150 passo 2) — teste passa a chamar o MESMO construtor, pela
# mesma chave <nome>-<hash>, em vez de ter escada própria.

construir_venvs() {  # $1=repo $2=sha ; enche VENVS_PRONTOS; 0 ok, 3 falhou
  local repo="$1" sha="$2" arvore linhas nome lock hash dest uv="" pyid="" py="" py_real="" py_ver=""
  arvore="$PROD_RAIZ/$repo/$sha"
  VENVS_PRONTOS=()
  [ -r "$VENVS" ] || return 0
  # leitor único (card #3150 passo 2, bin/_release/registro.py): mesma leitura que
  # teste e, depois, pre-push vão usar pela chave — nenhum relê o JSON por conta própria
  linhas="$(PLATAFIRMA_VENVS="$VENVS" python3 "$AQUI/_release/registro.py" --familia "$repo" 2>/dev/null)" || {
    printf 'release: dependência com outro contrato: registro de venvs não é JSON legível (%s)\n' "$VENVS" >&2
    return 3
  }
  while IFS=$'\t' read -r nome lock _teste; do
    [ -n "$nome" ] || continue
    if ! validar_slug "$nome" || [[ "$lock" == /* ]] || [[ "$lock" == *..* ]]; then
      printf 'release: erro: venv mal declarado em %s: %s (%s)\n' "$VENVS" "$nome" "$lock" >&2
      return 3
    fi
    if [ ! -f "$arvore/$lock" ]; then
      printf 'venv:      %s — lock %s ausente na rev %s; atalho do venv segue onde estava\n' "$nome" "$lock" "${sha:0:7}"
      continue
    fi
    if [ -z "$pyid" ]; then
      pyid="$(resolver_python)" || {
        printf 'release: venv %s não construído na rev %s — current intacto\n' "$nome" "${sha:0:7}" >&2
        return 3
      }
      IFS=$'\t' read -r py py_real py_ver <<<"$pyid"
    fi
    hash="$({ cat "$arvore/$lock"; printf '\npython=%s %s\n' "$py_real" "$py_ver"; } | sha256sum | cut -c1-12)"
    dest="$PROD_RAIZ/venv/$nome-$hash"
    if [ -f "$dest/.pronto" ]; then
      printf 'venv:      %s-%s já construído (lock e python inalterados)\n' "$nome" "$hash"
    else
      if [ -z "$uv" ]; then
        uv="$(resolver_uv)" || {
          printf 'release: venv %s não construído na rev %s — current intacto\n' "$nome" "${sha:0:7}" >&2
          return 3
        }
      fi
      if [ -e "$dest" ]; then chmod -R u+w "$dest" 2>/dev/null || true; rm -rf "$dest"; fi
      mkdir -p "$PROD_RAIZ/venv"
      if ! construir_venv "$arvore/$lock" "$dest" "$uv" "$py" "$py_ver"; then
        chmod -R u+w "$dest" 2>/dev/null || true; rm -rf "$dest"
        printf 'release: dependência ausente: venv %s não construiu do lock %s na rev %s — current intacto\n' "$nome" "$lock" "${sha:0:7}" >&2
        return 3
      fi
      : > "$dest/.pronto"
      chmod -R a-w "$dest"
      printf 'venv:      %s-%s construído de %s (python %s %s, uv %s)\n' "$nome" "$hash" "$lock" "$py" "$py_ver" "$uv"
    fi
    VENVS_PRONTOS+=("$nome-$hash")
  done <<<"$linhas"
  return 0
}

# Artefato de terceiro pinado (desenho #3010 §2): entra DENTRO da árvore da rev, no caminho
# que o código acha por realpath (ex.: terceiros/tokenizers/qwen2.5.json). Declaração em
# registro/terceiros.json: {"<nome>": {"familia", "destino", "sha256", "url"}}. Fonte do
# conteúdo: o cache $PF_RELEASE_RAIZ/terceiros/sha256/<pino> (semeável à mão em host sem rede);
# faltando, baixa da url. Conteúdo que não bate o pino é recusado e nada troca current.
# A árvore é a-w: abre só os diretórios do caminho, põe o arquivo e fecha de novo.
sha256_de() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }

materializar_terceiros() {  # $1=repo $2=sha ; 0 ok, 3 dependência ausente, 4 conteúdo fora do pino
  local repo="$1" sha="$2" arvore linhas nome destino pino url alvo cache tmp curl
  arvore="$PROD_RAIZ/$repo/$sha"
  [ -r "$TERCEIROS" ] || return 0
  linhas="$(jq -r --arg f "$repo" 'to_entries[] | select(.key | startswith("_") | not)
            | select((.value | type) == "object" and .value.familia == $f)
            | "\(.key)\t\(.value.destino)\t\(.value.sha256)\t\(.value.url // "")"' "$TERCEIROS" 2>/dev/null)" || {
    printf 'release: dependência com outro contrato: registro de terceiros não é JSON legível (%s)\n' "$TERCEIROS" >&2
    return 3
  }
  while IFS=$'\t' read -r nome destino pino url; do
    [ -n "$nome" ] || continue
    if ! validar_slug "$nome" || [[ "$destino" == /* ]] || [[ "$destino" == *..* ]] || [ -z "$destino" ] \
       || ! [[ "$pino" =~ ^[0-9a-f]{64}$ ]] || { [ -n "$url" ] && [[ "$url" != https://* ]]; }; then
      printf 'release: erro: terceiro mal declarado em %s: %s (%s)\n' "$TERCEIROS" "$nome" "$destino" >&2
      return 3
    fi
    alvo="$arvore/$destino"
    if [ -f "$alvo" ] && [ "$(sha256_de "$alvo")" = "$pino" ]; then
      printf 'terceiro:  %s já na árvore (sha256 %s)\n' "$nome" "${pino:0:12}"
      continue
    fi
    cache="$TERCEIROS_CACHE/$pino"
    if [ ! -f "$cache" ] || [ "$(sha256_de "$cache")" != "$pino" ]; then
      curl="$(command -v curl 2>/dev/null || true)"
      if [ -z "$url" ] || [ -z "$curl" ]; then
        printf 'release: dependência ausente: terceiro %s fora do cache (%s) e sem %s para baixar — current intacto\n' \
          "$nome" "$cache" "$([ -z "$url" ] && echo url || echo curl)" >&2
        return 3
      fi
      mkdir -p "$TERCEIROS_CACHE"
      tmp="$(mktemp "$TERCEIROS_CACHE/.baixando.XXXXXX")"
      if ! "$curl" -fsSL --proto '=https' --max-time 600 -o "$tmp" "$url"; then
        rm -f "$tmp"
        printf 'release: dependência ausente: terceiro %s não baixou de %s — semeie %s e repita; current intacto\n' "$nome" "$url" "$cache" >&2
        return 3
      fi
      local obtido; obtido="$(sha256_de "$tmp")"
      if [ "$obtido" != "$pino" ]; then
        rm -f "$tmp"
        printf 'release: recusa: terceiro %s veio de %s com sha256 %s, pinado %s — current intacto\n' "$nome" "$url" "$obtido" "$pino" >&2
        return 4
      fi
      chmod 444 "$tmp"; mv -f "$tmp" "$cache"
      printf 'terceiro:  %s baixado para o cache (sha256 %s)\n' "$nome" "${pino:0:12}"
    fi
    local d="$arvore" parte abertos=()
    local -a partes
    IFS='/' read -ra partes <<<"$(dirname "$destino")"
    chmod u+w "$d"; abertos+=("$d")
    for parte in "${partes[@]}"; do
      [ -n "$parte" ] && [ "$parte" != "." ] || continue
      d="$d/$parte"
      if [ -d "$d" ]; then chmod u+w "$d"; else mkdir "$d"; fi
      abertos+=("$d")
    done
    rm -f "$alvo"
    if cp "$cache" "$alvo.tmp" && mv -f "$alvo.tmp" "$alvo"; then
      chmod 444 "$alvo"
    else
      rm -f "$alvo.tmp"
      for d in "${abertos[@]}"; do chmod a-w "$d" 2>/dev/null || true; done
      printf 'release: indeterminável: não consegui pôr o terceiro %s em %s\n' "$nome" "$alvo" >&2
      return 5
    fi
    for d in "${abertos[@]}"; do chmod a-w "$d"; done
    printf 'terceiro:  %s -> %s (sha256 %s)\n' "$nome" "$destino" "${pino:0:12}"
  done <<<"$linhas"
  return 0
}

achar_deploy() { achar_verbo deploy; }

# dependência conferida ANTES de tocar current: família com stack exige deploy no PATH
exigir_deploy_se_stack() {
  [ "${#STACKS_PROMOVER[@]}" -gt 0 ] || return 0
  [ -n "$(achar_deploy)" ] || {
    printf 'release: dependência ausente: deploy não encontrado e a família tem stacks (%s)\n' "${STACKS_PROMOVER[*]}" >&2
    return 3
  }
}

promover_stacks() {  # $1=sha ; usa STACKS_PROMOVER; devolve 0 ou o nome da stack que recusou em STACK_FALHOU
  local sha="$1" s
  STACK_FALHOU=""
  local deploy_bin; deploy_bin="$(achar_deploy)"
  if [ "${#STACKS_PROMOVER[@]}" -eq 0 ]; then
    return 0
  fi
  if [ -z "$deploy_bin" ]; then
    printf 'release: dependência ausente: deploy não encontrado e a família tem stacks (%s)\n' "${STACKS_PROMOVER[*]}" >&2
    return 3
  fi
  local errf; errf="$(mktemp)"
  local rc_dep
  for s in "${STACKS_PROMOVER[@]}"; do
    printf 'stack:     %s → deploy %s promover %s\n' "$s" "$s" "${sha:0:7}"
    # stdout do deploy segue pro terminal (build log); stderr vai a um arquivo e e
    # ecoado logo apos, para o motivo da recusa (ex.: segredo ausente na instancia)
    # sobreviver quando o release roda pela porta e o stderr solto se perderia.
    # Sem isto a saida dizia so "stack recusou a promocao", generica, apagando a
    # causa que tem conserto. Arquivo (nao process substitution) evita a corrida
    # entre o tee e o tail quando o deploy recusa rapido.
    rc_dep=0
    "$deploy_bin" "$s" promover "$sha" 2>"$errf" || rc_dep=$?
    cat "$errf" >&2
    if [ "$rc_dep" -ne 0 ]; then
      STACK_FALHOU="$s"
      STACK_MOTIVO="$(tail -n 3 "$errf" 2>/dev/null || true)"
      rm -f "$errf"
      return 5
    fi
  done
  rm -f "$errf"
  return 0
}

# O restart da porta é deste verbo (spec_release §2: `promover` agenda o restart fora do
# próprio processo). A rev 5 o entregara ao observador pf-porta-watch (unit .path --user
# sobre current); em 15/09 ele não disparou em 2 de 2 promoções — current trocado, porta
# servindo o código anterior, ninguém avisado. O motivo da rev 5 (systemd-run sem bus; o
# restart matando a conexão que emitiu o promover) já tem cura na casa: `infra restart
# ops-mcp` despacha destacado e a chamada que o emite volta antes do restart (medido 15/09
# pela porta). Chamado por último, depois de tudo relatado. PF_RELEASE_PORTA=0 desliga.
reiniciar_porta() {
  # O restart da porta mata o processo que a chamou (a chamada nao sobrevive): a tela da
  # promocao tem de sair ANTES, senao quem promoveu recebe nada (medido em 26/09, a0c2108).
  resumo_imprime
  local repo="$1"
  [ "$repo" = "$FAMILIA_BIN" ] || return 0
  if [ "${PF_RELEASE_PORTA:-1}" != "1" ]; then
    printf 'porta:     restart desligado (PF_RELEASE_PORTA=0) — reinicie com: infra restart ops-mcp\n'
    return 0
  fi
  local infra_bin out rc=0
  infra_bin="$(achar_verbo infra)"
  if [ -z "$infra_bin" ]; then
    printf 'porta:     AVISO — infra não encontrado; a porta segue no código anterior até: infra restart ops-mcp\n' >&2
    return 0
  fi
  # Sem XDG_RUNTIME_DIR (wrapper, runuser, cron) o infra não acha a unit --user e o restart não
  # acontece (medido 15/09). Definidos só quando ausentes; o infra repete a regra para quem o
  # chama direto. O restart segue destacado (systemd-run --user, dentro do infra).
  # Valor herdado de OUTRA conta (runuser/su sem -l leva o XDG de quem chamou, ex.
  # /run/user/0) também não serve: diretório que existe e não é desta conta é trocado, e o
  # DBUS que aponta para dentro dele sai junto. O infra do PATH pode ser o de uma release
  # velha, sem essa regra; por isso ela vale aqui também.
  local xdg="${XDG_RUNTIME_DIR:-}" dbus="${DBUS_SESSION_BUS_ADDRESS:-}"
  if [ -n "$xdg" ] && [ -d "$xdg" ] && [ ! -O "$xdg" ]; then
    case "$dbus" in *"$xdg"*) dbus="" ;; esac
    xdg=""
  fi
  xdg="${xdg:-/run/user/$(id -u)}"
  out="$(XDG_RUNTIME_DIR="$xdg" DBUS_SESSION_BUS_ADDRESS="${dbus:-unix:path=$xdg/bus}" \
    "$infra_bin" restart ops-mcp 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    printf 'porta:     %s\n' "$(tail -n 1 <<<"$out")"
  else
    printf 'porta:     AVISO — infra restart ops-mcp saiu %s: %s\n' "$rc" "$(tail -n 1 <<<"$out")" >&2
  fi
  return 0
}

# ---- família abertura: promover/reverter pela mesma porta (#3054; spec_release §Aberto) ----
# A abertura é a subárvore abertura/ do harness publicada em morada imutável (arq:0097). O
# motor segue sendo bin/publicar-abertura (snapshot do object store, validado, ponteiro
# atômico, gancho da casa); o release lhe dá a fonte e o registro: lê do ESPELHO do harness,
# nunca do clone de trabalho (o 14/09 promoveu o passado lendo clone parado), confere que a
# rev descende de origin/main e grava o ponto de volta em $PLATAFIRMA_INSTANCIA/var/release/abertura.
rodar_publicador() {  # $@=args do publicar-abertura
  local pub; pub="$(achar_verbo publicar-abertura)"
  if [ -z "$pub" ]; then
    printf 'release: dependência ausente: publicar-abertura não encontrado (motor da família abertura)\n' >&2
    return 3
  fi
  PF_HARNESS="$(espelho_de "$FAMILIA_BIN")" PF_ABERTURA_DIR="$ABERTURA_DIR" \
    PF_ACERVO="$(command -v "$(achar_verbo acervo)" 2>/dev/null || true)" "$pub" "$@"
}

sha_abertura_no_ar() {
  local rc=0
  resolver_identidade abertura || rc=$?
  if [ "$rc" -eq 0 ]; then printf '%s' "$SHA"; fi
  return 0
}

rev_tem_abertura() {  # $1=sha
  "$GIT" --git-dir="$(espelho_de "$FAMILIA_BIN")" rev-parse --verify -q "${1}:abertura" >/dev/null 2>&1
}

# publica a abertura na rev do harness que acabou de ir ao ar; idempotente
publicar_abertura_da_familia() {  # $1=repo $2=sha ; 0 ok ou nada a fazer, 5 falhou
  local repo="$1" sha="$2" antes out rc=0
  [ "$repo" = "$FAMILIA_BIN" ] || return 0
  if ! rev_tem_abertura "$sha"; then
    printf 'abertura:  rev %s sem abertura/ — nada a publicar\n' "${sha:0:7}"
    return 0
  fi
  antes="$(sha_abertura_no_ar)"
  if [ "$antes" = "$sha" ]; then
    printf 'abertura:  já publicada em %s\n' "${sha:0:7}"
    return 0
  fi
  out="$(rodar_publicador "$sha" 2>&1)" || rc=$?
  printf '%s\n' "$out" | sed 's/^/abertura:  /'
  [ "$rc" -eq 0 ] || return 5
  gravar_pontos abertura "$antes" "$sha"
  return 0
}

promover_abertura() {  # $1=rev(opcional) $2=ensaio
  local rev="$1" ensaio="$2" rc=0 esp sha antes
  garantir_espelho "$FAMILIA_BIN" "$ensaio" || { rc=$?; return "$rc"; }
  esp="$(espelho_de "$FAMILIA_BIN")"
  if [ ! -d "$esp" ]; then
    printf 'ensaio:    %s sem espelho; nada resolvido\n' "$FAMILIA_BIN"
    return 0
  fi
  sha="$(resolver_rev "$FAMILIA_BIN" "$rev")" || {
    printf 'varrido:   %s no espelho de %s (fetch feito agora, sem achar)\n' "${rev:-origin/main}" "$FAMILIA_BIN" >&2
    return 1
  }
  exigir_descende_de_main "$FAMILIA_BIN" "$sha" 'promover' abertura || return $?
  if ! rev_tem_abertura "$sha"; then
    printf 'release: erro: rev %s não tem abertura/\n' "${sha:0:7}" >&2
    return 2
  fi
  antes="$(sha_abertura_no_ar)"
  if [ "$antes" = "$sha" ]; then
    printf 'já no ar:  abertura current → %s — nada a mover\n' "${sha:0:7}"
    return 1
  fi
  printf '== release promover abertura %s ==\n' "${sha:0:7}"
  printf 'de:        %s\n' "$(curto_ou "$antes" '(sem current)')"
  if [ "$ensaio" -eq 1 ]; then
    printf 'ensaio:    nada tocado\n'
    return 0
  fi
  publicar_abertura_da_familia "$FAMILIA_BIN" "$sha" || { rc=$?; return "$rc"; }
  printf 'no ar:     abertura %s\n' "${sha:0:7}"
  printf '%s\n' "$sha"
}

# --so-caderno (card #3141): gatilho AUTOMATICO (timer abertura-caderno), sem mao no meio.
# So promove quando o diff current->origin/main, restrito a abertura/, e SO caderno.md de
# cadeira/chapeu (abertura/<cadeira>/<chapeu>/caderno.md) — nunca decide sozinho quando o
# diff toca persona, chapeu.md, dono.md ou o roteador: isso sobe por `release promover
# abertura` a mao, ate a bateria #3090 (conferir de chapeu) existir.
RE_SO_CADERNO='^abertura/[^/]+/[^/]+/caderno\.md$'

promover_abertura_so_caderno() {  # $1=ensaio
  local ensaio="$1" rc=0 esp sha antes
  garantir_espelho "$FAMILIA_BIN" "$ensaio" || { rc=$?; return "$rc"; }
  esp="$(espelho_de "$FAMILIA_BIN")"
  if [ ! -d "$esp" ]; then
    printf 'ensaio:    %s sem espelho; nada resolvido\n' "$FAMILIA_BIN"
    return 0
  fi
  sha="$(resolver_rev "$FAMILIA_BIN" '')" || {
    printf 'varrido:   origin/main no espelho de %s (fetch feito agora, sem achar)\n' "$FAMILIA_BIN" >&2
    return 1
  }
  exigir_descende_de_main "$FAMILIA_BIN" "$sha" 'promover' abertura || return $?
  antes="$(sha_abertura_no_ar)"
  if [ -z "$antes" ]; then
    printf 'release: erro: abertura sem current — --so-caderno so promove em cima de uma abertura ja publicada; use release promover abertura\n' >&2
    return 2
  fi
  if [ "$antes" = "$sha" ]; then
    printf 'já no ar:  abertura current → %s — nada a mover\n' "${sha:0:7}"
    return 0
  fi

  local caminhos=() c fora=()
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    caminhos+=("$c")
  done < <("$GIT" --git-dir="$esp" diff --name-only "$antes" "$sha" -- abertura 2>/dev/null)

  if [ "${#caminhos[@]}" -eq 0 ]; then
    printf 'nada andou: %s → %s nao muda nada em abertura/ — nada a publicar\n' "${antes:0:7}" "${sha:0:7}"
    return 0
  fi

  for c in "${caminhos[@]}"; do
    [[ "$c" =~ $RE_SO_CADERNO ]] || fora+=("$c")
  done
  if [ "${#fora[@]}" -gt 0 ]; then
    printf 'release: recusa: --so-caderno so promove diff que e so caderno.md de cadeira/chapeu; fora do padrao (%d):\n' "${#fora[@]}" >&2
    printf '  %s\n' "${fora[@]}" >&2
    printf 'suba com: release promover abertura %s\n' "${sha:0:7}" >&2
    return 4
  fi

  printf '== release promover abertura --so-caderno %s ==\n' "${sha:0:7}"
  printf 'de:        %s\n' "$(curto_ou "$antes" '(sem current)')"
  printf 'so-caderno: %s caminho(s), todos caderno.md\n' "${#caminhos[@]}"
  if [ "$ensaio" -eq 1 ]; then
    printf 'ensaio:    nada tocado\n'
    return 0
  fi
  publicar_abertura_da_familia "$FAMILIA_BIN" "$sha" || { rc=$?; return "$rc"; }
  printf 'no ar:     abertura %s\n' "${sha:0:7}"
  printf '%s\n' "$sha"
}

reverter_abertura() {  # $1=sha(opcional) $2=ensaio
  local rev="$1" ensaio="$2" alvo="" antes novo out rc=0
  if [ -n "$rev" ]; then
    if [[ ! "$rev" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
      printf 'release: erro: a abertura reverte por sha já publicado, não por '\''%s'\''\n' "$rev" >&2
      return 2
    fi
    alvo="$rev"
  elif [ -f "$PONTOS/abertura/anterior" ]; then
    alvo="$(cat "$PONTOS/abertura/anterior" 2>/dev/null || echo '')"
  fi
  if [ -z "$alvo" ]; then
    printf 'release: erro: sem sha e sem ponto de volta gravado para abertura — não invento para onde voltar\n' >&2
    return 2
  fi
  exigir_descende_de_main "$FAMILIA_BIN" "$alvo" 'reverter' abertura || return $?
  antes="$(sha_abertura_no_ar)"
  if [ -n "$antes" ]; then
    case "$antes" in
      "$alvo"*) printf 'já no ar:  abertura current → %s — nada a mover\n' "${antes:0:7}"; return 1 ;;
    esac
  fi
  printf '== release reverter abertura %s → %s ==\n' "$(curto_ou "$antes" '(sem current)')" "${alvo:0:7}"
  if [ "$ensaio" -eq 1 ]; then
    printf 'ensaio:    nada tocado\n'
    return 0
  fi
  out="$(rodar_publicador reverter "$alvo" 2>&1)" || rc=$?
  printf '%s\n' "$out" | sed 's/^/abertura:  /'
  [ "$rc" -eq 0 ] || return 1
  novo="$(sha_abertura_no_ar)"
  gravar_pontos abertura "$antes" "$novo"
  printf 'no ar:     abertura %s\n' "${novo:0:7}"
  printf '%s\n' "$novo"
}

# gate de promocao (arq:0110 §9; mapa: `conferir` e o gate de infra/promocao-de-mudanca). A familia
# que serve verbos so troca current se cada verbo que a rev MUDOU (bin/<verbo> ou bin/_<verbo>/,
# em relacao ao current) passa em `conferir verbo` medido no checkout ja materializado. Conformacao
# e para frente (arq:0042): verbo que a rev nao tocou carrega o debito que ja carregava e nao
# segura a promocao. Mede com o conferir da propria rev, PF_CONFERIR_ORIGEM=0 (o checkout E o
# repo; origem nao mede nada ali). Divergencia e politica: exit 4, current intacto.
gate_conferir_verbo() {  # $1=repo $2=sha_candidato $3=sha_atual(ou vazio)
  local repo="$1" sha="$2" atual="$3" esp arvore impl
  [ "$repo" = "$FAMILIA_BIN" ] || return 0
  esp="$(espelho_de "$repo")"; arvore="$PROD_RAIZ/$repo/$sha"; impl="$arvore/bin/_release/conferir/conferir.py"
  if [ ! -f "$impl" ]; then
    printf 'gate:      rev %s nao traz bin/_release/conferir — anterior ao gate; nada medido\n' "${sha:0:7}"
    return 0
  fi
  if [ -z "$atual" ]; then
    printf 'gate:      familia sem current — sem base para dizer o que a rev mudou; nada medido\n'
    return 0
  fi
  local caminho nome verbos=() v
  while IFS= read -r caminho; do
    caminho="${caminho#bin/}"
    nome="${caminho%%/*}"
    nome="${nome#_}"
    [ -n "$nome" ] || continue
    [ -f "$arvore/bin/$nome" ] || continue      # sub-ato de verbo apagado, ou arquivo solto
    for v in "${verbos[@]}"; do [ "$v" = "$nome" ] && continue 2; done
    verbos+=("$nome")
  done < <("$GIT" --git-dir="$esp" diff --name-only "$atual" "$sha" -- bin 2>/dev/null)
  if [ "${#verbos[@]}" -eq 0 ]; then
    printf 'gate:      %s → %s nao muda verbo nenhum em bin/ — nada a medir\n' "${atual:0:7}" "${sha:0:7}"
    return 0
  fi
  printf 'gate:      conferir verbo na rev %s para o que ela mudou: %s\n' "${sha:0:7}" "${verbos[*]}"
  local rc=0 reprovados=()
  for v in "${verbos[@]}"; do
    rc=0
    PF_PROD_RAIZ="$PROD_RAIZ" PF_BIN_DIR="$arvore/bin" PF_HARNESS_DIR="$arvore" PF_CONFERIR_ORIGEM=0 python3 "$impl" verbo "$v" || rc=$?
    [ "$rc" -eq 0 ] || reprovados+=("$v")
  done
  if [ "${#reprovados[@]}" -gt 0 ]; then
    printf 'release: recusa: rev %s reprova em conferir verbo: %s — current segue em %s; corrija o cabecalho (capacidade/dono no mapa da mesa) e promova de novo\n' \
      "${sha:0:7}" "${reprovados[*]}" "${atual:0:7}" >&2
    return 4
  fi
  printf 'gate:      verde\n'
  return 0
}

# Estagio 1b da esteira (card #3150, comentario C1): a MESMA suite que hooks/pre-push
# mede, no MESMO venv da chave, com o MESMO veredito memoizado por (hash da arvore,
# chave) — lib/venv.sh: caminho_veredito/ler_veredito/gravar_veredito. Se o push que
# trouxe esta rev ja foi medido, a promocao reaproveita sem rodar nada de novo. So se
# aplica a familia que serve verbos (FAMILIA_BIN); chave fixa "harness" (mesma razao
# do pre-push: nenhum arquivo de VERDES hoje precisa de outra).
# Gate de bloqueio nao interpreta (spec_ambiente-de-desenvolvimento §3): suite que nao se
# conseguiu medir sai 5 e BARRA, com o motivo nomeado; so sobe com a flag explicita
# --aceitar-suite-indisponivel, declarada no retorno. Em 26/09 a regra antiga ("nunca barra
# por ambiente") deixou a promocao subir sem suite: o uv tentava criar controle/.venv na
# arvore materializada, que e so leitura. O pre-push (comentario A2) segue so avisando.
CHAVE_SUITE="harness"
GATE_SUITE_STATUS=""; GATE_SUITE_DETALHE=""; GATE_SUITE_LOG=""
GATE_AMBIENTE_STATUS=""; GATE_AMBIENTE_SEGUNDOS=0; GATE_AMBIENTE_CHAVE=""

gate_suite_verdes() {  # $1=repo $2=sha ; 0 verde ou n/a; 4 vermelho medido; 5 nao medido (detalhe nomeia)
  local repo="$1" sha="$2"
  local arvore="$PROD_RAIZ/$repo/$sha"  # "local a=$1 b=...$a" nao ve o $a recem-declarado: outro local
  GATE_SUITE_STATUS="indisponivel"; GATE_SUITE_DETALHE=""; GATE_SUITE_LOG=""
  GATE_AMBIENTE_STATUS="indisponivel"; GATE_AMBIENTE_SEGUNDOS=0; GATE_AMBIENTE_CHAVE=""
  [ "$repo" = "$FAMILIA_BIN" ] || { GATE_SUITE_STATUS="n/a"; return 0; }

  local alvos=() arq
  while IFS= read -r arq; do alvos+=("$arq"); done < <(listar_verdes "$arvore")
  local sumidos; sumidos="$(verdes_ausentes "$arvore" | tr '\n' ' ')"
  if [ -n "${sumidos// /}" ]; then
    GATE_SUITE_DETALHE="VERDES lista arquivo que nao existe na arvore: ${sumidos% }"
    return 5
  fi
  if [ "${#alvos[@]}" -eq 0 ]; then GATE_SUITE_STATUS="sem-verdes"; return 0; fi

  local venvs="${PLATAFIRMA_VENVS:-$arvore/registro/venvs.json}"
  local out familia lock teste
  out="$(PLATAFIRMA_VENVS="$venvs" python3 "$AQUI/_release/registro.py" "$CHAVE_SUITE" 2>/dev/null)" \
    || { GATE_SUITE_DETALHE="registro de venvs sem a chave $CHAVE_SUITE"; return 5; }
  IFS=$'\t' read -r familia lock teste <<<"$out"
  [ -f "$arvore/$lock" ] || { GATE_SUITE_DETALHE="lock $lock ausente na arvore"; return 5; }

  local pyid py py_real py_ver
  pyid="$(resolver_python 2>/dev/null)" || { GATE_SUITE_DETALHE="python de construcao nao resolvido"; return 5; }
  IFS=$'\t' read -r py py_real py_ver <<<"$pyid"
  local chave_hash
  chave_hash="$({ cat "$arvore/$lock"; printf '\npython=%s %s\n' "$py_real" "$py_ver"; } | sha256sum | cut -c1-12)"
  GATE_AMBIENTE_CHAVE="${CHAVE_SUITE}-${chave_hash}"

  local arvore_hash
  arvore_hash="$("$GIT" -C "$arvore" rev-parse 'HEAD^{tree}' 2>/dev/null)"
  [ -n "$arvore_hash" ] || { GATE_SUITE_DETALHE="hash da arvore ilegivel"; return 5; }

  local vereditos_dir="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/pre-push/vereditos"
  mkdir -p "$vereditos_dir" 2>/dev/null || true
  local veredito_arq; veredito_arq="$(caminho_veredito "$vereditos_dir" "$arvore_hash" "$CHAVE_SUITE" "$chave_hash")"
  local vresultado; vresultado="$(ler_veredito "$veredito_arq")"
  case "$vresultado" in
    verde)
      GATE_SUITE_STATUS="verde"; GATE_SUITE_DETALHE="reaproveitado"
      GATE_AMBIENTE_STATUS="reaproveitado"
      return 0 ;;
    vermelho)
      GATE_SUITE_STATUS="vermelho"
      GATE_SUITE_DETALHE="reaproveitado (veredito ja gravado vermelho para esta arvore)"
      return 4 ;;
  esac

  local uv; uv="$(resolver_uv 2>/dev/null)" || { GATE_SUITE_DETALHE="uv ausente"; return 5; }
  local dest="$PROD_RAIZ/venv/${CHAVE_SUITE}-${chave_hash}"
  local t0 t1
  t0=$(date +%s 2>/dev/null || echo 0)
  if [ ! -f "$dest/.pronto" ]; then
    mkdir -p "$(dirname "$dest")"
    if ! construir_venv "$arvore/$lock" "$dest" "$uv" "$py" "$py_ver" 2>/dev/null; then
      chmod -R u+w "$dest" 2>/dev/null || true; rm -rf "$dest"
      GATE_SUITE_DETALHE="venv da chave ${CHAVE_SUITE}-${chave_hash} nao construiu"
      return 5
    fi
    : > "$dest/.pronto"; chmod -R a-w "$dest"
    GATE_AMBIENTE_STATUS="construido"
  else
    GATE_AMBIENTE_STATUS="reaproveitado"
  fi
  t1=$(date +%s 2>/dev/null || echo 0)
  GATE_AMBIENTE_SEGUNDOS=$((t1 - t0))

  local log_dir="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/log/release-gate"
  mkdir -p "$log_dir" 2>/dev/null || true
  local saida="$log_dir/${sha}.txt" xml
  xml="$(mktemp "${TMPDIR:-/tmp}/gate-junit.XXXXXX.xml")"
  # A arvore materializada e so leitura: o ambiente do projeto controle/ vai para um
  # temporario (UV_PROJECT_ENVIRONMENT) em vez de controle/.venv, --frozen impede o uv de
  # reescrever o uv.lock da arvore, e o cache do pytest fica desligado. O resto e a mesma
  # linha do pre-push, para os dois medirem a mesma coisa.
  local rc_pytest=0 envtmp frozen=()
  envtmp="$(mktemp -d "${TMPDIR:-/tmp}/gate-env.XXXXXX")"
  [ -f "$arvore/controle/uv.lock" ] && frozen=(--frozen)
  ( cd "$arvore/controle" && UV_PROJECT_ENVIRONMENT="$envtmp/venv" timeout 300 "$uv" run "${frozen[@]}" \
      --python "$dest/bin/python" --with pytest \
      pytest "${alvos[@]}" -q -p no:cacheprovider --junitxml="$xml" ) >"$saida" 2>&1 || rc_pytest=$?
  rm -rf "$envtmp"
  GATE_SUITE_LOG="$saida"

  case "$rc_pytest" in
    0)
      gravar_veredito "$veredito_arq" verde "$sha"
      GATE_SUITE_STATUS="verde"; GATE_SUITE_DETALHE="$(tail -n 1 "$saida")"
      rm -f "$xml"
      return 0 ;;
    1)
      gravar_veredito "$veredito_arq" vermelho "$sha"
      GATE_SUITE_STATUS="vermelho"
      GATE_SUITE_DETALHE="$(nomear_reprovados "$xml" | head -n 1)"
      rm -f "$xml"
      return 4 ;;
    *)
      GATE_SUITE_STATUS="indisponivel"
      GATE_SUITE_DETALHE="pytest saiu $rc_pytest (uso/coleta/timeout) — nao medido; ver $saida"
      rm -f "$xml"
      return 5 ;;
  esac
}

# `release estado <familia>` mostra o ultimo veredito do gate (card #3150, "Tempo":
# em andamento | passou | barrou <teste>) — gravado aqui, lido la. Chave do sha:
# gate de uma rev que nao chegou a vingar (ensaio, ou promocao que falhou antes do
# gate) nao se confunde com o gate da rev que de fato esta no ar.
gravar_ultimo_gate() {  # $1=repo $2=sha
  local repo="$1" sha="$2" tmp
  local arq="$PONTOS/$repo/ultimo-gate.json"  # "local a=$1 b=$a" nao ve o $a recem-declarado: precisa de outro local
  mkdir -p "$(dirname "$arq")" 2>/dev/null || true
  tmp="$(mktemp "$(dirname "$arq")/.tmp.XXXXXX" 2>/dev/null)" || return 0
  printf '{"sha": "%s", "suite": "%s", "detalhe": "%s", "ambiente": "%s", "quando": "%s"}\n' \
    "$sha" "$GATE_SUITE_STATUS" "$(printf '%s' "$GATE_SUITE_DETALHE" | tr -d '"\\')" \
    "$GATE_AMBIENTE_CHAVE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp" 2>/dev/null \
    && mv -f "$tmp" "$arq" 2>/dev/null
}

ler_ultimo_gate() {  # $1=repo $2=sha_no_ar ; imprime uma linha resumida, ou nada
  local repo="$1" sha_ar="$2"
  local arq="$PONTOS/$repo/ultimo-gate.json"
  [ -f "$arq" ] || return 0
  local gsha gsuite gdet
  gsha="$(sed -n 's/.*"sha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$arq" 2>/dev/null | head -n 1)"
  gsuite="$(sed -n 's/.*"suite"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$arq" 2>/dev/null | head -n 1)"
  gdet="$(sed -n 's/.*"detalhe"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$arq" 2>/dev/null | head -n 1)"
  [ -n "$gsuite" ] || return 0
  local marca=""
  [ "$gsha" = "$sha_ar" ] || marca=" (medido numa rev que nao ficou no ar: ${gsha:0:7})"
  case "$gsuite" in
    verde) printf 'passou%s' "$marca" ;;
    vermelho) printf 'barrou: %s%s' "$gdet" "$marca" ;;
    *) printf '%s%s' "$gsuite" "$marca" ;;
  esac
}

# ---- estágio 4 (card #3150): card pelo PR do sha, cliente simples de tarefas ----
# Trava do card: a particao promover x rastreador esta com o arquiteto (fila); SEM
# resposta, este estagio implementa o caminho simples (release chama tarefas direto)
# e o comentario no card diz que a particao ainda pode mudar isso depois. Nunca
# bloqueia a promocao: gh ou tarefas ausente, ou ramo sem card (nao fabrica/<n>-...),
# so pula o estagio com um aviso.
resolver_card_do_sha() {  # $1=repo $2=sha ; imprime NNNN (o card) ou nada, 1 se nao achou
  local repo="$1" sha="$2" url owner_repo ramo
  command -v gh >/dev/null 2>&1 || return 1
  url="$(url_da_familia "$repo" 2>/dev/null)" || return 1
  [ -n "$url" ] || return 1
  # so sabe ler PR de forge no github.com; outro forge sai do mesmo jeito que gh ausente
  owner_repo="$(printf '%s' "$url" | sed -n 's#.*github\.com[:/]\([^/]*/[^/.]*\)\(\.git\)\{0,1\}/*$#\1#p')"
  [ -n "$owner_repo" ] || return 1
  ramo="$(gh api "repos/$owner_repo/commits/$sha/pulls" --jq '.[0].head.ref // empty' 2>/dev/null)" || return 1
  case "$ramo" in
    fabrica/[0-9]*-*)
      printf '%s' "${ramo#fabrica/}" | sed -n 's/^\([0-9]\{1,\}\)-.*/\1/p'
      return 0 ;;
    *) return 1 ;;
  esac
}

estagio_card() {  # $1=repo $2=sha_de(ou vazio) $3=sha_para
  local repo="$1" de="$2" para="$3" card tarefas_bin release_bin
  card="$(resolver_card_do_sha "$repo" "$para")" || {
    printf 'card:      ramo do PR nao e fabrica/<card>-... (ou gh/registro indisponivel) — estagio 4 pulado\n'
    return 0
  }
  [ -n "$card" ] || { printf 'card:      PR sem ramo fabrica/<card>-... — estagio 4 pulado\n'; return 0; }
  tarefas_bin="$(achar_verbo tarefas)"
  if [ -z "$tarefas_bin" ]; then
    printf 'card:      %s promovido (%s -> %s), mas tarefas nao encontrado — comente e mova a mao\n' "$card" "$(curto_ou "$de" '(novo)')" "${para:0:7}" >&2
    return 0
  fi
  "$tarefas_bin" comentar "$card" <<<"release promover $repo: $(curto_ou "$de" '(novo)') -> ${para:0:7}, gate de verbo verde. Estagio 4 (card #3150) como cliente simples de tarefas — pendente da particao promover x rastreador com o arquiteto; comentario e movimento podem vir a mudar de dono." >/dev/null 2>&1
  "$tarefas_bin" mover "$card" em-homologacao >/dev/null 2>&1
  printf 'card:      %s comentado e movido para em-homologacao (estagio 4, cliente simples — pendente de particao)\n' "$card"
  release_bin="$(achar_verbo release)"
  [ -n "$release_bin" ] && "$release_bin" conferir card "$card" >/dev/null 2>&1
  return 0
}

# NOTA (arq:0110 item 11c): nao ha mais reversao automatica de current na recusa de
# stack. current e stack sao planos separados; stack que recusa vira incidente e o
# current fica onde o gate o pos. A volta deliberada e `release reverter <repo> <sha>`.

# ---- estagio 3: conferencia no ar (card #3150) ----------------------------------
# Cada stack que a promocao recriou passa por `conferir servico <stack>` do proprio sha
# (projeto do compose; procedencia = current). Container ainda subindo nao e vermelho:
# ate 6 tentativas, 3 s entre elas. Familia sem stack nao tem o que conferir aqui (os
# verbos ja foram medidos na rev pelo gate, e o servido e a mesma arvore).
# PF_RELEASE_CONFERENCIA_AR=<executavel>: gancho de teste que faz as vezes da conferencia
# (0 conforme, 1 vermelho, 5 nao olhou); a primeira linha que ele imprime vira o detalhe.
CONF_AR_DETALHE=""
conferencia_no_ar() {  # $1=repo $2=sha ; 0 conforme ou nada a conferir · 1 vermelho · 5 nao olhou
  local repo="$1" sha="$2" rc=0 st rc_st tent out ok=()
  CONF_AR_DETALHE=""
  if [ -n "${PF_RELEASE_CONFERENCIA_AR:-}" ]; then
    out="$("$PF_RELEASE_CONFERENCIA_AR" "$repo" "$sha" 2>&1)" || rc=$?
    CONF_AR_DETALHE="$(printf '%s' "$out" | head -n 1)"
    case "$rc" in 0|5) return "$rc" ;; *) return 1 ;; esac
  fi
  [ "${#STACKS_PROMOVER[@]}" -gt 0 ] || return 0
  local impl="$PROD_RAIZ/$repo/$sha/bin/_release/conferir/conferir.py"
  [ -f "$impl" ] || { CONF_AR_DETALHE="rev ${sha:0:7} sem bin/_release/conferir"; return 5; }
  for st in "${STACKS_PROMOVER[@]}"; do
    rc_st=1
    for tent in 1 2 3 4 5 6; do
      out="$(PF_RELEASE_RAIZ="$PROD_RAIZ" python3 "$impl" servico "$st" 2>/dev/null)"; rc_st=$?
      [ "$rc_st" -eq 0 ] && break
      [ "$tent" -lt 6 ] && sleep 3
    done
    case "$rc_st" in
      0) ok+=("$st") ;;
      5) CONF_AR_DETALHE="servico $st: nao consegui olhar"; rc=5 ;;
      *)
        CONF_AR_DETALHE="servico $st: $(printf '%s\n' "$out" | grep -E 'nenhum container|^[[:space:]]+(DERIVA|SUMIU|EDITADO|ENV)|^[[:space:]]{8}' | head -n 1 | sed 's/^[[:space:]]*//')"
        return 1 ;;
    esac
  done
  [ "$rc" -ne 0 ] || CONF_AR_DETALHE="servico ${ok[*]} conforme"
  return "$rc"
}

comentar_incidente_no_card() {  # $1=repo $2=sha $3=texto ; nunca derruba a promocao
  local card tarefas_bin
  card="$(resolver_card_do_sha "$1" "$2")" || return 0
  [ -n "$card" ] || return 0
  tarefas_bin="$(achar_verbo tarefas)"
  [ -n "$tarefas_bin" ] || return 0
  "$tarefas_bin" comentar "$card" <<<"release promover $1 ${2:0:7}: INCIDENTE — $3" >/dev/null 2>&1 || true
  return 0
}

# ---- retorno de promover numa tela (card #3150, spec_ambiente-de-desenvolvimento §3) ----
# Tela: veredito e estagio (linhas gate:/suite:), familia e sha de -> para (== / de: /
# current:), ambiente, venvs, card, a linha da volta e a alca do log. Recusa e parada vao
# ao stderr, como antes. O resto (docker build, conferir por extenso, atalhos, abertura,
# restart) fica no log.
PROMO_LOG=""; PROMO_VOLTA=""
abrir_log_promover() {  # $1=repo
  [ "${PF_PROMOVER_VERBOSO:-0}" = 1 ] && return 0
  local dir="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/log/release-promover"
  mkdir -p "$dir" 2>/dev/null || return 0
  local arq; arq="$dir/$(date -u +%Y%m%dT%H%M%SZ)-$1-$$.log"
  : >"$arq" 2>/dev/null || return 0
  PROMO_LOG="$arq"
  exec 3>&1 4>&2 >>"$PROMO_LOG" 2>&1
  trap 'resumo_promover $?' EXIT
}

resumo_promover() {  # $1=exit
  local rc="$1"
  resumo_imprime
  exit "$rc"
}

# Imprime a tela e devolve stdout/stderr ao chamador. Idempotente: a segunda chamada
# (o trap de EXIT depois de reiniciar_porta) nao faz nada.
resumo_imprime() {
  [ -n "$PROMO_LOG" ] || return 0
  local sha_final log="$PROMO_LOG"
  PROMO_LOG=""
  trap - EXIT
  exec 1>&3 2>&4 3>&- 4>&-
  PROMO_LOG="$log"
  [ -f "$PROMO_LOG" ] || { PROMO_LOG=""; return 0; }
  # grep sem casamento sai 1: com set -e/pipefail isso mataria o resumo e trocaria o exit
  { grep -E '^(== |de: |gate: |venv: |current: |no ar: |ambiente: |suite: |card: |ensaio: |já no ar: )' "$PROMO_LOG" \
      | grep -v 'NAO MEDIDA'; } || true
  # "release: /opt/..." e o eco do deploy da stack, nao recusa: fica no log
  { grep -E '^(release: |varrido: |saida inteira: )|NAO MEDIDA|PROMOCAO|RETOMAR|VOLTAR CODIGO' "$PROMO_LOG" \
      | grep -v '^release: /'; } >&2 || true
  [ -z "$PROMO_VOLTA" ] || printf 'volta:     %s\n' "$PROMO_VOLTA"
  printf 'log:       %s\n' "$PROMO_LOG"
  sha_final="$(grep -E '^[0-9a-f]{40}$' "$PROMO_LOG" | tail -n 1)" || sha_final=""
  [ -z "$sha_final" ] || printf '%s\n' "$sha_final"
  PROMO_LOG=""
  return 0
}

# ---- ato: promover <repo> [<rev>] [--ensaio] --------------------------------------
cmd_promover() {
  local ensaio=0 so_caderno=0 repo="" rev="" aceitar_suite=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --ensaio) ensaio=1; shift ;;
      --so-caderno) so_caderno=1; shift ;;
      --aceitar-suite-indisponivel) aceitar_suite=1; shift ;;
      -*) printf 'release: erro: opção desconhecida: %s\n' "$1" >&2; uso_texto; exit 2 ;;
      *)
        if [ -z "$repo" ]; then repo="$1"
        elif [ -z "$rev" ]; then rev="$1"
        else printf 'release: erro: argumento extra: %s\n' "$1" >&2; uso_texto; exit 2; fi
        shift ;;
    esac
  done
  [ -n "$repo" ] || { printf 'release: erro: repo obrigatório para promover\n' >&2; uso_texto; exit 2; }
  validar_repo_ou_sair "$repo"
  if [ "$so_caderno" -eq 1 ] && [ "$repo" != "abertura" ]; then
    printf 'release: erro: --so-caderno so existe em release promover abertura\n' >&2; exit 2
  fi
  if [ "$repo" = "abertura" ]; then
    local rc_fam=0
    if [ "$so_caderno" -eq 1 ]; then
      [ -z "$rev" ] || { printf 'release: erro: --so-caderno nao aceita rev explicita (sempre origin/main)\n' >&2; exit 2; }
      promover_abertura_so_caderno "$ensaio" || rc_fam=$?
    else
      promover_abertura "$rev" "$ensaio" || rc_fam=$?
    fi
    exit "$rc_fam"
  fi

  # card #3150 (retorno numa tela, comentario C3): tudo o que a esteira imprime -- build,
  # conferir por extenso, atalhos, restart -- vai ao log da instancia; a tela recebe so as
  # linhas-chave, a volta e a alca do log, montadas no fim por resumo_promover (trap).
  # PF_PROMOVER_VERBOSO=1 devolve a saida inteira na tela.
  abrir_log_promover "$repo"

  # regime: família com stack no registro promove por rev explícita
  local rc=0
  ler_stacks_da_familia "$repo" || { rc=$?; exit "$rc"; }
  local tem_stack=$(( ${#STACKS_PROMOVER[@]} + ${#STACKS_FORA[@]} ))
  if [ "$tem_stack" -gt 0 ] && [ -z "$rev" ]; then
    printf 'release: erro: %s é família de código (stacks: %s) e promove por rev explícita: release promover %s <sha|tag>\n' \
      "$repo" "${STACKS_PROMOVER[*]} ${STACKS_FORA[*]}" "$repo" >&2
    exit 2
  fi

  garantir_espelho "$repo" "$ensaio" || { rc=$?; exit "$rc"; }
  local esp; esp="$(espelho_de "$repo")"
  if [ ! -d "$esp" ]; then
    # só em ensaio de família nova
    printf 'ensaio:    família nova; nada resolvido sem espelho\n'
    exit 0
  fi

  local sha
  sha="$(resolver_rev "$repo" "$rev")" || {
    # card #3150 comentario C7: com o fetch de garantir_espelho ja feito (inclusive
    # em ensaio, desde a correcao acima), rev que ainda nao resolve e "nao existe
    # (por ora)", nao erro de uso — exit 1 (varrido), nao 2. O espelho acabou de
    # ser atualizado, entao nao ha fetch a mais para tentar aqui.
    printf 'varrido:   %s no espelho de %s (fetch feito agora, sem achar)\n' "${rev:-origin/main}" "$repo" >&2
    printf 'tags recentes:\n' >&2
    "$GIT" --git-dir="$esp" for-each-ref --sort=-creatordate --count=5 --format='  %(refname:short)  %(objectname:short)' refs/tags 2>/dev/null >&2 || true
    exit 1
  }
  exigir_descende_de_main "$repo" "$sha" promover "$repo" || exit $?

  # o que está no ar agora
  local atual="" rc_id=0
  resolver_identidade "$repo" || rc_id=$?
  case "$rc_id" in
    0) atual="$SHA" ;;
    1) atual="" ;;
    2) atual="" ;;   # família nova: diretório recém-criado pelo espelho
    *) printf 'release: indeterminável: %s — arrume antes de promover\n' "$RESOLVER_MOTIVO" >&2; exit 5 ;;
  esac

  if [ "$atual" = "$sha" ]; then
    printf 'já no ar:  %s current → %s — nada a mover\n' "$repo" "${sha:0:7}"
    exit 1
  fi

  local tag; tag="$("$GIT" --git-dir="$esp" describe --tags --exact-match "$sha" 2>/dev/null || echo '')"
  printf '== release promover %s %s%s ==\n' "$repo" "${sha:0:7}" "${tag:+ ($tag)}"
  printf 'de:        %s\n' "$(curto_ou "$atual" '(sem current)')"
  if [ -d "$PROD_RAIZ/$repo/$sha" ]; then printf 'checkout:  %s já materializado (imutável, não reescrito)\n' "${sha:0:7}"
  else printf 'checkout:  materializar %s/%s/%s\n' "$PROD_RAIZ" "$repo" "$sha"; fi
  [ "${#STACKS_PROMOVER[@]}" -eq 0 ] || printf 'stacks:    %s (deploy promover)\n' "${STACKS_PROMOVER[*]}"
  [ "${#STACKS_FORA[@]}" -eq 0 ]     || printf 'stacks:    fora da promoção por release — reversão declarada por outra via (deploy <stack> up): %s\n' "${STACKS_FORA[*]}"
  if [ "$ensaio" -eq 1 ]; then
    printf 'ensaio:    nada tocado\n'
    exit 0
  fi

  exigir_deploy_se_stack || { rc=$?; exit "$rc"; }
  materializar "$repo" "$sha" || { rc=$?; exit "$rc"; }
  materializar_terceiros "$repo" "$sha" || { rc=$?; exit "$rc"; }
  local rc_suite=0
  gate_suite_verdes "$repo" "$sha" || rc_suite=$?
  if [ "$rc_suite" -eq 5 ] && [ "$aceitar_suite" -eq 1 ]; then
    GATE_SUITE_STATUS="nao-medida"
    GATE_SUITE_DETALHE="subiu por --aceitar-suite-indisponivel: $GATE_SUITE_DETALHE"
    printf 'suite:     NAO MEDIDA — %s\n' "$GATE_SUITE_DETALHE" >&2
  elif [ "$rc_suite" -ne 0 ]; then
    gravar_ultimo_gate "$repo" "$sha"
    if [ "$rc_suite" -eq 5 ]; then
      printf 'release: recusa: nao consegui medir a suite VERDES da rev %s: %s — current segue em %s; conserte e promova de novo, ou suba declarando --aceitar-suite-indisponivel\n' \
        "${sha:0:7}" "$GATE_SUITE_DETALHE" "$(curto_ou "$atual" '(nenhum)')" >&2
    else
      printf 'release: recusa: rev %s reprova na suite VERDES: %s — current segue em %s\n' \
        "${sha:0:7}" "$GATE_SUITE_DETALHE" "$(curto_ou "$atual" '(nenhum)')" >&2
    fi
    [ -n "$GATE_SUITE_LOG" ] && printf 'saida inteira: %s\n' "$GATE_SUITE_LOG" >&2
    exit "$rc_suite"
  fi
  gravar_ultimo_gate "$repo" "$sha"
  gate_conferir_verbo "$repo" "$sha" "$atual" || { rc=$?; exit "$rc"; }
  construir_venvs "$repo" "$sha" || { rc=$?; exit "$rc"; }
  gravar_pontos "$repo" "$atual" "$sha"
  trocar_current "$repo" "$sha" "$atual"
  printf 'current:   %s → %s\n' "$(curto_ou "$atual" '(nenhum)')" "${sha:0:7}"
  [ -z "$atual" ] || PROMO_VOLTA="release reverter $repo ${atual:0:7}"
  assentar_atalhos "$repo"
  local rc_ab=0
  publicar_abertura_da_familia "$repo" "$sha" || rc_ab=$?

  local rc_st=0
  promover_stacks "$sha" || rc_st=$?
  if [ "$rc_st" -ne 0 ]; then
    # ESTADO PARTIDO (arq:0110 item 11c): o current (codigo dos verbos) ja trocou e
    # passou o gate; foi a stack (containers) que recusou. NAO se reverte o current —
    # fatiar o codigo bom por falha de container e desfazer trabalho valido. O current
    # FICA no sha novo, a stack vira incidente separado, e o relato GRITA exatamente
    # onde partiu: codigo no ar em X, stack Y atras, containers rodando o codigo velho.
    # gravar_pontos mantem 'atual' = sha novo (o current de fato no ar) e 'anterior' =
    # o sha de onde saiu, para o reverter deliberado ter para onde voltar.
    gravar_pontos "$repo" "$atual" "$sha"
    {
      printf '\n'
      printf '=========================================================================\n'
      printf 'PROMOCAO PARCIAL — ESTADO PARTIDO, LEIA (release %s)\n' "$repo"
      printf '=========================================================================\n'
      printf '  codigo (current): NO AR em %s%s — verbos ja servem esta rev\n' "${sha:0:7}" "${tag:+ ($tag)}"
      printf '  stack recusada  : %s — NAO subiu; seus containers seguem no codigo ANTERIOR (%s)\n' "$STACK_FALHOU" "$(curto_ou "$atual" 'nenhum')"
      if [ "${#STACKS_PROMOVER[@]}" -gt 1 ]; then
        printf '  demais stacks   : as listadas antes de %s ja foram promovidas; as depois, nao\n' "$STACK_FALHOU"
      fi
      if [ -n "${STACK_MOTIVO:-}" ]; then
        printf '  motivo (deploy %s):\n' "$STACK_FALHOU"
        printf '%s\n' "$STACK_MOTIVO" | sed 's/^/    /'
      fi
      printf '  RETOMAR         : conserte a causa acima e rode  deploy %s promover %s\n' "$STACK_FALHOU" "${sha:0:7}"
      printf '  VOLTAR CODIGO   : release reverter %s %s  (devolve o current; a stack ainda depende do deploy subir)\n' "$repo" "$(curto_ou "$atual" '<sha-anterior>')"
      printf '=========================================================================\n'
    } >&2
    reiniciar_porta "$repo"
    exit "$rc_st"
  fi

  # Estagio 3 (spec_ambiente-de-desenvolvimento §3; card #3150, comentario C5):
  # conferencia no ar. Vermelho -> volta automatica ao sha anterior, current relido;
  # so se declara "revertido" com current relido igual ao anterior. Nao olhou (5) ->
  # declara e nao reverte: volta por medicao que nao aconteceu e tao cega quanto subir.
  local rc_ar=0
  conferencia_no_ar "$repo" "$sha" || rc_ar=$?
  case "$rc_ar" in
    0) [ -z "$CONF_AR_DETALHE" ] || printf 'no ar:     conferido — %s\n' "$CONF_AR_DETALHE" ;;
    5) printf 'no ar:     conferencia nao olhou (%s) — sem volta automatica; confira: release conferir servico\n' "$CONF_AR_DETALHE" ;;
    *)
      if [ -z "$atual" ]; then
        printf 'release: conferencia no ar VERMELHA (%s) e nao ha sha anterior para voltar — incidente\n' "$CONF_AR_DETALHE" >&2
        reiniciar_porta "$repo"
        exit 4
      fi
      printf 'release: conferencia no ar VERMELHA na rev %s: %s — voltando a %s\n' "${sha:0:7}" "$CONF_AR_DETALHE" "${atual:0:7}" >&2
      # restart da porta desligado no filho: quem reinicia e este processo, depois da tela
      PF_RELEASE_PORTA=0 "$AQUI/release" reverter "$repo" "$atual" || true
      local depois="" rc_id2=0
      resolver_identidade "$repo" || rc_id2=$?
      [ "$rc_id2" -eq 0 ] && depois="$SHA"
      if [ "$depois" = "$atual" ]; then
        PROMO_VOLTA=""
        printf 'release: revertido: current de %s relido em %s; a rev %s nao ficou no ar\n' "$repo" "${atual:0:7}" "${sha:0:7}" >&2
        comentar_incidente_no_card "$repo" "$sha" \
          "conferencia no ar vermelha ($CONF_AR_DETALHE); revertido automaticamente a ${atual:0:7}, current relido"
        reiniciar_porta "$repo"
        exit 4
      fi
      printf 'release: INCIDENTE — a volta automatica falhou: current de %s esta em %s, nao em %s; volte a mao: release reverter %s %s\n' \
        "$repo" "$(curto_ou "$depois" 'ilegivel')" "${atual:0:7}" "$repo" "${atual:0:7}" >&2
      comentar_incidente_no_card "$repo" "$sha" \
        "conferencia no ar vermelha ($CONF_AR_DETALHE) e a volta automatica FALHOU; current em $(curto_ou "$depois" 'ilegivel')"
      reiniciar_porta "$repo"
      exit 5 ;;
  esac

  printf 'no ar:     %s %s%s\n' "$repo" "${sha:0:7}" "${tag:+ ($tag)}"
  [ -z "$GATE_AMBIENTE_CHAVE" ] || printf 'ambiente:  %s (%s%s)\n' "$GATE_AMBIENTE_CHAVE" "$GATE_AMBIENTE_STATUS" "${GATE_AMBIENTE_SEGUNDOS:+, ${GATE_AMBIENTE_SEGUNDOS}s}"
  if [ -n "$GATE_SUITE_STATUS" ] && [ "$GATE_SUITE_STATUS" != "n/a" ]; then
    printf 'suite:     %s%s\n' "$GATE_SUITE_STATUS" "${GATE_SUITE_DETALHE:+ ($GATE_SUITE_DETALHE)}"
  fi
  if [ "$rc_ab" -ne 0 ]; then
    printf 'release: PROMOCAO PARCIAL — codigo no ar em %s, abertura NAO publicada; retomar: release promover abertura %s\n' "${sha:0:7}" "${sha:0:7}" >&2
    reiniciar_porta "$repo"
    exit 5
  fi
  estagio_card "$repo" "$atual" "$sha"
  reiniciar_porta "$repo"
  printf '%s\n' "$sha"
}

# ---- ato: reverter <repo> [<rev>] [--ensaio] --------------------------------------
cmd_reverter() {
  local ensaio=0 repo="" rev=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ensaio) ensaio=1; shift ;;
      --executar) printf 'release: aviso: --executar é o comportamento padrão de reverter; flag ignorada\n' >&2; shift ;;
      -*) printf 'release: erro: opção desconhecida: %s\n' "$1" >&2; uso_texto; exit 2 ;;
      *)
        if [ -z "$repo" ]; then repo="$1"
        elif [ -z "$rev" ]; then rev="$1"
        else printf 'release: erro: argumento extra: %s\n' "$1" >&2; uso_texto; exit 2; fi
        shift ;;
    esac
  done
  [ -n "$repo" ] || { printf 'release: erro: repo obrigatório para reverter\n' >&2; uso_texto; exit 2; }
  validar_repo_ou_sair "$repo"
  if [ "$repo" = "abertura" ]; then
    local rc_fam=0
    reverter_abertura "$rev" "$ensaio" || rc_fam=$?
    exit "$rc_fam"
  fi
  [ -d "$PROD_RAIZ/$repo" ] || recusar_familia_desconhecida "$repo"

  local rc=0 atual="" rc_id=0
  resolver_identidade "$repo" || rc_id=$?
  case "$rc_id" in
    0) atual="$SHA" ;;
    1) atual="" ;;
    *) printf 'release: indeterminável: %s — arrume antes de reverter\n' "$RESOLVER_MOTIVO" >&2; exit 5 ;;
  esac

  local alvo=""
  if [ -n "$rev" ]; then
    if is_hex_sha "$rev"; then
      alvo="$rev"   # sha completo: reverter não precisa do forge; materializado ou não decide abaixo
    else
      local esp; esp="$(espelho_de "$repo")"
      if [ -d "$esp" ]; then alvo="$(resolver_rev "$repo" "$rev" 2>/dev/null || true)"; fi
      if [ -z "$alvo" ]; then
        printf 'release: erro: rev '\''%s'\'' não resolve para %s\n' "$rev" "$repo" >&2
        exit 2
      fi
    fi
  else
    alvo="$(ponto_de_volta "$repo")"
    if ! is_hex_sha "$alvo"; then
      printf 'release: erro: sem rev e sem ponto de volta gravado para %s — não invento para onde voltar\n' "$repo" >&2
      printf 'materializados em %s/%s:\n' "$PROD_RAIZ" "$repo" >&2
      for d in "$PROD_RAIZ/$repo"/*/; do
        b="$(basename "$d")"; is_hex_sha "$b" && printf '  %s\n' "${b:0:7}" >&2
      done
      exit 2
    fi
  fi

  # política antes de existência: sha fora de main não se serve nem se sugere promover
  local rc_main=0
  exigir_descende_de_main "$repo" "$alvo" reverter "$repo" || rc_main=$?
  if [ "$rc_main" -ne 0 ]; then
    [ -n "$rev" ] || printf 'medido: o ponto de volta gravado de %s é anterior ao gate — voltar a ele reabriria a violação\n' "$repo" >&2
    exit "$rc_main"
  fi
  if [ ! -d "$PROD_RAIZ/$repo/$alvo" ]; then
    printf 'varrido: servido %s (%s/%s não está materializado)\n' "$repo" "$PROD_RAIZ/$repo" "${alvo:0:7}" >&2
    printf 'vizinho: release promover %s %s\n' "$repo" "$alvo" >&2
    exit 1
  fi
  if [ "$atual" = "$alvo" ]; then
    printf 'já no ar:  %s current → %s — nada a mover\n' "$repo" "${alvo:0:7}"
    exit 1
  fi

  ler_stacks_da_familia "$repo" || { rc=$?; exit "$rc"; }

  printf '== release reverter %s %s → %s ==\n' "$repo" "$(curto_ou "$atual" '(sem current)')" "${alvo:0:7}"
  [ "${#STACKS_PROMOVER[@]}" -eq 0 ] || printf 'stacks:    %s (deploy promover %s)\n' "${STACKS_PROMOVER[*]}" "${alvo:0:7}"
  [ "${#STACKS_FORA[@]}" -eq 0 ]     || printf 'stacks:    fora da reversão por release — reversão declarada por outra via (deploy <stack> up): %s\n' "${STACKS_FORA[*]}"
  if [ "$ensaio" -eq 1 ]; then
    printf 'ensaio:    nada tocado\n'
    exit 0
  fi

  exigir_deploy_se_stack || { rc=$?; exit "$rc"; }
  materializar_terceiros "$repo" "$alvo" || { rc=$?; exit "$rc"; }
  construir_venvs "$repo" "$alvo" || { rc=$?; exit "$rc"; }
  gravar_pontos "$repo" "$atual" "$alvo"
  trocar_current "$repo" "$alvo" "$atual"
  printf 'current:   %s → %s\n' "$(curto_ou "$atual" '(nenhum)')" "${alvo:0:7}"
  assentar_atalhos "$repo"
  local rc_ab=0
  publicar_abertura_da_familia "$repo" "$alvo" || rc_ab=$?

  local rc_st=0
  promover_stacks "$alvo" || rc_st=$?
  if [ "$rc_st" -ne 0 ]; then
    # ESTADO PARTIDO (arq:0110 item 11c), simetrico ao promover: o current ja voltou
    # para o alvo (codigo revertido no ar) e foi a stack que recusou a recriacao. NAO
    # se re-troca o current para frente — isso desfaria a reversao que o operador pediu,
    # justo quando ele volta por algo quebrado. O current FICA no alvo, a stack vira
    # incidente, e o relato GRITA onde partiu.
    gravar_pontos "$repo" "$atual" "$alvo"
    {
      printf '\n'
      printf '=========================================================================\n'
      printf 'REVERSAO PARCIAL — ESTADO PARTIDO, LEIA (release %s)\n' "$repo"
      printf '=========================================================================\n'
      printf '  codigo (current): REVERTIDO e no ar em %s — verbos ja servem esta rev\n' "${alvo:0:7}"
      printf '  stack recusada  : %s — NAO recriou; seus containers seguem em %s\n' "$STACK_FALHOU" "$(curto_ou "$atual" 'estado anterior')"
      if [ -n "${STACK_MOTIVO:-}" ]; then
        printf '  motivo (deploy %s):\n' "$STACK_FALHOU"
        printf '%s\n' "$STACK_MOTIVO" | sed 's/^/    /'
      fi
      printf '  RETOMAR         : conserte a causa acima e rode  deploy %s promover %s\n' "$STACK_FALHOU" "${alvo:0:7}"
      printf '=========================================================================\n'
    } >&2
    reiniciar_porta "$repo"
    exit "$rc_st"
  fi

  printf 'no ar:     %s %s\n' "$repo" "${alvo:0:7}"
  if [ "$rc_ab" -ne 0 ]; then
    printf 'release: REVERSAO PARCIAL — codigo no ar em %s, abertura NAO acompanhou; retomar: release reverter abertura %s\n' "${alvo:0:7}" "${alvo:0:7}" >&2
    reiniciar_porta "$repo"
    exit 5
  fi
  reiniciar_porta "$repo"
  printf '%s\n' "$alvo"
}

# Se nenhum argumento passado, imprime usage e sai 2
if [ $# -eq 0 ]; then
  uso
fi

# Tratamento universal de --ajuda / -h / --help
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

cmd="$1"
shift

case "$cmd" in
  estado)   cmd_estado "$@" ;;
  listar)   cmd_listar "$@" ;;
  ler)      cmd_ler "$@" ;;
  procurar) cmd_procurar "$@" ;;
  conferir) cmd_conferir "$@" ;;
  promover) cmd_promover "$@" ;;
  reverter) cmd_reverter "$@" ;;
  *)
    printf 'release: erro: ato desconhecido '\''%s'\''\n' "$cmd" >&2
    printf 'atos: estado · listar · ler · procurar · conferir · promover · reverter\n' >&2
    uso_texto
    exit 2
    ;;
esac
