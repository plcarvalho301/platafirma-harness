#!/usr/bin/env bash
# limpeza-quarentena — apaga levas de quarentena que passaram da janela de arrependimento.
# Sub-ato de `infra` (arq:0110 §14, emenda 26/09/2026 — card #3145): fora do PATH e do
# golden record, mora em bin/_infra/. Chamado por `infra limpeza quarentena [args]`, nunca
# direto; o cron do claudinho, sextas de madrugada, passa a chamar `infra limpeza
# quarentena` (ex-bin/quarentena-prune, movido daqui — a agenda do cron muda em PR de
# platafirma-core).
#
# A quarentena existe para que apagar seja reversivel: o que entra la foi movido,
# nao removido, e volta com um mv enquanto a leva viver. Este verbo e o fim dessa
# janela — sem ele a quarentena vira acumulo, que e o defeito oposto.
#
# Apaga LEVA (subdiretorio datado), nunca a raiz: leva quarentenada ontem sobrevive
# a poda de amanha. Sem o corte de idade, rodar na sexta daria 1 dia de janela a
# quem quarentenou na quinta, e a garantia deixaria de existir.
set -uo pipefail
# ambiente: PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] · QUARENTENA_RETENCAO_DIAS[=7]

# Raizes de producao (card #3010): quarentena, trava e log moram na instancia. Este
# script mora em bin/_infra/, um nivel abaixo de bin/ — raizes.sh fica dois niveis acima.
. "$(dirname "$(readlink -f "$0")")/../../lib/raizes.sh"

RETENCAO_DIAS="${QUARENTENA_RETENCAO_DIAS:-7}"
QUARENTENA="$PLATAFIRMA_INSTANCIA/var/quarentena"
MARCA="$PLATAFIRMA_INSTANCIA/var/log/poda.log"
TRAVA="$PLATAFIRMA_INSTANCIA/var/lock/quarentena-prune.lock"

ts() { date -Is; }
mkdir -p "$(dirname "$MARCA")" "$(dirname "$TRAVA")"

# Trava: sessao concorrente nao pode apagar a mesma leva duas vezes.
exec 9>"$TRAVA"
if ! flock -n 9; then
  echo "$(ts) limpeza-quarentena: outra execucao em curso, saindo" >> "$MARCA"
  exit 0
fi

[ -d "$QUARENTENA" ] || { echo "$(ts) limpeza-quarentena: sem $QUARENTENA, nada a fazer" >> "$MARCA"; exit 0; }
# O cinto abaixo compara com readlink -f: a raiz tambem sai canonica, senao um symlink
# no caminho da instancia faria recusar toda leva.
QUARENTENA="$(readlink -f "$QUARENTENA")"

total=0
bytes=0
while IFS= read -r leva; do
  [ -n "$leva" ] || continue
  # Cinto de seguranca: so apaga o que resolve para dentro da quarentena.
  real=$(readlink -f "$leva")
  case "$real" in
    "$QUARENTENA"/*) : ;;
    *) echo "$(ts) limpeza-quarentena: RECUSADO fora da quarentena: $real" >> "$MARCA"; continue ;;
  esac
  b=$(du -sb "$real" 2>/dev/null | cut -f1)
  b="${b:-0}"
  if rm -rf -- "$real"; then
    total=$((total + 1))
    bytes=$((bytes + b))
    echo "$(ts) limpeza-quarentena: apagada leva $(basename "$real") (${b} bytes)" >> "$MARCA"
  else
    echo "$(ts) limpeza-quarentena: FALHOU ao apagar $real" >> "$MARCA"
  fi
done < <(find "$QUARENTENA" -mindepth 1 -maxdepth 1 -type d -mtime "+$RETENCAO_DIAS" 2>/dev/null)

echo "$(ts) limpeza-quarentena: $total leva(s), $bytes bytes, retencao ${RETENCAO_DIAS}d" >> "$MARCA"
