#!/usr/bin/env bash
# limpeza-logs — poda o registro de operação por retenção declarada.
# Sub-ato de `infra` (arq:0110 §14, emenda 26/09/2026 — card #3145): fora do PATH e do
# golden record, mora em bin/_infra/. Chamado por `infra limpeza logs [args]`, nunca
# direto; o cron do claudinho, diariamente, passa a chamar `infra limpeza logs`
# (ex-bin/ops-log-prune, movido daqui — a agenda do cron muda em PR de platafirma-core).
# Não roda dentro do ops-mcp de propósito: processo que se auto-poda perde o log
# justamente quando morre.
set -uo pipefail
# ambiente: PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] · OPS_LOG_DIR[=$PLATAFIRMA_INSTANCIA/var/log/ops] · LONGJOB_LOGDIR[=$PLATAFIRMA_INSTANCIA/var/log/jobs] · OPS_LOG_RETENCAO_DIAS[=90]

# Raizes de producao (card #3010): os logs moram na instancia. Este script mora em
# bin/_infra/, um nivel abaixo de bin/ — raizes.sh fica dois niveis acima.
. "$(dirname "$(readlink -f "$0")")/../../lib/raizes.sh"

RETENCAO_DIAS="${OPS_LOG_RETENCAO_DIAS:-90}"
# O bruto da porta (var/log/ops) não está aqui: nenhum dia sai por idade antes da extração.
# Quem o corta é o timer com portão (#3354); nenhum verbo servido o apaga (arq:0123 §12).
OPS_DIR="${OPS_LOG_DIR:-$PLATAFIRMA_INSTANCIA/var/log/ops}"
ALVOS=(
  "${LONGJOB_LOGDIR:-$PLATAFIRMA_INSTANCIA/var/log/jobs}:*.log"
)
MARCA="$PLATAFIRMA_INSTANCIA/var/log/poda.log"

mkdir -p "$(dirname "$MARCA")"
ts() { date -Is; }

total=0
for alvo in "${ALVOS[@]}"; do
  dir="${alvo%%:*}"
  padrao="${alvo##*:}"
  [ -d "$dir" ] || continue
  # -mtime +N = modificado há mais de N dias completos
  n=$(find "$dir" -maxdepth 1 -type f -name "$padrao" -mtime "+$RETENCAO_DIAS" -print -delete | wc -l)
  total=$((total + n))
  [ "$n" -gt 0 ] && echo "$(ts) podados $n de $dir ($padrao, >$RETENCAO_DIAS dias)" >> "$MARCA"
done

# Linha de vida: grava mesmo quando não podou nada, para "o podador rodou" ser um
# fato observável e não uma suposição.
# O bruto só se conta, nunca se toca: ops-*.jsonl acima da retenção ficam no disco.
retido=0
if [ -d "$OPS_DIR" ]; then
  retido=$(find "$OPS_DIR" -maxdepth 1 -type f -name 'ops-*.jsonl' -mtime "+$RETENCAO_DIAS" -print | wc -l)
fi
echo "$(ts) poda ok — retencao=${RETENCAO_DIAS}d removidos=${total} · ops retido: ${retido} dias (corte do bruto é do timer, arq:0123 §12)" >> "$MARCA"

# O próprio log de poda não pode crescer para sempre: mantém as últimas 2000 linhas.
if [ "$(wc -l < "$MARCA")" -gt 2000 ]; then
  tail -n 1000 "$MARCA" > "$MARCA.tmp" && mv "$MARCA.tmp" "$MARCA"
fi
