#!/usr/bin/env bash
# migrar — aplica uma migracao SQL versionada num Postgres da stack, por stdin
# capacidade: infra/promocao-de-mudanca
# dono: ti
# componente: docker, psql
# use para: aplicar migracao de schema num contêiner Postgres da casa (rag, motor, ...)
# atos: aplicar (escrita, operacao), bancos (leitura, operacao)
# forma: texto
# cauda: nao
# classe: B
# consome: nenhum
# ambiente: PF_SUJEITO[obrigatória em aplicar] porta (identidade; sem fallback; entra na linha de log do ato quando presente) · PF_SESSAO porta (lida, chave do aviso de deprecado)
# depende: docker · o contêiner do banco (allowlist BANCOS) de pé · psql dentro do contêiner · a implementacao em bin/_release/migrar
# escreve: aplicar=schema do banco-alvo, via docker exec psql (nao e arquivo local; nao e segredo) · bancos=nada
# substitui: docker exec -i <ctr> psql -f - direto · psql -h ... -f <arquivo> direto no host
# deprecado: 2026-10-05 sucessor: release migrar (arq:0110 §1, §7, §11, card #3260)
# conforme: parcial
set -uo pipefail

AQUI="${BASH_SOURCE[0]%/*}"
[ "$AQUI" = "${BASH_SOURCE[0]}" ] && AQUI="."
IMPL="$AQUI/_release/migrar"
BASH_BIN="${BASH:-/bin/bash}"

avisa_deprecado() {  # uma vez por sessao (arq:0110 §11)
  local trava="/tmp/platafirma-avisos-${PF_SESSAO:-${USER:-default}}-migrar"
  if [ ! -f "$trava" ]; then
    : > "$trava" 2>/dev/null || true
    printf 'migrar: aviso: `migrar` está deprecado (arq:0110 §11); a forma conforme é `release migrar` (card #3260).\n' >&2
  fi
}

[ -f "$IMPL" ] || {
  printf 'migrar: dependência ausente: implementacao %s nao encontrada\n' "$IMPL" >&2
  exit 3
}

# Sem argumento nenhum ou --ajuda: despacha sem efeito colateral (Q2)
if [ $# -eq 0 ]; then
  export PF_VERBO_NOME="migrar"
  exec "$BASH_BIN" "$IMPL"
fi

for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h|ajuda)
      export PF_VERBO_NOME="migrar"
      exec "$BASH_BIN" "$IMPL" "$@"
      ;;
  esac
done

avisa_deprecado
export PF_VERBO_NOME="migrar"
exec "$BASH_BIN" "$IMPL" "$@"
