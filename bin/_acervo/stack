#!/usr/bin/env python3
# acervo stack — le e escreve a topologia de deploy na tabela acervo.stack.
# capacidade: conhecimento
# dono: claudinho-dados
#   (materia/semantica: claudinho-dados; a tabela e o golden record da topologia)
#
# `acervo stack ver [--json]`            le a tabela (mesma fonte do `listar topologia`)
# `acervo stack import <stacks.json>`    carrega o JSON pra tabela (upsert) — a ponte que
#                                        permite MATAR o stacks.json: importa, confere, apaga
# `acervo stack rm <slug>`               remove uma stack da tabela
#
# `import` e `rm` ESCREVEM. Sem eles a tabela so nasce por seed SQL na mao, e o
# stacks.json nao pode morrer porque e a unica porta de edicao. Este verbo e a porta:
# depois do import, a tabela E a fonte-verdade e o arquivo sai (arq:0076/0071).
#
# Serializacao FIEL (licao do #2703): rotas/gate/segredos/reversao/profiles entram como
# jsonb via to_jsonb do valor CRU (nunca embrulhar string que ja tem aspas); compose
# string OU lista, lista serializada como JSON (nao repr Python).
import json
import os
import signal
import subprocess
import sys

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"

USO = """uso:
  acervo stack ver [--json]           le a topologia da tabela acervo.stack
  acervo stack servicos <stack> [--json]  os servicos da stack: ficha de servico parte-de a ela, com a unit de cada um
  acervo stack resolver <unit>        `<stack>/<servico>` da unit, ou unit_sem_stack (exit 1)
  acervo stack import <stacks.json>   carrega o JSON pra tabela (upsert por slug) —
                                      a ponte pra matar o stacks.json
  acervo stack rm <slug>              remove a stack da tabela

Escreve em acervo.stack, o golden record da topologia de deploy. Depois de `import`
+ conferencia, o stacks.json pode ser apagado: a tabela vira a fonte, e o
`acervo listar topologia --completo` a serve ao deploy (arq:0076)."""


def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def _psql(sql, stdin=None):
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    cmd = ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-v", "ON_ERROR_STOP=1"]
    if stdin is None:
        cmd += ["-tAF|", "-c", sql]
    try:
        return subprocess.run(cmd, input=stdin if stdin is not None else None,
                              capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo stack: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo stack: psql falhou (rc=%s):\n%s" % (e.returncode, (e.stderr or "").strip()), 3)


def _lit_txt(v):
    return "null" if v is None else "'" + str(v).replace("'", "''") + "'"


def _lit_jsonb(v):
    return "null" if v is None else "'" + json.dumps(v, ensure_ascii=False).replace("'", "''") + "'::jsonb"


def _lit_compose(v):
    # coluna text: string crua; lista serializada como JSON (deploy aceita os dois)
    if v is None:
        return "null"
    if isinstance(v, list):
        return "'" + json.dumps(v, ensure_ascii=False).replace("'", "''") + "'"
    return _lit_txt(v)


def cmd_ver(quero_json):
    sql = ("select slug, coalesce(papel,''), coalesce(critico,false), coalesce(repo,''), "
           "coalesce(compose,''), coalesce(rotas::text,'null'), coalesce(segredos::text,'null'), "
           "coalesce(reversao::text,'null'), coalesce(gate::text,'null'), "
           "coalesce(profiles::text,'null'), coalesce(nota,''), coalesce(pre_build,'null') "
           "from acervo.stack order by slug")
    linhas = [l for l in _psql(sql).splitlines() if l.strip()]
    if not linhas:
        morre("acervo stack ver: tabela vazia.", 3)
    stacks = []
    for l in linhas:
        c = l.split("|")
        if len(c) != 12:
            morre("acervo stack ver: linha inesperada (%d campos):\n  %s" % (len(c), l), 3)
        slug, papel, crit, repo, compose, rotas, seg, rev, gate, prof, nota, pre_build = c
        comp = compose
        if compose.startswith("["):
            try:
                comp = json.loads(compose)
            except ValueError:
                pass
        j = lambda t: (None if t in ("null", "") else json.loads(t))
        stacks.append({"slug": slug, "papel": papel or None, "critico": crit == "t",
                       "repo": repo or None, "compose": comp or None,
                       "rotas": j(rotas), "segredos": j(seg), "reversao": j(rev),
                       "gate": j(gate), "profiles": j(prof), "nota": nota or None,
                       "pre_build": None if pre_build in ("null", "") else pre_build})
    if quero_json:
        print(json.dumps(stacks, ensure_ascii=False, indent=2))
        return
    for s in stacks:
        print("%s%s" % (s["slug"], "  [critico]" if s["critico"] else ""))
    sys.stderr.write("\n%d stack(s) em acervo.stack.\n" % len(stacks))


def cmd_import(arq):
    try:
        with open(arq, encoding="utf-8") as fh:
            doc = json.load(fh)
    except FileNotFoundError:
        morre("acervo stack import: nao achei %s" % arq, 3)
    except json.JSONDecodeError as e:
        morre("acervo stack import: %s nao e JSON valido: %s" % (arq, e), 3)
    stacks = doc.get("stacks")
    if not stacks:
        morre("acervo stack import: %s nao tem a chave 'stacks'." % arq, 3)

    vals = []
    for slug, s in stacks.items():
        # `forma` e obrigatoria na tabela (conteiner ou host): sem ela no JSON, sai do compose,
        # porque stack sem compose (a de catalogo, como `harness`) roda no host.
        forma = s.get("forma") or ("host" if s.get("compose") is None else "conteiner")
        if forma not in ("conteiner", "host"):
            morre("acervo stack import: stack %r com forma %r (esperava conteiner ou host)." % (slug, forma), 2)
        vals.append("(" + ",".join([
            _lit_txt(slug), _lit_txt(s.get("papel")),
            "true" if s.get("critico") else "false",
            _lit_txt(s.get("repo")), _lit_compose(s.get("compose")),
            _lit_jsonb(s.get("rotas")), _lit_jsonb(s.get("segredos")),
            _lit_jsonb(s.get("reversao")), _lit_jsonb(s.get("gate")),
            _lit_jsonb(s.get("profiles")), _lit_txt(s.get("_nota")),
            _lit_txt(s.get("pre_build")), _lit_txt(forma),
        ]) + ")")
    sets = ",".join("%s = excluded.%s" % (c, c) for c in
                    ("papel", "critico", "repo", "compose", "rotas", "segredos",
                     "reversao", "gate", "profiles", "nota", "pre_build", "forma"))
    sql = ("begin;\ninsert into acervo.stack "
           "(slug,papel,critico,repo,compose,rotas,segredos,reversao,gate,profiles,nota,pre_build,forma) values\n"
           + ",\n".join(vals) + "\non conflict (slug) do update set " + sets + ";\ncommit;")
    _psql(None, stdin=sql)
    sys.stderr.write("acervo stack import: %d stack(s) carregada(s)/atualizada(s) de %s.\n"
                     "  confira com `acervo stack ver` e `acervo listar topologia --completo --json`;\n"
                     "  batendo, o %s pode ser apagado — a tabela e a fonte.\n"
                     % (len(stacks), arq, arq))


def cmd_rm(slug):
    saida = _psql("delete from acervo.stack where slug = %s returning slug" % _lit_txt(slug))
    if not saida.strip():
        morre("acervo stack rm: nao ha stack com slug %r." % slug, 1)
    sys.stderr.write("acervo stack rm: %s removida.\n" % slug)


# O serviço é a ficha da classe `servico` ligada por `parte-de` à ficha da stack; a unit é a declaração dele
# na forma de processo de host (arq:0025 §1 e §2) e mora no suporte da ficha, tipo `unit`. Endereço que
# termina em `*` vale por prefixo (units transientes, como platafirma-job-*).
_SERVICO_DA_STACK = (
    "from acervo.entidade e "
    "join acervo.entidade_relacao r on r.de_id = e.id and r.tipo = 'parte-de' "
    "and (r.vigencia_fim is null or r.vigencia_fim > now()) "
    "join acervo.entidade st on st.id = r.para_id and st.classe = 'stack' "
    "and st.estado = 'ativa' "
)

def cmd_servicos(slug, quero_json):
    sql = ("select e.chave_humana, coalesce(string_agg(su.endereco, ',' order by su.endereco), '') "
           + _SERVICO_DA_STACK
           + "left join acervo.entidade_suporte su on su.entidade_id = e.id and su.tipo = 'unit' "
           "where e.classe = 'servico' and e.estado = 'ativa' and st.chave_humana = %s "
           "group by e.chave_humana order by e.chave_humana" % _lit_txt(slug))
    linhas = [l for l in _psql(sql).splitlines() if l.strip()]
    if not linhas:
        morre("acervo stack servicos %s: nenhum servico declarado na stack." % slug, 1)
    servicos = []
    for l in linhas:
        chave, _, units = l.partition("|")
        servicos.append({"servico": chave, "units": [u for u in units.split(",") if u]})
    if quero_json:
        print(json.dumps(servicos, ensure_ascii=False, indent=2))
        return
    for s in servicos:
        print("%s  %s" % (s["servico"], ", ".join(s["units"]) or "-"))

def cmd_resolver(unit):
    u = _lit_txt(unit)
    sql = ("select e.chave_humana " + _SERVICO_DA_STACK
           + "join acervo.entidade_suporte su on su.entidade_id = e.id and su.tipo = 'unit' "
           "where e.classe = 'servico' and e.estado = 'ativa' and "
           "(su.endereco = %s or (su.endereco like '%%*' and starts_with(%s, rtrim(su.endereco, '*')))) "
           "order by (su.endereco = %s) desc, length(su.endereco) desc limit 1" % (u, u, u))
    chave = _psql(sql).strip()
    if not chave:
        morre("unit_sem_stack: %s" % unit, 1)
    print(chave)

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)
    ato, resto = argv[0], argv[1:]
    if ato == "ver":
        # `ver <stack>` segue listando o registro inteiro: `release` chama `acervo ler casa stack <repo> --json`,
        # que cai aqui, e o argumento nunca filtrou. Os servicos de uma stack sao o ato `servicos`.
        cmd_ver("--json" in resto)
    elif ato == "servicos":
        slugs = [a for a in resto if not a.startswith("--")]
        if not slugs:
            morre("acervo stack servicos: falta a stack\n\n%s" % USO)
        cmd_servicos(slugs[0], "--json" in resto)
    elif ato == "resolver":
        if not resto:
            morre("acervo stack resolver: falta a unit\n\n%s" % USO)
        cmd_resolver(resto[0])
    elif ato == "import":
        if not resto:
            morre("acervo stack import: falta o caminho do stacks.json\n\n%s" % USO)
        cmd_import(resto[0])
    elif ato == "rm":
        if not resto:
            morre("acervo stack rm: falta o slug\n\n%s" % USO)
        cmd_rm(resto[0])
    else:
        morre("acervo stack: ato desconhecido %r (ver, import, rm)\n\n%s" % (ato, USO))


if __name__ == "__main__":
    # Sai limpo no `| head`. So na execucao direta: no import o processo do chamador nao muda (#3274).
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    main(sys.argv[1:])
