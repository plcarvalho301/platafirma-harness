def _padrao_do_conhecimento():
    """O módulo da tabela única do método padrão por tipo (`conversor/conversor/padrao.py`, só
    biblioteca padrão), da árvore do conhecimento: a declarada em PF_CONHECIMENTO_DIR (a bancada, o
    teste), senão a release no ar. `None` quando nenhuma o tem."""
    import importlib
    from pathlib import Path

    raizes = []
    if os.environ.get("PF_CONHECIMENTO_DIR"):
        raizes.append(Path(os.environ["PF_CONHECIMENTO_DIR"]))
    raizes.append(Path(_raizes()[1]) / "conhecimento")
    for raiz in raizes:
        pacote = raiz / "conversor"
        if not (pacote / "conversor" / "padrao.py").is_file():
            continue
        sys.path.insert(0, str(pacote))
        try:
            return importlib.import_module("conversor.padrao")
        finally:
            sys.path.remove(str(pacote))
    return None


