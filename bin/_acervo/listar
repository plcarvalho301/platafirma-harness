#!/usr/bin/env python3
# acervo listar — referências do acervo. Hoje: conceitos, ferramental e topologia (golden records).
# capacidade: conhecimento
# dono: claudinho-dados
#   (matéria/semântica: claudinho-dados · dono; mecanismo/harness: claudinho-TI · construcao)
#
# `acervo listar conceitos [--json]`   — golden record acervo.conceito (rag-extractor-pg).
# `acervo listar ferramental [--json] [--oficio] [--tools]` — golden record acervo.ferramental
#     (3 níveis: capacidade → verbo → instância). Fatia física da minuta 0012 / ADR 0076.
#     Com --oficio, filtra pelos verbos do NÚCLEO de abertura (whitelist em
#     abertura/oficio-ferramental.md), pra o oficio.md não duplicar a lista à mão.
#     Com --tools, projeta o núcleo em tools MCP (consumidor: ops-server).
# `acervo listar topologia [--json] [--completo]` — golden record acervo.stack (eixo irmão).
# Read-only. NÃO servido na montagem: é referência e fallback (D4 do ADR 0076).
#
# TRANSPORTE (arq:0106 seguido à risca): o psql devolve UMA linha, um array JSON, via
# json_agg(row_to_json(...)). Identidade de verbo/conceito/stack é o SLUG — coluna
# cravada. Descrição é payload opaco (texto pra IA); não é chave, não se parseia, não
# se conta campo. Nada de split posicional por delimitador: um `|` numa descrição é
# conteúdo, não estrutura. `_linhas`/contagem-de-campos foi deletada (era bloat que só
# existia pra defender transporte por texto delimitado — o incidente 09/09 da porta
# cega saiu daí).
#
# Contrato: platafirma-arquitetura/docs/abertura-de-sessao/abertura-novo-pedro/
#           P2 - monta-sessao.md, "índice de conceito" (22/08/2026).
# ferramental: platafirma-arquitetura/macro-global/decisions/
#           0076-catalogo-de-ferramental-golden-record-relacional.md
import json
import os
import signal
import subprocess
import sys

# Sai limpo quando o consumidor fecha o cano (| head, | jq -e). Sem isto, o print
# num stdout já fechado estoura BrokenPipeError com traceback (medido no teste).
try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"

# Whitelist do núcleo de abertura. A fonte é abertura/oficio-ferramental.md, um slug
# de verbo por linha dentro do bloco cercado (```); comentários e texto fora do bloco
# são ignorados. Resolvido relativo à raiz do harness (dois níveis acima de bin/).
OFICIO_WHITELIST = os.path.join(
    os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))),
    "abertura", "oficio-ferramental.md",
)

# Cada SELECT devolve UMA linha: um array JSON de objetos, chaveados por nome de coluna.
# json_agg preserva a ordem do ORDER BY interno. coalesce(..., '[]') porque json_agg de
# zero linhas é NULL, não array vazio.
SQL_CONCEITOS = """
select coalesce(json_agg(row_to_json(t) order by t.slug), '[]')
from (
  select c.slug, c.id, c.rotulo,
         nullif(array_to_string(c.outros_rotulos, ' / '), '') as outros_rotulos,
         coalesce(
           (select array_agg(distinct d.slug)
            from acervo.obra_trata_de tr
            join acervo.obra o on o.id = tr.obra_id
            join acervo.dominio d on d.id = o.dominio_id
            where tr.conceito_id = c.id), '{}') as origem,
         (select count(distinct tr.obra_id)
          from acervo.obra_trata_de tr where tr.conceito_id = c.id) as obras_ancora
  from acervo.conceito c
) t;
"""

# ferramental: uma linha por par capacidade→verbo, com as instâncias agregadas.
# O 1:1 capacidade↔verbo é constraint no schema; o join reflete isso (inner).
SQL_FERRAMENTAL = """
select coalesce(json_agg(row_to_json(t) order by t.capacidade, t.verbo), '[]')
from (
  select cap.slug as capacidade, vb.slug as verbo,
         nullif(vb.sot, '') as sot, nullif(vb.descricao, '') as descricao,
         coalesce(
           (select array_agg(distinct ins.slug order by ins.slug)
            from acervo.ferramental_instancia ins where ins.verbo_id = vb.id),
           '{}') as instancias
  from acervo.ferramental_capacidade cap
  join acervo.ferramental_verbo vb on vb.capacidade_id = cap.id
) t;
"""

# topologia: uma linha por stack, com as instancias que nela rodam agregadas (M:N).
# stack sem instancia e estado normal (recorte de deploy e arbitrario, ADR 0076).
SQL_TOPOLOGIA = """
select coalesce(json_agg(row_to_json(t) order by t.slug), '[]')
from (
  select stk.slug, nullif(stk.papel, '') as papel, coalesce(stk.critico, false) as critico,
         coalesce(
           (select array_agg(distinct ins.slug order by ins.slug)
            from acervo.instancia_roda_em_stack m
            join acervo.ferramental_instancia ins on ins.id = m.instancia_id
            where m.stack_id = stk.id), '{}') as instancias
  from acervo.stack stk
) t;
"""

# topologia --completo: TODAS as colunas que `deploy` le de stacks.json, servidas da
# tabela. rotas/segredos/reversao/gate/profiles sao jsonb e ja saem como json aninhado
# no row_to_json (sem ::text, sem reparse). compose e text OU lista serializada.
SQL_TOPOLOGIA_COMPLETA = """
select coalesce(json_agg(row_to_json(t) order by t.slug), '[]')
from (
  select stk.slug, nullif(stk.papel, '') as papel, coalesce(stk.critico, false) as critico,
         nullif(stk.repo, '') as repo, stk.compose,
         stk.rotas, stk.segredos, stk.reversao, stk.gate, stk.profiles,
         nullif(stk.nota, '') as nota,
         coalesce(
           (select array_agg(distinct ins.slug order by ins.slug)
            from acervo.instancia_roda_em_stack m
            join acervo.ferramental_instancia ins on ins.id = m.instancia_id
            where m.stack_id = stk.id), '{}') as instancias
  from acervo.stack stk
) t;
"""

USO = """uso:
  acervo listar conceitos [--json]              golden record acervo.conceito:
                                                slug . rotulo . outros rotulos . origem . obras-ancora
  acervo listar ferramental [--json] [--oficio] [--tools] golden record acervo.ferramental:
                                                capacidade . verbo . sot . descricao . instancias
                                                --oficio: so os verbos do nucleo de abertura
                                                --tools: projecao do nucleo em tools MCP (JSON; spec capsula)
  acervo listar topologia [--json] [--completo] topologia de deploy acervo.stack (eixo irmao):
                                                stack . critico . instancias . papel
                                                --completo: + repo, compose, rotas, gate,
                                                segredos, reversao, profiles, nota (o que
                                                `deploy` le do stacks.json)

Read-only. E o golden record: a lista (b) do chapeu e GERADA disto, nao editada a mao.
"""

def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)

def _le_whitelist_oficio():
    """Slugs de verbo do núcleo, do bloco cercado de oficio-ferramental.md.

    Só as linhas dentro do primeiro par de cercas ``` contam; fora delas é prosa.
    Linha vazia e comentário (#) são ignorados. O slug é o primeiro token da linha;
    o resto são marcadores `chave:valor` (hoje: `leva:2`, tool retida atrás de
    PF_TOOLS_LEVA2 — o whitelist é a ÚNICA fonte de quem é leva 2). Ausência do
    arquivo ou bloco vazio é erro duro: --oficio sem whitelist serviria a lista
    inteira e mentiria sobre ser 'só o núcleo'.

    Devolve set de slugs; `_marcadores_oficio()` devolve {slug: {chave: valor}}.
    """
    try:
        with open(OFICIO_WHITELIST, encoding="utf-8") as fh:
            linhas = fh.read().splitlines()
    except FileNotFoundError:
        morre("acervo listar ferramental --oficio: whitelist nao encontrado em\n  %s"
              % OFICIO_WHITELIST, 3)
    dentro = False
    slugs = []
    for l in linhas:
        s = l.strip()
        if s.startswith("```"):
            if dentro:
                break            # fecha no primeiro bloco
            dentro = True
            continue
        if not dentro or not s or s.startswith("#"):
            continue
        slugs.append(s.split()[0])
    if not slugs:
        morre("acervo listar ferramental --oficio: whitelist vazio em\n  %s\n"
              "  (esperado um bloco cercado com um slug de verbo por linha)"
              % OFICIO_WHITELIST, 3)
    return set(slugs)

def _marcadores_oficio():
    """{slug: {chave: valor}} dos marcadores da linha do whitelist (ex.: `deploy leva:2`)."""
    out = {}
    try:
        with open(OFICIO_WHITELIST, encoding="utf-8") as fh:
            linhas = fh.read().splitlines()
    except FileNotFoundError:
        return out
    dentro = False
    for l in linhas:
        s = l.strip()
        if s.startswith("```"):
            if dentro:
                break
            dentro = True
            continue
        if not dentro or not s or s.startswith("#"):
            continue
        tok = s.split()
        out[tok[0]] = dict(t.split(":", 1) for t in tok[1:] if ":" in t)
    return out

def _psql_json(sql, alvo):
    """Roda o SELECT (que devolve UMA linha: um array JSON) e desserializa.

    Sem -F, sem split posicional: a estrutura vem do JSON do proprio Postgres, que
    escapa qualquer coisa que houver nos campos-texto (| incluido). O slug e a
    identidade; a descricao e payload opaco que vive dentro do JSON e nunca vira chave.
    """
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    try:
        saida = subprocess.run(
            ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-tA", "-c", sql],
            capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo listar: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo listar: psql falhou (rc=%s):\n%s"
              % (e.returncode, (e.stderr or "").strip()), 3)
    try:
        return json.loads(saida)
    except (ValueError, TypeError) as e:
        morre("acervo listar %s: psql nao devolveu JSON parseavel (%s):\n  %s"
              % (alvo, e, saida[:200]), 3)

def listar_conceitos(quero_json):
    conceitos = _psql_json(SQL_CONCEITOS, "conceitos")
    for c in conceitos:
        c["origem"] = c.get("origem") or None
        c["obras_ancora"] = int(c.get("obras_ancora") or 0)
    if quero_json:
        print(json.dumps(conceitos, ensure_ascii=False, indent=2))
        return
    w = max((len(c["slug"]) for c in conceitos), default=4)
    print("%-*s  %5s  %-20s  %s" % (w, "slug", "obras", "origem", "rotulo"))
    print("%s  %5s  %-20s  %s" % ("-" * w, "-----", "-" * 20, "-" * 6))
    for c in conceitos:
        org = ",".join(c["origem"]) if c["origem"] else "-"
        print("%-*s  %5d  %-20s  %s" % (w, c["slug"], c["obras_ancora"], org, c["rotulo"]))
    sys.stderr.write("\n%d conceito(s) no golden record (acervo.conceito).\n" % len(conceitos))

def listar_ferramental_tools():
    """Projecao do whitelist do nucleo em tools MCP (spec_capsula-de-verbos §3.2).

    Um slug = uma tool; nome = slug, sem traducao. A identidade e vb.slug — coluna
    cravada do golden record. Slug sem binario em bin/ sai da lista com aviso em
    stderr — a porta nunca aborta por isso. `monta-sessao` fica de fora: `monta_sessao`
    ja e tool e e a unica excecao de nome. Sempre JSON: o consumidor e o ops-server.
    """
    whitelist = _le_whitelist_oficio()
    marcas = _marcadores_oficio()
    # Binario e o que o PATH da porta resolve (ops-server injeta ~/AI/bin e
    # ~/.local/bin): `fila` e symlink em ~/AI/bin -> fila_streams.py, nao mora em bin/.
    import shutil
    casa = os.path.expanduser("~")
    caminho = ":".join([os.path.join(casa, "AI", "bin"), os.path.join(casa, ".local", "bin"),
                        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                        os.environ.get("PATH", "")])
    itens = []
    vistos = set()
    for row in _psql_json(SQL_FERRAMENTAL, "ferramental"):
        verbo = row["verbo"]
        if verbo not in whitelist or verbo == "monta-sessao":
            continue
        vistos.add(verbo)
        binario = shutil.which(verbo, path=caminho)
        if not binario:
            sys.stderr.write("aviso: whitelist cita %r sem binario executavel no PATH — tool ausente\n" % verbo)
            continue
        desc = (row.get("descricao") or "").strip()
        itens.append({
            "tool": verbo, "verbo": verbo, "capacidade": row["capacidade"],
            "descricao": desc or ("verbo %s (sem descricao no golden record)" % verbo),
            "binario": binario,
            "leva": int(marcas.get(verbo, {}).get("leva", 1)),
        })
    faltam = whitelist - vistos - {"monta-sessao"}
    for v in sorted(faltam):
        sys.stderr.write("aviso: whitelist cita %r ausente no golden record — tool ausente\n" % v)
    print(json.dumps(itens, ensure_ascii=False, indent=2))

def listar_ferramental(quero_json, so_oficio=False):
    itens = []
    for row in _psql_json(SQL_FERRAMENTAL, "ferramental"):
        itens.append({
            "capacidade": row["capacidade"], "verbo": row["verbo"],
            "sot": row.get("sot") or None,
            "descricao": row.get("descricao") or None,
            "instancias": row.get("instancias") or None,
        })
    if so_oficio:
        whitelist = _le_whitelist_oficio()
        itens = [i for i in itens if i["verbo"] in whitelist]
        # Whitelist aponta verbo que o golden record nao tem: nucleo mente. Denuncia.
        faltam = whitelist - {i["verbo"] for i in itens}
        if faltam:
            morre("acervo listar ferramental --oficio: whitelist cita verbo(s) "
                  "ausente(s) no golden record: %s" % ", ".join(sorted(faltam)), 3)
    if quero_json:
        print(json.dumps(itens, ensure_ascii=False, indent=2))
        return
    wc = max((len(i["capacidade"]) for i in itens), default=10)
    wv = max((len(i["verbo"]) for i in itens), default=5)
    def _ins(i):
        return ",".join(i["instancias"]) if i["instancias"] else "-"
    wi = max([len(_ins(i)) for i in itens] + [len("instancias")])
    print("%-*s  %-*s  %-*s  %s" % (wc, "capacidade", wv, "verbo", wi, "instancias", "descricao"))
    print("%s  %s  %s  %s" % ("-" * wc, "-" * wv, "-" * wi, "-" * 9))
    for i in itens:
        print("%-*s  %-*s  %-*s  %s" % (wc, i["capacidade"], wv, i["verbo"], wi, _ins(i), i["descricao"] or "-"))
    rotulo = "acervo.ferramental, nucleo de abertura" if so_oficio else "acervo.ferramental"
    sys.stderr.write("\n%d capacidade(s) no golden record (%s).\n" % (len(itens), rotulo))

def listar_topologia(quero_json, completo=False):
    if not completo:
        stacks = []
        for row in _psql_json(SQL_TOPOLOGIA, "topologia"):
            stacks.append({
                "slug": row["slug"],
                "papel": row.get("papel") or None,
                "critico": bool(row.get("critico")),
                "instancias": row.get("instancias") or None,
            })
        if quero_json:
            print(json.dumps(stacks, ensure_ascii=False, indent=2))
            return
        ws = max((len(s["slug"]) for s in stacks), default=5)
        print("%-*s  %-4s  %-14s  %s" % (ws, "stack", "crit", "instancias", "papel"))
        print("%s  %-4s  %-14s  %s" % ("-" * ws, "----", "-" * 14, "-" * 5))
        for st in stacks:
            ins = ",".join(st["instancias"]) if st["instancias"] else "-"
            crit = "sim" if st["critico"] else "-"
            print("%-*s  %-4s  %-14s  %s" % (ws, st["slug"], crit, ins, st["papel"] or ""))
        sys.stderr.write("\n%d stack(s) na topologia (acervo.stack); vinculo M:N em instancia_roda_em_stack.\n" % len(stacks))
        return

    # --completo: todas as colunas que `deploy` le. jsonb ja vem aninhado do row_to_json;
    # compose e string OU lista (o registro aceita os dois; lista ja chega como array json).
    stacks = []
    for row in _psql_json(SQL_TOPOLOGIA_COMPLETA, "topologia --completo"):
        stacks.append({
            "slug": row["slug"],
            "papel": row.get("papel") or None,
            "critico": bool(row.get("critico")),
            "repo": row.get("repo") or None,
            "compose": row.get("compose") or None,
            "rotas": row.get("rotas"),
            "segredos": row.get("segredos"),
            "reversao": row.get("reversao"),
            "gate": row.get("gate"),
            "profiles": row.get("profiles"),
            "nota": row.get("nota") or None,
            "instancias": row.get("instancias") or None,
        })
    if quero_json:
        print(json.dumps(stacks, ensure_ascii=False, indent=2))
        return
    # forma-texto de --completo: uma stack por bloco (largura nao cabe em colunas).
    for st in stacks:
        print("== %s%s ==" % (st["slug"], "  [critico]" if st["critico"] else ""))
        print("  papel   : %s" % (st["papel"] or "-"))
        print("  repo    : %s" % (st["repo"] or "-"))
        comp = st["compose"]
        print("  compose : %s" % (", ".join(comp) if isinstance(comp, list) else (comp or "-")))
        print("  rotas   : %s" % (st["rotas"] if st["rotas"] is not None else "-"))
        print("  gate    : %s" % (st["gate"] if st["gate"] is not None else "-"))
        print("  profiles: %s" % (",".join(st["profiles"]) if st["profiles"] else "-"))
        seg = st["segredos"]
        print("  segredos: %s" % (", ".join(seg) if seg else "(nenhum declarado)" if seg == [] else "-"))
        rev = st["reversao"]
        if rev:
            print("  reversao: via=%s janela_min=%s quem=%s provado_em=%s" % (
                rev.get("via"), rev.get("janela_min"), rev.get("quem"), rev.get("provado_em")))
            if rev.get("estado"):
                print("            estado: %s" % rev["estado"])
        print("  instancias: %s" % (",".join(st["instancias"]) if st["instancias"] else "-"))
    sys.stderr.write("\n%d stack(s) na topologia completa (acervo.stack) — todos os campos que `deploy` le.\n" % len(stacks))

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)

    alvo, resto = argv[0], argv[1:]
    if alvo not in ("conceitos", "ferramental", "topologia"):
        morre("acervo listar: alvo desconhecido %r (hoje 'conceitos', 'ferramental' e 'topologia')\n\n%s"
              % (alvo, USO))

    quero_json = False
    so_oficio = False
    completo = False
    so_tools = False
    for a in resto:
        if a == "--json":
            quero_json = True
        elif a == "--oficio" and alvo == "ferramental":
            so_oficio = True
        elif a == "--tools" and alvo == "ferramental":
            so_tools = True
        elif a == "--completo" and alvo == "topologia":
            completo = True
        else:
            morre("acervo listar: opcao desconhecida %r\n\n%s" % (a, USO))

    if alvo == "conceitos":
        listar_conceitos(quero_json)
    elif alvo == "topologia":
        listar_topologia(quero_json, completo)
    elif so_tools:
        listar_ferramental_tools()
    else:
        listar_ferramental(quero_json, so_oficio)

if __name__ == "__main__":
    main(sys.argv[1:])
