def listar_obra(termo, eixo, situacao, quero_json):
    cat_info = _psql_json(
        "select coalesce(json_agg(row_to_json(t)), '[]') from ("
        "  select count(*) as total, to_char(max(coalesce(classificado_em, now())), 'YYYY-MM-DD') as data "
        "  from acervo.obra where retirada_em is null"
        ") t;", "catalogo_obra"
    )
    total_obras = cat_info[0]["total"] if cat_info else 0
    data_cat = cat_info[0]["data"] if cat_info else ""

    if eixo and eixo not in ("titulo", "conceito", "subdominio"):
        morre("acervo listar biblioteca obra: --eixo invalido '%s' (titulo, conceito, subdominio)." % eixo, 2)

    if termo:
        cond_t = "o.titulo ilike %s" % _lit("%" + termo + "%")
        cond_s = "lower(sd.slug) = lower(%s)" % _lit(termo)
        cond_c = "lower(cr.rotulo) = lower(%s)" % _lit(termo)

        if eixo == "titulo":
            sql = """
            select o.id, o.titulo, o.objeto, 'titulo' as eixo,
                   sd.slug as subdominio,
                   (select c.rotulo from acervo.obra_trata_de ot join acervo.conceito c on c.id = ot.conceito_id where ot.obra_id = o.id limit 1) as conceito,
                   imp.id as impressao_id, imp.estado as impressao_estado
            from acervo.obra o
            left join acervo.subdominio sd on sd.id = o.subdominio_id
            left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
            where {cond_t}
            order by o.titulo;
            """.format(cond_t=cond_t)
        elif eixo == "subdominio":
            sql = """
            select o.id, o.titulo, o.objeto, 'subdominio' as eixo,
                   sd.slug as subdominio,
                   (select c.rotulo from acervo.obra_trata_de ot join acervo.conceito c on c.id = ot.conceito_id where ot.obra_id = o.id limit 1) as conceito,
                   imp.id as impressao_id, imp.estado as impressao_estado
            from acervo.obra o
            join acervo.subdominio sd on sd.id = o.subdominio_id
            left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
            where {cond_s}
            order by o.titulo;
            """.format(cond_s=cond_s)
        elif eixo == "conceito":
            sql = """
            select distinct on (o.id) o.id, o.titulo, o.objeto, 'conceito' as eixo,
                   sd.slug as subdominio,
                   cr.rotulo as conceito,
                   imp.id as impressao_id, imp.estado as impressao_estado
            from acervo.obra o
            join acervo.obra_trata_de ot on ot.obra_id = o.id
            join acervo.conceito_rotulo cr on cr.conceito_id = ot.conceito_id
            left join acervo.subdominio sd on sd.id = o.subdominio_id
            left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
            where {cond_c}
            order by o.id, o.titulo;
            """.format(cond_c=cond_c)
        else:
            # card #3139 item 5: uma linha por obra, no eixo MAIS FORTE (não mais uma linha
            # por (obra, eixo) nem ordenado pelo id) — titulo igual ao termo (1) -> titulo que
            # contem o termo (2) -> conceito, rotulo preferido ou alternativo (3) -> subdominio
            # (4); empate por titulo. O DISTINCT ON interno escolhe a linha de menor `forca`
            # por obra; o ORDER BY externo reordena o resultado por forca e titulo.
            cond_t_exato = "lower(o.titulo) = lower(%s)" % _lit(termo)
            cond_t_contem_so = "%s and lower(o.titulo) <> lower(%s)" % (cond_t, _lit(termo))
            sql = """
            select x.id, x.titulo, x.objeto, x.eixo, x.subdominio, x.conceito,
                   x.impressao_id, x.impressao_estado
              from (
                select distinct on (sub.id) sub.id, sub.titulo, sub.objeto, sub.eixo, sub.forca,
                       sub.subdominio, sub.conceito, sub.impressao_id, sub.impressao_estado
                  from (
                    select o.id, o.titulo, o.objeto, 'titulo' as eixo, 1 as forca,
                           sd.slug as subdominio,
                           (select c.rotulo from acervo.obra_trata_de ot join acervo.conceito c on c.id = ot.conceito_id where ot.obra_id = o.id limit 1) as conceito,
                           imp.id as impressao_id, imp.estado as impressao_estado
                      from acervo.obra o
                      left join acervo.subdominio sd on sd.id = o.subdominio_id
                      left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
                     where {cond_t_exato}
                    union all
                    select o.id, o.titulo, o.objeto, 'titulo' as eixo, 2 as forca,
                           sd.slug as subdominio,
                           (select c.rotulo from acervo.obra_trata_de ot join acervo.conceito c on c.id = ot.conceito_id where ot.obra_id = o.id limit 1) as conceito,
                           imp.id as impressao_id, imp.estado as impressao_estado
                      from acervo.obra o
                      left join acervo.subdominio sd on sd.id = o.subdominio_id
                      left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
                     where {cond_t_contem_so}
                    union all
                    select o.id, o.titulo, o.objeto, 'conceito' as eixo, 3 as forca,
                           sd.slug as subdominio,
                           cr.rotulo as conceito,
                           imp.id as impressao_id, imp.estado as impressao_estado
                      from acervo.obra o
                      join acervo.obra_trata_de ot on ot.obra_id = o.id
                      join acervo.conceito_rotulo cr on cr.conceito_id = ot.conceito_id
                      left join acervo.subdominio sd on sd.id = o.subdominio_id
                      left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
                     where {cond_c}
                    union all
                    select o.id, o.titulo, o.objeto, 'subdominio' as eixo, 4 as forca,
                           sd.slug as subdominio,
                           (select c.rotulo from acervo.obra_trata_de ot join acervo.conceito c on c.id = ot.conceito_id where ot.obra_id = o.id limit 1) as conceito,
                           imp.id as impressao_id, imp.estado as impressao_estado
                      from acervo.obra o
                      join acervo.subdominio sd on sd.id = o.subdominio_id
                      left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
                     where {cond_s}
                  ) sub
                 order by sub.id, sub.forca, sub.titulo
              ) x
             order by x.forca, x.titulo;
            """.format(cond_t_exato=cond_t_exato, cond_t_contem_so=cond_t_contem_so,
                       cond_s=cond_s, cond_c=cond_c)
    else:
        sql = """
        select o.id, o.titulo, o.objeto, 'obra' as eixo,
               sd.slug as subdominio,
               (select c.rotulo from acervo.obra_trata_de ot join acervo.conceito c on c.id = ot.conceito_id where ot.obra_id = o.id limit 1) as conceito,
               imp.id as impressao_id, imp.estado as impressao_estado
        from acervo.obra o
        left join acervo.subdominio sd on sd.id = o.subdominio_id
        left join acervo.impressao imp on imp.obra_id = o.id and imp.estado = 'servindo'
        order by o.titulo;
        """

    # Obra retirada (retirada_em preenchido) não é achada pelo catálogo: sai de todos os eixos, com
    # ou sem --situacao (arq:0119 §1.4, §9; #3317). Filtro único sobre o resultado, para não repetir
    # a condição nos sete SELECTs; quem quer ver a retirada usa `acervo curar biblioteca --expurgadas`.
    raw_itens = _psql_json(
        "select coalesce(json_agg(row_to_json(t)), '[]') from (%s) t "
        "where t.id not in (select id from acervo.obra where retirada_em is not null);"
        % sql.strip().rstrip(";"),
        "listar obra"
    )

    # Marcação de uso da obra (arq:0119 §6; spec acervo-obra §6; migração 071, #3202): só no
    # --situacao, numa consulta à parte pelos ids, para não repetir a coluna nos seis SELECTs.
    marcas = {}
    if situacao and raw_itens:
        ids = ",".join(_lit(r["id"]) for r in raw_itens)
        for m in _psql_json(
                "select coalesce(json_agg(row_to_json(t)), '[]') from ("
                "  select id::text as id, marcacao from acervo.obra where id::text in (%s)"
                ") t;" % ids, "marcacao"):
            marcas[m["id"]] = m.get("marcacao")
    # O estado da obra vem do motor, pela regra única (`estado_da_obra`, #3294): servida inteira
    # (classificada, com cópia, não retirada; arq:0119 §1.4) e servível (o espelho da impressão que
    # serve, régua 6, #3282). Obra retirada não vem na projeção: não é servida nem servível.
    estados = {}
    if situacao and raw_itens:
        sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))))
        from recuperacao.adaptadores import motor_acervo_rest
        from recuperacao.adaptadores.base import FonteIndisponivel
        try:
            proj = motor_acervo_rest.obras(["obra_id", "servida_inteira", "servivel"])
        except FonteIndisponivel as e:
            sys.stderr.write(f"indeterminável: estado das obras fora do ar ({e})\n")
            return 5
        estados = {o["obra_id"]: o for o in proj.get("itens", [])}

    itens = []
    for row in raw_itens:
        obj = row.get("objeto")
        imp_id = row.get("impressao_id")
        imp_st = row.get("impressao_estado")

        if not obj:
            degrau = "catalogada"
        elif not imp_id:
            degrau = "armazenada"
        elif imp_st == "em_construcao":
            degrau = "ingerida"
        else:
            degrau = "vetorizada"

        estado = estados.get(str(row["id"]), {})
        servida = "sim" if estado.get("servida_inteira") else "nao"
        servivel = "sim" if estado.get("servivel") else "nao"
        store = "acervo" if (obj and obj.startswith("acervo/")) else ("pessoal" if (obj and obj.startswith("pessoal/")) else "-")
        imp_str = imp_id[:8] if imp_id else "-"

        item = {
            "id": row["id"],
            "titulo": row["titulo"],
            "eixo": row.get("eixo"),
            "subdominio": row.get("subdominio"),
            "conceito": row.get("conceito"),
        }
        if situacao:
            item["situacao"] = {
                "servida_inteira": servida,
                "servivel": servivel,
                "degrau": degrau,
                "store": store,
                "impressao": imp_str,
                "impressao_id": imp_id,
                "marcacao": marcas.get(str(row["id"])),
            }
        itens.append(item)

    if not itens:
        if quero_json:
            print("[]")
        else:
            if termo:
                print(f"motivo: nenhuma obra encontrada para --sobre '{termo}'")
            else:
                print("motivo: nenhuma obra no catalogo")
            print(f"varrido:   acervo.obra ({total_obras} obras, catálogo de {data_cat})")
        return 0

    if quero_json:
        print(json.dumps(itens, ensure_ascii=False, indent=2))
        return 0

    if situacao:
        for i in itens:
            sit = i["situacao"]
            eixo_tag = f"[{i['eixo']}] " if i.get("eixo") and i['eixo'] != "obra" else ""
            print(f"{eixo_tag}{i['titulo']}")
            print(f"  servida inteira: {sit['servida_inteira']}   servivel: {sit['servivel']}   degrau: {sit['degrau']}   store: {sit['store']}   impressao: {sit['impressao']}   marcacao: {sit['marcacao'] or '-'}\n")
        sys.stderr.write(f"\n{len(itens)} obra(s) encontrada(s).\n")
        return 0

    for i in itens:
        eixo_tag = f"[{i['eixo']}] " if i.get("eixo") and i['eixo'] != "obra" else ""
        extra = []
        if i.get("subdominio"):
            extra.append(f"subdominio: {i['subdominio']}")
        if i.get("conceito"):
            extra.append(f"conceito: {i['conceito']}")
        info = f" ({', '.join(extra)})" if extra else ""
        print(f"{eixo_tag}{i['titulo']}{info}")
    sys.stderr.write(f"\n{len(itens)} obra(s) encontrada(s).\n")
    return 0


# O julgamento dos espelhos servindo (#2856 linha 156, casos #3240 e #3282). O veredito da régua mora no
# catálogo, em `acervo.impressao.espelho -> veredito` (conhecimento, conversor/regua.py, §3.1 da spec
# espelho-de-leitura); aqui só se LÊ e se conta, pelo mesmo caminho do `acervo psql --banco rag`.
# Régua 6 (#3282): só a perda líquida julga; o veredito de régua anterior conta como «não julgado» até
# o `acervo curar biblioteca --rejulgar --lote`.
CLASSES_QUALIDADE = ("servível", "servível imperfeito", "não servível", "não julgado")
CRITERIO_QUALIDADE = (
    "perda líquida, max(perda − inserção, 0) / |R|: servível até 8%, imperfeito acima de 1%; não servível "
    "acima de 8% ou sem medida; o resto é aviso"
)

SQL_QUALIDADE_ESPELHO = """
select coalesce(json_agg(row_to_json(t) order by t.titulo, t.id), '[]')
from (
  select o.id, o.titulo, (imp.espelho is not null) as tem_espelho,
         (imp.espelho->'veredito'->>'servivel')::boolean as servivel,
         (imp.espelho->'veredito'->>'imperfeita')::boolean as imperfeita,
         imp.espelho->'veredito'->>'regua' as regua
  from acervo.impressao imp
  join acervo.obra o on o.id = imp.obra_id
  where imp.estado = 'servindo'
) t;
"""


def _classe(linha: dict) -> str:
    if linha.get("servivel") is None:
        return "não julgado"
    if not linha["servivel"]:
        return "não servível"
    return "servível imperfeito" if linha.get("imperfeita") else "servível"


def listar_obra_qualidade(por_obra, quero_json):
    """`acervo listar biblioteca obra --qualidade [--por-obra] [--json]`: a contagem, por classe, do julgamento
    dos espelhos servindo (régua 6: servível, servível imperfeito, não servível; não julgado para o veredito
    de régua anterior); com --por-obra, uma linha por obra. Só leitura."""
    linhas = _psql_json(SQL_QUALIDADE_ESPELHO, "qualidade_espelho")
    com_espelho = [l for l in linhas if l.get("tem_espelho")]
    sem_espelho = len(linhas) - len(com_espelho)
    obras = [{"id": l["id"], "titulo": l["titulo"], "classe": _classe(l), "regua": l.get("regua")}
             for l in com_espelho]
    classes = {c: 0 for c in CLASSES_QUALIDADE}
    for o in obras:
        classes[o["classe"]] = classes.get(o["classe"], 0) + 1
    reguas = sorted({str(o["regua"]) for o in obras if o["regua"] is not None})

    if quero_json:
        doc = {"total": len(obras), "sem_espelho": sem_espelho, "classes": classes,
               "regua": reguas, "criterio": CRITERIO_QUALIDADE}
        if por_obra:
            doc["obras"] = obras
        print(json.dumps(doc, ensure_ascii=False, indent=2))
        return 0

    print("%d espelhos servindo · critério (régua %s): %s"
          % (len(obras), "/".join(reguas) or "?", CRITERIO_QUALIDADE))
    for classe, n in classes.items():
        print("%-19s %d" % (classe, n))
    if sem_espelho:
        print("sem espelho %d (impressão servindo sem espelho de leitura; fora da conta)" % sem_espelho)
    if por_obra:
        print()
        ordem = {c: i for i, c in enumerate(classes)}
        for o in sorted(obras, key=lambda o: (ordem[o["classe"]], o["titulo"], o["id"])):
            print("%-19s %s" % (o["classe"], o["titulo"]))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)

    alvo, resto = argv[0], argv[1:]
    if alvo not in ("conceitos", "ferramental", "topologia", "obra"):
        morre("acervo listar: alvo desconhecido %r (hoje 'conceitos', 'ferramental', 'topologia' e 'obra')\n\n%s"
              % (alvo, USO))

    quero_json = False
    so_oficio = False
    completo = False
    so_tools = False
    situacao = False
    quero_qualidade = False
    por_obra = False
    quero_rotas = False
    quero_acessos = False
    quero_metodos = False
    quero_bancada = False
    pasta_bancada = None
    arquivo_estratos = None
    stack_alvo = None
    termo = None
    eixo = None

    i = 0
    while i < len(resto):
        a = resto[i]
        if a == "--json":
            quero_json = True
            i += 1
        elif a == "--situacao":
            situacao = True
            i += 1
        elif a == "--qualidade" and alvo == "obra":
            quero_qualidade = True
            i += 1
        elif a == "--por-obra" and alvo == "obra":
            por_obra = True
            i += 1
        elif a == "--oficio" and alvo == "ferramental":
            so_oficio = True
            i += 1
        elif a == "--tools" and alvo == "ferramental":
            so_tools = True
            i += 1
        elif a == "--completo" and alvo == "topologia":
            completo = True
            i += 1
        elif a == "--rotas" and alvo == "topologia":
            quero_rotas = True
            i += 1
        elif a == "--acessos" and alvo == "topologia":
            quero_acessos = True
            i += 1
        elif a == "--sobre" and alvo == "obra" and i + 1 < len(resto):
            termo = resto[i + 1]
            i += 2
        elif a == "--eixo" and alvo == "obra" and i + 1 < len(resto):
            eixo = resto[i + 1]
            i += 2
        elif a == "bancada" and alvo == "obra" and not quero_bancada:
            quero_bancada = True
            i += 1
        elif quero_bancada and alvo == "obra" and not a.startswith("-") and pasta_bancada is None:
            # <pasta>, --json e --estratos <arquivo> valem em QUALQUER ordem depois de `bancada`.
            # Vem ANTES das palavras reservadas: depois de `bancada`, o primeiro token sem '-' e
            # a pasta, mesmo que se chame `metodos` (ou `bancada`).
            pasta_bancada = a
            i += 1
        elif a == "metodos" and alvo == "obra" and not quero_metodos:
            quero_metodos = True
            i += 1
        elif a == "--estratos" and alvo == "obra" and i + 1 < len(resto):
            arquivo_estratos = resto[i + 1]
            i += 2
        elif alvo == "topologia" and not a.startswith("-") and stack_alvo is None:
            stack_alvo = a
            i += 1
        else:
            morre("acervo listar: opcao desconhecida %r\n\n%s" % (a, USO))

    if quero_bancada and (situacao or termo is not None or eixo is not None):
        # nao ignorar em silencio: o agregador nao filtra por assunto, eixo nem situacao
        morre("acervo listar biblioteca bancada: aceita so <pasta>, --json e --estratos <arquivo>; "
              "--sobre, --eixo e --situacao nao valem aqui.\n\n%s" % USO)
    if por_obra and not quero_qualidade:
        morre("acervo listar biblioteca obra: --por-obra so vale com --qualidade.\n\n%s" % USO)
    if quero_qualidade and (situacao or termo is not None or eixo is not None
                            or quero_bancada or quero_metodos):
        # nao ignorar em silencio: a agregacao cobre todos os espelhos servindo, sem filtro
        morre("acervo listar biblioteca obra --qualidade: aceita so --por-obra e --json; --sobre, --eixo, "
              "--situacao, bancada e metodos nao valem aqui.\n\n%s" % USO)
    if arquivo_estratos is not None and not quero_bancada:
        morre("acervo listar: --estratos so vale em `acervo listar biblioteca bancada <pasta>`.\n\n%s" % USO)
    if quero_bancada and not pasta_bancada:
        morre("acervo listar biblioteca bancada: falta a <pasta> (a que `curar --reextrair --bancada` gravou).\n\n%s" % USO)
    if quero_bancada and quero_metodos:
        morre("acervo listar obra: escolha `metodos` OU `bancada`, nao os dois.\n\n%s" % USO)
    if quero_rotas and quero_acessos:
        morre("acervo listar topologia: escolha --rotas OU --acessos, nao os dois.\n\n%s" % USO)
    if (quero_rotas or quero_acessos) and not stack_alvo:
        morre("acervo listar topologia --rotas/--acessos exige <stack>.\n\n%s" % USO)

    if alvo == "conceitos":
        listar_conceitos(quero_json)
    elif alvo == "topologia":
        if quero_rotas:
            listar_topologia_rotas(stack_alvo)
        elif quero_acessos:
            listar_topologia_acessos(stack_alvo)
        else:
            listar_topologia(quero_json, completo, stack_alvo)
    elif alvo == "obra":
        if quero_qualidade:
            sys.exit(listar_obra_qualidade(por_obra, quero_json))
        if quero_bancada:
            # so stdlib, sem banco: a logica mora ao lado (bancada_conversao.py)
            sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
            import bancada_conversao
            sys.exit(bancada_conversao.executar(pasta_bancada, quero_json, arquivo_estratos))
        if quero_metodos:
            listar_obra_metodos(quero_json)
        else:
            listar_obra(termo, eixo, situacao, quero_json)
    elif so_tools:
        listar_ferramental_tools()
    else:
        listar_ferramental(quero_json, so_oficio)


if __name__ == "__main__":
    # Sai limpo quando o consumidor fecha o cano (| head, | jq -e). Sem isto, o print
    # num stdout já fechado estoura BrokenPipeError com traceback (medido no teste).
    # So na execucao direta: no import o processo do chamador nao muda (#3274).
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    main(sys.argv[1:])
