#!/usr/bin/env bash
# _acervo/ingerir — alias deprecado (arq:0089 §3); use `ingerir --lote <pasta>`
echo "Deprecation: use ingerir --lote" >&2
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for arg in "$@"; do
    if [[ "$arg" == "--lote" ]]; then
        exec "$DIR/../ingerir" "$@"
    fi
done
exec "$DIR/../ingerir" --lote "$@"
