#!/usr/bin/env bash
# acervo ingerir — leva a obra da entrada até a vetorização, numa chamada.
#
# Duas portas, uma cadeia. Por arquivo (default) e por planilha (`--planilha`, a
# classificação digitada num .ods). As duas terminam nos mesmos degraus finais.
#
# Encadeia o que já existe; não reimplementa nada. O RAG é FERRAMENTA: quem manda
# na sequência é este verbo, e o `rag_extractor` é chamado em cada degrau.
#
#   por arquivo                            por planilha
#     inventário                             carga da planilha  (classificação)
#     armazenamento (MinIO)   [degrau b]     └────────┐
#     filas                                           │
#     catalogação             [degrau a]              │
#     └──────────────────┬─────────────────────────────
#     materialização     │  PDF + sidecar em disco
#     chunking           │  [degrau c]
#     vetor de texto     │  [degrau d]
#     propagação de faceta
#     vetor de metadado     [degrau e]
#
# DRY-RUN por default. `--apply` escreve. Mutação por arquivo exige a raiz explícita.
set -euo pipefail

AQUI="$(dirname "$(readlink -f "$0")")"
RAG="${RAG_DIR:-$HOME/AI/platafirma-conhecimento/rag}"
DESTINO="${CORPUS_DIR:-$RAG/corpus}"

uso() {
  cat >&2 <<'FIM'
uso:
  acervo ingerir <raiz>                     dry-run: mostra o que entraria
  acervo ingerir <raiz> --apply             arquivo: da entrada até a vetorização
  acervo ingerir --planilha [x.ods]         dry-run da carga de classificação
  acervo ingerir --planilha [x.ods] --apply planilha: carga e depois a vetorização
  acervo ingerir --apply                    RECUSADO: mutação exige a raiz explícita

<raiz> é a árvore de arquivos da entrada (ex.: ~/AI/entrada). O objeto é endereçado
pelo sha256 do conteúdo, então reexecutar é idempotente: o que já subiu é pulado.

Sem o .ods explícito, `--planilha` usa a única que estiver na fila de entrada e
recusa se houver mais de uma — não escolhe por você. Ponha uma lá com `acervo-drop`.

Mede a escada antes e depois e imprime os dois retratos. Interrompido no meio,
basta reexecutar: cada passo retoma de onde parou.
FIM
  exit 2
}

python_do_rag() {
  for c in "${RAG_PYTHON:-}" "$HOME/AI/.venv/bin/python" "$RAG/.venv/bin/python" \
           "$HOME/AI/.venv-testes/bin/python"; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  done
  echo "acervo ingerir: nenhum python com rag_extractor executável por este usuário." >&2
  echo "  aponte um com:  RAG_PYTHON=/caminho/para/python acervo ingerir ..." >&2
  exit 1
}

RAIZ=""; APPLY=0; PLANILHA=0; ODS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --apply)         APPLY=1; shift ;;
    --planilha)      PLANILHA=1; shift ;;
    -h|--help|ajuda) uso ;;
    -*)              echo "acervo ingerir: opção desconhecida '$1'" >&2; uso ;;
    *)               if [ "$PLANILHA" -eq 1 ] && [ -z "$ODS" ]; then ODS="$1"; else RAIZ="$1"; fi; shift ;;
  esac
done

if [ "$PLANILHA" -eq 0 ]; then
  [ -z "$RAIZ" ] && [ "$APPLY" -eq 1 ] && {
    echo "acervo ingerir: --apply sem raiz. Mutação não adivinha alvo." >&2; uso; }
  [ -z "$RAIZ" ] && uso
  [ -d "$RAIZ" ] || { echo "acervo ingerir: não é diretório: $RAIZ" >&2; exit 1; }
fi

PY="$(python_do_rag)"
export PYTHONPATH="$RAG"
cd "$RAG"

N=$([ "$PLANILHA" -eq 1 ] && echo 6 || echo 10)
K=0
passo() { K=$((K+1)); printf '\n\033[1m== %s/%s  %s\033[0m\n' "$K" "$N" "$*"; }
seco()  { [ "$APPLY" -eq 1 ] || { echo "   (dry-run) rodaria: $*"; return 1; }; return 0; }

passo "escada antes"
"$AQUI/escada" | sed -n '/catalogadas/,/vetorizadas/p'

if [ "$PLANILHA" -eq 1 ]; then
  passo "carga da planilha — classificação digitada vira acervo.obra"
  if [ "$APPLY" -eq 1 ]; then python3 scripts/carga-planilha.py ${ODS:+"$ODS"} --apply
  else python3 scripts/carga-planilha.py ${ODS:+"$ODS"}; fi
else
  passo "inventário da raiz — $RAIZ"
  if [ "$APPLY" -eq 1 ]; then
    # O manifest liga sha256 ao nome legível, e perdê-lo é irreversível. Raiz parcial
    # ou vazia geraria inventário menor e apagaria o resto do índice em silêncio.
    NOVO="$(mktemp)"; trap 'rm -f "$NOVO"' EXIT
    python3 scripts/inventario-acervo.py "$RAIZ" > "$NOVO"
    ANTES=$(wc -l < acervo/manifest.jsonl 2>/dev/null || echo 0)
    AGORA=$(wc -l < "$NOVO")
    if [ "$AGORA" -lt "$ANTES" ]; then
      echo "   RECUSADO: inventário de $RAIZ tem $AGORA linha(s); o manifest atual tem $ANTES." >&2
      echo "   Sobrescrever apagaria o índice do que está fora desta raiz. Aponte a raiz inteira." >&2
      exit 1
    fi
    mv "$NOVO" acervo/manifest.jsonl
    echo "   manifest: $AGORA linha(s)  (antes: $ANTES)"
  else
    python3 scripts/inventario-acervo.py "$RAIZ" | wc -l | xargs echo "   (dry-run) manifest teria" "linha(s)"
  fi

  passo "armazenamento — objeto por sha256 no MinIO  [degrau b]"
  if [ "$APPLY" -eq 1 ]; then python3 scripts/ingerir-acervo.py "$RAIZ" acervo/manifest.jsonl
  else python3 scripts/ingerir-acervo.py "$RAIZ" acervo/manifest.jsonl --dry-run; fi

  passo "filas — read-only, determinístico"
  python3 scripts/fila-acervo.py

  passo "catalogação — cria a obra dos objetos sem obra  [degrau a]"
  if seco "cli carregar-acervo --apply"; then "$PY" -m rag_extractor.cli carregar-acervo --apply
  else "$PY" -m rag_extractor.cli carregar-acervo; fi
fi

passo "materialização — PDF e sidecar em $DESTINO"
mkdir -p "$DESTINO"
if seco "cli materializar-acervo $DESTINO --apply"; then
  "$PY" -m rag_extractor.cli materializar-acervo "$DESTINO" --apply
else "$PY" -m rag_extractor.cli materializar-acervo "$DESTINO"; fi

passo "chunking  [degrau c]"
seco "cli ingest $DESTINO" && "$PY" -m rag_extractor.cli ingest "$DESTINO"

passo "vetor de texto  [degrau d]"
seco "cli embed" && "$PY" -m rag_extractor.cli embed

passo "propagação de faceta para documents/chunks"
if seco "cli sincronizar-acervo --apply"; then "$PY" -m rag_extractor.cli sincronizar-acervo --apply
else "$PY" -m rag_extractor.cli sincronizar-acervo; fi

passo "vetor de metadado  [degrau e]"
seco "cli embed-meta" && "$PY" -m rag_extractor.cli embed-meta

passo "escada depois"
"$AQUI/escada" | sed -n '/catalogadas/,/vetorizadas/p'

if [ "$APPLY" -eq 1 ]; then
  echo "
Falta publicar: o export e as chamadas Cargo não são ingestão.
  PlataFirma:Ops/sincronizar-o-acervo, passos 3 e 6"
else
  ALVO=$([ "$PLANILHA" -eq 1 ] && echo "--planilha ${ODS:-}" || echo "$RAIZ")
  echo "
DRY-RUN — nada foi escrito. Para valer:  acervo ingerir $ALVO --apply"
fi
