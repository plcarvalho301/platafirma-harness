#!/usr/bin/env python3
# acervo ler <particao> secao — o texto da seção pelo endereço que a busca devolve (#3312).
# capacidade: conhecimento
# dono: dados
#
# arq:0119 §1.2 e §3: a busca (motor, ia) devolve endereço, escore e cobertura; a consulta
# termina com a fonte entregue pelo acervo. Este sub-ato é a entrega: recebe o `secao_id` que
# `motor rag buscar ... --texto nenhum` devolve e serve o texto inteiro da seção.
#
#   acervo ler casa       secao <secao_id> [<secao_id> ...] [--json]
#   acervo ler biblioteca secao <secao_id> [<secao_id> ...] [--json]
#
# Contrato do texto: o mesmo de `textos_de_secao` do motor (platafirma-conhecimento,
# rag/motor_acervo/store/acervo_store.py): partes da seção que não são `is_not_text`, em
# ordem de `part_idx` e `ordem_leitura` (nulos primeiro), unidas por quebra de linha. Só serve
# seção de impressão servindo; casa retirada e obra expurgada não servem texto.
#
# exit: 0 todas achadas · 1 alguma não achada (as achadas saem igual) · 2 uso · 3 banco fora.
# Read-only.
import json
import os
import re
import signal
import subprocess
import sys

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"

UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")

USO = """uso:
  acervo ler casa       secao <secao_id> [<secao_id> ...] [--json]
  acervo ler biblioteca secao <secao_id> [<secao_id> ...] [--json]
      o texto inteiro da seção pelo endereço que a busca devolve
      (motor rag buscar <particao> "<pergunta>" --texto nenhum → secao_id).
exit: 0 todas achadas · 1 alguma não achada · 2 uso · 3 banco fora."""

# Uma linha por seção: o texto agregado na ordem do motor e o endereço legível.
SQL = {
    "casa": """
select coalesce(json_agg(row_to_json(t)), '[]') from (
  select s.id::text as secao_id,
         case when c.chave is null then c.repo || '@' || c.path
              when c.serie is not null then c.chave
              else coalesce(et.slug || ' ', '') || c.chave end as arquivo,
         s.ancora, s.hierarquia as breadcrumb,
         string_agg(t.texto, E'\\n' order by t.part_idx nulls first, t.ordem_leitura nulls first)
           filter (where not t.is_not_text) as texto
    from acervo.casa_secao s
    join acervo.casa_trecho t    on t.casa_secao_id = s.id
    join acervo.casa_impressao i on i.id = t.casa_impressao_id and i.estado = 'servindo'
    join acervo.casa c           on c.id = i.casa_id and c.retirada_em is null
    left join acervo.especie_tipo et on et.id = c.especie_id
   where s.id = any(%s::uuid[])
   group by s.id, c.chave, c.serie, c.repo, c.path, et.slug, s.ancora, s.hierarquia
) t;
""",
    "biblioteca": """
select coalesce(json_agg(row_to_json(t)), '[]') from (
  select s.id::text as secao_id, o.arquivo, o.id::text as obra_id,
         s.ancora, s.hierarquia as breadcrumb,
         string_agg(t.texto, E'\\n' order by t.part_idx nulls first, t.ordem_leitura nulls first)
           filter (where not t.is_not_text) as texto
    from acervo.secao s
    join acervo.trecho t    on t.secao_id = s.id
    join acervo.impressao i on i.id = t.impressao_id and i.estado = 'servindo'
    join acervo.obra o      on o.id = i.obra_id and o.expurgada_em is null
   where s.id = any(%s::uuid[])
   group by s.id, o.arquivo, o.id, s.ancora, s.hierarquia
) t;
""",
}


def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def _psql_json(sql):
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    try:
        saida = subprocess.run(
            ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-tA", "-c", sql],
            capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo ler secao: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo ler secao: psql falhou (rc=%s):\n%s"
              % (e.returncode, (e.stderr or "").strip()), 3)
    try:
        return json.loads(saida) if saida.strip() else []
    except (ValueError, TypeError) as e:
        morre("acervo ler secao: psql nao devolveu JSON (%s):\n  %s" % (e, saida[:200]), 3)


def montar_sql(particao, ids):
    """O SELECT da partição com o array de uuids validados. Os ids já passaram pela regex de
    uuid, então o literal não carrega nada além de hex e hífen."""
    arr = "'{" + ",".join(i.lower() for i in ids) + "}'"
    return SQL[particao] % arr


def ler(particao, ids, quero_json, psql=None):
    psql = psql or _psql_json
    linhas = psql(montar_sql(particao, ids))
    por_id = {l["secao_id"]: l for l in linhas if l.get("texto") is not None}
    achadas = [dict(por_id[i.lower()], particao=particao) for i in ids if i.lower() in por_id]
    faltam = [i for i in ids if i.lower() not in por_id]
    if quero_json:
        print(json.dumps({"secoes": achadas, "nao_achadas": faltam}, ensure_ascii=False, indent=2))
    else:
        for n, s in enumerate(achadas):
            if n:
                print()
            print("== %s · %s · %s" % (s["secao_id"], s["arquivo"], s["ancora"]))
            print(s["texto"])
    for i in faltam:
        sys.stderr.write("acervo ler %s secao: %s nao serve texto (secao inexistente, de outra "
                         "particao, impressao fora de servico ou fonte retirada).\n" % (particao, i))
    return 1 if faltam else 0


def main(argv):
    # Invocado pelo despachante como: _acervo/secao <particao> <secao_id>... [--json]
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)
    particao, resto = argv[0], argv[1:]
    if particao not in SQL:
        morre("acervo ler secao: particao '%s' sem secao (casa, biblioteca).\n\n%s" % (particao, USO), 2)
    quero_json = "--json" in resto
    ids = [a for a in resto if a != "--json"]
    if not ids:
        morre("acervo ler %s secao: falta o secao_id.\n\n%s" % (particao, USO), 2)
    ruins = [i for i in ids if not UUID.match(i)]
    if ruins:
        morre("acervo ler %s secao: secao_id nao e uuid: %s\n\n%s" % (particao, ", ".join(ruins), USO), 2)
    return ler(particao, ids, quero_json)


if __name__ == "__main__":
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    sys.exit(main(sys.argv[1:]))
