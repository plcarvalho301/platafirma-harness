#!/usr/bin/env python3
# acervo ler <particao> secao — o texto da seção pelo endereço que a busca devolve (#3312).
# capacidade: conhecimento
# dono: dados
#
# arq:0119 §1.2 e §3: a busca (motor, ia) devolve endereço, escore e cobertura; a consulta
# termina com a fonte entregue pelo acervo. Cliente fino da rota POST /acervo/secoes/consulta do
# motor do acervo (platafirma-conhecimento, rotas_secoes.py): a leitura é uma só, a da rota, e o
# Recuperador e este verbo leem o mesmo texto.
#
#   acervo ler casa       secao <secao_id> [<secao_id> ...] [--json]
#   acervo ler biblioteca secao <secao_id> [<secao_id> ...] [--json]
#
# exit: 0 todas achadas · 1 alguma não achada (as achadas saem igual) · 2 uso · 3 rota fora ·
# 5 indeterminável. Read-only.
import json
import os
import re
import signal
import sys
from pathlib import Path

HARNESS_DIR = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(HARNESS_DIR))
sys.path.insert(0, str(HARNESS_DIR / "lib"))

try:
    from recuperacao.adaptadores.motor_acervo_rest import BASE as DEFAULT_BASE
    from recuperacao.adaptadores.motor_acervo_rest import TOKEN as DEFAULT_TOKEN
except ImportError:
    DEFAULT_BASE, DEFAULT_TOKEN = "http://127.0.0.1:8100", ""

BASE = (os.environ.get("MOTOR_ACERVO_URL") or os.environ.get("RAG_API_URL")
        or os.environ.get("RAG_API_BASE") or DEFAULT_BASE).rstrip("/")
TOKEN = os.environ.get("RAG_API_TOKEN") or DEFAULT_TOKEN
ROTA = "/acervo/secoes/consulta"

UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
PARTICOES = ("casa", "biblioteca")

USO = """uso:
  acervo ler casa       secao <secao_id> [<secao_id> ...] [--json]
  acervo ler biblioteca secao <secao_id> [<secao_id> ...] [--json]
      o texto inteiro da seção pelo endereço que a busca devolve
      (motor rag buscar <particao> "<pergunta>" --texto nenhum → secao_id).
      rota: POST /acervo/secoes/consulta {particao, secao_ids}.
exit: 0 todas achadas · 1 alguma não achada · 2 uso · 3 rota fora · 5 indeterminável."""


class Falha(Exception):
    def __init__(self, codigo, msg):
        super().__init__(msg)
        self.codigo = codigo


def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def _post(corpo):
    import requests

    headers = {"accept": "application/json"}
    if TOKEN:
        headers["authorization"] = f"Bearer {TOKEN}"
    try:
        resp = requests.post(f"{BASE}{ROTA}", json=corpo, headers=headers, timeout=60)
    except requests.exceptions.ConnectionError as e:
        raise Falha(3, f"rota fora: motor do acervo não respondeu em {BASE} ({e.__class__.__name__})") from e
    except requests.exceptions.RequestException as e:
        raise Falha(5, f"indeterminavel: {e}") from e
    if resp.status_code >= 400:
        try:
            pj = resp.json()
        except ValueError:
            pj = {"title": f"HTTP {resp.status_code}", "detail": resp.text[:300]}
        raise Falha(5 if resp.status_code >= 500 else 2, f"{pj.get('title')}: {pj.get('detail')}")
    return resp.json()


def ler(particao, ids, quero_json, post=None):
    post = post or _post
    dados = post({"particao": particao, "secao_ids": ids})
    achadas = dados.get("secoes") or []
    faltam = dados.get("nao_achadas") or []
    if quero_json:
        print(json.dumps({"secoes": achadas, "nao_achadas": faltam}, ensure_ascii=False, indent=2))
    else:
        for n, s in enumerate(achadas):
            if n:
                print()
            print("== %s · %s · %s" % (s["secao_id"], s["arquivo"], s["ancora"]))
            print(s["texto"])
    for i in faltam:
        sys.stderr.write("acervo ler %s secao: %s nao serve texto (secao inexistente, de outra "
                         "particao, impressao fora de servico ou fonte retirada).\n" % (particao, i))
    return 1 if faltam else 0


def main(argv):
    # Invocado pelo despachante como: _acervo/secao <particao> <secao_id>... [--json]
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)
    particao, resto = argv[0], argv[1:]
    if particao not in PARTICOES:
        morre("acervo ler secao: particao '%s' sem secao (casa, biblioteca).\n\n%s" % (particao, USO), 2)
    quero_json = "--json" in resto
    ids = [a for a in resto if a != "--json"]
    if not ids:
        morre("acervo ler %s secao: falta o secao_id.\n\n%s" % (particao, USO), 2)
    ruins = [i for i in ids if not UUID.match(i)]
    if ruins:
        morre("acervo ler %s secao: secao_id nao e uuid: %s\n\n%s" % (particao, ", ".join(ruins), USO), 2)
    try:
        return ler(particao, ids, quero_json)
    except Falha as f:
        sys.stderr.write("acervo ler %s secao: %s\n" % (particao, f))
        return f.codigo


if __name__ == "__main__":
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    sys.exit(main(sys.argv[1:]))
