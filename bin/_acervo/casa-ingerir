#!/usr/bin/env python3
# _acervo/casa-ingerir — cliente fino da ingestão da partição `casa` (card #3027, arq:0115).
# capacidade: incorporacao
# dono: claudinho-dados
#   (recorte de dados: o que vai no payload e o que o plano diz · dono; o mecanismo HTTP
#    espelha bin/ingerir de obra · construcao TI)
#
# Documento de casa é ficha do acervo, e o arquivo em git é o suporte dela (arq:0115 §1).
# O suporte é `platafirma-casa`, fora do release (§1.2); a ingestão lê o OBJETO GIT pelo sha
# (§8.1), num espelho bare da instância (padrão do `.repo.git` de bin/release; ver
# _acervo/_suporte.py). Este cliente:
#   1. garante o espelho (clone --bare na 1ª vez) e busca o forge com a credencial da conta;
#   2. resolve `platafirma-casa[@<rev>]` (sem @: origin/main; rev tem de ser ancestral dele);
#   3. lista a árvore (`ls-tree -r`) e lê os corpos num processo só (`cat-file --batch`);
#   4. manda todo `*.md` (menos README) como {repo, path, sha_ref, titulo, corpo} —
#      espécie, subtipo, chave, ciclo, dono e Sobre: o SERVIDOR tira do corpo e do caminho,
#      predicado único de admissão (§7, contrato de dados D5/D6);
#   5. recusa AQUI a fonte de diagrama (.mmd/.d2) sem o documento que ilustra (§7, D5
#      predicado 8): diagrama não vai ao servidor;
#   6. POST /acervo/casa/lotes (dry-run) e .../aplicar (--apply), com poll — espelha ingerir.
# Lote da árvore inteira leva `fonte.arvore_completa=true`: linha viva que saiu do suporte
# ganha `retirar` no servidor (§3.5, D4). Recorte (--so/--limite) nunca retira.
import argparse
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _suporte  # noqa: E402
from _suporte import SUPORTE  # noqa: E402

HARNESS_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if HARNESS_DIR not in sys.path:
    sys.path.insert(0, HARNESS_DIR)

try:
    from recuperacao.adaptadores.motor_acervo_rest import BASE as DEFAULT_BASE, TOKEN as DEFAULT_TOKEN
except ImportError:
    DEFAULT_BASE = "http://127.0.0.1:8100"
    DEFAULT_TOKEN = ""

BASE = (os.environ.get("RAG_API_BASE") or DEFAULT_BASE).rstrip("/")
TOKEN = os.environ.get("RAG_API_TOKEN") or DEFAULT_TOKEN

TETO_ITENS = 500           # TETO_ITENS do servidor (casa_lotes.py); o suporte tem ~385 docs
DEGRAUS = ("catalogar", "chunk", "embed", "vetor")
VEREDITOS = ("criar", "edicao", "ja_ingerido", "reprovado", "retirar")
RE_REV = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/~^-]{0,199}")
RE_DIAGRAMA = re.compile(r"(\.\d+)?\.(mmd|d2)$")
MAIN = "refs/remotes/origin/main"

USO = """uso:
  acervo ingerir casa platafirma-casa[@<rev>] [--apply] [--motor rag] [--ate vetor]
                      [--autor <slug>] [--so <substr>] [--limite N] [--json]

  platafirma-casa[@<rev>]  o suporte da particao casa (arq:0115 §1.2), unico repo aceito.
               Sem @: origin/main do espelho, depois do fetch (o sha resolvido sai no stderr).
               <rev> (sha ou tag) tem de ser ancestral de origin/main: so o que entrou em
               main se ingere (§8.1).
  fonte        espelho bare <instancia>/var/acervo/suporte/platafirma-casa.git
               (PF_SUPORTE_ESPELHO), buscado do forge com a credencial da conta
               (PF_SUPORTE_URL). Nunca release, nunca bancada.
  o que vai    todo *.md da arvore (README fica fora) como {repo, path, sha_ref, titulo,
               corpo}; especie, chave, ciclo, dono e Sobre: o servidor tira do corpo e do
               caminho (§2, §3, §6, §7). Fonte de diagrama (.mmd/.d2) nao vai ao servidor:
               sem o documento que ilustra, e recusada aqui (§7).
  --so <s>     so documentos cujo caminho contem <s>   } recorte: o lote nao e a arvore
  --limite N   so os N primeiros documentos           } completa, e nada se retira
  --apply      aplica (default: dry-run do plano, nada escrito no acervo)
  --ate        catalogar | chunk | embed | vetor (default: vetor)
  --json       o plano inteiro (lote do servidor + recusas locais) em JSON

  exit: 0 limpo · 3 com recusa (dry-run) · 1 erro (forge, rev, motor, lote falhou) · 2 uso

  Toda escrita no acervo e do servidor (POST /acervo/casa/lotes): casa, impressao, trechos,
  indices, retirada e acervo.casa_fonte. Este cliente so escreve o espelho da instancia.
"""


def morre(msg, code=1):
    sys.stderr.write("acervo ingerir casa: " + msg.rstrip("\n") + "\n")
    sys.exit(code)


# ------------------------------------------------------------------ fonte: espelho e sha

def parse_fonte(arg):
    """`platafirma-casa[@<rev>]` -> (repo, rev|None). Outro repo recusa (uso, exit 2)."""
    arg = (arg or SUPORTE).strip()
    repo, _, rev = arg.partition("@")
    if repo != SUPORTE:
        morre(f"fonte '{arg}' recusada: documento de casa mora so no suporte {SUPORTE} "
              f"(arq:0115 §1.2, §10); a forma e `acervo ingerir casa {SUPORTE}[@<rev>]`.", 2)
    if not rev:
        return repo, None
    if not RE_REV.fullmatch(rev):
        morre(f"rev invalida: '{rev}' (sha, tag ou origin/<ramo>).", 2)
    return repo, rev


def garantir_espelho(esp, url):
    """Espelho bare do suporte, no molde de `garantir_espelho` de bin/release: clona da URL
    na 1ª vez, realinha o origin se divergir, busca refs/remotes/origin/* e tags, e expurga
    refs/heads/* (fóssil do clone --bare, arq:0074). Forge fora do ar ou sem credencial: 1."""
    if not os.path.isdir(esp):
        try:
            os.makedirs(os.path.dirname(esp), exist_ok=True)
        except OSError as e:
            morre(f"nao criei a morada do espelho {os.path.dirname(esp)}: {e}", 1)
        r = _suporte.git_sem_dir("clone", "-q", "--bare", url, esp)
        if r.returncode != 0:
            morre(f"forge fora do ar ou sem credencial da conta: clone --bare de {url} em "
                  f"{esp} falhou:\n{_suporte.texto(r.stderr)}", 1)
    else:
        atual = _suporte.texto(_suporte.git(esp, "remote", "get-url", "origin").stdout)
        if atual != url:
            r = _suporte.git(esp, "remote", "set-url", "origin", url)
            if r.returncode != 0:
                _suporte.git(esp, "remote", "add", "origin", url)
            sys.stderr.write(f"espelho: origin realinhado a {url}\n")
    r = _suporte.git(esp, "fetch", "-q", "--prune", "origin",
                     "+refs/heads/*:refs/remotes/origin/*", "+refs/tags/*:refs/tags/*")
    if r.returncode != 0:
        morre(f"forge fora do ar ou sem credencial da conta: fetch em {esp} falhou:\n"
              f"{_suporte.texto(r.stderr)}", 1)
    fosseis = _suporte.texto(_suporte.git(esp, "for-each-ref", "--format=%(refname)",
                                          "refs/heads/").stdout)
    for ref in fosseis.splitlines():
        if ref.strip():
            _suporte.git(esp, "update-ref", "-d", ref.strip())


def resolver_rev(esp, rev):
    """sha de 40 hex. Sem rev: origin/main. Com rev: tem de existir e ser ancestral de main."""
    alvo = rev or MAIN
    r = _suporte.git(esp, "rev-parse", "--verify", "-q", alvo + "^{commit}")
    sha = _suporte.texto(r.stdout)
    if r.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", sha):
        if rev:
            morre(f"rev '{rev}' nao existe no espelho {esp} (depois do fetch).", 1)
        morre(f"espelho {esp} sem {MAIN}: o forge nao tem main?", 1)
    if rev:
        r = _suporte.git(esp, "merge-base", "--is-ancestor", sha, MAIN)
        if r.returncode == 1:
            morre(f"{rev} ({sha[:12]}) nao e ancestral de origin/main: so o que entrou em "
                  f"main do suporte se ingere (arq:0115 §8.1).", 1)
        if r.returncode != 0:
            morre(f"merge-base falhou no espelho {esp}:\n{_suporte.texto(r.stderr)}", 1)
    return sha


def ler_arvore(esp, sha):
    """Caminhos de blob da árvore do commit, na ordem do git (ls-tree -r -z)."""
    r = _suporte.git(esp, "ls-tree", "-r", "-z", "--name-only", sha)
    if r.returncode != 0:
        morre(f"ls-tree de {sha[:12]} falhou:\n{_suporte.texto(r.stderr)}", 1)
    return [p.decode("utf-8", "surrogateescape") for p in r.stdout.split(b"\0") if p]


def classificar(arvore):
    """(docs, diagramas, ignorados). Doc = *.md fora README; diagrama = .mmd/.d2."""
    docs, diagramas, ignorados = [], [], []
    for p in arvore:
        base = p.rsplit("/", 1)[-1]
        if "\n" in p:
            ignorados.append(p)
        elif base.endswith(".md"):
            (ignorados if base.lower().startswith("readme") else docs).append(p)
        elif RE_DIAGRAMA.search(base):
            diagramas.append(p)
        else:
            ignorados.append(p)
    return docs, diagramas, ignorados


def recusas_diagrama(diagramas, arvore):
    """Predicado 8 (D5): a fonte de diagrama ilustra o documento de mesmo prefixo, sem o
    sufixo `(.N).mmd|.d2` (arq:0115 §9.1: `spec/acervo.1.mmd` -> `spec/acervo.md`). Sem ele
    na árvore, recusa local, com motivo; nada disso vai ao servidor."""
    presentes = set(arvore)
    recusas = []
    for p in diagramas:
        doc = RE_DIAGRAMA.sub(".md", p)
        if doc not in presentes:
            recusas.append({
                "path": p, "portao": "diagrama", "resultado": "reprovado",
                "motivo": f"fonte de diagrama sem documento: {doc} nao existe na arvore "
                          f"(arq:0115 §7, §9.1)",
            })
    return recusas


def ler_corpos(esp, sha, paths):
    """Corpo de cada caminho num processo só: `cat-file --batch`, uma linha `<sha>:<path>`
    por arquivo. Saída: `<obj> blob <tam>\\n<conteudo>\\n` ou `<nome> missing\\n`."""
    if not paths:
        return {}
    entrada = "".join(f"{sha}:{p}\n" for p in paths).encode("utf-8", "surrogateescape")
    r = _suporte.git(esp, "cat-file", "--batch", entrada=entrada)
    if r.returncode != 0:
        morre(f"cat-file --batch falhou:\n{_suporte.texto(r.stderr)}", 1)
    out, pos, corpos = r.stdout, 0, {}
    for p in paths:
        nl = out.find(b"\n", pos)
        if nl < 0:
            morre(f"cat-file --batch cortou a saida em {p}", 1)
        cab = out[pos:nl].decode("utf-8", "replace").split()
        pos = nl + 1
        if len(cab) != 3 or cab[1] != "blob":
            morre(f"{p}: objeto ausente ou nao-blob em {sha[:12]} ({' '.join(cab)})", 1)
        tam = int(cab[2])
        corpos[p] = out[pos:pos + tam].decode("utf-8", "replace")
        pos += tam + 1
    return corpos


def titulo_do_corpo(corpo, path):
    """1º H1 (`# `, fora de bloco de código) sem o `#`; sem H1, o nome do arquivo."""
    cerca = False
    for linha in corpo.lstrip("﻿").splitlines():
        s = linha.strip()
        if s.startswith("```") or s.startswith("~~~"):
            cerca = not cerca
            continue
        if not cerca and s.startswith("# "):
            return s[2:].strip().rstrip("#").strip() or os.path.splitext(os.path.basename(path))[0]
    return os.path.splitext(os.path.basename(path))[0]


def montar_itens(sha, docs, corpos):
    return [{
        "repo": SUPORTE, "path": p, "sha_ref": sha,
        "titulo": titulo_do_corpo(corpos[p], p), "corpo": corpos[p],
    } for p in docs]


def montar_payload(autor, motor, ate, fonte, itens):
    """Payload D6: o servidor tira tudo o mais do corpo e do path (predicado único)."""
    return {
        "autor": autor, "motor": motor, "ate": ate,
        "fonte": {"repo": fonte["repo"], "sha": fonte["sha"],
                  "arvore_completa": bool(fonte["arvore_completa"])},
        "itens": itens,
    }


# ------------------------------------------------------------------ HTTP

def _http():
    try:
        import requests
    except ImportError:
        morre("python sem o modulo requests: o cliente nao fala com o motor acervo.", 1)
    return requests


def _headers():
    return {"authorization": f"Bearer {TOKEN}"} if TOKEN else {}


def _problema(resp):
    try:
        pj = resp.json()
        return f"erro {resp.status_code} ({pj.get('title')}): {pj.get('detail', resp.text)}"
    except ValueError:
        return f"erro {resp.status_code}: {resp.text}"


def postar_lote(payload):
    requests = _http()
    try:
        resp = requests.post(f"{BASE}/acervo/casa/lotes", json=payload, headers=_headers())
    except requests.exceptions.RequestException as e:
        morre(f"motor acervo indisponivel em {BASE}: {e}", 1)
    if resp.status_code != 201:
        morre(_problema(resp), 1)
    return resp.json()


def aplicar_lote(lote_id):
    requests = _http()
    try:
        ra = requests.post(f"{BASE}/acervo/casa/lotes/{lote_id}/aplicar", headers=_headers())
    except requests.exceptions.RequestException as e:
        morre(f"aplicar falhou: {e}", 1)
    if ra.status_code not in (200, 202):
        morre(f"aplicar {_problema(ra)}", 1)
    while True:
        time.sleep(1.0)
        try:
            rc = requests.get(f"{BASE}/acervo/lotes/{lote_id}", headers=_headers(), timeout=60)
        except requests.exceptions.RequestException as e:
            morre(f"poll falhou: {e}", 1)
        if rc.status_code != 200:
            continue
        atual = rc.json()
        if atual.get("estado") in ("concluido", "falhou"):
            return atual


# ------------------------------------------------------------------ plano

def _curto(arquivo):
    pre = SUPORTE + "@"
    if not arquivo:
        return "-"
    return arquivo[len(pre):] if arquivo.startswith(pre) else arquivo


def _portoes(it, resultado):
    out = []
    for p in it.get("portoes") or []:
        if p.get("resultado") == resultado:
            det = p.get("detail") or p.get("title") or ""
            out.append(f"{p.get('portao')}: {det}" if det else str(p.get("portao")))
    return out


def _legado(it):
    """Nova versão recusada de linha que já existe: a linha NÃO se retira, segue servindo a
    versão anterior (D4). O servidor devolve casa_id da linha casada (D6) ou diz 'legado'."""
    if it.get("veredito") != "reprovado":
        return False
    if it.get("casa_id"):
        return True
    return "legado" in json.dumps(it.get("portoes") or [], ensure_ascii=False).lower()


def _linha_retirada(it):
    classif = it.get("classificacao") or {}
    origem = it.get("origem") or {}
    chave = classif.get("chave") or origem.get("chave")
    suc = classif.get("substituida_por") or origem.get("substituida_por")
    s = it.get("arquivo") or "-"
    if chave:
        s = f"{chave} ({s})"
    return s + (f" -> substituida por {suc}" if suc else " (sem sucessora declarada)")


def contagem(lote, campo="veredito"):
    cont = {}
    for it in lote.get("itens") or []:
        v = it.get(campo) or "?"
        cont[v] = cont.get(v, 0) + 1
    return cont


def tem_recusa(lote, recusas_locais):
    return bool(recusas_locais) or any(
        it.get("veredito") == "reprovado" for it in lote.get("itens") or [])


def plano(lote, fonte, recusas_locais, ignorados, aplicado=False):
    """Resumo por veredito, recusas com motivo, avisos (estrato), retiradas, legado mantido."""
    itens = lote.get("itens") or []
    L = []
    modo = "aplicado" if aplicado else "dry-run"
    L.append(f"Plano de ingestao casa: {fonte['repo']}@{fonte['sha'][:12]} · "
             f"lote {lote.get('id')} ({modo})")
    escopo = ("arvore completa: linha viva fora da arvore sai por `retirar`"
              if fonte["arvore_completa"] else "recorte (--so/--limite): nada se retira")
    L.append(f"Fonte: espelho {fonte['espelho']} · {fonte['docs']} doc(s) enviado(s) · {escopo}")
    L.append(f"Autor: {lote.get('autor')} · Motor: {lote.get('motor')} · Ate: {lote.get('ate')}")
    cont = contagem(lote)
    ordem = [v for v in VEREDITOS if v in cont] + sorted(v for v in cont if v not in VEREDITOS)
    partes = [f"total={len(itens)}"] + [f"{v}={cont[v]}" for v in ordem]
    if recusas_locais:
        partes.append(f"recusa_local={len(recusas_locais)}")
    L.append("Resumo: " + " | ".join(partes))
    if aplicado:
        est = contagem(lote, "estado")
        L.append("Estado dos itens: " + " | ".join(f"{k}={v}" for k, v in sorted(est.items())))
    if ignorados:
        L.append(f"Ignorados (nao sao documento: README, .gitkeep, outros): {len(ignorados)}")

    def secao(titulo, linhas):
        if linhas:
            L.append("")
            L.append(f"{titulo} ({len(linhas)}):")
            L.extend(f"  - {x}" for x in linhas)

    reprov = [it for it in itens if it.get("veredito") == "reprovado"]
    secao("Recusas", [f"{_curto(it.get('arquivo'))}: "
                      f"{'; '.join(_portoes(it, 'reprovado')) or 'reprovado sem portao nomeado'}"
                      for it in reprov])
    secao("Recusas locais, nao enviadas (arq:0115 §7, diagrama)",
          [f"{r['path']}: {r['motivo']}" for r in recusas_locais])
    secao("Avisos", [f"{_curto(it.get('arquivo'))}: {'; '.join(_portoes(it, 'aviso'))}"
                     for it in itens if _portoes(it, "aviso")])
    secao("Retiradas", [_linha_retirada(it) for it in itens if it.get("veredito") == "retirar"])
    secao("Legado mantido (nova versao recusada; a linha segue servindo a versao anterior)",
          [_curto(it.get("arquivo")) for it in reprov if _legado(it)])
    L.append("")
    L.append("item a item: --json")
    return "\n".join(L)


def pos_lote(lote, fonte, recusas_locais, aplicado):
    """PONTO DE EXTENSÃO (arq:0115 §7.4 e §8.1; item Aberto da TI). Aqui entram, quando
    decididos: a notificação da admissão e da recusa a quem gravou, pela `fila`, com tipo
    próprio `recusa`, motivo e caminho; e o gatilho da ingestão no merge em main do suporte.
    Hoje não faz nada: o plano impresso é o único canal."""
    return None


# ------------------------------------------------------------------ main

def main(argv=None):
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("fonte", nargs="?", default=None)
    ap.add_argument("--apply", action="store_true", default=False)
    ap.add_argument("--motor", default="rag")
    ap.add_argument("--ate", default="vetor")
    ap.add_argument("--autor", default=None)
    ap.add_argument("--limite", type=int, default=0)
    ap.add_argument("--so", default=None)
    ap.add_argument("--json", dest="como_json", action="store_true", default=False)
    ap.add_argument("-h", "--help", "--ajuda", dest="ajuda", action="store_true", default=False)
    args, resto = ap.parse_known_args(argv)

    if args.ajuda:
        sys.stderr.write(USO)
        sys.exit(0)
    if resto:
        morre(f"argumento(s) nao reconhecido(s): {' '.join(resto)} (lista curada, --adr e "
              f"repo de release sairam com arq:0115).\n\n{USO}", 2)
    if args.ate not in DEGRAUS:
        morre(f"--ate invalido: {args.ate} ({', '.join(DEGRAUS)})", 2)
    if args.limite < 0:
        morre(f"--limite invalido: {args.limite}", 2)
    repo, rev = parse_fonte(args.fonte)

    autor = args.autor
    if not autor:
        cad = os.environ.get("PF_CADEIRA", "").strip().lower()
        cad = cad.removeprefix("claudinho-").removeprefix("claudinha-")
        autor = cad or "dados"

    esp, url = _suporte.espelho(), _suporte.url()
    garantir_espelho(esp, url)
    sha = resolver_rev(esp, rev)
    if rev is None:
        sys.stderr.write(f"acervo ingerir casa: {repo} sem @<rev> = origin/main em {sha}\n")

    arvore = ler_arvore(esp, sha)
    docs, diagramas, ignorados = classificar(arvore)
    recusas_locais = recusas_diagrama(diagramas, arvore)
    if args.so:
        docs = [p for p in docs if args.so in p]
        recusas_locais = [r for r in recusas_locais if args.so in r["path"]]
    if args.limite:
        docs = docs[:args.limite]
    arvore_completa = not (args.so or args.limite)
    if not docs:
        # Árvore sem documento nunca vira lote: com arvore_completa, retiraria o acervo inteiro.
        morre(f"nenhum documento .md em {repo}@{sha[:12]}"
              + ("" if arvore_completa else " no recorte (--so/--limite)") + ".", 1)
    if len(docs) > TETO_ITENS:
        morre(f"{len(docs)} documentos passam do teto do servidor ({TETO_ITENS} por lote).", 1)

    corpos = ler_corpos(esp, sha, docs)
    itens = montar_itens(sha, docs, corpos)
    fonte = {"repo": repo, "sha": sha, "arvore_completa": arvore_completa}
    info = dict(fonte, espelho=esp, docs=len(itens))

    lote = postar_lote(montar_payload(autor, args.motor, args.ate, fonte, itens))

    if not args.apply:
        if args.como_json:
            print(json.dumps({"fonte": info, "lote": lote, "recusas_locais": recusas_locais,
                              "ignorados": ignorados}, indent=2, ensure_ascii=False))
        else:
            print(plano(lote, info, recusas_locais, ignorados))
        sys.exit(3 if tem_recusa(lote, recusas_locais) else 0)

    lote = aplicar_lote(lote["id"])
    pos_lote(lote, info, recusas_locais, aplicado=True)
    if args.como_json:
        print(json.dumps({"fonte": info, "lote": lote, "recusas_locais": recusas_locais,
                          "ignorados": ignorados}, indent=2, ensure_ascii=False))
    else:
        print(plano(lote, info, recusas_locais, ignorados, aplicado=True))
        print(f"\nestado final do lote: {lote.get('estado')}")
    sys.exit(0 if lote.get("estado") == "concluido" else 1)


