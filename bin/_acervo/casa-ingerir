def sha_do_repo(repo):
    """sha da familia na release no ar. Familia ausente -> None (item pula com aviso)."""
    dirf = dir_da_familia(repo)
    if not os.path.isdir(dirf):
        return None
    return sha_do_repo_dir(dirf)

def _override(cauda):
    """`path :: dono=x natureza=y ciclo=z tipo=w` -> (path, dict). Sufixo opcional por linha."""
    ov = {}
    if "::" in cauda:
        path, resto = cauda.split("::", 1)
        for par in resto.split():
            if "=" in par:
                k, v = par.split("=", 1)
                if k in ("dono", "natureza", "ciclo", "tipo"):
                    ov[k] = v.strip()
        return path.strip(), ov
    return cauda.strip(), ov

def parse_lista(caminho):
    """Le a lista curada. Devolve itens {repo, path, tipo, dono, natureza, ciclo}."""
    repo_atual = None
    especie_atual = None
    itens = []
    with open(caminho, encoding="utf-8") as f:
        for linha in f:
            s = linha.rstrip("\n")
            m_repo = re.match(r"^##\s+(\S+)\s*$", s)
            if m_repo:
                # `## platafirma-core / motor` -> primeiro token; docs trazem o repo no path.
                repo_atual = m_repo.group(1).strip()
                especie_atual = None
                continue
            m_sec = re.match(r"^###\s+(.+)$", s)
            if m_sec:
                rotulo = m_sec.group(1).lower()
                especie_atual = None
                for pista, esp in PISTA_ESPECIE.items():
                    if pista in rotulo:
                        especie_atual = esp
                        break
                if not especie_atual:
                    m_fam = re.search(r"\(([a-z-]+)\)", rotulo)
                    if m_fam:
                        especie_atual = FAMILIA_ESPECIE.get(m_fam.group(1))
                continue
            m_item = re.match(r"^-\s+(.+)$", s)
            if m_item and repo_atual:
                cauda, ov = _override(m_item.group(1))
                # path pode trazer o repo como prefixo (secao "core / motor"): se o primeiro
                # segmento e' uma familia conhecida na release, ele e' o repo e sai do path.
                repo = repo_atual
                path = cauda
                seg0 = cauda.split("/", 1)[0]
                if seg0 in REPO_DONO and os.path.isdir(dir_da_familia(seg0)):
                    repo = seg0
                    path = cauda.split("/", 1)[1]
                itens.append({
                    "repo": repo,
                    "path": path,
                    "tipo": ov.get("tipo") or especie_atual,
                    "dono": ov.get("dono") or REPO_DONO.get(repo, "arquiteto"),
                    "natureza": ov.get("natureza") or "golden",
                    "ciclo": ov.get("ciclo") or "publicado",
                })
    return itens

def montar_itens(curados, limite, so):
    """Resolve sha e le corpo de cada item. Devolve (itens_payload, pulos)."""
    itens, pulos = [], []
    sha_cache = {}
    for it in curados:
        chave = f"{it['repo']}@{it['path']}"
        if so and so not in chave:
            continue
        # Fonte ja resolvida (varre_repo / varre_adrs traz sha e corpo): respeita. Senao,
        # lista curada: sha da familia na release e corpo lido de la.
        sha = it.get("sha_ref")
        corpo = it.get("corpo")
        if not sha:
            if it["repo"] not in sha_cache:
                sha_cache[it["repo"]] = sha_do_repo(it["repo"])
            sha = sha_cache[it["repo"]]
        if not sha:
            pulos.append((chave, "familia ausente na release: " + dir_da_familia(it["repo"])))
            continue
        if corpo is None:
            fp = os.path.join(dir_da_familia(it["repo"]), it["path"])
            if not os.path.isfile(fp):
                pulos.append((chave, "arquivo nao existe na release"))
                continue
            try:
                with open(fp, encoding="utf-8", errors="replace") as f:
                    corpo = f.read()
            except OSError as e:
                pulos.append((chave, f"leitura falhou: {e}"))
                continue
        # Titulo: se o curado ja trouxe (fonte ADR), respeita; senao le o 1o `# ` do corpo.
        titulo = it.get("titulo")
        if not titulo:
            for linha in corpo.splitlines()[:15]:
                t = linha.strip()
                if t.startswith("# ") and not t.startswith("##"):
                    titulo = t.lstrip("#").strip()
                    break
        # Corpo: fonte ADR ja leu; lista curada le do disco aqui.
        corpo_final = it.get("corpo") or corpo
        itens.append({
            "repo": it["repo"], "path": it["path"], "sha_ref": sha,
            "dono": it["dono"], "tipo": it["tipo"] or "",
            "natureza": it["natureza"], "ciclo": it["ciclo"],
            "titulo": titulo or os.path.splitext(os.path.basename(it["path"]))[0],
            "corpo": corpo_final, "referentes": it.get("referentes") or [],
        })
        if limite and len(itens) >= limite:
            break
    return itens, pulos

def tabela_plano(lote, pulos):
    L = []
    total = len(lote.get("itens", []))
    resumo = {}
    for it in lote.get("itens", []):
        resumo[it.get("veredito", "?")] = resumo.get(it.get("veredito", "?"), 0) + 1
    L.append(f"Plano de ingestao casa: lote {lote.get('id')} (dry-run)")
    L.append(f"Autor: {lote.get('autor')} · Motor: {lote.get('motor')} · Ate: {lote.get('ate')}")
    L.append(f"Resumo: total={total} | " +
             " | ".join(f"{k}={v}" for k, v in sorted(resumo.items())))
    if pulos:
        L.append(f"Pulados antes do envio: {len(pulos)}")
        for chave, motivo in pulos:
            L.append(f"    - {chave}: {motivo}")
    L.append("")
    L.append(f"{'#':<3} {'repo@path':<52} {'veredito':<12} portoes")
    L.append("-" * 100)
    for it in lote.get("itens", []):
        pos = str(it.get("posicao", 0))
        arq = it.get("arquivo") or "-"
        if len(arq) > 50:
            arq = "..." + arq[-47:]
        ver = it.get("veredito") or "-"
        reprova = [f"{p.get('portao')}:{p.get('detail', p.get('title', ''))}"
                   for p in it.get("portoes", []) if p.get("resultado") == "reprovado"]
        det = "; ".join(reprova) if reprova else "ok"
        L.append(f"{pos:<3} {arq:<52} {ver:<12} {det}")
    return "\n".join(L)

def sha_do_repo_dir(repo_dir):
    """sha do checkout. A release materializa <familia>/<sha> (checkout destacado) e o
    atalho aponta para ele: sem git legivel ali, o proprio nome do diretorio e o sha."""
    try:
        r = subprocess.run([GIT, "-C", repo_dir, "rev-parse", "HEAD"],
                           capture_output=True, text=True, check=True)
        if r.stdout.strip():
            return r.stdout.strip()
    except Exception:
        pass
    nome = os.path.basename(os.path.realpath(repo_dir))
    return nome if re.fullmatch(r"[0-9a-f]{7,40}", nome) else None

def varre_repo(repo):
    """Varre o SERVIDO (<release>/<curto>, arq:0097, card #3010) e classifica por padrao_path.

    O atalho da release aponta para <familia>/current -> <sha>. Varre-se o destino
    resolvido, nunca a raiz da familia: a raiz dava caminho relativo `<sha>/docs/...`, que
    glob nenhum de padrao_path casa — e o verbo saia com "nenhum arquivo casa com
    padrao_path" mesmo com o repo inteiro no ar (medido 14/09, dados). Sem a familia na
    release, recusa: a bancada nao e fonte de casa.
    """
    caminho_prod = dir_da_familia(repo)
    if os.path.isdir(caminho_prod):
        repo_dir = os.path.realpath(caminho_prod)
    else:
        morre(f"repositorio '{repo}' nao encontrado na release: {caminho_prod}.", 1)

    sha = sha_do_repo_dir(repo_dir) or "desconhecido"
    sql_esp = "select coalesce(json_agg(row_to_json(t)), '[]') from (select slug, padrao_path from acervo.especie_tipo where padrao_path is not null) t;"
    especies = _identidade.psql_json(sql_esp, "especies")

    itens_aprovados = []
    itens_reprovados = []

    # So documento de texto e candidato: doc de casa e markdown de git. Diretorio de
    # ferramenta (node_modules, .git, venv) nem entra na conta de reprovados.
    PULA_DIR = {".git", "node_modules", ".venv", "venv", "__pycache__", ".cache"}
    for root, dirs, files in os.walk(repo_dir):
        dirs[:] = [d for d in dirs if d not in PULA_DIR and not d.startswith(".")]
        for f in sorted(files):
            if not f.endswith(".md"):
                continue
            rel = os.path.relpath(os.path.join(root, f), repo_dir)
            if f.upper().startswith(("README", "AGENTS", "CLAUDE")) or rel.startswith("abertura/"):
                continue

            match_esp = None
            dono_padrao = REPO_DONO.get(repo, "arquiteto")
            for esp in especies:
                for pat in esp.get("padrao_path", []):
                    if fnmatch.fnmatch(rel, pat):
                        match_esp = esp["slug"]
                        if esp.get("dono"):
                            dono_padrao = esp["dono"]
                        break
                if match_esp:
                    break

            if match_esp:
                try:
                    with open(os.path.join(repo_dir, rel), encoding="utf-8", errors="replace") as fh:
                        corpo = fh.read()
                except OSError:
                    corpo = ""
                titulo = None
                for linha in corpo.splitlines()[:15]:
                    t = linha.strip()
                    if t.startswith("# ") and not t.startswith("##"):
                        titulo = t.lstrip("#").strip()
                        break
                itens_aprovados.append({
                    "repo": repo, "path": rel, "sha_ref": sha,
                    "dono": dono_padrao, "tipo": match_esp,
                    "natureza": "golden", "ciclo": "publicado",
                    "titulo": titulo or os.path.splitext(os.path.basename(rel))[0],
                    "corpo": corpo, "referentes": [],
                    "veredito": "aprovado",
                })
            else:
                itens_reprovados.append({
                    "repo": repo, "path": rel, "sha_ref": sha,
                    "veredito": "reprovado",
                    "motivo": "nenhum padrao_path em acervo.especie_tipo cobre este caminho",
                })

    return repo, sha, repo_dir, itens_aprovados, itens_reprovados

def tabela_plano_repo(repo, sha, aprovados, reprovados):
    por_esp = {}
    for it in aprovados:
        esp = it["tipo"]
        por_esp[esp] = por_esp.get(esp, 0) + 1

    L = []
    L.append(f"Plano de ingestao casa: {repo}@{sha[:12]} (dry-run)")
    L.append(f"Total escaneado: {len(aprovados) + len(reprovados)} arquivos")
    L.append("Aprovados por espécie:")
    for esp, cnt in sorted(por_esp.items()):
        L.append(f"  - {esp:<20} : {cnt} doc(s)")
    L.append(f"Reprovados sem cobertura : {len(reprovados)} arquivo(s)")
    if reprovados:
        L.append("\nExemplos de reprovados (com motivo):")
        for r in reprovados[:10]:
            L.append(f"  - {r['path']}: {r['motivo']}")
        if len(reprovados) > 10:
            L.append(f"  ... e mais {len(reprovados) - 10} arquivo(s)")
    return "\n".join(L)

def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("lista", nargs="?", default=None)
    ap.add_argument("--apply", action="store_true", default=False)
    ap.add_argument("--motor", default="rag")
    ap.add_argument("--ate", default="vetor")
    ap.add_argument("--autor", default=None)
    ap.add_argument("--limite", type=int, default=0)
    ap.add_argument("--so", default=None)
    ap.add_argument("--adr", action="store_true", default=False)
    ap.add_argument("--json", dest="como_json", action="store_true", default=False)
    ap.add_argument("-h", "--help", "--ajuda", dest="ajuda", action="store_true", default=False)
    args, _ = ap.parse_known_args()

    if args.ajuda:
        sys.stderr.write(USO)
        sys.exit(0)
    if args.ate not in ("catalogar", "chunk", "embed", "vetor"):
        morre(f"--ate invalido: {args.ate}", 2)

    autor = args.autor
    if not autor:
        cad = os.environ.get("PF_CADEIRA", "").strip().lower()
        cad = cad.removeprefix("claudinho-").removeprefix("claudinha-")
        autor = cad or "dados"

    # Fonte (spec_acervo §6): `acervo ingerir casa <repo>` varre o repositorio inteiro e
    # classifica por especie_tipo.padrao_path. Toda ESCRITA vai pela rota do servidor
    # (POST /acervo/casa/lotes + aplicar), que grava casa, impressao, trechos, indices e
    # casa_fonte. O cliente nao toca o banco para escrever. Lista curada (arquivo) e --adr
    # seguem aceitos como fonte de transicao, pela mesma rota.
    pulos_previos = []
    cabecalho_plano = None
    if args.adr:
        curados = varre_adrs()
        if not curados:
            morre("nenhuma ADR encontrada em macro-global/ de " + ADR_REPO, 1)
    else:
        lista = args.lista or "platafirma-arquitetura"
        if os.path.isfile(lista):
            curados = parse_lista(lista)
            if not curados:
                morre(f"nenhum item na lista {lista}", 1)
        else:
            repo, sha, repo_dir, aprovados, reprovados = varre_repo(lista)
            curados = aprovados
            pulos_previos = [(f"{repo}@{r['path']}", r["motivo"]) for r in reprovados]
            cabecalho_plano = tabela_plano_repo(repo, sha, aprovados, reprovados)
            if not curados:
                morre(f"nenhum arquivo de {repo} casa com padrao_path de acervo.especie_tipo", 1)
    itens, pulos = montar_itens(curados, args.limite, args.so)
    # Reprovados da varredura ja saem resumidos no cabecalho do plano (contagem + 10
    # exemplos); no --json vao inteiros. Nao se despejam um a um na tabela do lote.
    if args.como_json:
        pulos = pulos_previos + pulos
    if cabecalho_plano and not args.como_json:
        print(cabecalho_plano)
        print()
    if not itens:
        # Os motivos saem AQUI: o caminho do --json fica depois do POST, entao mandar o dono
        # "ver com --json" era um beco — nenhum item, nenhum lote, nenhuma saida.
        detalhe = "\n".join(f"    - {chave}: {motivo}" for chave, motivo in pulos[:20])
        extra = f"\n    ... e mais {len(pulos) - 20}" if len(pulos) > 20 else ""
        morre(f"nenhum item ingerivel ({len(pulos)} pulados):\n{detalhe}{extra}", 1)

    headers = {}
    if TOKEN:
        headers["authorization"] = f"Bearer {TOKEN}"
    payload = {"autor": autor, "motor": args.motor, "ate": args.ate, "itens": itens}

    try:
        resp = requests.post(f"{BASE}/acervo/casa/lotes", json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        morre(f"motor acervo indisponivel em {BASE}: {e}", 1)
    if resp.status_code != 201:
        try:
            pj = resp.json()
            morre(f"erro {resp.status_code} ({pj.get('title')}): {pj.get('detail', resp.text)}", 1)
        except ValueError:
            morre(f"erro {resp.status_code}: {resp.text}", 1)

    lote = resp.json()
    lote_id = lote["id"]

    if not args.apply:
        if args.como_json:
            print(json.dumps({"lote": lote, "pulos": pulos}, indent=2, ensure_ascii=False))
        else:
            print(tabela_plano(lote, pulos))
        reprovados = sum(1 for it in lote.get("itens", []) if it.get("veredito") == "reprovado")
        sys.exit(3 if reprovados else 0)

    try:
        ra = requests.post(f"{BASE}/acervo/casa/lotes/{lote_id}/aplicar", headers=headers)
    except requests.exceptions.RequestException as e:
        morre(f"aplicar falhou: {e}", 1)
    if ra.status_code not in (200, 202):
        morre(f"aplicar {ra.status_code}: {ra.text}", 1)

    while True:
        time.sleep(1.0)
        try:
            rc = requests.get(f"{BASE}/acervo/lotes/{lote_id}", headers=headers)
        except requests.exceptions.RequestException as e:
            morre(f"poll falhou: {e}", 1)
        if rc.status_code != 200:
            continue
        atual = rc.json()
        if atual.get("estado") in ("concluido", "falhou"):
            lote = atual
            break

    if args.como_json:
        print(json.dumps({"lote": lote, "pulos": pulos}, indent=2, ensure_ascii=False))
    else:
        print(tabela_plano(lote, pulos))
        print(f"\nestado final do lote: {lote.get('estado')}")
    sys.exit(0 if lote.get("estado") == "concluido" else 1)

if __name__ == "__main__":
    main()
