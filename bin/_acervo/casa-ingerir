def _status_para_ciclo(status):
    s = (status or "").lower()
    if any(w in s for w in ("aceito", "aceita", "accepted")):
        return "publicado"
    if any(w in s for w in ("proposto", "proposta", "proposed")):
        return "minuta"
    if any(w in s for w in ("superado", "substitu", "superseded")):
        return "superado"
    return "publicado"

def _campo_cabecalho(corpo, rotulo):
    cabeca = corpo.split("\n##", 1)[0]
    m = re.search(r"^-\s+\*\*\s*" + re.escape(rotulo) + r"\s*:\*\*\s*(.+)$",
                  cabeca, re.M | re.I)
    return m.group(1).strip() if m else ""

def _titulo_adr(corpo):
    linha = corpo.splitlines()[0] if corpo.splitlines() else ""
    t = linha.lstrip("#").strip()
    for sep in (" \u2014 ", " -- ", " - "):
        if sep in t:
            return t.split(sep, 1)[1].strip()
    return t

def _referentes_adr(corpo, registro, numero):
    # Vocabulario FECHADO do enum acervo.casa_tipo_ref (045_acervo_casa.sql): o codigo da ADR
    # e' um referente de classe `decisao`, e Capability e' `capacidade`. Os termos que a
    # nomenclatura usava em prosa (`codigo`, `capability`) nao existem no enum e faziam o
    # lote inteiro falhar em InvalidTextRepresentation na hora de gravar o referente.
    refs = [{"tipo_ref": "decisao", "ref": f"{registro}:{numero}"}]
    for rotulo, tipo_ref in (("Capability", "capacidade"), ("Stack", "stack")):
        val = _campo_cabecalho(corpo, rotulo)
        for v in re.split(r"[,;]+", val):
            v = v.strip().lower()
            if v:
                refs.append({"tipo_ref": tipo_ref, "ref": v})
    return refs

def varre_adrs():
    """Varre os dois layouts de ADR e devolve itens JA prontos (titulo/ciclo/referentes/corpo)."""
    clone = dir_da_familia(ADR_REPO)
    itens = []

    def _um(caminho_abs, path_rel, registro):
        base = os.path.basename(path_rel)
        m = re.match(r"^(\d{3,4})-.+\.md$", base)
        if not m:
            return None
        numero = m.group(1).zfill(4)
        with open(caminho_abs, encoding="utf-8", errors="replace") as f:
            corpo = f.read()
        return {
            "repo": ADR_REPO, "path": path_rel, "tipo": "adr", "dono": "arquiteto",
            "natureza": "golden",
            "ciclo": _status_para_ciclo(_campo_cabecalho(corpo, "Status")),
            "titulo": _titulo_adr(corpo),
            # DEBITO: casa_referente.ref virou FK para acervo.entidade(id) em 09/09
            # (0108b-casa-referente-fk.sql) e o fichario da raiz esta VAZIO (0 fichas). Ate
            # ele ser populado, referente de ADR nao tem alvo: emitir `arq:0001` como texto
            # derruba o lote inteiro em InvalidTextRepresentation. Entra sem referente; o
            # backfill liga (repo,path) -> ficha quando a raiz existir. _referentes_adr fica
            # de pe, ja com o vocabulario certo do enum, para esse dia.
            "referentes": [],
            "corpo": corpo,
        }

    dglobal = os.path.join(clone, ADR_DIR_GLOBAL)
    if os.path.isdir(dglobal):
        for fn in sorted(os.listdir(dglobal)):
            if fn.endswith(".md"):
                it = _um(os.path.join(dglobal, fn), f"{ADR_DIR_GLOBAL}/{fn}", "arq")
                if it:
                    itens.append(it)

    dcaps = os.path.join(clone, ADR_DIR_CAPS)
    if os.path.isdir(dcaps):
        for cap in sorted(os.listdir(dcaps)):
            ddec = os.path.join(dcaps, cap, "decisions")
            if not os.path.isdir(ddec):
                continue
            registro = "seg" if cap == "seguranca" else cap
            for fn in sorted(os.listdir(ddec)):
                if fn.endswith(".md"):
                    it = _um(os.path.join(ddec, fn),
                             f"{ADR_DIR_CAPS}/{cap}/decisions/{fn}", registro)
                    if it:
                        itens.append(it)
    return itens

