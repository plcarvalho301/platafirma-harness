class Falha(Exception):
    def __init__(self, codigo: int, msg: str):
        super().__init__(msg)
        self.codigo, self.msg = codigo, msg


def say(msg: str = "", fim: str = "\n") -> None:
    try:
        sys.stdout.write(msg + fim)
        sys.stdout.flush()
    except (BrokenPipeError, OSError, ValueError):
        pass                                # a chamada foi cortada (MCP, 60 s); o verbo segue no host


def agora() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


# ---------------------------------------------------------------- docker: catálogo e balde

def _env_docker() -> dict:
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/%d/docker.sock" % os.getuid())
    return env


def _docker(args: list[str], entrada: str | None = None, timeout: int = 900) -> str:
    try:
        r = subprocess.run(["docker", *args], input=entrada, capture_output=True, text=True, timeout=timeout,
                           env=_env_docker(), errors="replace")
    except FileNotFoundError:
        raise Falha(3, "acervo censo: 'docker' não está no PATH desta conta.")
    except subprocess.TimeoutExpired:
        raise Falha(3, f"acervo censo: docker {' '.join(args[:3])} passou de {timeout}s.")
    if r.returncode != 0:
        raise Falha(3, f"acervo censo: docker {' '.join(args[:3])} saiu {r.returncode}: {r.stderr.strip()[-300:]}")
    return r.stdout


def _psql(sql: str, timeout: int = 900) -> str:
    return _docker(["exec", "-i", PG_CONTAINER, "psql", "-U", PG_USER, "-d", PG_DB, "-At", "-v", "ON_ERROR_STOP=1"],
                   entrada=sql, timeout=timeout)


def credenciais_balde() -> dict:
    fmt = "{{range .Config.Env}}{{println .}}{{end}}"
    saida = _docker(["inspect", MINIO_CONTAINER, "--format", fmt], timeout=60)
    env = dict(l.split("=", 1) for l in saida.splitlines() if "=" in l)
    if "MINIO_ROOT_USER" not in env or "MINIO_ROOT_PASSWORD" not in env:
        raise Falha(3, f"acervo censo: credencial do balde ausente em {MINIO_CONTAINER}.")
    return {"usuario": env["MINIO_ROOT_USER"], "senha": env["MINIO_ROOT_PASSWORD"]}


def contar_servindo() -> int | None:
    try:
        return int(_psql(SQL_CONTA_SERVINDO, timeout=120).strip())
    except (Falha, ValueError):
        return None


def carregar_universo(ids: list[str] | None) -> list[dict]:
    filtro = ""
    if ids:
        filtro = "and (" + " or ".join("o.id::text like '%s%%'" % i for i in ids) + ")"
    saida = _psql(SQL_UNIVERSO.replace("__FILTRO__", filtro))
    obras = [json.loads(l) for l in saida.splitlines() if l.startswith("{")]
    if not obras:
        raise Falha(1, "acervo censo: o catálogo não devolveu nenhuma obra" + (" para --obras" if ids else "") + ".")
    return obras


# ---------------------------------------------------------------- balde (dentro do worker)

def _init_worker(cfg: dict) -> None:
    global _CFG, _S3
    _CFG = cfg
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    import boto3                                             # só o worker precisa: --status roda sem
    from botocore.config import Config
    _S3 = boto3.client("s3", endpoint_url=MINIO_ENDPOINT, aws_access_key_id=cfg["balde"]["usuario"],
                       aws_secret_access_key=cfg["balde"]["senha"],
                       config=Config(retries={"max_attempts": 3}, connect_timeout=10, read_timeout=120))


def _buscar(objeto: str):
    """(bytes, None) | (None, "ausente") | (None, motivo). O objeto é `<bucket>/<sha256>`."""
    bucket, _, chave = objeto.partition("/")
    if not bucket or not chave:
        return None, f"objeto malformado: {objeto!r}"
    try:
        return _S3.get_object(Bucket=bucket, Key=chave)["Body"].read(), None
    except Exception as e:                                   # noqa: BLE001
        cod = getattr(e, "response", {}).get("Error", {}).get("Code", "")
        if cod in ("NoSuchKey", "404", "NoSuchBucket", "NotFound"):
            return None, "ausente"
        return None, f"{type(e).__name__}: {str(e)[:200]}"


def _ficha_erro(item: dict, e: BaseException) -> dict:
    f = censo_ficha.montar_ficha(item, lambda _o: (None, f"{type(e).__name__}: {str(e)[:200]}"))
    f["erro"] = f["erro"] or f"{type(e).__name__}: {str(e)[:200]}"
    return f


def _worker(item: dict) -> dict:
    prazo = float(_CFG.get("prazo_obra_s", censo_ficha.PRAZO_OBRA_S))

    def _estouro(_sig, _frm):
        raise TimeoutError(f"prazo da obra estourado ({int(prazo)} s)")

    signal.signal(signal.SIGALRM, _estouro)
    signal.alarm(int(prazo) + 90)
    try:
        return censo_ficha.montar_ficha(item, _buscar, prazo)
    except BaseException as e:                               # noqa: BLE001 — a obra ruim não derruba o lote
        return _ficha_erro(item, e)
    finally:
        signal.alarm(0)


# ---------------------------------------------------------------- a pasta

def ler_fichas(pasta: str) -> tuple[dict, int]:
    """({obra_id: ficha}, linhas quebradas). A última linha de cada obra vale."""
    caminho = os.path.join(pasta, ARQ_FICHA)
    fichas, ruins = {}, 0
    if not os.path.isfile(caminho):
        return fichas, 0
    with open(caminho, encoding="utf-8") as f:
        for linha in f:
            linha = linha.strip()
            if not linha:
                continue
            try:
                j = json.loads(linha)
            except ValueError:
                ruins += 1
                continue
            if isinstance(j, dict) and j.get("obra_id"):
                fichas[j["obra_id"]] = j
    return fichas, ruins


def ler_universo(pasta: str) -> list[dict]:
    caminho = os.path.join(pasta, ARQ_UNIVERSO)
    if not os.path.isfile(caminho):
        return []
    with open(caminho, encoding="utf-8") as f:
        return [json.loads(l) for l in f if l.strip()]


def _pid_vivo(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _lock_de(pasta: str) -> int | None:
    try:
        with open(os.path.join(pasta, ARQ_LOCK)) as f:
            pid = int(f.read().strip().split()[0])
        return pid if _pid_vivo(pid) else None
    except (OSError, ValueError, IndexError):
        return None


def validar_pasta(pasta: str) -> str:
    p = os.path.realpath(os.path.expanduser(pasta))
    for r in PASTAS_RECUSADAS:
        if p == r or p.startswith(r + "/"):
            raise Falha(2, f"acervo censo: pasta de saída recusada ({r} é produção ou sistema).")
    if p == "/":
        raise Falha(2, "acervo censo: pasta de saída recusada (raiz).")
    try:
        os.makedirs(p, exist_ok=True)
        teste = os.path.join(p, ".escrita")
        with open(teste, "w") as f:
            f.write("ok")
        os.remove(teste)
    except OSError as e:
        raise Falha(2, f"acervo censo: a pasta de saída não aceita escrita ({e}).")
    return p


def status(pasta: str) -> dict:
    if not os.path.isdir(pasta):
        raise Falha(2, f"acervo censo: pasta inexistente: {pasta}")
    universo = ler_universo(pasta)
    fichas, ruins = ler_fichas(pasta)
    ids = {u["obra_id"] for u in universo}
    feitas = {i: f for i, f in fichas.items() if i in ids} if ids else fichas
    erros = [i for i, f in feitas.items() if f.get("erro")]
    caminho = os.path.join(pasta, ARQ_FICHA)
    return {
        "pasta": pasta, "universo": len(universo), "com_ficha": len(feitas), "com_erro": len(erros),
        "pendentes": max(0, len(ids) - len(feitas)) if ids else None, "linhas_quebradas": ruins,
        "em_andamento": _lock_de(pasta), "ultima_escrita_ficha": (
            datetime.datetime.fromtimestamp(os.path.getmtime(caminho)).astimezone().isoformat(timespec="seconds")
            if os.path.isfile(caminho) else None),
        "agente_json": os.path.isfile(os.path.join(pasta, ARQ_AGENTE)),
        "contradicoes_tsv": os.path.isfile(os.path.join(pasta, ARQ_TSV)),
        "resumo_json": os.path.isfile(os.path.join(pasta, ARQ_RESUMO)),
        "obras_com_erro": sorted(erros)[:20],
    }


def imprimir_status(s: dict, como_json: bool) -> None:
    if como_json:
        say(json.dumps(s, ensure_ascii=False, indent=2))
        return
    pct = f" ({round(100 * s['com_ficha'] / s['universo'])}%)" if s["universo"] else ""
    say(f"censo obra · {s['pasta']}")
    say(f"universo: {s['universo']} obras · com ficha: {s['com_ficha']}{pct} · com erro: {s['com_erro']} · pendentes: {s['pendentes']}")
    say("em andamento: " + (f"sim (pid {s['em_andamento']})" if s["em_andamento"] else "não")
        + f" · última escrita: {s['ultima_escrita_ficha'] or '-'}")
    say(f"agente.json: {'sim' if s['agente_json'] else 'não'} · contradicoes.tsv: {'sim' if s['contradicoes_tsv'] else 'não'}"
        f" · resumo.json: {'sim' if s['resumo_json'] else 'não'}")
    if s["linhas_quebradas"]:
        say(f"linhas quebradas descartadas na leitura: {s['linhas_quebradas']}")


# ---------------------------------------------------------------- agente.json

def _versao(dist: str) -> str | None:
    try:
        from importlib.metadata import version
        return version(dist)
    except Exception:                                        # noqa: BLE001
        return None


def _sha_do_harness() -> str | None:
    partes = os.path.realpath(__file__).split(os.sep)
    for i, p in enumerate(partes):
        if p == "platafirma-harness" and i + 1 < len(partes):
            return partes[i + 1]
    return None


def _sha_arquivo(caminho: str) -> str | None:
    try:
        with open(caminho, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except OSError:
        return None


def _identificador() -> dict:
    sf = os.environ.get("PLATAFIRMA_SF") or next((c for c in ("/usr/local/bin/sf", "/usr/bin/sf") if os.path.exists(c)), None)
    if sf:
        try:
            r = subprocess.run([sf, "-version"], capture_output=True, text=True, timeout=20)
            return {"nome": "siegfried", "caminho": sf, "saida_version": (r.stdout or r.stderr).strip()[:400]}
        except (OSError, subprocess.TimeoutExpired):
            pass
    return {"nome": "assinatura-propria", "versao": _sha_do_harness(),
            "motivo": "siegfried ausente no host: assinaturas por bytes embutidas no ato; registro PRONOM nulo"}


def montar_agente(cfg: dict, antes: int | None) -> dict:
    aqui = os.path.dirname(os.path.abspath(__file__))
    return {
        "ato": "acervo censo obra", "card": 3189, "temporario": True,
        "papel_premis": "executing program (Agente 2.6)", "versao_ficha": censo_ficha.VERSAO_FICHA,
        "harness_sha": _sha_do_harness(), "python": sys.version.split()[0], "host": socket.gethostname(),
        "iniciado_em": agora(), "workers": cfg["workers"], "prazo_obra_s": cfg["prazo_obra_s"],
        "identificador": _identificador(),
        "bibliotecas": {d: _versao(d) for d in BIBLIOTECAS},
        "leitores": {m: _sha_arquivo(os.path.join(aqui, m + ".py")) for m in ("censo_ficha", "censo_estrutura", "censo_regras", *LEITORES)},
        "impressoes_servindo_antes": antes,
    }


# ---------------------------------------------------------------- saídas: tsv e resumo

def finalizar(pasta: str, execucao: dict) -> dict:
    universo = ler_universo(pasta)
    fichas, _ = ler_fichas(pasta)
    ids = {u["obra_id"] for u in universo}
    lista = [f for i, f in sorted(fichas.items()) if not ids or i in ids]
    contra: list[dict] = []
    for f in lista:
        contra += censo_regras.avaliar_obra(f)
    contra += censo_regras.avaliar_identidade([f for f in lista if not f.get("erro")])
    with open(os.path.join(pasta, ARQ_TSV), "w", encoding="utf-8") as fh:
        fh.write("\n".join(censo_regras.linhas_tsv(contra, fichas)) + "\n")
    resumo = censo_regras.resumir(lista, contra)
    resumo.update({"universo": len(universo), "pendentes": max(0, len(ids) - len(lista)) if ids else None,
                   "execucao": execucao,
                   "maquina_s_total": round(sum((f.get("tempos_ms") or {}).get("total") or 0 for f in lista) / 1000, 1),
                   "impressoes_servindo": {"antes": execucao.get("impressoes_servindo_antes"),
                                           "depois": execucao.get("impressoes_servindo_depois")}})
    with open(os.path.join(pasta, ARQ_RESUMO), "w", encoding="utf-8") as fh:
        json.dump(resumo, fh, ensure_ascii=False, indent=2, sort_keys=True)
        fh.write("\n")
    return resumo


# ---------------------------------------------------------------- a rodada

def _ids_de(arg: str | None) -> list[str] | None:
    if not arg:
        return None
    if arg.startswith("@"):
        try:
            with open(arg[1:], encoding="utf-8") as f:
                toks = [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
        except OSError as e:
            raise Falha(2, f"acervo censo: --obras {arg}: {e}")
    else:
        toks = [t.strip() for t in arg.split(",") if t.strip()]
    ruins = [t for t in toks if not re.fullmatch(r"[0-9a-fA-F-]{8,36}", t)]
    if ruins:
        raise Falha(2, "acervo censo: --obras aceita o id da obra (uuid, ou prefixo de 8 caracteres ou mais); inválido: "
                    + ", ".join(ruins[:5]))
    return [t.lower() for t in toks]


def _parar(_sig, _frm) -> None:
    global _PARAR
    _PARAR = True


def rodar(args) -> int:
    global _PARAR
    pasta = validar_pasta(args.bancada)
    outro = _lock_de(pasta)
    if outro and outro != os.getpid():
        raise Falha(4, f"acervo censo: outro censo roda nesta pasta (pid {outro}); acompanhe por --status.")
    with open(os.path.join(pasta, ARQ_LOCK), "w") as f:
        f.write(f"{os.getpid()} {agora()}\n")
    try:
        ids = _ids_de(args.obras)
        cam_univ = os.path.join(pasta, ARQ_UNIVERSO)
        antes = None
        if args.atualizar_universo or not os.path.isfile(cam_univ):
            say("universo: consultando o catálogo…")
            antes = contar_servindo()
            universo = carregar_universo(ids)
            with open(cam_univ + ".tmp", "w", encoding="utf-8") as f:
                for u in universo:
                    f.write(json.dumps(u, ensure_ascii=False, separators=(",", ":")) + "\n")
            os.replace(cam_univ + ".tmp", cam_univ)
        else:
            universo = ler_universo(pasta)
            say(f"universo: {len(universo)} obras (universo.jsonl da rodada anterior; --atualizar-universo consulta de novo)")
        fichas, ruins = ler_fichas(pasta)
        if ruins:
            say(f"aviso: {ruins} linha(s) quebrada(s) em {ARQ_FICHA} descartada(s) na leitura")
        alvo_ids = set(ids) if ids else None
        selecionadas = [u for u in universo if not alvo_ids or any(u["obra_id"].startswith(i) for i in alvo_ids)]
        pendentes = []
        for u in selecionadas:
            f = fichas.get(u["obra_id"])
            if f is None or args.refazer or (args.refazer_erros and f.get("erro")):
                pendentes.append(u)
        if args.limite:
            pendentes = pendentes[:args.limite]
        workers = args.workers or max(1, min(6, (os.cpu_count() or 2) - 1))
        cfg = {"workers": workers, "prazo_obra_s": args.prazo_obra_s}
        agente_novo = montar_agente(cfg, antes)
        cam_agente = os.path.join(pasta, ARQ_AGENTE)
        if os.path.isfile(cam_agente):
            try:
                with open(cam_agente, encoding="utf-8") as f:
                    velho = json.load(f)
                agente_novo["primeira_execucao"] = velho.get("primeira_execucao") or velho.get("iniciado_em")
                if agente_novo["impressoes_servindo_antes"] is None:
                    agente_novo["impressoes_servindo_antes"] = velho.get("impressoes_servindo_antes")
            except (OSError, ValueError):
                pass
        agente_novo.setdefault("primeira_execucao", agente_novo["iniciado_em"])
        with open(cam_agente, "w", encoding="utf-8") as f:
            json.dump(agente_novo, f, ensure_ascii=False, indent=2, sort_keys=True)
            f.write("\n")
        say(f"universo {len(universo)} · selecionadas {len(selecionadas)} · com ficha {len(fichas)} · a fazer {len(pendentes)}"
            f" · workers {workers}")
        t0 = time.monotonic()
        if pendentes:
            cfg["balde"] = credenciais_balde()
            signal.signal(signal.SIGTERM, _parar)
            signal.signal(signal.SIGINT, _parar)
            _executar(pasta, pendentes, cfg, workers)
        relogio = round(time.monotonic() - t0, 1)
        execucao = {"iniciada_em": agente_novo["iniciado_em"], "terminada_em": agora(), "relogio_s": relogio,
                    "workers": workers, "interrompida": _PARAR,
                    "impressoes_servindo_antes": agente_novo["impressoes_servindo_antes"],
                    "impressoes_servindo_depois": contar_servindo()}
        resumo = finalizar(pasta, execucao)
        regras = " ".join(f"{r}={v['violacoes']}" for r, v in resumo["regras"].items())
        say(f"fim: {resumo['obras_com_ficha']} de {resumo['universo']} com ficha · erros {resumo['erros']} · pendentes {resumo['pendentes']}"
            f" · relógio {relogio}s · máquina {resumo['maquina_s_total']}s")
        say(f"contradições por regra: {regras}")
        return 0 if resumo["pendentes"] in (0, None) and resumo["erros"] == 0 else 1
    finally:
        try:
            os.remove(os.path.join(pasta, ARQ_LOCK))
        except OSError:
            pass


def _executar(pasta: str, pendentes: list[dict], cfg: dict, workers: int) -> None:
    """Pool de processos: o pai só escreve a ficha, uma linha por obra, e nunca lê arquivo do balde."""
    global _PARAR
    caminho = os.path.join(pasta, ARQ_FICHA)
    if os.path.isfile(caminho) and os.path.getsize(caminho) > 0:
        with open(caminho, "rb+") as f:                      # linha cortada no meio: fecha com \n para não colar na próxima
            f.seek(-1, os.SEEK_END)
            if f.read(1) != b"\n":
                f.write(b"\n")
    total, feitas, erros = len(pendentes), 0, 0
    fila = list(reversed(pendentes))
    ctx = multiprocessing.get_context("fork")
    tentativas_pool = 0
    with open(caminho, "a", encoding="utf-8") as saida:
        while fila and not _PARAR:
            try:
                with cf.ProcessPoolExecutor(max_workers=workers, mp_context=ctx, initializer=_init_worker,
                                            initargs=(cfg,)) as ex:
                    em_voo: dict = {}
                    while (fila or em_voo) and not _PARAR:
                        while fila and len(em_voo) < 3 * workers:
                            item = fila.pop()
                            em_voo[ex.submit(_worker, item)] = item
                        feitos, _ = cf.wait(em_voo, timeout=5, return_when=cf.FIRST_COMPLETED)
                        for fut in feitos:
                            item = em_voo.pop(fut)
                            try:
                                ficha = fut.result()
                            except BrokenProcessPool:
                                fila.append(item)
                                raise
                            except Exception as e:           # noqa: BLE001
                                ficha = _ficha_erro(item, e)
                            saida.write(json.dumps(ficha, ensure_ascii=False, separators=(",", ":")) + "\n")
                            saida.flush()
                            feitas += 1
                            erros += 1 if ficha.get("erro") else 0
                            if feitas % 10 == 0 or feitas == total:
                                os.fsync(saida.fileno())
                                say(f"  {feitas}/{total} · erros {erros} · {ficha['obra_id'][:8]} {ficha.get('formato_id') or '-'}"
                                    f" {ficha['tempos_ms'].get('total', 0)}ms")
                    if _PARAR:
                        for fut in em_voo:
                            fut.cancel()
                        say("interrompido: as obras em voo terminam e a pasta fica retomável")
            except BrokenProcessPool:
                tentativas_pool += 1
                say(f"aviso: um processo do pool morreu (memória?); recomeçando o pool ({tentativas_pool}/5)")
                for item in list(em_voo.values()):
                    if item not in fila:
                        fila.append(item)
                if tentativas_pool >= 5:
                    for item in fila:
                        saida.write(json.dumps(_ficha_erro(item, RuntimeError("pool do censo morreu 5 vezes")),
                                               ensure_ascii=False, separators=(",", ":")) + "\n")
                    fila.clear()
    say(f"rodada: {feitas} fichas gravadas · erros {erros}")


USO = """uso: acervo censo obra --bancada <pasta> [--obras <id,id...|@arquivo>] [--status] [--refazer] [--refazer-erros]
                          [--workers N] [--prazo-obra-s S] [--limite N] [--atualizar-universo] [--json]
ATO TEMPORARIO (#3189): grava em <pasta> agente.json, universo.jsonl, ficha.jsonl, contradicoes.tsv e resumo.json.
So leitura; retomavel (obra com linha na ficha nao se rele); --status so le a pasta.
--obras aceita o id da obra (uuid ou prefixo de 8+ caracteres) ou @arquivo com um por linha.
exit: 0 tudo com ficha e sem erro - 1 obra com erro ou pendente - 2 uso - 3 dependencia fora - 4 outro censo na pasta
"""


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="acervo censo obra", add_help=False)
    ap.add_argument("--bancada", default=None)
    ap.add_argument("--obras", default=None)
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--refazer", action="store_true")
    ap.add_argument("--refazer-erros", dest="refazer_erros", action="store_true")
    ap.add_argument("--workers", type=int, default=0)
    ap.add_argument("--prazo-obra-s", dest="prazo_obra_s", type=int, default=int(censo_ficha.PRAZO_OBRA_S))
    ap.add_argument("--limite", type=int, default=0)
    ap.add_argument("--atualizar-universo", dest="atualizar_universo", action="store_true")
    ap.add_argument("--json", dest="como_json", action="store_true")
    ap.add_argument("-h", "--help", "--ajuda", dest="ajuda", action="store_true")
    try:
        args, resto = ap.parse_known_args([a for a in argv if a != "obra"] if argv[:1] == ["obra"] else argv)
        if args.ajuda or not args.bancada:
            sys.stderr.write(USO + ("" if args.ajuda else "\nfalta --bancada <pasta>\n"))
            return 0 if args.ajuda else 2
        if resto:
            raise Falha(2, "acervo censo: argumento(s) não reconhecido(s): " + " ".join(resto))
        if args.status:
            imprimir_status(status(os.path.realpath(os.path.expanduser(args.bancada))), args.como_json)
            return 0
        return rodar(args)
    except Falha as e:
        sys.stderr.write(e.msg.rstrip("\n") + "\n")
        return e.codigo


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
