#!/usr/bin/env python3
# acervo registrar — ESCREVE um verbo no golden record a partir do cabecalho do bin.
# capacidade: conhecimento
# dono: claudinho-dados
#
# `acervo registrar <verbo>`   upsert de capacidade + verbo + descricao lendo o
#                              cabecalho de bin/<verbo> (# <verbo> — desc, # capacidade:).
# `acervo registrar --todos`   registra todos os verbos do nucleo (whitelist do oficio).
#
# Este e "o verbo que faz o post no banco": substitui escrever migration de seed na
# mao + aplicar de psql. Fonte = o cabecalho do script (o host); a tabela e a projecao.
# Idempotente por slug. Migration continua so para DDL (criar coluna/tabela).
import os
import re
import signal
import subprocess
import sys

try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"
BIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

USO = """uso:
  acervo registrar <verbo>     upsert do verbo no golden record a partir do cabecalho
                               do bin/<verbo> (# <verbo> — desc, # capacidade:)
  acervo registrar --todos     registra todos os verbos do nucleo (whitelist do oficio)

ESCREVE em acervo.ferramental (capacidade + verbo + descricao). Idempotente por slug.
`# regua: <ato> lista-de-verificacao <chave>` grava a lista do ato em ferramental_ato so
se ela resolve no acervo agora; a que nao resolve sai em aviso, sem referencia pendurada.
`# regua: <ato> repositorio` marca regua_propria (spec_lint §3, §6; migracao 062).
Fonte = o cabecalho do script; a tabela e a projecao. Substitui a migration de seed
na mao (migration fica so para DDL)."""


def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def _psql(sql, escreve=False):
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    cmd = ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-v", "ON_ERROR_STOP=1"]
    if not escreve:
        cmd += ["-tAF|", "-c", sql]
    try:
        return subprocess.run(cmd, input=sql if escreve else None,
                              capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo registrar: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo registrar: psql falhou (rc=%s):\n%s" % (e.returncode, (e.stderr or "").strip()), 3)


def _lit(v):
    return "null" if v is None else "'" + str(v).replace("'", "''") + "'"


CHAVES = (
    "capacidade", "dono", "componente", "use para", "atos", "classe",
    "le", "escreve", "consome", "ambiente", "depende", "substitui", "regua"
)
# Chaves que se repetem, uma linha por ato, e acumulam em vez de sobrescrever.
POR_ATO = ("le", "escreve", "regua")

RE_SLUG = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")

def _regua_por_ato(linhas, verbo):
    """`# regua: <ato> repositorio` | `# regua: <ato> <especie> <chave>` (spec_lint §3, §6) ->
    {ato: ("repositorio", None) | (especie, chave)}. Sem versao: resolve-se no servido."""
    por_ato = {}
    for linha in linhas or []:
        partes = linha.split()
        if len(partes) == 2 and partes[1] == "repositorio":
            por_ato[partes[0]] = ("repositorio", None)
        elif len(partes) == 3 and RE_SLUG.match(partes[1]) and RE_SLUG.match(partes[2]):
            por_ato[partes[0]] = (partes[1], partes[2])
        else:
            morre("acervo registrar: bin/%s tem `# regua: %s` fora da forma "
                  "`<ato> repositorio` ou `<ato> <especie> <chave>` (spec_lint §3)." % (verbo, linha), 3)
    return por_ato

def _listas_que_resolvem(pares):
    """Das (especie, chave) pedidas, as que existem VIVAS no acervo casa agora. O golden record
    nunca guarda referencia pendurada (spec_lint §3: lista antes da classe)."""
    if not pares:
        return set()
    valores = ", ".join("(%s, %s)" % (_lit(e), _lit(c)) for e, c in sorted(pares))
    out = _psql(
        "select v.e, v.c from (values %s) as v(e, c) "
        "join acervo.especie_tipo t on t.slug = v.e "
        "join acervo.casa x on x.especie_id = t.id and x.chave = v.c and x.retirada_em is null;" % valores)
    return {tuple(l.split("|", 1)) for l in out.splitlines() if "|" in l}


def _le_cabecalho(path):
    """Le o cabecalho por CHAVE, nunca por posicao (spec_capsula-de-verbos §6):
    `# <verbo> — <o que>` (continua nas linhas `#` seguintes ate um `#` vazio ou uma
    linha chaveada — `descansar` quebra a frase em duas linhas), `# capacidade:`,
    `# use para:` e `# atos:`. A descricao servida em tools/list e composta aqui,
    forma fixa: `<o que> · use para: <vocabulario> · atos: <lista>`; chave ausente
    so omite a parte, nunca inventa. Mesma convencao de chaves que `conferir` parseia."""
    desc, campos, lendo_desc = [], {}, False
    with open(path, errors="replace") as f:
        # 80 e nao 45: `le:`/`escreve:` sao uma linha POR ATO, e verbo de 19 atos (repo)
        # passa de 45 linhas de cabecalho; cortar aqui registrava ato sem acesso (morre).
        linhas = [next(f, "") for _ in range(80)]
    for l in linhas:
        s = l.strip()
        if not s.startswith("#") or s.startswith("#!"):
            continue
        s = s.lstrip("#").strip()
        if not s:
            lendo_desc = False
            continue
        low = s.lower()
        chave = next((c for c in CHAVES if low.startswith(c + ":")), None)
        if chave:
            valor = s.split(":", 1)[1].strip()
            # `le:` e `escreve:` sao POR ATO (spec_acervo §1, §7): uma linha por ato,
            # `# le: <ato>=<recurso>[,<recurso>]`; chave repetida acumula, nao sobrescreve.
            if chave in POR_ATO:
                campos.setdefault(chave, []).append(valor)
            else:
                campos[chave] = valor
            lendo_desc = False
            continue
        if not desc:
            for sep in (" — ", " - "):
                if sep in s:
                    desc.append(s.split(sep, 1)[1].strip())
                    lendo_desc = True
                    break
        elif lendo_desc:
            desc.append(s)
    partes = [" ".join(desc).strip().rstrip(".")] if desc else []
    for chave in ("use para", "atos"):
        if campos.get(chave):
            partes.append("%s: %s" % (chave, campos[chave]))
    return campos, (" · ".join(partes) or None)


def _le_whitelist():
    p = os.path.join(os.path.dirname(BIN), "abertura", "oficio-ferramental.md")
    if not os.path.isfile(p):
        morre("acervo registrar --todos: whitelist nao encontrado em\n  %s" % p, 3)
    slugs, dentro = [], False
    with open(p, encoding="utf-8") as fh:
        for l in fh.read().splitlines():
            s = l.strip()
            if s.startswith("```"):
                dentro = not dentro
                continue
            if dentro and s and not s.startswith("#"):
                slugs.append(s.split()[0])   # marcadores (`leva:2`) ficam no resto da linha
    if not slugs:
        morre("acervo registrar --todos: whitelist vazio.", 3)
    return slugs


def _resolve(verbo):
    """Arquivo real do verbo: bin/<slug> da propria arvore (a release no ar e o PATH;
    nao existe mais diretorio de symlinks de verbos). Symlink e seguido ate o nome real."""
    cand = os.path.join(BIN, verbo)
    return os.path.realpath(cand) if os.path.isfile(cand) else None


def registrar_um(verbo):
    path = _resolve(verbo)
    if not path:
        morre("acervo registrar: nao achei o script de bin/%s em %s" % (verbo, BIN), 3)
    campos, desc = _le_cabecalho(path)
    cap = campos.get("capacidade")
    if not cap:
        morre("acervo registrar: bin/%s sem '# capacidade:' no cabecalho — "
              "nao registro sem capacidade (1:1, arq:0037)." % verbo, 3)
    sot = "bin/%s" % verbo

    atos_raw = campos.get("atos", "")
    atos_info = []
    if atos_raw:
        for item in re.findall(r'([a-zA-Z0-9_-]+(?:\s*\([^)]*\))?)', atos_raw):
            m = re.match(r"^([a-zA-Z0-9_-]+)(?:\s*\(([^)]+)\))?$", item.strip())
            if m:
                ato_nome = m.group(1)
                inside = [p.strip() for p in m.group(2).split(",")] if m.group(2) else []
                if len(inside) >= 2:
                    op, subcap = inside[0], inside[1]
                elif len(inside) == 1:
                    op, subcap = inside[0], inside[0]
                else:
                    op, subcap = "execucao", cap
                atos_info.append((ato_nome, op, subcap))

    # Acesso por ato: {ato: [recurso, ...]} para `le` e `escreve`. Recurso e id logico de
    # acervo.ferramental_recurso (FK reprova valor fora do enum); `nada` e linha explicita.
    def _acesso_por_ato(linhas):
        por_ato = {}
        for linha in linhas or []:
            if "=" not in linha:
                morre("acervo registrar: linha de acesso sem ato: '%s' (forma: <ato>=<recurso>,...)" % linha, 3)
            ato_nome, recs = linha.split("=", 1)
            por_ato[ato_nome.strip()] = [r.strip() for r in recs.split(",") if r.strip()]
        return por_ato
    le_por_ato = _acesso_por_ato(campos.get("le"))
    escreve_por_ato = _acesso_por_ato(campos.get("escreve"))

    # Regua por ato (spec_lint §6): so grava a lista que resolve no acervo agora; a que nao
    # resolve sai em aviso e fica sem referencia (nunca pendurada).
    regua_por_ato = _regua_por_ato(campos.get("regua"), verbo)
    nomes_atos = {a for a, _, _ in atos_info}
    sem_ato = sorted(a for a in regua_por_ato if a not in nomes_atos)
    if sem_ato:
        morre("acervo registrar: bin/%s declara `# regua:` para ato que `# atos:` nao lista: %s"
              % (verbo, ", ".join(sem_ato)), 3)
    pedidas = {r for r in regua_por_ato.values() if r[0] != "repositorio"}
    resolvem = _listas_que_resolvem(pedidas)
    pendentes = []
    def _regua_sql(ato_nome):
        r = regua_por_ato.get(ato_nome)
        if r is None:
            return "null", "null", "false"
        if r[0] == "repositorio":
            return "null", "null", "true"
        if r in resolvem:
            return _lit(r[0]), _lit(r[1]), "false"
        pendentes.append("%s -> %s %s" % (ato_nome, r[0], r[1]))
        return "null", "null", "false"

    consome_raw = campos.get("consome", "")
    consumos = [c.strip() for c in consome_raw.split(",") if c.strip()]

    ambiente_raw = campos.get("ambiente", "")
    ambientes = []
    if ambiente_raw:
        for item in re.findall(r'([A-Z0-9_]+(?:\s*\([^)]*\))?)', ambiente_raw):
            m = re.match(r"^([A-Z0-9_]+)(?:\s*\(([^)]+)\))?$", item.strip())
            if m:
                var_name = m.group(1)
                detail = m.group(2) or ""
                obrig = "opcional" not in detail.lower()
                origem = detail.replace("opcional,", "").replace("opcional", "").strip() or None
                ambientes.append((var_name, obrig, origem))

    sql_parts = [
        "begin;\n",
        "insert into acervo.ferramental_capacidade (slug, rotulo) "
        "select %s, %s where not exists (select 1 from acervo.ferramental_capacidade where slug=%s);\n"
        % (_lit(cap), _lit(cap), _lit(cap)),
        "insert into acervo.ferramental_verbo (slug, capacidade_id, sot, descricao) "
        "select %s, c.id, %s, %s from acervo.ferramental_capacidade c where c.slug=%s limit 1 "
        "on conflict (slug) do update set sot=excluded.sot, descricao=excluded.descricao, "
        "capacidade_id=excluded.capacidade_id;\n" % (_lit(verbo), _lit(sot), _lit(desc), _lit(cap))
    ]

    # A projecao e do cabecalho inteiro: o que o verbo declara hoje substitui o que declarou
    # ontem (idempotente por verbo), em vez de acumular sobras.
    sql_parts.append("delete from acervo.ferramental_ato where verbo=%s;\n" % _lit(verbo))
    sql_parts.append("delete from acervo.ferramental_acesso where verbo=%s;\n" % _lit(verbo))
    for ato_nome, op, subcap in atos_info:
        # (verbo, ato) -> folha: mapeamento em ferramental_ato; a tabela de capacidades
        # continua sendo so o mapa de folhas (spec_acervo §7).
        if regua_por_ato:
            # Colunas de regua (062) so entram para verbo que declara `# regua:`: verbo sem a
            # linha registra igual a antes, mesmo num banco que ainda nao tem as colunas.
            re_esp, re_chave, re_propria = _regua_sql(ato_nome)
            sql_parts.append(
                "insert into acervo.ferramental_ato (verbo, ato, capacidade, acao, tipo, "
                "regua_especie, regua_chave, regua_propria) "
                "values (%s, %s, %s, %s, %s, %s, %s, %s) on conflict (verbo, ato) do update set "
                "capacidade=excluded.capacidade, acao=excluded.acao, tipo=excluded.tipo, "
                "regua_especie=excluded.regua_especie, regua_chave=excluded.regua_chave, "
                "regua_propria=excluded.regua_propria;\n"
                % (_lit(verbo), _lit(ato_nome), _lit(subcap), _lit(op), _lit(subcap),
                   re_esp, re_chave, re_propria)
            )
        else:
            sql_parts.append(
                "insert into acervo.ferramental_ato (verbo, ato, capacidade, acao, tipo) "
                "values (%s, %s, %s, %s, %s) on conflict (verbo, ato) do update set "
                "capacidade=excluded.capacidade, acao=excluded.acao, tipo=excluded.tipo;\n"
                % (_lit(verbo), _lit(ato_nome), _lit(subcap), _lit(op), _lit(subcap))
            )
        for modo, por_ato in (("le", le_por_ato), ("escreve", escreve_por_ato)):
            if not le_por_ato and not escreve_por_ato:
                break   # verbo ainda sem declaracao de acesso (pre-0110): registra sem acesso
            recs = por_ato.get(ato_nome)
            if recs is None:
                morre("acervo registrar: bin/%s nao declara `# %s: %s=...` \u2014 ato sem linha "
                      "de acesso nao se registra (`nada` e linha explicita)." % (verbo, modo, ato_nome), 3)
            for rec in recs:
                sql_parts.append(
                    "insert into acervo.ferramental_acesso (verbo, ato, recurso_id, modo) "
                    "values (%s, %s, %s, %s) on conflict (verbo, ato, recurso_id, modo) do nothing;\n"
                    % (_lit(verbo), _lit(ato_nome), _lit(rec), _lit(modo))
                )
        for cons in consumos:
            sql_parts.append(
                "insert into acervo.ferramental_consumo (verbo, ato, servico, consumo_raw) "
                "values (%s, %s, %s, %s) on conflict (verbo, ato, servico) "
                "do update set consumo_raw=excluded.consumo_raw;\n"
                % (_lit(verbo), _lit(ato_nome), _lit(cons), _lit(cons))
            )

    for var_name, obrig, origem in ambientes:
        sql_parts.append(
            "insert into acervo.ferramental_ambiente (verbo, variavel, obrigatoria, origem) "
            "values (%s, %s, %s, %s) on conflict (verbo, variavel) "
            "do update set obrigatoria=excluded.obrigatoria, origem=excluded.origem;\n"
            % (_lit(verbo), _lit(var_name), "true" if obrig else "false", _lit(origem))
        )

    sql_parts.append("commit;\n")
    _psql("".join(sql_parts), escreve=True)
    if pendentes:
        sys.stderr.write("acervo registrar: %s: regua que ainda nao resolve no acervo, gravada sem "
                         "referencia (lista antes da classe, spec_lint §3): %s\n"
                         % (verbo, "; ".join(pendentes)))
    return cap, desc


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "--ajuda"):
        print(USO)
        sys.exit(2 if not argv else 0)
    if argv[0] == "--todos":
        feitos, pulados = [], []
        for v in sorted(_le_whitelist()):
            path = _resolve(v)
            if not path:
                pulados.append((v, "sem binario"))
                continue
            campos, _ = _le_cabecalho(path)
            cap = campos.get("capacidade")
            if not cap:
                pulados.append((v, "sem capacidade"))
                continue
            registrar_um(v)
            feitos.append(v)
        sys.stderr.write("acervo registrar --todos: %d registrado(s): %s\n"
                         % (len(feitos), ", ".join(feitos)))
        if pulados:
            sys.stderr.write("pulados: %s\n"
                             % ", ".join("%s (%s)" % p for p in pulados))
        return
    verbo = argv[0]
    cap, desc = registrar_um(verbo)
    sys.stderr.write("acervo registrar: %s -> capacidade=%s, descricao=%s\n"
                     % (verbo, cap, desc or "(vazia)"))


if __name__ == "__main__":
    main(sys.argv[1:])
