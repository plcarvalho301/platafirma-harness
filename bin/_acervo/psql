#!/usr/bin/env bash
# acervo psql — SQL ad-hoc contra um Postgres da casa, por STDIN, resultado cru de volta.
#
# Por que existe: por meses a leitura do acervo foi psql cru no host — some quando a
# porta-so-verbo fecha o shell, e nunca funcionou de fora de casa. Sem este ato, as
# cadeiras (e o dono, remoto) ficam tateando fossil em repo procurando o que uma query
# resolve num giro. Este verbo traz o psql PARA a porta: passa pelo controle da casa,
# roda de qualquer superficie (logo, de fora tambem), e captura os DOIS streams.
#
# ESCOPO HOJE (decisao do dono, 08/09/2026): SEM bloqueio de escrita. A conexao usa o
# mesmo role de sempre; DROP/DELETE/UPDATE PASSAM. Encapsular ja traz o ganho — controle
# da casa e captura de stderr — e o bloqueio (role read-only) entra depois, no proprio
# verbo, sem mexer em quem chama. ate la: e psql cru, com o poder de escrita que isso tem.
#
# Contencao ESTRUTURAL (o que NAO afrouxou, no molde do `migrar`):
#   1. ALVO por allowlist de banco (slug), nunca string arbitraria para o docker.
#   2. O SQL vem por STDIN, sempre. Nenhum caminho de arquivo do host e aberto aqui.
#   3. Nenhuma flag do chamador atravessa para o psql fora do corpo no stdin.
#
# Captura os DOIS streams e devolve os dois — corrige o debito `migrar-stdout` no molde
# certo: o stdout do docker aninhado (resultado da query) NAO se perde no stderr do
# wrapper, que era o furo do `migrar` (`psql -f -` mandando stdout ao terminal do host).
set -uo pipefail

VERBO="acervo psql"

# Allowlist carregada de registro/bancos.json (#4428): todos os Postgres da casa,
# sempre pela role de leitura `analise_leitura` e transação somente leitura.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BANCOS_JSON="${PF_BANCOS_JSON:-$SCRIPT_DIR/../../registro/bancos.json}"
ROLE_LEITURA="analise_leitura"

morre() { printf '%s: %s\n' "$VERBO" "$1" >&2; exit "${2:-3}"; }

declare -A BANCOS=()
if [ ! -f "$BANCOS_JSON" ]; then
  morre "registro de bancos ausente: $BANCOS_JSON" 3
fi
while IFS=$'\t' read -r _slug _ctr _base; do
  [ -n "$_slug" ] || continue
  BANCOS["$_slug"]="${_ctr}:${ROLE_LEITURA}:${_base}"
done < <(
  python3 - "$BANCOS_JSON" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as fh:
    dados = json.load(fh)
for slug, info in dados.items():
    if slug.startswith("_") or not isinstance(info, dict):
        continue
    ctr = info.get("conteiner") or ""
    base = info.get("base") or ""
    if ctr and base:
        print(f"{slug}\t{ctr}\t{base}")
PY
)

uso() {
  cat >&2 <<EOF
uso:
  acervo psql [--banco <banco>] [-A] [-t] [--csv] [-q] [-x] [-F <sep>] [--sql <query> | -c <query>]
                             roda SQL somente de leitura no <banco> pela role ${ROLE_LEITURA}
                             banco default: rag (schema acervo.*).
                             opções de formato: -A (sem alinhamento), -t (só tuplas),
                             --csv, -q (quiet), -x (expandido), -F <sep> (separador de campo).
                             query pode vir via --sql "<query>", argumento posicional ou STDIN.
                             forma vigente (posicional, \`acervo psql <banco>\`) ainda responde.

bancos declarados: ${!BANCOS[*]}  (default: rag)
leitura apenas: role ${ROLE_LEITURA} com default_transaction_read_only=on (sem escrita).
exit: 0 ok · 2 uso · 3 falha (docker/psql) · 4 banco fora da allowlist ou restrito
EOF
  exit 2
}

banco="rag"
sql=""
psql_flags=()

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help|ajuda) uso ;;
    --banco)
      shift
      banco="${1:-}"
      [ -n "$banco" ] || morre "--banco exige um valor" 2
      ;;
    -c|--sql)
      shift
      sql="${1:-}"
      [ -n "$sql" ] || morre "--sql exige uma query" 2
      ;;
    -A|--no-align)
      psql_flags+=("-A")
      ;;
    -t|--tuples-only)
      psql_flags+=("-t")
      ;;
    -At|-tA)
      psql_flags+=("-A" "-t")
      ;;
    --csv)
      psql_flags+=("--csv")
      ;;
    -q|--quiet)
      psql_flags+=("-q")
      ;;
    -x|--expanded)
      psql_flags+=("-x")
      ;;
    -F|--field-separator)
      shift
      [ $# -gt 0 ] || morre "$1 exige um separador" 2
      psql_flags+=("-F" "$1")
      ;;
    -R|--record-separator)
      shift
      [ $# -gt 0 ] || morre "$1 exige um separador" 2
      psql_flags+=("-R" "$1")
      ;;
    *)
      if [ -n "${BANCOS[$1]:-}" ]; then
        banco="$1"
      elif [ -z "$sql" ]; then
        sql="$1"
      else
        sql="$sql $1"
      fi
      ;;
  esac
  shift
done

[ -n "${BANCOS[$banco]:-}" ] || morre "banco '$banco' fora da allowlist — validos: ${!BANCOS[*]}" 4
if [ "$banco" = "keycloak" ] && [ -n "${PF_CADEIRA:-}" ] && [ "$PF_CADEIRA" != "seguranca" ] && [ "$PF_CADEIRA" != "ti" ]; then
  morre "banco 'keycloak' restrito as cadeiras seguranca e ti (cadeira atual: $PF_CADEIRA)" 4
fi
IFS=: read -r ctr usr base <<<"${BANCOS[$banco]}"

if [ -z "$sql" ]; then
  if [ -t 0 ]; then
    morre "nenhuma query informada — passe a query via \`--sql '<query>'\`, argumento posicional ou \`stdin=<SELECT ...>\`" 2
  fi
  sql="$(cat)"
fi
[ -n "${sql//[[:space:]]/}" ] || morre "query vazia — passe a query via \`--sql '<query>'\`, argumento posicional ou \`stdin=<SELECT ...>\`" 2

command -v docker >/dev/null 2>&1 || morre "'docker' nao esta no PATH desta conta" 3
docker inspect -f '{{.State.Running}}' "$ctr" 2>/dev/null | grep -qx true \
  || morre "contêiner '$ctr' nao esta de pe — \`infra estado\`" 3

# -P pager=off para nao travar; sem tty. O corpo vai por stdin, nao como -c: aceita
# meta-comandos (\d, \dt, \l) e SQL na mesma sessao, igual a um psql interativo.
# Capturamos stdout e stderr SEPARADOS e devolvemos os dois — a query sai no stdout,
# NOTICE/erro de sintaxe no stderr. Este e o conserto do debito migrar-stdout.
err_arq="$(mktemp "${TMPDIR:-/tmp}/acervo-psql.XXXXXX")" || morre "mktemp falhou" 3
trap 'rm -f "$err_arq"' EXIT
out="$(docker exec -i -e "PGOPTIONS=-c default_transaction_read_only=on" "$ctr" psql -U "$usr" -d "$base" -P pager=off "${psql_flags[@]}" 2>"$err_arq" <<<"$sql")"
rc=$?
err="$(cat "$err_arq")"
rm -f "$err_arq"

[ -n "$out" ] && printf '%s\n' "$out"
[ -n "$err" ] && printf '%s\n' "$err" >&2
exit "$rc"
