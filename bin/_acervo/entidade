#!/usr/bin/env python3
# acervo entidade — leitura e resolucao da raiz da casa (acervo.entidade*, arq:0108).
# capacidade: conhecimento
# dono: claudinho-dados
#   (materia/semantica: claudinho-dados · dono; mecanismo/harness: claudinho-TI · construcao)
#
# Serve os dois atos da raiz que a ordem de 0108 pede, sobre as tabelas
# acervo.entidade_classe / acervo.entidade (rag_extractor):
#
#   acervo listar  entidade [--especie <e>] [--dona <cadeira>] [--json]
#       Lista o INDICE de classes (acervo.entidade_classe): slug · especie · dona ·
#       chave_humana · substrato_golden · regime. Filtros opcionais por especie
#       (categoria da classe) e por dona (cadeira no array `dona`). E o golden record
#       do fichario: a lista viva de arq:0108 §2, nao um .md a mao.
#
#   acervo resolver <classe> <string> [--json]
#       O UNICO ato de resolucao de identidade da raiz (arq:0022, arq:0108 §5).
#       Recebe a classe (slug de entidade_classe) e uma string humana; devolve o
#       entidade.id (uuid opaco) da ficha cuja chave_humana casa, dentro da classe.
#       Resolver por parsing de string em outro lugar e violacao (arq:0022): a
#       identidade se pede a este ato, nunca se deduz. Casa exato primeiro; se nada,
#       tenta alias (acervo.entidade_alias). Zero -> rc 1 (nao encontrado); mais de
#       um -> rc 2 (ambiguo, lista os candidatos). Um -> imprime o uuid, rc 0.
#
# Read-only. A escrita da raiz e a carga/backfill (migrar/psql), outro caminho.
import json
import os
import signal
import subprocess
import sys

try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"

def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)

def _psql_json(sql, alvo):
    """SELECT que devolve UMA linha (array JSON via json_agg); desserializa.

    Mesmo transporte de _acervo/listar: a estrutura vem do JSON do proprio
    Postgres, que escapa qualquer coisa nos campos-texto. Sem split posicional.
    """
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    try:
        saida = subprocess.run(
            ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-tA", "-c", sql],
            capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo entidade: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo entidade: psql falhou (rc=%s):\n%s"
              % (e.returncode, (e.stderr or "").strip()), 3)
    try:
        return json.loads(saida) if saida.strip() else []
    except (ValueError, TypeError) as e:
        morre("acervo entidade %s: psql nao devolveu JSON parseavel (%s):\n  %s"
              % (alvo, e, saida[:200]), 3)

def _lit(s):
    return "'" + str(s).replace("'", "''") + "'"

# ------------------------------------------------------------------ listar entidade

SQL_CLASSES = """
select coalesce(json_agg(row_to_json(t) order by t.slug), '[]')
from (
  select ec.slug, ec.especie, ec.dona, ec.chave_humana,
         nullif(ec.substrato_golden,'') as substrato_golden, ec.regime
  from acervo.entidade_classe ec
  %s
) t;
"""

def listar_entidade(especie, dona, quero_json):
    conds = []
    if especie:
        conds.append("ec.especie = %s" % _lit(especie))
    if dona:
        # dona e text[]; casa se a cadeira esta no array
        conds.append("%s = any(ec.dona)" % _lit(dona))
    where = ("where " + " and ".join(conds)) if conds else ""
    classes = _psql_json(SQL_CLASSES % where, "listar entidade")
    if quero_json:
        print(json.dumps(classes, ensure_ascii=False, indent=2))
        return 0
    if not classes:
        filtro = []
        if especie: filtro.append("especie=%s" % especie)
        if dona: filtro.append("dona=%s" % dona)
        sys.stderr.write("acervo listar entidade: nenhuma classe%s.\n"
                         % ((" (" + ", ".join(filtro) + ")") if filtro else ""))
        return 0
    ws = max(len(c["slug"]) for c in classes)
    we = max(len(c["especie"]) for c in classes)
    def _dona(c): return ",".join(c["dona"]) if c["dona"] else "-"
    wd = max([len(_dona(c)) for c in classes] + [len("dona")])
    print("%-*s  %-*s  %-*s  %-16s  %s"
          % (ws, "slug", we, "especie", wd, "dona", "chave_humana", "regime"))
    print("%s  %s  %s  %-16s  %s"
          % ("-" * ws, "-" * we, "-" * wd, "-" * 12, "-" * 6))
    for c in classes:
        print("%-*s  %-*s  %-*s  %-16s  %s"
              % (ws, c["slug"], we, c["especie"], wd, _dona(c),
                 c["chave_humana"] or "-", c["regime"]))
    sys.stderr.write("\n%d classe(s) no indice da raiz (acervo.entidade_classe).\n"
                     % len(classes))
    return 0

# --------------------------------------------------------------------- resolver

SQL_RESOLVE = """
select coalesce(json_agg(row_to_json(t)), '[]') from (
  select e.id, e.chave_humana, 'exato' as via
    from acervo.entidade e
   where e.classe = {classe} and e.chave_humana = {alvo}
  union all
  select e.id, e.chave_humana, 'alias' as via
    from acervo.entidade e
    join acervo.entidade_alias a on a.entidade_id = e.id
   where e.classe = {classe} and a.alias = {alvo}
     and not exists (select 1 from acervo.entidade e2
                      where e2.classe = {classe} and e2.chave_humana = {alvo})
) t;
"""

def _classe_existe(classe):
    got = _psql_json(
        "select coalesce(json_agg(slug),'[]') from acervo.entidade_classe "
        "where slug = %s;" % _lit(classe), "classe")
    return bool(got)

def resolver(classe, alvo, quero_json):
    if not _classe_existe(classe):
        vivas = _psql_json(
            "select coalesce(json_agg(slug order by slug),'[]') "
            "from acervo.entidade_classe;", "classes")
        morre("acervo resolver: classe '%s' nao existe em acervo.entidade_classe.\n"
              "  classes vivas: %s" % (classe, ", ".join(vivas)), 2)
    sql = SQL_RESOLVE.format(classe=_lit(classe), alvo=_lit(alvo))
    cand = _psql_json(sql, "resolver")
    if not cand:
        if quero_json:
            print(json.dumps({"classe": classe, "chave": alvo, "id": None,
                              "achou": False}, ensure_ascii=False))
        else:
            sys.stderr.write("acervo resolver: '%s' nao resolve em '%s' "
                             "(nenhuma ficha com essa chave nem alias).\n"
                             % (alvo, classe))
        return 1
    if len(cand) > 1:
        sys.stderr.write("acervo resolver: '%s' ambiguo em '%s' (%d fichas):\n"
                         % (alvo, classe, len(cand)))
        for c in cand:
            sys.stderr.write("  %s  (via %s, chave_humana=%s)\n"
                             % (c["id"], c["via"], c["chave_humana"]))
        return 2
    c = cand[0]
    if quero_json:
        print(json.dumps({"classe": classe, "chave": alvo, "id": c["id"],
                          "via": c["via"], "achou": True}, ensure_ascii=False))
    else:
        print(c["id"])
    return 0

USO = """uso:
  acervo listar entidade [--especie <e>] [--dona <cadeira>] [--json]
      indice de classes da raiz (acervo.entidade_classe): slug · especie · dona ·
      chave_humana · substrato_golden · regime. Filtra por especie ou por dona.
  acervo resolver <classe> <string> [--json]
      resolve a string para o entidade.id (uuid) da ficha, dentro da classe.
      O UNICO ato de resolucao de identidade da raiz (arq:0022). Casa exato,
      depois alias. rc: 0 achou (imprime uuid) · 1 nada · 2 ambiguo (lista).

Read-only sobre a raiz da casa (arq:0108)."""

def main(argv):
    # Invocado pelo despachante como:
    #   _acervo/entidade listar [--especie e] [--dona d] [--json]
    #   _acervo/entidade resolver <classe> <string> [--json]
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)
    ato = argv[0]
    resto = argv[1:]
    quero_json = "--json" in resto
    resto = [a for a in resto if a != "--json"]

    if ato == "listar":
        especie = dona = None
        i = 0
        while i < len(resto):
            if resto[i] == "--especie" and i + 1 < len(resto):
                especie = resto[i + 1]; i += 2
            elif resto[i] == "--dona" and i + 1 < len(resto):
                dona = resto[i + 1]; i += 2
            else:
                morre("acervo listar entidade: argumento inesperado %r\n\n%s"
                      % (resto[i], USO), 2)
        return listar_entidade(especie, dona, quero_json)

    if ato == "resolver":
        if len(resto) != 2:
            morre("acervo resolver <classe> <string>: preciso de exatamente dois "
                  "argumentos.\n\n%s" % USO, 2)
        return resolver(resto[0], resto[1], quero_json)

    morre("acervo entidade: ato desconhecido '%s' (listar, resolver).\n\n%s"
          % (ato, USO), 2)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
