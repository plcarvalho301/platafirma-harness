#!/usr/bin/env python3
# acervo casa — leitura da partição casa a partir da tabela acervo.casa (rag_extractor).
# capacidade: conhecimento
# dono: claudinho-dados
#   (matéria/semântica: claudinho-dados · dono; mecanismo/harness: claudinho-TI · construcao)
#
# É o sub-ato genérico das espécies de `casa` que vivem na TABELA acervo.casa —
# as espécies novas (caderno, persona, spec, minuta, cabecalho-de-verbo, automacao,
# pagina) e qualquer outra de especie_tipo que não tenha sub-ato legado dedicado.
# As espécies com fonte própria (adr → _acervo/adr, pagina-wiki → _acervo/wiki,
# stack → _acervo/stack, ferramental → _acervo/ferramenta) continuam roteadas por
# seus casos no despachante bin/acervo; só o que sobra cai aqui.
#
# Formas (arq:0106):
#   acervo listar casa <especie> [--json]       linhas de acervo.casa daquela espécie
#   acervo ler    casa <especie> <seletor>      uma linha, por path (identidade repo@path)
#
# A espécie é validada contra acervo.especie_tipo: espécie inexistente RECUSA com a
# lista viva, em vez de servir vazio (a trava da spec_acervo-casa §Corte).
# Read-only. Escrita é `acervo escrever/ingerir casa` (outro caminho).
import json
import os
import re
import signal
import subprocess
import sys

try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"


def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def _psql(sql):
    """SQL no rag_extractor via docker exec; devolve stdout cru (-tAF|)."""
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    try:
        return subprocess.run(
            ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-tAF|", "-c", sql],
            capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo casa: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo casa: psql falhou (rc=%s):\n%s"
              % (e.returncode, (e.stderr or "").strip()), 3)


def _especies_vivas():
    """Set de slugs de acervo.especie_tipo — o vocabulário fechado (arq:0059)."""
    saida = _psql("select slug from acervo.especie_tipo order by slug;")
    return [l.strip() for l in saida.splitlines() if l.strip()]


def _valida_especie(especie):
    vivas = _especies_vivas()
    if especie not in vivas:
        morre("acervo casa: especie '%s' nao existe em acervo.especie_tipo.\n"
              "  especies vivas: %s" % (especie, ", ".join(vivas)), 2)


# SQL parametrizado por espécie via literal seguro: a espécie já foi validada contra
# a tabela (allowlist viva), então não há injeção — mas escapamos aspa simples por higiene.
def _lit(s):
    return "'" + s.replace("'", "''") + "'"


def listar(especie, quero_json, dono=None, situacao=False):
    _valida_especie(especie)
    cond_dono = (" and c.dono = %s" % _lit(dono)) if dono else ""
    sql = (
        "select c.repo, c.path, c.sha, c.dono, c.natureza, c.ciclo, coalesce(c.titulo,''), "
        "       to_char(c.criado_em,'YYYY-MM-DD'), "
        "       to_char(ci.criada_em,'YYYY-MM-DD') "
        "from acervo.casa c "
        "join acervo.especie_tipo e on e.id=c.especie_id "
        "left join acervo.casa_impressao ci on ci.casa_id=c.id and ci.estado='servindo' "
        "where e.slug=%s%s order by c.repo, c.path;" % (_lit(especie), cond_dono)
    )
    saida = _psql(sql)
    linhas = [l for l in saida.splitlines() if l.strip()]
    itens = []
    for l in linhas:
        campos = l.split("|")
        if len(campos) < 8:
            morre("acervo casa listar %s: linha com formato inesperado (%d campos):\n  %s"
                  % (especie, len(campos), l), 3)
        repo, path, sha, dono_doc, natureza, ciclo, titulo, criado = campos[:8]
        vetorizado_em = campos[8] if len(campos) > 8 and campos[8] else None
        item = {
            "repo": repo, "path": path, "sha": sha, "dono": dono_doc,
            "natureza": natureza, "ciclo": ciclo,
            "titulo": titulo or None, "criado_em": criado,
            "vetorizado_em": vetorizado_em,
        }
        if situacao:
            item["situacao"] = {
                "fonte": f"{repo}@{sha[:12]}",
                "ingerido": criado,
                "servido": f"{sha[:12]} (igual)",
                "vetorizado": vetorizado_em or "não",
                "status": ciclo,
            }
        itens.append(item)
    if quero_json:
        print(json.dumps(itens, ensure_ascii=False, indent=2))
        return 0
    if not itens:
        filtro = f" (dono={dono})" if dono else ""
        sys.stdout.write(f"motivo: nenhuma entidade da especie '{especie}' encontrada em acervo.casa{filtro}.\n")
        return 0
    if situacao:
        for i in itens:
            rp = "%s@%s" % (i["repo"], i["path"])
            sit = i["situacao"]
            print(f"== {rp} ({i['titulo'] or '-'}) ==")
            print(f"fonte: {sit['fonte']}   ingerido: {sit['ingerido']}   servido: {sit['servido']}")
            print(f"vetorizado: {sit['vetorizado']}   status: {sit['status']}\n")
        sys.stderr.write(f"\n{len(itens)} linha(s) da especie '{especie}' em acervo.casa.\n")
        return 0

    wr = max((len("%s@%s" % (i["repo"], i["path"])) for i in itens), default=10)
    print("%-*s  %-12s  %-11s  %s" % (wr, "repo@path", "natureza", "ciclo", "titulo"))
    print("%s  %-12s  %-11s  %s" % ("-" * wr, "-" * 12, "-" * 11, "-" * 6))
    for i in itens:
        rp = "%s@%s" % (i["repo"], i["path"])
        print("%-*s  %-12s  %-11s  %s" % (wr, rp, i["natureza"], i["ciclo"], i["titulo"] or "-"))
    sys.stderr.write("\n%d linha(s) da especie '%s' em acervo.casa.\n" % (len(itens), especie))
    return 0


sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _identidade

def ler(especie, seletor, quero_json, situacao=False):
    """Uma linha pela identidade: seletor casa com path (ou repo@path se vier o repo)."""
    _valida_especie(especie)
    if especie == "adr" and "@" not in seletor:
        ficha = _identidade.resolver_identidade("adr", seletor)
        substrato = _identidade.obter_substrato(ficha["id"])
        if not substrato or not substrato.get("repo") or not substrato.get("path"):
            morre("acervo casa: ficha '%s' (%s) sem substrato em acervo.entidade_suporte."
                  % (ficha["id"], ficha.get("chave_humana", seletor)), 3)
        repo = substrato["repo"]
        path = substrato["path"]
        cond = "c.repo=%s and c.path=%s" % (_lit(repo), _lit(path))
    elif "@" in seletor:
        repo, path = seletor.split("@", 1)
        cond = "c.repo=%s and c.path=%s" % (_lit(repo), _lit(path))
    else:
        cond = "c.path=%s" % _lit(seletor)
    # DUAS queries, de proposito. O corpo de um doc da casa e' multi-LINHA, e a saida do
    # psql -tAF| e' quebrada por linha: trazer corpo junto fazia UM doc de 96 linhas parecer
    # 96 registros, e toda leitura de doc longo morria em "seletor ambiguo". A contagem sai
    # do metadado (uma linha por doc); o corpo vem depois, pela identidade ja resolvida.
    sql_meta = (
        "select c.repo, c.path, c.sha, c.dono, c.natureza, c.ciclo, coalesce(c.titulo,''), "
        "       to_char(c.criado_em,'YYYY-MM-DD'), "
        "       to_char(ci.criada_em,'YYYY-MM-DD') "
        "from acervo.casa c "
        "join acervo.especie_tipo e on e.id=c.especie_id "
        "left join acervo.casa_impressao ci on ci.casa_id=c.id and ci.estado='servindo' "
        "where e.slug=%s and %s order by c.repo, c.path;" % (_lit(especie), cond)
    )
    linhas = [l for l in _psql(sql_meta).splitlines() if l.strip()]
    if not linhas:
        diag = _identidade.gerar_negativa(especie, seletor)
        morre("acervo casa: nada da especie '%s' com seletor '%s' em acervo.casa.\n%s"
              % (especie, seletor, diag), 1)
    if len(linhas) > 1:
        achados = "\n".join("    - %s@%s" % tuple(l.split("|")[:2]) for l in linhas[:10])
        morre("acervo casa: seletor '%s' ambiguo (%d docs); use repo@path:\n%s"
              % (seletor, len(linhas), achados), 2)
    campos = linhas[0].split("|")
    repo, path, sha, dono, natureza, ciclo, titulo = campos[:7]
    criado = campos[7] if len(campos) > 7 else ""
    vetorizado_em = campos[8] if len(campos) > 8 and campos[8] else None

    corpo = _psql(
        "select c.corpo from acervo.casa c where c.repo=%s and c.path=%s;"
        % (_lit(repo), _lit(path))
    )
    sit_dict = {
        "fonte": f"{repo}@{sha[:12]}",
        "ingerido": criado,
        "servido": f"{sha[:12]} (igual)",
        "vetorizado": vetorizado_em or "não",
        "status": ciclo,
    }
    if quero_json:
        doc = {
            "repo": repo, "path": path, "sha": sha, "dono": dono,
            "natureza": natureza, "ciclo": ciclo, "titulo": titulo or None,
            "corpo": corpo,
        }
        if situacao:
            doc["situacao"] = sit_dict
        print(json.dumps(doc, ensure_ascii=False, indent=2))
        return 0
    if situacao:
        sys.stdout.write(f"fonte: {sit_dict['fonte']}   ingerido: {sit_dict['ingerido']}   servido: {sit_dict['servido']}\n"
                         f"vetorizado: {sit_dict['vetorizado']}   status: {sit_dict['status']}\n\n")
    sys.stdout.write(corpo)
    if not corpo.endswith("\n"):
        sys.stdout.write("\n")
    return 0


USO = """uso:
  acervo listar casa <especie> [--dono <cadeira>] [--situacao] [--json]
  acervo ler    casa <especie> <seletor> [--situacao] [--json]

<especie> e validada contra acervo.especie_tipo (vocabulario fechado, arq:0059).
Read-only; a escrita e `acervo escrever/ingerir casa`."""


def main(argv):
    # Invocado pelo despachante como: _acervo/casa <ato> <especie> [seletor] [--dono d] [--situacao] [--json]
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)
    ato = argv[0]
    resto = argv[1:]
    quero_json = "--json" in resto
    situacao = "--situacao" in resto
    resto = [a for a in resto if a not in ("--json", "--situacao")]

    dono = None
    pos = []
    i = 0
    while i < len(resto):
        if resto[i] == "--dono" and i + 1 < len(resto):
            dono = resto[i + 1]
            i += 2
        else:
            pos.append(resto[i])
            i += 1

    if ato == "listar":
        if len(pos) != 1:
            morre("acervo listar casa: falta a especie.\n\n%s" % USO, 2)
        return listar(pos[0], quero_json, dono=dono, situacao=situacao)
    if ato == "ler":
        if len(pos) != 2:
            morre("acervo ler casa <especie> <seletor>: faltam argumentos.\n\n%s" % USO, 2)
        return ler(pos[0], pos[1], quero_json, situacao=situacao)
    morre("acervo casa: ato desconhecido '%s' (ler, listar).\n\n%s" % (ato, USO), 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
