#!/usr/bin/env python3
# acervo casa — leitura da partição casa a partir da tabela acervo.casa (rag_extractor).
# capacidade: conhecimento
# dono: claudinho-dados
#   (matéria/semântica: claudinho-dados · dono; mecanismo/harness: claudinho-TI · construcao)
#
# É o sub-ato genérico das espécies de `casa` que vivem na TABELA acervo.casa —
# as espécies novas (caderno, persona, spec, minuta, cabecalho-de-verbo, automacao,
# pagina) e qualquer outra de especie_tipo que não tenha sub-ato legado dedicado.
# As espécies com fonte própria (adr → _acervo/adr, pagina-wiki → _acervo/wiki,
# stack → _acervo/stack, ferramental → _acervo/ferramenta) continuam roteadas por
# seus casos no despachante bin/acervo; só o que sobra cai aqui.
#
# Formas (arq:0106):
#   acervo listar casa <especie> [--json]       linhas de acervo.casa daquela espécie
#   acervo ler    casa <especie> <seletor>      uma linha, por path (identidade repo@path)
#
# A espécie é validada contra acervo.especie_tipo: espécie inexistente RECUSA com a
# lista viva, em vez de servir vazio (a trava da spec_acervo-casa §Corte).
# Read-only. Escrita é `acervo escrever/ingerir casa` (outro caminho).
import json
import os
import signal
import subprocess
import sys

try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"


def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def _psql(sql):
    """SQL no rag_extractor via docker exec; devolve stdout cru (-tAF|)."""
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    try:
        return subprocess.run(
            ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-tAF|", "-c", sql],
            capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo casa: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo casa: psql falhou (rc=%s):\n%s"
              % (e.returncode, (e.stderr or "").strip()), 3)


def _especies_vivas():
    """Set de slugs de acervo.especie_tipo — o vocabulário fechado (arq:0059)."""
    saida = _psql("select slug from acervo.especie_tipo order by slug;")
    return [l.strip() for l in saida.splitlines() if l.strip()]


def _valida_especie(especie):
    vivas = _especies_vivas()
    if especie not in vivas:
        morre("acervo casa: especie '%s' nao existe em acervo.especie_tipo.\n"
              "  especies vivas: %s" % (especie, ", ".join(vivas)), 2)


# SQL parametrizado por espécie via literal seguro: a espécie já foi validada contra
# a tabela (allowlist viva), então não há injeção — mas escapamos aspa simples por higiene.
def _lit(s):
    return "'" + s.replace("'", "''") + "'"


def listar(especie, quero_json):
    _valida_especie(especie)
    sql = (
        "select c.repo, c.path, c.dono, c.natureza, c.ciclo, coalesce(c.titulo,''), "
        "       to_char(c.criado_em,'YYYY-MM-DD') "
        "from acervo.casa c join acervo.especie_tipo e on e.id=c.especie_id "
        "where e.slug=%s order by c.repo, c.path;" % _lit(especie)
    )
    saida = _psql(sql)
    linhas = [l for l in saida.splitlines() if l.strip()]
    itens = []
    for l in linhas:
        campos = l.split("|")
        if len(campos) != 7:
            morre("acervo casa listar %s: linha com formato inesperado (%d campos):\n  %s"
                  % (especie, len(campos), l), 3)
        repo, path, dono, natureza, ciclo, titulo, criado = campos
        itens.append({
            "repo": repo, "path": path, "dono": dono,
            "natureza": natureza, "ciclo": ciclo,
            "titulo": titulo or None, "criado_em": criado,
        })
    if quero_json:
        print(json.dumps(itens, ensure_ascii=False, indent=2))
        return 0
    if not itens:
        sys.stderr.write("acervo casa: nenhuma linha da especie '%s' em acervo.casa "
                         "(a tabela existe; espere a ingestao do passo e).\n" % especie)
        return 0
    wr = max((len("%s@%s" % (i["repo"], i["path"])) for i in itens), default=10)
    print("%-*s  %-12s  %-11s  %s" % (wr, "repo@path", "natureza", "ciclo", "titulo"))
    print("%s  %-12s  %-11s  %s" % ("-" * wr, "-" * 12, "-" * 11, "-" * 6))
    for i in itens:
        rp = "%s@%s" % (i["repo"], i["path"])
        print("%-*s  %-12s  %-11s  %s" % (wr, rp, i["natureza"], i["ciclo"], i["titulo"] or "-"))
    sys.stderr.write("\n%d linha(s) da especie '%s' em acervo.casa.\n" % (len(itens), especie))
    return 0


def ler(especie, seletor, quero_json):
    """Uma linha pela identidade: seletor casa com path (ou repo@path se vier o repo)."""
    _valida_especie(especie)
    if "@" in seletor:
        repo, path = seletor.split("@", 1)
        cond = "c.repo=%s and c.path=%s" % (_lit(repo), _lit(path))
    else:
        cond = "c.path=%s" % _lit(seletor)
    sql = (
        "select c.repo, c.path, c.sha, c.dono, c.natureza, c.ciclo, "
        "       coalesce(c.titulo,''), c.corpo "
        "from acervo.casa c join acervo.especie_tipo e on e.id=c.especie_id "
        "where e.slug=%s and %s;" % (_lit(especie), cond)
    )
    saida = _psql(sql)
    linhas = [l for l in saida.splitlines() if l.strip()]
    if not linhas:
        morre("acervo casa: nada da especie '%s' com seletor '%s' em acervo.casa."
              % (especie, seletor), 1)
    if len(linhas) > 1:
        morre("acervo casa: seletor '%s' ambiguo (%d linhas); use repo@path."
              % (seletor, len(linhas)), 2)
    campos = linhas[0].split("|")
    # corpo pode conter |; junta o rump depois dos 7 primeiros campos
    repo, path, sha, dono, natureza, ciclo, titulo = campos[:7]
    corpo = "|".join(campos[7:])
    if quero_json:
        print(json.dumps({
            "repo": repo, "path": path, "sha": sha, "dono": dono,
            "natureza": natureza, "ciclo": ciclo, "titulo": titulo or None,
            "corpo": corpo,
        }, ensure_ascii=False, indent=2))
        return 0
    sys.stdout.write(corpo)
    if not corpo.endswith("\n"):
        sys.stdout.write("\n")
    return 0


USO = """uso:
  acervo listar casa <especie> [--json]     linhas de acervo.casa daquela especie
  acervo ler    casa <especie> <seletor>    uma linha por path (ou repo@path)

<especie> e validada contra acervo.especie_tipo (vocabulario fechado, arq:0059).
Read-only; a escrita e `acervo escrever/ingerir casa`."""


def main(argv):
    # Invocado pelo despachante como: _acervo/casa <ato> <especie> [seletor] [--json]
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)
    ato = argv[0]
    resto = argv[1:]
    quero_json = "--json" in resto
    resto = [a for a in resto if a != "--json"]
    if ato == "listar":
        if len(resto) != 1:
            morre("acervo listar casa: falta a especie.\n\n%s" % USO, 2)
        return listar(resto[0], quero_json)
    if ato == "ler":
        if len(resto) != 2:
            morre("acervo ler casa <especie> <seletor>: faltam argumentos.\n\n%s" % USO, 2)
        return ler(resto[0], resto[1], quero_json)
    morre("acervo casa: ato desconhecido '%s' (ler, listar).\n\n%s" % (ato, USO), 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
