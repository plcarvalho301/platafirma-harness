def normalizar(especie, seletor):
    """Seletor -> chave canônica, sem banco (arq:0115 §3.4). None = não é chave de forma
    fechada (número nu de adr, que resolve por série; ou texto, que cai no título).
    adr fora da forma que parece chave (`arq:11O`, `12a`) recusa, exit 2."""
    s = seletor.strip()
    if especie == "adr":
        m = RE_ADR.match(s)
        if m:
            return f"{m.group(1)}:{int(m.group(2)):04d}" if m.group(1) else None
        if re.match(r"^[a-z]+:", s) or re.match(r"^\d", s):
            morre(f"acervo ler casa adr: seletor '{s}' invalido. Forma esperada: {FORMA_ADR}", 2)
        return None
    if especie == "minuta" and re.fullmatch(r"\d{1,4}", s):
        return f"{int(s):04d}"
    return s


def _ambiguo(especie, seletor, cands, porque):
    ops = "\n".join(f"    acervo ler casa {especie} {ident(c)}   {c.get('titulo') or ''}".rstrip()
                    for c in cands[:20])
    morre(f"acervo ler casa {especie}: '{seletor}' ambiguo ({porque}, {len(cands)} fichas):\n{ops}", 2)


def resolver(especie, seletor, info):
    """A linha de acervo.casa do seletor, pela escada: chave -> número nu (adr) -> slug sem
    data (datado) -> slug de arquivo (adr) -> repo@path / path -> título. Nada: negativa,
    exit 1."""
    s = seletor.strip()
    base = f"e.slug = {_lit(especie)}"
    if "@" in s and not s.startswith("@"):
        repo, path = s.split("@", 1)
        cands = _linhas(f"{base} and c.repo = {_lit(repo)} and c.path = {_lit(path)}")
        if cands:
            return cands[0]
    else:
        chave = normalizar(especie, s)
        if chave:
            cands = _linhas(f"{base} and c.chave = {_lit(chave)}")
            if cands:
                return cands[0]
        m = RE_ADR.match(s) if especie == "adr" else None
        if m and not m.group(1):
            cands = _linhas(f"{base} and c.numero = {int(m.group(2))}", limite=50)
            if len(cands) > 1:
                _ambiguo(especie, s, cands, "o número existe em mais de uma série")
            if cands:
                return cands[0]
        if info.get("regime") == "datado" and RE_SLUG.match(s) and not RE_DATADO.match(s):
            rx = "^[0-9]{4}-[0-9]{2}-[0-9]{2}-" + s + "$"
            cands = _linhas(f"{base} and c.chave ~ {_lit(rx)}", limite=50)
            if len(cands) > 1:
                _ambiguo(especie, s, cands, "o slug existe em mais de uma data")
            if cands:
                return cands[0]
        # adr e regime 'vivo' (chave <serie>:NNNN, nao o slug) mas o arquivo ainda e
        # NNNN-<slug>.md: sem este degrau, o slug do arquivo nunca resolvia (card #3121).
        if especie == "adr" and RE_SLUG.match(s) and not RE_ADR.match(s):
            rx = "/[0-9]{4}-" + s + r"\.md$"
            cands = _linhas(f"{base} and c.path ~ {_lit(rx)}", limite=50)
            if len(cands) > 1:
                _ambiguo(especie, s, cands, "o slug existe em mais de um arquivo")
            if cands:
                return cands[0]
        cands = _linhas(f"{base} and c.path = {_lit(s)}", limite=50)
        if len(cands) > 1:
            _ambiguo(especie, s, cands, "o caminho existe em mais de um repo")
        if cands:
            return cands[0]
        # Fallback final pelo título — nunca para o que já tem forma de chave de adr.
        if not (especie == "adr" and RE_ADR.match(s)):
            cands = _linhas(f"{base} and lower(c.titulo) = lower({_lit(s)})", limite=50)
            if not cands and len(s) >= 3:
                pat = s.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
                cands = _linhas(f"{base} and c.titulo ilike {_lit('%' + pat + '%')}", limite=50)
            if len(cands) > 1:
                _ambiguo(especie, s, cands, "o título casa com mais de uma ficha")
            if cands:
                return cands[0]
    diag = _identidade.gerar_negativa(especie, seletor, casa=True)
    if especie == "adr":
        diag += f"\nformas: {FORMA_ADR} ou <slug> do arquivo"
    morre("acervo casa: nada da especie '%s' com chave '%s' em acervo.casa.\n%s"
          % (especie, seletor, diag), 1)


def ler(especie, seletor, quero_json, situacao=False):
    normalizar(especie, seletor)   # forma inválida é erro de uso (exit 2) antes de tocar o banco
    info = _especie(especie)
    linha = resolver(especie, seletor, info)
    fonte = _fonte()
    sit = _situacao(linha, fonte, _estado_espelho())

    if linha.get("retirada_em"):
        # §3.5: a chave segue resolvível; responde a sucessora, sem o texto.
        if quero_json:
            doc = _item(linha) | {"corpo": None}
            if situacao:
                doc["situacao"] = sit
            print(json.dumps(doc, ensure_ascii=False, indent=2))
            return 0
        print(marca_linha(linha, especie))
        print(f"{ident(linha)}: {txt_retirada(linha)}")
        if linha.get("substituida_por"):
            print(f"  a vigente: acervo ler casa {especie} {linha['substituida_por']}")
        return 0

    corpo = (_q(f"select json_build_object('corpo', c.corpo) from acervo.casa c "
                f"where c.id = {_lit(linha['id'])}::uuid;") or {}).get("corpo") or ""
    if quero_json:
        doc = _item(linha) | {"corpo": corpo}
        if situacao:
            doc["situacao"] = sit
        print(json.dumps(doc, ensure_ascii=False, indent=2))
        return 0
    print(marca_linha(linha, especie))
    if situacao:
        sys.stdout.write(f"{ident(linha)} · {linha.get('titulo') or '-'}\n"
                         f"fonte: {sit['fonte']}   ingerido: {sit['ingerido']}   servido: {sit['servido']}\n"
                         f"vetorizado: {sit['vetorizado']}   status: {sit['status']}\n\n")
    sys.stdout.write(corpo)
    if not corpo.endswith("\n"):
        sys.stdout.write("\n")
    return 0


USO = """uso:
  acervo listar casa [--json]                              catálogo das espécies de casa
  acervo listar casa <especie> [--todas] [--dono <cadeira>] [--situacao] [--json]
  acervo listar casa [<especie>] --sobre <classe> <chave> [--todas] [--json]
  acervo listar casa guia --mapa                          as linhas de mapa das rotinas (peça `rotinas`)
  acervo ler    casa <especie> <chave> [--situacao] [--json]

<chave>: adr <serie>:NNNN (arq:0075; arq:75 e 75 resolvem se não houver ambiguidade) ou o
<slug> do arquivo NNNN-<slug>.md (se único), minuta NNNN, datado <AAAA-MM-DD>-<slug> (ou só
o <slug>, se único), vivo <slug>.
<especie> é validada contra acervo.especie_tipo (vocabulário fechado, arq:0059).
exit: 0 ok · 1 nada · 2 uso/forma/ambíguo · 5 indeterminável.
Read-only; a escrita é `acervo ingerir casa platafirma-casa`."""


def main(argv):
    # Invocado pelo despachante como: _acervo/casa <ato> [especie] [seletor] [--sobre c k]
    #                                 [--dono d] [--todas] [--situacao] [--json]
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre(USO, 0 if argv else 2)
    ato = argv[0]
    resto = argv[1:]
    quero_json = "--json" in resto
    situacao = "--situacao" in resto
    todas = "--todas" in resto
    quero_mapa = "--mapa" in resto
    resto = [a for a in resto if a not in ("--json", "--situacao", "--todas", "--mapa")]

    dono = None
    sobre_args = None
    pos = []
    i = 0
    while i < len(resto):
        if resto[i] == "--dono" and i + 1 < len(resto):
            dono = resto[i + 1]
            i += 2
        elif resto[i] == "--sobre":
            # <classe> <chave> ou <classe>:<chave>; nunca engole a flag seguinte
            sobre_args = []
            i += 1
            while (i < len(resto) and len(sobre_args) < 2 and not resto[i].startswith("--")
                   and not (sobre_args and ":" in sobre_args[0])):
                sobre_args.append(resto[i])
                i += 1
        else:
            pos.append(resto[i])
            i += 1

    if ato == "listar":
        if sobre_args is not None:
            if not sobre_args or len(pos) > 1:
                morre("acervo listar casa [<especie>] --sobre <classe> <chave>: faltam "
                      "argumentos.\n\n%s" % USO, 2)
            classe = sobre_args[0]
            chave = sobre_args[1] if len(sobre_args) > 1 else None
            return sobre(classe, chave, pos[0] if pos else None, quero_json, todas=todas)
        if not pos:
            return catalogo(quero_json)
        if quero_mapa:
            if len(pos) != 1:
                morre("acervo listar casa <especie> --mapa: uma espécie só.\n\n%s" % USO, 2)
            return mapa(pos[0])
        if len(pos) != 1:
            morre("acervo listar casa <especie>: argumentos demais.\n\n%s" % USO, 2)
        return listar(pos[0], quero_json, dono=dono, situacao=situacao, todas=todas)
    if ato == "ler":
        if len(pos) != 2:
            morre("acervo ler casa <especie> <chave>: faltam argumentos.\n\n%s" % USO, 2)
        return ler(pos[0], pos[1], quero_json, situacao=situacao)
    morre("acervo casa: ato desconhecido '%s' (ler, listar).\n\n%s" % (ato, USO), 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
