def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def indeterminavel(motivo, detalhe=""):
    """§11.2: fonte que não responde não é '0 linhas'. A primeira linha diz, exit 5."""
    sys.stdout.write(f"indeterminável · {motivo}\n")
    if detalhe:
        sys.stderr.write(detalhe.rstrip("\n") + "\n")
    sys.exit(5)


def _q(sql, alvo="acervo.casa"):
    """SELECT que devolve UM valor json (json_agg / json_build_object). None = sem linha."""
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    try:
        r = subprocess.run(
            ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-tAq",
             "-v", "ON_ERROR_STOP=1", "-c", sql],
            capture_output=True, env=env)
    except FileNotFoundError:
        indeterminavel("docker nao encontrado no PATH: acervo.casa inalcançável")
    if r.returncode != 0:
        indeterminavel(f"psql falhou lendo {alvo} (rc={r.returncode})",
                       r.stderr.decode("utf-8", "replace"))
    saida = r.stdout.decode("utf-8", "replace").strip()
    if not saida:
        return None
    try:
        return json.loads(saida)
    except ValueError as e:
        indeterminavel(f"psql devolveu json ilegível lendo {alvo} ({e})", saida[:300])


def _lit(s):
    return "'" + str(s).replace("'", "''") + "'"


# ------------------------------------------------------------------ cobertura (§11.2)

def _especies_vivas():
    return _q("select coalesce(json_agg(slug order by slug), '[]') from acervo.especie_tipo;",
              "acervo.especie_tipo") or []


def _especie(especie):
    """Espécie com projeção, regime e contagem; fora do vocabulário (arq:0059) recusa."""
    info = _q(f"""
      select json_build_object(
        'slug', e.slug, 'projecao', e.projecao, 'regime', e.regime,
        'vivas', (select count(*) from acervo.casa c
                   where c.especie_id = e.id and c.retirada_em is null),
        'retiradas', (select count(*) from acervo.casa c
                       where c.especie_id = e.id and c.retirada_em is not null),
        'sem_chave', (select count(*) from acervo.casa c
                       where c.especie_id = e.id and c.retirada_em is null and c.chave is null),
        'fora_da_fonte', (select count(*) from acervo.casa c
                           where c.especie_id = e.id and c.retirada_em is null
                             and c.repo = {_lit(SUPORTE)}
                             and c.sha is distinct from (
                                 select f.sha from acervo.casa_fonte f
                                  where f.repo = {_lit(SUPORTE)}
                                  order by f.ingerido_em desc limit 1)),
        'legado', (select count(*) from acervo.casa c
                    where c.especie_id = e.id and c.retirada_em is null
                      and c.repo <> {_lit(SUPORTE)}),
        'ultimo', (select json_object_agg(coalesce(t.serie, ''), t.ult order by t.serie)
                     from (select serie, max(numero) as ult from acervo.casa
                            where especie_id = e.id and numero is not null
                            group by serie) t))
        from acervo.especie_tipo e where e.slug = {_lit(especie)};""", "acervo.especie_tipo")
    if not info:
        morre("acervo casa: especie '%s' nao existe em acervo.especie_tipo.\n"
              "  especies vivas: %s" % (especie, ", ".join(_especies_vivas())), 2)
    return info


def _fonte():
    """Último sha do suporte ingerido (acervo.casa_fonte), ou None."""
    return _q(f"""
      select json_build_object('sha', f.sha,
               'em', to_char(f.ingerido_em at time zone 'UTC', 'YYYY-MM-DD HH24:MI"Z"'))
        from acervo.casa_fonte f where f.repo = {_lit(SUPORTE)}
       order by f.ingerido_em desc limit 1;""", "acervo.casa_fonte")


def txt_fonte(fonte):
    if not fonte:
        return f"fonte {SUPORTE}: nunca ingerida"
    return f"fonte {SUPORTE}@{fonte['sha'][:12]} ingerida em {fonte['em']}"


def txt_ultimo(ultimo):
    """{'arq': 115, 'seg': 14} -> 'último: arq:0115 · seg:0014'; minuta ('' -> 38): '0038'."""
    if not ultimo:
        return None
    partes = [f"{s}:{int(n):04d}" if s else f"{int(n):04d}" for s, n in sorted(ultimo.items())]
    return "último: " + " · ".join(partes)


def _estado_espelho():
    """(main, motivo, busca) do espelho do suporte: o origin/main JÁ buscado (ou None e o
    motivo) e a hora da última busca. Leitura não busca no forge."""
    main, motivo = _suporte.main_do_espelho()
    return main, motivo, _suporte.ultima_busca() if main else None


def txt_espelho(esp, sha=None):
    """O main do espelho contra `sha`, dizendo de quando é a busca."""
    main, motivo, busca = esp
    if not main:
        return f"main do espelho indeterminável: {motivo}"
    quando = f", buscado em {busca}" if busca else ", sem registro de busca"
    if sha and main == sha:
        return f"= main do espelho{quando}"
    return f"main do espelho em {main[:12]}{quando}"


def linha_cobertura(n, info, fonte, esp=None, todas=False, dono=None):
    partes = [f"{n} linha(s)", info["slug"], txt_fonte(fonte)]
    if esp is not None and fonte:
        partes.append(txt_espelho(esp, fonte["sha"])
                      + ("" if not esp[0] or esp[0] == fonte["sha"] else ": ingestão defasada"))
    partes += [f"projeção {info.get('projecao') or '(nenhuma)'}",
               f"regime {info.get('regime') or '(nenhum)'}"]
    ult = txt_ultimo(info.get("ultimo"))
    if ult:
        partes.append(ult)
    if info.get("sem_chave"):
        partes.append(f"{info['sem_chave']} sem chave (id=repo@path)")
    if fonte and info.get("fora_da_fonte"):
        partes.append(f"{info['fora_da_fonte']} com texto de outro sha que a fonte "
                      f"(versão nova recusada ou fora do recorte)")
    if info.get("legado"):
        partes.append(f"{info['legado']} fora do suporte (legado)")
    if todas:
        partes.append("inclui retiradas")
    elif info.get("retiradas"):
        partes.append(f"{info['retiradas']} retirada(s) fora (--todas)")
    if dono:
        partes.append(f"dono={dono}")
    return " · ".join(partes)


def servido(linha, fonte, esp):
    """Honesto (arq:0110 Q6), POR LINHA: o sha do texto que a linha serve contra o sha da
    última fonte ingerida (casa_fonte) e contra o main do espelho, com a hora da busca.
    Linha com sha diferente do da fonte serve texto velho: a versão nova foi recusada
    (legado mantido, D4) ou ficou fora do recorte (--so/--limite)."""
    repo, sha = linha.get("repo"), linha.get("sha") or ""
    if linha.get("retirada_em"):
        return f"não servida: retirada em {linha['retirada_em']} (último texto de {sha[:12] or '?'})"
    if repo != SUPORTE:
        return f"fora do suporte (legado de {repo})"
    if not fonte:
        return "nunca ingerido"
    l12, f12 = sha[:12] or "?", fonte["sha"][:12]
    if sha != fonte["sha"]:
        return (f"texto de {l12}; fonte em {f12}: versão nova recusada ou fora do recorte "
                f"({txt_espelho(esp, sha)})")
    main = esp[0]
    if main and main != sha:
        return f"{l12} ({txt_espelho(esp, sha)}: ingestão defasada)"
    return f"{l12} ({txt_espelho(esp, sha)})"


# ------------------------------------------------------------------ linhas

_CAMPOS = """
    c.id::text as id, c.chave, c.serie, c.numero, c.repo, c.path, c.sha, c.dono,
    c.natureza::text as natureza, c.ciclo::text as ciclo, coalesce(c.titulo, '') as titulo,
    s.slug as subtipo, e.slug as especie, to_char(c.criado_em, 'YYYY-MM-DD') as criado_em,
    to_char(c.retirada_em at time zone 'UTC', 'YYYY-MM-DD') as retirada_em, c.substituida_por,
    to_char(ci.criada_em, 'YYYY-MM-DD') as vetorizado_em,
    c.forca::text as forca, c.revisao, c.status_declarado"""

# card #3139 item 1: rotulo de exibicao da forca (o slug do banco fica em _item()["forca"]).
# `registro` leva a data embutida na chave datada (<AAAA-MM-DD>-<slug>): "registro de
# AAAA-MM-DD", nao so "registro".
FORCA_ROTULO = {"decisao": "decisão", "proposta": "proposta",
               "nao_declarada": "força não declarada"}
_RE_DATA_CHAVE = re.compile(r"^(\d{4}-\d{2}-\d{2})")

def _rotulo_forca(linha):
    forca = linha.get("forca")
    if forca == "registro":
        m = _RE_DATA_CHAVE.match(linha.get("chave") or "")
        return f"registro de {m.group(1)}" if m else "registro"
    return FORCA_ROTULO.get(forca, forca or "força não declarada")

_ORDEM = "t.serie nulls last, t.numero nulls last, t.chave nulls last, t.repo, t.path"


def _linhas(where, limite=None):
    lim = f" limit {int(limite)}" if limite else ""
    return _q(f"""
      select coalesce(json_agg(row_to_json(t) order by {_ORDEM}), '[]') from (
        select {_CAMPOS}
          from acervo.casa c
          join acervo.especie_tipo e on e.id = c.especie_id
          left join acervo.especie_subtipo s on s.id = c.subtipo_id
          left join acervo.casa_impressao ci on ci.casa_id = c.id and ci.estado = 'servindo'
         where {where}
         order by c.serie nulls last, c.numero nulls last, c.chave nulls last, c.repo, c.path
         {lim}) t;""") or []


def ident(linha):
    """§11.1: a chave é o identificador; sem ela, repo@path (declarado na cobertura)."""
    return linha.get("chave") or f"{linha['repo']}@{linha['path']}"


def txt_retirada(linha):
    suc = linha.get("substituida_por")
    return (f"retirada em {linha['retirada_em']}; "
            + (f"substituída por {suc}" if suc else "sem sucessora declarada"))

def vigencia(linha):
    """card #3139 item 1: vigente | substituída por <chave> | retirada em <data> sem sucessora."""
    if not linha.get("retirada_em"):
        return "vigente"
    suc = linha.get("substituida_por")
    if suc:
        return f"substituída por {suc}"
    return f"retirada em {linha['retirada_em']} sem sucessora"

def forca_vigencia_txt(linha):
    """`<força>[, rev N] · <vigência>` (card #3139 item 1/4)."""
    txt = _rotulo_forca(linha)
    if linha.get("revisao"):
        txt += f", rev {linha['revisao']}"
    return f"{txt} · {vigencia(linha)}"

def marca_linha(linha, especie):
    """A linha que `ler casa` escreve antes do corpo (card #3139 item 1)."""
    return (f"{forca_vigencia_txt(linha)} — {especie} {ident(linha)} · "
            f"{linha.get('titulo') or '-'}")


def _situacao(linha, fonte, esp):
    return {
        "fonte": f"{linha['repo']}@{(linha.get('sha') or '')[:12]}",
        "ingerido": linha.get("criado_em"),
        "servido": servido(linha, fonte, esp),
        "vetorizado": linha.get("vetorizado_em") or "não",
        "status": txt_retirada(linha) if linha.get("retirada_em") else linha.get("ciclo"),
    }


def _item(linha):
    return {k: linha.get(k) for k in (
        "chave", "serie", "numero", "repo", "path", "sha", "dono", "natureza", "ciclo",
        "subtipo", "criado_em", "retirada_em", "substituida_por",
        "forca", "revisao", "status_declarado")} | {
        "id": ident(linha), "titulo": linha.get("titulo") or None,
        "vetorizado_em": linha.get("vetorizado_em"),
        "vigencia": vigencia(linha),
        "marca": marca_linha(linha, linha["especie"]) if linha.get("especie") else None}


# ------------------------------------------------------------------ mapa das rotinas
# Peça `rotinas` da abertura (#3084): cada guia de rotina abre com `## Mapa` e um bloco
# cercado; `acervo listar casa guia --mapa` junta os blocos numa chamada só, em ordem fixa e
# sem data nem sha no corpo, para o prefixo da abertura ficar byte-estável.

ORDEM_MAPA = ("LER", "LEVANTAR", "CONFERIR", "REGISTRAR", "PUBLICAR", "REPORTAR")
CAB_MAPA = "ROTINAS — pergunta → chamada → o que o retorno diz"
_RE_MAPA = re.compile(r"^## Mapa[ \t]*\n.*?^```[^\n]*\n(?P<bloco>.*?)^```", re.M | re.S)

def extrai_mapa(corpos):
    """corpos -> (texto, faltam). Um bloco por rotina, pela primeira palavra; a primeira
    ocorrência vence. Rotina fora de ORDEM_MAPA entra depois, em ordem alfabética."""
    blocos = {}
    for corpo in corpos:
        m = _RE_MAPA.search(corpo or "")
        if not m:
            continue
        for b in re.split(r"\n[ \t]*\n", m.group("bloco").strip("\n")):
            b = b.rstrip()
            if not b.strip():
                continue
            blocos.setdefault(b.split(None, 1)[0], b)
    faltam = [n for n in ORDEM_MAPA if n not in blocos]
    if not blocos:
        return None, faltam
    ordem = [n for n in ORDEM_MAPA if n in blocos] + sorted(n for n in blocos if n not in ORDEM_MAPA)
    return "\n\n".join([CAB_MAPA] + [blocos[n] for n in ordem]), faltam

def mapa(especie):
    _especie(especie)
    linhas = _q(f"""
      select coalesce(json_agg(c.corpo order by c.chave), '[]')
        from acervo.casa c join acervo.especie_tipo e on e.id = c.especie_id
       where e.slug = {_lit(especie)} and c.retirada_em is null
         and c.corpo like '%## Mapa%';""") or []
    texto, faltam = extrai_mapa(linhas)
    if faltam:
        sys.stderr.write("aviso: sem linha de mapa para " + ", ".join(faltam) + "\n")
    if not texto:
        morre(f"acervo listar casa {especie} --mapa: nenhuma ficha viva com seção `## Mapa`.", 1)
    print(texto)
    return 0

# ------------------------------------------------------------------ listar

def catalogo(quero_json):
    """`listar casa` sem espécie: as espécies de casa (regime declarado, arq:0115 §5) e as
    que têm linha, com projeção, regime e contagem."""
    linhas = _q("""
      select coalesce(json_agg(row_to_json(t) order by t.regime nulls last, t.slug), '[]') from (
        select e.slug, e.regime, e.projecao,
               count(c.id) filter (where c.retirada_em is null) as vivas,
               count(c.id) filter (where c.retirada_em is not null) as retiradas
          from acervo.especie_tipo e
          left join acervo.casa c on c.especie_id = e.id
         where e.regime is not null or c.id is not null
         group by e.slug, e.regime, e.projecao) t;""", "acervo.especie_tipo") or []
    fonte = _fonte()
    vivas = sum(int(l["vivas"]) for l in linhas)
    cab = (f"{len(linhas)} espécie(s) de casa · {vivas} ficha(s) viva(s) · {txt_fonte(fonte)}"
           f" · ler uma: acervo listar casa <especie>")
    if quero_json:
        sys.stderr.write(cab + "\n")
        print(json.dumps(linhas, ensure_ascii=False, indent=2))
        return 0
    print(cab)
    if not linhas:
        print("motivo: nenhuma espécie com regime em acervo.especie_tipo.")
        return 0
    we = max(len(l["slug"]) for l in linhas)
    wp = max(len(l["projecao"] or "-") for l in linhas)
    print("%-*s  %-11s  %-*s  %6s  %9s" % (we, "especie", "regime", wp, "projecao", "vivas",
                                          "retiradas"))
    for l in linhas:
        print("%-*s  %-11s  %-*s  %6s  %9s" % (we, l["slug"], l["regime"] or "-", wp,
                                              l["projecao"] or "-", l["vivas"], l["retiradas"]))
    return 0


def listar(especie, quero_json, dono=None, situacao=False, todas=False):
    info = _especie(especie)
    fonte = _fonte()
    conds = [f"e.slug = {_lit(especie)}"]
    if not todas:
        conds.append("c.retirada_em is null")
    if dono:
        conds.append(f"c.dono = {_lit(dono)}")
    linhas = _linhas(" and ".join(conds))
    esp = _estado_espelho()
    cab = linha_cobertura(len(linhas), info, fonte, esp=esp, todas=todas, dono=dono)

    if quero_json:
        sys.stderr.write(cab + "\n")
        itens = []
        for l in linhas:
            it = _item(l)
            if situacao:
                it["situacao"] = _situacao(l, fonte, esp)
            itens.append(it)
        print(json.dumps(itens, ensure_ascii=False, indent=2))
        return 0

    print(cab)
    if not linhas:
        filtro = f" (dono={dono})" if dono else ""
        print(f"motivo: nenhuma ficha da especie '{especie}' em acervo.casa{filtro}.")
        return 0
    if situacao:
        for l in linhas:
            sit = _situacao(l, fonte, esp)
            print(f"\n== {ident(l)} ({l.get('titulo') or '-'}) ==")
            print(f"fonte: {sit['fonte']}   ingerido: {sit['ingerido']}   servido: {sit['servido']}")
            print(f"vetorizado: {sit['vetorizado']}   status: {sit['status']}")
        return 0

    wi = max((len(ident(l)) for l in linhas), default=5)
    wf = max((len(forca_vigencia_txt(l)) for l in linhas), default=17)
    print("%-*s  %-*s  %s" % (wi, "chave", wf, "força · vigência", "titulo"))
    print("%s  %s  %s" % ("-" * wi, "-" * wf, "-" * 6))
    for l in linhas:
        titulo = l.get("titulo") or "-"
        if l.get("subtipo"):
            titulo = f"[{l['subtipo']}] {titulo}"
        # a vigência (coluna à esquerda) já diz retirada/sucessora; título não repete.
        print("%-*s  %-*s  %s" % (wi, ident(l), wf, forca_vigencia_txt(l), titulo))
    return 0


def _entidade(classe, chave):
    """Ficha ATIVA da raiz (acervo.entidade) do referente de Sobre:, pela regra da admissão
    (D5 p7): (classe, chave_humana) exato, senão entidade_alias — e só nas classes que podem
    ser referente de Sobre: (CLASSES_SOBRE). Com classe: ela tem de ser uma dessas. Sem
    classe: procura em todas elas e só aceita se a chave cair numa ficha só.
    0 -> negativa de 4 linhas, exit 1; >1 -> opções, exit 2."""
    if classe and classe not in CLASSES_SOBRE:
        morre(f"acervo listar casa --sobre: classe '{classe}' nao e referente de Sobre: "
              f"(arq:0115 §6.2). Classes: {', '.join(CLASSES_SOBRE)}.", 2)
    classes = [classe] if classe else list(CLASSES_SOBRE)
    arr = "array[" + ", ".join(_lit(c) for c in classes) + "]::text[]"
    k = _lit(chave)
    cand = _q(f"""
      select coalesce(json_agg(row_to_json(t) order by t.classe, t.chave_humana), '[]') from (
        select e.id::text as id, e.classe, e.chave_humana
          from acervo.entidade e
         where e.classe = any({arr}) and e.estado = 'ativa' and e.chave_humana = {k}
        union
        select e.id::text, e.classe, e.chave_humana
          from acervo.entidade e join acervo.entidade_alias a on a.entidade_id = e.id
         where e.classe = any({arr}) and e.estado = 'ativa' and a.alias = {k}
           and not exists (select 1 from acervo.entidade e2
                            where e2.classe = any({arr}) and e2.estado = 'ativa'
                              and e2.chave_humana = {k})
      ) t;""", "acervo.entidade") or []
    if not cand:
        parecidos = _q(f"""
          select coalesce(json_agg(t.c order by t.sim desc, t.c), '[]') from (
            select e.classe || ' ' || e.chave_humana as c,
                   similarity(e.chave_humana, {k}) as sim
              from acervo.entidade e
             where e.classe = any({arr}) and e.estado = 'ativa'
               and similarity(e.chave_humana, {k}) > 0.2
             order by sim desc limit 5) t;""", "acervo.entidade") or []
        onde = f"classe {classe}" if classe else f"classes {', '.join(CLASSES_SOBRE)}"
        morre(f"acervo listar casa --sobre: nenhuma ficha ativa com chave '{chave}' "
              f"({onde}; exato nem alias).\n"
              f"varrido:   acervo.entidade ({onde}, estado ativa) e acervo.entidade_alias\n"
              f"parecidos: {', '.join(parecidos) or '(nenhuma chave parecida)'}\n"
              f"vizinho:   acervo listar entidade\n"
              f"cura:      a ficha do referente nasce no fichário (migração/curadoria de "
              f"dados), não no documento; o Sobre: só cita a chave (arq:0115 §6)", 1)
    if len(cand) > 1:
        ops = "\n".join(f"    --sobre {c['classe']} {c['chave_humana']}" for c in cand)
        morre(f"acervo listar casa --sobre: '{chave}' ambiguo ({len(cand)} fichas); "
              f"informe a classe:\n{ops}", 2)
    return cand[0]["classe"], cand[0]["chave_humana"], cand[0]["id"]


def sobre(classe, chave, especie, quero_json, todas=False):
    """«A documentação de X» (arq:0115 §6.4): documentos cujo Sobre: resolve à ficha."""
    if chave is None and classe and ":" in classe:
        classe, chave = classe.split(":", 1)
    elif chave is None:
        classe, chave = None, classe
    if especie:
        _especie(especie)
    classe, chave_humana, ent_id = _entidade(classe, chave)
    conds = [f"r.ref = {_lit(ent_id)}::uuid"]
    if not todas:
        conds.append("c.retirada_em is null")
    if especie:
        conds.append(f"e.slug = {_lit(especie)}")
    linhas = _q(f"""
      select coalesce(json_agg(row_to_json(t) order by t.especie, t.serie nulls last,
                               t.numero nulls last, t.chave nulls last, t.repo, t.path), '[]')
        from (select e.slug as especie, c.chave, c.serie, c.numero, c.repo, c.path,
                     coalesce(c.titulo, '') as titulo, c.ciclo::text as ciclo,
                     to_char(c.retirada_em at time zone 'UTC', 'YYYY-MM-DD') as retirada_em,
                     c.substituida_por
                from acervo.casa_referente r
                join acervo.casa c on c.id = r.casa_id
                join acervo.especie_tipo e on e.id = c.especie_id
               where {' and '.join(conds)}) t;""", "acervo.casa_referente") or []
    cab = (f"{len(linhas)} documento(s) sobre {classe} {chave_humana} · {txt_fonte(_fonte())}"
           + (f" · especie {especie}" if especie else "")
           + (" · inclui retiradas" if todas else ""))
    if quero_json:
        sys.stderr.write(cab + "\n")
        print(json.dumps([dict(l, id=ident(l)) for l in linhas], ensure_ascii=False, indent=2))
        return 0
    print(cab)
    if not linhas:
        print(f"motivo: nenhum documento de casa declara Sobre: {classe} {chave_humana}.")
        return 0
    we = max(len(l["especie"]) for l in linhas)
    wi = max(len(ident(l)) for l in linhas)
    for l in linhas:
        extra = f"  ({txt_retirada(l)})" if l.get("retirada_em") else ""
        print("%-*s  %-*s  %s%s" % (we, l["especie"], wi, ident(l), l["titulo"] or "-", extra))
    return 0


