#!/usr/bin/env python3
# _acervo/curar — atos de curadoria das particoes casa e biblioteca (spec_acervo.md §6).
# acervo curar casa alias <classe> <chave> <alias>
# Chega aqui como `curar obra ...`: `obra` e o nome interno do sub-ato que bin/acervo usa
# para a particao biblioteca, nao a particao (que saiu em 03/10/2026, #3197).
import json
import os
import signal
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _identidade

def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)

def curar_alias(classe, chave, alias):
    ficha = _identidade.resolver_identidade(classe, chave)
    entidade_id = ficha["id"]
    chave_humana = ficha.get("chave_humana", chave)

    sql = """
    insert into acervo.entidade_alias (entidade_id, alias, papel, origem)
    values (%s, %s, 'alternativo', 'curadoria')
    on conflict (entidade_id, alias) do nothing;
    """ % (_identidade._lit(entidade_id), _identidade._lit(alias))

    _identidade.psql_exec(sql)
    print(f"acervo curar: alias '{alias}' vinculado a '{classe}:{chave_humana}' ({entidade_id}).")
    return 0

def curar_obra(argv):
    """`acervo curar biblioteca ...` — repassa para bin/curar (cliente REST completo: --situacao,
    --expurgar, --restaurar, --promover, --reclassificar, --conceito, --relacionar/--relacoes/
    --desrelacionar). Existe aqui só porque `curar` não é verbo servido pela porta (#3126) —
    a lógica inteira, incluindo HermiT e export, já é a de bin/curar; nada se duplica.
    """
    alvo = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "curar")
    os.execv(sys.executable, [sys.executable, alvo, *argv])

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "ajuda"):
        morre("uso: acervo curar casa alias <classe> <chave> <alias>\n"
              "     acervo curar biblioteca --situacao|--expurgar|--restaurar|--promover|"
              "--reclassificar|--conceito ...   (repassa para bin/curar)\n"
              "     acervo curar biblioteca --conceito <slug> --renomear <slug-novo> --motivo \"…\" [--apply]   "
              "(troca o slug, cura K15: o velho vira termo de entrada; plano seco sem --apply)\n"
              "     acervo curar biblioteca --relacionar <de> <para> --tipo <t> --garantia <g> "
              "--motivo <m> [--apply]\n"
              "     acervo curar biblioteca --relacoes <conceito> | --desrelacionar <id>\n"
              "     acervo curar biblioteca --reextrair <obra> [--metodo <slug>] [--apply]   (termina na selada; "
              "--promover a poe no ar)\n"
              "     acervo curar biblioteca --reextrair --lote [--ordem <lista>] [--apply] | "
              "--reextrair --lote --relatorio <lote>\n"
              "     acervo curar biblioteca --rejulgar --lote [--apply]   (veredito pela regua vigente, sem reconverter)\n"
              "     acervo curar biblioteca --reextrair <id,id...|@arquivo> --bancada <pasta> "
              "[--metodo <slug>] [--refazer]   (converte em pasta de saida; nao escreve "
              "no acervo; depois: acervo listar biblioteca bancada <pasta>)\n"
              "     cartilha das familias e garantias: acervo relacionar biblioteca conceito --ajuda\n"
              "     --reclassificar, --conceito, --relacionar, --relacoes, --desrelacionar, --derivar, --derivacoes e "
              "--desderivar respondem com aviso: os atos de Classificar sao acervo catalogar, definir, relacionar, "
              "desrelacionar, derivar e desderivar (spec acervo, secao 10; #3296)",
              0 if argv else 2)
    sub = argv[0]
    if sub == "alias":
        if len(argv) != 4:
            morre("uso: acervo curar casa alias <classe> <chave> <alias>", 2)
        return curar_alias(argv[1], argv[2], argv[3])
    if sub == "obra":
        return curar_obra(argv[1:])
    morre(f"acervo curar: sub-ato desconhecido '{sub}' (alias, obra)", 2)

if __name__ == "__main__":
    # Sai limpo no `| head`. So na execucao direta: no import o processo do chamador nao muda (#3274).
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    sys.exit(main(sys.argv[1:]))
