#!/usr/bin/env python3
"""acervo exportar — regera, na bancada da sessao, o que deriva do schema `acervo`.

A cadeia (guia de evolucao da ontologia, §7) tem dois elos e nao para no meio:

  1. `motor_acervo.cli exportar-acervo --out <bancada>/ontologia/acervo`
     Postgres -> ontologia/acervo/*.jsonl (so LE o banco)
  2. `scripts/gen_referencia_template.py --vocabulario`
     export -> rag/docs/ontologia/vocabulario.json (offline, stdlib)

Onde roda: o CODIGO e o da bancada de `platafirma-conhecimento` da sessao que chamou
(wt/<repo>/<sessao>, senao wt/<repo>/<cadeira>, senao o clone), para o export sair coerente
com o gerador da mesma versao. O PYTHON e o venv da release (venv de bancada nunca e
runtime) e o AMBIENTE e o da ingestao declarado em registro/motor-instancias.json — o mesmo
que `motor rag indexar` usa. Nao ha plano seco: o ato so grava arquivo derivado na bancada,
que se le e se desfaz no git; o banco nao se toca.

Contrato e conteudo do export sao de dados (Olga); este ato so expoe e instala.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

_ARVORE = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(_ARVORE / "lib"))
import raizes  # noqa: E402

REPO = "platafirma-conhecimento"
REG = os.environ.get("PF_MOTOR_REG") or str(_ARVORE / "registro" / "motor-instancias.json")
CANON_INSTANCIA = "/srv/platafirma/casa/"
DOCKER_HOST = "unix:///run/user/1001/docker.sock"  # o mesmo do bin/motor
# a spec do verbo mora no suporte da casa e se lê pela chave (arq:0115; mesmo SPEC de bin/acervo)
SPEC = "spec acervo (acervo ler casa spec acervo)"


def morre(msg: str, cod: int = 3) -> None:
    print(f"acervo exportar: {msg}", file=sys.stderr)
    sys.exit(cod)


def _dono_da_bancada(wt: Path) -> str:
    """Sessão que marcou a bancada (`pf-sessao-viva` no git dir, escrita por `repo abrir`), ou \"\".
    Com várias bancadas abertas, a marca distingue a da sessão que chamou sem escolher calado."""
    g = wt / ".git"
    try:
        if g.is_file():
            txt = g.read_text(encoding="utf-8").strip()
            g = (wt / txt[len("gitdir:"):].strip()) if txt.startswith("gitdir:") else g
        return (g / "pf-sessao-viva").read_text(encoding="utf-8").split("\t")[0].strip()
    except OSError:
        return ""

def bancada_do_repo(chave: str = "") -> Path:
    """Mesma ordem do verbo `repo`: sessao, cadeira, clone. `chave` (de `--bancada <card-slug>`,
    a mesma do `repo <ato> platafirma-conhecimento@<chave>`) escolhe entre várias bancadas abertas da
    cadeira — sessões simultâneas da mesma cadeira deixam mais de uma, e fechá-las não é de quem exporta."""
    try:
        raiz = raizes.bancada()
    except raizes.BancadaNaoDeclarada as e:
        morre(str(e))
    cadeira = os.environ.get("PF_CADEIRA", "")
    for prefixo in ("claudinho-", "claudinha-"):
        if cadeira.startswith(prefixo):
            cadeira = cadeira[len(prefixo):]
    if chave:
        achadas = sorted(p for p in (raiz / "wt" / REPO).glob(f"*/{chave}") if (p / ".git").exists())
        if len(achadas) != 1:
            morre(f"--bancada {chave}: {len(achadas)} bancada(s) de {REPO} com essa chave", 2)
        return achadas[0]
    for chave in (os.environ.get("PF_SESSAO", ""), cadeira):
        if chave:
            wt = raiz / "wt" / REPO / chave
            if (wt / ".git").exists():
                return wt
    # Layout do `repo abrir` desde o #3152: wt/<repo>/<cadeira>/<card-ou-slug>. Uma bancada so:
    # e ela; mais de uma: ambiguo, recusa pedindo que feche as outras (nunca escolhe calado).
    if cadeira:
        base = raiz / "wt" / REPO / cadeira
        achadas = sorted(p for p in base.glob("*") if (p / ".git").exists()) if base.is_dir() else []
        if len(achadas) == 1:
            return achadas[0]
        if len(achadas) > 1:
            minhas = [p for p in achadas if _dono_da_bancada(p) == os.environ.get("PF_SESSAO", "")]
            if os.environ.get("PF_SESSAO") and len(minhas) == 1:
                return minhas[0]
            morre(f"{len(achadas)} bancadas de {REPO} abertas para {cadeira} "
                  f"({', '.join(p.name for p in achadas)}); diga qual com --bancada <chave>.", 2)
    clone = raiz / REPO
    if (clone / ".git").exists():
        print(f"acervo exportar: aviso: sem bancada da sessao; usando o clone {clone}",
              file=sys.stderr)
        return clone
    morre(f"nao ha bancada de {REPO} — `repo abrir {REPO}` abre uma")


def python_do_rag() -> str:
    for c in (os.environ.get("RAG_PYTHON", ""),
              str(raizes.release() / "venv" / "rag" / "bin" / "python")):
        if c and os.access(c, os.X_OK):
            return c
    morre("nenhum python do rag executavel (RAG_PYTHON ou <release>/venv/rag/bin/python)")


def _vars_do_dir(caminho: Path) -> dict:
    return {p.name: p.read_text(encoding="utf-8").strip()
            for p in sorted(caminho.iterdir())
            if p.is_file() and not p.name.endswith(".tmp")}


def _env_do_container(container: str) -> dict:
    """env efetivo do container servido (mesma leitura do `motor ... ajuste`)."""
    r = subprocess.run(
        ["docker", "inspect", container, "--format", "{{range .Config.Env}}{{println .}}{{end}}"],
        capture_output=True, text=True,
        env={**os.environ, "DOCKER_HOST": os.environ.get("DOCKER_HOST", DOCKER_HOST)})
    if r.returncode != 0:
        return {}
    return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)


def ambiente_da_ingestao() -> dict:
    """Ambiente do banco para o motor_acervo, da instancia `rag` do registro, nesta ordem:

    1. `env_da_ingestao`, se existir: arquivo NOME=valor (vai como RAG_ENV_FILE, que o
       settings carrega) ou diretorio (um arquivo por variavel);
    2. senao o cofre da stack, segredos/<stack> (POSTGRES_PASSWORD e afins);
    3. EMBED_MODEL, que o settings exige mesmo para so ler o banco, vem do container servido
       quando nenhum dos dois o declara — o embedder e o do servico, nunca um default.
    O banco e o publicado em 127.0.0.1:5432 pelo compose (default do settings).
    """
    try:
        with open(REG, encoding="utf-8") as f:
            inst = json.load(f)["rag"]
    except (OSError, KeyError, ValueError) as e:
        morre(f"registro de motor ilegivel ({REG}): {e}")
    valor = inst.get("env_da_ingestao", "")
    caminho = (raizes.instancia() / valor[len(CANON_INSTANCIA):]
               if valor.startswith(CANON_INSTANCIA) else None)
    if caminho is not None and caminho.is_file():
        env, fonte = {"RAG_ENV_FILE": str(caminho)}, str(caminho)
    elif caminho is not None and caminho.is_dir():
        env, fonte = _vars_do_dir(caminho), str(caminho)
    else:
        cofre = raizes.instancia() / "segredos" / inst.get("stack", "rag")
        if not cofre.is_dir():
            morre(f"sem ambiente do banco: nem {valor or 'env_da_ingestao'} nem {cofre}")
        # so o que o banco pede: o cofre tambem guarda chave de API e do MinIO, que o export
        # nao usa e nao tem por que herdar
        env = {k: v for k, v in _vars_do_dir(cofre).items() if k.startswith("POSTGRES_") or k == "EMBED_MODEL"}
        fonte = str(cofre)
    if "RAG_ENV_FILE" not in env and "EMBED_MODEL" not in env:
        embed = _env_do_container(inst.get("container", "")).get("EMBED_MODEL", "")
        if not embed:
            morre(f"EMBED_MODEL nem em {fonte} nem no container {inst.get('container')}")
        env["EMBED_MODEL"] = embed
    print(f"ambiente: {fonte} ({', '.join(sorted(env))})", file=sys.stderr)
    return env


def roda(titulo: str, cmd: list, cwd: Path, env: dict) -> None:
    print(f"\n== {titulo}")
    r = subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True)
    saida = (r.stdout + r.stderr).strip()
    if saida:
        print(saida[-3000:])
    if r.returncode != 0:
        morre(f"parou em: {titulo} (exit {r.returncode})", 1)


def main(argv: list) -> int:
    chave = ""
    if len(argv) == 2 and argv[0] == "--bancada" and argv[1]:
        chave = argv[1]
    elif argv:
        print(f"uso: acervo exportar [--bancada <card-slug>]\n  {SPEC}", file=sys.stderr)
        return 2
    wt = bancada_do_repo(chave)
    py = python_do_rag()
    # rag/ e conversor/: desde a #3205 o motor_acervo importa o pacote `conversor`, que mora ao
    # lado de rag/ na mesma árvore; sem ele o export morria no import (medido em 01/10, #3202)
    env = {**os.environ, **ambiente_da_ingestao(),
           "PYTHONPATH": os.pathsep.join([str(wt / "rag"), str(wt / "conversor")])}
    destino = wt / "ontologia" / "acervo"
    roda("1/2 export do schema acervo -> ontologia/acervo/*.jsonl",
         [py, "-m", "motor_acervo.cli", "exportar-acervo", "--out", str(destino)],
         wt / "rag", env)
    roda("2/2 vocabulario.json a partir do export",
         [py, str(wt / "scripts" / "gen_referencia_template.py"), "--vocabulario"],
         wt, env)
    r = subprocess.run(["git", "-C", str(wt), "status", "--short", "--",
                        "ontologia/acervo", "rag/docs/ontologia/vocabulario.json"],
                       capture_output=True, text=True)
    mudou = r.stdout.strip()
    print(f"\nbancada: {wt}")
    print("mudou:\n" + mudou if mudou else "nada mudou: o export ja acompanhava o banco")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
