#!/bin/bash
# Baixa uma obra do acervo pelo título (busca parcial, sem acento sensível).
# Uso:  acervo baixar "philosophy of software"        -> baixa para o diretório atual
#       acervo baixar "meditations" /caminho/destino  -> baixa para outro diretório
set -euo pipefail

TERMO="${1:-}"
DESTINO="${2:-.}"
[ -z "$TERMO" ] && { echo "uso: acervo baixar \"<trecho do titulo>\" [destino]"; exit 1; }

PG=rag-extractor-pg
PGUSER=$(docker inspect $PG --format '{{range .Config.Env}}{{println .}}{{end}}' | sed -n 's/^POSTGRES_USER=//p')
PGDB=$(docker inspect $PG --format '{{range .Config.Env}}{{println .}}{{end}}' | sed -n 's/^POSTGRES_DB=//p')

# Normaliza o termo no Postgres (unaccent + hífen/espaço equivalentes) para o
# filtro grosso; o casamento fino hífen<->espaço acontece no Python abaixo, que o
# SQL sozinho não faz. unaccent é pré-requisito instalado no rag-extractor-pg.
# Ordenação por id_canonico (uuid estável), NUNCA por nome de arquivo (ont:0072).
SQL="select coalesce(titulo,arquivo), arquivo, objeto, id
     from acervo.obra
     where objeto is not null
       and (translate(unaccent(lower(coalesce(titulo,''))),'-',' ')
              like translate(unaccent(lower('%$TERMO%')),'-',' ')
            or translate(unaccent(lower(arquivo)),'-',' ')
              like translate(unaccent(lower('%$TERMO%')),'-',' '))
     order by id limit 200"

CANDIDATOS=$(docker exec "$PG" psql -U "$PGUSER" -d "$PGDB" -At -F$'\t' -c "$SQL")

# Casamento fino: colapsa qualquer run de hífen/espaço para um espaço só, dos dois
# lados, e confere a contenção. Fecha "Fluent-Python" vs "Fluent Python".
RES=$(printf '%s\n' "$CANDIDATOS" | TERMO="$TERMO" python3 -c '
import sys, os, re, unicodedata

def norm(t):
    if not t:
        return ""
    nfkd = unicodedata.normalize("NFKD", str(t))
    sem = "".join(c for c in nfkd if not unicodedata.combining(c))
    return re.sub(r"[-\s]+", " ", sem.lower()).strip()

alvo = norm(os.environ.get("TERMO", ""))
if not alvo:
    sys.exit(0)

hits = []
for linha in sys.stdin:
    linha = linha.rstrip("\r\n")
    if not linha:
        continue
    campos = linha.split("\t")
    if len(campos) < 4:
        continue
    titulo, arquivo, objeto, _id = campos[0], campos[1], campos[2], campos[3]
    if alvo in norm(titulo) or alvo in norm(arquivo):
        hits.append((len(norm(titulo)), _id, titulo, arquivo, objeto))

hits.sort(key=lambda x: (x[0], x[1]))
for _, _id, titulo, arquivo, objeto in hits[:20]:
    print(titulo + "\t" + arquivo + "\t" + objeto)
')

[ -z "$RES" ] && { echo "nada encontrado para: $TERMO"; exit 1; }

N=$(echo "$RES" | wc -l)
if [ "$N" -gt 1 ]; then
  echo "$N resultados — refine o termo ou escolha:"
  echo "$RES" | nl -w2 -s') ' | cut -c1-120
  read -rp "número (enter cancela): " ESCOLHA
  [ -z "$ESCOLHA" ] && exit 0
  RES=$(echo "$RES" | sed -n "${ESCOLHA}p")
fi

ARQUIVO=$(echo "$RES" | cut -f2)
OBJETO=$(echo "$RES" | cut -f3)
BUCKET="${OBJETO%%/*}"
SHA="${OBJETO#*/}"

mkdir -p "$DESTINO"
~/AI/.venv-acervo/bin/python - "$BUCKET" "$SHA" "$DESTINO/$ARQUIVO" <<'EOF'
import sys, subprocess, boto3
bucket, sha, destino = sys.argv[1], sys.argv[2], sys.argv[3]
fmt = "{{range .Config.Env}}{{println .}}{{end}}"
env = dict(l.split("=", 1) for l in subprocess.run(
    ["docker", "inspect", "rag-extractor-minio", "--format", fmt],
    capture_output=True, text=True).stdout.splitlines() if "=" in l)
boto3.client("s3", endpoint_url="http://127.0.0.1:9000",
             aws_access_key_id=env["MINIO_ROOT_USER"],
             aws_secret_access_key=env["MINIO_ROOT_PASSWORD"]
             ).download_file(bucket, sha, destino)
print(destino)
EOF
