#!/usr/bin/env python3
"""acervo pipeline — o ato unico do pipeline do acervo (card #4120, item 26).

    acervo pipeline <pasta>                     o plano do lote, sem gravar (o do `ingerir --lote`)
    acervo pipeline <pasta> --apply             incorpora a pasta, cria o job no servidor e devolve o id
    acervo pipeline --lote <id> [--espera <s>]  cria o job sobre um lote ja aplicado, ou retoma o que ele tem
    acervo pipeline --job <id> [--espera <s>]   o estado do job e de cada etapa

Cliente fino: nao classifica nem indexa. O job roda no servidor do acervo, obra a obra, em segundo plano,
e pausa cada obra em `classificar` ate a sessao responder (`acervo catalogar biblioteca obra --job <id>`).
Por isso este ato devolve o id sem esperar o job inteiro: a chamada fica sempre abaixo dos 600 s da porta.
A incorporacao reaproveita `bin/ingerir` (carga, portoes, plano guardado e --apply), sem duplicar nada.

Saidas: 0 o job existe (criado ou retomado) · 1 lote sem obra para o job, ou incorporacao que falhou ·
2 uso errado · 3 servico fora ou incorporacao que passou do prazo · 4 recusa de politica ·
5 o que `ingerir` devolveu nao se leu (o lote pode ter sido aplicado: confira em `acervo ler biblioteca lote`).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import pipeline_cliente as pc  # noqa: E402

HARNESS_DIR = Path(__file__).resolve().parents[2]
# PF_INGERIR só existe para o teste trocar o cliente de lote por um que não sobe arquivo a lugar nenhum
INGERIR = Path(os.environ.get("PF_INGERIR") or HARNESS_DIR / "bin" / "ingerir")
# a incorporacao tem de caber na chamada da porta (600 s), com folga para criar o job e responder
PRAZO_INGERIR_S = 500

USO = """uso:
  acervo pipeline <pasta> [--apply] [--espera <s>] [--json]
  acervo pipeline --lote <id> [--espera <s>] [--json]
  acervo pipeline --job <id> [--espera <s>] [--json]
"""


def morre(msg: str, codigo: int = 2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(codigo)


def _ingerir(pasta: str, apply: bool, como_json: bool) -> subprocess.CompletedProcess:
    cmd = [sys.executable, str(INGERIR), "--lote", pasta]
    if apply:
        # até a impressão selada: o job precisa do espelho para catalogar e comparar duplicata. Indexar e pôr no ar
        # ficam depois da classificação, e não são etapas do job (ver o card #4120).
        cmd += ["--apply", "--ate", "chunk"]
    if como_json:
        cmd.append("--json")
    return subprocess.run(cmd, capture_output=True, text=True, timeout=PRAZO_INGERIR_S, check=False)


def _lote_do_json(saida: str) -> dict | None:
    """O lote que `ingerir --json` imprimiu: o primeiro objeto JSON da saida, com `id` e `itens`."""
    # `ingerir --json` imprime com indent=2: o objeto abre numa linha só com `{`. O que veio antes (o aviso do
    # conversor, por exemplo) pode ter chave no meio da linha, e não conta.
    for m in re.finditer(r"^\{[ \t]*$", saida, re.MULTILINE):
        try:
            obj, _ = json.JSONDecoder().raw_decode(saida[m.start():])
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("id"):
            return obj
    return None


def _mostrar_job(job: dict, como_json: bool) -> None:
    print(json.dumps(job, ensure_ascii=False, indent=2) if como_json else pc.resumo_do_job(job))


def _job_do_lote(pasta: str, lote_id: str, espera: int, como_json: bool) -> int:
    try:
        job = pc.criar_job(pasta, lote_id)
        if espera:
            job = pc.ver_job(job["id"], espera)
        elif "etapas" not in job:
            job = pc.ver_job(job["id"])
    except pc.Falha as e:
        morre(f"acervo pipeline: {e.mensagem}", e.codigo)
    _mostrar_job(job, como_json)
    return 0


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="acervo pipeline", add_help=False)
    p.add_argument("pasta", nargs="?")
    p.add_argument("--apply", action="store_true")
    p.add_argument("--lote")
    p.add_argument("--job")
    p.add_argument("--espera", type=int, default=0)
    p.add_argument("--json", dest="como_json", action="store_true")
    p.add_argument("-h", "--help", "--ajuda", dest="ajuda", action="store_true")
    args, desconhecidos = p.parse_known_args(argv)

    if args.ajuda:
        sys.stderr.write(USO)
        return 2
    if desconhecidos:
        morre(f"acervo pipeline: argumento que o ato nao le: {' '.join(desconhecidos)}\n{USO}", 2)
    if args.espera < 0 or args.espera > pc.TETO_ESPERA_S:
        morre(f"acervo pipeline: --espera vai de 0 a {pc.TETO_ESPERA_S} s (o teto do servidor)", 2)
    fontes = [k for k, v in (("<pasta>", args.pasta), ("--lote", args.lote), ("--job", args.job)) if v]
    if len(fontes) != 1:
        morre(f"acervo pipeline: informe uma so fonte entre <pasta>, --lote e --job (vieram: "
              f"{', '.join(fontes) or 'nenhuma'})\n{USO}", 2)
    if args.apply and not args.pasta:
        morre("acervo pipeline: --apply acompanha <pasta>; --lote e --job nao incorporam nada", 2)

    if args.job:
        try:
            job = pc.ver_job(args.job, args.espera)
        except pc.Falha as e:
            morre(f"acervo pipeline: {e.mensagem}", e.codigo)
        _mostrar_job(job, args.como_json)
        return 0

    if args.lote:
        return _job_do_lote(f"lote:{args.lote}", args.lote, args.espera, args.como_json)

    pasta = args.pasta
    if not (os.path.isdir(pasta) or os.path.isfile(pasta)):
        morre(f"acervo pipeline: pasta nao encontrada: {pasta}", 1)

    if not args.apply:
        # o plano e o do `ingerir --lote`, que guarda o plano e recusa o --apply se a pasta mudou
        r = subprocess.run([sys.executable, str(INGERIR), "--lote", pasta], check=False, timeout=PRAZO_INGERIR_S)
        sys.stderr.write("acervo pipeline: plano seco; repita com --apply para incorporar e criar o job\n")
        return r.returncode

    try:
        r = _ingerir(pasta, apply=True, como_json=True)
    except subprocess.TimeoutExpired:
        morre(f"acervo pipeline: a incorporacao passou de {PRAZO_INGERIR_S} s e foi interrompida. O lote pode estar "
              "rodando no servidor: ache o id em registro/lotes da bancada ou em `acervo listar biblioteca obra "
              "--situacao` e retome com `acervo pipeline --lote <id>`", 3)
    lote = _lote_do_json(r.stdout)
    # 0 incorporou limpo, 2 com excecoes, 3 com reprovado e 1 com obra barrada num portao do encadeamento ainda
    # criam o job das obras que entraram; o que barra o job e o lote que nao concluiu
    if lote is None:
        sys.stderr.write(r.stderr)
        morre("acervo pipeline: nao li o lote que `ingerir` devolveu; nenhum job criado. Se o lote foi aplicado, "
              "retome com `acervo pipeline --lote <id>`", 5)
    if lote.get("estado") not in (None, "concluido"):
        sys.stderr.write(r.stderr)
        morre(f"acervo pipeline: o lote {lote['id']} terminou em '{lote.get('estado')}'; nenhum job criado", 1)
    com_obra = [it for it in lote.get("itens", []) if it.get("obra_id")]
    if not com_obra:
        sys.stderr.write(r.stderr)
        morre(f"acervo pipeline: o lote {lote['id']} nao tem obra para o job (todos os itens ficaram como excecao)", 1)
    if r.stderr.strip():
        sys.stderr.write(r.stderr)
    sys.stderr.write(f"lote: {lote['id']} · {len(com_obra)} obra(s) · ingerir saiu {r.returncode}\n")
    return _job_do_lote(pasta, lote["id"], args.espera, args.como_json)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
