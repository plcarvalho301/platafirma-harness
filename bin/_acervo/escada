#!/usr/bin/env python3
# acervo escada — estado corrente do acervo por PARTIÇÃO (blob-minio | wiki), nos cinco
# degraus do fluxo.
#
# CLIENTE FINO de `GET /acervo/particao` (arq:0089: a rota é a única fonte). O que este
# script fazia até 02/09/2026 — `mc ls` nos buckets, `docker cp` do resultado para dentro
# do Postgres, SQL de 90 linhas com `\copy`, e uma segunda conexão ao motor-pg — mora agora
# em `rag/motor_acervo/particao.py`. Aqui não se abre socket para MinIO nem para Postgres:
# a medição é do serviço, e o verbo formata.
#
# uso:  acervo escada [--json] [--detalhe] [--colecao firma|pessoal]
# saída: 0 medido e invariante fechado · 2 uso inválido · 3 invariante FUROU · 4 fonte fora
# capacidade: incorporacao
# dono: claudinho-dados

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

HARNESS_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
if HARNESS_DIR not in sys.path:
    sys.path.insert(0, HARNESS_DIR)

try:
    from recuperacao.adaptadores.motor_acervo_rest import BASE as DEFAULT_BASE, TOKEN as DEFAULT_TOKEN
except ImportError:                                   # o verbo roda fora do harness instalado
    DEFAULT_BASE = "http://127.0.0.1:8100"
    DEFAULT_TOKEN = ""

BASE = (os.environ.get("RAG_API_BASE") or os.environ.get("MOTOR_ACERVO_URL") or DEFAULT_BASE).rstrip("/")
TOKEN = os.environ.get("RAG_API_TOKEN") or DEFAULT_TOKEN
TIMEOUT_S = float(os.environ.get("RAG_TIMEOUT_S", "30"))

EXIT_INVARIANTE = 3
EXIT_FONTE_FORA = 4

DEGRAUS = [
    ("a  catalogadas", "a_catalogadas"),
    ("b  armazenadas", "b_armazenadas"),
    ("c  ingeridas (chunkadas)", "c_ingeridas"),
    ("d  embedded (texto)", "d_embedded"),
    ("e  vetorizadas (metadado)", "e_vetor_meta"),
]
FUGAS = [
    ("catálogo aponta pro vazio", "catalogo_aponta_pro_vazio"),
    ("objeto sem documento", "objeto_sem_documento"),
    ("impressão sem trecho", "impressao_sem_trecho"),
    ("embedding parcial", "embedding_parcial"),
    ("sem vetor de faceta", "sem_vetor_de_faceta"),
]
COLUNAS = ["blob-minio", "wiki"]


def indeterminavel(detalhe, problema=None):
    """Fonte fora é fonte fora: não se imprime tabela de zeros para não parecer descoberta."""
    print("indeterminavel", file=sys.stderr)
    print(f"acervo escada: {detalhe}", file=sys.stderr)
    if problema:
        print(json.dumps(problema, indent=2, ensure_ascii=False), file=sys.stderr)
    sys.exit(EXIT_FONTE_FORA)


def buscar(colecao, detalhe):
    query = {}
    if colecao:
        query["colecao"] = colecao
    if detalhe:
        query["detalhe"] = "true"
    url = f"{BASE}/acervo/particao" + (f"?{urllib.parse.urlencode(query)}" if query else "")
    req = urllib.request.Request(
        url, headers={**({"authorization": f"Bearer {TOKEN}"} if TOKEN else {})})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as r:  # noqa: S310 — loopback
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        corpo = e.read()
        try:
            problema = json.loads(corpo)
        except Exception:
            problema = {"status": e.code, "detail": corpo.decode("utf-8", "replace")}
        indeterminavel(f"{BASE} respondeu {e.code}", problema)
    except Exception as e:
        indeterminavel(f"motor_acervo indisponível em {BASE}: {e}")


def _linha(rotulo, valores, nota=""):
    celulas = "".join(f"{v:>12}" for v in valores)
    print(f'  {rotulo:.<32}{celulas}   {nota}'.rstrip())


def imprimir(d, colecao):
    p = d["particoes"]
    recorte = f" · coleção {colecao}" if colecao else ""
    print(f'ACERVO por partição — medido em {d["medido_em"][:19]}{recorte}')
    print(f'fonte: GET {BASE}/acervo/particao (o verbo não lê MinIO nem Postgres)')
    print()
    print(" " * 34 + "".join(f"{c:>12}" for c in COLUNAS))
    _linha("obras", [p[c]["obras"] for c in COLUNAS])
    print()
    for rotulo, chave in DEGRAUS:
        nota = {"b_armazenadas": "presença real no store",
                "e_vetor_meta": "ponto de faceta por obra"}.get(chave, "")
        _linha(rotulo, [p[c]["degraus"][chave] for c in COLUNAS], nota)
    print()
    _linha("servindo", [p[c].get("servindo", 0) for c in COLUNAS])
    _linha("bloqueadas por OCR", [p[c].get("bloqueadas_ocr", 0) for c in COLUNAS])
    print()
    print("FUGA POR DEGRAU (0 em tudo = escada sem vazamento)")
    for rotulo, chave in FUGAS:
        valores = [p[c]["fuga"].get(chave, 0) for c in COLUNAS]
        marca = "!" if any(valores) else " "
        celulas = "".join(f"{v:>12}" for v in valores)
        print(f'  {marca} {rotulo:.<30}{celulas}')
    print()
    fora = d.get("fora_da_particao", {})
    print(f'  fora da partição: {fora.get("objeto_no_store_sem_obra", 0)} objeto(s) no store sem obra')
    print(f'  expurgadas (reversível, fora da medição): {d.get("expurgadas", 0)}')
    print()

    inv = d["invariante"]
    if inv["ok"]:
        print("  invariante: OK — toda obra viva está armazenada em uma das duas partições")
        return
    print(f'  invariante: FUROU — {inv["terceiro_caso"]} obra(s) sem objeto, '
          "fora de qualquer partição")
    for oid in inv["ids"][:20]:
        print(f"    {oid}")
    if len(inv["ids"]) > 20:
        print(f'    … e mais {len(inv["ids"]) - 20}')


def imprimir_detalhe(d):
    print()
    print("=== quem está fora do lugar ===")
    for particao, bloco in d["particoes"].items():
        for chave, ids in (bloco.get("fuga_ids") or {}).items():
            print(f"-- {particao} · {chave} ({len(ids)})")
            for oid in ids:
                print(f"   {oid}")
    orfaos = (d.get("fora_da_particao") or {}).get("objeto_no_store_sem_obra_ids") or []
    if orfaos:
        print(f"-- objeto no store sem obra ({len(orfaos)})")
        for objeto in orfaos:
            print(f"   {objeto}")


def main():
    ap = argparse.ArgumentParser(prog="acervo escada", add_help=True,
                                 description="escada do acervo por partição (blob-minio | wiki)")
    ap.add_argument("--json", action="store_true", help="repassa o corpo da rota, cru")
    ap.add_argument("--detalhe", action="store_true", help="lista os ids ofensores")
    ap.add_argument("--colecao", choices=["firma", "pessoal"], help="recorta por coleção")
    args = ap.parse_args()

    d = buscar(args.colecao, args.detalhe)
    if args.json:
        print(json.dumps(d, indent=2, ensure_ascii=False))
    else:
        imprimir(d, args.colecao)
        if args.detalhe:
            imprimir_detalhe(d)

    # O dado é conhecido e a rota responde 200: quem falha ruidosamente é o consumidor.
    sys.exit(EXIT_INVARIANTE if not d["invariante"]["ok"] else 0)


if __name__ == "__main__":
    main()
