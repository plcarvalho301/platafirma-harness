#!/usr/bin/env python3
# acervo listar casa ferramental --retrato — o retrato do dicionario de rotulos dos atos.
# capacidade: conhecimento
# dono: claudinho-dados
#   (mecanismo/harness: claudinho-TI · construcao)
#
# Le o registro mestre do ferramental (acervo.ferramental_ato) e emite o RETRATO: um JSON com o
# rotulo, a volta e o atalho de cada ato e o sha do registro de que saiu (arq:0124 §3, arq:0031).
# A Taipa nao le o registro nem na execucao nem no build (arq:0125, U33): consome este arquivo,
# gerado por esta chamada e commitado em platafirma-ui. O retrato nao se edita a mao; rotulo errado
# se cura no cabecalho do verbo (`# rotulo:`, `# volta:`, `# atalho:`) e se escreve de novo por
# `acervo escrever casa ferramental <verbo>`.
#
# O objeto do rotulo entra no cabecalho como {slug} do conceito no tesauro e sai aqui resolvido
# pelo rotulo preferido do conceito (arq:0125, Fechado depois do aceite, 4). Conceito que sumiu do
# tesauro depois do registro derruba a emissao (exit 3): retrato com buraco nao se gera.
#
# Forma (esquema retrato-ferramental/1), sempre JSON em stdout:
#   {"esquema": "retrato-ferramental/1",
#    "sha": "<sha256 do corpo `atos`, JSON canonico>",
#    "atos": {"<verbo> <ato>": {"rotulo": "...", "objeto": ["<slug do conceito>"],
#                              "volta": {"desfaz": true, "como": "..."}, "atalho": "x"}},
#    "avisos": ["..."]}
# Ato que nao declara os campos sai so com os que declara, sem texto inventado; entrada vazia `{}`.
# `objeto` so existe quando o rotulo tem {slug}. A face do ato nao entra: o registro ainda nao a
# guarda (nenhum cabecalho a declara); entra como chave nova, sem mudar o esquema.
#
# Read-only. Exit: 0 emitiu · 2 uso · 3 banco fora do ar ou conceito do rotulo sem rotulo no tesauro.
import hashlib
import json
import os
import re
import signal
import subprocess
import sys

PG = "rag-extractor-pg"
DB = "rag_extractor"
USR = "rag"
ESQUEMA = "retrato-ferramental/1"

RE_OBJETO = re.compile(r"\{([a-z0-9]+(?:-[a-z0-9]+)*)\}")

USO = """uso:
  acervo listar casa ferramental --retrato [--json]
      o retrato do dicionario de rotulos: rotulo, volta e atalho de cada ato, e o sha do registro
      de que saiu. Sempre JSON em stdout (--json e aceito por simetria com os outros listar).
Read-only."""

SQL_ATOS = (
    "select coalesce(json_agg(row_to_json(t) order by t.verbo, t.ato), '[]') from ("
    "select verbo, ato, rotulo, volta, atalho from acervo.ferramental_ato) t;")


def morre(msg, code=2):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def _lit(v):
    return "'" + str(v).replace("'", "''") + "'"


def _psql(sql):
    env = dict(os.environ)
    env.setdefault("DOCKER_HOST", "unix:///run/user/1001/docker.sock")
    try:
        return subprocess.run(
            ["docker", "exec", "-i", PG, "psql", "-U", USR, "-d", DB, "-tA", "-c", sql],
            capture_output=True, text=True, check=True, env=env).stdout
    except FileNotFoundError:
        morre("acervo listar casa ferramental --retrato: 'docker' nao encontrado no PATH.", 3)
    except subprocess.CalledProcessError as e:
        morre("acervo listar casa ferramental --retrato: psql falhou (rc=%s):\n%s"
              % (e.returncode, (e.stderr or "").strip()), 3)


def le_atos():
    """As linhas de ferramental_ato: [{verbo, ato, rotulo, volta, atalho}], pela ordem do banco."""
    return json.loads(_psql(SQL_ATOS).strip() or "[]")


def le_conceitos(slugs):
    """{slug: rotulo preferido} dos conceitos pedidos que existem no tesauro."""
    if not slugs:
        return {}
    sql = ("select coalesce(json_agg(row_to_json(t)), '[]') from ("
           "select slug, rotulo from acervo.conceito where slug in (%s)) t;"
           % ", ".join(_lit(s) for s in sorted(slugs)))
    return {r["slug"]: r["rotulo"] for r in json.loads(_psql(sql).strip() or "[]")}


def objetos_do_rotulo(linhas):
    return {s for l in linhas if l.get("rotulo") for s in RE_OBJETO.findall(l["rotulo"])}


def resolve(texto, conceitos):
    """`Apagar {obra}` -> `Apagar obra`. KeyError(slug) quando o conceito nao tem rotulo.
    O tesauro escreve o rotulo em forma de titulo (`Documento de arquivo`); no meio da frase a
    inicial desce, salvo quando o resto do rotulo ja tem maiuscula (sigla, nome proprio)."""
    def troca(m):
        slug = m.group(1)
        if slug not in conceitos:
            raise KeyError(slug)
        rot = conceitos[slug]
        if m.start() > 0 and rot[:1].isupper() and not any(c.isupper() for c in rot[1:]):
            rot = rot[0].lower() + rot[1:]
        return rot
    return RE_OBJETO.sub(troca, texto)


def _volta(valor):
    if valor == "nao":
        return {"desfaz": False}
    return {"desfaz": True, "como": re.sub(r"^sim\s+[—-]\s+", "", valor)}


def monta_atos(linhas, conceitos):
    """{"verbo ato": {rotulo?, volta?, atalho?}}: so o que o ato declara, o rotulo ja resolvido."""
    atos, sem_conceito = {}, set()
    for l in linhas:
        entrada = {}
        if l.get("rotulo"):
            try:
                entrada["rotulo"] = resolve(l["rotulo"], conceitos)
            except KeyError as e:
                sem_conceito.add(e.args[0])
            # o conceito do objeto, pelo slug, para a tela ligar o rotulo ao tesauro (carta do
            # arquiteto 20261011T223655): so quando o rotulo tem objeto.
            objeto = RE_OBJETO.findall(l["rotulo"])
            if objeto:
                entrada["objeto"] = objeto
        if l.get("volta"):
            entrada["volta"] = _volta(l["volta"])
        if l.get("atalho"):
            entrada["atalho"] = l["atalho"]
        atos["%s %s" % (l["verbo"], l["ato"])] = entrada
    if sem_conceito:
        morre("acervo listar casa ferramental --retrato: o rotulo cita conceito sem rotulo no "
              "tesauro: %s (retrato com buraco nao se gera; o conceito volta ao tesauro ou o "
              "rotulo se cura no cabecalho e se escreve de novo)." % ", ".join(sorted(sem_conceito)), 3)
    return atos


def sha_do_corpo(atos):
    canonico = json.dumps(atos, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
    return hashlib.sha256(canonico.encode("utf-8")).hexdigest()


def avisos_de(atos):
    por_tecla = {}
    for chave, e in atos.items():
        if e.get("atalho"):
            por_tecla.setdefault(e["atalho"], []).append(chave)
    return ["atalho %s repetido em %s (unico em toda face)" % (t, ", ".join(sorted(ks)))
            for t, ks in sorted(por_tecla.items()) if len(ks) > 1]


def retrato(linhas, conceitos):
    atos = monta_atos(linhas, conceitos)
    return {"esquema": ESQUEMA, "sha": sha_do_corpo(atos), "atos": atos, "avisos": avisos_de(atos)}


def main(argv):
    if any(a in ("-h", "--help", "ajuda") for a in argv):
        print(USO)
        return 0
    if "--retrato" not in argv:
        morre(USO)
    for a in argv:
        if a not in ("--retrato", "--json"):
            morre("acervo listar casa ferramental --retrato: opcao desconhecida %r\n\n%s" % (a, USO))
    linhas = le_atos()
    r = retrato(linhas, le_conceitos(objetos_do_rotulo(linhas)))
    print(json.dumps(r, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    # Sai limpo no `| head`. So na execucao direta: no import o processo do chamador nao muda (#3274).
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    sys.exit(main(sys.argv[1:]))
