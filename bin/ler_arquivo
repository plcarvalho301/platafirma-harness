#!/usr/bin/env python3
# ler_arquivo — lê arquivo da casa ou da instância para o agente, pela porta
# capacidade: busca
# dono: ti
# ruff: noqa: ERA001
"""Ponto de entrada executável do harness para `ler_arquivo` por processo.

Fase de expansão da story #4442 (t10): continua atendendo normalmente, mas emite
em `stderr` o aviso de sucessor apontando o ato `ler` pela chave lógica.
"""
from __future__ import annotations

import sys
from pathlib import Path

_LIB = Path(__file__).resolve().parents[1] / "lib"
if str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))

from leitura.__main__ import main as _main_leitura

AVISO_SUCESSOR = (
    "aviso: ler_arquivo será retirado na contração da story #4442; "
    "use o ato ler do verbo dono pela chave lógica (ex.: busca ler <classe>:<slug>)\n"
)


def main() -> int:
    sys.stderr.write(AVISO_SUCESSOR)
    sys.stderr.flush()
    return _main_leitura()


if __name__ == "__main__":
    raise SystemExit(main())
