#!/usr/bin/env python3
# jaiminho — fala com o colaborador externo Jaiminho, no container proprio dele.
# capacidade: mensagem
# dono: claudinho-TI
# componente: jaiminho (Antigravity CLI + ponte MCP)
"""jaiminho — interlocucao com o colaborador externo (card 344, seg:0009).

O Jaiminho e um modelo do Google que roda DENTRO do container `jaiminho`:
Antigravity CLI (`agy`) autenticado pela assinatura do dono — sem API paga — e
uma ponte MCP local que injeta o token do realm do client L0R8OJ. Este verbo e
so a mao que alcanca aquele container; nenhuma decisao de acesso mora aqui.

O que o Jaiminho alcanca da plataforma nao se decide neste arquivo e sim no PEP
do ops-server, que responde a cada chamada MCP dele. Aumentar o alcance dele e
ato de concessao no PAP, nunca flag deste verbo.

Atos:
  perguntar "<texto>"   uma pergunta, sessao NOVA — abre com a persona dele
                        (corpo tambem por stdin)
  continuar "<texto>"   retoma a ultima conversa dele, sem reinjetar a persona
  estado                conta autenticada, modelo, ponte e sessao na plataforma
  login                 reabre o fluxo OAuth e imprime a URL para o dono
  logs [n]              ultimas linhas do container

Sem argumento, imprime isto.
"""
import json
import os
import re
import shlex
import subprocess
import sys

# Tres constantes viraram env com o default de sempre (18/08/2026, org:0020): a
# segunda conta da fabrica roda o MESMO motor `agy` no MESMO desenho de container, e
# duplicar 230 linhas para trocar tres strings criaria uma copia envelhecendo em
# silencio. Quem seta e o shim `bin/jaiminho-fabrica`; chamada sem env nenhum
# continua sendo o Jaiminho, byte por byte.
CONTAINER = os.environ.get("PF_JAIMINHO_CONTAINER", "jaiminho")
RAIZ = os.environ.get("PF_RAIZ", os.path.expanduser("~/AI"))
PERSONA = os.environ.get("PF_JAIMINHO_PERSONA") or os.path.join(
    RAIZ, "platafirma-harness", "personas", "persona-jaiminho.md")
# O home dentro do container e /home/jaiminho nas duas contas porque a IMAGEM e a
# mesma (uid 10001). O que separa as contas nao e o caminho: e o volume, o client
# do realm e o papel no PAP.
TRABALHO = os.environ.get("PF_JAIMINHO_TRABALHO", "/home/jaiminho/trabalho")

# --- de qual DAEMON este verbo fala -------------------------------------------------
# Em 20/08/2026 (#2286) os dois bracos do `agy` sairam do daemon do `claudinho` e
# passaram ao daemon rootless da conta `jaiminho` (uid 1003). O verbo continuou
# perguntando ao daemon errado — e, pior, MENTINDO: `estado` respondia "container fora
# do ar — `deploy jaiminho up -d`", que e literalmente o ato que sobe um SEGUNDO braco
# contra os volumes velhos (handoff 20260820T195257, item 2). Verbo que erra o alvo e
# defeito; verbo que sugere o estrago e armadilha.
#
# `PF_JAIMINHO_DOCKER_HOST` aponta o daemon. O DEFAULT e o socket do uid 1003 porque os
# DOIS bracos migraram — nao sobrou braco no daemon do `claudinho`. Manter o default
# vazio faria o verbo perguntar ao daemon errado por omissao, que e o defeito corrigido
# aqui. Vazio explicito ainda vale: `PF_JAIMINHO_DOCKER_HOST= jaiminho estado` mede a
# conta corrente, que e o que se quer ao conferir se sobrou container orfao daqui.
DOCKER_HOST_ALVO = os.environ.get("PF_JAIMINHO_DOCKER_HOST",
                                  "unix:///run/user/1003/docker.sock")
# Onde o braco foi parar, para a frase de recusa dizer o que fazer em vez de mandar
# subir. Nao e caminho de execucao: e endereco para humano.
DAEMON_DONO = os.environ.get("PF_JAIMINHO_DAEMON_DONO", "jaiminho (uid 1003)")


def _ambiente():
    """Ambiente do subprocesso, com DOCKER_HOST quando ha daemon declarado."""
    env = dict(os.environ)
    if DOCKER_HOST_ALVO:
        env["DOCKER_HOST"] = DOCKER_HOST_ALVO
    return env


def _alcanca_daemon():
    """O daemon alvo responde a esta conta? Distingue 'nao alcanco' de 'nao existe'."""
    r = subprocess.run(["docker", "version", "--format", "{{.Server.Version}}"],
                       capture_output=True, text=True, env=_ambiente())
    return r.returncode == 0
# Dentro do container ele e root do proprio mundo: sem shell no host, sem rede da
# malha, sem credencial de cadeira. Por isso a aprovacao interativa de ferramenta
# nao acrescenta seguranca aqui — ela custaria um TTY que este verbo nao tem.
# --print-timeout: o default do agy e 5m0s e ele conta a REDACAO, nao so a busca.
# Medido em 16/08: tres giros do mesmo pedido de 5340 chars morreram em 305 s com
# os 17 passos ja fechados — o teto pegou na hora de escrever. 9m cabe dentro do
# sh(timeout=600) com folga para o proprio agy imprimir o erro antes do SIGKILL.
BASE = "cd {t}; agy --dangerously-skip-permissions --print-timeout 9m".format(t=TRABALHO)

# A frase exata que o agy cospe no estouro do print mode. E o gatilho do resgate.
ESTOUROU = "timeout waiting for response"
RESGATE = (
    "Seu giro anterior estourou o teto de tempo antes de terminar de escrever."
    " Entregue AGORA o que voce ja apurou ate aqui, direto: sem reiniciar o"
    " trabalho, sem introducao, sem pedir confirmacao."
)


def sh(cmd, timeout=600, entrada=None):
    return subprocess.run(["docker", "exec", "-i", CONTAINER, "bash", "-lc", cmd],
                          capture_output=True, text=True, timeout=timeout, input=entrada,
                          env=_ambiente())


def vivo():
    r = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", CONTAINER],
                       capture_output=True, text=True, env=_ambiente())
    return r.returncode == 0 and r.stdout.strip() == "true"


def exige_container():
    if vivo():
        return
    # NUNCA sugerir `up -d` sem antes saber se o alvo apenas nao esta ao alcance:
    # subir aqui um container que vive em outro daemon cria o segundo braco.
    if not _alcanca_daemon():
        sys.exit(
            f"{CONTAINER}: fora do alcance desta conta — o daemon alvo nao responde.\n"
            f"  O braco roda no daemon rootless da conta {DAEMON_DONO} desde o card #2286,\n"
            f"  e `claudinho` nao tem sudo para alcanca-lo.\n"
            f"  NAO rode `deploy jaiminho up -d`: isso sobe um SEGUNDO braco neste daemon,\n"
            f"  contra os volumes velhos, com a mesma credencial.\n"
            f"  Para operar, use a conta dona do daemon, ou declare o alcance:\n"
            f"    sudo -u jaiminho XDG_RUNTIME_DIR=/run/user/1003 \\\n"
            f"      DOCKER_HOST=unix:///run/user/1003/docker.sock docker ps")
    sys.exit(f"{CONTAINER}: daemon alcancado, container fora do ar.\n"
             f"  Suba pela conta dona do deploy ({DAEMON_DONO}), em /srv/pf/agy/{CONTAINER}.\n"
             f"  A stack `platafirma-harness/jaiminho` NAO sobe mais este braco: o servico\n"
             f"  saiu do compose de proposito (#2286), e um `up -d` la nao o traz de volta.")


def abertura():
    """A persona do Jaiminho, para prefixar a conversa NOVA.

    Medido em 15/08/2026 contra o `agy` do container: ele nao le AGENTS.md nem
    GEMINI.md do cwd, `agy agents` volta vazio e nao ha agent configuravel por
    arquivo. Sem esta injecao o Jaiminho responde como Gemini generico — perguntado
    sobre o proprio papel, disse ser \"assistente para desenvolvimento de software\",
    que nao e nada do que a persona dele contrata.

    Vai na ABERTURA, nunca no `continuar`: e a mesma economia que o verbo `chat`
    faz com o pacote de cadeira (injeta na fita nova, nao reinjeta no resume). Uma
    vez por conversa, e nao uma vez por giro.

    Persona ausente NAO derruba a chamada: o giro segue sem ela e a linha de aviso
    sai no stderr. Melhor resposta generica declarada que sala muda.
    """
    try:
        with open(PERSONA, encoding="utf-8") as f:
            texto = f.read().strip()
    except OSError as e:
        print(f"jaiminho: aviso — persona nao lida ({e}); a conversa abre generica",
              file=sys.stderr)
        return ""
    return texto


def texto_do_argumento(args):
    junto = " ".join(args).strip()
    if junto:
        return junto
    if not sys.stdin.isatty():
        return sys.stdin.read().strip()
    return ""


def falar(args, continuar=False):
    exige_container()
    pergunta = texto_do_argumento(args)
    if not pergunta:
        sys.exit("jaiminho: sem pergunta — passe o texto como argumento ou por stdin")
    flag = " -c" if continuar else ""
    if not continuar:
        persona = abertura()
        if persona:
            pergunta = (
                persona
                + "\n\n---\nO texto acima e quem voce e; o que vem depois desta linha e a"
                  " mensagem a responder.\n\n"
                + pergunta
            )
    r = sh(f"{BASE}{flag} -p {shlex.quote(pergunta)}")
    saida = (r.stdout or "").strip()
    erro = (r.stderr or "").strip()
    if saida:
        print(saida)
    if r.returncode == 0:
        return

    if "Authentication required" in erro + saida:
        sys.exit("jaiminho: sessao do Google expirou — rode `jaiminho login`")

    if ESTOUROU in erro:
        # O estouro do print mode NAO apaga a sessao: o trabalho fica do lado de la
        # e sai por `-c`. Medido em 16/08 — giro morto em 305 s devolveu os 16 itens
        # ja apurados em 21 s de retomada. Reportar "falhou" sem tentar isso mente
        # sobre o que existe, e foi assim que o dono perdeu uma pesquisa inteira.
        r2 = sh(f"{BASE} -c -p {shlex.quote(RESGATE)}")
        resgatada = (r2.stdout or "").strip()
        if r2.returncode == 0 and resgatada:
            print(resgatada)
            print("jaiminho: o giro estourou o teto; o texto acima veio da retomada"
                  " automatica, e pode nao ser a entrega inteira.", file=sys.stderr)
            return
        sys.exit("jaiminho: o giro estourou o teto de tempo e a retomada automatica"
                 " tambem nao veio — o trabalho segue na sessao dele. Mande"
                 " `continuar` pedindo a entrega do que ja apurou.")

    sys.exit(f"jaiminho: agy saiu {r.returncode}\n{erro[:600]}")


def estado():
    exige_container()
    ponte = sh("curl -s --max-time 20 127.0.0.1:8022/estado", timeout=60).stdout.strip()
    try:
        ponte = json.loads(ponte)
    except ValueError:
        ponte = {"erro": ponte[:200] or "ponte nao respondeu"}
    conta = sh("agy -p 'responda apenas: pronto' 2>&1 | tail -3", timeout=180).stdout.strip()
    autenticado = "Authentication required" not in conta
    print(json.dumps({
        "container": "no ar",
        "autenticado_no_google": autenticado,
        "ponte_mcp": ponte,
        "resposta_de_prova": conta[:200] if autenticado else None,
    }, ensure_ascii=False, indent=2))


def login():
    """Conduz o OAuth por tmux dentro do container: sem TTY o `agy` recusa
    autenticar, e o prompt do codigo expira em 60 s se ninguem o segurar."""
    exige_container()
    sh("tmux kill-session -t login 2>/dev/null; "
       f"tmux new-session -d -s login -x 200 -y 50 'cd {TRABALHO}; agy'", timeout=60)
    sh("sleep 10; tmux send-keys -t login Enter", timeout=60)
    tela = sh("sleep 8; tmux capture-pane -p -J -t login", timeout=60).stdout
    url = re.search(r"https://accounts\.google\.com/o/oauth2/auth\?\S*?state=[A-Za-z0-9_-]+",
                    tela.replace("\n", "").replace(" ", ""))
    if not url:
        sys.exit("jaiminho: nao achei a URL de autorizacao. Tela:\n" + tela[-800:])
    print("Abra no navegador, autorize, e devolva o codigo com:\n"
          "  jaiminho login-codigo <codigo>\n")
    print(url.group(0))


def login_codigo(args):
    exige_container()
    codigo = texto_do_argumento(args)
    if not codigo:
        sys.exit("jaiminho: passe o codigo devolvido pela pagina de autorizacao")
    sh(f"tmux send-keys -t login {shlex.quote(codigo)}; sleep 1; tmux send-keys -t login Enter",
       timeout=60)
    # Primeiro acesso ainda passa por tema, termos e confianca na pasta. ENTER NAO
    # ATRAVESSA A TELA DE TERMOS: la ele e `Toggle` do consentimento de dados, e o
    # laco de Enter so ligava e desligava o checkbox para sempre. Medido em
    # 18/08/2026, no primeiro login da conta jaiminho-fabrica. O caminho e navegar
    # ate [Done] — Down sai do checkbox, Right vai do [Previous] ao [Done] — e so
    # entao confirmar. O checkbox fica DESMARCADO: telemetria de interacao nao se
    # concede por default.
    sh("for i in 1 2 3; do tmux send-keys -t login Enter; sleep 4; done", timeout=120)
    tela = sh("tmux capture-pane -p -t login", timeout=60).stdout
    if "Done" in tela and "Toggle" in tela:
        sh("tmux send-keys -t login Down; sleep 2; tmux send-keys -t login Right; "
           "sleep 2; tmux send-keys -t login Enter; sleep 6", timeout=90)
    # Confianca na pasta e as telas seguintes: ai sim Enter confirma o default.
    sh("for i in 1 2 3; do tmux send-keys -t login Enter; sleep 4; done", timeout=120)
    tela = sh("tmux capture-pane -p -t login", timeout=60).stdout
    print("\n".join(l for l in tela.splitlines() if l.strip())[:900])


def logs(args):
    n = args[0] if args else "40"
    r = subprocess.run(["docker", "logs", "--tail", str(n), CONTAINER],
                       capture_output=True, text=True, env=_ambiente())
    print((r.stdout or "") + (r.stderr or ""))


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        return
    ato, args = sys.argv[1], sys.argv[2:]
    if ato == "perguntar":
        falar(args)
    elif ato == "continuar":
        falar(args, continuar=True)
    elif ato == "estado":
        estado()
    elif ato == "login":
        login()
    elif ato == "login-codigo":
        login_codigo(args)
    elif ato == "logs":
        logs(args)
    else:
        sys.exit(f"jaiminho: ato desconhecido {ato!r}\n\n{__doc__.strip()}")


if __name__ == "__main__":
    main()
