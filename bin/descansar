#!/opt/platafirma/current/venv/harness/bin/python
# descansar — encerra a sessão numa chamada e numa linha, e dispara as coletas em segundo plano
# capacidade: memoria
# dono: gestao-estrategica
# classe: B
# forma: linha (encerrar) / objeto (publicar)
# use para: encerrar a sessão quando o trabalho acabou; publicar uma mensagem (afirmação, negativa, pedido, recusa, contestação, decisão)
# atos: encerrar (escrita, sessao), publicar (escrita, mensagem)
# escreve: o oplog (sessao_encerrada e um evento por coleta); a mensagem no banco de eventos, esfera de negócio, família mensagem (rota aberta pela S4355; até lá, só o arquivo de ensaio); apaga a chave sessao:<id> do Valkey msg-mem
# ambiente: PF_SESSAO, PF_CADEIRA e PF_SUJEITO (origem: a porta); OPS_LOG_DIR (oplog); PF_MENSAGEM_ARQUIVO (destino de ensaio da mensagem); CASA_PG_* (fichário, para conferir etiqueta e destinatário); PF_VALKEY_FIXTURE, PF_FICHARIO_FIXTURE e PF_DESCANSO_PIDFILE (só teste); PF_BIN[=bin/ da própria release]
# depende: lib/descanso, lib/oplog, lib/postura/lousa, lib/postura/casa
# saídas: 0 ok · 2 uso, sem sessão ou mensagem recusada · 3 sem destino para a mensagem ou fichário fora
"""O descanso da casa nova (S4335, regras 28 a 31 da F4269).

`descansar [encerrar]` encerra a sessão (apaga a chave dela na memória de trabalho), dispara num processo filho
destacado as três coletas (lib/descanso/coletas.py) e devolve só a despedida. Não relata mesa, caderno nem o que
ficou aberto: isso já está na lousa. A entrada padrão, quando vem, é a lista de observações da cadeira na fita.

`descansar publicar` grava uma mensagem (JSON na entrada padrão, na forma de referencias/classes/mensagem.md);
recusa com exit 2 a que vem sem enunciado, sem quem, sem destinatário ou sem tipo, a de tipo fora do dicionário, a
de etiqueta ou destinatário que não é chave de ficha e a de relação fora de atualiza, corrige e retrata.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

_REPO_REAL = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO_REAL / "lib"))

from descanso import coletas, eventos  # noqa: E402
from descanso.memoria import Fora, memoria_do_ambiente  # noqa: E402
from descanso.publicar import Recusada, SemDestino, publicar  # noqa: E402

DESPEDIDA = "sessão encerrada; até a próxima."


def _sai(msg: str, codigo: int, como_json: bool) -> int:
    if como_json:
        print(json.dumps({"erro": msg, "exit_code": codigo}, ensure_ascii=False))
    else:
        print(msg, file=sys.stderr)
    return codigo


def _entrada() -> str:
    return "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read().strip()


def ato_encerrar(como_json: bool) -> int:
    sessao_id = (os.environ.get("PF_SESSAO") or "").strip()
    cadeira = (os.environ.get("PF_CADEIRA") or "").strip()
    if not sessao_id or sessao_id == "-":
        return _sai("sem sessão aberta para encerrar: a porta não injetou PF_SESSAO", 2, como_json)
    bruto = _entrada()
    try:
        observacoes = json.loads(bruto) if bruto else []
    except ValueError:
        observacoes = [bruto]
    if isinstance(observacoes, dict):
        observacoes = [observacoes]

    try:
        memoria_do_ambiente().apagar(sessao_id)
    except Fora:
        pass        # a chave vence sozinha em 48 h; o evento sessao_encerrada é que diz que a sessão acabou

    ctx = {"sessao_id": sessao_id, "cadeira": cadeira or None, "sujeito": eventos.sujeito_do_ambiente(cadeira),
           "observacoes": observacoes}
    fd, caminho = tempfile.mkstemp(prefix="descanso-", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(ctx, f, ensure_ascii=False)
    filho = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_coletar", caminho],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True, close_fds=True)
    pidfile = (os.environ.get("PF_DESCANSO_PIDFILE") or "").strip()
    if pidfile:
        Path(pidfile).write_text(str(filho.pid), encoding="utf-8")

    print(json.dumps({"despedida": DESPEDIDA}, ensure_ascii=False) if como_json else DESPEDIDA)
    return 0


def ato_coletar(caminho: str) -> int:
    try:
        ctx = coletas.ler_contexto(caminho)
    finally:
        try:
            os.unlink(caminho)
        except OSError:
            pass
    coletas.rodar(ctx)
    return 0


def ato_publicar(como_json: bool) -> int:
    bruto = _entrada()
    try:
        dado = json.loads(bruto) if bruto else None
    except ValueError as erro:
        return _sai(f"a mensagem não é JSON: {erro}", 2, como_json)
    sessao = (os.environ.get("PF_SESSAO") or "").strip() or None
    cadeira = (os.environ.get("PF_CADEIRA") or "").strip() or None
    try:
        msg, gravou = publicar(dado, sessao=sessao, cadeira=cadeira)
    except Recusada as erro:
        return _sai(f"recusada: {erro}", 2, como_json)
    except SemDestino as erro:
        return _sai(str(erro), 3, como_json)
    saida = {"chave": msg.chave(), "gravada": gravou, "tipo-de-mensagem": msg.tipo,
             "destinatario": msg.destinatario, "etiqueta": msg.etiqueta, "correlacao": msg.correlacao}
    if como_json:
        print(json.dumps(saida, ensure_ascii=False))
    else:
        print(("gravada " if gravou else "já estava ") + msg.chave()[:12])
    return 0


USO = "uso: descansar [encerrar] [--json] · descansar publicar [--json]  (mensagem JSON na entrada padrão)"


def main(argv: list[str]) -> int:
    como_json = "--json" in argv
    args = [a for a in argv if a != "--json"]
    if args and args[0] in ("-h", "--help", "--ajuda"):
        print(USO)
        return 0
    if not args or args[0] == "encerrar":
        return ato_encerrar(como_json) if len(args) <= 1 else _sai(USO, 2, como_json)
    if args[0] == "publicar" and len(args) == 1:
        return ato_publicar(como_json)
    if args[0] == "_coletar" and len(args) == 2:
        return ato_coletar(args[1])
    return _sai(f"ato desconhecido: {args[0]!r}\n{USO}", 2, como_json)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
