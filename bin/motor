def servido(inst):
    """env efetivo do container; ausente = default do codigo."""
    c = inst.get("container")
    if not c:
        return {}, "instancia sem container"
    r = sh(f"docker inspect {c} --format '{{{{range .Config.Env}}}}{{{{println .}}}}{{{{end}}}}'")
    if r.returncode != 0:
        return None, f"container {c} fora do ar"
    return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l), None


def cmd_listar(d):
    for nome, i in d.items():
        print(f"{nome:12} {i['estado']:10} {i.get('container') or '-'}")


def caminho_env(inst):
    """Env da ingestao, sempre na instancia (desenho §3): o registro declara um arquivo
    NOME=valor (canonico /srv/platafirma/casa/...) ou uma stack, e ai e o diretorio
    segredos/<stack> com um arquivo por variavel. Nunca .env em arvore de repo."""
    valor = inst.get("env_da_ingestao") or ""
    if _seguro(valor, 1):
        return str(raizes.instancia() / "segredos" / valor)
    return na_instancia(valor) if valor.startswith(_CANON_INSTANCIA) else ""


def _grava_atomico(alvo, texto):
    tmp = alvo + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(texto)
    os.replace(tmp, alvo)


def le_env_da_ingestao(inst):
    """Ajuste da metade OFFLINE. A ingestao nao roda em container: roda no host, com o venv do
    rag, e recebe este env como ambiente (o corte de linha de comando). Ler o compose para dizer o valor de
    corte diria o que o servico de BUSCA carrega — e a busca nao corta nada."""
    caminho = caminho_env(inst)
    out = {}
    if caminho and os.path.isdir(caminho):
        for nome in sorted(os.listdir(caminho)):
            arq = os.path.join(caminho, nome)
            if os.path.isfile(arq) and not nome.endswith(".tmp"):
                with open(arq) as f:
                    out[nome] = f.read().strip()
    elif caminho and os.path.isfile(caminho):
        with open(caminho) as f:
            for linha in f:
                linha = linha.strip()
                if linha and not linha.startswith("#") and "=" in linha:
                    k, v = linha.split("=", 1)
                    out[k.strip()] = v.strip()
    return out


def escreve_no_env(inst, b, v, novo):
    """Grava a variavel no env da ingestao da instancia. Sem commit e sem promover, de
    proposito: o env carrega segredo e nao e versionado, e nao ha servico a reiniciar —
    o valor passa a valer na proxima ingestao, e so no que ela cortar."""
    caminho = caminho_env(inst)
    if not caminho or not os.path.exists(caminho):
        print(f"nao achei o env da ingestao ({caminho or 'env_da_ingestao do registro fora da instancia'})",
              file=sys.stderr)
        sys.exit(1)
    if os.path.isdir(caminho):
        _grava_atomico(os.path.join(caminho, b["var"]), novo + "\n")
    else:
        with open(caminho) as f:
            texto = f.read()
        pad = re.compile(rf"^{re.escape(b['var'])}=.*$", re.M)
        if pad.search(texto):
            texto = pad.sub(lambda m: f"{b['var']}={novo}", texto, count=1)
        else:
            texto = texto.rstrip("\n") + f"\n{b['var']}={novo}\n"
        _grava_atomico(caminho, texto)
    lido = le_env_da_ingestao(inst).get(b["var"])
    if lido != novo:
        print(f"NAO CONFERE: pedi {novo}, o arquivo le {lido}", file=sys.stderr)
        sys.exit(1)
    print(f"{b['slug']}: {v} -> {novo}  ({b['var']} em {caminho})")
    print("CONFERIDO no arquivo. Nada foi promovido: isto e ajuste de CORTE, e corte so muda")
    print("o que a proxima ingestao cortar. O acervo ja indexado segue com o corte antigo —")
    print("comparar os dois no mesmo gold nao mede nada ate uma reingestao completa.")


def cmd_ajuste(nome, inst, argv):
    env, err = servido(inst)
    ajustes = {b["slug"]: b for b in inst["ajustes"]}

    if not argv:
        if err:
            print(f"[{err} — valores abaixo sao o DECLARADO, nao o servido]\n")
        larg = max(len(s) for s in ajustes)
        env_ing = le_env_da_ingestao(inst)
        for b in inst["ajustes"]:
            if b.get("onde") == "env":
                # Ajuste de INGESTAO: nao ha container servindo isto. A ingestao roda no host,
                # com os segredos da stack como ambiente — o valor do compose seria decorativo aqui.
                v = env_ing.get(b["var"])
                onde = "env da ingestao" if v is not None else "default do codigo"
            else:
                v = (env or {}).get(b["var"])
                onde = "compose" if v is not None else "default do codigo"
            mostrado = v if v not in (None, "") else b["codigo"] or "(vazio)"
            # Valor longo (instrucao de pergunta, nome de modelo) desalinha a coluna e some
            # com a fase, que e o que organiza a leitura. O inteiro sai no detalhe do ajuste.
            if len(mostrado) > 12:
                mostrado = mostrado[:11] + "\u2026"
            print(f"  {b['slug']:<{larg}}  {mostrado:>12}   fase {b['fase']:<14} ({onde})")
        print(f"\n  detalhe de um: motor {nome} ajuste <nome-do-ajuste>")
        print(f"  fora da lista, e por que: {', '.join(inst['nao_e_ajuste'])}")
        return

    slug = argv[0]
    if slug not in ajustes:
        print(f"nao existe ajuste '{slug}'. Ha: {', '.join(ajustes)}", file=sys.stderr)
        sys.exit(1)
    b = ajustes[slug]
    if b.get("onde") == "env":
        v = le_env_da_ingestao(inst).get(b["var"], b["codigo"])
    else:
        v = (env or {}).get(b["var"], b["codigo"])

    if len(argv) == 1:
        print(f"{b['slug']}   hoje: {v}   faixa: {b['faixa']}   fase {b['fase']}")
        print(f"  subir da  : {b['sobe']}")
        print(f"  e custa   : {b['custa']}")
        print(f"  como sei  : {b['medir']}")
        arquivo = (caminho_env(inst) if b.get("onde") == "env" else caminho_override(inst))
        print(f"  (variavel {b['var']}, no {arquivo})")
        return

    novo = argv[1]
    if b.get("onde") == "env":
        escreve_no_env(inst, b, v, novo)
        return
    tem_porta = (env or {}).get(b["var"]) is not None
    if tem_porta and v == novo:
        print(f"{slug} ja esta em {novo} no servido. Nada a fazer.")
        return
    # O compose base mora na release, so-leitura; o ajuste de container vive na SOBREPOSICAO
    # da instancia (desenho §4). Sem git: nem a release se edita, nem verbo servido commita
    # em bancada — quem promove e o ajudante (bin/_release/stack), que compoe base + sobreposicao.
    caminho = caminho_override(inst)
    if not os.path.isfile(caminho):
        print(f"nao achei a sobreposicao da instancia em {caminho} "
              f"(o compose base {inst['compose']} e da release, so-leitura)", file=sys.stderr)
        sys.exit(1)
    with open(caminho) as f:
        texto = f.read()
    # [ \t], nao \s: \s atravessa quebra de linha e casaria linhas vizinhas.
    pad = re.compile(rf"^([ \t]+){re.escape(b['var'])}:.*$", re.M)
    achou = pad.findall(texto)
    if len(achou) == 1:
        texto = pad.sub(lambda m: f"{m.group(1)}{b['var']}: {novo}", texto, count=1)
    elif len(achou) == 0:
        anc = re.compile(r"^([ \t]+)environment:[ \t]*$", re.M)
        if len(anc.findall(texto)) != 1:
            print(f"nao achei onde declarar {b['var']} em {caminho}: declare uma vez o "
                  f"`environment:` do servico {inst.get('servico')}", file=sys.stderr)
            sys.exit(1)
        texto = anc.sub(lambda m: f"{m.group(0)}\n{m.group(1)}  {b['var']}: {novo}", texto, count=1)
    else:
        print(f"{b['var']} aparece {len(achou)}x na sobreposicao — nao mexo as cegas", file=sys.stderr)
        sys.exit(1)
    with open(caminho, "w") as f:
        f.write(texto)
    print(f"{slug}: {v} -> {novo}  ({b['var']} em {caminho})")

    r = sh(f"{os.path.join(BIN, '_release', 'stack')} promover {inst['stack']}")
    print(r.stdout.strip()[-300:] or r.stderr.strip()[-300:])

    env2, err2 = servido(inst)
    agora = (env2 or {}).get(b["var"], "?")
    if agora == novo:
        print(f"\nCONFERIDO no servido: {b['var']}={agora}")
    else:
        print(f"\nNAO CONFERE: pedi {novo}, o container serve {agora}", file=sys.stderr)
        sys.exit(1)


# O lote de indexacao roda no rag-api (#3203): a API ja tem o embedder carregado, autentica pelo
# mesmo token da busca e devolve o id em segundos. Erro do lote vira exit da tabela da casa.
_EXIT_DO_LOTE = {404: 1, 409: 4, 422: 1}
USO_INDEXAR = ("motor <inst> indexar biblioteca [--obra <uuid>[,<uuid>…]] [--promover] [--autor <slug>] "
               "[--apply] [--json]\n  motor <inst> indexar biblioteca --so-faceta [--obra <uuid>[,<uuid>…]] [--apply] [--json]\n"
               "  motor <inst> indexar biblioteca --relatorio <lote> [--json]")

def _lote_indexacao(inst, tok, corpo=None, lote="", pula_ocupado=False):
    """POST do plano (o lote, com `aplicar`) ou GET do relatorio, na rota `indexacao` do registro.
    `pula_ocupado` (o ciclo `--so-faceta`, #3393): lote em andamento (409) nao e falha, o giro seguinte pega."""
    url = inst.get("indexacao") or ""
    if not url:
        print("motor indexar: a instancia nao declara `indexacao` em motor-instancias.json",
              file=sys.stderr)
        sys.exit(1)
    if lote:
        url = url.rstrip("/") + "/" + lote
    req = urllib.request.Request(
        url, data=json.dumps(corpo).encode() if corpo is not None else None,
        headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        if e.code not in _EXIT_DO_LOTE:
            _trata_erro_http(e, "motor indexar")
        try:
            pj = json.loads(e.read().decode("utf-8", "replace"))
            motivo = f"{pj.get('title')}: {pj.get('detail')}"
        except Exception:
            motivo = f"HTTP {e.code}"
        if e.code == 409 and pula_ocupado:
            print(f"motor indexar: {motivo} — pula este giro")
            sys.exit(0)
        print(f"motor indexar: {motivo}", file=sys.stderr)
        sys.exit(_EXIT_DO_LOTE[e.code])
    except urllib.error.URLError as e:
        _trata_erro_http(e, "motor indexar")

def _texto_do_plano(p):
    """Primeira linha: o que o plano (ou o lote aberto) faz; depois, impressao a impressao."""
    conta = (f"{p.get('a_indexar', 0)} a indexar ({p.get('trechos_a_embedar', 0)} trechos a embedar) · "
             f"{p.get('prontas', 0)} com indice aprovado"
             + ("" if p.get("promover") else " (sobem com --promover)")
             + f" · {p.get('fora_transcritas', 0)} transcrita(s) fora, o promover nao pede indice"
             f" · {p.get('fora_nao_indexaveis', 0)} nao indexavel(is) fora (espelho nao servivel)"
             f" · {p.get('indexadas', 0)} de {p.get('seladas', 0)} seladas marcadas para indexar"
             f" · {p.get('facetas_defasadas', 0)} faceta(s) a refazer no ar")
    if p.get("modo") == "nada":
        return f"nada a fazer: {conta}\nsem lote aberto"
    if p.get("modo") == "aplicado":
        return (f"lote {p['lote']} aberto no rag-api, em segundo plano: {p.get('n', 0)} impressao(oes) · "
                f"{conta}\nacompanhar: {p.get('acompanhar')}")
    linhas = [f"plano: {p.get('n', 0)} impressao(oes) · {conta}"]
    for it in (p.get("itens") or [])[:20]:
        if it["acao"] == "refazer_faceta":
            situacao = "faceta defasada" if it.get("faceta") else "faceta ausente"
        else:
            situacao = f"{it.get('vetores', 0)}/{it.get('elegiveis', 0)} vetores"
        linhas.append(f"  {it['posicao']:>3}  {it['obra_id']}  {(it.get('titulo') or '')[:40]:<40}  "
                      f"{situacao}  {it['acao']}")
    if p.get("n", 0) > 20:
        linhas.append(f"  … +{p['n'] - 20}")
    if p.get("n", 0):
        linhas.append("para valer: o mesmo comando com --apply")
    return "\n".join(linhas)

def _texto_do_relatorio(r):
    """Primeira linha: estado do lote e a contagem; depois os problemas, e os itens se forem poucos."""
    estados = ", ".join(f"{k} {v}" for k, v in sorted((r.get("por_estado") or {}).items()))
    linhas = [f"lote {r['lote']}: {r.get('estado')} · {estados or 'nada a fazer'} · "
              f"{r.get('embedados', 0)} vetores de trecho · {round((r.get('ms') or 0) / 1000)} s"]
    itens = r.get("itens") or []
    mostrar = itens if len(itens) <= 30 else [i for i in itens if i.get("problema")]
    for it in mostrar:
        gate = it.get("gate") or {}
        linhas.append(f"  {it.get('estado'):<13} {it['obra_id']}  {(it.get('titulo') or '')[:40]:<40}  "
                      f"{gate.get('vetores', '-')}/{gate.get('elegiveis', '-')}  "
                      f"{it.get('problema') or ('gate ok' if gate.get('aprovado') else '')}")
    if len(itens) > 30:
        linhas.append(f"  ({len(itens)} itens; --json traz todos)")
    return "\n".join(linhas)


def cmd_indexar(inst, argv):
    """O estagio Indexar da arq:0119 §2 (#3203): o motor recebe a impressao selada da obra marcada
    «transcrita e indexada» e monta o indice dela (trecho e faceta) sem po-lo no ar; o `acervo
    promover` poe impressao e indice em servico juntos, e `--promover` o encadeia depois do gate.
    Roda no rag-api: plano, lote em segundo plano e relatorio. O trilho antigo, que materializava o
    arquivo e cortava no motor, saiu: o motor nao corta a partir do arquivo (arq:0119, Consequencias).
    So a selada indexavel entra (#3282: espelho servivel pela regua 6). O plano traz tambem a faceta
    no ar que falta ou veio de outro cabecalho (titulo, emissor, dominio ou conceito trocado depois
    de indexar) e a refaz no --apply (#3309). `--so-faceta` (#3393) planeja so essas facetas, sem as
    seladas pendentes, e e o que o `bot` roda a cada 5 min: plano vazio nao abre lote, e lote em
    andamento sai 0 com «pula este giro» (o giro seguinte pega)."""
    particao, argv = resolve_particao(argv, "indexar")
    if particao != "biblioteca":
        print(f"motor indexar {particao}: so a biblioteca indexa por este ato; a casa indexa na "
              f"ingestao da casa.\n  {USO_INDEXAR}", file=sys.stderr)
        sys.exit(2)
    obras, lote, autor = [], "", os.environ.get("PF_CADEIRA") or "ia"
    apply_ = promover = como_json = so_faceta = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--obra", "--obras", "--relatorio", "--autor"):
            if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
                print(f"indexar: {a} exige um valor.\n  {USO_INDEXAR}", file=sys.stderr)
                sys.exit(2)
            v = argv[i + 1]
            if a == "--relatorio":
                lote = v
            elif a == "--autor":
                autor = v
            else:
                obras += [o.strip() for o in v.split(",") if o.strip()]
            i += 2
            continue
        if a == "--apply":
            apply_ = True
        elif a == "--promover":
            promover = True
        elif a == "--so-faceta":
            so_faceta = True
        elif a == "--json":
            como_json = True
        else:
            print(f"indexar: argumento desconhecido {a!r}.\n  {USO_INDEXAR}", file=sys.stderr)
            sys.exit(2)
        i += 1
    if so_faceta and (promover or lote):
        print(f"indexar: --so-faceta nao se combina com --promover nem com --relatorio.\n  {USO_INDEXAR}",
              file=sys.stderr)
        sys.exit(2)
    for valor in obras + ([lote] if lote else []):
        if not _UUID.match(valor):
            print(f"indexar: {valor!r} nao e uuid (obra e lote vao pelo uuid).\n  {USO_INDEXAR}",
                  file=sys.stderr)
            sys.exit(2)
    tok = token_da(inst)
    if lote:
        r = _lote_indexacao(inst, tok, lote=lote)
        print(json.dumps(r, ensure_ascii=False, indent=1) if como_json else _texto_do_relatorio(r))
        return
    corpo = {"autor": autor, "aplicar": apply_, "obras": obras, "promover": promover}
    if so_faceta:
        corpo["so_faceta"] = True
    r = _lote_indexacao(inst, tok, corpo, pula_ocupado=so_faceta)
    print(json.dumps(r, ensure_ascii=False, indent=1) if como_json else _texto_do_plano(r))


# ---------------------------------------------------------------- trocar (troca de embedder, #3264)
# O ato roda no rag-api (e o motor e o banco ficam do outro lado da porta): plano, montagem da geracao
# nova em sombra, relatorio, virada e descarte. A virada apaga a geracao anterior no mesmo ato e nao tem
# verbo de volta, entao so aplica com a confirmacao nomeada e o «sim» do dono, que o rag-api grava na
# geracao (arq:0121 §7.4). Erro do rag-api vira exit da tabela da casa.
_EXIT_DA_TROCA = {400: 2, 404: 1, 409: 4, 422: 1}
USO_TROCAR = (
    "motor <inst> trocar biblioteca --embedder <modelo> --dimensao <N> [--autor <slug>] [--memoria 1GB] "
    "[--apply] [--json]\n"
    "  motor <inst> trocar biblioteca [--estado] [--relatorio <lote>] [--json]\n"
    "  motor <inst> trocar biblioteca --virar <id|gN> [--ajuste <nome>=<valor>…] [--sim \"<o sim do dono>\"] "
    "[--confirma gN] [--apply] [--json]\n"
    "  motor <inst> trocar biblioteca --descartar <id|gN> [--confirma gN] [--apply] [--json]")

def _chama_troca(inst, tok, caminho="", corpo=None):
    """POST (com corpo) ou GET na rota `troca` do registro."""
    base = inst.get("troca") or ""
    if not base:
        print("motor trocar: a instancia nao declara `troca` em motor-instancias.json", file=sys.stderr)
        sys.exit(1)
    req = urllib.request.Request(
        base.rstrip("/") + caminho, data=json.dumps(corpo).encode() if corpo is not None else None,
        headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        if e.code not in _EXIT_DA_TROCA:
            _trata_erro_http(e, "motor trocar")
        try:
            pj = json.loads(e.read().decode("utf-8", "replace"))
            motivo = f"{pj.get('title')}: {pj.get('detail')}"
        except Exception:
            motivo = f"HTTP {e.code}"
        print(f"motor trocar: {motivo}", file=sys.stderr)
        sys.exit(_EXIT_DA_TROCA[e.code])
    except urllib.error.URLError as e:
        _trata_erro_http(e, "motor trocar")

def _valor_do_ajuste(texto):
    """`0.61` -> 0.61, `0,61` -> 0.61 (virgula decimal), `true` -> True, o resto fica texto (nome de
    modelo). O rag-api confere o tipo de cada ajuste antes de gravar (#3264): texto num campo numero e
    recusado la, mas a virgula e erro de digitacao de quem escreve em portugues, e se corrige aqui."""
    if texto.lower() in ("true", "false"):
        return texto.lower() == "true"
    if re.fullmatch(r"-?\d+,\d+", texto):
        texto = texto.replace(",", ".")
    try:
        return float(texto) if "." in texto else int(texto)
    except ValueError:
        return texto

def _o_que_apaga(a):
    folhas = ", ".join(a.get("folhas") or []) or "-"
    meta = ", ".join(a.get("chaves_index_meta") or []) or "-"
    return (f"{a.get('vetores', 0)} vetores, {a.get('indices', 0)} indices "
            f"({a.get('indices_em_construcao', 0)} em construcao), folhas {folhas}, chaves da index_meta {meta}")

def _cobertura_txt(c):
    return (f"cobertura {c.get('aprovadas', 0)}/{c.get('total', 0)} impressoes com indice aprovado "
            f"({c.get('percentual', 0)}%)")

def _texto_da_troca(p):
    """Primeira linha: o que o ato diz; o resto, o que o dono precisa para decidir ou acompanhar."""
    modo = p.get("modo")
    if modo == "plano" and p.get("ato") == "virar":
        c = p["cobertura"]
        g = p["geracao"]
        linhas = [f"virada da g{g['numero']} ({g['embedder']}): {_cobertura_txt(c)} · "
                  f"HNSW {'pronto' if p.get('hnsw') else 'AUSENTE'} · {p.get('indices_a_servir', 0)} indices a servir"]
        for r in (p.get("reprovadas") or [])[:20]:
            linhas.append(f"  reprovada  {r['obra_id']}  {(r.get('titulo') or '')[:40]:<40}  {r.get('motivo')}")
        if len(p.get("reprovadas") or []) > 20:
            linhas.append(f"  … +{len(p['reprovadas']) - 20}")
        linhas.append(f"  apaga a g{p['apaga']['geracao']} ({p['apaga'].get('embedder')}): {_o_que_apaga(p['apaga'])}")
        ret = p.get("retrato_mais_recente")
        linhas.append("  retrato mais recente: " + (f"{ret['tirado_em']} ({ret['total']} obras)" if ret else "nenhum"))
        linhas.append(f"  ajustes que a geracao leva: {json.dumps(p.get('ajustes'), ensure_ascii=False)}")
        linhas.append(f"  volta: {p.get('volta')}")
        linhas.append("para virar: --apply --confirma g" + str(g["numero"]) +
                      " --sim \"<o sim do dono>\" --ajuste aviso_de_cobertura_fraca=<piso> […]")
        return "\n".join(linhas)
    if modo == "virada":
        r = p.get("resultado") or {}
        return (f"virada feita: a g{p['geracao']['numero']} serve a {p['particao']} e a g"
                f"{r.get('anterior_numero')} foi expurgada ({r.get('indices_da_anterior_apagados', 0)} indices apagados, "
                f"{r.get('indices_da_nova_servindo', 0)} servindo na nova)\n"
                f"  index_meta: {p.get('index_meta', {}).get('apagadas', 0)} chave(s) embed_* apagada(s)\n"
                f"  agora: prior de secao sobre a geracao nova, retrato depois e `release conferir acervo`")
    if modo == "ja_servindo":
        return f"a g{p['geracao']} ja serve; nada a virar (index_meta: {p.get('index_meta', {}).get('apagadas', 0)} chave(s) apagada(s))"
    if modo == "plano" and p.get("ato") == "descartar":
        return (f"descartar a g{p['geracao']['geracao']} ({p['geracao']['embedder']}): "
                f"apaga {_o_que_apaga(p['apaga'])}\npara valer: --apply --confirma g{p['geracao']['geracao']}")
    if modo == "descartada":
        return f"geracao descartada: {json.dumps(p.get('resultado'), ensure_ascii=False)}"
    if modo == "aplicado":
        return (f"lote {p['lote']} aberto no rag-api, em segundo plano: g{p['geracao']} · {p['a_montar']} a montar "
                f"de {p['impressoes_servindo']} impressoes ({p['prontas']} prontas) · "
                f"{p['trechos_elegiveis']} trechos no universo\nacompanhar: {p['acompanhar']}")
    if modo is None and "ambiente" in p:   # estado
        sombra = p.get("sombra")
        sv = p.get("servindo") or {"geracao": "-", "embedder": "nenhuma geracao servindo"}
        if sombra and sombra.get("cobertura"):
            linhas = [f"{_cobertura_txt(sombra['cobertura'])} na g{sombra['geracao']} ({sombra['embedder']}) · "
                      f"servindo g{sv['geracao']} ({sv['embedder']})"]
            for f in (sombra.get("faltam_amostra") or [])[:10]:
                linhas.append(f"  falta  {f['impressao_id']}  {(f.get('titulo') or '')[:40]:<40}  "
                              f"{f.get('vetores')}/{f.get('elegiveis')} vetores · faceta {'ok' if f.get('faceta') else 'nao'}")
        else:
            linhas = [f"sem geracao em construcao na {p['particao']} · servindo g{sv['geracao']} ({sv['embedder']})"]
        amb = p.get("ambiente") or {}
        linhas.append(f"  ambiente: {amb.get('lotes_de_ingestao_abertos', 0)} lote(s) de ingestao aberto(s) · "
                      f"lote de indexacao/troca {'ABERTO' if amb.get('lote_de_indexacao_aberto') else 'fechado'} · "
                      f"VRAM livre {(amb.get('vram') or {}).get('livre_gb', 'nao medida')} GB")
        if p.get("lote"):
            linhas.append(f"  ultimo lote: {p['lote'].get('lote')}")
        return "\n".join(linhas)
    # plano da montagem
    s, par, est, amb = p["servindo"], p["parametros"], p["estimativa"], p.get("ambiente") or {}
    vram = (amb.get("vram") or {}).get("livre_gb")
    linhas = [f"plano: trocar a {p['particao']} de g{s['geracao']} ({s['embedder']}) para {par['embedder']} em "
              f"{par['dimensao_trecho']} dimensoes · {p['impressoes_servindo']} impressoes servindo · "
              f"{p['trechos_elegiveis']} trechos elegiveis",
              f"  estimativa (hipotese, confirma na primeira impressao): disco ~{est['disco_gb']} GB · "
              f"tempo ~{est['tempo_h']} h a {est['vazao_trechos_por_s']:.0f} trechos/s · modelo ~{est['vram_do_modelo_gb']} GB "
              f"de VRAM; VRAM livre agora {vram if vram is not None else 'nao medida'} GB",
              f"  ambiente: {amb.get('lotes_de_ingestao_abertos', 0)} lote(s) de ingestao aberto(s) · lote de "
              f"indexacao/troca {'ABERTO' if amb.get('lote_de_indexacao_aberto') else 'fechado'} "
              f"(nada deve rodar da montagem a virada)",
              f"  parametros: prefixo da pergunta {par.get('prefixo_da_pergunta')!r}, do trecho "
              f"{par.get('prefixo_do_trecho')!r}, fatia MRL {'sim' if par.get('fatia_mrl_trecho') else 'nao'}, "
              f"faceta {par.get('dimensao_faceta')}d, dtype {par.get('dtype')}"]
    if p.get("sombra"):
        sb = p["sombra"]
        linhas.append(f"  ja ha a g{sb['geracao']} em construcao com estes parametros: {_cobertura_txt(sb['cobertura'])}")
    linhas.append("para valer: o mesmo comando com --apply")
    return "\n".join(linhas)

def cmd_trocar(inst, argv):
    """Troca de embedder por particao (#3264; arq:0121 §7). Ver o docstring de `ingestao/troca.py`, no rag-api."""
    particao, argv = resolve_particao(argv, "trocar")
    if particao != "biblioteca":
        print(f"motor trocar {particao}: so a biblioteca troca de embedder; a casa segue na geracao dela "
              f"(arq:0121 §7.3).\n  {USO_TROCAR}", file=sys.stderr)
        sys.exit(2)
    opcoes = {"--embedder": "embedder", "--dimensao": "dimensao", "--autor": "autor", "--memoria": "memoria",
              "--virar": "virar", "--descartar": "descartar", "--confirma": "confirma", "--sim": "sim",
              "--relatorio": "relatorio"}
    v: dict = {"autor": os.environ.get("PF_CADEIRA") or "ia"}
    ajustes: dict = {}
    apply_ = como_json = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in opcoes or a == "--ajuste":
            if i + 1 >= len(argv) or (argv[i + 1].startswith("--") and a != "--sim"):
                print(f"trocar: {a} exige um valor.\n  {USO_TROCAR}", file=sys.stderr)
                sys.exit(2)
            if a == "--ajuste":
                nome, sep, valor = argv[i + 1].partition("=")
                if not sep or not nome:
                    print(f"trocar: --ajuste e <nome>=<valor>, veio {argv[i + 1]!r}.\n  {USO_TROCAR}", file=sys.stderr)
                    sys.exit(2)
                ajustes[nome.strip().replace("-", "_")] = _valor_do_ajuste(valor.strip())
            else:
                v[opcoes[a]] = argv[i + 1]
            i += 2
            continue
        if a == "--apply":
            apply_ = True
        elif a == "--json":
            como_json = True
        elif a == "--estado":
            v["estado"] = True
        else:
            print(f"trocar: argumento desconhecido {a!r}.\n  {USO_TROCAR}", file=sys.stderr)
            sys.exit(2)
        i += 1
    if v.get("relatorio") and not _UUID.match(v["relatorio"]):
        print(f"trocar: {v['relatorio']!r} nao e uuid de lote.\n  {USO_TROCAR}", file=sys.stderr)
        sys.exit(2)
    if sum(1 for k in ("virar", "descartar", "embedder", "relatorio", "estado") if v.get(k)) > 1:
        print(f"trocar: --embedder, --virar, --descartar, --relatorio e --estado sao atos distintos; "
              f"um por chamada.\n  {USO_TROCAR}", file=sys.stderr)
        sys.exit(2)
    tok = token_da(inst)
    if v.get("relatorio"):
        r = _chama_troca(inst, tok, f"/lote/{v['relatorio']}")
        print(json.dumps(r, ensure_ascii=False, indent=1) if como_json else _texto_do_lote_da_troca(r))
        return
    if v.get("virar") or v.get("descartar"):
        corpo = {"particao": particao, "geracao": v.get("virar") or v.get("descartar"), "aplicar": apply_,
                 "autor": v["autor"]}
        if v.get("confirma"):
            corpo["confirma"] = v["confirma"]
        if v.get("virar"):
            if v.get("sim"):
                corpo["sim"] = v["sim"]
            if ajustes:
                corpo["ajustes"] = ajustes
        r = _chama_troca(inst, tok, "/virar" if v.get("virar") else "/descartar", corpo)
        print(json.dumps(r, ensure_ascii=False, indent=1) if como_json else _texto_da_troca(r))
        return
    if v.get("embedder"):
        if not v.get("dimensao"):
            print(f"trocar: --embedder pede --dimensao.\n  {USO_TROCAR}", file=sys.stderr)
            sys.exit(2)
        try:
            dimensao = int(v["dimensao"])
        except ValueError:
            print(f"trocar: --dimensao exige inteiro, veio {v['dimensao']!r}.\n  {USO_TROCAR}", file=sys.stderr)
            sys.exit(2)
        corpo = {"particao": particao, "embedder": v["embedder"], "dimensao": dimensao, "aplicar": apply_,
                 "autor": v["autor"]}
        if v.get("memoria"):
            corpo["memoria"] = v["memoria"]
        r = _chama_troca(inst, tok, "", corpo)
        print(json.dumps(r, ensure_ascii=False, indent=1) if como_json else _texto_da_troca(r))
        return
    r = _chama_troca(inst, tok, f"/{particao}")
    print(json.dumps(r, ensure_ascii=False, indent=1) if como_json else _texto_da_troca(r))

def _texto_do_lote_da_troca(r):
    """Primeira linha: a cobertura (impressoes com indice aprovado sobre as que servem), como o card manda."""
    cob = r.get("cobertura")
    plano = r.get("plano") or {}
    if cob:
        primeira = f"{_cobertura_txt(cob)} · "
    else:
        feitas = sum(1 for i in r.get("itens") or [] if i.get("estado") == "montada")
        primeira = (f"cobertura inicial {plano.get('prontas', 0)}/{plano.get('impressoes_servindo', 0)} e "
                    f"{feitas} montada(s) neste lote · ")
    estados = ", ".join(f"{k} {v}" for k, v in sorted((r.get("por_estado") or {}).items()))
    linhas = [primeira + f"lote {r['lote']}: {r.get('estado')} · {estados or 'nada a fazer'} · "
              f"{r.get('embedados', 0)} vetores de trecho · {round((r.get('ms') or 0) / 1000)} s"]
    if r.get("hnsw"):
        linhas.append(f"  HNSW construido em {r['hnsw']['folhas']} folha(s), {round(r['hnsw']['ms'] / 1000)} s")
    if r.get("problema"):
        linhas.append(f"  PAROU: {r['problema']}")
    for it in (r.get("problemas") or [])[:20]:
        linhas.append(f"  {it.get('estado'):<10} {it['obra_id']}  {(it.get('titulo') or '')[:40]:<40}  {it.get('problema')}")
    if len(r.get("problemas") or []) > 20:
        linhas.append(f"  … +{len(r['problemas']) - 20} (--json traz todos)")
    return "\n".join(linhas)


# ---------------------------------------------------------------- evento 'consulta'
# Emitido no choke point de `motor <inst> buscar`, DENTRO do motor Python (card #2911,
# contrato B1). Todo caminho de busca — claude.ai, fita e Code — passa por cmd_buscar
# (C1 confirmado 27/08: cmd_buscar e o unico emissor de http para o endpoint de busca),
# entao emitir aqui cobre as tres superficies sem parsear o campo 'comando' do audit.
#
# NOME: 'consulta', nao 'disparo' (dono vetou na fita 27/08: 'disparo' confunde o evento
# — a busca aconteceu — com o veredito — foi bom disparar). O evento afirma so o fato.
#
# sessao/ordem_id: lidos do env (PF_SESSAO/PF_ORDEM_ID). bin/motor roda como NETO do
# server (server -> run_command -> bash -> motor) e NAO enxerga o ContextVar de sessao
# do server, so o env herdado. Enquanto o server nao injetar PF_SESSAO/PF_ORDEM_ID no
# _env_subprocesso do run_command, os campos saem '-' — declarado, nao inferido. O JOIN
# de D (card #2908) se ancora em 'sessao'; a propagacao e o proximo elo (anotado no card).
# Onde mora o bruto, a chave, o aparo e a classe da linha sao do lib/oplog (arq:0123 §3).
def _emite_consulta(nome, inst, corpo, resp, dur_ms):
    """Grava uma linha JSONL {evento:'consulta', ...} em $PLATAFIRMA_INSTANCIA/var/log/ops. Best-effort:
    falha de log NUNCA derruba a busca — o resultado ja saiu para o cliente."""
    try:
        from datetime import datetime
        n_hits = None
        if isinstance(resp, dict):
            for chave in ("fontes", "hits", "resultados", "itens"):
                v = resp.get(chave)
                if isinstance(v, list):
                    n_hits = len(v)
                    break
        linha = {
            "ts": datetime.now().astimezone().isoformat(timespec="milliseconds"),
            "instancia": os.environ.get("OPS_NAME", "-"),
            "usuario": os.environ.get("USER", "claudinho"),
            "sessao": os.environ.get("PF_SESSAO", "-"),
            "ordem_id": corpo.get("ordem_id") or os.environ.get("PF_ORDEM_ID", "-"),
            "tool": "motor",
            "evento": "consulta",
            "motor": nome,
            "cadeira": os.environ.get("PF_CADEIRA", "-"),
            "chapeu": os.environ.get("PF_CHAPEU", "-"),
            "particao": corpo.get("particao"),
            "origem_consulta": corpo.get("origem"),   # abertura|busca|bench|sombra|autoteste; `origem` e de quem chamou
            "k": corpo.get("k"),
            "conceito": corpo.get("conceitos"),
            "n_hits": n_hits,
            "dur_ms": dur_ms,
        }
        # Na consulta que a abertura dispara a query e a mensagem do dono: grava-se, so no bruto
        # (spec log-de-negocio §0/§3); o pacote que volta da busca nao entra na linha.
        # Na consulta montada (#3360) `pergunta` e a lista enviada; o que a cadeira disse e a necessidade.
        # O pedido do dono nao e copiado para esta linha: ele ja esta nas linhas de turno e de abertura.
        bloco = corpo.get("consulta") if isinstance(corpo.get("consulta"), dict) else None
        pergunta = (bloco["necessidade"] if bloco else corpo.get("pergunta")) or ""
        linha["query"] = pergunta[:2000]
        linha["query_bytes"] = len(pergunta.encode("utf-8"))
        if bloco:
            linha["montagem"] = {"n_rotulos": len(bloco["rotulos"]),
                                 "n_perguntas": len(bloco["perguntas"]),
                                 "lint": bloco.get("lint")}
        oplog.emitir(linha)
    except Exception:
        pass  # log e instrumento, nunca barreira: a busca ja respondeu.


def _trata_erro_http(e, contexto="motor"):
    if isinstance(e, urllib.error.HTTPError):
        corpo = ""
        try:
            corpo = e.read(200).decode("utf-8", "replace").strip()
        except Exception:
            pass
        motivo = f"HTTP {e.code}"
        if corpo:
            motivo += f" — {corpo}"
        elif e.reason:
            motivo += f" — {e.reason}"
        print(f"{contexto}: {motivo}", file=sys.stderr)
    elif isinstance(e, urllib.error.URLError):
        print(f"{contexto}: erro de rede — {e.reason}", file=sys.stderr)
    else:
        print(f"{contexto}: {e}", file=sys.stderr)
    sys.exit(3)


# Quem chamou a busca (#3314); a mesma lista do CHECK de acervo.evento_recuperacao. A abertura e a
# medida mandam a sua; chamada sem a flag grava busca.
ORIGENS = ("abertura", "busca", "bench", "sombra", "autoteste")
# A consulta montada (#3360, spec motor §2b) e so da origem `busca`: a abertura manda o prompt do dono
# literal e a medida manda o gabarito literal, e os dois precisam chegar intactos ao motor.
ORIGENS_LITERAIS = ("abertura", "bench", "sombra", "autoteste")

def _monta_consulta(texto, sem_lint):
    """A consulta montada da origem `busca` (#3360, #3364): lint, chapeu e rotulos.

    Recusa com exit 2 e a causa na primeira linha, o jeito certo na seguinte. Nunca reescreve a
    necessidade e nunca chama modelo: quem corrige e a cadeira, na chamada seguinte."""
    chapeu = consulta.chapeu_vestido()
    cadeira = (os.environ.get("PF_CADEIRA") or "").strip()
    if not sem_lint:
        recusa = consulta.lint(texto)
        if recusa:
            print(consulta.mensagem_de_recusa(*recusa), file=sys.stderr)
            sys.exit(2)
    rotulos = consulta.rotulos_do_chapeu(cadeira, chapeu)
    return consulta.consulta(texto, chapeu, rotulos, lint_desligado=sem_lint)

def cmd_buscar(nome_inst, inst, argv):
    uso = ('motor <inst> buscar <particao> --necessidade "<uma frase que nomeia o assunto pelo termo do acervo>" '
           '[--sem-lint] [--k N] [--texto secao|trecho|nenhum] [--conceito <slug>] '
           '[--ordem-id <id>] [--geracao <id|gN>] [--origem ' + "|".join(ORIGENS) + ']\n'
           '  posicional: motor <inst> buscar <particao> "<frase>" passa pelo mesmo lint; '
           '--origem ' + "|".join(ORIGENS_LITERAIS) + ' manda o texto literal, sem lint nem montagem\n  ' + SPEC)
    if not argv and sys.stdin.isatty():
        print(uso, file=sys.stderr)
        sys.exit(2)

    particao, resto = resolve_particao(argv, "buscar")
    corpo = {"particao": _PARA_A_API.get(particao, particao)}
    conceitos = []
    palavras = []
    necessidade = None
    sem_lint = False
    i = 0
    while i < len(resto):
        a = resto[i]
        if a == "--sem-lint":                 # para a bancada: grava `lint: desligado` no evento
            sem_lint = True
            i += 1
            continue
        if a.startswith("--"):
            nome = a[2:]
            if nome not in ("k", "texto", "conceito", "ordem-id", "origem", "geracao", "necessidade"):
                print("buscar: flag desconhecida " + repr(a)
                      + ". conhecidas: --necessidade, --sem-lint, --k, --texto, --conceito, --ordem-id,"
                        " --origem, --geracao.\n  " + uso,
                      file=sys.stderr)
                sys.exit(2)
            if i + 1 >= len(resto) or resto[i + 1].startswith("--"):
                print("buscar: a flag " + repr(a) + " exige um valor.\n  " + uso, file=sys.stderr)
                sys.exit(2)
            v = resto[i + 1]
            if nome == "conceito":            # repetivel: cada --conceito <slug> acrescenta um
                conceitos.append(v)
            elif nome == "ordem-id":          # id da fita, passado pelo cliente (unica entidade
                corpo["ordem_id"] = v         # que sabe que abertura e buscas sao a mesma fita:
                                              # no claude.ai cada tool call e sessao MCP distinta,
                                              # entao nao ha id compartilhado no servidor (#2902).
            elif nome == "geracao":          # busca numa geracao fora de servico (#3264): a sombra
                corpo["geracao"] = v
            elif nome == "necessidade":      # o que a cadeira precisa saber, em uma frase (#3360)
                necessidade = v
            elif nome == "origem":           # quem chamou (#3314): vai ao evento do log
                if v not in ORIGENS:
                    print("buscar: --origem aceita " + "|".join(ORIGENS) + ", recebi " + repr(v) + ".",
                          file=sys.stderr)
                    sys.exit(2)
                corpo["origem"] = v
            elif nome == "k":
                try:
                    corpo["k"] = int(v)
                except ValueError:
                    print("buscar: --k exige inteiro, recebi " + repr(v) + ".", file=sys.stderr)
                    sys.exit(2)
            else:  # texto
                if v not in ("secao", "trecho", "nenhum"):
                    print("buscar: --texto aceita secao|trecho|nenhum, recebi " + repr(v) + ".", file=sys.stderr)
                    sys.exit(2)
                corpo["texto"] = v
            i += 2
        else:
            palavras.append(a)
            i += 1

    if necessidade is not None and palavras:
        print("buscar: texto posicional e --necessidade juntos; use um so.\n  " + uso, file=sys.stderr)
        sys.exit(2)
    pergunta = ""
    if necessidade is not None:
        pergunta = necessidade.strip()
    elif palavras == ["-"]:
        pergunta = sys.stdin.read().strip()
    elif palavras:
        pergunta = " ".join(palavras)
    elif not sys.stdin.isatty():
        pergunta = sys.stdin.read().strip()

    if not pergunta:
        print("buscar: nenhuma pergunta informada via argumento ou stdin.\n  " + uso, file=sys.stderr)
        sys.exit(2)

    corpo.setdefault("origem", "busca")
    if corpo["origem"] in ORIGENS_LITERAIS:
        # A abertura e a medida mandam o texto como esta: sem lint e sem montagem (spec motor §2b).
        if necessidade is not None or sem_lint:
            print("buscar: --origem " + corpo["origem"] + " manda o texto literal; --necessidade e "
                  "--sem-lint so valem na origem busca.\n  " + uso, file=sys.stderr)
            sys.exit(2)
        corpo["pergunta"] = pergunta
    else:
        bloco = _monta_consulta(pergunta, sem_lint)
        corpo["pergunta"] = bloco["perguntas"][0] if len(bloco["perguntas"]) == 1 else bloco["perguntas"]
        corpo["perguntas"] = bloco["perguntas"]
        corpo["consulta"] = bloco
        chapeu = consulta.chapeu_vestido()
        if chapeu:
            cadeira = (os.environ.get("PF_CADEIRA") or "").strip()
            rotulos = list(consulta.rotulos_do_chapeu(cadeira, chapeu))
            corpo["chapeu"] = {"cadeira": cadeira, "chapeu": chapeu, "rotulos": rotulos}
    # Sessao e fita vao no corpo (#3314): o rag-api le PF_SESSAO do proprio conteiner, que nao
    # e o do cliente, e o evento saia sem sessao_id.
    sessao = os.environ.get("PF_SESSAO", "").strip()
    if sessao and sessao != "-":
        corpo.setdefault("sessao_id", sessao)
    ordem = os.environ.get("PF_ORDEM_ID", "").strip()
    if ordem and ordem != "-":
        corpo.setdefault("ordem_id", ordem)
    if conceitos:
        corpo["conceitos"] = conceitos
    tok = token_da(inst)
    req = urllib.request.Request(
        inst["endpoint"], data=json.dumps(corpo).encode(),
        headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    t0 = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            bruto = r.read().decode()
    except (urllib.error.HTTPError, urllib.error.URLError) as e:
        _trata_erro_http(e, "motor")
    dur_ms = int((time.monotonic() - t0) * 1000)
    # choke point (#2911): parse best-effort so para instrumentar; a saida ao cliente
    # continua sendo o corpo cru, byte a byte, para nao alterar contrato de nenhuma
    # superficie que consome esta stdout.
    try:
        resp = json.loads(bruto)
    except Exception:
        resp = None
    _emite_consulta(nome_inst, inst, corpo, resp, dur_ms)
    print(bruto)


# ---------------------------------------------------------------- medir
# A bateria mede o SERVIDO, pela porta que o cliente usa — nao um retrieve() reconstruido no
# host. E deliberado: reconstruir o caminho no host exige o venv com o embedder, mede uma copia
# do trilho e passa silenciosamente por deploy velho. Aqui, o que responde e o que esta no ar.

def token_da(inst):
    """RAG_API_TOKEN: segredo da instancia, um arquivo so com o valor. `token_em` e o canonico
    /srv/platafirma/casa/segredos/<stack>/<NOME> ou a forma curta <stack>/<NOME>.
    Ausente e falha alta: busca sem token seria 401 com cara de motor fora do ar."""
    nome = inst.get("token_em") or ""
    arq = (str(raizes.instancia() / "segredos" / nome) if _seguro(nome, 2)
           else na_instancia(nome) if nome.startswith(_CANON_INSTANCIA + "segredos/") else "")
    if not arq:
        print(f"motor: token_em do registro deve ser um segredo da instancia "
              f"(segredos/<stack>/<NOME>), veio {nome!r}", file=sys.stderr)
        sys.exit(1)
    try:
        with open(arq) as f:
            return f.read().strip()
    except OSError as e:
        print(f"motor: segredo {nome} ilegivel ({type(e).__name__}) "
              f"— grave com `seg segredo gravar {nome}`", file=sys.stderr)
        sys.exit(1)


def http(url, tok, corpo=None, timeout=300):
    req = urllib.request.Request(
        url, data=json.dumps(corpo).encode() if corpo is not None else None,
        headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except (urllib.error.HTTPError, urllib.error.URLError) as e:
        _trata_erro_http(e, "motor")


def _base(sid):
    """`secao~2` e a mesma secao que `secao`: a reparticao e nossa, nao do documento."""
    return re.sub(r"~\d+$", "", sid or "")


def titulos_do_banco(inst):
    """slug do documento -> titulo da obra, e id da obra -> titulo.

    Sai do banco e nao do repo porque o alvo do gabarito e o que ESTA indexado; obra
    catalogada e nao ingerida nao pode contar como alvo alcancavel.
    """
    b = inst.get("banco") or {}
    if not b:
        return {}, {}
    sql = ("SELECT DISTINCT split_part(s.ancora,'#',1), o.id::text, o.titulo "
           "FROM acervo.secao s JOIN acervo.impressao i ON i.id = s.impressao_id "
           "JOIN acervo.obra o ON o.id = i.obra_id WHERE i.estado = 'servindo'")
    r = sh(f"docker exec -i {b['container']} psql -U {b['user']} -d {b['db']} -At -F '\t' -c \"{sql}\"")
    if r.returncode != 0:
        print(f"nao consegui ler o banco ({b['container']}): {r.stderr.strip()[-200:]}", file=sys.stderr)
        sys.exit(1)
    por_slug, por_obra = {}, {}
    for linha in r.stdout.splitlines():
        if not linha.strip():
            continue
        slug, oid, titulo = linha.split("\t")
        por_slug[slug] = titulo
        por_obra.setdefault(oid, set()).add(titulo)
    return por_slug, por_obra


def monta_gold(inst, gabarito=None):
    """Duas familias, e elas nunca se somam numa nota so: nota unica esconde qual metade quebrou.

    - `codigo`  : o gabarito declara a secao exata (`alvo_section_id`). Acerto = a secao.
    - `sentido` : o gabarito declara a obra (`alvo_obra_ids`). Acerto = qualquer trecho dela.

    Negativas do gabarito passam a ser medidas na familia `abstencao` (#2925).
    Fica de fora, contado e nunca escondido: multi-step (sem alvo), e alvo cuja
    obra nao esta indexada — gold que encolhe em silencio e baseline que mente.
    """
    caminho = gabarito or na_release(inst.get("gabarito", ""))
    if not caminho or not os.path.isfile(caminho):
        print(f"gabarito canonico nao encontrado em {caminho}", file=sys.stderr)
        sys.exit(1)
    itens = [json.loads(l) for l in open(caminho, encoding="utf-8") if l.strip()]
    por_slug, por_obra = titulos_do_banco(inst)
    gold, sem_alvo, fora_do_indice = [], 0, 0
    for e in itens:
        if not e.get("pontuavel", True):
            continue
        if e.get("relevancia") == "negativa":
            # A negativa que ganhou obra no acervo reformado fica no estrato negativo para a calibracao
            # da #3264 (protocolo G0), mas abster nela e erro: a `nota` do gabarito a marca, e a conta
            # a mostra a parte das 22 sem obra.
            gold.append({"q": e["pergunta"], "id": e.get("id"), "familia": "abstencao",
                         "estrato": e.get("estrato"), "obras": set(), "anchor": None,
                         "com_obra": str(e.get("nota") or "").startswith("ganhou obra")})
            continue
        alvo = e.get("alvo_section_id")
        if alvo:
            titulo = por_slug.get(_base(alvo).split("#", 1)[0])
            if not titulo:
                fora_do_indice += 1
                continue
            gold.append({"q": e["pergunta"], "id": e.get("id"), "familia": "codigo",
                         "estrato": e.get("estrato"), "obras": {titulo},
                         "anchor": _base(alvo).split("#", 1)[1] if "#" in alvo else None})
            continue
        # `alvo_obras` (titulos) e a forma do estrato gerado; `alvo_obra_ids` (uuid) e a do
        # gabarito canonico. As duas resolvem para o mesmo: o titulo que a resposta devolve.
        obras = ({t for t in (e.get("alvo_obras") or [])}
                 | {t for o in (e.get("alvo_obra_ids") or []) for t in por_obra.get(o, ())})
        if obras:
            gold.append({"q": e["pergunta"], "id": e.get("id"), "familia": "sentido",
                         "estrato": e.get("estrato"), "obras": obras, "anchor": None})
        elif e.get("alvo_obra_ids") or e.get("alvo_obras"):
            fora_do_indice += 1
        else:
            sem_alvo += 1
    return gold, {"itens": len(itens), "sem_alvo": sem_alvo, "fora_do_indice": fora_do_indice}


def _rank(fontes, item):
    for i, f in enumerate(fontes, 1):
        if f.get("obra") not in item["obras"]:
            continue
        if item["anchor"] is None:
            return i
        sid = _base(f.get("section_id") or "")
        if "#" in sid and sid.split("#", 1)[1] == item["anchor"]:
            return i
    return None


def _agrega(ranks, k=5):
    n = len(ranks) or 1
    res = {"n": len(ranks),
           "hit@1": round(sum(1 for r in ranks if r == 1) / n, 3),
           "hit@3": round(sum(1 for r in ranks if r and r <= 3) / n, 3),
           "hit@5": round(sum(1 for r in ranks if r and r <= 5) / n, 3)}
    if k not in (1, 3, 5):
        res[f"hit@{k}"] = round(sum(1 for r in ranks if r and r <= k) / n, 3)
    res["mrr"] = round(sum((1.0 / r) if r else 0.0 for r in ranks) / n, 3)
    return res


def _p(vals, q):
    if not vals:
        return 0.0
    s = sorted(vals)
    return s[min(len(s) - 1, int(round(q * (len(s) - 1))))]


def dir_medicoes(inst):
    rel = inst.get("medicoes_em", "var/medicoes")
    d = na_instancia(rel)
    if not d:
        print(f"medicoes_em invalido no registro (fora da instancia): {rel!r}", file=sys.stderr)
        sys.exit(1)
    os.makedirs(d, exist_ok=True)
    return d


def ultima_medicao(inst, gabarito, geracao=None):
    """A ultima rodada DO MESMO gabarito (e da mesma geracao: a sombra se compara com a sombra, o servido
    com o servido). Comparar estratos diferentes seria comparar populacoes diferentes e chamar a
    diferenca de delta."""
    d = dir_medicoes(inst)
    for nome in sorted((f for f in os.listdir(d) if f.endswith(".json")), reverse=True):
        with open(os.path.join(d, nome)) as f:
            m = json.load(f)
        if m.get("gabarito") == gabarito and m.get("geracao") == geracao:
            return m
    return None


def cmd_medir(nome, inst, argv):
    particao, argv = resolve_particao(argv, "medir")
    if "--calibrar" in argv:
        return cmd_calibrar(inst, particao, argv)
    if "--sombra-ver" in argv:
        return cmd_sombra_ver(inst, _valor(argv, "--sombra-ver", "medir"))
    if "--sombra-parar" in argv:
        return cmd_sombra_parar(inst, _valor(argv, "--sombra-parar", "medir"))
    if "--sombra" in argv:
        return cmd_sombra(inst, particao, argv)
    if particao != "biblioteca" and "--gabarito" not in argv:
        print(f"motor medir {particao}: sem gabarito para esta particao. So 'biblioteca' tem\n"
              f"  gabarito canonico hoje; passe --gabarito <arq> para as outras.\n  {SPEC}",
              file=sys.stderr)
        sys.exit(2)
    k = 5
    rerank = "--rerank" in argv
    if "--k" in argv:
        k = int(argv[argv.index("--k") + 1])
    rotulo = argv[argv.index("--rotulo") + 1] if "--rotulo" in argv else ""
    expansao = "--expansao" in argv
    veredito = "--veredito" in argv
    geracao = _valor(argv, "--geracao", "medir") if "--geracao" in argv else None
    peso = argv[argv.index("--peso-conceito") + 1] if "--peso-conceito" in argv else None
    gab = argv[argv.index("--gabarito") + 1] if "--gabarito" in argv else None
    if gab:
        gab = os.path.abspath(gab)
    # Chave do delta: o nome LOGICO <familia>/<caminho> (estavel entre raizes e igual ao das
    # medicoes antigas); gabarito passado a mao fora da release entra pelo caminho absoluto.
    chave_gab = logico_da_release(gab or inst.get("gabarito", ""))
    tok = token_da(inst)

    carimbo = http(inst["facets"], tok).get("indice", {})
    gold, conta = monta_gold(inst, gab)
    if not gold:
        print("gold vazio — nada a medir", file=sys.stderr)
        sys.exit(1)
    n_cod = sum(1 for g in gold if g['familia'] == 'codigo')
    n_sen = sum(1 for g in gold if g['familia'] == 'sentido')
    n_abs = sum(1 for g in gold if g['familia'] == 'abstencao')
    print(f"gabarito: {conta['itens']} itens | {len(gold)} pontuaveis "
          f"({n_cod} por codigo, {n_sen} por sentido"
          + (f", {n_abs} negativas" if n_abs else "") + ") | "
          f"{conta['sem_alvo']} sem alvo (multi-step) | "
          f"{conta['fora_do_indice']} com alvo fora do indice")
    print(f"indice: acervo_sha={carimbo.get('acervo_sha','?')[:12]} "
          f"{carimbo.get('embed_model')} ({carimbo.get('embed_backend')}) | "
          f"revisor {'LIGADO nesta rodada' if rerank else 'desligado'} | "
          f"expansao {'LIGADA nesta rodada' if expansao else 'desligada'}"
          + (f" (peso {peso})" if expansao and peso else "")
          + f" | veredito por conceito {'LIGADO nesta rodada' if veredito else 'como a geracao declara'}"
          + (f" | GERACAO MEDIDA: {geracao} (embedder e ajustes dela)" if geracao else "") + f" | k={k}")
    # a geracao que serve a biblioteca e o sinal e o piso que ela leva (aceite do #3264): sem isto o carimbo
    # dizia so o embedder, e o piso escolhido na virada ficava em `motor.geracao.ajustes`, fora da medida
    ger = carimbo.get("geracao") or {}
    if ger:
        aj = ger.get("ajustes") or {}
        print(f"geracao servindo: g{ger.get('numero')} ({(ger.get('parametros') or {}).get('embedder')}) | "
              f"aviso_de_cobertura_fraca {aj.get('aviso_de_cobertura_fraca')} | "
              f"aviso_com_revisor {aj.get('aviso_com_revisor')} | "
              f"veredito_por_conceito {aj.get('veredito_por_conceito')}")
    print()

    ranks = {"codigo": [], "sentido": [], "t2": []}
    abst_ok, abst_total = 0, 0
    abst_sem, total_sem, abst_com, total_com = 0, 0, 0, 0
    perguntas = []
    lat, t0 = [], time.time()
    # Os bracos ligam por chamada em `bracos` (a lista que a API le desde o #2895). Os booleanos
    # `rerank` e `expansao` no corpo, que esta bateria mandava, a API nao le: a rodada dita «revisor
    # LIGADO» media o mesmo numero que a sem revisor (medido em 07/10/2026, #3264).
    bracos = [b for b, ligado in (("rerank", rerank), ("expansao", expansao), ("veredito", veredito)) if ligado]
    for i, g in enumerate(gold, 1):
        corpo = {"pergunta": g["q"], "k": k, "texto": "nenhum", "origem": "bench"}
        if bracos:
            corpo["bracos"] = bracos
        if expansao and peso is not None:
            corpo["peso_conceito"] = float(peso)
        if geracao:
            corpo["geracao"] = geracao
        r = http(inst["endpoint"], tok, corpo)
        lat.append((r.get("tempos_ms") or {}).get("total", 0.0))
        cob = (r.get("cobertura") or "").lower()
        sinal = r.get("sinal") or {}
        linha = {"id": g.get("id"), "q": g["q"], "familia": g["familia"], "estrato": g.get("estrato"),
                 "cobertura": cob, "medida": sinal.get("medida"), "valor": sinal.get("valor"),
                 "piso": sinal.get("piso"),
                 "veredito": ((r.get("ontologia") or {}).get("veredito") or {}).get("estado")}
        if g["familia"] == "abstencao":
            abst_total += 1
            abstem = cob in ("fraca", "vazia", "ausente", "nenhuma")
            abst_ok += abstem
            if g.get("com_obra"):
                total_com, abst_com = total_com + 1, abst_com + abstem
            else:
                total_sem, abst_sem = total_sem + 1, abst_sem + abstem
            linha["grupo"] = "neg_com_obra" if g.get("com_obra") else "neg_sem_obra"
        else:
            rnk = _rank(r.get("fontes") or [], g)
            ranks[g["familia"]].append(rnk)
            t2 = (g.get("estrato") or "").startswith("T2")
            if t2:
                ranks["t2"].append(rnk)
            linha.update(grupo="t2" if t2 else "pos", rank=rnk)
        perguntas.append(linha)
        if i % 25 == 0:
            print(f"  ... {i}/{len(gold)}")

    m = {"geral": _agrega(ranks["codigo"] + ranks["sentido"], k),
         "codigo": _agrega(ranks["codigo"], k),
         "sentido": _agrega(ranks["sentido"], k),
         "t2": _agrega(ranks["t2"], k)}
    if abst_total:
        m["abstencao"] = {"n": abst_total, "ok": abst_ok,
                          "abstencao": f"{abst_ok}/{abst_total}",
                          "taxa": round(abst_ok / abst_total, 3)}
    med = {"em": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "rotulo": rotulo, "k": k,
           "rerank": rerank, "expansao": expansao, "peso_conceito": peso,
           "veredito": veredito, "geracao": geracao, "bracos": bracos,
           "gabarito": chave_gab,
           "indice": carimbo, "gold": conta, "metricas": m,
           "abstencao": f"{abst_ok}/{abst_total}" if abst_total else None,
           "abstencao_por_grupo": {"sem_obra": f"{abst_sem}/{total_sem}", "com_obra": f"{abst_com}/{total_com}"},
           "perguntas": perguntas,
           "latencia_ms": {"mediana": round(_p(lat, 0.5), 1), "p90": round(_p(lat, 0.9), 1)},
           "elapsed_s": round(time.time() - t0, 1)}

    col_k = f" {'hit@' + str(k):>7}" if k not in (1, 3, 5) else ""
    print(f"\n  {'familia':<9} {'n':>4} {'hit@1':>7} {'hit@3':>7} {'hit@5':>7}{col_k} {'mrr':>7}")
    for fam in ("codigo", "sentido", "t2", "geral"):
        a = m[fam]
        extra_v = f" {a[f'hit@{k}']:>7}" if k not in (1, 3, 5) else ""
        print(f"  {fam:<9} {a['n']:>4} {a['hit@1']:>7} {a['hit@3']:>7} {a['hit@5']:>7}{extra_v} {a['mrr']:>7}")
    if abst_total:
        print(f"  abstenção {abst_ok}/{abst_total}")
        if total_com:
            # o recorte do card: as 22 negativas sem obra, e a parte as que ganharam obra (abster nelas e erro)
            print(f"    sem obra {abst_sem}/{total_sem} · com obra {abst_com}/{total_com} (abster nelas e erro)")
    print(f"\n  latencia servida: mediana {med['latencia_ms']['mediana']} ms | "
          f"p90 {med['latencia_ms']['p90']} ms | rodada {med['elapsed_s']}s")

    anterior = ultima_medicao(inst, chave_gab, geracao)
    arq = os.path.join(dir_medicoes(inst),
                       time.strftime("%Y%m%dT%H%M%S") + (f"-{rotulo}" if rotulo else "") + ".json")
    with open(arq, "w") as f:
        json.dump(med, f, ensure_ascii=False, indent=1)

    if anterior:
        # O delta so quer dizer alguma coisa junto do que MUDOU no indice entre as duas
        # rodadas: numero que subiu com o corpus outro nao e melhora, e ninguem percebe.
        print(f"\n  contra {anterior['em']}"
              + (f" [{anterior['rotulo']}]" if anterior.get("rotulo") else ""))
        ant_m = anterior.get("metricas", {})
        for fam in ("codigo", "sentido", "t2", "geral"):
            if fam in m and fam in ant_m:
                d1 = m[fam]["hit@1"] - ant_m[fam]["hit@1"]
                dm = m[fam]["mrr"] - ant_m[fam]["mrr"]
                dk_str = ""
                if k not in (1, 3, 5) and f"hit@{k}" in m[fam] and f"hit@{k}" in ant_m[fam]:
                    dk = m[fam][f"hit@{k}"] - ant_m[fam][f"hit@{k}"]
                    dk_str = f"   hit@{k} {dk:+.3f}"
                print(f"  {fam:<9} hit@1 {d1:+.3f}{dk_str}   mrr {dm:+.3f}")
        if abst_total:
            ant_abs = ant_m.get("abstencao") or anterior.get("abstencao")
            if isinstance(ant_abs, dict) and "ok" in ant_abs:
                d_ok = abst_ok - ant_abs["ok"]
                print(f"  abstenção {abst_ok}/{abst_total} ({d_ok:+d} contra {ant_abs['ok']}/{ant_abs.get('n', abst_total)})")
            elif isinstance(ant_abs, str) and "/" in ant_abs:
                try:
                    ant_ok = int(ant_abs.split("/")[0])
                    d_ok = abst_ok - ant_ok
                    print(f"  abstenção {abst_ok}/{abst_total} ({d_ok:+d} contra {ant_abs})")
                except ValueError:
                    print(f"  abstenção {abst_ok}/{abst_total}")
            else:
                print(f"  abstenção {abst_ok}/{abst_total}")
        mudou = [c for c in set(carimbo) | set(anterior.get("indice", {}))
                 if carimbo.get(c) != anterior.get("indice", {}).get(c)
                 and c != "sha_calculado_em"]
        if mudou:
            print("  mudou no indice: " + ", ".join(
                f"{c} {anterior.get('indice', {}).get(c)} -> {carimbo.get(c)}"
                for c in sorted(mudou)))
        else:
            print("  indice identico — o delta e do que voce mexeu, nao do corpus")
        for campo, agora_v in (("rerank", rerank), ("k", k), ("expansao", expansao),
                               ("peso_conceito", peso), ("veredito", veredito)):
            if campo == "veredito":   # medicao anterior ao #3264 nao tem o campo: ausente e desligado
                if bool(anterior.get(campo)) != agora_v:
                    print(f"  mudou na rodada: {campo} {bool(anterior.get(campo))} -> {agora_v}")
                continue
            if anterior.get(campo) != agora_v:
                print(f"  mudou na rodada: {campo} {anterior.get(campo)} -> {agora_v}")
    else:
        print("\n  primeira medicao: nao ha baseline. Meca de novo depois de mexer.")
    print(f"\n  salvo em {arq}")


def _medida_da_rodada(linhas):
    """A nota crua que a rodada usou: `rerank` ou `sim` (a que a API devolveu em `sinal.medida`)."""
    medidas = [x.get("medida") for x in linhas if x.get("medida") in ("rerank", "sim")]
    return max(set(medidas), key=medidas.count) if medidas else None


# O revisor que o rag-api liga quando a chamada pede `rerank` sem modelo declarado (RECOMMENDED_RERANKER,
# platafirma-conhecimento@rag/motor_acervo/config/settings.py). Um revisor vencedor so vale na busca se a
# geracao o liga por padrao: o ajuste `revisor` dela leva o nome do modelo.
MODELO_DO_REVISOR = "BAAI/bge-reranker-v2-m3"


def _ajuste_do_vencedor(med, piso, piso_sim=None):
    """O que passar a `trocar --virar` para a geracao nascer com o sinal que venceu.

    `aviso_de_cobertura_fraca` e sempre exigido pela virada (a decisao do dono fica gravada): o veredito
    e a similaridade abstem pelo piso dela; o revisor vence com a nota dele (`aviso_com_revisor`) e leva
    junto o `revisor` que o liga por padrao e o piso da similaridade da mesma geracao (`piso_sim`), que
    segue valendo onde o revisor nao chega (busca sem fonte)."""
    if med.get("veredito"):
        # veredito por conceito abstem pelo rotulo do conceito E pela similaridade; os dois ajustes juntos
        return [f"aviso_de_cobertura_fraca={piso}", "veredito_por_conceito=true"]
    if _medida_da_rodada(med.get("perguntas") or []) == "rerank":
        extra = [f"aviso_de_cobertura_fraca={piso_sim}"] if piso_sim is not None else []
        return [f"aviso_com_revisor={piso}", *extra, f"revisor={MODELO_DO_REVISOR}"]
    return [f"aviso_de_cobertura_fraca={piso}"]


def cmd_calibrar(inst, particao, argv):
    """`medir <particao> --calibrar <controle>[,<rodada>…] [--geracao <id>]`: escolhe o sinal de abstenção
    sobre as medições que a bateria já salvou (card #3264, 6c). Não chama a API.

    Os argumentos são os rótulos (`--rotulo`) das rodadas de UMA geração; o primeiro é o controle, a
    similaridade. A conta e a régua do dono estão em `bin/_motor/calibra.py`."""
    rotulos = [r for r in _valor(argv, "--calibrar", "medir").split(",") if r]
    if not rotulos:
        print("medir --calibrar: informe os rotulos das rodadas, a de controle (similaridade) primeiro:\n"
              "  motor rag medir biblioteca --calibrar nova-sim,nova-revisor,nova-veredito", file=sys.stderr)
        sys.exit(2)
    if len(set(rotulos)) != len(rotulos):
        print(f"medir --calibrar: rotulo repetido em {','.join(rotulos)}", file=sys.stderr)
        sys.exit(2)
    geracao = _valor(argv, "--geracao", "medir") if "--geracao" in argv else None
    d = dir_medicoes(inst)
    achadas = {}
    for nome in sorted((f for f in os.listdir(d) if f.endswith(".json")), reverse=True):
        if len(achadas) == len(rotulos):
            break
        try:
            with open(os.path.join(d, nome)) as f:
                m = json.load(f)
        except (OSError, ValueError):
            continue
        r = m.get("rotulo")
        if r not in rotulos or r in achadas or not m.get("perguntas"):
            continue
        if geracao is not None and m.get("geracao") != geracao:
            continue
        achadas[r] = m
    faltam = [r for r in rotulos if r not in achadas]
    if faltam:
        print(f"medir --calibrar: sem medicao salva (com `perguntas`) para: {', '.join(faltam)}\n"
              f"  em {d}. Rode a bateria antes: motor rag medir {particao} --k 8 --geracao <id> --rotulo <r>",
              file=sys.stderr)
        sys.exit(1)
    geracoes = {m.get("geracao") for m in achadas.values()}
    gabaritos = {m.get("gabarito") for m in achadas.values()}
    if len(geracoes) > 1 or len(gabaritos) > 1:
        print(f"medir --calibrar: as rodadas nao sao da mesma geracao e do mesmo gabarito "
              f"(geracoes {sorted(map(str, geracoes))}, gabaritos {sorted(map(str, gabaritos))}); "
              f"comparar populacoes diferentes e chamar a diferenca de sinal", file=sys.stderr)
        sys.exit(1)
    controle = rotulos[0]
    # na ordem em que o dono listou: no empate vence o primeiro (liste do mais barato ao mais caro)
    res = calibra.calibrar({r: achadas[r]["perguntas"] for r in rotulos}, controle)
    n_t2 = res["rodadas"][controle]["de_t2"]
    ctrl = res["rodadas"][controle]
    print(f"calibracao do sinal de abstencao | geracao {next(iter(geracoes)) or 'servindo'} | "
          f"controle {controle} | gabarito {next(iter(gabaritos))}")
    print(f"  orcamento de perda de T2 = {res['orcamento_t2']}/{n_t2} "
          f"(o que a similaridade paga no piso {res['piso_do_controle']}; T2 achadas na rodada)")
    if n_t2 and res["orcamento_t2"] * 5 > n_t2:
        print("  ATENCAO: o orcamento passa de 1/5 das T2 achadas. Com poucas T2 o minimo da similaridade degenera\n"
              "  em calar tudo e o vencedor abstem a vontade; confira a tabela antes de levar o numero ao dono.")
    print()
    print(f"  {'rodada':<22} {'sinal':<8} {'piso':>6} {'sem obra':>9} {'T2 perdidas':>12} {'com obra':>9}")
    for r in rotulos:
        x = res["rodadas"][r]
        sinal = ("veredito+" if achadas[r].get("veredito") else "") + (_medida_da_rodada(achadas[r]["perguntas"]) or "?")
        marca = "  (fora do orcamento)" if x.get("fora_do_orcamento") else ""
        print(f"  {r:<22} {sinal:<8} {x['piso']:>6} {x['neg_sem_obra']:>4}/{x['de_neg_sem_obra']:<4} "
              f"{x['t2_abstidas']:>5}/{x['de_t2']:<6} {x['neg_com_obra_abstidas']:>4}/{x['de_neg_com_obra']:<4}{marca}")
    curvas = {r: {"no_piso_da_geracao": calibra.no_piso_da_geracao(achadas[r]["perguntas"]),
                  "pontos": calibra.curva(achadas[r]["perguntas"])} for r in rotulos}
    if "--curva" in argv:
        print("\n  o custo de cada piso: o menor que abstem ao menos N das negativas sem obra, e as T2 achadas que ele cala")
        for r in rotulos:
            base = curvas[r]["no_piso_da_geracao"]
            print(f"  {r}: no piso que a geracao usou, sem obra {base['neg_sem_obra']}/{base['de_neg_sem_obra']} "
                  f"e T2 achadas caladas {base['t2_abstidas']}/{base['de_t2']}")
            for p in curvas[r]["pontos"]:
                print(f"      >= {p['abstem']:>2}/{p['de_neg_sem_obra']}  piso {p['piso']:<6}  cala T2 "
                      f"{p['t2_abstidas']}/{p['de_t2']}")
    print(f"\n  as negativas com obra (abster nelas e erro) saem a parte: {ctrl['de_neg_com_obra']} no gabarito, "
          f"a conta nao as soma as {ctrl['de_neg_sem_obra']}")
    saida = {"em": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "geracao": next(iter(geracoes)),
             "gabarito": None, "calibracao_do": next(iter(gabaritos)), "resultado": res, "curvas": curvas, "ajuste": None}
    if res["atinge_o_minimo"]:
        v = res["vencedora"]
        ajuste = _ajuste_do_vencedor(achadas[v], res["rodadas"][v]["piso"], ctrl["piso"])
        saida["ajuste"] = ajuste
        print(f"\n  VENCE: {v} com {res['rodadas'][v]['neg_sem_obra']}/{res['rodadas'][v]['de_neg_sem_obra']} "
              f"(minimo {res['minimo']}) sem perder positiva T2 alem do controle.\n"
              f"  para virar: trocar --virar <id> --apply --confirma g<N> --sim \"<texto do dono>\" "
              + " ".join(f"--ajuste {a}" for a in ajuste))
    else:
        melhor = res["vencedora"]
        n = res["rodadas"][melhor]["neg_sem_obra"] if melhor else 0
        print(f"\n  NENHUM SINAL ATINGE {res['minimo']}/{ctrl['de_neg_sem_obra']} (melhor: {melhor or '-'} com {n}): "
              f"a particao NAO vira (arq:0121 §7.3) e o numero vai ao dono.")
    arq = os.path.join(d, time.strftime("%Y%m%dT%H%M%S") + "-calibracao.json")
    with open(arq, "w") as f:
        json.dump(saida, f, ensure_ascii=False, indent=1)
    print(f"\n  salvo em {arq}")
    sys.exit(0 if res["atinge_o_minimo"] else 4)


# ---------------------------------------------------------------- braco-sombra do embedder
# Guia escolha-de-llm §11 e spec motor §2a: braco-sombra so para bench, fora de servico. E a
# unica medida deste verbo que NAO passa pela porta servida, e por desenho: o candidato nao esta
# no ar. O que roda e bin/_motor/sombra.py, copiado para dentro do conteiner do rag e lancado em
# segundo plano, num venv que herda o torch da imagem; nada do servido e escrito.
SOMBRA_SCRIPT = str(_ARVORE / "bin" / "_motor" / "sombra.py")


def _valor(argv, flag, ato):
    i = argv.index(flag)
    if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
        print(f"{ato}: a flag {flag} exige um valor.", file=sys.stderr)
        sys.exit(2)
    return argv[i + 1]


def cmd_sombra(inst, particao, argv):
    modelos = [m for m in _valor(argv, "--sombra", "medir").split(",") if m]
    particoes = ([p for p in _valor(argv, "--particoes", "medir").split(",") if p]
                 if "--particoes" in argv else [particao])
    for p in particoes:
        if p not in ("biblioteca", "casa"):
            print(f"medir --sombra: particao {p!r} sem indice vetorial servido (biblioteca, casa)",
                  file=sys.stderr)
            sys.exit(2)
    k = int(_valor(argv, "--k", "medir")) if "--k" in argv else 8
    n = int(_valor(argv, "--perguntas", "medir")) if "--perguntas" in argv else 1000
    c = inst.get("container")
    gab = na_release(inst.get("gabarito", ""))
    if not c or not gab or not os.path.isfile(gab):
        print(f"medir --sombra: falta conteiner ({c}) ou gabarito ({gab})", file=sys.stderr)
        sys.exit(1)
    sid = time.strftime("%Y%m%dT%H%M%S")
    dentro = f"/tmp/sombra-{sid}"
    args = {"id": sid, "saida": dentro, "modelos": modelos, "particoes": particoes, "k": k,
            "max_perguntas": n, "gabarito": f"{dentro}/gabarito.jsonl"}
    for passo in (f"docker exec {c} mkdir -p {dentro}",
                  f"docker cp {shlex.quote(SOMBRA_SCRIPT)} {c}:{dentro}/sombra.py",
                  f"docker cp {shlex.quote(gab)} {c}:{dentro}/gabarito.jsonl"):
        r = sh(passo)
        if r.returncode != 0:
            print(f"medir --sombra: falhou `{passo}`: {r.stderr.strip()[-300:]}", file=sys.stderr)
            sys.exit(3)
    corpo = (f"cd {dentro} && (python -m venv --system-site-packages venv && "
             f"venv/bin/pip install -q -U 'transformers>=5.2' 'sentence-transformers>=5.4.1') "
             f"> pip.log 2>&1; PY=venv/bin/python; [ -x $PY ] || PY=python; "
             f"PYTHONPATH=/app HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 $PY sombra.py >> log.txt 2>&1; "
             f"echo $? > fim")
    r = sh(f"docker exec -d -e SOMBRA_ARGS={shlex.quote(json.dumps(args))} {c} sh -c {shlex.quote(corpo)}")
    if r.returncode != 0:
        print(f"medir --sombra: nao lancou: {r.stderr.strip()[-300:]}", file=sys.stderr)
        sys.exit(3)
    print(f"sombra {sid} lancada em {c} (fora do servido): {', '.join(modelos)} | "
          f"particoes {', '.join(particoes)} | k={k} | ate {n} perguntas do log\n"
          f"  acompanhe: motor rag medir {particao} --sombra-ver {sid}")


def cmd_sombra_ver(inst, sid):
    if not re.fullmatch(r"\d{8}T\d{6}", sid or ""):
        print(f"medir --sombra-ver: id invalido {sid!r} (forma AAAAMMDDTHHMMSS)", file=sys.stderr)
        sys.exit(2)
    c = inst.get("container")
    dentro = f"/tmp/sombra-{sid}"
    estado = sh(f"docker exec {c} sh -c " + shlex.quote(
        f"tail -n 12 {dentro}/log.txt 2>/dev/null; echo '--- pip:'; tail -n 3 {dentro}/pip.log "
        f"2>/dev/null; echo '--- fim:'; cat {dentro}/fim 2>/dev/null || echo rodando"))
    if estado.returncode != 0:
        print(f"medir --sombra-ver: {estado.stderr.strip()[-300:]}", file=sys.stderr)
        sys.exit(1)
    print(estado.stdout.rstrip())
    r = sh(f"docker exec {c} cat {dentro}/resultado.json")
    if r.returncode != 0:
        return
    res = json.loads(r.stdout)
    arq = os.path.join(dir_medicoes(inst), f"{sid}-sombra.json")
    with open(arq, "w") as f:
        json.dump(res, f, ensure_ascii=False, indent=1)
    _resumo_sombra(res)
    print(f"\n  salvo em {arq}")


def cmd_sombra_parar(inst, sid):
    """Encerra a sombra <sid> dentro do conteiner. A imagem nao tem procps: varre /proc em Python
    e manda SIGTERM a todo processo cuja linha de comando cita /tmp/sombra-<sid>/."""
    if not re.fullmatch(r"\d{8}T\d{6}", sid or ""):
        print(f"medir --sombra-parar: id invalido {sid!r} (forma AAAAMMDDTHHMMSS)", file=sys.stderr)
        sys.exit(2)
    c = inst.get("container")
    alvo = f"/tmp/sombra-{sid}/"
    py = ("import os,signal\n"
          "n=0\n"
          "for p in os.listdir('/proc'):\n"
          "    if not p.isdigit() or int(p)==os.getpid(): continue\n"
          "    try: cmd=open('/proc/'+p+'/cmdline','rb').read().decode(errors='ignore')\n"
          "    except OSError: continue\n"
          f"    if {alvo!r} in cmd or 'sombra-{sid}' in cmd:\n"
          "        os.kill(int(p),signal.SIGTERM); n+=1\n"
          "print(n)\n")
    r = sh(f"docker exec -i {c} python3 -", input=py)
    if r.returncode != 0:
        print(f"medir --sombra-parar: {r.stderr.strip()[-300:]}", file=sys.stderr)
        sys.exit(3)
    n = r.stdout.strip() or "0"
    print(f"sombra {sid}: {n} processo(s) encerrado(s)" if n != "0"
          else f"sombra {sid}: nada rodando")


def _resumo_sombra(res):
    k = res.get("k")
    print(f"\nsombra {res['id']} | corpus {res.get('corpus')} | perguntas {res.get('perguntas')}")
    for nome, info in res.get("modelos", {}).items():
        if "erro" in info:
            print(f"  ERRO {nome}: {info['erro']}")
    if res.get("gabarito"):
        print(f"\n  gabarito (biblioteca, braco de significado isolado, k={k})")
        print(f"  {'variante':<34} {'cod h@1':>7} {'cod mrr':>7} {'sen h@1':>7} {'sen h@5':>7} {'sen mrr':>7} {'abst erro':>9} {'piso':>6}")
        for v, g in res["gabarito"].items():
            a = g.get("abstencao") or {}
            print(f"  {v:<34} {g['codigo']['hit@1']:>7} {g['codigo']['mrr']:>7} {g['sentido']['hit@1']:>7} "
                  f"{g['sentido']['hit@5']:>7} {g['sentido']['mrr']:>7} {a.get('erro', '-'):>9} {a.get('piso', '-'):>6}")
    for p, tab in (res.get("replay") or {}).items():
        print(f"\n  replay do log em {p} (juiz {res.get('juiz', {}).get('modelo')}, nDCG@{k})")
        print(f"  {'variante':<34} {'nDCG':>7} {'V':>5} {'E':>5} {'D':>5} {'jacc':>6}")
        for v, t in tab.items():
            print(f"  {v:<34} {t['ndcg_medio']:>7} {t['vitorias']:>5} {t['empates']:>5} {t['derrotas']:>5} {t['jaccard_com_servido']:>6}")
    conc = (res.get("juiz") or {}).get("concordancia_com_gabarito") or {}
    for v, cc in conc.items():
        print(f"  juiz x gabarito ({v}): {cc['concordam']}/{cc['comparaveis']} = {cc['taxa']}")


def _psql_json(banco, sql):
    """Roda `sql` (uma consulta que devolve um JSON numa linha) no banco declarado do registro."""
    r = sh(f"docker exec -i {banco['container']} psql -U {banco['user']} -d {banco['db']} -At -v ON_ERROR_STOP=1",
           input=sql)
    if r.returncode != 0:
        print(f"motor: banco {banco['container']} nao respondeu: {r.stderr.strip()[-300:]}", file=sys.stderr)
        sys.exit(3)
    return json.loads(r.stdout.strip() or "null")


def _lit(v):
    return "'" + str(v).replace("'", "''") + "'"


SORTEAR_OPCOES = {"--semente": 1, "--ate": 1, "--saida": 1, "--aceitar-sem-ordem": 0,
                  "--aceitar-sem-cadeira": 0, "--apply": 0, "--json": 0}


def cmd_sortear(inst, argv):
    """`sortear biblioteca`: o estrato sentido da escada, sorteado do log de perguntas (card #3349;
    padrao protocolo-medicao-rag, «Fonte e filtros»). Sem --apply e so o plano: o que entrou, o que
    saiu por motivo e as 20 do piloto. Com --apply --saida grava a lista e a gabarito_versao."""
    particao, resto = resolve_particao(argv, "sortear")
    if particao != "biblioteca":
        print("motor sortear: so a biblioteca tem estrato sentido (a casa tem ate 30 perguntas, sem sorteio estratificado)",
              file=sys.stderr)
        sys.exit(2)
    op, i = {}, 0
    while i < len(resto):
        n = SORTEAR_OPCOES.get(resto[i])
        if n is None:
            print(f"motor sortear: argumento desconhecido {resto[i]!r}. Aceita: {' '.join(SORTEAR_OPCOES)}", file=sys.stderr)
            sys.exit(2)
        op[resto[i]] = resto[i + 1] if n and i + 1 < len(resto) else True
        if n and i + 1 >= len(resto):
            print(f"motor sortear: {resto[i]} pede um valor", file=sys.stderr)
            sys.exit(2)
        i += 1 + n
    if op.get("--apply") and not op.get("--saida"):
        print("motor sortear: --apply pede --saida <arquivo.jsonl> (o arquivo que vai ao git)", file=sys.stderr)
        sys.exit(2)
    semente = op.get("--semente", "escada-sentido-v1")
    b, bancos = inst.get("banco") or {}, inst.get("bancos") or {}
    if not b or "sessao" not in bancos or "motor" not in bancos:
        print("motor sortear: a instancia nao declara banco e bancos.sessao/motor em motor-instancias.json", file=sys.stderr)
        sys.exit(1)
    eventos = _psql_json(b, (
        "SELECT coalesce(json_agg(t ORDER BY t.criado_em, t.id), '[]'::json) FROM ("
        "SELECT e.id::text AS id, e.ordem_id, e.pergunta, e.particao, e.origem, e.sessao_id, "
        "e.criado_em::text AS criado_em, EXISTS (SELECT 1 FROM acervo.evento_secao s "
        "JOIN acervo.impressao i ON i.id = s.impressao_id WHERE s.evento_id = e.id) AS secao_em_impressao "
        "FROM acervo.evento_recuperacao e WHERE e.disparou) t"))
    ate = op.get("--ate") or max((e["criado_em"] for e in eventos), default="")
    eventos = [e for e in eventos if e["criado_em"] <= ate]
    ids = sorted({e["sessao_id"] for e in eventos if sorteio.e_uuid(e.get("sessao_id"))})
    cadeiras = {}
    if ids:
        linhas = _psql_json(bancos["sessao"], (
            "SELECT coalesce(json_agg(json_build_object('sessao_id', sessao_id::text, 'cadeira', cadeira)), '[]'::json) "
            "FROM sessao.sessao WHERE sessao_id::text IN (" + ",".join(_lit(x) for x in ids) + ")"))
        cadeiras = {x["sessao_id"]: x["cadeira"] for x in linhas}
    fora = {sorteio.normalizar(e["pergunta"]) for e in eventos if e.get("origem") in sorteio.ORIGENS_FORA}
    gab = na_release(inst.get("gabarito", ""))
    if gab and os.path.isfile(gab):
        with open(gab, encoding="utf-8") as f:
            fora |= {sorteio.normalizar(json.loads(l).get("pergunta", "")) for l in f if l.strip()}
    cand, excluidas = sorteio.filtrar(
        eventos, cadeiras, fora, aceitar_sem_ordem=bool(op.get("--aceitar-sem-ordem")),
        aceitar_sem_cadeira=bool(op.get("--aceitar-sem-cadeira")))
    sentido, pequenas = sorteio.separar_estratos(cand, excluidas)
    lista = sorteio.sortear(sentido, semente)
    flags = {"aceitar_sem_ordem": bool(op.get("--aceitar-sem-ordem")),
             "aceitar_sem_cadeira": bool(op.get("--aceitar-sem-cadeira")), "ate": ate}
    rel = sorteio.relatorio(len(eventos), cand, excluidas, sentido, pequenas, lista, semente, flags)
    conteudo = sorteio.linhas_jsonl(lista)
    rel["sha_git"] = sorteio.sha_blob_git(conteudo)
    if op.get("--json"):
        print(json.dumps({**rel, "lista": [{k: c[k] for k in ("posicao", "papel", "id", "cadeira", "estrato", "pergunta")}
                                           for c in lista]}, ensure_ascii=False, indent=1))
    else:
        print(f"sorteio {semente} · {rel['eventos_lidos']} eventos do log ate {ate[:19]} · {rel['candidatos']} candidatos · "
              f"{rel['sentido']} no estrato sentido · {rel['sorteadas']} sorteadas "
              f"({rel['principal']} principais, {rel['reserva']} de reserva; piloto {rel['piloto']})")
        if rel["sorteadas"] < sorteio.PRINCIPAL + sorteio.RESERVA:
            print(f"POOL ABAIXO DE {sorteio.PRINCIPAL + sorteio.RESERVA}: {rel['sentido']} perguntas no estrato sentido")
        print("excluidas por motivo:")
        for motivo, n in rel["excluidas"].items():
            print(f"  {n:>5}  {motivo}")
        print("cadeiras no estrato sentido: " + (", ".join(f"{k} {v}" for k, v in rel["por_cadeira_no_pool"].items()) or "-"))
        if pequenas:
            print("cadeiras fora por ter menos de cinco: " + ", ".join(pequenas))
        print(f"piloto (as {rel['piloto']} primeiras da ordem; o estrato e proposta da maquina, quem confirma e o dono):")
        for c in lista[: sorteio.PILOTO]:
            print(f"  {c['posicao']:>2}. [{c['cadeira']}] ({c['estrato']}) {c['pergunta']}")
    if not op.get("--apply"):
        if not op.get("--json"):
            print("plano: nada gravado. Para valer: o mesmo comando com --apply --saida <arquivo.jsonl>")
        return
    if not lista:
        print("motor sortear: nada sorteado; nao ha o que gravar", file=sys.stderr)
        sys.exit(1)
    with open(op["--saida"], "wb") as f:
        f.write(conteudo)
    facets = http(inst["facets"], token_da(inst), timeout=30)
    sha_acervo = ((facets or {}).get("indice") or {}).get("acervo_sha")
    if not sha_acervo:
        print("motor sortear: /facets nao trouxe indice.acervo_sha; sem ele a versao nao se data", file=sys.stderr)
        sys.exit(3)
    nota = json.dumps({"fita": "#3349", "semente": semente, "flags": flags, "sorteadas": rel["sorteadas"],
                       "excluidas": rel["excluidas"]}, ensure_ascii=False, sort_keys=True)
    existente = _psql_json(bancos["motor"], (
        "SELECT coalesce((SELECT json_build_object('id', id::text) FROM avaliacao.gabarito_versao "
        f"WHERE sha_git = {_lit(rel['sha_git'])} AND sha_acervo = {_lit(sha_acervo)}), 'null'::json)"))
    if existente:
        print(f"ja existe: gabarito_versao {existente['id']} (sha_git {rel['sha_git'][:12]}, sha_acervo {sha_acervo[:12]}); "
              f"{op['--saida']} regravado com o mesmo conteudo")
        return
    novo = _psql_json(bancos["motor"], (
        "WITH ins AS (INSERT INTO avaliacao.gabarito_versao (sha_git, sha_acervo, nota) VALUES "
        f"({_lit(rel['sha_git'])}, {_lit(sha_acervo)}, {_lit(nota)}) RETURNING id) "
        "SELECT json_build_object('id', id::text) FROM ins"))
    print(f"gabarito_versao {novo['id']} gravada (sha_git {rel['sha_git'][:12]}, sha_acervo {sha_acervo[:12]}); "
          f"lista em {op['--saida']}: {len(lista)} perguntas. Comite o arquivo como avaliacao/escada-sentido-v1.jsonl.")


# O braco lexical puro roda DENTRO do conteiner do rag (molde da sombra): `candidatos_lexicais` so existe la.
# O script entra por stdin; a pergunta e a seccao saem em JSON na ultima linha. Nao escreve em banco nenhum.
ESCRITOR_LEXICO = '''
import json, os, re
from types import SimpleNamespace
from motor_acervo.config.settings import load_settings
from motor_acervo.store.db import get_conn
from motor_acervo.store import acervo_store as acs
A = json.loads(os.environ["LEX_ARGS"])
st = load_settings()
conn = get_conn(st)
conn.autocommit = True
esc = SimpleNamespace(particao="obra", dominios=[], subdominios=[], serve_a=[], colecoes=[])
imp = [str(r[0]) for r in conn.execute("SELECT i.id FROM acervo.impressao i JOIN acervo.obra o ON o.id = i.obra_id "
                                       "WHERE i.estado = 'servindo' AND o.retirada_em IS NULL").fetchall()]
PARADAS = set("a o as os um uma de da do das dos em no na nos nas por para com que se e ou ao aos the and of to in for with is are on at by an or as it be this that from".split())
SQL_SECAO = ("SELECT t.id::text, s.id::text, s.ancora, s.titulo, s.hierarquia, o.titulo "
             "FROM acervo.trecho t JOIN acervo.secao s ON s.id = t.secao_id "
             "JOIN acervo.impressao i ON i.id = t.impressao_id JOIN acervo.obra o ON o.id = i.obra_id "
             "WHERE t.id = ANY(%s::uuid[])")
SQL_OU = ("SELECT t.id::text FROM acervo.trecho t WHERE t.elegivel AND t.impressao_id = ANY(%(imp)s::uuid[]) "
          "AND t.texto_tsv @@ to_tsquery('simple', %(q)s) "
          "ORDER BY ts_rank(t.texto_tsv, to_tsquery('simple', %(q)s)) DESC LIMIT %(n)s")


def secoes_de(ids, secs, vistas):
    if not ids:
        return
    por_trecho = {r[0]: r for r in conn.execute(SQL_SECAO, (ids,)).fetchall()}
    for tid in ids:
        r = por_trecho.get(str(tid))
        if not r or r[1] in vistas:
            continue
        vistas.add(r[1])
        textos = [x[0] for x in conn.execute(
            "SELECT texto FROM acervo.trecho WHERE secao_id = %s::uuid AND elegivel ORDER BY ordem_leitura", (r[1],)).fetchall()]
        hier = [h for h in (r[4] or []) if h] or ([r[3]] if r[3] else [])
        secs.append({"chave": r[1], "secao_id": r[1], "section_id": r[2],
                     "titulo": r[5] + (" › " + " › ".join(hier) if hier else ""),
                     "texto": "\\n\\n".join(textos)[:A["max_chars"]]})
        if len(secs) == A["k"]:
            return


out = {}
for pid, q in A["itens"]:
    secs, vistas, modo = [], set(), "and"
    # o braco lexical do servido: AND de todos os termos (plainto_tsquery), so impressao servindo
    secoes_de(acs.candidatos_lexicais(conn, esc, q[:500], A["pool"], impressoes=imp), secs, vistas)
    if len(secs) < A["k"]:
        # pergunta de palavras-chave raramente casa por AND: completa com OR ranqueado (ts_rank), declarado no carimbo
        termos = list(dict.fromkeys(t for t in re.findall(r"\\w{3,}", q.lower()[:500]) if t not in PARADAS))
        if termos:
            antes = len(secs)
            ou = [r[0] for r in conn.execute(SQL_OU, {"imp": imp, "q": " | ".join(termos), "n": A["pool"] * 2}).fetchall()]
            secoes_de(ou, secs, vistas)
            modo = "or" if antes == 0 else "and+or" if len(secs) > antes else "and"
        elif not secs:
            modo = "vazio"
    if not secs:
        modo = "vazio"
    out[pid] = {"secoes": secs, "modo": modo}
print(json.dumps(out, ensure_ascii=False))
'''

ESCREVER_OPCOES = {"--lista": 1, "--versao": 1, "--criterio-versao": 1, "--recusar": 1, "--perguntas": 1,
                   "--terceiro-braco": 1, "--lote-id": 1, "--saida": 1, "--tempo": 1, "--ativar": 0, "--plano": 0}


def _salva_estado(arq, estado):
    _grava_atomico(arq, json.dumps(estado, ensure_ascii=False))


def _gerar_ollama(mensagens, tentativa):
    base = os.environ.get("OLLAMA_BASE_URL", "http://127.0.0.1:11434").rstrip("/")
    corpo = {"model": escritor.MODELO, "messages": mensagens, "stream": False, "think": False, "format": "json",
             "options": {"temperature": escritor.TEMPERATURA, "seed": escritor.SEMENTE_GERACAO + tentativa,
                         "num_predict": 1500, "num_ctx": 16384}}
    req = urllib.request.Request(base + "/api/chat", data=json.dumps(corpo).encode(),
                                 headers={"Content-Type": "application/json"})
    t0 = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            j = json.loads(r.read().decode())
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, OSError) as e:
        print(f"motor escrever: o ollama nao respondeu em {base} ({type(e).__name__}); infra cache vram", file=sys.stderr)
        sys.exit(3)
    return {"texto": (j.get("message") or {}).get("content", ""), "tokens_prompt": j.get("prompt_eval_count", 0),
            "tokens_saida": j.get("eval_count", 0), "segundos": time.monotonic() - t0}


def _recupera_servido(inst, tok, pergunta, bracos=None, extra=None):
    corpo = {"particao": "biblioteca", "pergunta": pergunta, "k": escritor.K, "texto": "secao", "origem": "bench"}
    if bracos:
        corpo["bracos"] = bracos
    if extra:
        corpo.update(extra)      # `parear --do-log`: o braco eleito soma `chapeu` e `eleicao_chapeu` (card #3378)
    return http(inst["endpoint"], tok, corpo, timeout=120)


def _recupera_lexico(inst, itens):
    c = inst.get("container")
    args = json.dumps({"itens": itens, "k": escritor.K, "pool": 50, "max_chars": 6000}, ensure_ascii=False)
    r = sh(f"docker exec -i -e PYTHONPATH=/app -e LEX_ARGS={shlex.quote(args)} {c} python -", input=ESCRITOR_LEXICO)
    if r.returncode != 0:
        print(f"motor escrever: o braco lexical falhou no conteiner {c}: {r.stderr.strip()[-400:]}", file=sys.stderr)
        sys.exit(3)
    return json.loads(r.stdout.strip().splitlines()[-1])


def cmd_escrever(d, inst, argv):
    """`escrever biblioteca`: as respostas do piloto da escada (card #3349; padrao protocolo-medicao-rag, «Unidade da
    marca»). Recupera o top-8 nos tres bracos, escreve cada resposta com o mesmo modelo, prompt e semente, e monta o
    envelope do lote (`--saida`) que `motor marcacao lote gravar` manda. O estado fica em arquivo: a redacao passa do
    prazo de uma chamada e a mesma chamada retoma de onde parou."""
    particao, resto = resolve_particao(argv, "escrever")
    if particao != "biblioteca":
        print("motor escrever: so a biblioteca tem estrato sentido", file=sys.stderr)
        sys.exit(2)
    op, i = {}, 0
    while i < len(resto):
        n = ESCREVER_OPCOES.get(resto[i])
        if n is None or (n and i + 1 >= len(resto)):
            print(f"motor escrever: argumento invalido {resto[i]!r}. Aceita: {' '.join(ESCREVER_OPCOES)}", file=sys.stderr)
            sys.exit(2)
        op[resto[i]] = resto[i + 1] if n else True
        i += 1 + n
    if not op.get("--plano") and not (op.get("--saida") and op.get("--versao") and op.get("--criterio-versao")):
        print("motor escrever: pede --saida <envelope.json> --versao <gabarito_versao_id> --criterio-versao <v> "
              "(ou --plano, so a recuperacao)", file=sys.stderr)
        sys.exit(2)
    lista = op.get("--lista") or na_release("platafirma-harness/avaliacao/escada-sentido-v1.jsonl")
    if not lista or not os.path.isfile(lista):
        print(f"motor escrever: lista do sorteio nao encontrada ({lista}); passe --lista <arquivo.jsonl>", file=sys.stderr)
        sys.exit(1)
    with open(lista, "rb") as f:
        bruto = f.read()
    linhas = [json.loads(l) for l in bruto.decode().splitlines() if l.strip()]
    recusadas = {x for x in (op.get("--recusar") or "").split(",") if x}
    piloto = escritor.escolher_piloto(linhas, recusadas, sum(1 for l in linhas if l["papel"] == "piloto"))
    if op.get("--perguntas"):
        piloto = piloto[: int(op["--perguntas"])]
    if not piloto:
        print("motor escrever: nenhuma pergunta no piloto", file=sys.stderr)
        sys.exit(1)
    tok = token_da(inst)
    lote_id = op.get("--lote-id") or time.strftime("piloto-fita1-%Y%m%dT%H%M", time.gmtime())
    arq_estado = os.path.join(dir_medicoes(inst), f"escritor-{lote_id}.json")
    os.makedirs(os.path.dirname(arq_estado), exist_ok=True)
    if os.path.isfile(arq_estado):
        with open(arq_estado) as f:
            est = json.load(f)
        if est["perguntas"] != [p["id"] for p in piloto]:
            print(f"motor escrever: o estado {arq_estado} e de outro conjunto de perguntas; use outro --lote-id", file=sys.stderr)
            sys.exit(2)
    else:
        est = escritor.novo_estado(lote_id, [p["id"] for p in piloto], "", "")
    por_id = {p["id"]: p for p in piloto}

    # --- terceiro braco -------------------------------------------------------------------------------------
    if not est["terceiro_braco"]:
        pedido = op.get("--terceiro-braco", "auto")
        if pedido in ("revisor", "expansao", "nenhum"):
            est["terceiro_braco"], est["terceiro_motivo"] = pedido, "pedido na chamada"
        elif pedido == "auto":
            amostras = []
            for p in piloto[:5]:
                serv = _recupera_servido(inst, tok, p["pergunta"])
                rev = _recupera_servido(inst, tok, p["pergunta"], ["rerank"])
                amostras.append((escritor.secoes_do_servido(serv), escritor.secoes_do_servido(rev),
                                 (rev.get("tempos_ms") or {}).get("rerank", 0)))
                est["recuperado"].setdefault(p["id"], {})["servido"] = amostras[-1][0]
                est["recuperado"][p["id"]]["revisor"] = amostras[-1][1]
            est["terceiro_braco"], est["terceiro_motivo"] = escritor.decidir_terceiro_braco(amostras)
        else:
            print("motor escrever: --terceiro-braco aceita auto|revisor|expansao|nenhum", file=sys.stderr)
            sys.exit(2)
        _salva_estado(arq_estado, est)
    terceiro = est["terceiro_braco"]
    bracos_busca = ["rerank"] if terceiro == "revisor" else ["expansao"]

    # --- recuperacao ----------------------------------------------------------------------------------------
    faltam_lex = []
    for p in piloto:
        rec = est["recuperado"].setdefault(p["id"], {})
        if "servido" not in rec:
            rec["servido"] = escritor.secoes_do_servido(_recupera_servido(inst, tok, p["pergunta"]))
        if terceiro != "nenhum" and "terceiro" not in rec:
            rec["terceiro"] = rec.pop("revisor", None) if terceiro == "revisor" and "revisor" in rec else \
                escritor.secoes_do_servido(_recupera_servido(inst, tok, p["pergunta"], bracos_busca))
        if "lexico" not in rec:
            faltam_lex.append([p["id"], p["pergunta"]])
    if faltam_lex:
        lex = _recupera_lexico(inst, faltam_lex)
        for pid, r in lex.items():
            est["recuperado"][pid]["lexico"] = r["secoes"]
            est.setdefault("lexico_modo", {})[pid] = r["modo"]
    _salva_estado(arq_estado, est)
    modos = dict(sorted(Counter(est.get("lexico_modo", {}).values()).items()))
    bracos_do_lote = ("servido", "lexico") + (() if terceiro == "nenhum" else ("terceiro",))
    sem = {b: sum(1 for p in piloto if not est["recuperado"][p["id"]][b]) for b in bracos_do_lote}
    rec_ = est["recuperado"]
    iguais = mesma_ordem = 0
    if terceiro != "nenhum":
        iguais = sum(1 for p in piloto if escritor.jaccard(rec_[p["id"]]["servido"], rec_[p["id"]]["terceiro"]) == 1.0)
        mesma_ordem = sum(1 for p in piloto if [s["chave"] for s in rec_[p["id"]]["servido"]] == [s["chave"] for s in rec_[p["id"]]["terceiro"]])
    print(f"lote {lote_id} · {len(piloto)} perguntas · terceiro braco: {terceiro} ({est['terceiro_motivo']}) · "
          f"top-8 do terceiro com o mesmo conjunto do servido em {iguais}/{len(piloto)} e na mesma ordem em {mesma_ordem}/{len(piloto)} · "
          f"sem nenhuma secao: {sem} · "
          f"lexico por modo: {modos}")
    if op.get("--plano"):
        print(f"estado em {arq_estado}; recuperacao feita, nada escrito")
        return

    # --- redacao (depois da recuperacao: o ollama e o Nemotron dividem a placa) ------------------------------
    limite = time.monotonic() + float(op.get("--tempo", 480))
    pendentes = [(p, b) for p in piloto for b in bracos_do_lote
                 if b not in est["geradas"].get(p["id"], {})]
    for p, b in pendentes:
        if time.monotonic() > limite:
            break
        est["geradas"].setdefault(p["id"], {})[b] = escritor.escrever_resposta(
            p["pergunta"], est["recuperado"][p["id"]][b], _gerar_ollama)
        _salva_estado(arq_estado, est)
    feitas = sum(len(v) for v in est["geradas"].values())
    total = len(bracos_do_lote) * len(piloto)
    if feitas < total:
        print(f"INCOMPLETO: {feitas}/{total} respostas escritas; repita o mesmo comando com --lote-id {lote_id}")
        sys.exit(1)

    # --- envelope --------------------------------------------------------------------------------------------
    facets = http(inst["facets"], tok, timeout=30) or {}
    env, _ = servido(inst)
    env = env or {}
    chaves = ("EMBED_MODEL", "EMBED_BACKEND", "EMBED_QUERY_INSTRUCTION", "RETRIEVAL_MODE", "HYBRID_LEXICAL", "RRF_K",
              "RERANK_MODEL", "RERANK_POOL", "RERANK_BLEND", "CHUNK_TOKEN_CEILING", "EXPANSAO_POR_CONCEITO")
    custo = {b: {"segundos": 0.0, "tokens_prompt": 0, "tokens_saida": 0, "respostas": 0}
             for b in ("servido", "lexico") + (() if terceiro == "nenhum" else (terceiro,))}
    for pid, por_braco in est["geradas"].items():
        for b, r in por_braco.items():
            c = custo[terceiro if b == "terceiro" else b]
            c["segundos"] = round(c["segundos"] + r["carimbo"]["segundos"], 2)
            c["tokens_prompt"] += r["carimbo"]["tokens_prompt"]
            c["tokens_saida"] += r["carimbo"]["tokens_saida"]
            c["respostas"] += 1
    vocab = next((v for k, v in sorted(facets.items()) if "vocab" in k.lower()), None) \
        or ((facets.get("indice") or {}).get("vocabulario_versao"))
    carimbo = {
        "acervo": {"acervo_sha": (facets.get("indice") or {}).get("acervo_sha"), "indice": facets.get("indice")},
        "motor": {"servido": {k: env.get(k) for k in chaves}, "k": escritor.K, "texto": "secao",
                  "terceiro_braco": terceiro, "terceiro_motivo": est["terceiro_motivo"], "lexico": "candidatos_lexicais (full-text, AND dos termos) e, se der menos de 8 secoes, OR ranqueado por ts_rank; "
                            "so impressao servindo", "lexico_modo_por_pergunta": modos},
        "vocabulario": {"versao": vocab or "nao declarada em /facets", "fonte": "/facets"},
        "gabarito": {"versao_id": op["--versao"], "sha_git": sorteio.sha_blob_git(bruto), "lista": "avaliacao/escada-sentido-v1.jsonl",
                     "recusadas": sorted(recusadas)},
        "escritor": {"modelo": escritor.MODELO, "prompt_versao": escritor.PROMPT_VERSAO, "prompt_sha256": escritor.prompt_sha256(),
                     "semente": escritor.SEMENTE_GERACAO, "temperatura": escritor.TEMPERATURA, "palavras": escritor.PALAVRAS,
                     "juiz": "a definir na fita 2 (modelo de outra familia que o escritor)"},
        "custo": custo,
    }
    resultados = {pid: {"servido": g["servido"], "lexico": g["lexico"], "terceiro": g.get("terceiro")} for pid, g in est["geradas"].items()}
    envelope = escritor.montar_lote(lote_id, op["--versao"], op["--criterio-versao"], piloto, resultados, terceiro, carimbo,
                                    str(escritor.SEMENTE_GERACAO), bool(op.get("--ativar")))
    problemas = escritor.conferir_aceite(envelope, len(piloto), len(bracos_do_lote))
    _grava_atomico(op["--saida"], json.dumps(envelope, ensure_ascii=False))
    print(f"envelope em {op['--saida']}: {len(envelope['corpo']['perguntas'])} perguntas, {len(envelope['respostas'])} respostas")
    for b, c in custo.items():
        m = max(c["respostas"], 1)
        print(f"  {b:<9} {c['respostas']} respostas · {c['segundos'] / m:.1f} s e {c['tokens_saida'] / m:.0f} tokens de saida por resposta "
              f"(prompt {c['tokens_prompt'] / m:.0f})")
    if problemas:
        print("FORA DO ACEITE:")
        for pr in problemas:
            print(f"  - {pr}")
        sys.exit(1)
    print(f"aceite: {len(piloto)} perguntas e {len(bracos_do_lote) * len(piloto)} respostas, toda resposta com secao no rodape, "
          "toda afirmacao com secao no mapa, carimbo com as cinco versoes")
    print(f"gravar: motor marcacao lote gravar {op['--saida']}{' --ativar' if not op.get('--ativar') else ''}")


# O texto das secoes sai de DENTRO do conteiner do rag (molde do braco lexico); a geracao do juiz roda no host
# (`_gerar_claude_host`). O script nao escreve em banco.
JUIZ_TEXTOS = '''
import json, os
from motor_acervo.config.settings import load_settings
from motor_acervo.store.db import get_conn
A = json.loads(os.environ["JUIZ_ARGS"])
conn = get_conn(load_settings())
out = {}
for sid in A["ids"]:
    textos = [r[0] for r in conn.execute(
        "SELECT texto FROM acervo.trecho WHERE secao_id = %s::uuid AND elegivel ORDER BY ordem_leitura", (sid,)).fetchall()]
    out[sid] = "\\n\\n".join(textos)[:A["max_chars"]]
print(json.dumps(out, ensure_ascii=False))
'''

def _gerar_claude_host(sistema, usuario, modelo):
    """Uma geração do juiz pelo `claude` do host (o contêiner do rag não tem o CLI e a casa não tem chave de API,
    decisão do dono de 24/07). Molde: tooling/rodar-firmabot-claude.py — processo novo por chamada, sem ferramentas,
    sem sessão salva, em diretório neutro para não carregar o CLAUDE.md de um repositório."""
    import shutil, tempfile
    exe = shutil.which("claude") or next((p for p in (os.path.expanduser("~/.local/bin/claude"),
                                                       os.path.expanduser("~/.claude/local/claude")) if os.path.isfile(p)), None)
    if not exe:
        print("motor julgar: o `claude` nao esta no PATH do host nem em ~/.local/bin", file=sys.stderr)
        sys.exit(3)
    t0 = time.monotonic()
    try:
        r = subprocess.run([exe, "-p", "--system-prompt", sistema, "--tools", "", "--no-session-persistence",
                            "--model", modelo, "--output-format", "json", usuario],
                           capture_output=True, text=True, timeout=600, cwd=tempfile.gettempdir())
    except subprocess.TimeoutExpired:
        return {"texto": "", "modelo": modelo, "provider": "claude_cli_host", "segundos": round(time.monotonic() - t0, 2)}
    if r.returncode != 0:
        print(f"motor julgar: claude -p falhou (rc={r.returncode}): {(r.stderr or r.stdout).strip()[-400:]}", file=sys.stderr)
        sys.exit(3)
    try:
        j = json.loads(r.stdout)
    except ValueError:
        j = {"result": r.stdout}
    # o CLI pode somar um modelo auxiliar no modelUsage; o do juiz e o que casa com o pedido
    usados = [m for m in (j.get("modelUsage") or {}) if modelo.lower() in m.lower()]
    return {"texto": j.get("result") or "", "modelo": usados[0] if len(usados) == 1 else modelo,
            "provider": "claude_cli_host", "segundos": round(time.monotonic() - t0, 2)}


JULGAR_OPCOES = {"--lote": 1, "--criterio": 1, "--tempo": 1, "--modelo": 1, "--kappa": 0, "--divergencias": 0, "--tempo-ativo": 0,
                 "--conferencia": 0, "--ativar": 0, "--json": 0, "--lote-conferencia": 1}


def _no_conteiner_rag(inst, script, args, timeout=900):
    c = inst.get("container")
    r = sh(f"docker exec -i -e PYTHONPATH=/app -e JUIZ_ARGS={shlex.quote(json.dumps(args, ensure_ascii=False))} {c} python -",
           input=script, timeout=timeout)
    if r.returncode != 0:
        print(f"motor julgar: falhou no conteiner {c}: {r.stderr.strip()[-600:]}", file=sys.stderr)
        sys.exit(3)
    return json.loads(r.stdout.strip().splitlines()[-1])


def _marcacao_da(d):
    mk = d.get("marcacao")
    if not mk:
        print("motor julgar: a instancia marcacao nao esta no registro", file=sys.stderr)
        sys.exit(3)
    return mk["endpoint"], token_da(mk)


def _chama_marcacao(base, tk, metodo, caminho, corpo=None):
    try:
        return marcacao.chamar(base, tk, metodo, caminho, corpo)
    except marcacao.Falha as f:
        print(f"motor julgar: marcacao-api: {f.msg}", file=sys.stderr)
        sys.exit(f.codigo)


def cmd_julgar(d, inst, argv):
    """`julgar biblioteca --lote <id>`: o juiz do piloto da escada (card #3350; padrao protocolo-medicao-rag, «O juiz»).
    Sem flag de leitura, julga cada resposta do lote pelo criterio que a tela mostrou ao dono e grava em
    avaliacao.juiz_marca; NUNCA le os eventos do dono. `--kappa`, `--divergencias`, `--tempo-ativo` e `--conferencia`
    so rodam com o juiz completo no banco, e so entao leem os eventos (a hora da primeira leitura fica no estado)."""
    particao, resto = resolve_particao(argv, "julgar")
    if particao != "biblioteca":
        print("motor julgar: so a biblioteca tem o piloto da escada", file=sys.stderr)
        sys.exit(2)
    op, i = {}, 0
    while i < len(resto):
        n = JULGAR_OPCOES.get(resto[i])
        if n is None or (n and i + 1 >= len(resto)):
            print(f"motor julgar: argumento invalido {resto[i]!r}. Aceita: {' '.join(JULGAR_OPCOES)}", file=sys.stderr)
            sys.exit(2)
        op[resto[i]] = resto[i + 1] if n else True
        i += 1 + n
    leituras = [f for f in ("--kappa", "--divergencias", "--tempo-ativo", "--conferencia") if op.get(f)]
    if not op.get("--lote") or len(leituras) > 1 or (op.get("--ativar") and not op.get("--conferencia")):
        print("motor julgar: pede --lote <id> e no maximo um de --kappa, --divergencias, --tempo-ativo, --conferencia "
              "(--ativar so com --conferencia)", file=sys.stderr)
        sys.exit(2)
    lote_id = op["--lote"]
    base, tk = _marcacao_da(d)
    lote = _chama_marcacao(base, tk, "GET", "/interno/lote/" + urllib.parse.quote(lote_id) + "?com_braco=1")
    if lote["passada"] != "primeira":
        print(f"motor julgar: o lote {lote_id} e de {lote['passada']}; o juiz marca a primeira passada", file=sys.stderr)
        sys.exit(2)
    arq_estado = os.path.join(dir_medicoes(inst), f"juiz-{lote_id}.json")
    os.makedirs(os.path.dirname(arq_estado), exist_ok=True)
    est = json.load(open(arq_estado)) if os.path.isfile(arq_estado) else {"lote_id": lote_id, "julgados": {}, "textos": {}}
    if not leituras:
        return _julgar(inst, op, lote, est, arq_estado, base, tk)

    # --- leituras: so com o juiz completo no banco ---------------------------------------------------------
    marcas_j = _chama_marcacao(base, tk, "GET", "/interno/juiz?lote_id=" + urllib.parse.quote(lote_id))["marcas"]
    if est.get("prompt_hash"):
        marcas_j = [m for m in marcas_j if m["prompt_hash"] == est["prompt_hash"]]
    juiz_por = {m["resposta_id"]: m for m in marcas_j}
    faltam = [r["resposta_id"] for r in lote["respostas"] if r["resposta_id"] not in juiz_por]
    if faltam:
        print(f"motor julgar: o juiz ainda nao marcou {len(faltam)} de {len(lote['respostas'])} respostas do lote; "
              f"rode `motor rag julgar biblioteca --lote {lote_id}` ate completar. Nada dos eventos do dono foi lido.",
              file=sys.stderr)
        sys.exit(1)
    ultima_juiz = max(marcas_j, key=lambda m: m["id"])["criado_em"]
    if not est.get("eventos_lidos_em"):
        est["eventos_lidos_em"] = time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime())
        _salva_estado(arq_estado, est)
    eventos = _chama_marcacao(base, tk, "GET", "/interno/eventos?lote_id=" + urllib.parse.quote(lote_id))["eventos"]
    dono = kappa.marcas_do_dono(eventos)
    fora = kappa.excluidas(eventos)
    jz = {rid: {"qualidade": m["qualidade"], "embasamento": m["embasamento"]} for rid, m in juiz_por.items()}
    from datetime import datetime
    ordem = {"ultima_marca_do_juiz": ultima_juiz, "primeira_leitura_dos_eventos": est["eventos_lidos_em"],
             "juiz_antes": datetime.fromisoformat(ultima_juiz) < datetime.fromisoformat(est["eventos_lidos_em"])}
    if op.get("--kappa"):
        c = kappa.concordancia(lote, dono, jz, fora)
        graus = tuple(c["por_grau"])
        c["matriz"] = kappa.matriz(lote, dono, jz, fora, graus)
        c["ordem"] = ordem
        c["repeticoes"] = sum(1 for m in dono.values() if m.get("marcas", 1) > 1)
        c["juiz"] = {"modelo": est.get("modelo"), "provider": est.get("provider"), "prompt_hash": est.get("prompt_hash"),
                     "prompt_versao": juiz.PROMPT_VERSAO, "criterio_versao": lote["criterio_versao"]}
        _grava_atomico(os.path.join(dir_medicoes(inst), f"kappa-{lote_id}.json"), json.dumps(c, ensure_ascii=False))
        if op.get("--json"):
            print(json.dumps(c, ensure_ascii=False, indent=1))
            return
        iv, e = c["intervalo"], c["enganosa"]
        k = "indefinido" if c["kappa"] is None else f"{c['kappa']:.2f}"
        faixa = "indefinido" if iv["baixo"] is None else f"{iv['baixo']:.2f} a {iv['alto']:.2f}"
        print(f"lote {lote_id} · {c['n_respostas']} respostas de {c['n_perguntas']} perguntas · juiz {c['juiz']['modelo']}")
        print(f"  kappa {k} · intervalo 95% {faixa} ({iv['reamostras']} reamostras por pergunta, {iv['indefinidas']} indefinidas)")
        print(f"  enganosa: o dono marcou {e['dono_marcou']}, o juiz acompanhou {e['juiz_acompanhou']} · "
              f"o juiz marcou {e['juiz_marcou']}, o dono confirmou {e['dono_confirmou']}")
        print("  por grau (dono / juiz / os dois): " + " · ".join(
            f"{g} {v['dono']}/{v['juiz']}/{v['os_dois']}" for g, v in c["por_grau"].items()))
        print("  linha = o grau que o dono deu; coluna = o que o juiz deu")
        print("  " + " " * 12 + "".join(f"{g:>12}" for g in graus))
        for a in graus:
            print("  " + f"{a:<12}" + "".join(f"{c['matriz'][a][b]:>12}" for b in graus))
        print(f"  fora: perguntas excluidas {c['perguntas_excluidas'] or 'nenhuma'} · sem marca do dono "
              f"{len(c['sem_marca_do_dono'])} · respostas marcadas mais de uma vez {c['repeticoes']} (vale a mais recente)")
        print(f"  ordem: ultima marca do juiz {ultima_juiz} · primeira leitura dos eventos {est['eventos_lidos_em']} · "
              f"{'juiz antes' if ordem['juiz_antes'] else 'FORA DA ORDEM'}")
        return
    divs = kappa.divergencias(lote, dono, jz, fora)
    if op.get("--divergencias"):
        if op.get("--json"):
            print(json.dumps(divs, ensure_ascii=False, indent=1))
            return
        print(f"lote {lote_id} · {len(divs)} divergencia(s) de grau, sem braco (embasamento fora, ordem do dono 09/10)")
        for n, x in enumerate(divs, 1):
            print(f"{n:>3}. {x['resposta_id']} · dono {x['dono']['qualidade']} · juiz {x['juiz']['qualidade']} · {x['pergunta'][:70]}")
        return
    if op.get("--tempo-ativo"):
        t = kappa.tempo(lote, dono, kappa.preferencias(eventos), fora)
        if op.get("--json"):
            print(json.dumps(t, ensure_ascii=False, indent=1))
            return
        for nome, v in (("por resposta", t["por_resposta"]), ("por pergunta", t["por_pergunta"])):
            print(f"{nome}: n {v['n']} · mediana {v['mediana']:.1f} s · p90 {v['p90']:.1f} s · total {v['total'] / 60:.1f} min")
        return
    # --conferencia
    conf_id = op.get("--lote-conferencia") or f"{lote_id}-conf"
    if not divs:
        print(f"motor julgar: nenhuma divergencia no lote {lote_id}; sem lote de conferencia")
        return
    env = kappa.lote_de_conferencia(lote, divs, conf_id, lambda: "re-" + os.urandom(6).hex(), f"{conf_id}/{len(divs)}")
    env["ativo"] = bool(op.get("--ativar"))
    r = _chama_marcacao(base, tk, "PUT", "/interno/lote", env)
    print(f"lote {r['lote_id']} gravado · passada conferencia · {r['perguntas']} perguntas · {r['respostas']} respostas "
          f"(= {len(divs)} divergencias) · {'ativo: a tela ja o serve' if r['ativo'] else 'inativo'}")


def _julgar(inst, op, lote, est, arq_estado, base, tk):
    crit_arq = op.get("--criterio") or na_release("platafirma-ui/app/marcacao/criterio.json")
    try:
        with open(crit_arq, encoding="utf-8") as f:
            criterio = json.load(f)
    except (OSError, ValueError) as e:
        print(f"motor julgar: criterio da tela nao lido ({crit_arq}): {e}", file=sys.stderr)
        sys.exit(3)
    if criterio.get("criterio_versao") != lote["criterio_versao"]:
        print(f"motor julgar: o criterio servido e {criterio.get('criterio_versao')}, o lote foi marcado em "
              f"{lote['criterio_versao']}; o juiz julga pelo criterio que o dono viu", file=sys.stderr)
        sys.exit(2)
    graus = juiz.graus_do_criterio(criterio)
    sistema = juiz.sistema(criterio)
    h = juiz.prompt_hash(sistema)
    if est.get("prompt_hash") and est["prompt_hash"] != h:
        print(f"motor julgar: o estado {arq_estado} e de outro prompt; o prompt do juiz nao muda no meio do lote", file=sys.stderr)
        sys.exit(2)
    est["prompt_hash"] = h
    perg = {p["pergunta_id"]: p for p in lote["corpo"]["perguntas"]}
    texto_resp = {r["resposta_id"]: r["texto"] for p in lote["corpo"]["perguntas"] for r in p["respostas"]}
    ids = sorted({s.get("secao_id") or s["chave"] for r in lote["respostas"] for s in r["secoes"]} - set(est["textos"]))
    if ids:
        est["textos"].update(_no_conteiner_rag(inst, JUIZ_TEXTOS, {"ids": ids, "max_chars": juiz.CHARS_POR_SECAO + 500}))
        _salva_estado(arq_estado, est)

    def gerar(sist, usuario, tentativa):
        g = _gerar_claude_host(sist, usuario, op.get("--modelo") or est.get("modelo_pedido") or "opus")
        est["modelo_pedido"] = op.get("--modelo") or est.get("modelo_pedido") or "opus"
        if est.get("modelo") and est["modelo"] != g["modelo"]:
            print(f"motor julgar: o gerador do rag trocou de modelo no meio do lote ({est['modelo']} -> {g['modelo']})",
                  file=sys.stderr)
            sys.exit(4)
        est["modelo"], est["provider"] = g["modelo"], g["provider"]
        return g

    limite = time.monotonic() + float(op.get("--tempo", 480))
    pendentes = [r for r in lote["respostas"] if r["resposta_id"] not in est["julgados"]]
    falhas = []
    for r in pendentes:
        if time.monotonic() > limite:
            break
        secoes = [{"chave": s["chave"], "titulo": s["titulo"], "texto": est["textos"].get(s.get("secao_id") or s["chave"], "")}
                  for s in r["secoes"]]
        try:
            est["julgados"][r["resposta_id"]] = juiz.julgar_resposta(
                sistema, graus, perg[r["pergunta_id"]]["texto"], texto_resp[r["resposta_id"]], secoes, r["mapa"], gerar)
        except RuntimeError as e:
            falhas.append(f"{r['resposta_id']}: {e}")
        _salva_estado(arq_estado, est)
    feitos, total = len(est["julgados"]), len(lote["respostas"])
    contagem = dict(sorted(Counter(j["qualidade"] for j in est["julgados"].values()).items()))
    print(f"lote {lote['lote_id']} · juiz {est.get('modelo')} ({est.get('provider')}) · prompt {h[:12]} · "
          f"{feitos}/{total} julgadas · graus do juiz {contagem}")
    for f in falhas:
        print(f"  sem julgamento: {f}")
    if feitos < total:
        print(f"INCOMPLETO: repita `motor rag julgar biblioteca --lote {lote['lote_id']}`; nada foi gravado no banco ainda")
        sys.exit(1)
    r = _chama_marcacao(base, tk, "POST", "/interno/juiz", juiz.marcas_para_gravar(lote["lote_id"], est["julgados"], est["modelo"], h))
    print(f"{r['gravadas']} marca(s) do juiz gravada(s) (as ja gravadas com o mesmo modelo e prompt nao se repetem); "
          f"os eventos do dono nao foram lidos. Proximo: motor rag julgar biblioteca --lote {lote['lote_id']} --kappa")


PAREAR_OPCOES = {"--frases": 1, "--versao": 1, "--criterio-versao": 1, "--saida": 1, "--lote-id": 1, "--antes": 1,
                "--lista": 1, "--tempo": 1, "--ativar": 0, "--plano": 0, "--do-log": 0, "--desde": 1}


def _julgamentos_do_lote(d, antes):
    """O que o dono ja julgou no lote `antes`, por pergunta (so leitura da marcacao-api). Falha vira aviso."""
    mk = d.get("marcacao")
    if not mk or not antes:
        return {}
    try:
        base, tk = mk["endpoint"], token_da(mk)
        lote = marcacao.chamar(base, tk, "GET", "/interno/lote/" + urllib.parse.quote(antes) + "?com_braco=1")
        evs = marcacao.chamar(base, tk, "GET", "/interno/eventos?lote_id=" + urllib.parse.quote(antes))["eventos"]
    except marcacao.Falha as f:
        print(f"motor parear: o julgamento anterior ({antes}) nao foi lido: {f.msg}", file=sys.stderr)
        return {}
    return par_consulta.julgamentos_anteriores(lote, evs)


def cmd_parear(d, inst, argv):
    """`parear biblioteca`: o par minimo da consulta montada (card #3360; spec motor §2b). Para cada pergunta com frase do
    dono, recupera o top-8 da chamada de hoje (A), da frase (C) e da lista montada (D), na mesma geracao; escreve uma
    resposta por braco com o escritor da escada, a FRASE como pergunta nos tres; monta o lote que o dono julga na tela
    e a tabela com a sobreposicao e o que ele ja julgou. Estado em arquivo, retomavel (`--lote-id`)."""
    particao, resto = resolve_particao(argv, "parear")
    if particao != "biblioteca":
        print("motor parear: so a biblioteca tem o piloto da escada", file=sys.stderr)
        sys.exit(2)
    op, i = {}, 0
    while i < len(resto):
        n = PAREAR_OPCOES.get(resto[i])
        if n is None or (n and i + 1 >= len(resto)):
            print(f"motor parear: argumento invalido {resto[i]!r}. Aceita: {' '.join(PAREAR_OPCOES)}", file=sys.stderr)
            sys.exit(2)
        op[resto[i]] = resto[i + 1] if n else True
        i += 1 + n
    if op.get("--do-log"):
        return _parear_do_log(inst, op)
    if op.get("--desde"):
        print("motor parear: --desde so vale com --do-log", file=sys.stderr)
        sys.exit(2)
    if not op.get("--frases") or not (op.get("--plano") or (op.get("--saida") and op.get("--versao") and op.get("--criterio-versao"))):
        print("motor parear: pede --frases <arquivo.json> e, para escrever, --saida <envelope.json> --versao <gabarito_versao_id> "
              "--criterio-versao <v> (ou --plano, so a recuperacao e a tabela)", file=sys.stderr)
        sys.exit(2)
    lista = op.get("--lista") or str(_ARVORE / "avaliacao" / "escada-sentido-v1.jsonl")
    try:
        with open(lista, "rb") as f:
            bruto = f.read()
        piloto = {c["id"]: c for c in (json.loads(l) for l in bruto.decode().splitlines() if l.strip()) if c["papel"] == "piloto"}
        with open(op["--frases"], encoding="utf-8") as f:
            frases_bruto = f.read()
        frases = par_consulta.ler_frases(frases_bruto, piloto)
    except (OSError, ValueError) as e:
        print(f"motor parear: {e}", file=sys.stderr)
        sys.exit(2)
    ids = [pid for pid in piloto if pid in frases]
    tok = token_da(inst)
    lote_id = op.get("--lote-id") or time.strftime("par-consulta-%Y%m%dT%H%M", time.gmtime())
    arq_estado = os.path.join(dir_medicoes(inst), f"par-{lote_id}.json")
    os.makedirs(os.path.dirname(arq_estado), exist_ok=True)
    if os.path.isfile(arq_estado):
        with open(arq_estado) as f:
            est = json.load(f)
        if est["perguntas"] != ids:
            print(f"motor parear: o estado {arq_estado} e de outro conjunto de perguntas; use outro --lote-id", file=sys.stderr)
            sys.exit(2)
    else:
        est = {"lote_id": lote_id, "perguntas": ids, "recuperado": {}, "consultas": {}, "geradas": {},
               "iniciado_em": time.strftime("%Y-%m-%dT%H:%M:%S%z")}

    # --- recuperacao: A, C e D na mesma geracao e no mesmo instante ---------------------------------------
    for pid in ids:
        f = frases[pid]
        rotulos = consulta.rotulos_do_chapeu(f["cadeira"], f["chapeu"])
        cs = par_consulta.consultas(piloto[pid]["pergunta"], f["frase"], rotulos)
        est["consultas"][pid] = cs
        rec = est["recuperado"].setdefault(pid, {})
        for braco, c in cs.items():
            if braco not in rec:
                rec[braco] = escritor.secoes_do_servido(_recupera_servido(inst, tok, c))
        for braco in [b for b in rec if b not in cs]:      # estado de um arquivo de frases antigo
            del rec[braco]
    _salva_estado(arq_estado, est)

    julgados = _julgamentos_do_lote(d, op.get("--antes"))
    itens, linhas, avisos = [], [], []
    for n, pid in enumerate(ids, 1):
        rec = est["recuperado"][pid]
        jacc = par_consulta.jaccard_dos_bracos(rec)
        itens.append({"id": pid, "pergunta_do_log": piloto[pid]["pergunta"], "frase": frases[pid]["frase"], "chapeu": frases[pid]["chapeu"],
                      "consultas": est["consultas"][pid], "recuperado": rec, "jaccard": jacc, "julgamento": julgados.get(pid),
                      "sem_secao": [b for b in rec if not rec[b]]})
        linhas.append(par_consulta.linha_da_tabela(n, pid, frases[pid]["frase"], jacc, "montada" in rec, julgados.get(pid)))
        recusa = consulta.lint(frases[pid]["frase"])
        if recusa:
            avisos.append(f"{n}. a sua frase seria recusada pelo lint ({recusa[0]}): {frases[pid]['frase'][:70]}")
        vazios = itens[-1]["sem_secao"]
        if vazios:
            avisos.append(f"{n}. braco(s) sem nenhuma secao: {', '.join(par_consulta.LETRA[b] for b in vazios)}")
    dia = time.strftime("%Y-%m-%d", time.gmtime())
    arq_json = os.path.join(dir_medicoes(inst), f"{dia}-par-consulta.json")
    arq_md = os.path.join(dir_medicoes(inst), f"{dia}-par-consulta.md")
    _grava_atomico(arq_json, json.dumps({"lote_id": lote_id, "gerado_em": est["iniciado_em"], "antes": op.get("--antes"),
                                         "perguntas": itens, "avisos": avisos}, ensure_ascii=False))
    _grava_atomico(arq_md, par_consulta.tabela(linhas) + "\n\n" + par_consulta.blocos_markdown(itens))
    sem_d = sum(1 for it in itens if "montada" not in it["recuperado"])
    print(f"par {lote_id} · {len(ids)} perguntas · D = C (sem chapeu, nao entra) em {sem_d}")
    print(par_consulta.tabela(linhas))
    for a in avisos:
        print(f"AVISO {a}")
    print(f"tabela e top-8 por braco: {arq_md}\njson: {arq_json}")
    if op.get("--plano"):
        print(f"estado em {arq_estado}; recuperacao feita, nada escrito")
        return

    # --- redacao: a frase e a pergunta nos tres bracos -------------------------------------------------------
    limite = time.monotonic() + float(op.get("--tempo", 480))
    for pid in ids:
        for braco in est["recuperado"][pid]:
            if braco in est["geradas"].get(pid, {}):
                continue
            if time.monotonic() > limite:
                break
            est["geradas"].setdefault(pid, {})[braco] = escritor.escrever_resposta(
                frases[pid]["frase"], est["recuperado"][pid][braco], _gerar_ollama)
            _salva_estado(arq_estado, est)
    total = sum(len(est["recuperado"][pid]) for pid in ids)
    feitas = sum(len(est["geradas"].get(pid, {})) for pid in ids)
    if feitas < total:
        print(f"INCOMPLETO: {feitas}/{total} respostas escritas; repita o mesmo comando com --lote-id {lote_id}")
        sys.exit(1)

    # --- envelope ----------------------------------------------------------------------------------------------
    facets = http(inst["facets"], tok, timeout=30) or {}
    env, _ = servido(inst)
    env = env or {}
    chaves = ("EMBED_MODEL", "EMBED_BACKEND", "EMBED_QUERY_INSTRUCTION", "RETRIEVAL_MODE", "HYBRID_LEXICAL", "RRF_K",
              "RERANK_MODEL", "RERANK_POOL", "RERANK_BLEND", "CHUNK_TOKEN_CEILING", "EXPANSAO_POR_CONCEITO")
    custo = {b: {"segundos": 0.0, "tokens_prompt": 0, "tokens_saida": 0, "respostas": 0} for b in par_consulta.BRACOS_DO_PAR}
    for por_braco in est["geradas"].values():
        for b, r in por_braco.items():
            c = custo[b]
            c["segundos"] = round(c["segundos"] + r["carimbo"]["segundos"], 2)
            c["tokens_prompt"] += r["carimbo"]["tokens_prompt"]
            c["tokens_saida"] += r["carimbo"]["tokens_saida"]
            c["respostas"] += 1
    carimbo = {
        "acervo": {"acervo_sha": (facets.get("indice") or {}).get("acervo_sha"), "indice": facets.get("indice")},
        "motor": {"servido": {k: env.get(k) for k in chaves}, "k": escritor.K, "texto": "secao",
                  "bracos": {"servido": "a chamada do log, como foi feita", "frase": "a frase do dono",
                             "montada": "consulta.montar(frase, sem pedido, rotulos do chapeu informado)"}},
        "vocabulario": {"versao": (facets.get("indice") or {}).get("vocabulario_versao") or "nao declarada em /facets", "fonte": "/facets"},
        "gabarito": {"versao_id": op["--versao"], "sha_git": sorteio.sha_blob_git(bruto), "lista": "avaliacao/escada-sentido-v1.jsonl",
                     "perguntas": ids},
        "escritor": {"modelo": escritor.MODELO, "prompt_versao": escritor.PROMPT_VERSAO, "prompt_sha256": escritor.prompt_sha256(),
                     "semente": escritor.SEMENTE_GERACAO, "temperatura": escritor.TEMPERATURA, "palavras": escritor.PALAVRAS,
                     "pergunta_do_escritor": "a frase do dono, nos tres bracos"},
        "par": {"frases_sha256": hashlib.sha256(frases_bruto.encode()).hexdigest(), "antes": op.get("--antes"), "regra":
                "D nao perde para A em nenhum dos cinco pares que o dono ler", "sem_pedido": "as chamadas do piloto sao anteriores ao #3345"},
        "custo": custo,
    }
    resultados = {pid: dict(est["geradas"][pid]) for pid in ids}
    perguntas = [{"id": pid, "frase": frases[pid]["frase"], "cadeira": piloto[pid]["cadeira"], "data": piloto[pid]["data"]} for pid in ids]
    envelope = par_consulta.montar_lote_par(lote_id, op["--versao"], op["--criterio-versao"], perguntas, resultados, carimbo,
                                            str(escritor.SEMENTE_GERACAO), bool(op.get("--ativar")))
    problemas = par_consulta.conferir_aceite_par(envelope, len(ids))
    _grava_atomico(op["--saida"], json.dumps(envelope, ensure_ascii=False))
    print(f"envelope em {op['--saida']}: {len(envelope['corpo']['perguntas'])} perguntas, {len(envelope['respostas'])} respostas")
    if problemas:
        print("FORA DO ACEITE:")
        for pr in problemas:
            print(f"  - {pr}")
        sys.exit(1)
    print(f"gravar: motor marcacao lote gravar {op['--saida']}{' --ativar' if not op.get('--ativar') else ''}")


def _populacao_do_log(inst, desde):
    """A populacao do `parear --do-log` (card #3378): os eventos de acervo.evento_recuperacao com necessidade e chapeu nao
    nulos, lidos pelo banco como `eleger` (nunca o log da porta, #3364), cuja rota /eleger devolve `eleito_do_chapeu`,
    deduplicados por necessidade. Devolve (chamadas lidas, chamadas com eleito, populacao)."""
    b, bancos = inst.get("banco") or {}, inst.get("bancos") or {}
    if not b or "sessao" not in bancos:
        print("motor parear: a instancia nao declara banco e bancos.sessao em motor-instancias.json", file=sys.stderr)
        sys.exit(1)
    eventos = _psql_json(b, (
        "SELECT coalesce(json_agg(t ORDER BY t.criado_em, t.id), '[]'::json) FROM ("
        "SELECT e.id::text AS id, e.sessao_id::text AS sessao_id, e.criado_em::text AS criado_em, "
        "e.necessidade, e.chapeu "
        "FROM acervo.evento_recuperacao e "
        "WHERE e.disparou AND e.necessidade IS NOT NULL AND e.necessidade != '' "
        "AND e.chapeu IS NOT NULL AND e.chapeu != '' AND e.chapeu != '-') t"))
    if desde:
        eventos = [e for e in eventos if (e.get("criado_em") or "") >= desde]
    ids = sorted({e["sessao_id"] for e in eventos if e.get("sessao_id") and _UUID.match(e["sessao_id"])})
    cadeiras = {}
    if ids:
        linhas = _psql_json(bancos["sessao"], (
            "SELECT coalesce(json_agg(json_build_object('sessao_id', sessao_id::text, 'cadeira', cadeira)), '[]'::json) "
            "FROM sessao.sessao WHERE sessao_id::text IN (" + ",".join(_lit(x) for x in ids) + ")"))
        cadeiras = {x["sessao_id"]: x["cadeira"] for x in (linhas or [])}
    itens, quem = [], []
    for e in eventos:
        cad = cadeiras.get(e.get("sessao_id")) or "-"
        rotulos = list(consulta.rotulos_do_chapeu(cad, e["chapeu"]))
        itens.append({"necessidade": e["necessidade"], "rotulos": rotulos})
        quem.append((e, cad, rotulos))
    resultados = []
    if itens:
        tok = token_da(inst)
        for idx in range(0, len(itens), 100):
            resp = _chama_eleger(inst, tok, {"itens": itens[idx:idx + 100]})
            resultados.extend((resp or {}).get("itens") or [])
    com_eleito, populacao, vistas = 0, [], set()
    for (e, cad, rotulos), res in zip(quem, resultados):
        if not res.get("eleito_do_chapeu"):
            continue
        com_eleito += 1
        necessidade = " ".join(e["necessidade"].split())
        if necessidade.lower() in vistas:
            continue
        vistas.add(necessidade.lower())
        populacao.append({"id": "ev-" + e["id"], "necessidade": necessidade, "cadeira": cad, "chapeu": e["chapeu"],
                          "rotulos": rotulos, "data": (e.get("criado_em") or "")[:10]})
    return len(eventos), com_eleito, populacao


def _parear_do_log(inst, op):
    """`parear biblioteca --do-log [--desde <data>]` (card #3378; Medida do #3359): o par sobre as chamadas do log com
    eleito, nao sobre o piloto. Dois bracos na mesma geracao, mesmo k e mesmo escritor: `frase` (a busca de hoje: a
    necessidade, sem chapeu) e `eleito` (a necessidade com `chapeu` e `eleicao_chapeu: true` no corpo, so na
    requisicao). A tabela traz o Jaccard do top-8 E x C. Populacao vazia: sai 0 dizendo que nao ha par, sem lote."""
    if op.get("--frases") or op.get("--lista") or op.get("--antes"):
        print("motor parear: --do-log tira a populacao do log; nao combina com --frases, --lista nem --antes", file=sys.stderr)
        sys.exit(2)
    if not (op.get("--plano") or (op.get("--saida") and op.get("--versao") and op.get("--criterio-versao"))):
        print("motor parear: --do-log pede --plano (so a recuperacao e a tabela) ou --saida <envelope.json> "
              "--versao <gabarito_versao_id> --criterio-versao <v>", file=sys.stderr)
        sys.exit(2)
    desde = op.get("--desde") or ""
    total, com_eleito, populacao = _populacao_do_log(inst, desde)
    print(f"parear --do-log{' desde ' + desde if desde else ''}: chamadas do log com eleito {com_eleito} de {total} "
          f"(necessidade e chapeu nao nulos) · {len(populacao)} necessidades distintas")
    if not populacao:
        print("nao ha par a medir: nenhuma chamada do log com eleito; nenhum lote criado")
        return
    tok = token_da(inst)
    ids = [p["id"] for p in populacao]
    por_id = {p["id"]: p for p in populacao}
    lote_id = op.get("--lote-id") or time.strftime("par-eleito-%Y%m%dT%H%M", time.gmtime())
    arq_estado = os.path.join(dir_medicoes(inst), f"par-{lote_id}.json")
    os.makedirs(os.path.dirname(arq_estado), exist_ok=True)
    if os.path.isfile(arq_estado):
        with open(arq_estado) as f:
            est = json.load(f)
        if est["perguntas"] != ids:
            print(f"motor parear: o estado {arq_estado} e de outro conjunto de chamadas; use outro --lote-id", file=sys.stderr)
            sys.exit(2)
    else:
        est = {"lote_id": lote_id, "perguntas": ids, "recuperado": {}, "consultas": {}, "geradas": {},
               "iniciado_em": time.strftime("%Y-%m-%dT%H:%M:%S%z")}

    # --- recuperacao: C e E na mesma geracao e no mesmo instante ------------------------------------------
    for pid in ids:
        p = por_id[pid]
        cs = par_consulta.consultas_do_log(p["necessidade"], p["cadeira"], p["chapeu"], p["rotulos"])
        est["consultas"][pid] = cs
        rec = est["recuperado"].setdefault(pid, {})
        for braco, c in cs.items():
            if braco not in rec:
                rec[braco] = escritor.secoes_do_servido(_recupera_servido(inst, tok, c["pergunta"], extra=c["corpo"]))
    _salva_estado(arq_estado, est)

    itens, linhas, avisos = [], [], []
    for n, pid in enumerate(ids, 1):
        p, rec = por_id[pid], est["recuperado"][pid]
        jacc = par_consulta.jaccard_eleito(rec)
        itens.append({"id": pid, "frase": p["necessidade"], "cadeira": p["cadeira"], "chapeu": p["chapeu"],
                      "consultas": est["consultas"][pid], "recuperado": rec, "jaccard": jacc})
        linhas.append(par_consulta.linha_da_tabela_log(n, pid, p["necessidade"], p["cadeira"], p["chapeu"], jacc))
        vazios = [b for b in rec if not rec[b]]
        if vazios:
            avisos.append(f"{n}. braco(s) sem nenhuma secao: {', '.join(par_consulta.LETRA[b] for b in vazios)}")
    dia = time.strftime("%Y-%m-%d", time.gmtime())
    arq_json = os.path.join(dir_medicoes(inst), f"{dia}-par-eleito.json")
    arq_md = os.path.join(dir_medicoes(inst), f"{dia}-par-eleito.md")
    _grava_atomico(arq_json, json.dumps({"lote_id": lote_id, "gerado_em": est["iniciado_em"], "desde": desde or None,
                                         "chamadas": {"lidas": total, "com_eleito": com_eleito, "distintas": len(populacao)},
                                         "perguntas": itens, "avisos": avisos}, ensure_ascii=False))
    _grava_atomico(arq_md, par_consulta.tabela_log(linhas) + "\n\n" + par_consulta.blocos_markdown_log(itens))
    print(f"par {lote_id} · {len(ids)} chamadas com eleito")
    print(par_consulta.tabela_log(linhas))
    for a in avisos:
        print(f"AVISO {a}")
    print(f"tabela e top-8 por braco: {arq_md}\njson: {arq_json}")
    if op.get("--plano"):
        print(f"estado em {arq_estado}; recuperacao feita, nada escrito")
        return

    # --- redacao: a necessidade e a pergunta nos dois bracos ---------------------------------------------
    limite = time.monotonic() + float(op.get("--tempo", 480))
    for pid in ids:
        for braco in est["recuperado"][pid]:
            if braco in est["geradas"].get(pid, {}):
                continue
            if time.monotonic() > limite:
                break
            est["geradas"].setdefault(pid, {})[braco] = escritor.escrever_resposta(
                por_id[pid]["necessidade"], est["recuperado"][pid][braco], _gerar_ollama)
            _salva_estado(arq_estado, est)
    total_r = sum(len(est["recuperado"][pid]) for pid in ids)
    feitas = sum(len(est["geradas"].get(pid, {})) for pid in ids)
    if feitas < total_r:
        print(f"INCOMPLETO: {feitas}/{total_r} respostas escritas; repita o mesmo comando com --lote-id {lote_id}")
        sys.exit(1)

    # --- envelope ----------------------------------------------------------------------------------------
    facets = http(inst["facets"], tok, timeout=30) or {}
    env, _ = servido(inst)
    env = env or {}
    chaves = ("EMBED_MODEL", "EMBED_BACKEND", "EMBED_QUERY_INSTRUCTION", "RETRIEVAL_MODE", "HYBRID_LEXICAL", "RRF_K",
              "RERANK_MODEL", "RERANK_POOL", "RERANK_BLEND", "CHUNK_TOKEN_CEILING", "EXPANSAO_POR_CONCEITO", "ELEICAO_CHAPEU")
    custo = {b: {"segundos": 0.0, "tokens_prompt": 0, "tokens_saida": 0, "respostas": 0} for b in par_consulta.BRACOS_DO_LOG}
    for por_braco in est["geradas"].values():
        for b, r in por_braco.items():
            c = custo[b]
            c["segundos"] = round(c["segundos"] + r["carimbo"]["segundos"], 2)
            c["tokens_prompt"] += r["carimbo"]["tokens_prompt"]
            c["tokens_saida"] += r["carimbo"]["tokens_saida"]
            c["respostas"] += 1
    carimbo = {
        "acervo": {"acervo_sha": (facets.get("indice") or {}).get("acervo_sha"), "indice": facets.get("indice")},
        "motor": {"servido": {k: env.get(k) for k in chaves}, "k": escritor.K, "texto": "secao",
                  "bracos": {"frase": "a necessidade do evento, sem chapeu: a busca de hoje",
                             "eleito": "a necessidade com chapeu {cadeira, chapeu, rotulos} e eleicao_chapeu: true, so na requisicao"}},
        "vocabulario": {"versao": (facets.get("indice") or {}).get("vocabulario_versao") or "nao declarada em /facets", "fonte": "/facets"},
        "gabarito": {"versao_id": op["--versao"], "fonte": "acervo.evento_recuperacao (necessidade e chapeu nao nulos; /eleger com eleito_do_chapeu)",
                     "desde": desde or None, "perguntas": ids},
        "escritor": {"modelo": escritor.MODELO, "prompt_versao": escritor.PROMPT_VERSAO, "prompt_sha256": escritor.prompt_sha256(),
                     "semente": escritor.SEMENTE_GERACAO, "temperatura": escritor.TEMPERATURA, "palavras": escritor.PALAVRAS,
                     "pergunta_do_escritor": "a necessidade do evento, nos dois bracos"},
        "par": {"necessidades_sha256": hashlib.sha256("\n".join(p["necessidade"] for p in populacao).encode()).hexdigest(),
                "chamadas": {"lidas": total, "com_eleito": com_eleito, "distintas": len(populacao)},
                "regra": "a escrita no #3359 antes da rodada; quem le os pares e o dono, quem decide ligar e a ia"},
        "custo": custo,
    }
    resultados = {pid: dict(est["geradas"][pid]) for pid in ids}
    perguntas = [{"id": pid, "frase": por_id[pid]["necessidade"], "cadeira": por_id[pid]["cadeira"], "data": por_id[pid]["data"]} for pid in ids]
    envelope = par_consulta.montar_lote_par(lote_id, op["--versao"], op["--criterio-versao"], perguntas, resultados, carimbo,
                                            str(escritor.SEMENTE_GERACAO), bool(op.get("--ativar")))
    problemas = par_consulta.conferir_aceite_par(envelope, len(ids))
    _grava_atomico(op["--saida"], json.dumps(envelope, ensure_ascii=False))
    print(f"envelope em {op['--saida']}: {len(envelope['corpo']['perguntas'])} perguntas, {len(envelope['respostas'])} respostas")
    if problemas:
        print("FORA DO ACEITE:")
        for pr in problemas:
            print(f"  - {pr}")
        sys.exit(1)
    print(f"gravar: motor marcacao lote gravar {op['--saida']}{' --ativar' if not op.get('--ativar') else ''}")


def _causa_curta(causa):
    return "assuntos" if consulta.CAUSA_ASSUNTOS in causa else "frase" if causa == consulta.CAUSA_FRASE else "lingua"


def cmd_lintar(inst, argv):
    """`lintar`: o lint da consulta montada sobre o log de perguntas, so leitura (card #3360, passo 7).

    Diz, por origem, quantos eventos o lint recusaria e por qual causa, e as 20 do piloto da escada uma a
    uma. A causa (c) nao se mede: o log anterior a 087 nao tem o pedido do dono. Nao grava nada, nao
    recusa nada: e a regua do piso de palavras funcionais (consulta.PISO_FUNCIONAIS) contra o que as
    cadeiras de fato perguntaram."""
    desde = None
    resto = list(argv)
    if "--desde" in resto:
        k = resto.index("--desde")
        if k + 1 >= len(resto) or not re.match(r"^\d{4}-\d{2}-\d{2}$", resto[k + 1]):
            print("motor lintar: --desde pede AAAA-MM-DD", file=sys.stderr)
            sys.exit(2)
        desde = resto[k + 1]
        del resto[k:k + 2]
    if any(x != "--json" for x in resto):
        print("motor lintar: aceita --desde AAAA-MM-DD e --json\n  motor <inst> lintar [--desde AAAA-MM-DD] [--json]", file=sys.stderr)
        sys.exit(2)
    argv = resto
    b = inst.get("banco") or {}
    if not b:
        print("motor lintar: a instancia nao declara banco em motor-instancias.json", file=sys.stderr)
        sys.exit(1)
    # `pedido` saiu da consulta e do evento no #3364: nao se le mais
    eventos = _psql_json(b, (
        "SELECT coalesce(json_agg(t ORDER BY t.criado_em, t.id), '[]'::json) FROM ("
        "SELECT e.id::text AS id, e.pergunta, e.origem, e.criado_em::text AS criado_em, "
        "e.necessidade, e.chapeu, e.perguntas, e.lint "
        "FROM acervo.evento_recuperacao e WHERE e.disparou"
        + (f" AND e.criado_em >= {_lit(desde)}::date" if desde else "") + ") t"))
    por_origem, distintas = {}, {}
    for e in eventos:
        o = e.get("origem") or "nao declarada"
        d = por_origem.setdefault(o, {"eventos": 0, "passam": 0, "ingles": 0, "recusadas": Counter(),
                                      "exemplos_recusados": []})
        d["eventos"] += 1
        v = consulta.lint(e["pergunta"])
        if v is None:
            d["passam"] += 1
            d["ingles"] += consulta.lingua(e["pergunta"]) == "en"     # (c) com pedido em portugues
        else:
            d["recusadas"][_causa_curta(v[0])] += 1
            if o == "abertura" and len(d["exemplos_recusados"]) < 10:
                d["exemplos_recusados"].append(e["pergunta"][:90])
        distintas.setdefault(o, set()).add(" ".join(e["pergunta"].lower().split()))
    montadas = [e for e in eventos if e.get("necessidade")]      # o que a 087 passou a gravar
    piloto = []
    with open(_ARVORE / "avaliacao" / "escada-sentido-v1.jsonl", encoding="utf-8") as f:
        for linha in f:
            c = json.loads(linha)
            if c.get("papel") == "piloto":
                v = consulta.lint(c["pergunta"])
                veredito = "passa" if v is None else _causa_curta(v[0])
                piloto.append({"posicao": c["posicao"], "pergunta": c["pergunta"],
                               "palavras": len(consulta.palavras(c["pergunta"])),
                               "funcionais": round(consulta.proporcao_funcionais(c["pergunta"]), 3),
                               "veredito": veredito,
                               # (c) so dispara com o pedido a vista; o piloto e anterior ao #3345 e nao o tem.
                               # Aqui se supoe o pedido em portugues, que e a lingua do dono.
                               "veredito_com_pedido_pt": ("lingua" if veredito == "passa"
                                                          and consulta.lingua(c["pergunta"]) == "en" else veredito)})
    rel = {"piso": consulta.PISO_FUNCIONAIS, "min_palavras": consulta.MIN_PALAVRAS, "eventos": len(eventos),
           "por_origem": {o: {"eventos": d["eventos"], "distintas": len(distintas[o]), "passam": d["passam"],
                              "ingles": d["ingles"], "recusadas": dict(d["recusadas"]),
                              "exemplos_recusados": d["exemplos_recusados"]}
                          for o, d in sorted(por_origem.items())},
           "piloto": piloto,
           "montadas": {"eventos": len(montadas), "ultimos": [
               {"criado_em": e["criado_em"][:19], "pergunta": e["pergunta"][:70], "necessidade": e["necessidade"][:70],
                "chapeu": e["chapeu"], "n_perguntas": len(e["perguntas"] or []), "lint": e["lint"]}
               for e in montadas[-10:]]}}
    if argv:
        print(json.dumps(rel, ensure_ascii=False, indent=1))
        return
    print(f"lint da consulta sobre {rel['eventos']} eventos do log (piso {consulta.PISO_FUNCIONAIS} de palavras funcionais, "
          f"{consulta.MIN_PALAVRAS} palavras ou mais; a causa de lingua nao se mede: o log nao tem pedido, "
          "e a coluna ingles supoe um pedido em portugues)")
    print(f"  {'origem':<14} {'eventos':>7} {'distintas':>9} {'passam':>7} {'assuntos':>9} {'frase':>6} {'ingles*':>8}")
    for o, d in rel["por_origem"].items():
        r = d["recusadas"]
        print(f"  {o:<14} {d['eventos']:>7} {d['distintas']:>9} {d['passam']:>7} {r.get('assuntos', 0):>9} "
              f"{r.get('frase', 0):>6} {d['ingles']:>8}")
    print("  * dos que passam, os que a causa de lingua recusaria com pedido em portugues")
    for o, d in rel["por_origem"].items():
        if o == "abertura" and d["exemplos_recusados"]:
            print("abertura recusada (prompt do dono: o piso nao pode pegar):")
            for x in d["exemplos_recusados"]:
                print(f"    {x}")
    print("piloto da escada, uma a uma:")
    for p in piloto:
        print(f"  {p['posicao']:>2}. {p['veredito']:<8} {p['palavras']:>2} palavras · funcionais {p['funcionais']:<5} · {p['pergunta'][:100]}")
    print(f"piloto: {sum(1 for p in piloto if p['veredito'] != 'passa')} recusadas, "
          f"{sum(1 for p in piloto if p['veredito'] == 'passa')} passam")
    print(f"piloto com pedido em portugues (causa de lingua somada): "
          f"{sum(1 for p in piloto if p['veredito_com_pedido_pt'] != 'passa')} recusadas, "
          f"{sum(1 for p in piloto if p['veredito_com_pedido_pt'] == 'passa')} passam: "
          + ", ".join(str(p['posicao']) for p in piloto if p['veredito_com_pedido_pt'] == 'passa'))
    m = rel["montadas"]
    print(f"eventos com consulta montada (087): {m['eventos']} de {rel['eventos']}" + (f" desde {desde}" if desde else ""))
    for e in m["ultimos"]:
        print(f"  {e['criado_em']} chapeu={e['chapeu']} perguntas={e['n_perguntas']} lint={e['lint']} "
              f"necessidade={e['necessidade']!r}")


def _chama_eleger(inst, tok, corpo):
    """POST na rota /eleger do rag-api (#3362, #3368)."""
    base = inst.get("eleger") or urllib.parse.urljoin(inst["endpoint"], "/eleger")
    req = urllib.request.Request(
        base, data=json.dumps(corpo).encode("utf-8"),
        headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return json.loads(r.read().decode("utf-8"))
    except (urllib.error.HTTPError, urllib.error.URLError) as e:
        _trata_erro_http(e, "motor eleger")


def cmd_eleger(nome_inst, inst, argv):
    """`eleger`: medicao so leitura da eleicao de chapeu sobre o log de perguntas (card #3368).

    Le acervo.evento_recuperacao (necessidade e chapeu nao nulos), manda em lote a rota /eleger
    do rag-api e imprime por cadeira e chapeu: total, frase_sem_conceito, chapeu_sem_casamento.
    Nao grava nada, nao altera a busca."""
    desde = ""
    como_json = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            como_json = True
            i += 1
            continue
        if a == "--desde":
            if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
                print("eleger: --desde exige um valor.\n  motor <inst> eleger [--desde <data>] [--json]", file=sys.stderr)
                sys.exit(2)
            desde = argv[i + 1]
            i += 2
            continue
        print(f"eleger: argumento desconhecido {a!r}.\n  motor <inst> eleger [--desde <data>] [--json]", file=sys.stderr)
        sys.exit(2)

    b, bancos = inst.get("banco") or {}, inst.get("bancos") or {}
    if not b or "sessao" not in bancos:
        print("motor eleger: a instancia nao declara banco e bancos.sessao em motor-instancias.json", file=sys.stderr)
        sys.exit(1)

    eventos = _psql_json(b, (
        "SELECT coalesce(json_agg(t ORDER BY t.criado_em, t.id), '[]'::json) FROM ("
        "SELECT e.id::text AS id, e.sessao_id::text AS sessao_id, e.criado_em::text AS criado_em, "
        "e.necessidade, e.chapeu "
        "FROM acervo.evento_recuperacao e "
        "WHERE e.disparou AND e.necessidade IS NOT NULL AND e.necessidade != '' "
        "AND e.chapeu IS NOT NULL AND e.chapeu != '' AND e.chapeu != '-') t"))

    if desde:
        eventos = [e for e in eventos if (e.get("criado_em") or "") >= desde]

    ids = sorted({e["sessao_id"] for e in eventos if e.get("sessao_id") and _UUID.match(e["sessao_id"])})
    cadeiras = {}
    if ids:
        linhas = _psql_json(bancos["sessao"], (
            "SELECT coalesce(json_agg(json_build_object('sessao_id', sessao_id::text, 'cadeira', cadeira)), '[]'::json) "
            "FROM sessao.sessao WHERE sessao_id::text IN (" + ",".join(_lit(x) for x in ids) + ")"))
        cadeiras = {x["sessao_id"]: x["cadeira"] for x in (linhas or [])}

    pares = []
    itens = []
    for e in eventos:
        cad = cadeiras.get(e.get("sessao_id")) or "-"
        chap = e.get("chapeu") or "-"
        rotulos = list(consulta.rotulos_do_chapeu(cad, chap))
        pares.append((cad, chap))
        itens.append({"necessidade": e["necessidade"], "rotulos": rotulos})

    resultados = []
    if itens:
        tok = token_da(inst)
        chunk_size = 100
        for idx in range(0, len(itens), chunk_size):
            resp = _chama_eleger(inst, tok, {"itens": itens[idx:idx + chunk_size]})
            resultados.extend((resp or {}).get("itens") or [])

    contagem = {}
    for (cad, chap), res in zip(pares, resultados):
        chave = (cad, chap)
        if chave not in contagem:
            contagem[chave] = {
                "cadeira": cad,
                "chapeu": chap,
                "total": 0,
                "frase_sem_conceito": 0,
                "chapeu_sem_casamento": 0,
                "eleito": 0,
            }
        d = contagem[chave]
        d["total"] += 1
        sinais = res.get("sinais") or []
        if "frase_sem_conceito" in sinais:
            d["frase_sem_conceito"] += 1
        if "chapeu_sem_casamento" in sinais:
            d["chapeu_sem_casamento"] += 1
        if res.get("eleito_do_chapeu"):
            d["eleito"] += 1

    linhas = [contagem[k] for k in sorted(contagem.keys())]
    total_eventos = len(eventos)
    total_sem_conceito = sum(l["frase_sem_conceito"] for l in linhas)
    total_sem_casamento = sum(l["chapeu_sem_casamento"] for l in linhas)
    total_eleito = sum(l["eleito"] for l in linhas)

    if como_json:
        saida = {
            "desde": desde or None,
            "eventos": total_eventos,
            "tabela": linhas,
            "por_cadeira_chapeu": {f"{l['cadeira']}/{l['chapeu']}": l for l in linhas},
            "totais": {
                "total": total_eventos,
                "frase_sem_conceito": total_sem_conceito,
                "chapeu_sem_casamento": total_sem_casamento,
                "eleito": total_eleito,
            },
        }
        print(json.dumps(saida, ensure_ascii=False, indent=1))
        return

    info_desde = f" desde {desde}" if desde else ""
    print(f"eleicao de chapeu sobre {total_eventos} eventos do log{info_desde} (necessidade e chapeu nao nulos)")
    if not linhas:
        print("  nenhum evento encontrado")
        return
    larg_cad = max(max(len(l["cadeira"]) for l in linhas), len("cadeira"))
    larg_chap = max(max(len(l["chapeu"]) for l in linhas), len("chapeu"))
    print(f"  {'cadeira':<{larg_cad}}  {'chapeu':<{larg_chap}}  {'total':>7}  {'frase_sem_conceito':>19}  {'chapeu_sem_casamento':>21}")
    for l in linhas:
        print(f"  {l['cadeira']:<{larg_cad}}  {l['chapeu']:<{larg_chap}}  {l['total']:>7}  {l['frase_sem_conceito']:>19}  {l['chapeu_sem_casamento']:>21}")
    print(f"  {'total':<{larg_cad}}  {'':<{larg_chap}}  {total_eventos:>7}  {total_sem_conceito:>19}  {total_sem_casamento:>21}")


def main():
    d = reg()
    a = sys.argv[1:]
    # --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4): varre
    # todos os argumentos antes do despacho; nenhum ato chega a rodar. uso() sai 2.
    if any(x in ("--ajuda", "--help", "-h") for x in a):
        uso()
    if a and a[0] == "motor":
        sys.stderr.write("motor: primeiro argumento 'motor' desduplicado com aviso\n")
        a = a[1:]
    if a and a[0] == "casa":
        sys.stderr.write("motor: 'motor casa' redirecionado para `motor rag buscar casa` com aviso\n")
        a = ["rag", "buscar", "casa"] + a[1:]
    elif a and a[0] == "buscar":
        sys.stderr.write("motor: assumindo instancia 'rag' para `buscar` com aviso\n")
        a = ["rag"] + a
        # Lote pela tool (`ato: buscar`, args [rag, buscar, casa, ...]): a instancia e o ato chegam
        # repetidos atras do `buscar` que a tool ja pos na frente (#2856 linha 23).
        if len(a) >= 4 and a[2] in d and a[3] == "buscar":
            sys.stderr.write("motor: `buscar <inst> buscar` desduplicado com aviso\n")
            a = a[2:]
    if not a:
        uso()
    if a[0] == "listar":
        return cmd_listar(d)
    if a[0] not in d:
        print(f"nao conheco a instancia '{a[0]}'. Ha: {', '.join(d)}", file=sys.stderr)
        sys.exit(1)
    inst = d[a[0]]
    if inst["estado"] != "ativa":
        print(f"instancia '{a[0]}' esta {inst['estado']} — nenhum ato aceito", file=sys.stderr)
        sys.exit(1)
    if inst.get("tipo") == "marcacao-api":
        # a marcacao-api nao e motor de busca: sem ajuste, buscar, medir. Os atos sao os do cliente dela.
        sys.exit(marcacao.executar(inst["endpoint"], token_da(inst), a[1:]))
    if len(a) < 2:
        uso()
    if a[1] == "ajuste":
        return cmd_ajuste(a[0], inst, a[2:])
    if a[1] == "buscar":
        return cmd_buscar(a[0], inst, a[2:])
    if a[1] == "indexar":
        return cmd_indexar(inst, a[2:])
    if a[1] == "trocar":
        return cmd_trocar(inst, a[2:])
    if a[1] == "sortear":
        return cmd_sortear(inst, a[2:])
    if a[1] == "lintar":
        return cmd_lintar(inst, a[2:])
    if a[1] == "parear":
        return cmd_parear(d, inst, a[2:])
    if a[1] == "escrever":
        return cmd_escrever(d, inst, a[2:])
    if a[1] == "julgar":
        return cmd_julgar(d, inst, a[2:])
    if a[1] == "eleger":
        return cmd_eleger(a[0], inst, a[2:])
    if a[1] == "medir":
        return cmd_medir(a[0], inst, a[2:])
    print(f"ato desconhecido '{a[1]}'. {a[0]} aceita: ajuste, buscar, eleger, escrever, indexar, julgar, lintar, medir, parear, sortear, trocar", file=sys.stderr)
    sys.exit(1)


main()
