#!/usr/bin/env python3
# motor — gestao de motores de decisao: o que um motor serve e mede.
# capacidade: gestao-de-motores
# (arq:0043 — a capacidade e do subcomando; aqui os tres servem a mesma:
#  motor listar · motor <inst> buscar · motor <inst> ajuste)
# dono: claudinho-IA
# componente: platafirma-motor
# O verbo e `motor`; a instancia e argumento (arq:0037; veto do verbo `rag`).
import json, os, re, subprocess, sys, urllib.request

RAIZ = os.path.expanduser("~/AI")
REG = os.path.join(RAIZ, "platafirma-harness/registro/motor-instancias.json")
DOCKER = {"DOCKER_HOST": "unix:///run/user/1001/docker.sock"}


def sh(cmd, **kw):
    env = dict(os.environ, **DOCKER)
    return subprocess.run(cmd, shell=True, capture_output=True, text=True, env=env, **kw)


def reg():
    with open(REG) as f:
        return json.load(f)


def uso(cod=2):
    print("""motor — o que cada motor serve e mede

  motor listar                          instancias declaradas e estado
  motor <inst> ajuste                    todos os ajustes, com o valor de hoje
  motor <inst> ajuste <slug>             o que esse ajuste troca por que
  motor <inst> ajuste <slug> <valor>     mexe, promove e confere o servido
  motor <inst> buscar "<pergunta>" [--k N] [--texto secao|trecho|nenhum]
  motor <inst> indexar [--apply]        fases 2-5: materializa, chunka, embedda
                                        (o que ENTRA no corpus e `acervo ingerir`)

instancias: """ + ", ".join(reg().keys()))
    sys.exit(cod)


def servido(inst):
    """env efetivo do container; ausente = default do codigo."""
    c = inst.get("container")
    if not c:
        return {}, "instancia sem container"
    r = sh(f"docker inspect {c} --format '{{{{range .Config.Env}}}}{{{{println .}}}}{{{{end}}}}'")
    if r.returncode != 0:
        return None, f"container {c} fora do ar"
    return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l), None


def cmd_listar(d):
    for nome, i in d.items():
        print(f"{nome:12} {i['estado']:10} {i.get('container') or '-'}")


def caminho_env(inst):
    return os.path.join(RAIZ, inst.get("env_da_ingestao", ""))


def le_env_da_ingestao(inst):
    """Ajuste da metade OFFLINE. A ingestao nao roda em container: roda no host, com o venv do
    rag, e o `dotenv` do processo le este arquivo. Ler o compose para dizer o valor de corte
    diria o que o servico de BUSCA carrega — e a busca nao corta nada."""
    caminho = caminho_env(inst)
    if not caminho or not os.path.exists(caminho):
        return {}
    out = {}
    with open(caminho) as f:
        for linha in f:
            linha = linha.strip()
            if linha and not linha.startswith("#") and "=" in linha:
                k, v = linha.split("=", 1)
                out[k.strip()] = v.strip()
    return out


def escreve_no_env(inst, b, v, novo):
    """Grava no `.env` da ingestao. Sem commit e sem promover, de proposito: o arquivo carrega
    segredo e nao e versionado, e nao ha servico a reiniciar — o valor passa a valer na proxima
    ingestao, e so no que ela cortar."""
    caminho = caminho_env(inst)
    if not caminho or not os.path.exists(caminho):
        print(f"nao achei o env da ingestao ({caminho or 'nao declarado'})", file=sys.stderr)
        sys.exit(1)
    with open(caminho) as f:
        texto = f.read()
    pad = re.compile(rf"^{b['var']}=.*$", re.M)
    if pad.search(texto):
        texto = pad.sub(f"{b['var']}={novo}", texto, count=1)
    else:
        texto = texto.rstrip("\n") + f"\n{b['var']}={novo}\n"
    with open(caminho, "w") as f:
        f.write(texto)
    lido = le_env_da_ingestao(inst).get(b["var"])
    if lido != novo:
        print(f"NAO CONFERE: pedi {novo}, o arquivo le {lido}", file=sys.stderr)
        sys.exit(1)
    print(f"{b['slug']}: {v} -> {novo}  ({b['var']} em {inst['env_da_ingestao']})")
    print("CONFERIDO no arquivo. Nada foi promovido: isto e ajuste de CORTE, e corte so muda")
    print("o que a proxima ingestao cortar. O acervo ja indexado segue com o corte antigo —")
    print("comparar os dois no mesmo gold nao mede nada ate uma reingestao completa.")


def cmd_ajuste(nome, inst, argv):
    env, err = servido(inst)
    ajustes = {b["slug"]: b for b in inst["ajustes"]}

    if not argv:
        if err:
            print(f"[{err} — valores abaixo sao o DECLARADO, nao o servido]\n")
        larg = max(len(s) for s in ajustes)
        env_ing = le_env_da_ingestao(inst)
        for b in inst["ajustes"]:
            if b.get("onde") == "env":
                # Ajuste de INGESTAO: nao ha container servindo isto. A ingestao roda no host,
                # com o `.env` do repo — o valor do compose seria decorativo aqui.
                v = env_ing.get(b["var"])
                onde = "env da ingestao" if v is not None else "default do codigo"
            else:
                v = (env or {}).get(b["var"])
                onde = "compose" if v is not None else "default do codigo"
            mostrado = v if v not in (None, "") else b["codigo"] or "(vazio)"
            # Valor longo (instrucao de pergunta, nome de modelo) desalinha a coluna e some
            # com a fase, que e o que organiza a leitura. O inteiro sai no detalhe do ajuste.
            if len(mostrado) > 12:
                mostrado = mostrado[:11] + "\u2026"
            print(f"  {b['slug']:<{larg}}  {mostrado:>12}   fase {b['fase']:<14} ({onde})")
        print(f"\n  detalhe de um: motor {nome} ajuste <nome-do-ajuste>")
        print(f"  fora da lista, e por que: {', '.join(inst['nao_e_ajuste'])}")
        return

    slug = argv[0]
    if slug not in ajustes:
        print(f"nao existe ajuste '{slug}'. Ha: {', '.join(ajustes)}", file=sys.stderr)
        sys.exit(1)
    b = ajustes[slug]
    if b.get("onde") == "env":
        v = le_env_da_ingestao(inst).get(b["var"], b["codigo"])
    else:
        v = (env or {}).get(b["var"], b["codigo"])

    if len(argv) == 1:
        print(f"{b['slug']}   hoje: {v}   faixa: {b['faixa']}   fase {b['fase']}")
        print(f"  subir da  : {b['sobe']}")
        print(f"  e custa   : {b['custa']}")
        print(f"  como sei  : {b['medir']}")
        arquivo = (inst["env_da_ingestao"] if b.get("onde") == "env" else inst["compose"])
        print(f"  (variavel {b['var']}, no {arquivo})")
        return

    novo = argv[1]
    if b.get("onde") == "env":
        escreve_no_env(inst, b, v, novo)
        return
    tem_porta = (env or {}).get(b["var"]) is not None
    if tem_porta and v == novo:
        print(f"{slug} ja esta em {novo} no servido. Nada a fazer.")
        return
    caminho = os.path.join(RAIZ, inst["compose"])
    with open(caminho) as f:
        texto = f.read()
    pad = re.compile(rf"^(\s+){b['var']}:.*$", re.M)
    achou = pad.findall(texto)
    if len(achou) == 1:
        texto = pad.sub(lambda m: f"{m.group(1)}{b['var']}: {novo}", texto, count=1)
    elif len(achou) == 0:
        anc = re.compile(r"^(\s+)RAG_API_TOKEN:.*$", re.M)
        if not anc.search(texto):
            print(f"nao achei onde declarar {b['var']} em {inst['compose']}", file=sys.stderr)
            sys.exit(1)
        texto = anc.sub(lambda m: f"{m.group(1)}{b['var']}: {novo}\n{m.group(0)}", texto, count=1)
    else:
        print(f"{b['var']} aparece {len(achou)}x no compose — nao mexo as cegas", file=sys.stderr)
        sys.exit(1)
    with open(caminho, "w") as f:
        f.write(texto)
    print(f"{slug}: {v} -> {novo}  ({b['var']} em {inst['compose']})")

    repo = os.path.join(RAIZ, inst["compose"].split("/")[0])
    r = sh(f'git -C {repo} add -A && git -C {repo} commit -q -m "motor rag ajuste: {slug} {v} -> {novo}" && git -C {repo} push -q')
    if r.returncode != 0:
        print(f"git falhou, nao promovo: {r.stderr.strip()[-300:]}", file=sys.stderr)
        sys.exit(1)
    r = sh(f"{RAIZ}/bin/deploy {inst['stack']} promover")
    print(r.stdout.strip()[-300:] or r.stderr.strip()[-300:])

    env2, err2 = servido(inst)
    agora = (env2 or {}).get(b["var"], "?")
    if agora == novo:
        print(f"\nCONFERIDO no servido: {b['var']}={agora}")
    else:
        print(f"\nNAO CONFERE: pedi {novo}, o container serve {agora}", file=sys.stderr)
        sys.exit(1)


def python_do_rag():
    for c in [os.environ.get("RAG_PYTHON", ""),
              os.path.expanduser("~/AI/.venv/bin/python"),
              os.path.join(RAIZ, "platafirma-conhecimento/rag/.venv/bin/python"),
              os.path.expanduser("~/AI/.venv-testes/bin/python")]:
        if c and os.access(c, os.X_OK):
            return c
    print("motor rag indexar: nenhum python com rag_extractor executavel por este usuario.\n"
          "  aponte um com:  RAG_PYTHON=/caminho/para/python motor rag indexar ...", file=sys.stderr)
    sys.exit(1)


def cmd_indexar(inst, argv):
    """Fases 2-5 do trilho: materializa, chunka, embedda, propaga faceta, embedda meta.
    Fase 1 (o que entra no corpus) e curadoria: fica em `acervo ingerir`."""
    apply_ = "--apply" in argv
    rag = os.path.join(RAIZ, "platafirma-conhecimento/rag")
    py = python_do_rag()
    destino = os.environ.get("CORPUS_DIR", os.path.join(rag, "corpus"))
    passos = [
        ("materializacao — PDF e sidecar em " + destino,
         f"{py} -m rag_extractor.cli materializar-acervo {destino}" + (" --apply" if apply_ else "")),
        ("chunking  [degrau c]", f"{py} -m rag_extractor.cli ingest {destino}"),
        ("vetor de texto  [degrau d]", f"{py} -m rag_extractor.cli embed"),
        ("propagacao de faceta para documents/chunks",
         f"{py} -m rag_extractor.cli sincronizar-acervo" + (" --apply" if apply_ else "")),
        ("vetor de metadado  [degrau e]", f"{py} -m rag_extractor.cli embed-meta"),
    ]
    escada = os.path.join(RAIZ, "bin/acervo")
    print("\n== escada antes")
    print(sh(f"{escada} escada").stdout)
    for i, (titulo, cmd) in enumerate(passos, 1):
        print(f"\n== {i}/{len(passos)}  {titulo}")
        if not apply_ and (" embed" in cmd or " ingest " in cmd or "--apply" not in cmd):
            print(f"   (dry-run) rodaria: {cmd.split('cli ',1)[1]}")
            continue
        r = sh(f"cd {rag} && PYTHONPATH={rag} {cmd}")
        print((r.stdout or r.stderr).strip()[-1200:])
        if r.returncode != 0:
            print(f"\nPAROU no passo {i}: {titulo}", file=sys.stderr)
            sys.exit(1)
    print("\n== escada depois")
    print(sh(f"{escada} escada").stdout)
    if not apply_:
        print("DRY-RUN — nada foi escrito. Para valer:  motor rag indexar --apply")


def cmd_buscar(inst, argv):
    if not argv:
        print('motor <inst> buscar "<pergunta>" [--k N] [--texto secao|trecho|nenhum]', file=sys.stderr)
        sys.exit(2)
    corpo = {"pergunta": argv[0]}
    resto = argv[1:]
    for k, v in zip(resto[::2], resto[1::2]):
        k = k.lstrip("-")
        corpo[k] = int(v) if k == "k" else v
    tok = ""
    with open(os.path.join(RAIZ, inst["token_em"])) as f:
        for l in f:
            if l.startswith("RAG_API_TOKEN="):
                tok = l.split("=", 1)[1].strip().strip("\"'")
    req = urllib.request.Request(
        inst["endpoint"], data=json.dumps(corpo).encode(),
        headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=300) as r:
        print(r.read().decode())


def main():
    d = reg()
    a = sys.argv[1:]
    if not a:
        uso()
    if a[0] == "listar":
        return cmd_listar(d)
    if a[0] not in d:
        print(f"nao conheco a instancia '{a[0]}'. Ha: {', '.join(d)}", file=sys.stderr)
        sys.exit(1)
    inst = d[a[0]]
    if inst["estado"] != "ativa":
        print(f"instancia '{a[0]}' esta {inst['estado']} — nenhum ato aceito", file=sys.stderr)
        sys.exit(1)
    if len(a) < 2:
        uso()
    if a[1] == "ajuste":
        return cmd_ajuste(a[0], inst, a[2:])
    if a[1] == "buscar":
        return cmd_buscar(inst, a[2:])
    if a[1] == "indexar":
        return cmd_indexar(inst, a[2:])
    print(f"ato desconhecido '{a[1]}'. {a[0]} aceita: ajuste, buscar, indexar", file=sys.stderr)
    sys.exit(1)


main()
