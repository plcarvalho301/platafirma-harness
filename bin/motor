#!/usr/bin/env python3
# motor — busca semantica sobre uma particao do acervo: o que um motor serve e mede.
# capacidade: motor
# dono: ia
# componente: platafirma-motor
# classe: B
# use para: achar pelo sentido o trecho que responde a X (buscar <particao>, e `--geracao <id>` consulta a geracao em sombra antes de virar; o que o acervo tem sobre X se acha tambem pelo catalogo, `acervo listar --sobre`), medir a bateria de um motor (medir), indexar a impressao selada da obra marcada para indexar (indexar biblioteca), trocar o embedder da biblioteca montando a geracao nova em sombra, medindo e virando (trocar biblioteca), sortear do log de perguntas o estrato sentido da escada (sortear biblioteca), gravar e ler o lote da tela de marcacao do gold set (motor marcacao), ler/mexer um ajuste (ajuste)
# atos: listar (leitura, texto), ajuste (leitura|escrita, config), buscar (leitura, busca), medir (leitura, medida), indexar (escrita, indice), trocar (escrita, geracao), sortear (escrita, gabarito) — buscar/medir/indexar/trocar/sortear exigem particao: motor <inst> <ato> <particao> ...; a instancia `marcacao` (marcacao-api) fala os atos dela: lote (gravar|ler|ativar), eventos, juiz
# forma: json
# cauda: nao
# poda: cosmetica@rag,casa,buscar
# consome: rag-extractor-api@platafirma-conhecimento/rag/openapi.yaml >=1.0 (buscar, medir, indexar; endpoints por instancia em motor-instancias.json)
# ambiente: PLATAFIRMA_RELEASE origem-shell [=/opt/platafirma/current] (gabarito); PLATAFIRMA_INSTANCIA origem-shell [=/srv/platafirma/casa] (segredos, log, medicoes, sobreposicao do compose); OPS_LOG_DIR origem-shell [=$PLATAFIRMA_INSTANCIA/var/log/ops]; PF_BIN origem-shell (teste; ausente e o bin/ da propria arvore); PF_SESSAO porta; PF_ORDEM_ID porta; PF_CADEIRA porta; PF_CHAPEU porta; OPS_NAME porta; USER shell
# escreve: $PLATAFIRMA_INSTANCIA/var/log/ops/*.jsonl (evento consulta, best-effort); env da ingestao na instancia, arquivo NOME=valor ou $PLATAFIRMA_INSTANCIA/segredos/<stack>/<VAR> (ajuste de corte, via motor-instancias.json); $PLATAFIRMA_INSTANCIA/deploy/<stack>/compose.override.yaml (ajuste de container); $PLATAFIRMA_INSTANCIA/var/medicoes/*.json (medir)
# depende: docker (ajuste servido, medir banco); ajudante bin/_release/stack (ajuste que promove); rede (consome a API do rag)
# substitui: docker exec rag-* ; curl ao endpoint de busca
# O verbo e `motor`; a instancia e argumento (arq:0037; veto do verbo `rag`).
# atos: a capacidade e do (verbo, ato) (arq:0110 §6). Transicao vigente->conforme em spec_motor §5.
import json, os, re, shlex, subprocess, sys, time, urllib.error, urllib.request
from pathlib import Path

# Raizes da casa (card #3010). Codigo, registro e verbos irmaos vem da PROPRIA arvore
# (realpath); o que o registro nomeia resolve em duas raizes so: release (codigo do rag,
# gabarito) e instancia (segredos, log, medicoes, sobreposicao do compose).
_ARVORE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_ARVORE / "lib"))
import raizes  # noqa: E402
import oplog  # noqa: E402  (card #3344: o unico que escreve o bruto da porta)
sys.path.insert(0, str(_ARVORE / "bin" / "_motor"))
import calibra  # noqa: E402  (a calibracao do sinal de abstencao sobre medicoes salvas, #3264)
import marcacao  # noqa: E402  (cliente da marcacao-api, rotas /interno/, #3349)
import sorteio  # noqa: E402  (o sorteio do estrato sentido da escada, #3349)

REG = os.environ.get("PF_MOTOR_REG") or str(_ARVORE / "registro" / "motor-instancias.json")
BIN = os.environ.get("PF_BIN") or str(_ARVORE / "bin")
DOCKER = {"DOCKER_HOST": "unix:///run/user/1001/docker.sock"}


SPEC = "spec motor (acervo ler casa spec motor)"
# arq:0106 §3: as particoes sao biblioteca, casa e registro. `obra` e o nome anterior da
# biblioteca e segue aceito como sinonimo; a API do rag aceita biblioteca diretamente.
PARTICOES = ("biblioteca", "casa", "registro")
_SINONIMOS = {"obra": "biblioteca"}
_PARA_A_API = {}
_UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.IGNORECASE)

def resolve_particao(argv, ato):
    """Gramatica arq:0106: motor <inst> <ato> <particao>. Forma vigente sem particao
    NAO some em silencio: cai em 'biblioteca' com aviso ao stderr apontando a forma nova e
    a spec (spec_motor §5). Enquanto so a biblioteca esta povoada, o default e seguro."""
    if argv and (argv[0] in PARTICOES or argv[0] in _SINONIMOS):
        return _SINONIMOS.get(argv[0], argv[0]), argv[1:]
    sys.stderr.write(
        f"motor {ato}: sem particao — a forma conforme e "
        f"`motor <inst> {ato} <particao> ...` (particoes: {', '.join(PARTICOES)}).\n"
        f"  assumindo 'biblioteca' (unica povoada hoje); declare a particao.\n  {SPEC}\n")
    return "biblioteca", argv

def sh(cmd, env_extra=None, **kw):
    env = {**os.environ, **(env_extra or {}), **DOCKER}
    return subprocess.run(cmd, shell=True, capture_output=True, text=True, env=env, **kw)


# O registro nomeia caminho de producao pelo valor canonico das duas raizes (desenho §1-§3).
# A resolucao rebaseia esse prefixo em raizes.release()/raizes.instancia(), para o teste
# apontar tudo a um diretorio temporario. A forma relativa (<familia>/<caminho> na release,
# <stack> ou <stack>/<NOME> sob segredos/) segue aceita.
_CANON_RELEASE = "/opt/platafirma/current/"
_CANON_INSTANCIA = "/srv/platafirma/casa/"


def _seguro(rel, segmentos=None):
    """Nome relativo do registro nunca sai da raiz: nada absoluto, nada de '..', nenhum
    arquivo oculto (.env). `segmentos` fixa a forma: 1 = <stack>, 2 = <stack>/<NOME>."""
    partes = (rel or "").split("/")
    if not rel or rel.startswith("/") or ".." in partes or any(x.startswith(".") for x in partes):
        return False
    return segmentos is None or len(partes) == segmentos


def _curto(familia):
    return familia[len("platafirma-"):] if familia.startswith("platafirma-") else familia


def na_release(valor):
    """Campo de release do registro -> arquivo na release no ar ($PLATAFIRMA_RELEASE/<curto>/<caminho>).
    Aceita o canonico /opt/platafirma/current/<curto>/... e o logico <familia>/<caminho>.
    Fora das duas formas devolve ''."""
    valor = valor or ""
    if valor.startswith(_CANON_RELEASE):
        resto = valor[len(_CANON_RELEASE):]
        return str(raizes.release() / resto) if _seguro(resto) else ""
    if not _seguro(valor) or "/" not in valor:
        return ""
    familia, _, resto = valor.partition("/")
    return str(raizes.release() / _curto(familia) / resto)


def logico_da_release(valor):
    """Nome logico <familia>/<caminho> (chave estavel das medicoes, igual a das antigas)."""
    for prefixo in (_CANON_RELEASE, str(raizes.release()).rstrip("/") + "/"):
        if valor and valor.startswith(prefixo):
            curto, _, resto = valor[len(prefixo):].partition("/")
            return f"platafirma-{curto}/{resto}"
    return valor or ""


def na_instancia(valor, relativo_a=""):
    """Campo de instancia do registro -> caminho sob $PLATAFIRMA_INSTANCIA. Aceita o canonico
    /srv/platafirma/casa/... e o relativo (a `relativo_a` dentro da instancia). Invalido: ''."""
    valor = valor or ""
    if valor.startswith(_CANON_INSTANCIA):
        resto = valor[len(_CANON_INSTANCIA):]
        return str(raizes.instancia() / resto) if _seguro(resto) else ""
    if not _seguro(valor):
        return ""
    return str(raizes.instancia() / relativo_a / valor) if relativo_a else str(raizes.instancia() / valor)


def caminho_override(inst):
    """Sobreposicao da instancia (desenho §4): o compose base da release e so-leitura."""
    return str(raizes.instancia() / "deploy" / inst["stack"] / "compose.override.yaml")


def reg():
    with open(REG) as f:
        return json.load(f)


