def _erro(msg: str, codigo: int, como_json: bool) -> int:
    if como_json:
        print(json.dumps({"erro": msg}, ensure_ascii=False))
    else:
        print(msg, file=sys.stderr)
    return codigo


def _argv_da_linha(chamada: str, valores: dict) -> list[str]:
    """A chamada da linha do catalogo vira argv: cada `{campo}` e um token inteiro (a mensagem de
    delegacao, texto livre, nunca passa por shlex) e `{regua}` vira dois: especie e chave."""
    argv: list[str] = []
    for tok in shlex.split(chamada):
        if tok.startswith("{") and tok.endswith("}") and tok[1:-1] in valores:
            v = valores[tok[1:-1]]
            argv.extend(v if isinstance(v, list) else [v])
        else:
            argv.append(tok)
    return argv


def _ref_da_linha(chamada: str, valores: dict) -> str:
    ref = chamada
    for campo, v in valores.items():
        ref = ref.replace("{%s}" % campo, " ".join(v) if isinstance(v, list) else v)
    return f"verbo:{ref}"


def _recorta_regua(texto: str, especie: str) -> str | None:
    """Lista de verificacao: so `## Critérios` e `## Contrapontos` (o revisor aponta, nao conserta;
    curas, casos e rodape ficam fora). Padrao segue inteiro, ate a espécie ganhar recorte proprio."""
    if especie != "lista-de-verificacao":
        return texto
    saida: list[str] = []
    dentro = False
    for linha in texto.splitlines():
        m = re.match(r"^##\s+(.+?)\s*$", linha)
        if m:
            dentro = m.group(1).strip().lower() in SECOES_DA_REGUA
        if dentro:
            saida.append(linha)
    return "\n".join(saida).strip() or None


def _peca_da_linha(linha: dict, ref: str, rc: int, stdout: str, stderr: str, pergunta: str,
                   avisos: list[str], regua: list[str] | None) -> dict:
    peca_id = linha["peca"]
    env = {"peca": peca_id, "dono": linha["dono"], "ref": ref, "sha": None, "regime": linha["regime"],
           "volatilidade": linha["volatilidade"], "tokens": 0, "frescor": "indisponivel",
           "motivo": None, "conteudo": None}

    def indisponivel(motivo: str) -> dict:
        env["motivo"] = motivo[:200]
        avisos.append(f"peça `{peca_id}` indisponível: {env['motivo']}")
        return env

    if rc != 0:
        return indisponivel((stderr or stdout).strip() or f"exit {rc}")
    conteudo = stdout.strip()
    if peca_id == "acervo-consultado":
        try:
            d = json.loads(stdout)
        except (ValueError, TypeError):
            d = None
        if isinstance(d, dict):
            if d.get("erro"):
                return indisponivel(str(d["erro"]))
            conteudo = _portao_cobertura(d, pergunta, env)
    elif peca_id == "regua":
        conteudo = _recorta_regua(conteudo, (regua or [""])[0])
        if not conteudo:
            return indisponivel("regua sem `## Critérios` nem `## Contrapontos`")
    env.update(frescor="fresco", conteudo=conteudo, tokens=conta_tokens(conteudo),
               sha=sha_servido(conteudo))
    return env


def ato_montar_cadeirinha(cadeira_arg: str | None, chapeu: str | None, modo: str | None,
                          regua: list[str] | None, perfil: str, sem_acervo: bool,
                          como_json: bool) -> int:
    # etapa 1 — uso (spec cadeirinha §5): combinacao invalida e exit 2, com a lista do que vale
    if perfil != "cadeirinha":
        return _erro("--modo e --regua so valem com --perfil cadeirinha", 2, como_json)
    falta = [f for f, v in (("--chapeu", chapeu), ("--modo", modo)) if not v]
    if falta:
        return _erro(f"--perfil cadeirinha exige {' e '.join(falta)}: o roteador nao roda, quem "
                     "chama sabe o que pede", 2, como_json)
    if modo not in MODOS:
        return _erro(f"modo '{modo}' fora do vocabulário — modos: {', '.join(MODOS)}", 2, como_json)
    if regua:
        if modo not in MODOS_COM_REGUA:
            return _erro(f"--regua so vale em {' e '.join(MODOS_COM_REGUA)}; o modo '{modo}' nao a serve",
                         2, como_json)
        if regua[0] not in ESPECIES_REGUA:
            return _erro(f"--regua '{regua[0]}' nao serve — especies: {', '.join(ESPECIES_REGUA)}",
                         2, como_json)
    if cadeira_arg:
        return _erro("a cadeira da cadeirinha vem da sessao que o agente abriu (PF_CADEIRA), nunca de "
                     "argumento: aberta na sessao de outra cadeira, a lente que sai e a dela", 2, como_json)
    # etapa 2 — identidade
    cadeira, erro_cad = valida_cadeira(None)
    if not cadeira:
        return _erro(erro_cad or "sem cadeira: a porta não injetou", 3, como_json)
    valido, err_chapeu = valida_chapeu(cadeira, chapeu)
    if not valido:
        return _erro(f"erro: chapéu '{chapeu}' fora do vocabulário da cadeira '{cadeira}' — {err_chapeu}",
                     2, como_json)
    # o modo e documento de casa; o montador nao aceita modo sem documento
    rc_modo, out_modo, err_modo = executa_verbo(["acervo", "ler", "casa", "modo", modo], cadeira)
    if rc_modo == 1:
        return _erro(f"modo '{modo}' sem documento na casa (`acervo ler casa modo {modo}`): "
                     f"{(err_modo or out_modo).strip()[:160]}", 2, como_json)

    pergunta = sys.stdin.read().strip()
    avisos: list[str] = []
    if not os.environ.get("PF_ORIGEM_SESSAO"):
        avisos.append("sessao sem origem_sessao: a lente e a da cadeira da sessao em curso; o agente "
                      "abre a propria (`sessao abrir <cadeira> --origem <sessao_id de quem chamou>`)")
    valores = {"cadeira": cadeira, "chapeu": chapeu, "modo": modo, "regua": list(regua or []),
               "pergunta": pergunta}
    servidas: list[dict] = []
    for linha in CATALOGO_CADEIRINHA:
        peca_id = linha["peca"]
        if (peca_id == "regua" and not regua) or (peca_id == "acervo-consultado" and (not pergunta or sem_acervo)):
            continue
        ref = _ref_da_linha(linha["chamada"], {**valores, "pergunta": pergunta[:40]})
        if peca_id == "modo":
            rc, out, err = rc_modo, out_modo, err_modo
        else:
            rc, out, err = executa_verbo(_argv_da_linha(linha["chamada"], valores), cadeira)
        servidas.append(_peca_da_linha(linha, ref, rc, out, err, pergunta, avisos, regua))

    montador_sha = resolve_montador_sha()
    sessao_id = os.environ.get("PF_SESSAO") or None
    ordem_id = os.environ.get("PF_ORDEM_ID") or None
    reg_pacote = registra_pacote(cadeira, servidas, montador_sha, sid=sessao_id, oid=ordem_id)
    if os.environ.get("PF_FITA") and not reg_pacote.get("registrado"):
        avisos.append(f"registro do pacote não gravado: {reg_pacote.get('motivo')}")
    resultado = {
        "cadeira": cadeira, "nome_canonico": cadeira, "sessao_id": sessao_id, "ordem_id": ordem_id,
        "perfil": "cadeirinha", "modo": modo, "regua": list(regua) if regua else None,
        "chapeu": chapeu, "chapeus": chapeus_de(cadeira),
        "roteador": {"via": "comando", "slug": chapeu, "acertos": {},
                     "motivo": "perfil cadeirinha: chapéu dado por quem chama"},
        "pacote": {"pecas": len(servidas), "tokens": sum(e["tokens"] for e in servidas),
                   "metodo_tokens": medidor()[1], "montador_sha": montador_sha,
                   "montado_em": int(time.time()), "registro": reg_pacote},
        "pecas": servidas, "avisos": avisos,
    }
    if como_json:
        print(json.dumps(resultado, ensure_ascii=False))
        return 0
    return imprime_texto(resultado)


# ------------------------------------------------------------------ ato: catalogo
def ato_catalogo(como_json: bool = False, perfil: str = "cadeira") -> int:
    linhas = CATALOGO_CADEIRINHA if perfil == "cadeirinha" else CATALOGO
    # Etapa 3 (§4): "catalogo ausente" so existe quando o catalogo vier do acervo. Na
    # transicao ele mora neste arquivo e nao tem como faltar; a etapa e declarada, nao
    # simulada por variavel de ambiente (toda variavel lida tem origem nomeada).
    if como_json:
        print(json.dumps(linhas, ensure_ascii=False, indent=2))
        return 0

    print("# catálogo de peças (transição: declarado no verbo até averbação no acervo)")
    print(f"{'peça':<18} {'gatilho':<25} {'regime':<8} {'volatilidade':<12} {'dono':<20} chamada")
    print("-" * 110)
    for p in linhas:
        print(f"{p.get('peca', ''):<18} {p.get('gatilho', ''):<25} {p.get('regime', ''):<8} "
              f"{p.get('volatilidade', ''):<12} {p.get('dono', ''):<20} {p.get('chamada', '')}")
    return 0


# ------------------------------------------------------------------ ato: rotear
def ato_rotear(como_json: bool = False) -> int:
    cadeira, erro_cad = valida_cadeira()
    if not cadeira:
        if como_json:
            print(json.dumps({"erro": erro_cad}, ensure_ascii=False))
        else:
            print(erro_cad, file=sys.stderr)
        return 3

    pergunta = sys.stdin.read().strip()
    dec, erro_rot, rc_rot = executa_roteador(pergunta, cadeira)
    if rc_rot == 3:
        if como_json:
            print(json.dumps({"erro": erro_rot}, ensure_ascii=False))
        else:
            print(erro_rot, file=sys.stderr)
        return 3

    if como_json:
        print(json.dumps(dec, ensure_ascii=False))
    else:
        print(f"chapeu: {dec.get('slug') or 'null'}   roteador: {dec.get('via')}")
        if dec.get("motivo"):
            print(f"motivo: {dec.get('motivo')}")
    return 0


# ------------------------------------------------------------------ ato: montar
def ato_montar(cadeira_arg: str | None = None, chapeu_forcado: str | None = None,
               sem_acervo: bool = False, como_json: bool = False,
               perfil: str = "cadeira", modo: str | None = None,
               regua: list[str] | None = None) -> int:
    if perfil != "cadeira" or modo or regua:
        return ato_montar_cadeirinha(cadeira_arg, chapeu_forcado, modo, regua, perfil, sem_acervo,
                                     como_json)
    cadeira, erro_cad = valida_cadeira(cadeira_arg)
    if not cadeira:
        if como_json:
            print(json.dumps({"erro": erro_cad}, ensure_ascii=False))
        else:
            print(erro_cad, file=sys.stderr)
        return 3

    if chapeu_forcado:
        valido, err_chapeu = valida_chapeu(cadeira, chapeu_forcado)
        if not valido:
            msg = f"erro: chapéu '{chapeu_forcado}' fora do vocabulário da cadeira '{cadeira}' — {err_chapeu}"
            if como_json:
                print(json.dumps({"erro": msg}, ensure_ascii=False))
            else:
                print(msg, file=sys.stderr)
            return 2

    pergunta = sys.stdin.read().strip()

    # Roteador de chapéu
    if chapeu_forcado:
        roteador_info = {
            "via": "comando",
            "slug": chapeu_forcado,
            "acertos": {},
            "motivo": "chapéu forçado por argumento",
        }
        aviso_rot = None
    else:
        roteador_info, aviso_rot, _rc_rot = executa_roteador(pergunta, cadeira)

    chapeu_slug = roteador_info.get("slug")
    avisos: list[str] = []
    if aviso_rot:
        avisos.append(aviso_rot)
    elif not chapeu_slug:
        avisos.append(f"chapéu não roteado (fallback): {roteador_info.get('motivo')}")

    cat_por_id = {item["peca"]: item for item in CATALOGO}

    # Ordem de injeção por saliência (spec expediente §2, §7; #3146):
    # persona → [chapeu] → conduta → rotinas → alias-cadeiras → mesa → [acervo-consultado] → cadernos.
    # Com chapéu roteado ou forçado, o chapéu vem em 2º, entre persona e conduta; sem chapéu, persona → conduta → rotinas.
    ordem_chaves = ["persona"]
    if chapeu_slug:
        ordem_chaves.append("chapeu")
    ordem_chaves.append("conduta")
    ordem_chaves.append("rotinas")
    ordem_chaves.append("alias-cadeiras")
    ordem_chaves.append("mesa")
    if pergunta and not sem_acervo:
        ordem_chaves.append("acervo-consultado")
    ordem_chaves.append("cadernos")

    servidas: list[dict] = []

    for peca_id in ordem_chaves:
        meta = cat_por_id.get(peca_id, {})
        dono = meta.get("dono", "gestao-estrategica")
        regime = meta.get("regime", "valor")
        volatilidade = meta.get("volatilidade", "volatil")
        chamada_tmpl = meta.get("chamada", "")

        if peca_id == "conduta":
            cmd = "persona conduta"
            ref = "verbo:persona conduta"
        elif peca_id == "persona":
            cmd = f"persona ler {cadeira}"
            ref = f"verbo:persona ler {cadeira}"
        elif peca_id == "chapeu":
            cmd = f"persona ler {cadeira} --chapeu {chapeu_slug}"
            ref = f"verbo:persona ler {cadeira} --chapeu {chapeu_slug}"
        elif peca_id == "alias-cadeiras":
            cmd = "persona foto"
            ref = "verbo:persona foto"
        elif peca_id == "mesa":
            if chapeu_slug:
                cmd = f"mesa ver {chapeu_slug}"
                ref = f"verbo:mesa ver {chapeu_slug}"
            else:
                cmd = "mesa ver"
                ref = "verbo:mesa ver"
        elif peca_id == "acervo-consultado":
            # argv pronto: a pergunta e texto livre e nao passa por shlex
            cmd = ["motor", "rag", "buscar", "casa", pergunta, "--k", "6", "--texto", "secao"]
            ref = f'verbo:motor rag buscar casa "{pergunta[:40]}" --k 6 --texto secao'
        elif peca_id == "cadernos":
            if chapeu_slug:
                cmd = f"mesa caderno --chapeu {chapeu_slug}"
                ref = f"verbo:mesa caderno --chapeu {chapeu_slug}"
            else:
                cmd = "mesa caderno"
                ref = "verbo:mesa caderno"
        else:
            cmd = chamada_tmpl.replace("{cadeira}", cadeira).replace("{chapeu}", chapeu_slug or "")
            ref = f"verbo:{cmd}"

        env = {
            "peca": peca_id,
            "dono": dono,
            "ref": ref,
            "sha": None,
            "regime": regime,
            "volatilidade": volatilidade,
            "tokens": 0,
            "frescor": "indisponivel",
            "motivo": None,
            "conteudo": None,
        }

        rc, stdout, stderr = executa_verbo(cmd, cadeira)
        if rc != 0:
            env["frescor"] = "indisponivel"
            motivo = (stderr or stdout).strip()[:200] or f"exit {rc}"
            env["motivo"] = motivo
            avisos.append(f"peça `{peca_id}` indisponível: {motivo}")
            servidas.append(env)
            continue

        # Sucesso
        conteudo_bruto = stdout.strip()
        if peca_id == "acervo-consultado":
            try:
                d_acervo = json.loads(stdout)
                if isinstance(d_acervo, dict):
                    if d_acervo.get("erro"):
                        env["frescor"] = "indisponivel"
                        motivo = str(d_acervo["erro"])[:200]
                        env["motivo"] = motivo
                        avisos.append(f"peça `acervo-consultado` indisponível: {motivo}")
                        servidas.append(env)
                        continue
                    conteudo_bruto = _portao_cobertura(d_acervo, pergunta, env)
            except (ValueError, TypeError):
                conteudo_bruto = stdout.strip()

        env["frescor"] = "fresco"
        env["conteudo"] = conteudo_bruto
        env["tokens"] = conta_tokens(conteudo_bruto)
        env["sha"] = sha_servido(conteudo_bruto)
        servidas.append(env)

    montador_sha = resolve_montador_sha()
    sessao_id = os.environ.get("PF_SESSAO") or None
    ordem_id = os.environ.get("PF_ORDEM_ID") or None

    reg_pacote = registra_pacote(cadeira, servidas, montador_sha, sid=sessao_id, oid=ordem_id)
    if os.environ.get("PF_FITA") and not reg_pacote.get("registrado"):
        avisos.append(f"registro do pacote não gravado: {reg_pacote.get('motivo')}")

    total_tokens = sum(e["tokens"] for e in servidas)
    pacote_info = {
        "pecas": len(servidas),
        "tokens": total_tokens,
        "metodo_tokens": medidor()[1],
        "montador_sha": montador_sha,
        "montado_em": int(time.time()),
        "registro": reg_pacote,
    }

    resultado = {
        "cadeira": cadeira,
        "nome_canonico": cadeira,
        "sessao_id": sessao_id,
        "ordem_id": ordem_id,
        "chapeu": chapeu_slug,
        "chapeus": chapeus_de(cadeira),
        "roteador": roteador_info,
        "pacote": pacote_info,
        "pecas": servidas,
        "avisos": avisos,
    }

    if como_json:
        print(json.dumps(resultado, ensure_ascii=False))
        return 0

    return imprime_texto(resultado)


def imprime_texto(pac: dict) -> int:
    """Imprime pacote no formato texto conforme spec_expediente §3."""
    cad = pac.get("cadeira")
    sid = pac.get("sessao_id") or "null"
    oid = pac.get("ordem_id") or "null"
    chapeu = pac.get("chapeu") or "null"
    rot = pac.get("roteador") or {}
    via = rot.get("via", "fallback")
    pacote = pac.get("pacote") or {}
    n_pecas = pacote.get("pecas", 0)
    tokens = pacote.get("tokens", 0)
    metodo_tk = pacote.get("metodo_tokens", "qwen2.5")

    print(f"cadeira: {cad}   sessao_id: {sid}   ordem_id: {oid}")
    print(f"chapeu: {chapeu}   roteador: {via}")
    if pac.get("perfil"):
        print(f"perfil: {pac['perfil']}   modo: {pac.get('modo')}"
              + (f"   regua: {' '.join(pac['regua'])}" if pac.get("regua") else ""))
    print(f"pacote: {n_pecas} peças · {tokens} tokens · {metodo_tk}")

    for e in pac.get("pecas", []):
        sha = f" @{e['sha']}" if e.get("sha") else ""
        print(f"===== {e['peca']}: {e['ref']}{sha} ({e['frescor']}, {e['tokens']} tokens) =====")
        if e.get("conteudo") is not None:
            print(e["conteudo"])
        else:
            print(f"(INDISPONÍVEL — {e.get('motivo')})")
        print()

    avisos = pac.get("avisos") or []
    if avisos:
        print("avisos:")
        for a in avisos:
            print(f"  (aviso: {a})")

    return 0


# ------------------------------------------------------------------ CLI / main
def main() -> int:
    # Trata --json com erro em stdout quando argumento/ato inválido
    argv = sys.argv[1:]
    como_json = "--json" in argv

    parser = Uso(
        descricao="monta o pacote de expediente da cadeira (conduta, persona, mesa, cadernos)",
        saidas="0 ok · 2 uso · 3 sem cadeira / catálogo ausente",
    )
    atos = parser.atos()

    p_montar = atos.novo("montar", "monta o pacote na ordem do §2; com pergunta, roteia o chapéu e consulta o acervo")
    p_montar.add_argument("cadeira", nargs="?", default=None, help="slug da cadeira (opcional; fallback PF_CADEIRA)")
    p_montar.add_argument("--chapeu", metavar="<slug>", help="força o slug do chapéu (ignora roteador)")
    p_montar.add_argument("--sem-acervo", action="store_true", help="omite a consulta ao acervo")
    p_montar.add_argument("--perfil", choices=PERFIS, default="cadeira",
                          help="cadeira (o padrão) ou cadeirinha: a lente sem a conduta, para quem trabalha por delegação")
    p_montar.add_argument("--modo", metavar="<slug>", help="o modo do agente (só com --perfil cadeirinha)")
    p_montar.add_argument("--regua", nargs=2, metavar=("<espécie>", "<chave>"),
                          help="a régua que o agente aplica (só em revisar e avaliar)")
    p_montar.add_argument("--json", action="store_true", help="saída em formato JSON")

    p_rotear = atos.novo("rotear", "só o roteador: pergunta → chapéu, com via (determinístico, semântico, fallback)")
    p_rotear.add_argument("--json", action="store_true", help="saída em formato JSON")

    p_catalogo = atos.novo("catalogo", "as peças do catálogo e metadados")
    p_catalogo.add_argument("--perfil", choices=PERFIS, default="cadeira", help="as linhas do perfil")
    p_catalogo.add_argument("--json", action="store_true", help="saída em formato JSON")

    if not argv:
        parser.error("falta o ato")

    primeiro = argv[0]
    if primeiro in ("-h", "--help", "--ajuda"):
        parser.print_help(sys.stdout)
        sys.exit(0)

    if primeiro not in ("montar", "rotear", "catalogo"):
        if como_json:
            print(json.dumps({"erro": f"ato desconhecido: '{primeiro}'"}, ensure_ascii=False))
            sys.exit(2)
        parser.error(f"ato desconhecido: '{primeiro}'")

    args = parser.parse_args()

    if args.ato == "catalogo":
        return ato_catalogo(como_json=args.json, perfil=args.perfil)
    elif args.ato == "rotear":
        return ato_rotear(como_json=args.json)
    elif args.ato == "montar":
        return ato_montar(
            cadeira_arg=args.cadeira,
            chapeu_forcado=args.chapeu,
            sem_acervo=args.sem_acervo,
            como_json=args.json,
            perfil=args.perfil,
            modo=args.modo,
            regua=args.regua,
        )
    return 2


if __name__ == "__main__":
    sys.exit(main())
