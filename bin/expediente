def _erro(msg: str, codigo: int, como_json: bool) -> int:
    if como_json:
        print(json.dumps({"erro": msg}, ensure_ascii=False))
    else:
        print(msg, file=sys.stderr)
    return codigo


def _argv_da_linha(chamada: str, valores: dict) -> list[str]:
    argv: list[str] = []
    for tok in shlex.split(chamada):
        if tok.startswith("{") and tok.endswith("}") and tok[1:-1] in valores:
            v = valores[tok[1:-1]]
            argv.extend(v if isinstance(v, list) else [v])
        else:
            argv.append(tok)
    return argv


def _ref_da_linha(chamada: str, valores: dict) -> str:
    ref = chamada
    for campo, v in valores.items():
        ref = ref.replace("{%s}" % campo, " ".join(v) if isinstance(v, list) else v)
    return f"verbo:{ref}"


def _recorta_regua(texto: str, especie: str) -> str | None:
    if especie != "lista-de-verificacao":
        return texto
    saida: list[str] = []
    dentro = False
    for linha in texto.splitlines():
        m = re.match(r"^##\s+(.+?)\s*$", linha)
        if m:
            dentro = m.group(1).strip().lower() in SECOES_DA_REGUA
        if dentro:
            saida.append(linha)
    return "\n".join(saida).strip() or None


def _conteudo_do_verbo_persona(stdout: str, avisos: list[str]) -> str:
    try:
        d = json.loads(stdout)
    except (ValueError, TypeError):
        return stdout.strip()
    if not isinstance(d, dict):
        return stdout.strip()
    avisos.extend(a for a in d.get("avisos") or [] if a not in avisos)
    return (d.get("conteudo") or "").strip()


def _peca_da_linha(linha: dict, ref: str, rc: int, stdout: str, stderr: str, pergunta: str,
                   avisos: list[str], regua: list[str] | None) -> dict | None:
    peca_id = linha["peca"]
    env = {"peca": peca_id, "dono": linha["dono"], "ref": ref, "sha": None, "regime": linha["regime"],
           "volatilidade": linha["volatilidade"], "tokens": 0, "frescor": "indisponivel",
           "motivo": None, "conteudo": None}

    def indisponivel(motivo: str) -> dict:
        env["motivo"] = motivo[:200]
        avisos.append(f"peça `{peca_id}` indisponível: {env['motivo']}")
        return env

    if rc != 0:
        return indisponivel((stderr or stdout).strip() or f"exit {rc}")
    conteudo = stdout.strip()
    if peca_id == "acervo-consultado":
        try:
            d = json.loads(stdout)
        except (ValueError, TypeError):
            d = None
        if isinstance(d, dict):
            if d.get("erro"):
                return indisponivel(str(d["erro"]))
            conteudo = _portao_cobertura(d, pergunta, env)
    elif peca_id == "regua":
        conteudo = _recorta_regua(conteudo, (regua or [""])[0])
        if not conteudo:
            return indisponivel("regua sem `## Critérios` nem `## Contrapontos`")
    elif peca_id == "posturas":
        conteudo = _conteudo_do_verbo_persona(stdout, avisos)
        if not conteudo:
            return None
    env.update(frescor="fresco", conteudo=conteudo, tokens=conta_tokens(conteudo),
               sha=sha_servido(conteudo))
    return env


def ato_montar_cadeirinha(cadeira_arg: str | None, chapeu: str | None, modo: str | None,
                          regua: list[str] | None, perfil: str, sem_acervo: bool,
                          como_json: bool) -> int:
    if perfil != "cadeirinha":
        return _erro("--modo e --regua so valem com --perfil cadeirinha", 2, como_json)
    falta = [f for f, v in (("--chapeu", chapeu), ("--modo", modo)) if not v]
    if falta:
        return _erro(f"--perfil cadeirinha exige {' e '.join(falta)}: o roteador nao roda, quem "
                     "chama sabe o que pede", 2, como_json)
    if modo not in MODOS:
        return _erro(f"modo '{modo}' fora do vocabulário — modos: {', '.join(MODOS)}", 2, como_json)
    if regua:
        if modo not in MODOS_COM_REGUA:
            return _erro(f"--regua so vale em {' e '.join(MODOS_COM_REGUA)}; o modo '{modo}' nao a serve",
                         2, como_json)
        if regua[0] not in ESPECIES_REGUA:
            return _erro(f"--regua '{regua[0]}' nao serve — especies: {', '.join(ESPECIES_REGUA)}",
                         2, como_json)
    if cadeira_arg:
        return _erro("a cadeira da cadeirinha vem da sessao que o agente abriu (PF_CADEIRA), nunca de "
                     "argumento: aberta na sessao de outra cadeira, a lente que sai e a dela", 2, como_json)
    cadeira, erro_cad = valida_cadeira(None)
    if not cadeira:
        return _erro(erro_cad or "sem cadeira: a porta não injetou", 3, como_json)
    chapeu, aviso_chapeu, erro_res = resolve_chapeu(cadeira, chapeu)
    if erro_res:
        return _erro(erro_res, 2, como_json)
    valido, err_chapeu = valida_chapeu(cadeira, chapeu)
    if not valido:
        return _erro(f"erro: chapéu '{chapeu}' fora do vocabulário da cadeira '{cadeira}' — {err_chapeu}",
                     2, como_json)
    rc_modo, out_modo, err_modo = executa_verbo(["acervo", "ler", "casa", "modo", modo], cadeira)
    if rc_modo == 1:
        return _erro(f"modo '{modo}' sem documento na casa (`acervo ler casa modo {modo}`): "
                     f"{(err_modo or out_modo).strip()[:160]}", 2, como_json)

    pergunta = sys.stdin.read().strip()
    avisos: list[str] = [aviso_chapeu] if aviso_chapeu else []
    if not os.environ.get("PF_ORIGEM_SESSAO"):
        avisos.append("sessao sem origem_sessao: a lente e a da cadeira da sessao em curso; o agente "
                      "abre a propria (`sessao abrir <cadeira> --origem <sessao_id de quem chamou>`)")
    valores = {"cadeira": cadeira, "chapeu": chapeu, "modo": modo, "regua": list(regua or []),
               "pergunta": pergunta}
    servidas: list[dict] = []
    for linha in CATALOGO_CADEIRINHA:
        peca_id = linha["peca"]
        if (peca_id == "regua" and not regua) or (peca_id == "acervo-consultado" and (not pergunta or sem_acervo)):
            continue
        ref = _ref_da_linha(linha["chamada"], {**valores, "pergunta": pergunta[:40]})
        if peca_id == "modo":
            rc, out, err = rc_modo, out_modo, err_modo
        else:
            rc, out, err = executa_verbo(_argv_da_linha(linha["chamada"], valores), cadeira)
        servida = _peca_da_linha(linha, ref, rc, out, err, pergunta, avisos, regua)
        if servida is not None:
            servidas.append(servida)

    montador_sha = resolve_montador_sha()
    sessao_id = os.environ.get("PF_SESSAO") or None
    ordem_id = os.environ.get("PF_ORDEM_ID") or None
    reg_pacote = registra_pacote(cadeira, servidas, montador_sha, sid=sessao_id, oid=ordem_id)
    if os.environ.get("PF_FITA") and not reg_pacote.get("registrado"):
        avisos.append(f"registro do pacote não gravado: {reg_pacote.get('motivo')}")
    resultado = {
        "cadeira": cadeira, "nome_canonico": cadeira, "sessao_id": sessao_id, "ordem_id": ordem_id,
        "perfil": "cadeirinha", "modo": modo, "regua": list(regua) if regua else None,
        "chapeu": chapeu, "chapeus": chapeus_de(cadeira),
        "roteador": {"via": "comando", "slug": chapeu, "acertos": {},
                     "motivo": "perfil cadeirinha: chapéu dado por quem chama"},
        "pacote": {"pecas": len(servidas), "tokens": sum(e["tokens"] for e in servidas),
                   "metodo_tokens": medidor()[1], "montador_sha": montador_sha,
                   "montado_em": int(time.time()), "registro": reg_pacote},
        "pecas": servidas, "avisos": avisos,
    }
    if como_json:
        print(json.dumps(resultado, ensure_ascii=False))
        return 0
    return imprime_texto(resultado)


# ------------------------------------------------------------------ ato: catalogo
def ato_catalogo(como_json: bool = False, perfil: str = "cadeira") -> int:
    linhas = CATALOGO_CADEIRINHA if perfil == "cadeirinha" else CATALOGO
    if como_json:
        print(json.dumps(linhas, ensure_ascii=False, indent=2))
        return 0

    print("# catálogo de peças")
    print(f"{'peça':<18} {'gatilho':<25} {'regime':<8} {'volatilidade':<12} {'dono':<20} chamada")
    print("-" * 110)
    for p in linhas:
        print(f"{p.get('peca', ''):<18} {p.get('gatilho', ''):<25} {p.get('regime', ''):<8} "
              f"{p.get('volatilidade', ''):<12} {p.get('dono', ''):<20} {p.get('chamada', '')}")
    return 0


# ------------------------------------------------------------------ ato: rotear
def ato_rotear(como_json: bool = False) -> int:
    cadeira, erro_cad = valida_cadeira()
    if not cadeira:
        if como_json:
            print(json.dumps({"erro": erro_cad}, ensure_ascii=False))
        else:
            print(erro_cad, file=sys.stderr)
        return 3

    pergunta = sys.stdin.read().strip()
    dec, erro_rot, rc_rot = executa_roteador(pergunta, cadeira)
    if rc_rot == 3:
        if como_json:
            print(json.dumps({"erro": erro_rot}, ensure_ascii=False))
        else:
            print(erro_rot, file=sys.stderr)
        return 3

    if como_json:
        print(json.dumps(dec, ensure_ascii=False))
    else:
        print(f"chapeu: {dec.get('slug') or 'null'}   roteador: {dec.get('via')}")
        if dec.get("motivo"):
            print(f"motivo: {dec.get('motivo')}")
    return 0


# ------------------------------------------------------------------ abertura (ato: montar)
class _LeitorDeJson:
    def __init__(self, caminho: Path) -> None:
        self._caminho = caminho

    def processos_de_rotina(self) -> list[FichaDeProcesso]:
        dados = json.loads(self._caminho.read_text(encoding="utf-8"))
        lista = dados.get("processos") if isinstance(dados, dict) else dados
        return [
            FichaDeProcesso(
                chave=str(item.get("chave") or ""),
                gatilhos=item.get("gatilhos") or (),
                produz=item.get("produz") or (),
                classe=str(item.get("classe") or ""),
                conteudo=str(item.get("conteudo") or ""),
            )
            for item in (lista or [])
            if isinstance(item, dict)
        ]


def _obter_leitor_de_processos(leitor: LeitorDeProcessos | None = None) -> LeitorDeProcessos:
    if leitor is not None:
        return leitor
    fixture = os.environ.get("PF_ROTINAS_FIXTURE")
    if fixture and Path(fixture).is_file():
        return _LeitorDeJson(Path(fixture))
    return Ligacoes()


def _carregar_secao_abertura(cadeira_hint: str) -> SecaoDasCadeiras:
    fixture = os.environ.get("PF_NOMES_FIXTURE") or os.environ.get("PF_SECAO_CADEIRAS")
    if fixture and Path(fixture).is_file():
        return carregar_secao_das_cadeiras()
    if _acha_bin("persona") is not None:
        rc, out, _ = executa_verbo(["persona", "nomes"], cadeira_hint or "engenharia")
        if rc == 0 and out.strip():
            secao = SecaoDasCadeiras.de_texto(out)
            if secao.cadeiras:
                return secao
    return carregar_secao_das_cadeiras()


class _LeitorRoteiroJson:
    def __init__(self, caminho: Path) -> None:
        self._caminho = caminho

    def construido_de(self, roteiro: str = "porta") -> list[PecaDoRoteiro]:
        dados = json.loads(self._caminho.read_text(encoding="utf-8"))
        if isinstance(dados, dict) and dados.get("sem_banco"):
            raise SemBanco(str(dados.get("erro") or "Olaria indisponível"))
        lista = dados.get("pecas") if isinstance(dados, dict) else dados
        saida: list[PecaDoRoteiro] = []
        for item in (lista or []):
            if isinstance(item, dict):
                saida.append(PecaDoRoteiro(
                    classe=str(item.get("classe") or ""),
                    chave=str(item.get("chave") or ""),
                    posicao=item.get("posicao"),
                ))
            elif isinstance(item, list) and item[1:]:
                saida.append(PecaDoRoteiro(classe=str(item[0]), chave=str(item[1])))
        return saida


def _obter_leitor_de_roteiro(leitor: LeitorDoRoteiro | None = None) -> LeitorDoRoteiro:
    if leitor is not None:
        return leitor
    fixture = os.environ.get("PF_ROTEIRO_FIXTURE")
    if fixture and Path(fixture).is_file():
        return _LeitorRoteiroJson(Path(fixture))
    return Ligacoes()


_PARTE_CLI_POR_CLASSE = {
    "postura": "posturas",
    "cenario": "cenario",
    "circunstancia": "circunstancia",
    "ritual": "ritual",
}


class _LeitorDeParteVerbo:
    def _comando(
        self, classe: str, cadeira: str, chapeu: str | None, chave: str | None
    ) -> tuple[list[str], str, bool] | None:
        if classe == "persona":
            alvo = chave or cadeira
            return ["persona", "ler", alvo, "--parte", "persona"], f"verbo:persona ler {alvo} --parte persona", False
        if classe == "chapeu":
            alvo_ch = chave or chapeu or ""
            return ["persona", "ler", cadeira, "--chapeu", alvo_ch], f"verbo:persona ler {cadeira} --chapeu {alvo_ch}", False
        if classe == "cultura":
            return ["persona", "cultura"], "verbo:persona cultura", False
        parte_cli = _PARTE_CLI_POR_CLASSE.get(classe)
        if not parte_cli:
            return None
        com_ch = ["--chapeu", chapeu] if (chapeu and classe == "postura" and not chave) else []
        com_chave = ["--chave", chave] if chave else []
        cmd = ["persona", "ler", cadeira, "--parte", parte_cli, *com_ch, *com_chave, "--json"]
        ref = (
            f"verbo:persona ler {cadeira} --parte {parte_cli}"
            + (f" --chapeu {chapeu}" if com_ch else "")
            + (f" --chave {chave}" if com_chave else "")
        )
        return cmd, ref, True

    def ler(
        self,
        classe: str,
        cadeira: str,
        chapeu: str | None,
        *,
        chave: str | None = None,
    ) -> ParteLida:
        espec = self._comando(classe, cadeira, chapeu, chave)
        if espec is None:
            return ParteLida(
                ok=False,
                conteudo="",
                ref=f"verbo:persona ({classe})",
                erro=f"classe '{classe}' sem leitura no verbo persona",
            )
        cmd, ref, usa_json = espec
        rc, stdout, stderr = executa_verbo(cmd, cadeira)
        if rc != 0:
            motivo = (stderr or stdout).strip()[:200] or f"exit {rc}"
            return ParteLida(ok=False, conteudo="", ref=ref, erro=motivo)
        if not usa_json:
            inst = (chave or cadeira,) if classe == "persona" else (
                (chave or chapeu,) if (classe == "chapeu" and (chave or chapeu)) else ("da-casa",)
            )
            return ParteLida(ok=True, conteudo=stdout.strip(), ref=ref, instancias=inst)
        return self._interpretar_json(classe, ref, stdout)

    def _interpretar_json(self, classe: str, ref: str, stdout: str) -> ParteLida:
        try:
            d = json.loads(stdout)
        except (ValueError, TypeError):
            return ParteLida(ok=True, conteudo=stdout.strip(), ref=ref)
        if not isinstance(d, dict):
            return ParteLida(ok=True, conteudo=stdout.strip(), ref=ref)
        conteudo = (d.get("conteudo") or "").strip()
        avisos_p = tuple(str(a) for a in (d.get("avisos") or []) if a)
        instancias: tuple[str, ...] = ()
        if classe == "postura" and d.get("perfil"):
            instancias = (str(d["perfil"]),)
        elif classe == "cenario":
            instancias = tuple(str(c) for c in (d.get("cenarios") or []) if c)
        elif classe == "circunstancia" and d.get("circunstancia"):
            instancias = (str(d["circunstancia"]),)
        elif classe == "ritual" and d.get("ritual"):
            instancias = (str(d["ritual"]),)
        return ParteLida(
            ok=True,
            conteudo=conteudo,
            ref=ref,
            instancias=instancias,
            avisos=avisos_p,
        )


def _montar_roteiro(
    cadeira: str,
    chapeu_slug: str | None,
    avisos: list[str],
    *,
    leitor_roteiro: LeitorDoRoteiro | None = None,
    overrides: tuple[tuple[str, str], ...] = (),
) -> dict:
    montado = montar_roteiro_ficha(
        PedidoDeRoteiro(cadeira=cadeira, chapeu=chapeu_slug, overrides=overrides),
        _obter_leitor_de_roteiro(leitor_roteiro),
        _LeitorDeParteVerbo(),
    )
    for av in montado.avisos:
        if av not in avisos:
            avisos.append(av)
    partes_servidas = [
        {
            **p.como_dict(),
            "tokens": conta_tokens(p.conteudo or ""),
            "sha": sha_servido(p.conteudo) if p.conteudo else None,
        }
        for p in montado.partes
    ]
    conteudo = montado.conteudo
    return {
        "peca": "roteiro",
        "dono": "produto",
        "ref": f"verbo:persona ler {cadeira}" + (f" --chapeu {chapeu_slug}" if chapeu_slug else ""),
        "sha": sha_servido(conteudo) if conteudo else None,
        "regime": "valor",
        "volatilidade": "estavel",
        "tokens": conta_tokens(conteudo),
        "frescor": "fresco" if conteudo else "indisponivel",
        "motivo": None if conteudo else "roteiro vazio",
        "conteudo": conteudo,
        "partes": partes_servidas,
    }


def _montar_rotinas(leitor: LeitorDeProcessos, avisos: list[str]) -> tuple[dict, list[dict]]:
    erro_banco: str | None = None
    try:
        servidos, recusas = carregar_rotinas(leitor)
    except SemBanco as e:
        servidos, recusas = [], []
        erro_banco = str(e)[:200]
        avisos.append(f"peça `rotinas` sem banco: {erro_banco}")

    for rec in recusas:
        avisos.append(rec.mensagem or f"processo {rec.processo} recusado: {rec.codigo}")

    conteudo = formatar_rotinas(servidos)
    recusas_dicts = [r.como_dict() for r in recusas]
    env = {
        "peca": "rotinas",
        "dono": "gestao-estrategica",
        "ref": "casa:processos_de_rotina",
        "sha": sha_servido(conteudo) if conteudo else None,
        "regime": "valor",
        "volatilidade": "estavel",
        "tokens": conta_tokens(conteudo),
        "frescor": "indisponivel" if erro_banco else "fresco",
        "motivo": erro_banco,
        "conteudo": conteudo,
        "processos": [p.como_dict() for p in servidos],
        "recusas": recusas_dicts,
    }
    return env, recusas_dicts


def _montar_pauta(cadeira: str, chapeu_slug: str | None, pergunta: str, avisos: list[str]) -> dict:
    guardados, transicoes = carregar_guardados_da_lousa(
        cadeira,
        lousa_do_ambiente(),
        avisos=avisos,
    )

    cartas = []
    if _acha_bin("fila") is not None:
        rc_fila, out_fila, _ = executa_verbo("fila ler", cadeira)
        if rc_fila == 0:
            cartas = ler_cartas_da_fila(out_fila)

    sessao_ctx = ContextoDaSessao(
        cadeira=cadeira,
        chapeu=chapeu_slug,
        turno=pergunta,
        transicoes_de_card=transicoes,
    )
    pauta = montar_pauta(guardados, cartas, sessao_ctx)
    return {
        "peca": "pauta",
        "dono": "gestao-estrategica",
        "ref": "lousa + fila ler",
        "sha": sha_servido(pauta.conteudo) if pauta.conteudo else None,
        "regime": "valor",
        "volatilidade": "volatil",
        "tokens": conta_tokens(pauta.conteudo),
        "frescor": "fresco",
        "motivo": None,
        "conteudo": pauta.conteudo,
        "turno": pauta.turno,
        "guardados": [g.como_dict() for g in pauta.guardados],
        "total_guardados": pauta.total_guardados,
        "fora_da_ocasiao": pauta.fora_da_ocasiao,
        "cartas": [c.como_dict() for c in pauta.cartas],
    }


def _abrir_sessao_se_ausente(cadeira: str) -> tuple[str | None, str | None, dict | None]:
    sessao_id = (os.environ.get("PF_SESSAO") or "").strip() or None
    ordem_id = (os.environ.get("PF_ORDEM_ID") or "").strip() or None
    if sessao_id or _acha_bin("sessao") is None:
        return sessao_id, ordem_id, None
    rc_ses, out_ses, _ = executa_verbo(["sessao", "abrir", cadeira, "--json"], cadeira)
    if rc_ses != 0 or not out_ses.strip():
        return sessao_id, ordem_id, None
    d_ses = json.loads(out_ses)
    if not isinstance(d_ses, dict):
        return sessao_id, ordem_id, None
    return d_ses.get("sessao_id") or sessao_id, d_ses.get("ordem_id") or ordem_id, d_ses


def _fechar_abandonadas_e_abrir(cadeira: str, sessao_id: str | None):
    """S4335 t2: fecha como abandonadas as sessões do mesmo sujeito que pararam sem descanso e emite a sessão
    aberta desta. Nunca derruba a abertura: o que falhar aqui vira aviso."""
    try:
        from descanso import eventos as ev_descanso
        from descanso.abandono import fechar_abandonadas
        from descanso.memoria import memoria_do_ambiente
    except ImportError:
        return None
    sujeito = ev_descanso.sujeito_do_ambiente(cadeira)
    fech = fechar_abandonadas(sujeito, memoria_do_ambiente(), sessao_atual=sessao_id)
    if sessao_id:
        ev_descanso.emitir_aberta(sessao_id, sujeito=sujeito, cadeira=cadeira)
    return fech


def _entrada_da_abertura(
    cadeira_arg: str | None, chapeu_forcado: str | None, pergunta: str
) -> tuple[str, str | None, tuple[tuple[str, str], ...], list[str], str]:
    tupla = extrair_tupla(pergunta)
    if tupla is not None:
        chapeu_efetivo = tupla.chapeu if tupla.chapeu is not None else chapeu_forcado
        via = "tupla" if tupla.chapeu is not None else "comando"
        return tupla.cadeira.strip(), chapeu_efetivo, tupla.overrides, list(tupla.avisos), via
    cadeira_bruta = (cadeira_arg or os.environ.get("PF_CADEIRA") or "").strip()
    return cadeira_bruta, chapeu_forcado, (), [], "comando"


def ato_montar(cadeira_arg: str | None = None, chapeu_forcado: str | None = None,
               sem_acervo: bool = False, como_json: bool = False,
               perfil: str = "cadeira", modo: str | None = None,
               regua: list[str] | None = None,
               leitor_processos: LeitorDeProcessos | None = None) -> int:
    if perfil != "cadeira" or modo or regua:
        return ato_montar_cadeirinha(cadeira_arg, chapeu_forcado, modo, regua, perfil, sem_acervo,
                                     como_json)

    pergunta = sys.stdin.read().strip() if not sys.stdin.isatty() else ""
    cadeira_bruta, chapeu_efetivo, overrides_tupla, avisos_tupla, via_chapeu = _entrada_da_abertura(
        cadeira_arg, chapeu_forcado, pergunta
    )

    if not cadeira_bruta:
        return _erro("sem cadeira: a porta não injetou", 3, como_json)

    secao = _carregar_secao_abertura(cadeira_bruta)
    res_nome = resolver_nomes(cadeira_bruta, chapeu_efetivo, secao)
    if not res_nome.ok and res_nome.recusa is not None:
        if como_json:
            print(json.dumps(res_nome.recusa.como_dict(), ensure_ascii=False))
        else:
            print(res_nome.recusa.mensagem, file=sys.stderr)
        return 2

    cadeira = res_nome.cadeira or cadeira_bruta
    chapeu_slug = res_nome.chapeu
    avisos: list[str] = [*res_nome.avisos, *avisos_tupla]

    if chapeu_slug:
        valido, err_chapeu = valida_chapeu(cadeira, chapeu_slug)
        if not valido:
            msg = f"erro: chapéu '{chapeu_slug}' fora do vocabulário da cadeira '{cadeira}' — {err_chapeu}"
            return _erro(msg, 2, como_json)

    sessao_id, ordem_id, sessao_info = _abrir_sessao_se_ausente(cadeira)
    abandonadas = _fechar_abandonadas_e_abrir(cadeira, sessao_id)
    if abandonadas is not None and (abandonadas.fechadas or not abandonadas.olhou):
        avisos.append(abandonadas.linha())

    motivo_rot = "chapéu declarado na tupla da primeira linha" if via_chapeu == "tupla" else "chapéu forçado por argumento"
    roteador_info = ({"via": via_chapeu, "slug": chapeu_slug, "acertos": {}, "motivo": motivo_rot}
                     if chapeu_slug else None)

    env_roteiro = _montar_roteiro(cadeira, chapeu_slug, avisos, overrides=overrides_tupla)
    leitor = _obter_leitor_de_processos(leitor_processos)
    env_rotinas, recusas_rotinas = _montar_rotinas(leitor, avisos)
    env_pauta = _montar_pauta(cadeira, chapeu_slug, pergunta, avisos)

    servidas = [env_roteiro, env_rotinas, env_pauta]

    montador_sha = resolve_montador_sha()
    reg_pacote = registra_pacote(cadeira, servidas, montador_sha, sid=sessao_id, oid=ordem_id)
    if os.environ.get("PF_FITA") and not reg_pacote.get("registrado"):
        avisos.append(f"registro do pacote não gravado: {reg_pacote.get('motivo')}")

    total_tokens = sum(e["tokens"] for e in servidas)
    pacote_info = {
        "pecas": len(servidas),
        "tokens": total_tokens,
        "metodo_tokens": medidor()[1],
        "montador_sha": montador_sha,
        "montado_em": int(time.time()),
        "registro": reg_pacote,
    }

    chapeus_validos = (
        list(secao.cadeiras[cadeira].chapeus.keys())
        if cadeira in secao.cadeiras
        else chapeus_de(cadeira)
    )

    resultado = {
        "cadeira": cadeira,
        "nome_canonico": cadeira,
        "sessao_id": sessao_id,
        "ordem_id": ordem_id,
        **({"sessao": sessao_info} if sessao_info else {}),
        **({"chapeu": chapeu_slug} if chapeu_slug else {}),
        "chapeus": chapeus_validos,
        **({"roteador": roteador_info} if roteador_info else {}),
        "roteiro": env_roteiro,
        "rotinas": env_rotinas,
        "pauta": env_pauta,
        "recusas": recusas_rotinas,
        **({"abandonadas": abandonadas.como_dict()} if abandonadas is not None else {}),
        "pacote": pacote_info,
        "pecas": servidas,
        "avisos": avisos,
    }

    if como_json:
        print(json.dumps(resultado, ensure_ascii=False))
        return 0
    return imprime_texto(resultado)


def imprime_texto(pac: dict) -> int:
    cad = pac.get("cadeira", "?")
    sid = pac.get("sessao_id") or "-"
    oid = pac.get("ordem_id") or "-"
    pacote = pac.get("pacote") or {}
    n_pecas = pacote.get("pecas", 0)
    tokens = pacote.get("tokens", 0)
    metodo_tk = pacote.get("metodo_tokens", "qwen2.5")

    print(f"cadeira: {cad}   sessao_id: {sid}   ordem_id: {oid}")
    if "roteador" in pac:
        print(f"chapeu: {pac.get('chapeu') or 'null'}   roteador: {pac['roteador'].get('via', 'fallback')}")
    if pac.get("perfil"):
        print(f"perfil: {pac['perfil']}   modo: {pac.get('modo')}"
              + (f"   regua: {' '.join(pac['regua'])}" if pac.get("regua") else ""))
    print(f"pacote: {n_pecas} peças · {tokens} tokens · {metodo_tk}")

    for e in pac.get("pecas", []):
        sha = f" @{e['sha']}" if e.get("sha") else ""
        print(f"===== {e['peca']}: {e['ref']}{sha} ({e['frescor']}, {e['tokens']} tokens) =====")
        if e.get("conteudo") is not None:
            print(e["conteudo"])
        else:
            print(f"(INDISPONÍVEL — {e.get('motivo')})")
        print()

    avisos = pac.get("avisos") or []
    if avisos:
        print("avisos:")
        for a in avisos:
            print(f"  (aviso: {a})")

    return 0


# ------------------------------------------------------------------ CLI / main
def main() -> int:
    argv = sys.argv[1:]
    como_json = "--json" in argv

    parser = Uso(
        descricao="monta a abertura da sessão (roteiro, rotinas e pauta) e o perfil cadeirinha",
        saidas="0 ok · 2 uso / nome fora do vocabulário · 3 sem cadeira",
    )
    atos = parser.atos()

    p_montar = atos.novo("montar", "monta o pacote da abertura (roteiro, rotinas e pauta) ou do perfil cadeirinha")
    p_montar.add_argument("cadeira", nargs="?", default=None, help="slug ou nome alternativo da cadeira (fallback PF_CADEIRA)")
    p_montar.add_argument("--chapeu", metavar="<slug>", help="slug ou nome alternativo do chapéu")
    p_montar.add_argument("--sem-acervo", action="store_true", help="omite a consulta ao acervo (perfil cadeirinha)")
    p_montar.add_argument("--perfil", choices=PERFIS, default="cadeira",
                          help="cadeira (o padrão) ou cadeirinha: a lente sem a conduta, para quem trabalha por delegação")
    p_montar.add_argument("--modo", metavar="<slug>", help="o modo do agente (só com --perfil cadeirinha)")
    p_montar.add_argument("--regua", nargs=2, metavar=("<espécie>", "<chave>"),
                          help="a régua que o agente aplica (só em revisar e avaliar)")
    p_montar.add_argument("--json", action="store_true", help="saída em formato JSON")

    p_rotear = atos.novo("rotear", "só o roteador: pergunta → chapéu, com via (determinístico, semântico, fallback)")
    p_rotear.add_argument("--json", action="store_true", help="saída em formato JSON")

    p_catalogo = atos.novo("catalogo", "as peças do catálogo e metadados")
    p_catalogo.add_argument("--perfil", choices=PERFIS, default="cadeira", help="as linhas do perfil")
    p_catalogo.add_argument("--json", action="store_true", help="saída em formato JSON")

    if not argv:
        parser.error("falta o ato")

    primeiro = argv[0]
    if primeiro in ("-h", "--help", "--ajuda"):
        parser.print_help(sys.stdout)
        sys.exit(0)

    if primeiro not in ("montar", "rotear", "catalogo"):
        if como_json:
            print(json.dumps({"erro": f"ato desconhecido: '{primeiro}'"}, ensure_ascii=False))
            sys.exit(2)
        parser.error(f"ato desconhecido: '{primeiro}'")

    args = parser.parse_args()

    if args.ato == "catalogo":
        return ato_catalogo(como_json=args.json, perfil=args.perfil)
    elif args.ato == "rotear":
        return ato_rotear(como_json=args.json)
    elif args.ato == "montar":
        return ato_montar(
            cadeira_arg=args.cadeira,
            chapeu_forcado=args.chapeu,
            sem_acervo=args.sem_acervo,
            como_json=args.json,
            perfil=args.perfil,
            modo=args.modo,
            regua=args.regua,
        )
    return 2


if __name__ == "__main__":
    sys.exit(main())
