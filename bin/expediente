from raizes import instancia  # noqa: E402  (lib/ ja esta no sys.path)

# Artefato de terceiro pinado: dentro da arvore da familia, por realpath (card #3010) —
# o mesmo caminho de monta-sessao. PF_TOKENIZADOR so existe para teste passar fixture.
TOKENIZADOR = (os.environ.get("PF_TOKENIZADOR")
               or str(_REPO_REAL / "terceiros" / "tokenizers" / "qwen2.5.json"))
# Verbos irmaos: bin/ da propria release. PF_BIN so aponta outro diretorio (teste com stub).
BIN = Path(os.environ.get("PF_BIN") or (_REPO_REAL / "bin"))
_MEDIDOR = {"fn": None, "metodo": None}


def medidor():
    """Mesmo tokenizador de conferir sessao (qwen2.5). Fallback bytes/4 declarado."""
    if _MEDIDOR["fn"]:
        return _MEDIDOR["fn"], _MEDIDOR["metodo"]
    try:
        from tokenizers import Tokenizer
        if os.path.isfile(TOKENIZADOR):
            tk = Tokenizer.from_file(TOKENIZADOR)
            _MEDIDOR.update(fn=lambda s: len(tk.encode(s).ids), metodo="tokenizador qwen2.5")
            return _MEDIDOR["fn"], _MEDIDOR["metodo"]
        motivo = f"tokenizador ausente: {TOKENIZADOR}"
    except ImportError:
        motivo = "modulo `tokenizers` ausente"
    _MEDIDOR.update(fn=lambda s: max(1, len(s.encode("utf-8")) // 4),
                    metodo=f"ESTIMATIVA por bytes/4 ({motivo})")
    return _MEDIDOR["fn"], _MEDIDOR["metodo"]


def conta_tokens(texto: str) -> int:
    if not texto:
        return 0
    fn, _ = medidor()
    return fn(texto)


def env_verbo(cadeira: str) -> dict[str, str]:
    """Env da peça-verbo: PF_CADEIRA canônico + PATH explícito (spec_expediente §2, R7)."""
    casa = os.path.expanduser("~")
    e = dict(os.environ)
    e["PF_CADEIRA"] = cadeira
    e["PATH"] = f"{BIN}:{casa}/.local/bin:" + os.environ.get("PATH", "")
    return e


def resolve_montador_sha() -> str:
    morada = os.environ.get("PF_ABERTURA_DIR", str(instancia() / "var" / "abertura-publicada"))
    manifesto = os.path.join(morada, "current", "MANIFEST.json")
    if os.path.isfile(manifesto):
        try:
            with open(manifesto, encoding="utf-8") as f:
                d = json.load(f)
                if d.get("sha_curto"):
                    return d["sha_curto"]
                if d.get("sha"):
                    return d["sha"][:7]
        except (OSError, ValueError):
            pass
    # Runtime nao le working tree git (arq:0097): morada nao publicada sai declarada,
    # nunca adivinhada por `git rev-parse` no clone.
    return "morada-nao-publicada"


def executa_verbo(cmd_linha: str | list[str], cadeira: str, timeout: int = 30) -> tuple[int, str, str]:
    """Executa um comando de verbo no ambiente env_verbo. Lista = argv pronto: texto
    livre (a pergunta) entra assim, nunca por shlex."""
    try:
        args = cmd_linha if isinstance(cmd_linha, list) else shlex.split(cmd_linha)
        p = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env_verbo(cadeira),
            check=False,
        )
        return p.returncode, p.stdout or "", p.stderr or ""
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "", f"{type(e).__name__}: {e}"


def acha_roteador() -> Path | None:
    """Acha o sub-ato bin/_expediente/rotear: sob PF_BIN (diretorio hermetico de teste, stub)
    e, faltando la, no checkout real deste binario (o servido)."""
    candidatos = []
    if os.environ.get("PF_BIN"):
        candidatos.append(BIN / "_expediente" / "rotear")
    candidatos.append(_REPO_REAL / "bin" / "_expediente" / "rotear")
    for c in candidatos:
        if c.is_file() and os.access(c, os.X_OK):
            return c
    return None


def executa_roteador(pergunta: str, cadeira: str) -> tuple[dict, str | None, int]:
    """Executa o sub-ato bin/_expediente/roteador por subprocesso (spec §1, §4, §5)."""
    p_rot = acha_roteador()
    if not p_rot:
        return {
            "via": "fallback",
            "slug": None,
            "acertos": {},
            "motivo": "roteador ausente: bin/_expediente/rotear",
        }, "roteador ausente: bin/_expediente/rotear", 0

    try:
        p = subprocess.run(
            [str(p_rot), "--json"],
            input=pergunta,
            capture_output=True,
            text=True,
            timeout=15,
            env=env_verbo(cadeira),
            check=False,
        )
        if p.returncode == 3:
            # Conceitos do golden record mudos
            motivo = (p.stderr or p.stdout).strip() or "conceitos do golden record mudos"
            return {
                "via": "fallback",
                "slug": None,
                "acertos": {},
                "motivo": motivo,
            }, motivo, 3
        elif p.returncode == 0:
            d = json.loads(p.stdout)
            via_map = {
                "deterministico": "determinístico",
                "semantico": "semântico",
                "comando": "comando",
                "fallback": "fallback",
            }
            via = via_map.get(d.get("via", "fallback"), d.get("via", "fallback"))
            return {
                "via": via,
                "slug": d.get("slug"),
                "acertos": d.get("acertos") or {},
                "motivo": d.get("motivo"),
            }, None, 0
        else:
            motivo = (p.stderr or p.stdout).strip() or f"exit {p.returncode}"
            return {
                "via": "fallback",
                "slug": None,
                "acertos": {},
                "motivo": motivo,
            }, f"roteador falhou: {motivo}", 0
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        return {
            "via": "fallback",
            "slug": None,
            "acertos": {},
            "motivo": f"{type(e).__name__}: {e}",
        }, f"roteador falhou: {type(e).__name__}: {e}", 0


# ------------------------------------------------------------------ acervo / cobertura
PODA = os.environ.get("PF_PODA", "1") != "0"


def _formata_acervo(d: dict, pergunta: str) -> str:
    """Formata resultado do acervo vindo de motor rag buscar."""
    fontes = d.get("fontes") or []
    if not fontes:
        return (f"CONSULTA AO ACERVO - {pergunta[:80]}\n"
                "Sem cobertura no acervo para esta ordem. Nao responda pelo vizinho: "
                "se o acervo nao cobre, diga que nao cobre.")
    cab = (f"CONSULTA AO ACERVO - {pergunta[:80]} ({len(fontes)} trechos, "
           f"cobertura {d.get('cobertura') or '?'})")
    fita = (d.get("contexto") or "").strip()
    rodape = "(consultar nao e usar - cite [n] so onde a resposta aplicar; #2947)"
    if fita:
        return f"{cab}\n\n{fita}\n\n{rodape}"
    linhas = [cab]
    for f in fontes:
        linhas.append(f"[{f.get('n', '?')}] {f.get('obra', '?')} ({f.get('section_id', '?')})")
    linhas.append(rodape)
    return "\n".join(linhas)


def _portao_cobertura(d: dict, pergunta: str, env: dict) -> str:
    """Portão de cobertura R5 (arq:0101) — o piso vem de sinal.piso do retorno."""
    sinal = d.get("sinal") or {}
    valor, piso = sinal.get("valor"), sinal.get("piso")
    tem_medida = isinstance(valor, (int, float)) and isinstance(piso, (int, float))
    if not PODA or not tem_medida or valor >= piso:
        return _formata_acervo(d, pergunta)
    env["motivo"] = (f"portao de cobertura (arq:0101 R5): sinal {valor} < piso {piso} "
                     f"[{sinal.get('medida', '?')}]")
    return (f"CONSULTA AO ACERVO - {pergunta[:80]}\n"
            f"NAO SERVIDA: sinal {valor} abaixo do piso {piso} (cobertura {d.get('cobertura') or '?'}), "
            f"{len(d.get('fontes') or [])} trechos retidos. O acervo nao cobre esta "
            "ordem — nao responda pelo vizinho. Por ato, se precisar: "
            f"`motor rag buscar \"{pergunta}\"`.")


# ------------------------------------------------------------------ registro
def obtem_senha_sessao(cadeira: str) -> str:
    """Segredo entra por verbo, no processo (spec_acesso §2): `seg segredo ler`. A variavel
    SESSAO_PG_PASSWORD e aceita so como transicao (Q11), quando o verbo nao responde;
    arquivo .env nunca e fonte."""
    rc, out, _ = executa_verbo("seg segredo ler harness-sessao/SESSAO_PG_PASSWORD", cadeira, timeout=5)
    if rc == 0 and out.strip():
        return out.strip()
    return (os.environ.get("SESSAO_PG_PASSWORD") or "").strip()


def registra_pacote(cadeira: str, envelopes: list[dict], montador_sha: str,
                    sid: str | None = None, oid: str | None = None) -> dict:
    """Registra o pacote servido em Postgres sob PF_FITA. Senha SÓ de segredo/variável."""
    fid = (os.environ.get("PF_FITA") or "").strip()
    if not fid:
        return {"registrado": False, "motivo": "sem PF_FITA — sessao de mao nao tem fita"}

    senha = obtem_senha_sessao(cadeira)
    if not senha:
        return {"registrado": False, "motivo": "sem senha SESSAO_PG_PASSWORD"}

    try:
        import psycopg
    except ImportError:
        return {"registrado": False, "motivo": "psycopg ausente neste venv"}

    porta = os.environ.get("SESSAO_PG_PORT", "5437")
    dsn = f"host=127.0.0.1 port={porta} dbname=sessao user=sessao password={senha}"
    sup = os.environ.get("PF_SUPERFICIE", "").strip() or "desconhecida"
    if sup not in ("claude.ai", "chat", "code", "desconhecida"):
        sup = "desconhecida"
    try:
        with psycopg.connect(dsn, connect_timeout=3) as con, con.cursor() as cur:
            cur.execute("INSERT INTO sessao.fita (id, persona, superficie, sessao_id) "
                        "VALUES (%s,%s,%s,%s) ON CONFLICT (id) DO UPDATE SET "
                        "sessao_id = COALESCE(EXCLUDED.sessao_id, sessao.fita.sessao_id)",
                        (fid, cadeira, sup, sid))
            cur.execute("INSERT INTO sessao.pacote (fita_id, montador_sha, tokens) "
                        "VALUES (%s,%s,%s) ON CONFLICT (fita_id) DO UPDATE SET "
                        "montado_em = now(), montador_sha = EXCLUDED.montador_sha, "
                        "tokens = EXCLUDED.tokens",
                        (fid, montador_sha, sum(e["tokens"] for e in envelopes)))
            cur.executemany(
                "INSERT INTO sessao.peca_servida (fita_id, peca, ordem, ref, sha, regime, "
                "tokens, frescor) VALUES (%s,%s,%s,%s,%s,%s,%s,%s) "
                "ON CONFLICT (fita_id, peca) DO UPDATE SET ordem = EXCLUDED.ordem, "
                "ref = EXCLUDED.ref, sha = EXCLUDED.sha, tokens = EXCLUDED.tokens, "
                "frescor = EXCLUDED.frescor",
                [(fid, e["peca"], i, e["ref"], e["sha"], e["regime"], e["tokens"], e["frescor"])
                 for i, e in enumerate(envelopes)])
            con.commit()
        return {"registrado": True, "fita": fid}
    except Exception as e:  # noqa: BLE001
        return {"registrado": False, "motivo": f"{type(e).__name__}: {e}"}


# ------------------------------------------------------------------ validações
def valida_cadeira() -> tuple[str | None, str | None]:
    """Etapa 2: PF_CADEIRA presente e slug puro."""
    cad = os.environ.get("PF_CADEIRA")
    if not cad or not cad.strip():
        return None, "sem cadeira: a porta não injetou"
    cad = cad.strip()
    cad_lower = cad.lower()
    for pref in ("claudinho-", "claudinha-"):
        if cad_lower.startswith(pref):
            return None, "sem cadeira: a porta não injetou (cadeira não é slug puro)"
    if not re.match(r"^[a-z0-9-]+$", cad):
        return None, "sem cadeira: a porta não injetou (cadeira não é slug puro)"
    return cad, None


def valida_chapeu(cadeira: str, slug: str) -> tuple[bool, str]:
    """Etapa 1: --chapeu está no vocabulário de chapéus da cadeira."""
    rc, stdout, stderr = executa_verbo(f"persona ler {cadeira} --chapeu {slug}", cadeira)
    if rc != 0:
        detalhe = (stderr or stdout).strip()
        return False, detalhe
    return True, ""


# ------------------------------------------------------------------ ato: catalogo
def ato_catalogo(como_json: bool = False) -> int:
    # Etapa 3 (§4): "catalogo ausente" so existe quando o catalogo vier do acervo. Na
    # transicao ele mora neste arquivo e nao tem como faltar; a etapa e declarada, nao
    # simulada por variavel de ambiente (toda variavel lida tem origem nomeada).
    if como_json:
        print(json.dumps(CATALOGO, ensure_ascii=False, indent=2))
        return 0

    print("# catálogo de peças (transição: declarado no verbo até averbação no acervo)")
    print(f"{'peça':<18} {'gatilho':<25} {'regime':<8} {'volatilidade':<12} {'dono':<20} chamada")
    print("-" * 110)
    for p in CATALOGO:
        print(f"{p.get('peca', ''):<18} {p.get('gatilho', ''):<25} {p.get('regime', ''):<8} "
              f"{p.get('volatilidade', ''):<12} {p.get('dono', ''):<20} {p.get('chamada', '')}")
    return 0


# ------------------------------------------------------------------ ato: rotear
def ato_rotear(como_json: bool = False) -> int:
    cadeira, erro_cad = valida_cadeira()
    if not cadeira:
        if como_json:
            print(json.dumps({"erro": erro_cad}, ensure_ascii=False))
        else:
            print(erro_cad, file=sys.stderr)
        return 3

    pergunta = sys.stdin.read().strip()
    dec, erro_rot, rc_rot = executa_roteador(pergunta, cadeira)
    if rc_rot == 3:
        if como_json:
            print(json.dumps({"erro": erro_rot}, ensure_ascii=False))
        else:
            print(erro_rot, file=sys.stderr)
        return 3

    if como_json:
        print(json.dumps(dec, ensure_ascii=False))
    else:
        print(f"chapeu: {dec.get('slug') or 'null'}   roteador: {dec.get('via')}")
        if dec.get("motivo"):
            print(f"motivo: {dec.get('motivo')}")
    return 0


# ------------------------------------------------------------------ ato: montar
def ato_montar(chapeu_forcado: str | None = None, sem_acervo: bool = False,
               como_json: bool = False) -> int:
    cadeira, erro_cad = valida_cadeira()
    if not cadeira:
        if como_json:
            print(json.dumps({"erro": erro_cad}, ensure_ascii=False))
        else:
            print(erro_cad, file=sys.stderr)
        return 3

    if chapeu_forcado:
        valido, err_chapeu = valida_chapeu(cadeira, chapeu_forcado)
        if not valido:
            msg = f"erro: chapéu '{chapeu_forcado}' fora do vocabulário da cadeira '{cadeira}' — {err_chapeu}"
            if como_json:
                print(json.dumps({"erro": msg}, ensure_ascii=False))
            else:
                print(msg, file=sys.stderr)
            return 2

    pergunta = sys.stdin.read().strip()

    # Roteador de chapéu
    if chapeu_forcado:
        roteador_info = {
            "via": "comando",
            "slug": chapeu_forcado,
            "acertos": {},
            "motivo": "chapéu forçado por argumento",
        }
        aviso_rot = None
    else:
        roteador_info, aviso_rot, _rc_rot = executa_roteador(pergunta, cadeira)

    chapeu_slug = roteador_info.get("slug")
    avisos: list[str] = []
    if aviso_rot:
        avisos.append(aviso_rot)
    elif not chapeu_slug:
        avisos.append(f"chapéu não roteado (fallback): {roteador_info.get('motivo')}")

    cat_por_id = {item["peca"]: item for item in CATALOGO}

    # Ordem de injeção por SALIÊNCIA, não por volatilidade (spec_abertura §1, rev):
    # identidade em primazia máxima, régua de forma logo após a identidade que ela
    # enquadra, consulta passiva no meio, cadernos por último. Fundamento: curva em U
    # de atenção — primazia/recência nas pontas, vale no meio (Liu et al. 2024; role em
    # primazia é o efeito mais forte para persona). persona ANTES de conduta: a peça que
    # faz a cadeira ser ela mesma não pode entrar fria atrás de ~5,5k tokens de régua
    # comum a toda cadeira. chapeu em primazia alta (logo após persona) quando roteia.
    ordem_chaves = ["persona"]
    if chapeu_slug:
        ordem_chaves.append("chapeu")
    ordem_chaves.append("conduta")
    ordem_chaves.append("alias-cadeiras")
    ordem_chaves.append("mesa")
    if pergunta and not sem_acervo:
        ordem_chaves.append("acervo-consultado")
    ordem_chaves.append("cadernos")

    servidas: list[dict] = []

    for peca_id in ordem_chaves:
        meta = cat_por_id.get(peca_id, {})
        dono = meta.get("dono", "gestao-estrategica")
        regime = meta.get("regime", "valor")
        volatilidade = meta.get("volatilidade", "volatil")
        chamada_tmpl = meta.get("chamada", "")

        if peca_id == "conduta":
            cmd = "persona conduta"
            ref = "verbo:persona conduta"
        elif peca_id == "persona":
            cmd = f"persona ler {cadeira}"
            ref = f"verbo:persona ler {cadeira}"
        elif peca_id == "chapeu":
            cmd = f"persona ler {cadeira} --chapeu {chapeu_slug}"
            ref = f"verbo:persona ler {cadeira} --chapeu {chapeu_slug}"
        elif peca_id == "alias-cadeiras":
            cmd = "persona foto"
            ref = "verbo:persona foto"
        elif peca_id == "mesa":
            cmd = "mesa ver"
            ref = "verbo:mesa ver"
        elif peca_id == "acervo-consultado":
            # argv pronto: a pergunta e texto livre e nao passa por shlex
            cmd = ["motor", "rag", "buscar", "casa", pergunta, "--k", "6", "--texto", "secao"]
            ref = f'verbo:motor rag buscar casa "{pergunta[:40]}" --k 6 --texto secao'
        elif peca_id == "cadernos":
            if chapeu_slug:
                cmd = f"mesa caderno --chapeu {chapeu_slug}"
                ref = f"verbo:mesa caderno --chapeu {chapeu_slug}"
            else:
                cmd = "mesa caderno"
                ref = "verbo:mesa caderno"
        else:
            cmd = chamada_tmpl.replace("{cadeira}", cadeira).replace("{chapeu}", chapeu_slug or "")
            ref = f"verbo:{cmd}"

        env = {
            "peca": peca_id,
            "dono": dono,
            "ref": ref,
            "sha": None,
            "regime": regime,
            "volatilidade": volatilidade,
            "tokens": 0,
            "frescor": "indisponivel",
            "motivo": None,
            "conteudo": None,
        }

        rc, stdout, stderr = executa_verbo(cmd, cadeira)
        if rc != 0:
            env["frescor"] = "indisponivel"
            motivo = (stderr or stdout).strip()[:200] or f"exit {rc}"
            env["motivo"] = motivo
            avisos.append(f"peça `{peca_id}` indisponível: {motivo}")
            servidas.append(env)
            continue

        # Sucesso
        conteudo_bruto = stdout.strip()
        if peca_id == "acervo-consultado":
            try:
                d_acervo = json.loads(stdout)
                if isinstance(d_acervo, dict):
                    if d_acervo.get("erro"):
                        env["frescor"] = "indisponivel"
                        motivo = str(d_acervo["erro"])[:200]
                        env["motivo"] = motivo
                        avisos.append(f"peça `acervo-consultado` indisponível: {motivo}")
                        servidas.append(env)
                        continue
                    conteudo_bruto = _portao_cobertura(d_acervo, pergunta, env)
            except (ValueError, TypeError):
                conteudo_bruto = stdout.strip()

        env["frescor"] = "fresco"
        env["conteudo"] = conteudo_bruto
        env["tokens"] = conta_tokens(conteudo_bruto)
        env["sha"] = sha_servido(conteudo_bruto)
        servidas.append(env)

    montador_sha = resolve_montador_sha()
    sessao_id = os.environ.get("PF_SESSAO") or None
    ordem_id = os.environ.get("PF_ORDEM_ID") or None

    reg_pacote = registra_pacote(cadeira, servidas, montador_sha, sid=sessao_id, oid=ordem_id)
    if os.environ.get("PF_FITA") and not reg_pacote.get("registrado"):
        avisos.append(f"registro do pacote não gravado: {reg_pacote.get('motivo')}")

    total_tokens = sum(e["tokens"] for e in servidas)
    pacote_info = {
        "pecas": len(servidas),
        "tokens": total_tokens,
        "metodo_tokens": medidor()[1],
        "montador_sha": montador_sha,
        "montado_em": int(time.time()),
        "registro": reg_pacote,
    }

    resultado = {
        "cadeira": cadeira,
        "sessao_id": sessao_id,
        "ordem_id": ordem_id,
        "chapeu": chapeu_slug,
        "roteador": roteador_info,
        "pacote": pacote_info,
        "pecas": servidas,
        "avisos": avisos,
    }

    if como_json:
        print(json.dumps(resultado, ensure_ascii=False))
        return 0

    return imprime_texto(resultado)


def imprime_texto(pac: dict) -> int:
    """Imprime pacote no formato texto conforme spec_expediente §3."""
    cad = pac.get("cadeira")
    sid = pac.get("sessao_id") or "null"
    oid = pac.get("ordem_id") or "null"
    chapeu = pac.get("chapeu") or "null"
    rot = pac.get("roteador") or {}
    via = rot.get("via", "fallback")
    pacote = pac.get("pacote") or {}
    n_pecas = pacote.get("pecas", 0)
    tokens = pacote.get("tokens", 0)
    metodo_tk = pacote.get("metodo_tokens", "qwen2.5")

    print(f"cadeira: {cad}   sessao_id: {sid}   ordem_id: {oid}")
    print(f"chapeu: {chapeu}   roteador: {via}")
    print(f"pacote: {n_pecas} peças · {tokens} tokens · {metodo_tk}")

    for e in pac.get("pecas", []):
        sha = f" @{e['sha']}" if e.get("sha") else ""
        print(f"===== {e['peca']}: {e['ref']}{sha} ({e['frescor']}, {e['tokens']} tokens) =====")
        if e.get("conteudo") is not None:
            print(e["conteudo"])
        else:
            print(f"(INDISPONÍVEL — {e.get('motivo')})")
        print()

    avisos = pac.get("avisos") or []
    if avisos:
        print("avisos:")
        for a in avisos:
            print(f"  (aviso: {a})")

    return 0


# ------------------------------------------------------------------ CLI / main
def main() -> int:
    # Trata --json com erro em stdout quando argumento/ato inválido
    argv = sys.argv[1:]
    como_json = "--json" in argv

    parser = Uso(
        descricao="monta o pacote de expediente da cadeira (conduta, persona, mesa, cadernos)",
        saidas="0 ok · 2 uso · 3 sem cadeira / catálogo ausente",
    )
    atos = parser.atos()

    p_montar = atos.novo("montar", "monta o pacote na ordem do §2; com pergunta, roteia o chapéu e consulta o acervo")
    p_montar.add_argument("--chapeu", metavar="<slug>", help="força o slug do chapéu (ignora roteador)")
    p_montar.add_argument("--sem-acervo", action="store_true", help="omite a consulta ao acervo")
    p_montar.add_argument("--json", action="store_true", help="saída em formato JSON")

    p_rotear = atos.novo("rotear", "só o roteador: pergunta → chapéu, com via (determinístico, semântico, fallback)")
    p_rotear.add_argument("--json", action="store_true", help="saída em formato JSON")

    p_catalogo = atos.novo("catalogo", "as peças do catálogo e metadados")
    p_catalogo.add_argument("--json", action="store_true", help="saída em formato JSON")

    if not argv:
        parser.error("falta o ato")

    primeiro = argv[0]
    if primeiro in ("-h", "--help", "--ajuda"):
        parser.print_help(sys.stdout)
        sys.exit(0)

    if primeiro not in ("montar", "rotear", "catalogo"):
        if como_json:
            print(json.dumps({"erro": f"ato desconhecido: '{primeiro}'"}, ensure_ascii=False))
            sys.exit(2)
        parser.error(f"ato desconhecido: '{primeiro}'")

    args = parser.parse_args()

    if args.ato == "catalogo":
        return ato_catalogo(como_json=args.json)
    elif args.ato == "rotear":
        return ato_rotear(como_json=args.json)
    elif args.ato == "montar":
        return ato_montar(
            chapeu_forcado=args.chapeu,
            sem_acervo=args.sem_acervo,
            como_json=args.json,
        )
    return 2


if __name__ == "__main__":
    sys.exit(main())
