    ("cloudflared", POSTO, "http://cloudflared:20243/ready", None, '"readyConnections":0'),
]

# Declarado e sem sonda. Aparece na lista como sem-sinal, de proposito.
SEM_SONDA = {
    "mcp": "sem rota de saude propria; sonda fica para quando houver",
}

# Servico -> unit systemd --user oneshot (disparada por timer, sem container e sem
# healthcheck proprio, card #3141 passo 9). O veredito e o Result do ultimo start:
# `systemctl --user show <unit> -p Result` == "success" e no-ar; qualquer outro
# valor (exit-code, timeout, signal, ou vazio — nunca rodou) e fora, com o Result
# como motivo.
POR_SYSTEMD_RESULT = {
    "casa-site-publicar": "casa-site-publicar.service",
    "abertura-caderno": "abertura-caderno.service",
}


def agora():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def roda(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout de {timeout}s"
    except Exception as e:                      # daemon fora, binario ausente
        return 125, "", f"{type(e).__name__}: {e}"


def do_healthcheck(nome, contendor):
    fmt = "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}sem-healthcheck{{end}}"
    rc, out, err = roda(["docker", "inspect", "-f", fmt, contendor])
    if rc != 0:
        return {"estado": "fora", "exercitado": "docker inspect",
                "motivo": err.splitlines()[0] if err else f"contendor {contendor} nao existe"}
    status, saude = (out.split("|") + ["", ""])[:2]
    if status != "running":
        return {"estado": "fora", "exercitado": "docker inspect",
                "motivo": f"contendor {status}"}
    if saude == "healthy":
        return {"estado": "no-ar", "exercitado": "healthcheck do contendor"}
    if saude == "sem-healthcheck":
        return {"estado": "sem-sinal", "exercitado": None,
                "motivo": "contendor rodando, sem healthcheck declarado"}
    if saude == "starting":
        return {"estado": "degradado", "exercitado": "healthcheck do contendor",
                "motivo": "em start_period, ainda sem veredito"}
    rc2, log, _ = roda(["docker", "inspect", "-f",
                        "{{if .State.Health}}{{range .State.Health.Log}}{{.Output}}{{end}}{{end}}",
                        contendor])
    motivo = (log or "healthcheck reprovou").strip().replace("\n", " ")[:300]
    return {"estado": "fora", "exercitado": "healthcheck do contendor", "motivo": motivo}


def do_sonda_externa(nome, posto, url, exige, proibido):
    onde = f"GET {url} (de {posto})"
    rc, out, err = roda(["docker", "exec", posto, "curl", "-fsS", "--max-time", "6", url])
    if rc != 0:
        motivo = (err or out or f"curl saiu {rc}").splitlines()[0][:300]
        return {"estado": "fora", "exercitado": onde, "motivo": motivo}
    if exige and exige not in out:
        return {"estado": "degradado", "exercitado": onde,
                "motivo": f"respondeu sem {exige} no corpo"}
    if proibido and proibido in out:
        return {"estado": "degradado", "exercitado": onde,
                "motivo": f"respondeu, mas contem {proibido}"}
    return {"estado": "no-ar", "exercitado": onde}


def do_systemd_result(nome, unit):
    onde = f"systemctl --user show {unit} -p Result"
    rc, out, err = roda(["systemctl", "--user", "show", unit, "-p", "Result"])
    if rc != 0:
        motivo = (err or out or f"systemctl saiu {rc}").splitlines()[0][:300]
        return {"estado": "fora", "exercitado": onde, "motivo": motivo}
    resultado = out.strip()
    if resultado.startswith("Result="):
        resultado = resultado[len("Result="):]
    if resultado == "success":
        return {"estado": "no-ar", "exercitado": onde}
    return {"estado": "fora", "exercitado": onde, "motivo": f"Result={resultado or '(vazio)'}"}

def do_runtime():
    """A classe de falha que healthcheck de servico nenhum pega: pacote de sistema
    atualizado com o processo vivo. Nada quebra ate alguem tentar CRIAR contendor —
    e ai nenhum servico volta de um restart, inclusive os de unless-stopped."""
    rc, out, err = roda(["docker", "run", "--rm", "alpine:3", "true"], timeout=90)
    if rc == 0:
        return {"estado": "no-ar", "exercitado": "docker run --rm alpine:3 true"}
    motivo = (err or out or f"saiu {rc}").splitlines()[0][:300]
    return {"estado": "fora", "exercitado": "docker run --rm alpine:3 true",
            "motivo": motivo or "criacao de contendor falhou"}


def do_gpu():
    """Driver da GPU descasado da biblioteca (pos-morte do #3401): o pacote de espaco de
    usuario atualiza com o modulo de kernel antigo carregado, e nada quebra ate um contendor
    com GPU ser recriado. O nvidia-smi ja falha no minuto da atualizacao ("Driver/library
    version mismatch"), entao lido aqui, a cada coleta, o alerta chega antes da recriacao.
    Host sem nvidia-smi (instancia sem GPU) e sem-sinal, nunca fora."""
    onde = "nvidia-smi -L"
    if not shutil.which("nvidia-smi"):
        return {"estado": "sem-sinal", "exercitado": None,
                "motivo": "nvidia-smi ausente no host (instancia sem GPU?)"}
    rc, out, err = roda(["nvidia-smi", "-L"], timeout=20)
    if rc == 0 and out:
        return {"estado": "no-ar", "exercitado": onde}
    motivo = (err or out or f"saiu {rc}").splitlines()[0][:300]
    return {"estado": "fora", "exercitado": onde, "motivo": motivo}


# Montagens do host (card #3467, pos-morte do #3204): a raiz foi a somente leitura em 30/09 e so se
# soube por escrita que falhou. ambiente: SINAL_MONTAGENS[=/proc/mounts] (override so para teste)
MONTAGENS_PADRAO = "/proc/mounts"
CAMPOS_DE_MONTAGEM = 4                            # dispositivo, ponto, tipo, opcoes

def do_raiz(montagens: str | None = None) -> dict:
    """A raiz do host fora de rw. O kernel remonta `/` em ro quando o disco erra (errors=remount-ro)
    e nada avisa: o processo segue vivo, cada escrita falha e o healthcheck de servico nenhum
    nota. Le a opcao de montagem de `/` em /proc/mounts: sem privilegio, sem escrita, sem ruido.
    Arquivo ilegivel ou sem linha de `/` e sem-sinal (nao houve leitura), nunca fora."""
    arq = montagens or os.environ.get("SINAL_MONTAGENS", MONTAGENS_PADRAO)
    onde = f"{arq}: opcoes da montagem de /"
    try:
        linhas = Path(arq).read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as e:
        return {"estado": "sem-sinal", "exercitado": None,
                "motivo": f"{arq} ilegivel: {type(e).__name__}"}
    opcoes, fstype = None, "?"
    for linha in linhas:                          # montagem por cima da anterior: a ultima vence
        campos = linha.split()
        if len(campos) >= CAMPOS_DE_MONTAGEM and campos[1] == "/":
            fstype, opcoes = campos[2], campos[3].split(",")
    if opcoes is None:
        return {"estado": "sem-sinal", "exercitado": None,
                "motivo": f"{arq} sem linha de montagem de /"}
    if "ro" in opcoes:                            # item inteiro: errors=remount-ro nao conta
        return {"estado": "fora", "exercitado": onde,
                "motivo": f"raiz montada somente leitura (/ {fstype} ro)"}
    if "rw" in opcoes:
        return {"estado": "no-ar", "exercitado": onde}
    return {"estado": "sem-sinal", "exercitado": None,
            "motivo": f"montagem de / sem rw nem ro nas opcoes: {','.join(opcoes)[:100]}"}

def parse_dt(iso_str: str) -> datetime:
    if iso_str.endswith("Z"):
        iso_str = iso_str[:-1] + "+00:00"
    return datetime.fromisoformat(iso_str)


# Log e estado do contendor no incidente (card #3469): #3382 e #3383 ficaram sem causa porque o log
# saiu com a recriacao do contendor. Capturado ao abrir o incidente, antes de qualquer recriacao, e
# SEMPRE por `redigir`: o corpo do item e lido por gente e indexado, segredo nao entra.
LINHAS_DE_LOG = 80                  # `docker logs --tail`
LIMITE_DO_LOG = 6000                # caracteres do log no corpo do item
LIMITE_DA_SAIDA = 600               # caracteres da ultima saida da sonda
TOKEN_LONGO = 32                    # letras e digitos seguidos que parecem chave
MASCARA = "***"
# So `.State` e o contador de reinicios: nunca `.Config.Env`, que guarda segredo.
FORMATO_ESTADO = "{{json .State}}\t{{.RestartCount}}"

_CHAVE_PRIVADA = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|\Z)",
                            re.DOTALL)
_URL_COM_CREDENCIAL = re.compile(r"\b([A-Za-z][A-Za-z0-9+.-]*://[^/\s:@]+:)[^/\s@]+@")
_BEARER = re.compile(r"(?i)\b(bearer\s+|basic\s+(?=[A-Za-z0-9+/=]{8,}))[^\s\"',;]+")
_JWT = re.compile(r"\beyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]*")
_CHAVE_SEGREDA = re.compile(
    r"""(?i)((?:pass(?:word|wd|phrase)?|senha|secret|token|api[_-]?key|private[_-]?key|credential|cookie"""
    r"""|authorization)[\w.-]*["']?\s*[:=]\s*)("[^"]*"|'[^']*'|[^\s,;&}"']+)""")
_TOKEN_LONGO = re.compile(rf"[A-Za-z0-9_+/=]{{{TOKEN_LONGO},}}")

def _mascara_token(m: re.Match) -> str:
    t = m.group(0)
    if t.startswith("/") or not (re.search(r"\d", t) and re.search(r"[A-Za-z]", t)):
        return t                                 # caminho, ou palavra sem digito: nao e chave
    return MASCARA

def redigir(texto: str) -> str:
    """Tira de `texto` o que parece segredo, por regra: bloco de chave privada, credencial em URL,
    Bearer/Basic, JWT, valor de chave que sugere segredo (senha, token, secret, api key, cookie,
    authorization) e sequencia longa de letras e digitos. O que nao casa fica; regra erra para o
    lado de mascarar a mais."""
    texto = _CHAVE_PRIVADA.sub(MASCARA, texto)
    texto = _URL_COM_CREDENCIAL.sub(r"\1" + MASCARA + "@", texto)
    texto = _BEARER.sub(r"\1" + MASCARA, texto)
    texto = _JWT.sub(MASCARA, texto)
    texto = _CHAVE_SEGREDA.sub(r"\1" + MASCARA, texto)
    return _TOKEN_LONGO.sub(_mascara_token, texto)

def _cauda(texto: str, limite: int, *, por_linha: bool = False) -> str:
    """Os ultimos `limite` caracteres; `por_linha` descarta a linha cortada ao meio."""
    if len(texto) <= limite:
        return texto
    corte = texto[-limite:]
    if por_linha and "\n" in corte:
        corte = corte.split("\n", 1)[1]
    return "[...]\n" + corte

def contendor_do_servico(nome: str) -> str | None:
    """Nome do contendor do servico, ou None quando nao ha (unit systemd, gpu, runtime) ou nao se
    resolve. A sonda externa guarda o host da rede, nao o nome do contendor do compose: acha-se por
    `docker ps`, e so vale se for um unico (oauth2-proxy nao pode pegar oauth2-proxy-harness)."""
    if nome in POR_HEALTHCHECK:
        return POR_HEALTHCHECK[nome]
    for n, _posto, url, _exige, _proibido in POR_SONDA_EXTERNA:
        if n != nome:
            continue
        host = urlparse(url).hostname or ""
        rc, out, _ = roda(["docker", "ps", "-a", "--filter", f"name={host}", "--format", "{{.Names}}"])
        if rc != 0 or not host:
            return None
        nomes = out.split()
        if host in nomes:
            return host
        achados = [x for x in nomes if re.search(rf"(^|-){re.escape(host)}(-\d+)?$", x)]
        return achados[0] if len(achados) == 1 else None
    return None

def _estado_do_contendor(saida: str) -> list[str]:
    """Linhas de estado e de saude a partir de `FORMATO_ESTADO`; ValueError ou TypeError quando a
    saida nao e isso."""
    bruto, _, reinicios = saida.rpartition("\t")
    st = json.loads(bruto)                      # JSONDecodeError e um ValueError
    if not isinstance(st, dict):
        raise TypeError("docker inspect devolveu estado que nao e objeto")
    oom = "sim" if st.get("OOMKilled") else "nao"
    linhas = [(f"Estado: {st.get('Status')} · reinicios {reinicios.strip() or '?'} · saida {st.get('ExitCode')}"
               f" · OOM {oom} · iniciado {st.get('StartedAt')} · terminou {st.get('FinishedAt')}")]
    saude = st.get("Health")
    if isinstance(saude, dict):
        linhas.append(f"Saúde: {saude.get('Status')} · falhas seguidas {saude.get('FailingStreak')}")
        registros = [r for r in (saude.get("Log") or []) if isinstance(r, dict)]
        if registros:
            r = registros[-1]
            saida_sonda = redigir(_cauda(str(r.get("Output") or "").strip(), LIMITE_DA_SAIDA))
            linhas.append(f"Última saída da sonda (saida {r.get('ExitCode')}, {r.get('End')}): {saida_sonda}")
    else:
        linhas.append("Saúde: contêiner sem healthcheck declarado")
    return linhas

def captura_contendor(nome: str) -> str:
    """Bloco de texto para o corpo do incidente: contendor, hora, estado, saude com a ultima saida da
    sonda e as ultimas linhas do log, redigido. Falha de leitura vira linha `indisponível`; nunca
    excecao, o incidente abre de qualquer jeito."""
    contendor = contendor_do_servico(nome)
    if not contendor:
        return (f"Contêiner: nenhum identificado para '{nome}' (serviço sem contêiner, ou nome não"
                f" resolvido); sem log de contêiner a anexar\n")
    linhas = [f"Contêiner: {contendor}",
              f"Capturado em: {agora()} (ao abrir o incidente, antes de qualquer recriação)"]
    rc, out, err = roda(["docker", "inspect", "-f", FORMATO_ESTADO, contendor])
    try:
        if rc != 0:
            raise ValueError((err or out or f"docker inspect saiu {rc}").splitlines()[0][:200])
        linhas += _estado_do_contendor(out)
    except (ValueError, TypeError) as e:     # inspect falhou ou devolveu o que nao e estado
        linhas.append(f"Estado: indisponível ({redigir(str(e)[:200])})")
    rc, out, err = roda(["docker", "logs", "--tail", str(LINHAS_DE_LOG), "--timestamps", contendor])
    if rc != 0:
        motivo = (err or out or f"docker logs saiu {rc}").splitlines()[0][:200]
        linhas.append(f"Log: indisponível ({redigir(motivo)})")
    else:
        corpo = "\n".join(p for p in (out, err) if p)       # stdout e stderr do contendor, nessa ordem
        linhas.append(f"Log (últimas {LINHAS_DE_LOG} linhas, redigido):")
        linhas.append(redigir(_cauda(corpo, LIMITE_DO_LOG, por_linha=True)) or "(vazio)")
    return "\n".join(linhas) + "\n"

def abre_incidente(nome: str, info: dict) -> str | None:
    motivo = (info.get("motivo") or "serviço com sonda fora há mais de 10 min").strip()
    sintoma = motivo.splitlines()[0][:100]
    titulo = redigir(f"{nome}: {sintoma}")
    desc = (
        f"Detectado por sinal: serviço '{nome}' fora há mais de 10 min.\n\n"
        f"- Serviço: {nome}\n"
        f"- Fora desde: {info.get('fora_desde')}\n"
        f"- Exercitado: {info.get('exercitado')}\n"
        f"- Motivo: {info.get('motivo')}\n"
    )
    tarefas_bin = shutil.which("tarefas")
    if not tarefas_bin:
        candidato = raizes.release() / "harness" / "bin" / "tarefas"
        if candidato.is_file() and os.access(candidato, os.X_OK):
            tarefas_bin = str(candidato)
    if not tarefas_bin:
        sys.stderr.write("sinal: binario 'tarefas' nao encontrado no PATH nem na release; incidente nao aberto\n")
        return None

    # log e estado agora, antes de qualquer recriacao; o corpo inteiro (motivo incluso) passa por redigir
    desc = redigir(desc + "\n" + captura_contendor(nome))
    cmd = [tarefas_bin, "criar", titulo, "--incidente", "--cadeira", "ti", "--desc", desc]
    rc, out, err = roda(cmd, timeout=30)
    if rc != 0:
        sys.stderr.write(f"sinal: falha ao abrir incidente para {nome}: {err or out} (exit {rc})\n")
        return None
    m = re.search(r"item\s+(\d+)\s+criado", out)
    incidente_id = m.group(1) if m else "criado"
    print(f"INCIDENTE: #{incidente_id} — {titulo}")
    return incidente_id


def processa_estado_item(
    nome: str,
    item: dict,
    anterior_item: dict | None,
    agora_dt: datetime,
    abre_incidente_fn=abre_incidente,
    limiar_segundos: int = LIMIAR_INCIDENTE_SEGUNDOS,
) -> None:
    estado = item.get("estado")
    if estado == "fora":
        if anterior_item and anterior_item.get("estado") == "fora":
            fora_desde_str = anterior_item.get("fora_desde") or anterior_item.get("lido_em")
            incidente_id = anterior_item.get("incidente_id")
        else:
            fora_desde_str = item.get("lido_em") or agora_dt.isoformat(timespec="seconds")
            incidente_id = None

        item["fora_desde"] = fora_desde_str
        if incidente_id:
            item["incidente_id"] = incidente_id

        try:
            inicio = parse_dt(fora_desde_str)
            segundos_fora = (agora_dt - inicio).total_seconds()
        except Exception:
            segundos_fora = 0

        if segundos_fora >= limiar_segundos and not item.get("incidente_id"):
            novo_id = abre_incidente_fn(nome, item)
            if novo_id:
                item["incidente_id"] = novo_id
    else:
        item.pop("fora_desde", None)
        item.pop("incidente_id", None)


def reconcilia_com_anterior(
    dados: dict,
    anterior: dict | None,
    agora_dt: datetime | None = None,
    abre_incidente_fn=abre_incidente,
    limiar_segundos: int = LIMIAR_INCIDENTE_SEGUNDOS,
) -> dict:
    if agora_dt is None:
        agora_dt = datetime.now(timezone.utc)
    anterior_servicos = (anterior or {}).get("servicos", {})
    anterior_runtime = (anterior or {}).get("runtime")

    for nome, item in dados.get("servicos", {}).items():
        ant_item = anterior_servicos.get(nome)
        processa_estado_item(
            nome, item, ant_item, agora_dt,
            abre_incidente_fn=abre_incidente_fn,
            limiar_segundos=limiar_segundos,
        )

    if "runtime" in dados:
        processa_estado_item(
            "runtime", dados["runtime"], anterior_runtime, agora_dt,
            abre_incidente_fn=abre_incidente_fn,
            limiar_segundos=limiar_segundos,
        )

    return dados


def coleta():
    servicos = {}
    for nome, contendor in POR_HEALTHCHECK.items():
        e = do_healthcheck(nome, contendor)
        e["lido_em"] = agora()
        servicos[nome] = e
    for nome, posto, url, exige, proibido in POR_SONDA_EXTERNA:
        e = do_sonda_externa(nome, posto, url, exige, proibido)
        e["lido_em"] = agora()
        servicos[nome] = e
    for nome, motivo in SEM_SONDA.items():
        servicos[nome] = {"estado": "sem-sinal", "exercitado": None,
                          "motivo": motivo, "lido_em": agora()}
    for nome, unit in POR_SYSTEMD_RESULT.items():
        e = do_systemd_result(nome, unit)
        e["lido_em"] = agora()
        servicos[nome] = e
    e = do_gpu()
    e["lido_em"] = agora()
    servicos["gpu-host"] = e
    e = do_raiz()
    e["lido_em"] = agora()
    servicos["raiz-host"] = e
    runtime = do_runtime()
    runtime["lido_em"] = agora()
    return {"gerado_em": agora(), "runtime": runtime, "servicos": servicos}


# --- a porta, medida de fora (card #3919; spec eixos-do-host R7 e R8) ------------------------------------
#
# A sonda mede a porta pelo endereco publico com o token do cliente da sonda, chamando um ato leve, e nunca
# abre sessao: o ato leve e a tool `sessao` sem ato, o formato que `oplog.origem_da_linha` ja reconhece como
# sonda e que nao monta pacote nem cunha sessao (a abertura monta ~12 mil tokens e uma sessao duravel).
# Erro de transporte e a requisicao que nao deixou linha de giro na porta; erro de verbo e a classe do giro,
# nunca o exit 1 (arq:0123). O tempo que a porta registrou para o mesmo giro vem do bruto do dia, ao lado do
# tempo medido de fora: a diferenca e o custo do tunel. O token nunca se imprime, nem em erro.
# ambiente: SINAL_PORTA_URL[=https://ops.platafirma.org/mcp] · SINAL_PORTA_TOOL[=sessao] ·
#   SINAL_SONDA_CLIENTE[=sonda] (clientId no realm; o segredo mora em <instancia>/segredos/keycloak/<clientId>) ·
#   SINAL_SONDA_TOKEN_URL[=https://auth.platafirma.org/realms/platafirma/protocol/openid-connect/token] ·
#   SINAL_PORTA_TIMEOUT[=10] (o bruto do dia e lido por `oplog.ler`, que resolve onde ele mora)
PORTA_URL_PADRAO = "https://ops.platafirma.org/mcp"
PORTA_TOOL_PADRAO = "sessao"
SONDA_CLIENTE_PADRAO = "sonda"
REALM_URL_PADRAO = "https://auth.platafirma.org/realms/platafirma/protocol/openid-connect/token"
HTTP_OK = 200
HTTP_ERRO = 400                             # daqui para cima a resposta e erro
GIRO_ATRASO_INICIAL_S = 0.05                # espera pela linha de giro: dobra a cada tentativa, ate `espera_s`
SINAL_JANELA_DO_GIRO_S = 2                  # tolerancia entre o relogio da sonda e o `ts` que a porta gravou
SINAL_ERRO_DE_TOKEN = (401, 403)


class SemLeitura(Exception):
    """A medida nao se fez: a fonte nao respondeu. Vira `nao_consegui_olhar` com a causa, nunca zero."""

    def __init__(self, causa: str, fonte: str):
        super().__init__(f"{fonte}: {causa}")
        self.causa = causa
        self.fonte = fonte


def _pedido(url: str, corpo: bytes, cabecalhos: dict, timeout: float) -> tuple:
    """(status, cabecalhos, texto, ms). Sem proxy de ambiente: a medida e do caminho que a sonda faz.
    Erro de rede sobe como URLError/OSError/HTTPException; resposta HTTP de erro volta como status."""
    req = urllib.request.Request(url, data=corpo, headers=cabecalhos)
    abridor = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    t0 = time.monotonic()
    try:
        with abridor.open(req, timeout=timeout) as r:
            texto = r.read().decode("utf-8", "replace")
            return r.status, r.headers, texto, (time.monotonic() - t0) * 1000
    except urllib.error.HTTPError as e:
        texto = e.read().decode("utf-8", "replace")
        return e.code, e.headers, texto, (time.monotonic() - t0) * 1000


_ERROS_DE_REDE = (urllib.error.URLError, OSError, TimeoutError, http.client.HTTPException)


def obter_token(timeout: float) -> str:
    """Token do cliente da sonda (client_credentials). Sem o segredo de segredos/keycloak/<clientId>, a sonda
    nao tem identidade: SemLeitura, e a medida da porta sai `nao_consegui_olhar` sem tentar com outra."""
    cliente = os.environ.get("SINAL_SONDA_CLIENTE", SONDA_CLIENTE_PADRAO)
    fonte_do_segredo = f"segredos/keycloak/{cliente}"
    try:
        segredo = (raizes.instancia() / "segredos" / "keycloak" / cliente).read_text(encoding="utf-8").strip()
    except OSError:
        segredo = ""
    if not segredo or "\n" in segredo:
        raise SemLeitura("sem_credencial_da_sonda", fonte_do_segredo)
    url = os.environ.get("SINAL_SONDA_TOKEN_URL", REALM_URL_PADRAO)
    fonte = f"{urlparse(url).netloc} (token do cliente {cliente})"
    corpo = urlencode({"grant_type": "client_credentials", "client_id": cliente, "client_secret": segredo}).encode()
    try:
        status, _, texto, _ = _pedido(url, corpo, {"Content-Type": "application/x-www-form-urlencoded"}, timeout)
    except _ERROS_DE_REDE:
        raise SemLeitura("keycloak_fora", fonte) from None
    if status != HTTP_OK:
        raise SemLeitura("token_recusado", fonte)
    try:
        return json.loads(texto)["access_token"]
    except (ValueError, KeyError, TypeError):
        raise SemLeitura("token_ilegivel", fonte) from None


def _corpo_jsonrpc(texto: str) -> dict:
    """A resposta do MCP vem como JSON ou como evento SSE (`data: {...}`)."""
    for linha in texto.splitlines():
        if linha.startswith("data:"):
            return json.loads(linha[5:].strip())
    return json.loads(texto)


def _atrasos(total_s: float) -> list[float]:
    """As esperas antes de cada leitura do bruto: nenhuma na primeira, depois 0,05 s dobrando enquanto a soma
    couber em `total_s`."""
    atrasos, atraso, soma = [0.0], GIRO_ATRASO_INICIAL_S, 0.0
    while soma + atraso <= total_s:
        atrasos.append(atraso)
        soma += atraso
        atraso *= 2
    return atrasos


def giro_da_porta(tool: str, t0: datetime, t1: datetime, pasta: Path | None = None,
                  espera_s: float = 1.0) -> dict | None:
    """A linha de giro que a porta gravou no bruto do dia para a chamada da sonda (tool igual, sem ato, sem
    sessao) entre t0 e t1, com a folga do relogio. Espera um instante pela linha, que a porta escreve ao
    terminar o giro. Devolve {dur_ms, classe} ou None quando a porta nao deixou linha."""
    dia = oplog.dia_local(t0.isoformat())          # o dia do arquivo e o dia local da porta (spec log-de-negocio §3)
    folga = timedelta(seconds=SINAL_JANELA_DO_GIRO_S)
    for atraso in _atrasos(espera_s):
        time.sleep(atraso)
        achado = None
        for reg in oplog.ler(dia, diretorio_=pasta, tool=tool):    # so `lib/oplog` abre o bruto (arq:0123 §3)
            try:
                ts = parse_dt(reg["ts"])
            except (ValueError, KeyError, TypeError):
                continue
            if (reg.get("evento") != "http_req" and not reg.get("ato")
                    and reg.get("sessao_id") in (None, "", "-") and t0 - folga <= ts <= t1 + folga):
                achado = {"dur_ms": reg.get("dur_ms"), "classe": reg.get("classe")}
        if achado:
            return achado
    return None


def medir_porta(pasta_do_bruto: Path | None = None, espera_s: float = 1.0) -> dict:
    """Uma medida da porta, de fora (R7, R8): `latencia_externa_ms` ao lado de `dur_ms_porta`, o que a porta
    registrou para o mesmo giro; `erros_transporte` (1 quando a requisicao nao deixou linha de giro) separado
    de `erro_verbo` (a classe do giro quando nao e ok). Sem identidade da sonda, ou com a porta recusando o
    token, a medida e `nao_consegui_olhar`, com a causa. Chama a porta uma vez por passada (R13)."""
    timeout = float(os.environ.get("SINAL_PORTA_TIMEOUT", "10"))
    url = os.environ.get("SINAL_PORTA_URL", PORTA_URL_PADRAO)
    tool = os.environ.get("SINAL_PORTA_TOOL", PORTA_TOOL_PADRAO)
    fonte = urlparse(url).netloc
    medida = {"estado_leitura": "lida", "causa": None, "fonte": None, "latencia_externa_ms": None,
              "dur_ms_porta": None, "erros_transporte": 0, "erro_verbo": None}

    def sem_leitura(causa: str, onde: str) -> dict:
        return {**medida, "estado_leitura": "nao_consegui_olhar", "causa": causa, "fonte": onde}

    try:
        token = obter_token(timeout)
    except SemLeitura as e:
        return sem_leitura(e.causa, e.fonte)

    cabecalhos = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream",
                  "Authorization": f"Bearer {token}"}

    def jsonrpc(metodo: str, ident: int | None = None, params: dict | None = None) -> bytes:
        corpo = {"jsonrpc": "2.0", "method": metodo, "params": params or {}}
        if ident is not None:
            corpo["id"] = ident
        return json.dumps(corpo).encode()

    try:
        status, resposta, _, _ = _pedido(url, jsonrpc("initialize", 1, {
            "protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": {"name": "sinal", "version": "0"}}),
            cabecalhos, timeout)
        if status in SINAL_ERRO_DE_TOKEN:
            return sem_leitura("porta_recusou_o_token", fonte)
        if status < HTTP_ERRO:
            if resposta.get("mcp-session-id"):
                cabecalhos["mcp-session-id"] = resposta["mcp-session-id"]
            try:
                _pedido(url, jsonrpc("notifications/initialized"), cabecalhos, timeout)
            except _ERROS_DE_REDE:
                pass
    except _ERROS_DE_REDE:
        status = None

    t0 = datetime.now(timezone.utc)
    ms, status_da_chamada = None, None
    if status is not None and status < HTTP_ERRO:
        try:
            status_da_chamada, _, _, ms = _pedido(
                url, jsonrpc("tools/call", 2, {"name": tool, "arguments": {}}), cabecalhos, timeout)
        except _ERROS_DE_REDE:
            status_da_chamada, ms = None, None
    t1 = datetime.now(timezone.utc)

    if status_da_chamada in SINAL_ERRO_DE_TOKEN:
        return sem_leitura("porta_recusou_o_token", fonte)
    giro = giro_da_porta(tool, t0, t1, pasta_do_bruto, espera_s) if status_da_chamada is not None else None
    if giro is None:
        # a requisicao nao deixou linha de giro: a borda ou o tunel responderam 5xx, ou deu timeout antes da porta ver
        return {**medida, "erros_transporte": 1, "latencia_externa_ms": ms}
    medida["latencia_externa_ms"] = ms
    medida["dur_ms_porta"] = giro.get("dur_ms")
    if giro.get("classe") not in (None, "ok"):
        medida["erro_verbo"] = giro["classe"]
    return medida


def _texto_da_medida(m: dict) -> str:
    if m["estado_leitura"] != "lida":
        return f"porta: nao consegui olhar {m['fonte']} ({m['causa']})"
    partes = []
    if m["latencia_externa_ms"] is not None:
        partes.append(f"{m['latencia_externa_ms']:.0f} ms por fora")
    if m["dur_ms_porta"] is not None:
        partes.append(f"{m['dur_ms_porta']:.0f} ms registrados pela porta")
    if m["erros_transporte"]:
        partes.append("erro de transporte")
    if m["erro_verbo"]:
        partes.append(f"erro de verbo ({m['erro_verbo']})")
    return "porta: " + (", ".join(partes) or "sem numero")


# --- a serie dos eixos (card #3922; spec eixos-do-host R15; spec banco-de-eventos-de-plataforma R8 e R13) ------------
#
# Depois da coleta de saude e do arquivo de sinal, a passada grava a serie dos quatro eixos do host. O registro de cadencia
# (registro/cadencia-eixos.json) diz o que vence neste minuto. Cada eixo vencido e lido UMA vez, pelo ato
# `infra medir <eixo> --json`, e o total do host e a parte de cada stack e servico saem dessa mesma leitura (dono,
# 21/10/2026: uma coleta so por evento). O JSON vira o evento da ficha (bin/_metrica/eventos.py), entra na fila local e a
# fila sai pela rota de escrita; com o banco mudo ela guarda, e a passada seguinte repoe (R8). A morte por limite vem do
# detector, fora da cadencia, com cursor. A passada chama a porta uma vez, por `infra medir rede`, porque a juncao do R13
# depende disso. Erro da passada de eventos vai a stderr e NUNCA muda o exit do sinal: a unit aceita 0 e 1.
# ambiente: SINAL_INFRA[=bin/infra] · SINAL_DETECTOR[=bin/_infra/detector-morte] · SINAL_CADENCIA[=registro/cadencia-eixos.json] ·
#   SINAL_EVENTOS_URL[=http://127.0.0.1:8111] · SINAL_EVENTOS_TIMEOUT[=10] · SINAL_INSTANCIA[=nome do host]
ATO_TIMEOUT_S = 45
DETECTOR_TIMEOUT_S = 40
ESPERA_DO_GRUPO_MORTO_S = 5
PASSADA_ORCAMENTO_S = 90                    # os atos em paralelo (45 s no maximo cada) e o envio cabem nele
SAIDAS_COM_JSON = (0, 5)                    # lido e nao consegui olhar: as duas trazem o JSON
HORA_S = 3600
LIMITE_DA_AMOSTRA_S = 86400                 # a API serve a amostra crua ate um dia; acima, o agregado por hora
EXIT_REGISTRO_RECUSADO = 4


def _binario_irmao(variavel: str, *partes: str) -> str:
    return os.environ.get(variavel) or str(Path(__file__).resolve().parent.joinpath(*partes))


def _rodar_com_teto(comando: list[str], timeout: float) -> subprocess.CompletedProcess:
    """Roda o comando num grupo de processos proprio e, estourado o teto, mata o grupo inteiro: o ato e um script que
    abre journalctl, docker e outros, e matar so o pai deixaria um neto segurando o cano e a passada esperando por ele."""
    processo = subprocess.Popen(comando, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    try:
        saida, erro = processo.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(processo.pid, signal.SIGKILL)
        try:
            processo.communicate(timeout=ESPERA_DO_GRUPO_MORTO_S)
        except subprocess.TimeoutExpired:
            pass                                 # processo que nem o SIGKILL tira do estado D: a passada segue sem ele
        raise
    return subprocess.CompletedProcess(comando, processo.returncode, saida, erro)


def ler_eixo(eixo: str, janela_s: int) -> dict:
    """O JSON do eixo, o retorno de `infra medir <eixo> --json`. Ato que nao respondeu (timeout, exit fora de 0 e 5, saida
    que nao e o JSON do eixo) vira `nao_consegui_olhar` com a causa: nunca zero e nunca minuto calado."""
    comando = [_binario_irmao("SINAL_INFRA", "infra"), "medir", eixo, "--json"]
    if eixo == "ram":
        comando += ["--janela", str(janela_s)]      # as mortes que a frase do ato conta; a serie nao as guarda
    try:
        p = _rodar_com_teto(comando, ATO_TIMEOUT_S)
        j = json.loads(p.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return eventos.leitura_sem_resposta(eixo)
    if p.returncode not in SAIDAS_COM_JSON or not isinstance(j, dict) or j.get("eixo") != eixo:
        return eventos.leitura_sem_resposta(eixo)
    return j


def ler_morte(desde: int | None, ate: int) -> dict:
    """O retorno do detector de morte na janela, ou `nao_consegui_olhar` se ele nao respondeu."""
    comando = [_binario_irmao("SINAL_DETECTOR", "_infra", "detector-morte"), "--json"]
    if desde is not None:
        comando += ["--desde", str(desde)]
    comando += ["--ate", str(ate)]
    sem_resposta = {"estado_leitura": "nao_consegui_olhar", "causa": "detector_nao_respondeu", "fonte": "detector-morte",
                    "mortes": [], "vistas_sem_pid": [], "avisos": []}
    try:
        p = _rodar_com_teto(comando, DETECTOR_TIMEOUT_S)
        j = json.loads(p.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return sem_resposta
    if p.returncode not in SAIDAS_COM_JSON or not isinstance(j, dict) or not isinstance(j.get("mortes"), list):
        return sem_resposta
    return {**sem_resposta, **j}


def _enviar_filas(filas: dict, prazo: float) -> dict:
    token = eventos.ler_token()
    url = os.environ.get("SINAL_EVENTOS_URL", eventos.URL_PADRAO)
    timeout = float(os.environ.get("SINAL_EVENTOS_TIMEOUT", str(eventos.TIMEOUT_PADRAO_S)))
    saida = {}
    for familia, fila in filas.items():
        pendentes = len(fila.ler())
        if not pendentes:
            continue
        if token is None:
            saida[familia] = {"inseridos": 0, "existentes": 0, "recusados": [], "pendentes": pendentes,
                              "erro": "sem token da sonda (segredos/eventos/EVENTOS_SONDA_TOKEN)"}
        else:
            saida[familia] = eventos.enviar_fila(familia, fila, url=url, token=token, timeout=timeout, prazo=prazo)
    return saida


def _amostras_da_passada(registro: dict, planos: dict, leituras: dict, estado: dict, minuto: datetime) -> list[dict]:
    """O evento de cada eixo lido, com os consumidores que a cadencia deixou entrar e a conta dos que ficaram de fora."""
    instancia = eventos.nome_da_instancia()
    amostras = []
    for eixo, j in leituras.items():
        plano, entram, fora = planos[eixo], [], []
        for consumidor in j.get("consumidores") or []:
            (entram if cadencia.entra(registro, plano, consumidor) else fora).append(consumidor)
        reconexoes = eventos.diferenciar_reconexoes(j, estado) if eixo == "rede" else {}
        amostras.append(eventos.evento_do_eixo(j, minuto=minuto, janela_s=plano.janela_s, instancia=instancia,
                                               escolhidos=entram, fora=fora, reconexoes=reconexoes))
    return amostras


def _passada_com_trava(agora: datetime, minuto: datetime, pasta: Path, registro: dict, *, ver: bool) -> dict:
    prazo = time.monotonic() + PASSADA_ORCAMENTO_S
    estado = cadencia.ler_estado(pasta)
    planos = cadencia.planejar(registro, estado, minuto)
    ate = int(agora.timestamp())
    anterior = (estado.get("detector") or {}).get("ate")
    desde = min(anterior, ate - 1) if isinstance(anterior, int) else None
    with ThreadPoolExecutor(max_workers=len(planos) + 1) as pool:
        lendo = {eixo: pool.submit(ler_eixo, eixo, plano.janela_s) for eixo, plano in planos.items() if plano.le}
        lendo_morte = pool.submit(ler_morte, desde, ate)
        leituras = {eixo: futuro.result() for eixo, futuro in lendo.items()}
        morte = lendo_morte.result()
    amostras = _amostras_da_passada(registro, planos, leituras, estado, minuto)
    resumo = {"eixos": {eixo: (j["estado_leitura"], j.get("causa")) for eixo, j in leituras.items()},
              "amostras": len(amostras), "mortes": len(morte["mortes"]), "morte": morte, "descartados": 0}
    if ver:
        return {**resumo, "ver": {"eixo_host": amostras, "morte_limite": morte["mortes"]}}
    filas = {familia: eventos.Fila(pasta, familia) for familia in eventos.FAMILIAS}
    # primeiro a fila (o evento nunca fica so na memoria), depois o estado, depois o envio
    resumo["descartados"] = filas["eixo_host"].anexar(amostras) + filas["morte_limite"].anexar(morte["mortes"])
    for eixo in leituras:
        cadencia.registrar(estado, planos[eixo], minuto)
    if morte["estado_leitura"] == "lida":
        estado["detector"] = {"ate": ate}
    cadencia.gravar_estado(pasta, estado)
    return {**resumo, "envio": _enviar_filas(filas, prazo)}


def passada_de_eventos(agora: datetime | None = None, *, ver: bool = False) -> dict:
    """A passada da serie: le o que vence, grava na fila, grava o estado e envia. Com `ver`, mostra o que gravaria e nao
    toca a fila, o estado nem a rota. Outra passada em curso (a trava da pasta) deixa esta de lado."""
    agora = agora or datetime.now(timezone.utc)
    pasta = eventos.pasta_de_estado()
    registro = cadencia.carregar()
    with eventos.trava(pasta) as livre:
        if not livre:
            return {"pulada": "outra passada de eventos em curso"}
        return _passada_com_trava(agora, cadencia.minuto_de(agora), pasta, registro, ver=ver)


def _frase_da_morte(m: dict) -> str:
    if m["estado_leitura"] != "lida":
        return f"morte: nao consegui olhar ({m.get('causa')})"
    texto = f"morte: {len(m['mortes'])}"
    if m.get("vistas_sem_pid"):
        texto += f", {len(m['vistas_sem_pid'])} vista(s) sem pid"
    return texto


def _frase_do_envio(familia: str, e: dict) -> str:
    texto = f"{familia} {e['inseridos'] + e['existentes']} gravadas"
    if e.get("recusados"):
        texto += f", {len(e['recusados'])} recusadas"
    if e.get("pendentes"):
        texto += f", {e['pendentes']} na fila"
    if e.get("erro"):
        texto += f", erro: {e['erro']}"
    return texto


def _linha_dos_eventos(r: dict) -> str:
    """Uma linha, para o journal da unit: o que a passada leu, a morte, o envio e o que o banco mudo deixou na fila."""
    if r.get("pulada"):
        return f"eventos: pulada ({r['pulada']})"
    eixos_lidos = ", ".join(f"{eixo} {'lida' if estado == 'lida' else f'nao consegui olhar ({causa})'}"
                            for eixo, (estado, causa) in r["eixos"].items()) or "nenhum eixo venceu"
    partes = [f"eventos: {eixos_lidos}", _frase_da_morte(r["morte"])]
    partes += [_frase_do_envio(familia, e) for familia, e in (r.get("envio") or {}).items()]
    if r.get("descartados"):
        partes.append(f"fila cheia: {r['descartados']} descartada(s) das mais antigas")
    partes += [f"aviso: {aviso}" for aviso in r["morte"].get("avisos") or []]
    return " · ".join(partes)


def passada_de_eventos_sem_derrubar(inicio: datetime) -> None:
    """A passada de eventos dentro do `sinal`: o que der errado vai a stderr e nunca muda o exit. O minuto da amostra sai de
    `inicio`, o instante em que o processo comecou, e nao de quando a coleta de saude terminou (~8 s depois): com o timer
    a menos de dez segundos do minuto cheio, o fim da coleta cruzava a virada e deixava minuto sem amostra e minuto com duas."""
    try:
        print(_linha_dos_eventos(passada_de_eventos(inicio)))
    except Exception as e:  # noqa: BLE001  (a passada de eventos nunca derruba a de saude)
        sys.stderr.write(f"sinal: eventos: {type(e).__name__}: {e}\n")


def _eventos_a_mao(*, ver: bool) -> int:
    try:
        r = passada_de_eventos(ver=ver)
    except cadencia.RegistroInvalido as e:
        sys.stderr.write(f"sinal: eventos: registro de cadencia recusado: {e}\n")
        return EXIT_REGISTRO_RECUSADO
    for familia, lista in (r.get("ver") or {}).items():
        for evento in lista:
            print(f"{familia} {json.dumps(evento, ensure_ascii=False, sort_keys=True)}")
    if r.get("ver"):                              # o que o detector respondeu, sem as mortes (elas já saíram acima)
        resposta = {k: r["morte"].get(k) for k in ("estado_leitura", "causa", "fonte", "desde", "ate", "vistas_sem_pid",
                                                  "avisos")}
        print(f"morte {json.dumps(resposta, ensure_ascii=False, sort_keys=True)}")
    print(_linha_dos_eventos(r))
    return 0


def serie(eixo: str, horas: int, agora: datetime | None = None) -> int:
    """Le a serie do eixo pela API de leitura (R11) e diz quantas amostras, quantas lidas e a cobertura: a prova do Aceite
    no host. Sai 0 com a cobertura completa, 1 com ela parcial ou ausente, 5 quando a API nao respondeu."""
    ate = cadencia.minuto_de(agora or datetime.now(timezone.utc))
    granularidade = "amostra" if horas * HORA_S <= LIMITE_DA_AMOSTRA_S else "hora"
    url = os.environ.get("SINAL_EVENTOS_URL", eventos.URL_PADRAO)
    try:
        status, corpo = eventos.ler_serie(eixo, de=ate - timedelta(hours=horas), ate=ate, granularidade=granularidade,
                                          url=url, timeout=float(os.environ.get("SINAL_EVENTOS_TIMEOUT", "10")))
    except eventos.RedeFora:
        print(f"serie: a API do banco de eventos nao respondeu ({url})")
        return 5
    if status != HTTP_OK or corpo is None:
        print(f"serie: a API respondeu {status}" + (f" {corpo.get('tipo')}: {corpo.get('detalhe')}" if corpo else ""))
        return 5
    itens = corpo.get("amostras" if granularidade == "amostra" else "horas") or []
    lidas = sum(1 for i in itens if i.get("estado_leitura", "lida") == "lida" and i.get("lidas", 1))
    cobertura = corpo["cobertura"]
    print(f"{eixo}: {len(itens)} {'amostras' if granularidade == 'amostra' else 'horas'} ({lidas} lidas) em {horas} h, "
          f"cobertura {cobertura['estado']} ({cobertura['coberto_s']:.0f} de {cobertura['esperado_s']:.0f} s)")
    return 0 if cobertura["estado"] == "completa" else 1


def _serie_a_mao(args: list[str]) -> int:
    uso = "uso: sinal --serie <rede|ram|vram|cpu> [--horas <n>]"
    horas = 1
    if not args or args[0] not in cadencia.EIXOS or args[1:] not in ([], ["--horas", args[-1]]):
        print(uso, file=sys.stderr)
        return 2
    if args[1:]:
        if not args[-1].isdigit() or not 0 < int(args[-1]) <= 400 * 24:
            print(uso + " (horas: de 1 a 9600)", file=sys.stderr)
            return 2
        horas = int(args[-1])
    return serie(args[0], horas)


def main():
    inicio = datetime.now(timezone.utc)
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--ajuda", "ajuda"):
        print(__doc__.strip())
        print("\nuso: sinal [--ver | --porta [--json] | --eventos [--ver] | --serie <eixo> [--horas <n>]]")
        print("  sem argumento : coleta e escreve " + SAIDA + ", e grava a serie dos eixos que vencem")
        print("  --ver         : mostra o arquivo atual, sem coletar")
        print("  --porta       : mede a porta de fora, uma vez, com o token do cliente da sonda (nao grava o arquivo")
        print("                  de sinal); --json devolve a medida; sai 5 quando nao consegui olhar")
        print("  --eventos     : so a passada da serie dos eixos (registro/cadencia-eixos.json); com --ver mostra o que")
        print("                  gravaria, sem fila, sem estado e sem enviar")
        print("  --serie       : le a serie do eixo pela API do banco de eventos e diz amostras e cobertura; sai 1 com")
        print("                  a cobertura incompleta, 5 quando a API nao respondeu")
        return 0
    if argv and argv[0] == "--porta":
        medida = medir_porta()
        print(json.dumps(medida, ensure_ascii=False, indent=2) if "--json" in argv else _texto_da_medida(medida))
        return 0 if medida["estado_leitura"] == "lida" else 5
    if argv and argv[0] == "--eventos":
        return _eventos_a_mao(ver="--ver" in argv[1:])
    if argv and argv[0] == "--serie":
        return _serie_a_mao(argv[1:])
    if argv and argv[0] == "--ver":
        if not os.path.exists(SAIDA):
            print(json.dumps({"estado": "ausente",
                              "motivo": f"{SAIDA} nao existe: nenhuma coleta ate agora"},
                             ensure_ascii=False, indent=2))
            return 1
        with open(SAIDA, "r", encoding="utf-8") as f:
            print(f.read())
        return 0

    anterior = None
    if os.path.exists(SAIDA):
        try:
            with open(SAIDA, "r", encoding="utf-8") as f:
                anterior = json.load(f)
        except Exception as e:
            sys.stderr.write(f"sinal: aviso lendo anterior ({SAIDA}): {e}\n")

    dados = coleta()
    reconcilia_com_anterior(dados, anterior)

    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
    tmp = SAIDA + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:                   # escrita atomica: quem le nunca ve meia coleta
        json.dump(dados, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, SAIDA)

    fora = [n for n, e in dados["servicos"].items() if e["estado"] == "fora"]
    if dados["runtime"]["estado"] == "fora":
        fora.append("RUNTIME")
    for nome, e in sorted(dados["servicos"].items()):
        extra = []
        if e.get("motivo"):
            extra.append(e["motivo"])
        if e.get("fora_desde"):
            extra.append(f"fora desde {e['fora_desde']}")
        if e.get("incidente_id"):
            extra.append(f"incidente #{e['incidente_id']}")
        sufixo = f"  — {'; '.join(extra)}" if extra else ""
        print(f"{e['estado']:10} {nome}{sufixo}")
    r = dados["runtime"]
    extra_r = []
    if r.get("motivo"):
        extra_r.append(r["motivo"])
    if r.get("fora_desde"):
        extra_r.append(f"fora desde {r['fora_desde']}")
    if r.get("incidente_id"):
        extra_r.append(f"incidente #{r['incidente_id']}")
    sufixo_r = f"  — {'; '.join(extra_r)}" if extra_r else ""
    print(f"{r['estado']:10} (runtime){sufixo_r}")
    passada_de_eventos_sem_derrubar(inicio)
    return 1 if fora else 0


if __name__ == "__main__":
    sys.exit(main())
