#!/usr/bin/env python3
# sinal — coleta o estado de saude dos servicos e escreve o arquivo de sinal.
# capacidade: incidente
# dono: claudinho-TI
# use para: 'está no ar?', saúde dos serviços, arquivo de sinal
# atos: nenhum — roda direto, sem ato
# componente: docker
"""sinal — coleta o estado de saude dos servicos e escreve o arquivo de sinal.

Contrato com o agregador do plano de controle (#297): ele le ESTE arquivo e nao
conhece healthcheck nenhum. Tres regras que o formato existe para sustentar:

  - servico sem sonda entra na lista como `sem-sinal`, nunca some dela;
  - `ausente` (nao houve leitura) e distinto de qualquer valor lido;
  - toda entrada que nao esta `no-ar` carrega `motivo`.

Duas fontes, por necessidade: quem tem shell na imagem traz o veredito do
proprio healthcheck do Docker; quem nao tem (oauth2-proxy, cloudflared)
e sondado daqui, de fora, por um contendor-posto que esta na mesma rede.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

# Raizes de producao (card #3010): o sinal e estado da instancia, nunca da release.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import raizes  # noqa: E402

# ambiente: PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] (grava var/sinal/servicos.json; override so para teste)
SAIDA = str(raizes.instancia() / "var" / "sinal" / "servicos.json")
# Limiar para abertura de incidente (card #3253, pós-morte do #3251): 10 min (600s) por padrão.
LIMIAR_INCIDENTE_SEGUNDOS = int(os.environ.get("SINAL_INCIDENTE_LIMIAR_SEGUNDOS", "600"))
# POSTO: contêiner COM curl e NA rede `conhecimento` (plataforma-wiki_default), que é
# onde os oauth2-proxy vivem. Era `platafirma-core-vikunja-proxy-1`, desligado com o
# Vikunja (#172): a sonda passou a devolver "No such container" e os dois proxies saíam
# FORA com o serviço de pé — painel que acusa queda falsa treina todo mundo a ignorá-lo.
# O landing NÃO serve: está só na rede `borda` e não enxerga os proxies.
POSTO = "plataforma-wiki-mediawiki-1"

# Servico -> contendor. Quem tem healthcheck proprio le do Docker.
POR_HEALTHCHECK = {
    "keycloak": "platafirma-core-keycloak-1",
    "keycloak-db": "platafirma-core-keycloak-db-1",
    "landing": "platafirma-core-landing-1",
    "mediawiki": "plataforma-wiki-mediawiki-1",
    "rag-extractor-api": "rag-extractor-api",
    "acervo-api": "acervo-api",
}

# Imagem sem shell: sonda de fora, pelo posto.
# (nome, posto, url, exige-no-corpo, reprova-se-contem)
POR_SONDA_EXTERNA = [
    ("oauth2-proxy", POSTO, "http://oauth2-proxy:4180/ping", None, None),
    ("oauth2-proxy-harness", POSTO, "http://oauth2-proxy-harness:4180/ping", None, None),
    # readyConnections e o que distingue tunel de pe de tunel sem conexao com a
    # borda da Cloudflare: o processo fica vivo nos dois casos.
    ("cloudflared", POSTO, "http://cloudflared:20241/ready", None, '"readyConnections":0'),
]

# Declarado e sem sonda. Aparece na lista como sem-sinal, de proposito.
SEM_SONDA = {
    "mcp": "sem rota de saude propria; sonda fica para quando houver",
}

# Servico -> unit systemd --user oneshot (disparada por timer, sem container e sem
# healthcheck proprio, card #3141 passo 9). O veredito e o Result do ultimo start:
# `systemctl --user show <unit> -p Result` == "success" e no-ar; qualquer outro
# valor (exit-code, timeout, signal, ou vazio — nunca rodou) e fora, com o Result
# como motivo.
POR_SYSTEMD_RESULT = {
    "casa-site-publicar": "casa-site-publicar.service",
    "abertura-caderno": "abertura-caderno.service",
}


def agora():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def roda(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout de {timeout}s"
    except Exception as e:                      # daemon fora, binario ausente
        return 125, "", f"{type(e).__name__}: {e}"


def do_healthcheck(nome, contendor):
    fmt = "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}sem-healthcheck{{end}}"
    rc, out, err = roda(["docker", "inspect", "-f", fmt, contendor])
    if rc != 0:
        return {"estado": "fora", "exercitado": "docker inspect",
                "motivo": err.splitlines()[0] if err else f"contendor {contendor} nao existe"}
    status, saude = (out.split("|") + ["", ""])[:2]
    if status != "running":
        return {"estado": "fora", "exercitado": "docker inspect",
                "motivo": f"contendor {status}"}
    if saude == "healthy":
        return {"estado": "no-ar", "exercitado": "healthcheck do contendor"}
    if saude == "sem-healthcheck":
        return {"estado": "sem-sinal", "exercitado": None,
                "motivo": "contendor rodando, sem healthcheck declarado"}
    if saude == "starting":
        return {"estado": "degradado", "exercitado": "healthcheck do contendor",
                "motivo": "em start_period, ainda sem veredito"}
    rc2, log, _ = roda(["docker", "inspect", "-f",
                        "{{if .State.Health}}{{range .State.Health.Log}}{{.Output}}{{end}}{{end}}",
                        contendor])
    motivo = (log or "healthcheck reprovou").strip().replace("\n", " ")[:300]
    return {"estado": "fora", "exercitado": "healthcheck do contendor", "motivo": motivo}


def do_sonda_externa(nome, posto, url, exige, proibido):
    onde = f"GET {url} (de {posto})"
    rc, out, err = roda(["docker", "exec", posto, "curl", "-fsS", "--max-time", "6", url])
    if rc != 0:
        motivo = (err or out or f"curl saiu {rc}").splitlines()[0][:300]
        return {"estado": "fora", "exercitado": onde, "motivo": motivo}
    if exige and exige not in out:
        return {"estado": "degradado", "exercitado": onde,
                "motivo": f"respondeu sem {exige} no corpo"}
    if proibido and proibido in out:
        return {"estado": "degradado", "exercitado": onde,
                "motivo": f"respondeu, mas contem {proibido}"}
    return {"estado": "no-ar", "exercitado": onde}


def do_systemd_result(nome, unit):
    onde = f"systemctl --user show {unit} -p Result"
    rc, out, err = roda(["systemctl", "--user", "show", unit, "-p", "Result"])
    if rc != 0:
        motivo = (err or out or f"systemctl saiu {rc}").splitlines()[0][:300]
        return {"estado": "fora", "exercitado": onde, "motivo": motivo}
    resultado = out.strip()
    if resultado.startswith("Result="):
        resultado = resultado[len("Result="):]
    if resultado == "success":
        return {"estado": "no-ar", "exercitado": onde}
    return {"estado": "fora", "exercitado": onde, "motivo": f"Result={resultado or '(vazio)'}"}

def do_runtime():
    """A classe de falha que healthcheck de servico nenhum pega: pacote de sistema
    atualizado com o processo vivo. Nada quebra ate alguem tentar CRIAR contendor —
    e ai nenhum servico volta de um restart, inclusive os de unless-stopped."""
    rc, out, err = roda(["docker", "run", "--rm", "alpine:3", "true"], timeout=90)
    if rc == 0:
        return {"estado": "no-ar", "exercitado": "docker run --rm alpine:3 true"}
    motivo = (err or out or f"saiu {rc}").splitlines()[0][:300]
    return {"estado": "fora", "exercitado": "docker run --rm alpine:3 true",
            "motivo": motivo or "criacao de contendor falhou"}


def parse_dt(iso_str: str) -> datetime:
    if iso_str.endswith("Z"):
        iso_str = iso_str[:-1] + "+00:00"
    return datetime.fromisoformat(iso_str)


def abre_incidente(nome: str, info: dict) -> str | None:
    motivo = (info.get("motivo") or "serviço com sonda fora há mais de 10 min").strip()
    sintoma = motivo.splitlines()[0][:100]
    titulo = f"{nome}: {sintoma}"
    desc = (
        f"Detectado por sinal: serviço '{nome}' fora há mais de 10 min.\n\n"
        f"- Serviço: {nome}\n"
        f"- Fora desde: {info.get('fora_desde')}\n"
        f"- Exercitado: {info.get('exercitado')}\n"
        f"- Motivo: {info.get('motivo')}\n"
    )
    tarefas_bin = shutil.which("tarefas")
    if not tarefas_bin:
        candidato = raizes.release() / "harness" / "bin" / "tarefas"
        if candidato.is_file() and os.access(candidato, os.X_OK):
            tarefas_bin = str(candidato)
    if not tarefas_bin:
        sys.stderr.write("sinal: binario 'tarefas' nao encontrado no PATH nem na release; incidente nao aberto\n")
        return None

    cmd = [tarefas_bin, "criar", titulo, "--incidente", "--cadeira", "ti", "--desc", desc]
    rc, out, err = roda(cmd, timeout=30)
    if rc != 0:
        sys.stderr.write(f"sinal: falha ao abrir incidente para {nome}: {err or out} (exit {rc})\n")
        return None
    m = re.search(r"item\s+(\d+)\s+criado", out)
    incidente_id = m.group(1) if m else "criado"
    print(f"INCIDENTE: #{incidente_id} — {titulo}")
    return incidente_id


def processa_estado_item(
    nome: str,
    item: dict,
    anterior_item: dict | None,
    agora_dt: datetime,
    abre_incidente_fn=abre_incidente,
    limiar_segundos: int = LIMIAR_INCIDENTE_SEGUNDOS,
) -> None:
    estado = item.get("estado")
    if estado == "fora":
        if anterior_item and anterior_item.get("estado") == "fora":
            fora_desde_str = anterior_item.get("fora_desde") or anterior_item.get("lido_em")
            incidente_id = anterior_item.get("incidente_id")
        else:
            fora_desde_str = item.get("lido_em") or agora_dt.isoformat(timespec="seconds")
            incidente_id = None

        item["fora_desde"] = fora_desde_str
        if incidente_id:
            item["incidente_id"] = incidente_id

        try:
            inicio = parse_dt(fora_desde_str)
            segundos_fora = (agora_dt - inicio).total_seconds()
        except Exception:
            segundos_fora = 0

        if segundos_fora >= limiar_segundos and not item.get("incidente_id"):
            novo_id = abre_incidente_fn(nome, item)
            if novo_id:
                item["incidente_id"] = novo_id
    else:
        item.pop("fora_desde", None)
        item.pop("incidente_id", None)


def reconcilia_com_anterior(
    dados: dict,
    anterior: dict | None,
    agora_dt: datetime | None = None,
    abre_incidente_fn=abre_incidente,
    limiar_segundos: int = LIMIAR_INCIDENTE_SEGUNDOS,
) -> dict:
    if agora_dt is None:
        agora_dt = datetime.now(timezone.utc)
    anterior_servicos = (anterior or {}).get("servicos", {})
    anterior_runtime = (anterior or {}).get("runtime")

    for nome, item in dados.get("servicos", {}).items():
        ant_item = anterior_servicos.get(nome)
        processa_estado_item(
            nome, item, ant_item, agora_dt,
            abre_incidente_fn=abre_incidente_fn,
            limiar_segundos=limiar_segundos,
        )

    if "runtime" in dados:
        processa_estado_item(
            "runtime", dados["runtime"], anterior_runtime, agora_dt,
            abre_incidente_fn=abre_incidente_fn,
            limiar_segundos=limiar_segundos,
        )

    return dados


def coleta():
    servicos = {}
    for nome, contendor in POR_HEALTHCHECK.items():
        e = do_healthcheck(nome, contendor)
        e["lido_em"] = agora()
        servicos[nome] = e
    for nome, posto, url, exige, proibido in POR_SONDA_EXTERNA:
        e = do_sonda_externa(nome, posto, url, exige, proibido)
        e["lido_em"] = agora()
        servicos[nome] = e
    for nome, motivo in SEM_SONDA.items():
        servicos[nome] = {"estado": "sem-sinal", "exercitado": None,
                          "motivo": motivo, "lido_em": agora()}
    for nome, unit in POR_SYSTEMD_RESULT.items():
        e = do_systemd_result(nome, unit)
        e["lido_em"] = agora()
        servicos[nome] = e
    runtime = do_runtime()
    runtime["lido_em"] = agora()
    return {"gerado_em": agora(), "runtime": runtime, "servicos": servicos}


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--ajuda", "ajuda"):
        print(__doc__.strip())
        print("\nuso: sinal [--ver]")
        print("  sem argumento : coleta e escreve " + SAIDA)
        print("  --ver         : mostra o arquivo atual, sem coletar")
        return 0
    if argv and argv[0] == "--ver":
        if not os.path.exists(SAIDA):
            print(json.dumps({"estado": "ausente",
                              "motivo": f"{SAIDA} nao existe: nenhuma coleta ate agora"},
                             ensure_ascii=False, indent=2))
            return 1
        with open(SAIDA, "r", encoding="utf-8") as f:
            print(f.read())
        return 0

    anterior = None
    if os.path.exists(SAIDA):
        try:
            with open(SAIDA, "r", encoding="utf-8") as f:
                anterior = json.load(f)
        except Exception as e:
            sys.stderr.write(f"sinal: aviso lendo anterior ({SAIDA}): {e}\n")

    dados = coleta()
    reconcilia_com_anterior(dados, anterior)

    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
    tmp = SAIDA + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:                   # escrita atomica: quem le nunca ve meia coleta
        json.dump(dados, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, SAIDA)

    fora = [n for n, e in dados["servicos"].items() if e["estado"] == "fora"]
    if dados["runtime"]["estado"] == "fora":
        fora.append("RUNTIME")
    for nome, e in sorted(dados["servicos"].items()):
        extra = []
        if e.get("motivo"):
            extra.append(e["motivo"])
        if e.get("fora_desde"):
            extra.append(f"fora desde {e['fora_desde']}")
        if e.get("incidente_id"):
            extra.append(f"incidente #{e['incidente_id']}")
        sufixo = f"  — {'; '.join(extra)}" if extra else ""
        print(f"{e['estado']:10} {nome}{sufixo}")
    r = dados["runtime"]
    extra_r = []
    if r.get("motivo"):
        extra_r.append(r["motivo"])
    if r.get("fora_desde"):
        extra_r.append(f"fora desde {r['fora_desde']}")
    if r.get("incidente_id"):
        extra_r.append(f"incidente #{r['incidente_id']}")
    sufixo_r = f"  — {'; '.join(extra_r)}" if extra_r else ""
    print(f"{r['estado']:10} (runtime){sufixo_r}")
    return 1 if fora else 0


if __name__ == "__main__":
    sys.exit(main())
