#!/usr/bin/env bash
# monta-sessao <cadeira> — imprime numa volta o contexto de abertura da cadeira:
# capacidade: expediente
# dono: claudinho-IA
# persona, manifesto declarado por ela + o GERAL, org canônico e a fila dela.
#
# As duas variáveis saem do texto da persona, não do nome do arquivo:
#   linha 1        "Você é <nome>,"        -> nome canônico, que é o diretório da fila
#   linha FERRAMENTAL:                     -> caminho do manifesto
# Convenção de nome de arquivo não produz o "claudinha" de persona-fabrica.md.
set -euo pipefail

RAIZ="${PF_RAIZ:-$HOME/AI}"
cd "$RAIZ"

C="${1:-}"
if [ -z "$C" ]; then
  echo "uso: monta-sessao <cadeira>" >&2
  echo "cadeiras:" >&2
  ls -1 platafirma-harness/personas/persona-*.md | sed 's#.*/persona-##; s/\.md$//' >&2
  exit 2
fi

P="platafirma-harness/personas/persona-$C.md"
if [ ! -f "$P" ]; then
  echo "não existe $P" >&2
  ls -1 platafirma-harness/personas/persona-*.md | sed 's#.*/persona-##; s/\.md$//' >&2
  exit 1
fi

for r in platafirma-harness platafirma-arquitetura; do
  git -C "$r" pull --ff-only -q 2>/dev/null || echo "(aviso: $r não atualizou — conteúdo abaixo é o do clone)" >&2
done

N=$(sed -n '1s/^Você é \([A-Za-z-]*\).*/\1/p' "$P")
M=$(sed -n 's/^FERRAMENTAL: *\([^ ]*\.md\).*/\1/p' "$P" | head -1)

# O manifesto da cadeira APONTA para o geral em vez de repetir o operacional comum
# (fila, tarefas, infra, git, venv). Servir só o declarado abre cadeira sem essa
# metade — e a tool `monta_sessao` já entrega os dois. Mesmo default, mesma env.
G="${PF_MANIFESTO_GERAL:-platafirma-harness/tool-manifest/GERAL.md}"
[ "$G" = "$M" ] && G=""

echo "== cadeira: ${N:-<nome não resolvido na linha 1 de $P>} =="

for f in "$P" ${M:-} ${G:-} platafirma-arquitetura/docs/org-template-canonico.md; do
  if [ -f "$f" ]; then
    echo "===== $f ====="
    cat "$f"
  else
    echo "===== $f ===== (AUSENTE)"
  fi
done

if [ -z "$M" ]; then
  echo "(aviso: $P não declara linha FERRAMENTAL: — manifesto não entrou)"
fi

# Memória da cadeira, pelo verbo `mesa` — mesma razão de delegar da fila. A mesa
# entra inteira (é o resíduo da fita anterior, curto por construção); do caderno
# entra só o ÍNDICE, e o corpo sai por `mesa caderno <chapéu>` na fita que o quiser.
if [ -n "$C" ]; then
  echo "===== mesa: $C ====="
  PF_CADEIRA="$C" mesa ver 2>&1 || echo "(mesa indisponível — msg-mem fora do ar)"
  echo "===== cadernos: $C ====="
  PF_CADEIRA="$C" mesa caderno 2>&1 || true
fi

# Fila lida sempre pelo comando `fila`, nunca pelo sistema de arquivos: reimplementar
# aqui o parser do formato de caixa criaria segunda fonte da mesma regra, e a
# divergência entre as duas apareceria como mensagem sumida.
if [ -z "$N" ]; then
  echo "===== fila ===== (nome não resolvido — sem persona não há como saber a caixa)"
elif out=$(PF_CADEIRA="$C" fila status "$N" 2>&1); then
  echo "===== fila: $N ====="
  echo "$out"
else
  echo "===== fila: $N (FECHADA — porteiro) ====="
  echo "$out"
fi
