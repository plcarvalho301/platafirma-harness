# Clones que a abertura pode tocar. arq:0058 (E1) manda a abertura ler UM repositorio:
# `platafirma-arquitetura` so aparece aqui se alguma peca ainda apontar para ele, e
# quando nao aparecer mais o pull dele sai sozinho — nao ha lista a manter.
ORDEM_VOLATILIDADE = {"estavel": 0, "morna": 1, "volatil": 2}

def env_verbo(persona_ou_cadeira):
    """Env da peca-verbo: PF_CADEIRA canonico + PATH explicito.

    O PATH herdado NAO serve: quando o montador e chamado por um servico (ops-mcp,
    systemd --user), o ambiente do processo pai nao tem RAIZ/bin, e toda peca servida
    por execucao morre com FileNotFoundError — mesa, cadernos e fila sairam vazias em
    17/08 na superficie claude.ai, com a ausencia declarada e o pacote entregue mutilado.
    Montar aqui, e nao no chamador, e o que faz o pacote ser o mesmo nas tres superficies.
    """
    casa = os.path.expanduser("~")
    e = dict(os.environ)
    e["PF_CADEIRA"] = persona_ou_cadeira
    e["PATH"] = f"{RAIZ}/bin:{casa}/.local/bin:" + os.environ.get("PATH", "")
    return e


RE_NOME = re.compile(r"^Você é ([A-Za-zÀ-ÿ-]+)")
RE_FERRAMENTAL = re.compile(r"^FERRAMENTAL: *([^ ]*\.md)")


PREFIXOS_CADEIRA = ("claudinho-", "claudinha-")


def _sufixo_sem_prefixo(cadeira):
    """Sufixo em minusculas sem o prefixo claudinho-/claudinha-: a mesma forma que
    nomeia o diretorio em abertura/ (arq:0073 §1). UNICA implementacao do strip
    neste arquivo — `_canonico`, `cadeiras_validas` e `main` chamam esta em vez de
    repetir o loop (card #2438, comentario #380 do #2431: as duas normalizacoes nao
    podem divergir)."""
    cad = (cadeira or "").strip()
    for pref in PREFIXOS_CADEIRA:
        if cad.lower().startswith(pref):
            return cad[len(pref):].lower()
    return cad.lower()


# ------------------------------------------------------------------ catalogo
# Peças-verbo/ponteiro: não têm .md na árvore. Ficam aqui, no montador — é ele que
# declara o que sempre serve, não um índice externo. A árvore abertura/ é a fonte das
# peças-arquivo; esta lista é a das de verbo. Gatilho (camada abertura×chapéu) e volatilidade (ordem
# de injeção) saem da posição na árvore
# virou o que ramifica: gatilho (camada abertura×chapéu) e volatilidade (ordem de injeção).
PECAS_VERBO = [
    {"id": "arranque",        "artefato": "platafirma-harness@abertura/arranque.md",
     "gatilho": {"evento": "ato"},      "regime": "ponteiro", "volatilidade": "estavel", "dono": "claudinho-IA"},
    {"id": "mesa",            "artefato": "verbo:mesa ver",
     "gatilho": {"evento": "abertura"}, "regime": "valor",    "volatilidade": "volatil", "dono": "claudinho-dados"},
    {"id": "cadernos-indice", "artefato": "verbo:mesa caderno",
     "gatilho": {"evento": "abertura"}, "regime": "indice",   "volatilidade": "volatil", "dono": "claudinho-dados"},
    {"id": "caderno-chapeu",  "artefato": "verbo:mesa caderno {chapeu}",
     "gatilho": {"evento": "chapeu"},   "regime": "valor",    "volatilidade": "volatil", "dono": "claudinho-dados"},
    {"id": "fila-envelope",   "artefato": "verbo:fila ler",
     "gatilho": {"evento": "ato"},      "regime": "indice",   "volatilidade": "volatil", "dono": "claudinho-IA"},
    {"id": "minutas",         "artefato": "verbo:minuta ler",
     "gatilho": {"evento": "ato"},      "regime": "indice",   "volatilidade": "volatil", "dono": "claudinha-gestao-estrategica"},
    {"id": "tarefas-abertas", "artefato": "verbo:tarefas listar",
     "gatilho": {"evento": "ato"},      "regime": "indice",   "volatilidade": "volatil", "dono": "claudinho-TI"},
    {"id": "catalogo-de-verbos",  "artefato": "platafirma-harness@docs/catalogo-de-verbos.md",
     "gatilho": {"evento": "ato"},      "regime": "ponteiro", "volatilidade": "morna",   "dono": "claudinho-TI"},
]


def _mapa_alias_cadeiras():
    """'Nome Humano -> slug' por PROVIMENTO com alias no ledger de vinculo — so
    endereco, sem 'head de', gerencia ou fronteira (decisao do dono, card #2438,
    comentario #379: servir o organograma inteiro faz as instancias levantarem muro).
    Zero arquivo novo: deriva do MESMO ledger que `_canonico` ja le. PROVIMENTO sem
    alias (hoje so 'engenharia') sai OMITIDO com nota declarada — nao trava o
    conserto. Cadeira ausente do ledger (hoje a fabrica, que nao tem nome) nao
    aparece nem no mapa nem na nota: fabrica-como-destino-de-roteamento e materia da
    persona dela, nao desta peca."""
    por_slug, sem_alias = {}, set()
    try:
        with open(LEDGER, encoding="utf-8", errors="replace") as fh:
            for linha in fh:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    ev = json.loads(linha)
                except ValueError:
                    continue
                if ev.get("tipo") != "PROVIMENTO":
                    continue
                cad = (ev.get("cadeira") or "").strip()
                if not cad:
                    continue
                slug = _sufixo_sem_prefixo(cad)
                alias = (ev.get("alias") or "").strip()
                if alias:
                    por_slug[slug] = alias
                    sem_alias.discard(slug)
                elif slug not in por_slug:
                    sem_alias.add(slug)
    except OSError as e:
        return None, f"{type(e).__name__}: {e}"
    if not por_slug:
        return None, "ledger sem nenhum PROVIMENTO com alias"
    linhas = [f"{alias} -> {slug}"
              for slug, alias in sorted(por_slug.items(), key=lambda kv: kv[1])]
    texto = "\n".join(linhas) + "\n"
    motivo = None
    if sem_alias:
        faltantes = ", ".join(sorted(sem_alias))
        texto += f"\n(sem alias no ledger, omitido: {faltantes})\n"
        motivo = f"omitido por falta de alias no ledger: {faltantes}"
    return texto, motivo


PECAS_CALCULADAS_FN = {"alias-cadeiras": _mapa_alias_cadeiras}
PECAS_CALCULADAS = [
    {"id": "alias-cadeiras",  "artefato": "calc:alias-cadeiras",
     "gatilho": {"evento": "abertura"}, "regime": "valor", "volatilidade": "morna",
     "dono": "claudinha-gestao-estrategica"},
]

# id da peça-arquivo -> gatilho/regime/volatilidade, por posição na árvore abertura/.
# raiz de abertura/ e nível de cadeira = camada abertura; nível de chapéu = camada chapéu.
_ARQ_META = {
    "dono.md":            ("conduta-dono",   "abertura", "valor", "estavel"),
    "oficio.md":          ("oficio",         "abertura", "valor", "estavel"),
    "persona.md":         ("persona",        "abertura", "valor", "estavel"),
    "caderno.md":         ("caderno-head",   "abertura", "valor", "volatil"),
    "chapeu.md":          ("chapeu",         "chapeu",   "valor", "estavel"),
    "ferramental.md":     ("ferramental",    "chapeu",   "valor", "estavel"),
}


def catalogo():
    """Fonte do catálogo: árvore abertura/ para peça-arquivo + PECAS_VERBO para o resto.
    Cada peça-arquivo é UMA no catálogo mesmo aparecendo em vários .md reais (persona de
    cada cadeira etc.): dedup por id, o path volta a template ({cadeira}/{chapeu}) por
    posição."""
    vistos, saida = {}, []
    for caminho in sorted(glob.glob(os.path.join(ABERTURA, "**", "*.md"), recursive=True)):
        nome = os.path.basename(caminho)
        meta = _ARQ_META.get(nome)
        if not meta:
            continue
        pid, evento, regime, volat = meta
        if pid in vistos:
            continue
        vistos[pid] = True
        rel = os.path.relpath(caminho, ABERTURA).replace(os.sep, "/")
        if evento == "chapeu":
            art = f"platafirma-harness@abertura/{{cadeira}}/{{chapeu}}/{nome}"
        elif rel.count("/") >= 1:
            art = f"platafirma-harness@abertura/{{cadeira}}/{nome}"
        else:
            art = f"platafirma-harness@abertura/{nome}"
        saida.append({"id": pid, "dono": None, "artefato": art, "regime": regime,
                      "gatilho": {"evento": evento}, "volatilidade": volat})
    return saida + PECAS_VERBO + PECAS_CALCULADAS


def de_abertura(pecas, cadeira):
    """As pecas com gatilho de abertura, na ordem de injecao.

    alias-cadeiras (#2438) e peca normal de gatilho abertura: entra para TODA cadeira
    pelo filtro abaixo, sem excecao nominal — o `por_id.get("alias-cadeiras")` que so
    injetava fora do quadro ficou morto quando o #189 partiu o catalogo (a peca nunca
    existia nele) e saiu daqui.

    A abertura carrega o que tem NECESSIDADE DE FRONTLOADING — o que precisa estar na
    janela antes da primeira fala do dono, e por isso interrompe o seguimento da
    montagem. Tres categorias (ordem do dono, 25/08): incidente; continuacao declarada
    de fita anterior; alerta (broadcast deveria ser alerta; nao usado hoje). NAO e
    "impedimento" — essa formulacao era erro, removida. FILA E BOARD NAO ENTRAM — sao
    verbos on-demand, chamados por ordem do dono como qualquer outro (#189, 17/08).
    Peca com gatilho de abertura para caixa ou carteira e reincidencia: ja foi tirada
    uma vez e voltou como contagem, que devolve a fila ao lugar da mesa pela saliencia.
    """
    escolhidas = [p for p in pecas if (p.get("gatilho") or {}).get("evento") == "abertura"]
    return sorted(escolhidas, key=lambda p: (ORDEM_VOLATILIDADE.get(p.get("volatilidade"), 9),
                                             p.get("id", "")))


def de_chapeu(pecas):
    """Pecas da camada de chapeu (gatilho evento=chapeu), na ordem de injecao.
    Aditivas a abertura quando ha chapeu roteado; nao substituem a abertura."""
    esc = [p for p in pecas if (p.get("gatilho") or {}).get("evento") == "chapeu"]
    return sorted(esc, key=lambda p: (ORDEM_VOLATILIDADE.get(p.get("volatilidade"), 9),
                                      p.get("id", "")))


# ------------------------------------------------------------------ repos
def sha_e_frescor(repo):
    """SHA curto do clone e como ele esta contra o remoto — sem ida a rede.

    Clone atrasado e clone no head sao indistinguiveis sem isto, e pacote montado de
    clone atrasado serve texto velho sem sinal (arq:0058).
    """
    d = os.path.join(RAIZ, repo)
    if not os.path.isdir(os.path.join(d, ".git")):
        return None, "indisponivel", f"{repo} nao e clone git"
    def git(*a):
        p = subprocess.run(["git", "-C", d, *a], capture_output=True, text=True, timeout=10)
        return p.stdout.strip() if p.returncode == 0 else None
    sha = git("rev-parse", "--short", "HEAD")
    atras = git("rev-list", "--count", "HEAD..@{upstream}")
    adiante = git("rev-list", "--count", "@{upstream}..HEAD")
    # Falso-verde fechado: sem upstream NAO e fresco — e nao-verificavel. `fresco`
    # exige prova de paridade com o remoto; sem upstream nao ha contra o que provar.
    if atras is None:
        return sha, "indeterminado", "sem upstream conhecido"
    # Divergencia (commit local ausente no remoto) e classe propria: nao e "atras" e
    # nao se cura com ff. reset --hard curaria destruindo trabalho — nunca em silencio.
    if adiante and adiante != "0":
        return sha, "divergente", f"{adiante} commit(s) local(is) ausente(s) no remoto"
    # `fresco` aqui = HEAD == @{upstream} CACHEADO. So e honesto se houve fetch nesta
    # corrida; o gate de valor (monta) faz esse fetch antes de confiar neste verde.
    return sha, ("fresco" if atras == "0" else "defasado"), (
        None if atras == "0" else f"{atras} commit(s) atras do remoto")


def pull(repos):
    estado = {}
    for r in sorted(repos):
        d = os.path.join(RAIZ, r)
        if not os.path.isdir(os.path.join(d, ".git")):
            estado[r] = {"atualizado": False, "erro": "nao e clone git"}
            continue
        try:
            p = subprocess.run(["git", "-C", d, "pull", "--ff-only", "-q"],
                               capture_output=True, text=True, timeout=25)
            estado[r] = ({"atualizado": True} if p.returncode == 0 else
                         {"atualizado": False, "erro": p.stderr.strip()[:200]})
        except (OSError, subprocess.SubprocessError) as e:
            estado[r] = {"atualizado": False, "erro": f"{type(e).__name__}: {e}"}
    return estado


def _fetch(repo):
    """Atualiza o remote-tracking do clone SEM integrar. E o que torna o `fresco` do
    frescor honesto: `sha_e_frescor` compara com `@{upstream}` cacheado, e sem este
    fetch o cache pode estar atras do origin real — o falso-verde que servia conduta
    velha marcada `fresco`. Falha de rede volta declarada, nunca como sucesso."""
    d = os.path.join(RAIZ, repo)
    try:
        p = subprocess.run(["git", "-C", d, "fetch", "-q"], capture_output=True,
                           text=True, timeout=25)
    except (OSError, subprocess.SubprocessError) as e:
        return False, f"{type(e).__name__}: {e}"
    return (p.returncode == 0, (p.stderr or "").strip()[:160] or None)


def reconciliar(repo):
    """Uma tentativa de trazer o clone ao head do remoto SEM destruir historico local:
    fetch + merge --ff-only. Diverge (ff impossivel) ou offline -> NAO reconcilia e
    devolve o motivo. Nunca `reset --hard`: o clone e compartilhado e pode ter trabalho
    nao empurrado — apagar isso em silencio troca um defeito por outro pior (mesa #3)."""
    ok, motivo = _fetch(repo)
    if not ok:
        return False, f"fetch falhou: {motivo}"
    d = os.path.join(RAIZ, repo)
    m = subprocess.run(["git", "-C", d, "merge", "--ff-only", "-q", "@{upstream}"],
                       capture_output=True, text=True, timeout=25)
    if m.returncode != 0:
        return False, f"ff impossivel (divergencia): {(m.stderr or '').strip()[:160]}"
    return True, None


# ------------------------------------------------------------------ servir peca
TOKENIZADOR = os.path.join(RAIZ, "opt", "tokenizers", "qwen2.5.json")
_MEDIDOR = {"fn": None, "metodo": None}


def medidor():
    """Mesmo tokenizador de `conferir sessao` (qwen2.5), para que o registrado aqui e o
    medido la sejam o mesmo numero. Sem ele, estimativa por bytes/4 — que erra por ~40%
    (medido, caderno ia/contexto) e por isso vai DECLARADA no pacote, nunca calada."""
    if _MEDIDOR["fn"]:
        return _MEDIDOR["fn"], _MEDIDOR["metodo"]
    try:
        from tokenizers import Tokenizer
        if os.path.isfile(TOKENIZADOR):
            tk = Tokenizer.from_file(TOKENIZADOR)
            _MEDIDOR.update(fn=lambda s: len(tk.encode(s).ids), metodo="tokenizador qwen2.5")
            return _MEDIDOR["fn"], _MEDIDOR["metodo"]
        motivo = f"tokenizador ausente: {TOKENIZADOR}"
    except ImportError:
        motivo = "modulo `tokenizers` ausente"
    _MEDIDOR.update(fn=lambda s: max(1, len(s.encode("utf-8")) // 4),
                    metodo=f"ESTIMATIVA por bytes/4 ({motivo})")
    return _MEDIDOR["fn"], _MEDIDOR["metodo"]


def conta_tokens(texto):
    fn, _ = medidor()
    return fn(texto)


def sha_conteudo(texto):
    """Hash do que foi SERVIDO, nao do commit: e o que `conferir sessao` compara, e o
    que identifica peca servida por verbo, que nao tem blob nenhum."""
    import hashlib
    return hashlib.sha256(texto.encode("utf-8")).hexdigest()[:12]


def serve(peca, cadeira, persona=None, chapeu=None):
    """Devolve (envelope, conteudo). Conteudo None quando indisponivel."""
    art = peca.get("artefato", "")
    env = {"peca": peca.get("id"), "dono": peca.get("dono"), "ref": art,
           "regime": peca.get("regime"), "volatilidade": peca.get("volatilidade"),
           "sha": None,
           "tokens": 0, "frescor": "indisponivel", "motivo": None}
    if peca.get("_forcada"):
        env["motivo"] = peca["_forcada"]
    if peca.get("_inaplicavel"):
        env["frescor"] = "nao_se_aplica"
        env["motivo"] = peca["_inaplicavel"]
        return env, None

    if art.startswith("verbo:"):
        cmd = (art[len("verbo:"):].strip().replace("{cadeira}", cadeira)
               .replace("{chapeu}", chapeu or ""))
        try:
            # PF_CADEIRA da peca-verbo e o NOME CANONICO, nao o sufixo: e ele que
            # nomeia a caixa da fila e a chave da mesa. Foi a divergencia entre os dois
            # que partiu a mesa em duas metades (medido em 16/08).
            p = subprocess.run(cmd.split(), capture_output=True, text=True, timeout=20,
                               env=env_verbo(persona or cadeira))
            texto = (p.stdout or "").strip()
            if p.returncode != 0:
                env["motivo"] = (p.stderr or p.stdout).strip()[:200] or f"exit {p.returncode}"
                return env, None
            env["frescor"] = "fresco"
            env["tokens"] = conta_tokens(texto)
            env["sha"] = sha_conteudo(texto)
            return env, texto
        except (OSError, subprocess.SubprocessError) as e:
            env["motivo"] = f"{type(e).__name__}: {e}"
            return env, None

    if art.startswith("calc:"):
        calc_id = art[len("calc:"):].strip()
        fn = PECAS_CALCULADAS_FN.get(calc_id)
        if not fn:
            env["motivo"] = f"calculo desconhecido: {calc_id!r}"
            return env, None
        try:
            texto, motivo = fn()
        except OSError as e:
            env["motivo"] = f"{type(e).__name__}: {e}"
            return env, None
        if texto is None:
            env["motivo"] = motivo or "sem dado para calcular"
            return env, None
        env["frescor"] = "fresco"
        env["tokens"] = conta_tokens(texto)
        env["sha"] = sha_conteudo(texto)
        if motivo:
            env["motivo"] = motivo
        return env, texto

    if "@" not in art:
        env["motivo"] = f"artefato em forma desconhecida: {art!r}"
        return env, None

    repo, path = art.split("@", 1)
    path = path.replace("{cadeira}", cadeira).replace("{chapeu}", chapeu or "")
    env["ref"] = f"{repo}@{path}"
    _, frescor, motivo = sha_e_frescor(repo)
    env["motivo"] = motivo or env["motivo"]
    caminho = os.path.join(RAIZ, repo, path)
    if not os.path.isfile(caminho):
        env["frescor"] = "indisponivel"
        env["motivo"] = f"nao existe {caminho}"
        return env, None
    with open(caminho, encoding="utf-8", errors="replace") as fh:
        texto = fh.read()
    env["frescor"] = frescor
    env["tokens"] = conta_tokens(texto)
    env["sha"] = sha_conteudo(texto)
    return env, texto


# ------------------------------------------------------------------ registro do pacote
def registra_pacote(cadeira, envelopes, montador_sha):
    """Uma linha por peca servida (§6.6). Sem isto, orcamento de janela e declaracao.
    Falha aqui NAO derruba a abertura: devolve o motivo, e o pacote sai mesmo assim."""
    fid = (os.environ.get("PF_FITA") or "").strip()
    if not fid:
        return {"registrado": False, "motivo": "sem PF_FITA — sessao de mao nao tem fita"}
    try:
        import psycopg
    except ImportError:
        return {"registrado": False, "motivo": "psycopg ausente neste venv"}
    senha = os.environ.get("SESSAO_PG_PASSWORD", "")
    if not senha and os.path.isfile(SESSAO_ENV):
        for linha in open(SESSAO_ENV, encoding="utf-8"):
            if linha.startswith("SESSAO_PG_PASSWORD="):
                senha = linha.split("=", 1)[1].strip()
                break
    porta = os.environ.get("SESSAO_PG_PORT", "5437")
    dsn = f"host=127.0.0.1 port={porta} dbname=sessao user=sessao password={senha}"
    sup = os.environ.get("PF_SUPERFICIE", "").strip() or "desconhecida"
    if sup not in ("claude.ai", "chat", "code", "desconhecida"):
        sup = "desconhecida"
    try:
        with psycopg.connect(dsn, connect_timeout=3) as con, con.cursor() as cur:
            cur.execute("INSERT INTO sessao.fita (id, persona, superficie) VALUES (%s,%s,%s) "
                        "ON CONFLICT (id) DO NOTHING", (fid, cadeira, sup))
            cur.execute("INSERT INTO sessao.pacote (fita_id, montador_sha, tokens) "
                        "VALUES (%s,%s,%s) ON CONFLICT (fita_id) DO UPDATE SET "
                        "montado_em = now(), montador_sha = EXCLUDED.montador_sha, "
                        "tokens = EXCLUDED.tokens",
                        (fid, montador_sha, sum(e["tokens"] for e in envelopes)))
            cur.executemany(
                "INSERT INTO sessao.peca_servida (fita_id, peca, ordem, ref, sha, regime, "
                "tokens, frescor) VALUES (%s,%s,%s,%s,%s,%s,%s,%s) "
                "ON CONFLICT (fita_id, peca) DO UPDATE SET ordem = EXCLUDED.ordem, "
                "ref = EXCLUDED.ref, sha = EXCLUDED.sha, tokens = EXCLUDED.tokens, "
                "frescor = EXCLUDED.frescor",
                [(fid, e["peca"], i, e["ref"], e["sha"], e["regime"], e["tokens"], e["frescor"])
                 for i, e in enumerate(envelopes)])
            con.commit()
        return {"registrado": True, "fita": fid}
    except Exception as e:  # noqa: BLE001 — banco mudo nao pode derrubar a abertura
        return {"registrado": False, "motivo": f"{type(e).__name__}"}


# ------------------------------------------------------------------ montagem
def _canonico(sufixo):
    """Nome canonico (claudinho-<x>/claudinha-<x>) a partir do sufixo, pelo ledger de
    vinculo (arq:0073 §1) — a persona do form novo poe o ALIAS na linha 1, nao o slug,
    entao a linha 1 nao serve mais de fonte. Nao casando, devolve None: nao inventa."""
    try:
        achado = None
        with open(LEDGER, encoding="utf-8", errors="replace") as fh:
            for linha in fh:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    cad = (json.loads(linha).get("cadeira") or "").strip()
                except ValueError:
                    continue
                if _sufixo_sem_prefixo(cad) == sufixo.lower():
                    achado = cad
        return achado
    except OSError:
        return None


def cadeiras_validas():
    """Sufixos do ledger de vinculo, uniao com subdirs ja escritos em abertura/. Cadeira
    valida mas ainda nao redigida abre com pecas indisponiveis, nao com erro (0073 §7.5)."""
    do_ledger = set()
    try:
        with open(LEDGER, encoding="utf-8", errors="replace") as fh:
            for linha in fh:
                try:
                    cad = (json.loads(linha).get("cadeira") or "").strip()
                except ValueError:
                    continue
                if cad:
                    do_ledger.add(_sufixo_sem_prefixo(cad))
    except OSError:
        pass
    try:
        do_disco = {d for d in os.listdir(ABERTURA)
                    if os.path.isdir(os.path.join(ABERTURA, d))}
    except OSError:
        do_disco = set()
    return sorted(do_ledger | do_disco)


def monta(cadeira, atualizar, pergunta=None, forcado_chapeu=None, so_chapeu=False):
    if cadeira.lower() not in [c.lower() for c in cadeiras_validas()]:
        return {"erro": f"cadeira desconhecida: '{cadeira}'",
                "cadeiras_validas": cadeiras_validas()}
    p_persona = os.path.join(ABERTURA, cadeira, "persona.md")

    pecas = de_abertura(catalogo(), cadeira)
    repos = sorted({p["artefato"].split("@", 1)[0] for p in pecas
                    if "@" in p.get("artefato", "")})
    estado_repos = pull(repos) if atualizar else {
        r: {"atualizado": False, "motivo": "sem pull nesta chamada"} for r in repos}
    for r in repos:
        sha, frescor, motivo = sha_e_frescor(r)
        estado_repos.setdefault(r, {}).update({"sha": sha, "frescor": frescor})

    # ---- GATE DE VALOR (arq:0058; ordem do dono 25/08) ----------------------
    # Peca de VALOR nao-volatil (conduta, persona, oficio, chapeu,
    # ferramental) NUNCA se serve defasada em silencio. Volatil (mesa, caderno)
    # pode degradar com aviso — por isso o filtro e por volatilidade, nao so por regime.
    # Para cada repo que respalda peca assim: (1) fetch, para `fresco` deixar de comparar
    # com cache velho; (2) nao ficando fresco, UMA tentativa de reconciliar por ff (nunca
    # reset --hard); (3) persistindo nao-fresco -> a sessao NAO abre: devolve `erro`, sem
    # servir o conteudo de valor. Sem prova de paridade, recusa alto.
    repos_valor = sorted({
        p["artefato"].split("@", 1)[0] for p in pecas
        if "@" in p.get("artefato", "")
        and p.get("regime") == "valor" and p.get("volatilidade") != "volatil"})
    bloqueio = []
    for r in repos_valor:
        _fetch(r)  # torna o `fresco` honesto antes de julgar
        sha, frescor, motivo = sha_e_frescor(r)
        if frescor != "fresco":
            ok, m2 = reconciliar(r)
            sha, frescor, motivo = sha_e_frescor(r)
            if not ok or frescor != "fresco":
                bloqueio.append({"repo": r, "frescor": frescor,
                                 "motivo": m2 or motivo or "nao verificavel"})
        estado_repos.setdefault(r, {}).update({"sha": sha, "frescor": frescor})
    if bloqueio:
        return {
            "erro": "sessao nao aberta: peca de valor nao pode ser servida fresca "
                    "(reconciliacao por ff falhou; reset --hard nao e automatico)",
            "cadeira": cadeira, "nome_canonico": _canonico(cadeira),
            "bloqueio": bloqueio, "repos": estado_repos,
            "avisos": [f"repo `{b['repo']}` {b['frescor']}: {b['motivo']}"
                       for b in bloqueio],
        }

    texto_persona = (open(p_persona, encoding="utf-8", errors="replace").read()
                     if os.path.isfile(p_persona) else "")
    # Canonico vem do ledger, nao da linha 1: o form novo poe o alias ali (arq:0073).
    nome = _canonico(cadeira)

    # A abertura-base serve SEMPRE, salvo pedido explícito de SÓ-chapéu (`so_chapeu`).
    # Pergunta e chapéu apenas ROTEIAM o chapéu, que é ADITIVO (servido abaixo, por cima
    # da abertura). O antigo `perna_dois` INFERIA "só-chapéu" de "tem pergunta ou chapéu"
    # — proxy errado: com #249 (a borda/fita passou a mandar SEMPRE o corpo do turno como
    # --pergunta), toda abertura virava só-chapéu e, no fallback do roteador, devolvia
    # `pecas: []` sem `erro` — a ambiguidade "peça vazia × cadeira sem peça" que o contrato
    # jura nunca produzir. A troca de chapéu mid-sessão (o defeito que a Carla reportou:
    # reenviar a abertura já servida é desperdício) é caso real — mas agora se pede por
    # FLAG explícita `--so-chapeu`, nunca por inferência. Default serve abertura: esquecer
    # a flag falha para o lado seguro (nunca abre vazio), honrando o contrato acima.
    servidas, avisos = [], []
    if not so_chapeu:
        for peca in pecas:
            env, conteudo = serve(peca, cadeira, nome)
            env["conteudo"] = conteudo
            servidas.append(env)
            if env["frescor"] == "indisponivel":
                avisos.append(f"peça `{env['peca']}` indisponível: {env['motivo']}")
            elif env["frescor"] == "defasado":
                avisos.append(f"peça `{env['peca']}` servida de clone atrasado: {env['motivo']}")

    # Divergencia entre o que a persona declara e o que o catalogo resolve nao se
    # escolhe em silencio: as duas fontes existem, e a que discorda vira aviso.
    if not nome:
        avisos.append(f"cadeira '{cadeira}' sem canônico no ledger — fila não localizada")

    # ---- P2 passo 2: responde "qual chapeu?" DENTRO da montagem (recursao) ----
    # (a) deterministico -> (b) semantico -> (c) fallback. So dobra o chapeu quando decide.
    dec = _rot.escolhe(pergunta, cadeira, CHAPEUS_DIR, forcado=forcado_chapeu)
    roteador = {"via": dec.via, "motivo": dec.motivo, "acertos": dec.acertos, "slug": dec.slug}
    chapeu_env = None
    if dec.slug:
        # Perna 2 (arq:0073): dobra o chapeu servindo TODAS as pecas com gatilho de chapeu
        # (chapeu.md, ferramental.md, caderno do chapeu) pelo catalogo, {chapeu}=slug.
        for pc in de_chapeu(catalogo()):
            envc, cont = serve(pc, cadeira, nome, chapeu=dec.slug)
            envc["conteudo"] = cont
            envc["peca"] = f"{pc.get('id')}:{dec.slug}"
            envc["slug"] = dec.slug
            servidas.append(envc)
            if chapeu_env is None:
                chapeu_env = envc
            if envc["frescor"] == "indisponivel":
                avisos.append(f"peça `{envc['peca']}` indisponível: {envc['motivo']}")
    else:
        avisos.append(f"chapeu nao roteado (fallback): {dec.motivo}")

    montador_sha = (estado_repos.get("platafirma-harness") or {}).get("sha")
    return {
        "cadeira": cadeira,
        "nome_canonico": nome,
        "repos": estado_repos,
        "pacote": {
            "pecas": len(servidas),
            "tokens": sum(e["tokens"] for e in servidas),
            "metodo_tokens": medidor()[1],
            "montador_sha": montador_sha,
            "montado_em": int(time.time()),
            "registro": registra_pacote(cadeira, servidas, montador_sha),
        },
        "pecas": servidas,
        "chapeu": (chapeu_env["slug"] if chapeu_env else None),
        "roteador": roteador,
        "avisos": avisos,
    }


def imprime_texto(pac):
    if "erro" in pac:
        print(f"{pac['erro']}" + (f" (procurado: {pac['procurado']})" if pac.get('procurado') else ""), file=sys.stderr)
        print("cadeiras: " + " ".join(pac["cadeiras_validas"]), file=sys.stderr)
        return 1
    print(f"== cadeira: {pac['nome_canonico'] or '<nome não resolvido>'} ==")
    for e in pac["pecas"]:
        cab = f"===== {e['peca']}: {e['ref']}"
        if e["sha"]:
            cab += f" @{e['sha']}"
        cab += f" ({e['frescor']}, {e['tokens']} tokens) ====="
        print(cab)
        if e["conteudo"] is None:
            print(f"(INDISPONÍVEL — {e['motivo']})")
        else:
            print(e["conteudo"].rstrip())
        print()
    for a in pac["avisos"]:
        print(f"(aviso: {a})")
    reg = pac["pacote"]["registro"]
    if not reg.get("registrado"):
        print(f"(pacote não registrado: {reg.get('motivo')})")
    return 0


CHAPEUS = ABERTURA


def chapeus_de(cadeira):
    """Slugs no disco, por descoberta. Nao ha lista fixa: chapeu escrito por outra
    cadeira aparece sem ninguem emendar codigo — e foi para isso que este verbo
    existe. Diretorio ausente e lista vazia, nao erro."""
    d = os.path.join(CHAPEUS, cadeira)
    if not os.path.isdir(d):
        return []
    return sorted(n for n in os.listdir(d)
                  if os.path.isfile(os.path.join(d, n, "chapeu.md")))


def serve_chapeu(cadeira, slug):
    """Envelope + conteudo de UM chapeu. Ausente vem declarado, nunca omitido:
    pacote sem a peca e pacote com peca vazia seriam indistinguiveis."""
    caminho = os.path.join(CHAPEUS, cadeira, slug, "chapeu.md")
    env = {"peca": f"chapeu:{slug}", "cadeira": cadeira, "slug": slug,
           "ref": f"platafirma-harness@abertura/{cadeira}/{slug}/chapeu.md",
           "regime": "valor", "carga": "sob demanda",
           "sha": None, "tokens": 0, "frescor": "indisponivel", "motivo": None}
    if not os.path.isfile(caminho):
        env["motivo"] = f"nao existe: {caminho}"
        env["chapeus_do_disco"] = chapeus_de(cadeira)
        return env, None
    texto = open(caminho, encoding="utf-8").read()
    env["frescor"] = "fresco"
    env["tokens"] = conta_tokens(texto)
    env["sha"] = sha_conteudo(texto)
    _, env["metodo_tokens"] = medidor()
    return env, texto


def imprime_chapeu(cadeira, args):
    if args.chapeus:
        slugs = chapeus_de(cadeira)
        if args.json:
            print(json.dumps({"cadeira": cadeira, "chapeus": slugs,
                              "carga": "monta-sessao <cadeira> --chapeu <slug>"},
                             ensure_ascii=False))
            return 0
        if not slugs:
            print(f"nenhum chapeu escrito para '{cadeira}' "
                  f"(procurado: {os.path.join(CHAPEUS, cadeira)})", file=sys.stderr)
            return 1
        for s in slugs:
            env, _ = serve_chapeu(cadeira, s)
            print(f"{s}\t{env['tokens']} tokens\t{env['sha']}"
                  + (f"\t{env['motivo']}" if env["motivo"] else ""))
        return 0

    env, texto = serve_chapeu(cadeira, args.chapeu)
    if args.json:
        print(json.dumps({"envelope": env, "conteudo": texto}, ensure_ascii=False))
        return 0 if texto else 1
    if not texto:
        print(f"chapeu indisponivel: {env['motivo']}", file=sys.stderr)
        if env.get("chapeus_do_disco"):
            print("chapeus desta cadeira: " + " ".join(env["chapeus_do_disco"]),
                  file=sys.stderr)
        return 1
    print(f"===== chapeu {cadeira}/{args.chapeu} @{env['sha']} "
          f"({env['tokens']} tokens) =====")
    print(texto)
    if env["motivo"]:
        print(f"\naviso: {env['motivo']}", file=sys.stderr)
    return 0


def main():
    p = argparse.ArgumentParser(prog="monta-sessao",
                                description="pacote de abertura da cadeira, montado por catálogo")
    p.add_argument("cadeira", nargs="?")
    p.add_argument("--json", action="store_true")
    p.add_argument("--sem-atualizar", action="store_true")
    # Chapeu NAO entra na abertura (spec_montagem-de-sessao §7): carrega sob demanda,
    # no giro em que a linha ativa. Estas duas flags sao essa demanda, e por isso saem
    # do mesmo verbo — a conta e um verbo por capacidade (arq:0037), e a capacidade
    # aqui continua sendo `expediente`.
    p.add_argument("--chapeus", action="store_true",
                   help="lista os chapeus da cadeira, por descoberta no disco")
    p.add_argument("--pergunta", metavar="TEXTO",
                   help="o turno do dono; roteia o chapeu por (a)/(b), senao cai no fallback (c)")
    p.add_argument("--so-chapeu", action="store_true",
                   help="troca de chapeu mid-sessao: serve SO o chapeu, sem a abertura "
                        "(a abertura ja veio na 1a chamada; reenvia-la e desperdicio). "
                        "Default: serve abertura + chapeu roteado.")
    p.add_argument("--chapeu", metavar="SLUG",
                   help="serve UM chapeu da cadeira (sob demanda, fora da abertura)")
    args = p.parse_args()

    if not args.cadeira:
        if args.json:
            print(json.dumps({"erro": "uso: monta-sessao <cadeira>",
                              "cadeiras_validas": cadeiras_validas()}, ensure_ascii=False))
            return 2
        print("uso: monta-sessao <cadeira>", file=sys.stderr)
        print("cadeiras: " + " ".join(cadeiras_validas()), file=sys.stderr)
        return 2

    # Prefixo aceito e descartado: `claudinho-TI` e `TI` sao a mesma cadeira, e o nome
    # do arquivo de persona e o sufixo. Mesma regra de `_sufixo_sem_prefixo` (unica
    # implementacao do strip no arquivo — card #2438, comentario #380 do #2431).
    alvo = _sufixo_sem_prefixo(args.cadeira.strip())

    if args.chapeus:
        return imprime_chapeu(alvo, args)

    pac = monta(alvo, atualizar=not args.sem_atualizar, pergunta=args.pergunta,
                forcado_chapeu=args.chapeu, so_chapeu=args.so_chapeu)
    if args.json:
        print(json.dumps(pac, ensure_ascii=False))
        return 1 if "erro" in pac else 0
    return imprime_texto(pac)


if __name__ == "__main__":
    sys.exit(main())
