    {"id": "caderno-chapeu",  "artefato": "verbo:mesa caderno {chapeu}",
     "gatilho": {"evento": "chapeu"},   "regime": "valor",    "volatilidade": "volatil", "dono": "dados"},
    {"id": "fila-envelope",   "artefato": "verbo:fila ler",
     "gatilho": {"evento": "ato"},      "regime": "indice",   "volatilidade": "volatil", "dono": "ia"},
    {"id": "minutas",         "artefato": "verbo:minuta ler",
     "gatilho": {"evento": "ato"},      "regime": "indice",   "volatilidade": "volatil", "dono": "gestao-estrategica"},
    {"id": "tarefas-abertas", "artefato": "verbo:tarefas listar",
     "gatilho": {"evento": "ato"},      "regime": "indice",   "volatilidade": "volatil", "dono": "ti"},
    {"id": "catalogo-de-fontes",  "artefato": "platafirma-harness@docs/catalogo-de-fontes.md",
     "gatilho": {"evento": "ato"},      "regime": "ponteiro", "volatilidade": "morna",   "dono": "ti"},
]


def _mapa_alias_cadeiras():
    """'Nome Humano -> slug' do dado vivo abertura/aliases.json — so endereco, sem
    'head de', gerencia ou fronteira (decisao do dono, card #2438, comentario #379:
    servir o organograma inteiro faz as instancias levantarem muro). O ledger de
    vinculo NAO se le (incidente/ordem do dono): o alias afetivo migrou para a arvore
    viva. Cadeira viva (abertura/<slug>/persona.md) sem alias no mapa sai OMITIDA com
    nota declarada — nao trava o conserto. Ator interno sem nome afetivo (fabrica)
    entra no mapa com valor null: e a fonte que diz "sem alias, de proposito", nao
    este codigo — aqui nao ha lista de cadeira nenhuma."""
    caminho = os.path.join(ABERTURA, "aliases.json")
    try:
        with open(caminho, encoding="utf-8") as fh:
            mapa = json.load(fh)
    except (OSError, ValueError) as e:
        return None, f"{type(e).__name__}: {e}"
    por_slug = {slug: alias for slug, alias in mapa.items() if slug and alias}
    # cadeiras vivas AUSENTES do mapa: declara a omissao. Chave com null e alias
    # negado de proposito (fabrica), nao omissao.
    sem_alias = set(cadeiras_validas()) - set(mapa)
    if not por_slug:
        return None, "aliases.json sem nenhum alias"
    linhas = [f"{alias} -> {slug}"
              for slug, alias in sorted(por_slug.items(), key=lambda kv: kv[1])]
    texto = "\n".join(linhas) + "\n"
    motivo = None
    if sem_alias:
        faltantes = ", ".join(sorted(sem_alias))
        texto += f"\n(sem alias, omitido: {faltantes})\n"
        motivo = f"omitido por falta de alias: {faltantes}"
    return texto, motivo


PECAS_CALCULADAS_FN = {"alias-cadeiras": _mapa_alias_cadeiras}
PECAS_CALCULADAS = [
    {"id": "alias-cadeiras",  "artefato": "calc:alias-cadeiras",
     "gatilho": {"evento": "abertura"}, "regime": "valor", "volatilidade": "morna",
     "dono": "gestao-estrategica"},
]

# id da peça-arquivo -> gatilho/regime/volatilidade, por posição na árvore abertura/.
# raiz de abertura/ e nível de cadeira = camada abertura; nível de chapéu = camada chapéu.
_ARQ_META = {
    "dono.md":            ("conduta-dono",   "abertura", "valor", "estavel"),
    "oficio.md":          ("oficio",         "abertura", "valor", "estavel"),
    "persona.md":         ("persona",        "abertura", "valor", "estavel"),
    "caderno.md":         ("caderno-head",   "abertura", "valor", "volatil"),
    "chapeu.md":          ("chapeu",         "chapeu",   "valor", "estavel"),
    "ferramental.md":     ("ferramental",    "chapeu",   "valor", "estavel"),
}


def catalogo():
    """Fonte do catálogo: árvore abertura/ para peça-arquivo + PECAS_VERBO para o resto.
    Cada peça-arquivo é UMA no catálogo mesmo aparecendo em vários .md reais (persona de
    cada cadeira etc.): dedup por id, o path volta a template ({cadeira}/{chapeu}) por
    posição."""
    vistos, saida = {}, []
    for caminho in sorted(glob.glob(os.path.join(ABERTURA, "**", "*.md"), recursive=True)):
        nome = os.path.basename(caminho)
        meta = _ARQ_META.get(nome)
        if not meta:
            continue
        pid, evento, regime, volat = meta
        if pid in vistos:
            continue
        vistos[pid] = True
        rel = os.path.relpath(caminho, ABERTURA).replace(os.sep, "/")
        if evento == "chapeu":
            art = f"platafirma-harness@abertura/{{cadeira}}/{{chapeu}}/{nome}"
        elif rel.count("/") >= 1:
            art = f"platafirma-harness@abertura/{{cadeira}}/{nome}"
        else:
            art = f"platafirma-harness@abertura/{nome}"
        saida.append({"id": pid, "dono": None, "artefato": art, "regime": regime,
                      "gatilho": {"evento": evento}, "volatilidade": volat})
    return saida + PECAS_VERBO + PECAS_CALCULADAS


def de_abertura(pecas, cadeira):
    """As pecas com gatilho de abertura, na ordem de injecao.

    alias-cadeiras (#2438) e peca normal de gatilho abertura: entra para TODA cadeira
    pelo filtro abaixo, sem excecao nominal — o `por_id.get("alias-cadeiras")` que so
    injetava fora do quadro ficou morto quando o #189 partiu o catalogo (a peca nunca
    existia nele) e saiu daqui.

    A abertura carrega o que tem NECESSIDADE DE FRONTLOADING — o que precisa estar na
    janela antes da primeira fala do dono, e por isso interrompe o seguimento da
    montagem. Tres categorias (ordem do dono, 25/08): incidente; continuacao declarada
    de fita anterior; alerta (broadcast deveria ser alerta; nao usado hoje). NAO e
    "impedimento" — essa formulacao era erro, removida. FILA E BOARD NAO ENTRAM — sao
    verbos on-demand, chamados por ordem do dono como qualquer outro (#189, 17/08).
    Peca com gatilho de abertura para caixa ou carteira e reincidencia: ja foi tirada
    uma vez e voltou como contagem, que devolve a fila ao lugar da mesa pela saliencia.
    """
    escolhidas = [p for p in pecas if (p.get("gatilho") or {}).get("evento") == "abertura"]
    return sorted(escolhidas, key=lambda p: (ORDEM_VOLATILIDADE.get(p.get("volatilidade"), 9),
                                             p.get("id", "")))


def de_chapeu(pecas):
    """Pecas da camada de chapeu (gatilho evento=chapeu), na ordem de injecao.
    Aditivas a abertura quando ha chapeu roteado; nao substituem a abertura."""
    esc = [p for p in pecas if (p.get("gatilho") or {}).get("evento") == "chapeu"]
    return sorted(esc, key=lambda p: (ORDEM_VOLATILIDADE.get(p.get("volatilidade"), 9),
                                      p.get("id", "")))


# ------------------------------------------------------------------ morada publicada
_MORADA = {}
# Acima disto, a morada no ar deixa de ser detalhe e vira aviso na abertura. Um dia
# e a folga que um dia util comporta; abaixo dela, avisar todo giro seria ruido.
IDADE_MORADA_AVISO_H = 24


def _idade_horas(publicado_em):
    """Horas desde a publicacao, do carimbo ISO-8601 UTC do MANIFEST. None se ilegivel:
    idade desconhecida se declara como desconhecida, nunca como zero."""
    if not publicado_em:
        return None
    try:
        quando = time.strptime(str(publicado_em).replace("Z", ""), "%Y-%m-%dT%H:%M:%S")
    except (ValueError, TypeError):
        return None
    return round(max(0.0, (time.time() - calendar.timegm(quando)) / 3600), 1)


def morada():
    """Estado da morada publicada, resolvido UMA vez por corrida: sem git e sem rede.

    A arvore sob `current/` e IMUTAVEL — saiu de um commit por `git archive` e o ponteiro
    so se move por ato deliberado. Logo nao ha "atras do remoto" a medir no caminho de
    servico: ou a morada esta publicada, e o servido e exatamente o ref que o MANIFEST
    nomeia, ou ela nao esta, e a sessao nao abre. O que morava aqui — `sha_e_frescor`,
    `pull`, `_fetch`, `reconciliar` e a classe `divergente` — saiu inteiro por arq:0097:
    eram tres idas a rede por abertura para provar uma paridade que a publicacao ja prova.

    Ausencia se declara, como qualquer peca: morada nao publicada volta com o motivo e a
    cura, nunca como arvore vazia — as duas seriam indistinguiveis.
    """
    if _MORADA:
        return _MORADA
    dados, motivo = {}, None
    try:
        with open(MANIFESTO, encoding="utf-8") as fh:
            dados = json.load(fh)
    except FileNotFoundError:
        motivo = f"morada nao publicada: nao existe {MANIFESTO}"
    except (OSError, ValueError) as e:
        motivo = f"MANIFEST ilegivel: {type(e).__name__}: {e}"
    tem_arvore = os.path.isdir(ABERTURA)
    if dados and not tem_arvore:
        motivo = f"MANIFEST presente mas arvore ausente: {ABERTURA}"
    # A morada nao envelhece sozinha: `publicar-abertura` e ato deliberado, e entre
    # dois atos ela serve texto de ontem sem nada dizer — o "clone atrasado" do
    # arq:0058 de volta com outro nome (medido em 04/09: 27 commits atras, calada).
    # Medir "atras do remoto" exigiria git, que este caminho nao pode chamar; o que da
    # para afirmar sem rede e a IDADE do que esta no ar, e e o que sai declarado.
    idade_h = _idade_horas(dados.get("publicado_em"))
    _MORADA.update({
        "raiz": MORADA,
        "abertura": ABERTURA,
        "sha": dados.get("sha_curto"),
        "ref": dados.get("ref"),
        "tree_sha": dados.get("tree_sha"),
        "publicado_em": dados.get("publicado_em"),
        "publicado_por": dados.get("publicado_por"),
        "frescor": "publicado" if (dados and tem_arvore) else "indisponivel",
        "idade_h": idade_h,
        "motivo": motivo,
        # A abertura nao se atualiza no caminho de servico (arq:0097). Dito no pacote
        # para que a flag `--sem-atualizar` / `atualizar=` nao passe por promessa muda.
        "atualiza_por": "publicar-abertura",
    })
    return _MORADA


def caminho_publicado(path):
    """Resolve `abertura/...` do artefato para o arquivo dentro da morada.

    Fora de `abertura/` nao ha morada onde ler: devolve None, e quem chamou declara a
    indisponibilidade. Nao ha fallback para o clone — fallback silencioso para working
    tree e exatamente o que o arq:0097 fecha.
    """
    if not path.startswith("abertura/"):
        return None
    return os.path.join(ABERTURA, path[len("abertura/"):])


# ------------------------------------------------------------------ servir peca
TOKENIZADOR = os.path.join(RAIZ, "opt", "tokenizers", "qwen2.5.json")
_MEDIDOR = {"fn": None, "metodo": None}


def medidor():
    """Mesmo tokenizador de `conferir sessao` (qwen2.5), para que o registrado aqui e o
    medido la sejam o mesmo numero. Sem ele, estimativa por bytes/4 — que erra por ~40%
    (medido, caderno ia/contexto) e por isso vai DECLARADA no pacote, nunca calada."""
    if _MEDIDOR["fn"]:
        return _MEDIDOR["fn"], _MEDIDOR["metodo"]
    try:
        from tokenizers import Tokenizer
        if os.path.isfile(TOKENIZADOR):
            tk = Tokenizer.from_file(TOKENIZADOR)
            _MEDIDOR.update(fn=lambda s: len(tk.encode(s).ids), metodo="tokenizador qwen2.5")
            return _MEDIDOR["fn"], _MEDIDOR["metodo"]
        motivo = f"tokenizador ausente: {TOKENIZADOR}"
    except ImportError:
        motivo = "modulo `tokenizers` ausente"
    _MEDIDOR.update(fn=lambda s: max(1, len(s.encode("utf-8")) // 4),
                    metodo=f"ESTIMATIVA por bytes/4 ({motivo})")
    return _MEDIDOR["fn"], _MEDIDOR["metodo"]


def conta_tokens(texto):
    fn, _ = medidor()
    return fn(texto)


def sha_conteudo(texto):
    """Hash do que foi SERVIDO, nao do commit: e o que `conferir sessao` compara, e o
    que identifica peca servida por verbo, que nao tem blob nenhum.

    A CONTA vive em `comum/hash_servido.py` desde o arq:0101 R7, e nao mais aqui: a
    porta compara o sha da peca servida na abertura com o da peca reservida por verbo
    (dedup R2), e duas implementacoes do mesmo hash — uma com `.strip()`, outra sem —
    nunca casariam. Uma lib, dois consumidores."""
    return sha_servido(texto)


def serve(peca, cadeira, persona=None, chapeu=None):
    """Devolve (envelope, conteudo). Conteudo None quando indisponivel."""
    art = peca.get("artefato", "")
    env = {"peca": peca.get("id"), "dono": peca.get("dono"), "ref": art,
           "regime": peca.get("regime"), "volatilidade": peca.get("volatilidade"),
           "sha": None,
           "tokens": 0, "frescor": "indisponivel", "motivo": None}
    if peca.get("_forcada"):
        env["motivo"] = peca["_forcada"]
    if peca.get("_inaplicavel"):
        env["frescor"] = "nao_se_aplica"
        env["motivo"] = peca["_inaplicavel"]
        return env, None

    if art.startswith("verbo:"):
        cmd = (art[len("verbo:"):].strip().replace("{cadeira}", cadeira)
               .replace("{chapeu}", chapeu or ""))
        try:
            # PF_CADEIRA da peca-verbo e o NOME CANONICO, nao o sufixo: e ele que
            # nomeia a caixa da fila e a chave da mesa. Foi a divergencia entre os dois
            # que partiu a mesa em duas metades (medido em 16/08).
            p = subprocess.run(cmd.split(), capture_output=True, text=True, timeout=20,
                               env=env_verbo(persona or cadeira))
            texto = (p.stdout or "").strip()
            if p.returncode != 0:
                env["motivo"] = (p.stderr or p.stdout).strip()[:200] or f"exit {p.returncode}"
                return env, None
            env["frescor"] = "fresco"
            env["tokens"] = conta_tokens(texto)
            env["sha"] = sha_conteudo(texto)
            return env, texto
        except (OSError, subprocess.SubprocessError) as e:
            env["motivo"] = f"{type(e).__name__}: {e}"
            return env, None

    if art.startswith("calc:"):
        calc_id = art[len("calc:"):].strip()
        fn = PECAS_CALCULADAS_FN.get(calc_id)
        if not fn:
            env["motivo"] = f"calculo desconhecido: {calc_id!r}"
            return env, None
        try:
            texto, motivo = fn()
        except OSError as e:
            env["motivo"] = f"{type(e).__name__}: {e}"
            return env, None
        if texto is None:
            env["motivo"] = motivo or "sem dado para calcular"
            return env, None
        env["frescor"] = "fresco"
        env["tokens"] = conta_tokens(texto)
        env["sha"] = sha_conteudo(texto)
        if motivo:
            env["motivo"] = motivo
        return env, texto

    if "@" not in art:
        env["motivo"] = f"artefato em forma desconhecida: {art!r}"
        return env, None

    repo, path = art.split("@", 1)
    path = path.replace("{cadeira}", cadeira).replace("{chapeu}", chapeu or "")
    env["ref"] = f"{repo}@{path}"
    # O `ref` segue na forma <repo>@<path> porque e o que a cadeira cita; o conteudo,
    # porem, vem da morada publicada (arq:0097). Servida a arvore imutavel, `fresco`
    # deixa de ser comparacao com cache de remote-tracking e passa a ser fato: o que
    # esta em `current` E o ref publicado, e o MANIFEST diz qual.
    caminho = caminho_publicado(path)
    if caminho is None:
        env["motivo"] = f"fora da morada publicada: {art!r} nao esta sob abertura/"
        return env, None
    if not os.path.isfile(caminho):
        env["frescor"] = "indisponivel"
        env["motivo"] = f"nao existe {caminho}"
        return env, None
    with open(caminho, encoding="utf-8", errors="replace") as fh:
        texto = fh.read()
    env["frescor"] = "fresco"
    env["tokens"] = conta_tokens(texto)
    env["sha"] = sha_conteudo(texto)
    return env, texto


# ------------------------------------------------------------------ registro do pacote
def registra_pacote(cadeira, envelopes, montador_sha):
    """Uma linha por peca servida (§6.6). Sem isto, orcamento de janela e declaracao.
    Falha aqui NAO derruba a abertura: devolve o motivo, e o pacote sai mesmo assim."""
    fid = (os.environ.get("PF_FITA") or "").strip()
    if not fid:
        return {"registrado": False, "motivo": "sem PF_FITA — sessao de mao nao tem fita"}
    try:
        import psycopg
    except ImportError:
        return {"registrado": False, "motivo": "psycopg ausente neste venv"}
    senha = os.environ.get("SESSAO_PG_PASSWORD", "")
    if not senha and os.path.isfile(SESSAO_ENV):
        for linha in open(SESSAO_ENV, encoding="utf-8"):
            if linha.startswith("SESSAO_PG_PASSWORD="):
                senha = linha.split("=", 1)[1].strip()
                break
    porta = os.environ.get("SESSAO_PG_PORT", "5437")
    dsn = f"host=127.0.0.1 port={porta} dbname=sessao user=sessao password={senha}"
    sup = os.environ.get("PF_SUPERFICIE", "").strip() or "desconhecida"
    if sup not in ("claude.ai", "chat", "code", "desconhecida"):
        sup = "desconhecida"
    try:
        with psycopg.connect(dsn, connect_timeout=3) as con, con.cursor() as cur:
            cur.execute("INSERT INTO sessao.fita (id, persona, superficie) VALUES (%s,%s,%s) "
                        "ON CONFLICT (id) DO NOTHING", (fid, cadeira, sup))
            cur.execute("INSERT INTO sessao.pacote (fita_id, montador_sha, tokens) "
                        "VALUES (%s,%s,%s) ON CONFLICT (fita_id) DO UPDATE SET "
                        "montado_em = now(), montador_sha = EXCLUDED.montador_sha, "
                        "tokens = EXCLUDED.tokens",
                        (fid, montador_sha, sum(e["tokens"] for e in envelopes)))
            cur.executemany(
                "INSERT INTO sessao.peca_servida (fita_id, peca, ordem, ref, sha, regime, "
                "tokens, frescor) VALUES (%s,%s,%s,%s,%s,%s,%s,%s) "
                "ON CONFLICT (fita_id, peca) DO UPDATE SET ordem = EXCLUDED.ordem, "
                "ref = EXCLUDED.ref, sha = EXCLUDED.sha, tokens = EXCLUDED.tokens, "
                "frescor = EXCLUDED.frescor",
                [(fid, e["peca"], i, e["ref"], e["sha"], e["regime"], e["tokens"], e["frescor"])
                 for i, e in enumerate(envelopes)])
            con.commit()
        return {"registrado": True, "fita": fid}
    except Exception as e:  # noqa: BLE001 — banco mudo nao pode derrubar a abertura
        return {"registrado": False, "motivo": f"{type(e).__name__}"}


# ------------------------------------------------------------------ montagem
def _canonico(sufixo):
    """Nome canonico da cadeira: o SLUG PURO minusculo (arq:0073 §2, incidente/ordem
    do dono). O prefixo `claudinho-`/`claudinha-` foi expurgado do slug — nao ha mais
    nome canonico distinto do sufixo. Vale se a cadeira existe na arvore viva
    (abertura/<sufixo>/persona.md); nao existindo, devolve None: nao inventa.
    O ledger de vinculo NAO se le aqui."""
    suf = _sufixo_sem_prefixo(sufixo)
    # Existência da cadeira é o DIRETÓRIO em abertura/ (arq:0073 §7.5: cadeira criada
    # mas ainda não redigida abre com peças indisponíveis, não com erro). A peça
    # persona é quem fica indisponível quando falta persona.md — não a cadeira.
    if os.path.isdir(os.path.join(ABERTURA, suf)):
        return suf
    return None


def cadeiras_validas():
    """Sufixos vivos: subdirs de abertura/ que tem persona.md (arq:0073 §1). O ledger de
    vinculo NAO se le (incidente/ordem do dono). Cadeira sem persona.md redigida nao
    entra — mesma regra de ausencia de comum/cadeiras.py."""
    try:
        do_disco = {d for d in os.listdir(ABERTURA)
                    if os.path.isdir(os.path.join(ABERTURA, d))}
    except OSError:
        do_disco = set()
    return sorted(do_disco)


# Trilha de LEITURA que o eixo-2 (disparo.py, #2317) le para medir D. Uma linha por
# fonte alcancada: {ts, tool, sujeito, sessao, fonte, cobertura, carimbo, hit|miss,
# disjuntor}. E esta escrita que faz D subir de 0,043 - sem ela o disparo nao conta.
_TRILHA_LEITURA = os.environ.get(
    "PF_REC_TRILHA_LEITURA",
    str(Path.home() / "AI" / "var" / "log" / "recuperacao" / "leitura.jsonl"))


def dispara_acervo(cadeira, sujeito, pergunta):
    """Consulta o acervo na montagem (#2947) e serve o resultado como peca.

    O 'gate' que o card 2947 remove e COMPORTAMENTAL: as personas nao chamavam o RAG,
    entao o log nascia vazio. Aqui a montagem dispara em TODA abertura com pergunta.
    PORTA CANONICA: chama o verbo `motor rag buscar` (golden record), nao HTTP cru.
    Reimplementar /search no adaptador foi o vacilo que este patch corrige. Motor frio
    ou fora do ar viram peca `indisponivel` DECLARADA, nunca excecao que trava a sessao.
    """
    env = {"peca": "acervo-consultado", "dono": "dados",
           "ref": "verbo:rag_buscar(pergunta)", "regime": "valor",
           "volatilidade": "volatil", "sha": None, "tokens": 0}
    if not (pergunta or "").strip():
        env.update(frescor="nao_se_aplica", motivo="abertura sem pergunta", conteudo=None)
        return env, None

    sessao = os.environ.get("PF_FITA", "-")
    ordem_id = os.environ.get("PF_ORDEM_ID", "")
    t0 = time.monotonic()
    hit, cobertura, carimbo, disjuntor = False, "ausente", "-", "fechado"
    # PORTA CANONICA: o verbo `motor rag buscar`, nao HTTP cru. Uma porta so pro indice.
    argv = [os.path.join(str(RAIZ), "bin", "motor"), "rag", "buscar", pergunta.strip(),
            "--k", "6", "--texto", "secao"]
    if ordem_id:
        argv += ["--ordem-id", ordem_id]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=30,
                              env=os.environ.copy())
        if proc.returncode != 0 or not proc.stdout.strip():
            raise RuntimeError((proc.stderr or "verbo motor sem stdout")[:160])
        d = json.loads(proc.stdout)
        if d.get("erro"):
            raise RuntimeError(str(d["erro"])[:160])
        fontes = d.get("fontes") or []
        cobertura = str(d.get("cobertura") or "ausente")
        carimbo = str(d.get("formato_section_id") or "-")
        hit = bool(fontes)
        env["conteudo"] = _portao_cobertura(d, pergunta, env)
        env["frescor"] = "fresco"
        env["tokens"] = conta_tokens(env["conteudo"]) if env.get("conteudo") else 0
    except Exception as e:  # noqa: BLE001
        motivo = str(e)
        disjuntor = "aberto" if any(t in motivo.lower()
                                    for t in ("timeout", "inalcanc", "conex", "refused")) else "fechado"
        env.update(frescor="indisponivel",
                   motivo=f"verbo motor rag buscar falhou: {motivo}", conteudo=None)
    dur_ms = round((time.monotonic() - t0) * 1000)

    linha = {"ts": _agora_iso(), "tool": "monta-sessao", "sujeito": sujeito or cadeira,
             "sessao": sessao, "fonte": "acervo", "cobertura": cobertura,
             "carimbo": carimbo, "hit": hit, "disjuntor": disjuntor, "dur_ms": dur_ms}
    _grava_trilha(linha)
    return env, dur_ms


PODA = os.environ.get("PF_PODA", "1") != "0"


def _portao_cobertura(d, pergunta, env):
    """R5 (arq:0101) — a peca `acervo-consultado` entra INTEIRA so com sinal acima do
    piso; abaixo, uma linha.

    Medido: a abertura de uma fita gastou 28% dos tokens do pacote numa peca de RAG com
    cobertura fraca e uso ZERO — seis trechos de obra nenhuma relacionada, que a cadeira
    nao citou uma vez. Servir recuperacao ruim nao e neutro: ocupa a janela e ainda
    convida a responder pelo vizinho.

    O PISO NAO E DESTA LINHA. Usa-se o que o proprio `motor rag buscar` declara em
    `sinal.piso` — quem e dono do numero e a cadeira de dados (spec capsula §8), e
    inventar um segundo piso aqui seria decidir na marra o que tem dono. Sem `sinal`
    no retorno, serve inteiro: ausencia de medida nao e medida ruim.
    """
    sinal = d.get("sinal") or {}
    valor, piso = sinal.get("valor"), sinal.get("piso")
    tem_medida = isinstance(valor, (int, float)) and isinstance(piso, (int, float))
    if not PODA or not tem_medida or valor >= piso:
        return _formata_acervo(d, pergunta)
    env["motivo"] = (f"portao de cobertura (arq:0101 R5): sinal {valor} < piso {piso} "
                     f"[{sinal.get('medida', '?')}]")
    return ("CONSULTA AO ACERVO - " + pergunta[:80] + f"\nNAO SERVIDA: sinal {valor} "
            f"abaixo do piso {piso} (cobertura {d.get('cobertura') or '?'}), "
            f"{len(d.get('fontes') or [])} trechos retidos. O acervo nao cobre esta "
            "ordem — nao responda pelo vizinho. Por ato, se precisar: "
            "`motor rag buscar \"<pergunta>\"`.")


def _formata_acervo(d, pergunta):
    """Recebe o dict que o verbo `motor rag buscar` devolve. A fita ja vem montada em
    `contexto` (numerada [n] arquivo/section_id), a recuperacao contextual do rag.
    Serve ela direto; sem contexto, cai para o cabecalho das fontes."""
    fontes = d.get("fontes") or []
    if not fontes:
        return ("CONSULTA AO ACERVO - " + pergunta[:80] + "\n"
                "Sem cobertura no acervo para esta ordem. Nao responda pelo vizinho: "
                "se o acervo nao cobre, diga que nao cobre.")
    cab = ("CONSULTA AO ACERVO - " + pergunta[:80] + " (" + str(len(fontes))
           + " trechos, cobertura " + str(d.get("cobertura") or "?") + ")")
    fita = (d.get("contexto") or "").strip()
    rodape = "(consultar nao e usar - cite [n] so onde a resposta aplicar; #2947)"
    if fita:
        return cab + "\n\n" + fita + "\n\n" + rodape
    linhas = [cab]
    for f in fontes:
        linhas.append("[" + str(f.get("n", "?")) + "] " + str(f.get("obra", "?"))
                       + " (" + str(f.get("section_id", "?")) + ")")
    linhas.append(rodape)
    return "\n".join(linhas)


def _grava_trilha(linha):
    try:
        import pathlib
        p = pathlib.Path(_TRILHA_LEITURA)
        p.parent.mkdir(parents=True, exist_ok=True)
        with open(p, "a", encoding="utf-8") as f:
            f.write(json.dumps(linha, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _agora_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime())


def monta(cadeira, atualizar, pergunta=None, forcado_chapeu=None, so_chapeu=False):
    # `atualizar` sobrevive por compatibilidade de chamada (a flag `--sem-atualizar` e o
    # parametro da tool) e NAO faz mais nada: nao ha o que atualizar no caminho de
    # servico. Atualizar a abertura virou ato deliberado e separado, `publicar-abertura`
    # (arq:0097). Aceitar a flag sem efeito e o menor estrago para quem ja chama assim;
    # ignora-la calada seria falso-verde, entao o pacote declara quem atualiza, no bloco
    # `morada` (campo `atualiza_por`).
    m = morada()

    # ---- GATE DE VALOR (arq:0058, no que dele sobrevive ao arq:0097) --------
    # Peca de valor nao se serve de procedencia nao verificavel. Antes isso custava, por
    # abertura, um fetch e um merge --ff-only por clone, e a classe `divergente` travava
    # o boot de TODA cadeira quando um clone tinha commit local nao empurrado. Agora e
    # uma pergunta local e barata: a morada esta publicada? Nao estando, a sessao NAO
    # abre — e a cura segue sendo ato deliberado (`publicar-abertura`), nunca um
    # reset --hard em silencio. Este gate vem ANTES da validacao de cadeira de proposito:
    # sem morada, `cadeiras_validas()` sai vazia e "cadeira desconhecida" seria diagnostico
    # errado do defeito real.
    if m["frescor"] != "publicado":
        return {
            "erro": "sessao nao aberta: pacote de abertura nao publicado na morada "
                    "(runtime nao le working tree git — arq:0097)",
            "cadeira": cadeira, "nome_canonico": None,
            "morada": m, "cadeiras_validas": [],
            "avisos": [f"morada `{m['raiz']}` indisponivel: {m['motivo']}",
                       "cura: `publicar-abertura` — publica o ref e move `current`"],
        }

    if cadeira.lower() not in [c.lower() for c in cadeiras_validas()]:
        return {"erro": f"cadeira desconhecida: '{cadeira}'",
                "cadeiras_validas": cadeiras_validas()}
    p_persona = os.path.join(ABERTURA, cadeira, "persona.md")

    pecas = de_abertura(catalogo(), cadeira)

    texto_persona = (open(p_persona, encoding="utf-8", errors="replace").read()
                     if os.path.isfile(p_persona) else "")
    # Canonico vem do ledger, nao da linha 1: o form novo poe o alias ali (arq:0073).
    nome = _canonico(cadeira)

    # A abertura-base serve SEMPRE, salvo pedido explícito de SÓ-chapéu (`so_chapeu`).
    # Pergunta e chapéu apenas ROTEIAM o chapéu, que é ADITIVO (servido abaixo, por cima
    # da abertura). O antigo `perna_dois` INFERIA "só-chapéu" de "tem pergunta ou chapéu"
    # — proxy errado: com #249 (a borda/fita passou a mandar SEMPRE o corpo do turno como
    # --pergunta), toda abertura virava só-chapéu e, no fallback do roteador, devolvia
    # `pecas: []` sem `erro` — a ambiguidade "peça vazia × cadeira sem peça" que o contrato
    # jura nunca produzir. A troca de chapéu mid-sessão (o defeito que a Carla reportou:
    # reenviar a abertura já servida é desperdício) é caso real — mas agora se pede por
    # FLAG explícita `--so-chapeu`, nunca por inferência. Default serve abertura: esquecer
    # a flag falha para o lado seguro (nunca abre vazio), honrando o contrato acima.
    servidas, avisos = [], []
    if (m["idade_h"] or 0) > IDADE_MORADA_AVISO_H:
        avisos.append(
            f"morada publicada ha {m['idade_h']}h (ref {m['sha']}): a abertura servida "
            "pode estar atras do main — `publicar-abertura` republica")
    if not so_chapeu:
        for peca in pecas:
            env, conteudo = serve(peca, cadeira, nome)
            env["conteudo"] = conteudo
            servidas.append(env)
            if env["frescor"] == "indisponivel":
                avisos.append(f"peça `{env['peca']}` indisponível: {env['motivo']}")
            elif env["frescor"] == "defasado":
                avisos.append(f"peça `{env['peca']}` servida de clone atrasado: {env['motivo']}")

    # Divergencia entre o que a persona declara e o que o catalogo resolve nao se
    # escolhe em silencio: as duas fontes existem, e a que discorda vira aviso.
    if not nome:
        avisos.append(f"cadeira '{cadeira}' sem canônico no ledger — fila não localizada")

    # ---- P2 passo 2: responde "qual chapeu?" DENTRO da montagem (recursao) ----
    # (a) deterministico -> (b) semantico -> (c) fallback. So dobra o chapeu quando decide.
    dec = _rot.escolhe(pergunta, cadeira, CHAPEUS_DIR, forcado=forcado_chapeu)
    roteador = {"via": dec.via, "motivo": dec.motivo, "acertos": dec.acertos, "slug": dec.slug}
    chapeu_env = None
    if dec.slug:
        # Perna 2 (arq:0073): dobra o chapeu servindo TODAS as pecas com gatilho de chapeu
        # (chapeu.md, ferramental.md, caderno do chapeu) pelo catalogo, {chapeu}=slug.
        for pc in de_chapeu(catalogo()):
            envc, cont = serve(pc, cadeira, nome, chapeu=dec.slug)
            envc["conteudo"] = cont
            envc["peca"] = f"{pc.get('id')}:{dec.slug}"
            envc["slug"] = dec.slug
            servidas.append(envc)
            if chapeu_env is None:
                chapeu_env = envc
            if envc["frescor"] == "indisponivel":
                avisos.append(f"peça `{envc['peca']}` indisponível: {envc['motivo']}")
    else:
        avisos.append(f"chapeu nao roteado (fallback): {dec.motivo}")

    # #2947 - disparo do acervo na montagem. Serve o RAG ja consultado sobre a
    # pergunta que abriu a fita e escreve a linha que o eixo-2 mede (D). So na
    # abertura: so_chapeu reenvia chapeu, nao redispara mid-sessao.
    if not so_chapeu and pergunta:
        env_ac, _dur = dispara_acervo(cadeira, nome, pergunta)
        servidas.append(env_ac)
        if env_ac["frescor"] == "indisponivel":
            avisos.append(f"peca `acervo-consultado` indisponivel: {env_ac['motivo']}")

    # Quem data o pacote e o ref PUBLICADO, nao o clone: era o SHA do working tree do
    # montador (arq:0058, 'um clone so data o pacote'), e agora e o commit de onde a
    # arvore foi extraida — imutavel, e por isso reproduzivel.
    montador_sha = m["sha"]
    return {
        "cadeira": cadeira,
        "nome_canonico": nome,
        "morada": m,
        "pacote": {
            "pecas": len(servidas),
            "tokens": sum(e["tokens"] for e in servidas),
            "metodo_tokens": medidor()[1],
            "montador_sha": montador_sha,
            "montado_em": int(time.time()),
            "registro": registra_pacote(cadeira, servidas, montador_sha),
        },
        "pecas": servidas,
        "chapeu": (chapeu_env["slug"] if chapeu_env else None),
        "roteador": roteador,
        "avisos": avisos,
    }


def imprime_texto(pac):
    if "erro" in pac:
        print(f"{pac['erro']}" + (f" (procurado: {pac['procurado']})" if pac.get('procurado') else ""), file=sys.stderr)
        print("cadeiras: " + " ".join(pac["cadeiras_validas"]), file=sys.stderr)
        return 1
    print(f"== cadeira: {pac['nome_canonico'] or '<nome não resolvido>'} ==")
    for e in pac["pecas"]:
        cab = f"===== {e['peca']}: {e['ref']}"
        if e["sha"]:
            cab += f" @{e['sha']}"
        cab += f" ({e['frescor']}, {e['tokens']} tokens) ====="
        print(cab)
        if e["conteudo"] is None:
            print(f"(INDISPONÍVEL — {e['motivo']})")
        else:
            print(e["conteudo"].rstrip())
        print()
    for a in pac["avisos"]:
        print(f"(aviso: {a})")
    reg = pac["pacote"]["registro"]
    if not reg.get("registrado"):
        print(f"(pacote não registrado: {reg.get('motivo')})")
    return 0


CHAPEUS = ABERTURA


def chapeus_de(cadeira):
    """Slugs no disco, por descoberta. Nao ha lista fixa: chapeu escrito por outra
    cadeira aparece sem ninguem emendar codigo — e foi para isso que este verbo
    existe. Diretorio ausente e lista vazia, nao erro."""
    d = os.path.join(CHAPEUS, cadeira)
    if not os.path.isdir(d):
        return []
    return sorted(n for n in os.listdir(d)
                  if os.path.isfile(os.path.join(d, n, "chapeu.md")))


def serve_chapeu(cadeira, slug):
    """Envelope + conteudo de UM chapeu. Ausente vem declarado, nunca omitido:
    pacote sem a peca e pacote com peca vazia seriam indistinguiveis."""
    caminho = os.path.join(CHAPEUS, cadeira, slug, "chapeu.md")
    env = {"peca": f"chapeu:{slug}", "cadeira": cadeira, "slug": slug,
           "ref": f"platafirma-harness@abertura/{cadeira}/{slug}/chapeu.md",
           "regime": "valor", "carga": "sob demanda",
           "sha": None, "tokens": 0, "frescor": "indisponivel", "motivo": None}
    if not os.path.isfile(caminho):
        env["motivo"] = f"nao existe: {caminho}"
        env["chapeus_do_disco"] = chapeus_de(cadeira)
        return env, None
    texto = open(caminho, encoding="utf-8").read()
    env["frescor"] = "fresco"
    env["tokens"] = conta_tokens(texto)
    env["sha"] = sha_conteudo(texto)
    _, env["metodo_tokens"] = medidor()
    return env, texto


def imprime_chapeu(cadeira, args):
    if args.chapeus:
        slugs = chapeus_de(cadeira)
        if args.json:
            print(json.dumps({"cadeira": cadeira, "chapeus": slugs,
                              "carga": "monta-sessao <cadeira> --chapeu <slug>"},
                             ensure_ascii=False))
            return 0
        if not slugs:
            print(f"nenhum chapeu escrito para '{cadeira}' "
                  f"(procurado: {os.path.join(CHAPEUS, cadeira)})", file=sys.stderr)
            return 1
        for s in slugs:
            env, _ = serve_chapeu(cadeira, s)
            print(f"{s}\t{env['tokens']} tokens\t{env['sha']}"
                  + (f"\t{env['motivo']}" if env["motivo"] else ""))
        return 0

    env, texto = serve_chapeu(cadeira, args.chapeu)
    if args.json:
        print(json.dumps({"envelope": env, "conteudo": texto}, ensure_ascii=False))
        return 0 if texto else 1
    if not texto:
        print(f"chapeu indisponivel: {env['motivo']}", file=sys.stderr)
        if env.get("chapeus_do_disco"):
            print("chapeus desta cadeira: " + " ".join(env["chapeus_do_disco"]),
                  file=sys.stderr)
        return 1
    print(f"===== chapeu {cadeira}/{args.chapeu} @{env['sha']} "
          f"({env['tokens']} tokens) =====")
    print(texto)
    if env["motivo"]:
        print(f"\naviso: {env['motivo']}", file=sys.stderr)
    return 0


def main():
    # --ajuda UNIVERSAL (card #2868, ex-#2274 defeito 4): argparse ja da -h/--help;
    # aqui so mapeamos o alias PT --ajuda -> --help antes do parse, sem colidir com
    # os subparsers. Sem efeito colateral: nenhum ato roda.
    sys.argv = [("--help" if a == "--ajuda" else a) for a in sys.argv]
    p = argparse.ArgumentParser(prog="monta-sessao",
                                description="pacote de abertura da cadeira, montado por catálogo")
    p.add_argument("cadeira", nargs="?")
    p.add_argument("--json", action="store_true")
    p.add_argument("--sem-atualizar", action="store_true",
                   help="aceito e SEM EFEITO desde arq:0097: a abertura vem da morada "
                        "publicada, e quem a atualiza e `publicar-abertura`")
    # Chapeu NAO entra na abertura (spec_montagem-de-sessao §7): carrega sob demanda,
    # no giro em que a linha ativa. Estas duas flags sao essa demanda, e por isso saem
    # do mesmo verbo — a conta e um verbo por capacidade (arq:0037), e a capacidade
    # aqui continua sendo `expediente`.
    p.add_argument("--chapeus", action="store_true",
                   help="lista os chapeus da cadeira, por descoberta no disco")
    p.add_argument("--pergunta", metavar="TEXTO",
                   help="o turno do dono; roteia o chapeu por (a)/(b), senao cai no fallback (c)")
    p.add_argument("--so-chapeu", action="store_true",
                   help="troca de chapeu mid-sessao: serve SO o chapeu, sem a abertura "
                        "(a abertura ja veio na 1a chamada; reenvia-la e desperdicio). "
                        "Default: serve abertura + chapeu roteado.")
    p.add_argument("--chapeu", metavar="SLUG",
                   help="serve UM chapeu da cadeira (sob demanda, fora da abertura)")
    args = p.parse_args()

    if not args.cadeira:
        if args.json:
            print(json.dumps({"erro": "uso: monta-sessao <cadeira>",
                              "cadeiras_validas": cadeiras_validas()}, ensure_ascii=False))
            return 2
        print("uso: monta-sessao <cadeira>", file=sys.stderr)
        print("cadeiras: " + " ".join(cadeiras_validas()), file=sys.stderr)
        return 2

    # Prefixo aceito e descartado: `claudinho-TI` e `TI` sao a mesma cadeira, e o nome
    # do arquivo de persona e o sufixo. Mesma regra de `_sufixo_sem_prefixo` (unica
    # implementacao do strip no arquivo — card #2438, comentario #380 do #2431).
    alvo = _sufixo_sem_prefixo(args.cadeira.strip())

    if args.chapeus:
        return imprime_chapeu(alvo, args)

    pac = monta(alvo, atualizar=not args.sem_atualizar, pergunta=args.pergunta,
                forcado_chapeu=args.chapeu, so_chapeu=args.so_chapeu)
    if args.json:
        print(json.dumps(pac, ensure_ascii=False))
        return 1 if "erro" in pac else 0
    return imprime_texto(pac)


if __name__ == "__main__":
    sys.exit(main())
