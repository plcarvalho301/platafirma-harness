_FANTASMA_EXTS = (
    ".sidecar.json", ".sidecar.yaml", ".sidecar.yml",
    ".manifest", ".csv", ".jsonl", ".ods",
)
_FANTASMA_NAMES = {
    "manifest.json", "manifest.yaml", "inventario.csv", "fila-lote.jsonl",
}
_RE_WIKI_DATADO = re.compile(r"^(?:wiki/)?(.+?)@(\d{4}-\d{2}-\d{2})\.md$", re.IGNORECASE)

USO = """uso:
  ingerir (--lote <pasta> | --origem <gdrive:pasta|url> | --drive [<pasta>]) [opções]

Incorporar (arq:0119 §2): sem --ate, o lote para na obra catalogada com a cópia sob guarda.
Com --ate chunk, o --apply encadeia Transcrever (acervo espelhar) obra a obra; com --ate embed|vetor,
encadeia Transcrever, Indexar e põe no ar (motor <inst> indexar --promover). A obra que um portão
barra (espelho não servível, gate do motor) para ali, com o portão dito; as outras seguem.

Todo arquivo que entra ganha a ficha no mesmo ato (#3306): o formato lido nos bytes, não no nome. O plano
mostra o que a ficha leu na coluna Formato (um `.pdf` que é JSON sai JSON, um `.pdf` que é GZIP sai GZIP);
`?` é arquivo que o conversor não leu no plano, e o aplicar lê de novo.

opções de fonte (uma das opções):
  --lote <pasta>         pasta local com arquivos do lote a ingerir
  --origem <o>           pasta do Drive a espelhar para $PLATAFIRMA_INSTANCIA/var/entrada antes de ingerir;
                         aceita 'gdrive:<caminho>' ou URL drive/.../folders/<ID>
  --drive [<pasta>]      espelha pasta do Drive para staging local (~/AI/entrada/drive-<AAAAMMDD>-<rotulo>)
                         antes de ingerir (default: PlataFirma/entrada); o espelho é fiel (rclone sync):
                         arquivo que saiu do Drive sai do staging

opções adicionais:
  --apply                aplica o lote (default: falso, dry-run do plano)
  --ate <degrau>         degrau alvo: catalogar | chunk | embed | vetor (default: catalogar);
                         chunk pára na impressão selada; embed e vetor vão até o ar
  --motor <inst>         instância do motor que indexa (default: rag); só com --ate embed|vetor
  --ocr                  aceito e sem efeito: o espelhar faz OCR na página escaneada
  --semantico            corte semântico por Orçamento de Fronteiras na seção sem heading que
                         estoura o teto (causa A, card #3073); default: false (corte por tamanho)
  --autor <slug>         curador do lote (default: cadeira da sessão ou 'dados')
  --colecao, --bucket <s> coleção do acervo: firma | pessoal (default: firma)
  --json                 emite resultado em formato JSON bruto
"""


def falha_indeterminavel(erro_ou_resp):
    print("indeterminavel")
    if isinstance(erro_ou_resp, requests.Response):
        try:
            pj = erro_ou_resp.json()
            print(json.dumps(pj, indent=2, ensure_ascii=False))
        except Exception:
            print(json.dumps({
                "type": "about:blank",
                "title": "FonteIndisponivel",
                "status": erro_ou_resp.status_code,
                "detail": erro_ou_resp.text,
            }, indent=2, ensure_ascii=False))
    else:
        print(json.dumps({
            "type": "about:blank",
            "title": "FonteIndisponivel",
            "status": 503,
            "detail": f"Motor acervo indisponível em {BASE}: {erro_ou_resp}",
        }, indent=2, ensure_ascii=False))
    sys.exit(1)


def e_arquivo_fantasma(nome_ou_caminho: str) -> bool:
    nome = os.path.basename(nome_ou_caminho).lower()
    if nome in _FANTASMA_NAMES:
        return True
    return any(nome.endswith(ext) for ext in _FANTASMA_EXTS)


def extrair_classificacao_de_dict(r: dict) -> dict:
    c = {}
    if r.get("titulo"):
        c["titulo"] = r["titulo"]
    if r.get("dominio"):
        c["dominio"] = r["dominio"]
    if r.get("subdominio"):
        c["subdominio"] = r["subdominio"]
    if r.get("especie"):
        c["especie"] = r["especie"]
    concs_raw = r.get("conceitos") or r.get("conceito") or r.get("trata_de")
    if concs_raw:
        concs = [x.strip() for x in re.split(r"[,;]", concs_raw) if x.strip()]
        if concs:
            c["conceitos"] = concs
    if r.get("emitido_por"):
        em = [x.strip() for x in re.split(r"[,;]", r["emitido_por"]) if x.strip()]
        if em:
            c["emitido_por"] = em
    if r.get("publicacao"):
        c["publicacao"] = r["publicacao"]
    if r.get("id_canonico"):
        c["id_canonico"] = r["id_canonico"]
    if r.get("vinculacao"):
        # ont:0071: valor posto por quem classifica no sidecar; a ingestão não o infere de nada
        c["vinculacao"] = r["vinculacao"].strip()
    return c


def ler_sidecar_csv(caminho: str) -> dict[str, dict]:
    resultado = {}
    try:
        with open(caminho, newline="", encoding="utf-8-sig") as f:
            reader = csv.DictReader(f)
            for row in reader:
                r = {k.strip().lower(): (v.strip() if v else "") for k, v in row.items() if k}
                arq = r.get("arquivo")
                if not arq:
                    continue
                classif = extrair_classificacao_de_dict(r)
                resultado[arq] = classif
                resultado[os.path.basename(arq)] = classif
    except Exception as e:
        sys.stderr.write(f"ingerir: aviso: falha ao ler sidecar CSV {caminho}: {e}\n")
    return resultado


def ler_sidecar_ods(caminho: str) -> dict[str, dict]:
    resultado = {}
    NS = "{urn:oasis:names:tc:opendocument:xmlns:table:1.0}"
    TX = "{urn:oasis:names:tc:opendocument:xmlns:text:1.0}"
    try:
        with zipfile.ZipFile(caminho) as z:
            raiz = ET.fromstring(z.read("content.xml"))
        linhas = []
        for t in raiz.iter(f"{NS}table"):
            if t.get(f"{NS}name") != "Classificacao":
                continue
            for row in t.iter(f"{NS}table-row"):
                cel = []
                for c in row.iter(f"{NS}table-cell"):
                    rep = int(c.get(f"{NS}number-columns-repeated", "1"))
                    if rep > 200:
                        break
                    txt = "".join("".join(x.itertext()) for x in c.iter(f"{TX}p"))
                    cel.extend([txt] * rep)
                linhas.append(cel)
            break
        if len(linhas) >= 2:
            cab = [str(c).strip().lower() for c in linhas[0]]
            for cel in linhas[1:]:
                if not any(cel):
                    continue
                r = {cab[i]: (cel[i].strip() if i < len(cel) else "") for i in range(len(cab)) if cab[i]}
                arq = r.get("arquivo")
                if not arq:
                    continue
                classif = extrair_classificacao_de_dict(r)
                resultado[arq] = classif
                resultado[os.path.basename(arq)] = classif
    except Exception as e:
        sys.stderr.write(f"ingerir: aviso: falha ao ler sidecar ODS {caminho}: {e}\n")
    return resultado


def _slug_origem(origem: str) -> str:
    base = origem.split(":", 1)[-1].rstrip("/").split("/")[-1]
    s = re.sub(r"[^a-zA-Z0-9]+", "-", base).strip("-").lower()
    return s or "lote"

def _resolver_gdrive(caminho: str) -> str:
    # aceita 'gdrive:<caminho>' direto, ou uma URL de pasta do Drive
    # (drive/.../folders/<ID>), resolvida a caminho gdrive: por ID.
    m = re.search(r"/folders/([A-Za-z0-9_-]+)", caminho)
    if not m:
        return caminho if caminho.startswith("gdrive:") else f"gdrive:{caminho}"
    fid = m.group(1)
    try:
        r = subprocess.run(
            ["rclone", "lsjson", "--drive-root-folder-id", fid, "gdrive:", "--dirs-only"],
            capture_output=True, text=True, timeout=60, check=False,
        )
    except (OSError, subprocess.SubprocessError) as e:
        sys.stderr.write(f"ingerir: erro: falha ao resolver pasta do Drive {fid}: {e}\n")
        sys.exit(1)
    if r.returncode != 0:
        sys.stderr.write(f"ingerir: erro: rclone nao resolveu a pasta {fid}: {r.stderr.strip()}\n")
        sys.exit(1)
    # ID resolvido: usa o próprio ID como raiz do remote para o copy
    return f"gdrive,root_folder_id={fid}:"

def aterrissar_origem(origem: str) -> str:
    # Etapa 1 do runbook ingestao-do-drive, como ato do verbo: espelha uma
    # pasta do Drive para $PLATAFIRMA_INSTANCIA/var/entrada e devolve o caminho local (o --lote).
    remote = _resolver_gdrive(origem)
    slug = _slug_origem(origem)
    data = time.strftime("%Y%m%d")
    entrada = os.path.join(str(instancia() / "var" / "entrada"), f"drive-{data}-{slug}")
    os.makedirs(entrada, exist_ok=True)
    sys.stderr.write(f"ingerir: espelhando {origem} -> {entrada}\n")
    try:
        r = subprocess.run(
            ["rclone", "copy", remote, entrada, "--drive-acknowledge-abuse"],
            capture_output=True, text=True, timeout=1800, check=False,
        )
    except (OSError, subprocess.SubprocessError) as e:
        sys.stderr.write(f"ingerir: erro: rclone copy falhou: {e}\n")
        sys.exit(1)
    if r.returncode != 0:
        sys.stderr.write(f"ingerir: erro: rclone copy falhou ({r.returncode}): {r.stderr.strip()}\n")
        sys.exit(1)
    return entrada

def aterrissar_drive(pasta: str | None) -> str:
    # 1. Pasta-alvo default = PlataFirma/entrada quando --drive vem sem argumento.
    #    Com argumento, usa o caminho passado.
    alvo = (pasta or "").strip() or "PlataFirma/entrada"
    if alvo.startswith("gdrive:"):
        alvo = alvo[len("gdrive:"):].strip() or "PlataFirma/entrada"
    remote = _resolver_gdrive(alvo)
    rotulo = _slug_origem(alvo)
    data = time.strftime("%Y%m%d")
    # PF_ENTRADA_RAIZ só existe para o teste não escrever no staging real; sem ela, ~/AI/entrada.
    staging_raiz = os.environ.get("PF_ENTRADA_RAIZ") or os.path.expanduser("~/AI/entrada")
    staging = os.path.join(staging_raiz, f"drive-{data}-{rotulo}")
    os.makedirs(staging, exist_ok=True)
    sys.stderr.write(f"ingerir: espelhando {remote} -> {staging}\n")
    try:
        # sync, não copy: o staging é espelho fiel da pasta do Drive. O que saiu do Drive
        # sai da cópia de trabalho, senão o PORTÃO 1 (contagem lsf = staging) recusa o lote
        # pelo resto do dia e o arquivo tirado entra na ingestão. Só o staging é tocado.
        r_copy = subprocess.run(
            ["rclone", "sync", remote, staging, "--drive-acknowledge-abuse", "-P"],
            capture_output=True, text=True, timeout=1800, check=False,
        )
    except (OSError, subprocess.SubprocessError) as e:
        sys.stderr.write(f"ingerir: erro: rclone sync falhou: {e}\n")
        sys.exit(1)
    if r_copy.returncode != 0:
        sys.stderr.write(f"ingerir: erro: rclone sync falhou ({r_copy.returncode}): {r_copy.stderr.strip()}\n")
        sys.exit(1)

    # 4. PORTÃO 1 antes de ingerir: contagem de `rclone lsf` bate com o `ls` do
    #    staging; divergiu, erra e não segue (não deixa lote incompleto passar).
    try:
        r_lsf = subprocess.run(
            ["rclone", "lsf", remote],
            capture_output=True, text=True, timeout=300, check=False,
        )
    except (OSError, subprocess.SubprocessError) as e:
        sys.stderr.write(f"ingerir: erro: rclone lsf falhou: {e}\n")
        sys.exit(1)
    if r_lsf.returncode != 0:
        sys.stderr.write(f"ingerir: erro: rclone lsf falhou ({r_lsf.returncode}): {r_lsf.stderr.strip()}\n")
        sys.exit(1)

    itens_lsf = [l.strip() for l in r_lsf.stdout.splitlines() if l.strip()]
    qtd_lsf = len(itens_lsf)
    itens_staging = [f for f in os.listdir(staging) if not f.startswith(".")]
    qtd_staging = len(itens_staging)

    if qtd_lsf != qtd_staging:
        sys.stderr.write(
            f"ingerir: erro: PORTÃO 1: contagem de rclone lsf ({qtd_lsf}) diverge do staging ({qtd_staging}) — lote incompleto\n"
        )
        sys.exit(1)

    sys.stderr.write(f"ingerir: PORTÃO 1 aprovado: {qtd_staging} arquivo(s) conferidos no staging\n")
    return staging

def escanear_pasta(pasta: str) -> tuple[list[tuple[str, str]], dict[str, dict]]:
    sidecars = {}
    arquivos_conteudo = []

    for raiz, _, arqs in os.walk(pasta):
        for a in sorted(arqs):
            if a.startswith("."):
                continue
            fp = os.path.join(raiz, a)
            low = a.lower()
            if low.endswith(".csv"):
                sidecars.update(ler_sidecar_csv(fp))
            elif low.endswith(".ods"):
                sidecars.update(ler_sidecar_ods(fp))

    for raiz, dirs, arqs in os.walk(pasta):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for a in sorted(arqs):
            if a.startswith("."):
                continue
            if e_arquivo_fantasma(a):
                continue
            fp = os.path.join(raiz, a)
            rel = os.path.relpath(fp, pasta).replace(os.sep, "/")
            arquivos_conteudo.append((rel, fp))

    return arquivos_conteudo, sidecars


def extrair_titulo_de_md(caminho: str) -> str | None:
    try:
        with open(caminho, "r", encoding="utf-8", errors="replace") as f:
            for _ in range(15):
                linha = f.readline()
                if not linha:
                    break
                s = linha.strip()
                if s.startswith("# ") and not s.startswith("##"):
                    t = s.lstrip("#").strip()
                    if t:
                        return t
    except Exception:
        pass
    return None


def subir_objeto(caminho: str, sha256: str, colecao: str, headers: dict) -> None:
    tam = os.path.getsize(caminho)
    ct = mimetypes.guess_type(caminho)[0]
    if caminho.lower().endswith(".md"):
        ct = "text/markdown"
    elif caminho.lower().endswith(".pdf"):
        ct = "application/pdf"
    if not ct:
        ct = "application/octet-stream"

    h = {
        **headers,
        "Content-Length": str(tam),
        "Content-Type": ct,
    }
    url = f"{BASE}/acervo/objetos/{sha256}?colecao={urllib.parse.quote(colecao)}"
    try:
        with open(caminho, "rb") as f:
            resp = requests.put(url, data=f, headers=h)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)

    if resp.status_code not in (201, 204):
        if resp.status_code >= 500:
            falha_indeterminavel(resp)
        sys.stderr.write(f"ingerir: erro ao subir objeto {sha256} ({resp.status_code}): {resp.text}\n")
        sys.exit(1)


def descrever_ficha(item: dict) -> str:
    """O que a ficha do arquivo leu nos bytes (#3306), numa célula: formato, versão, páginas e quantas
    pedem OCR. Item sem portão `ficha` (já ingerido, reprovado) fica em `-`; ficha que o conversor não leu
    no plano, em `?` (o aplicar lê de novo)."""
    for p in item.get("portoes") or []:
        if p.get("portao") != "ficha":
            continue
        ficha = p.get("ficha")
        if not ficha:
            return "?"
        nome = ficha.get("formato") or "desconhecido"
        partes = [f"{nome} {ficha['versao']}" if ficha.get("versao") else nome]
        if ficha.get("paginas") is not None:
            partes.append(f"{ficha['paginas']}p")
        if ficha.get("paginas_ocr"):
            partes.append(f"{ficha['paginas_ocr']} OCR")
        return " · ".join(partes)
    return "-"

def formatar_tabela_plano(lote: dict) -> str:
    linhas = []
    resumo = lote.get("resumo", {})
    total = len(lote.get("itens", []))
    linhas.append(f"Plano de Ingestão: lote {lote.get('id')} (dry-run)")
    linhas.append(f"Autor: {lote.get('autor')} · Motor: {lote.get('motor') or '-'} · Até: {lote.get('ate')} · OCR: {lote.get('ocr')} · Coleção: {lote.get('colecao')}")
    linhas.append(f"Resumo: total={total} | criar={resumo.get('criar', 0)} | edicao={resumo.get('edicao', 0)} | ja_ingerido={resumo.get('ja_ingerido', 0)} | bloqueada={resumo.get('bloqueada', 0)} | reprovado={resumo.get('reprovado', 0)}")
    linhas.append("")
    linhas.append(f"{'#':<3} {'Arquivo':<40} {'Formato (ficha)':<24} {'Título':<45} {'Veredito':<14} {'Portões / Detalhe'}")
    linhas.append("-" * 155)
    for it in lote.get("itens", []):
        pos = str(it.get("posicao", 0))
        arq = it.get("arquivo") or "-"
        if len(arq) > 38:
            arq = arq[:35] + "..."
        tit = it.get("titulo") or "-"
        if len(tit) > 43:
            tit = tit[:40] + "..."
        ver = it.get("veredito") or "-"
        detalhes = []
        for p in it.get("portoes", []):
            if p.get("resultado") != "aprovado":
                # o motivo da recusa (#3307): a obra que já tem o arquivo, o formato que os bytes dizem
                motivo = f" — {p['detail']}" if p.get("detail") else ""
                detalhes.append(f"{p.get('portao')}:{p.get('title', p.get('resultado'))}{motivo}")
        det = "; ".join(detalhes) if detalhes else "todos aprovados"
        fmt = descrever_ficha(it)
        if len(fmt) > 22:
            fmt = fmt[:21] + "…"
        linhas.append(f"{pos:<3} {arq:<40} {fmt:<24} {tit:<45} {ver:<14} {det}")
    return "\n".join(linhas)


def formatar_tabela_aplicado(lote: dict) -> str:
    linhas = []
    resumo = lote.get("resumo", {})
    total = len(lote.get("itens", []))
    feito = resumo.get("feito", 0)
    falhou = resumo.get("falhou", 0)
    bloqueada = resumo.get("bloqueada", 0)
    edicao = resumo.get("edicao", 0)
    pulado = sum(1 for it in lote.get("itens", []) if it.get("estado") in ("pulado", "parado"))
    linhas.append(f"Execução de Ingestão: lote {lote.get('id')}")
    linhas.append(f"Estado: {lote.get('estado')} · Autor: {lote.get('autor')} · Motor: {lote.get('motor') or '-'} · Até: {lote.get('ate')}")
    linhas.append(f"Resumo: total={total} | feito={feito} | edicao={edicao} | bloqueada={bloqueada} | pulado={pulado} | falhou={falhou}")
    linhas.append("")
    linhas.append(f"{'#':<3} {'Arquivo':<40} {'Título':<45} {'Veredito':<12} {'Estado':<12} {'Degrau':<12} {'Detalhe'}")
    linhas.append("-" * 145)
    for it in lote.get("itens", []):
        pos = str(it.get("posicao", 0))
        arq = it.get("arquivo") or "-"
        if len(arq) > 38:
            arq = arq[:35] + "..."
        tit = it.get("titulo") or "-"
        if len(tit) > 43:
            tit = tit[:40] + "..."
        ver = it.get("veredito") or "-"
        est = it.get("estado") or "-"
        deg = it.get("degrau_alcancado") or "-"
        det = ""
        if it.get("problem"):
            det = it["problem"].get("detail") or it["problem"].get("title") or str(it["problem"])
        elif it.get("portoes"):
            for p in it["portoes"]:
                if p.get("resultado") != "aprovado":
                    det = f"{p.get('title', p.get('portao'))}: {p.get('detail', '')}"
                    break
        linhas.append(f"{pos:<3} {arq:<40} {tit:<45} {ver:<12} {est:<12} {deg:<12} {det}")
    return "\n".join(linhas)


# --- encadear os estágios depois de Incorporar (arq:0119 §2) -------------------------------
# `--ate chunk` vai até Transcrever (impressão selada); `--ate embed|vetor` vai até o ar: espelha,
# indexa e promove pelo motor (`--promover` depois do gate). Cada obra anda sozinha: a que um portão
# barra para ali, com o portão dito, e as outras seguem. Os atos são os verbos da casa, não cópia.

_ESTADOS_FIM_INDEXACAO = {"concluido", "falhou", "cancelado", "interrompido"}


def _bin_verbo(nome: str) -> str:
    return os.environ.get(f"PF_BIN_{nome.upper()}") or os.path.join(HARNESS_DIR, "bin", nome)


def _roda_verbo(argv: list[str], timeout: int) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"passou de {timeout} s")
    except OSError as e:
        return subprocess.CompletedProcess(argv, 127, "", str(e))


def _primeira_linha(texto: str) -> str:
    for l in (texto or "").splitlines():
        if l.strip():
            return l.strip()
    return ""


def espelhar_obra(obra_id: str) -> tuple[str | None, str]:
    """`acervo espelhar biblioteca obra <id> --apply`. Devolve (impressão selada, julgamento) ou
    (None, o motivo de ter parado)."""
    r = _roda_verbo([_bin_verbo("acervo"), "espelhar", "biblioteca", "obra", obra_id, "--apply"], 1800)
    if r.returncode != 0:
        return None, f"Transcrever: {_primeira_linha(r.stderr) or _primeira_linha(r.stdout) or f'exit {r.returncode}'}"
    impressao, julgamento = None, ""
    for l in r.stdout.splitlines():
        s = l.strip()
        m = re.match(r"impressão\s*:\s*([0-9a-f-]{36})\s+selada", s)
        if m:
            impressao = m.group(1)
        if s.startswith("novo") and "·" in s:
            julgamento = s.rsplit("·", 1)[-1].strip()
    if not impressao:
        return None, "Transcrever: o espelhar não devolveu impressão selada"
    if not julgamento.startswith("servível"):
        return None, f"Transcrever: espelho {julgamento or 'sem julgamento'} (régua 6: só espelho servível entra no ar); impressão {impressao} selada"
    return impressao, julgamento


def indexar_e_promover(obras: list[str], motor: str, autor: str) -> dict[str, str]:
    """`motor <inst> indexar biblioteca --obra … --promover --apply` e o relatório até o fim. Devolve
    {obra: motivo} das que não chegaram ao ar."""
    if not obras:
        return {}
    base = [_bin_verbo("motor"), motor, "indexar", "biblioteca"]
    r = _roda_verbo(base + ["--obra", ",".join(obras), "--promover", "--autor", autor, "--apply", "--json"], 600)
    if r.returncode != 0:
        motivo = f"Indexar: {_primeira_linha(r.stderr) or f'exit {r.returncode}'}"
        return {o: motivo for o in obras}
    try:
        plano = json.loads(r.stdout)
    except ValueError:
        return {o: "Indexar: o motor não devolveu o lote" for o in obras}
    lote = plano.get("lote")
    if not lote:
        return {o: "Indexar: o motor não achou impressão selada a indexar" for o in obras}
    sys.stderr.write(f"ingerir: Indexar: lote {lote} no motor {motor}\n")
    limite = time.time() + int(os.environ.get("PF_INGERIR_PRAZO_INDEXAR", "3600"))
    rel = {}
    while time.time() < limite:
        rr = _roda_verbo(base + ["--relatorio", lote, "--json"], 300)
        if rr.returncode == 0:
            try:
                rel = json.loads(rr.stdout)
            except ValueError:
                rel = {}
            if rel.get("estado") in _ESTADOS_FIM_INDEXACAO:
                break
        time.sleep(float(os.environ.get("PF_INGERIR_PASSO", "5")))
    else:
        motivo = f"Indexar: lote {lote} ainda rodando; acompanhar com motor {motor} indexar biblioteca --relatorio {lote}"
        return {o: motivo for o in obras}
    por_obra = {it.get("obra_id"): it for it in rel.get("itens") or []}
    barradas = {}
    for o in obras:
        it = por_obra.get(o)
        if not it:
            barradas[o] = f"Indexar: obra fora do lote {lote}"
        elif it.get("problema") or not (it.get("gate") or {}).get("aprovado"):
            barradas[o] = f"Indexar: {it.get('problema') or 'gate do motor reprovado'} (lote {lote})"
    return barradas


def encadear_estagios(lote: dict, ate: str, motor: str, autor: str) -> dict[str, str]:
    """Depois do lote aplicado: Transcrever e, além de chunk, Indexar e pôr no ar. Imprime o
    destino de cada obra e devolve {obra: portão} das que pararam antes do alvo."""
    titulos = {it["obra_id"]: it.get("titulo") or it.get("arquivo") or it["obra_id"]
               for it in lote.get("itens", []) if it.get("obra_id") and it.get("estado") == "feito"}
    barradas, seladas = {}, []
    for i, obra in enumerate(titulos, 1):
        sys.stderr.write(f"ingerir: Transcrever {i}/{len(titulos)}: {titulos[obra][:60]}\n")
        impressao, nota = espelhar_obra(obra)
        if impressao:
            seladas.append(obra)
        else:
            barradas[obra] = nota
    if ate != "chunk":
        barradas.update(indexar_e_promover(seladas, motor, autor))
    alvo = "selada" if ate == "chunk" else "no ar"
    print("")
    print(f"Estágios depois de Incorporar: {len(titulos) - len(barradas)} de {len(titulos)} {alvo}")
    for obra, titulo in titulos.items():
        estado = barradas.get(obra) or alvo
        print(f"  {obra}  {titulo[:45]:<45}  {estado}")
    return barradas


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--lote", dest="lote", default=None)
    parser.add_argument("--origem", dest="origem", default=None)
    parser.add_argument("--drive", dest="drive", nargs="?", const="PlataFirma/entrada", default=None)
    parser.add_argument("--motor", dest="motor", default=None)
    parser.add_argument("--apply", dest="apply", action="store_true", default=False)
    parser.add_argument("--ate", dest="ate", default="catalogar")
    parser.add_argument("--ocr", dest="ocr", action="store_true", default=False)
    parser.add_argument("--semantico", dest="semantico", action="store_true", default=False)
    parser.add_argument("--autor", dest="autor", default=None)
    parser.add_argument("--colecao", "--bucket", dest="colecao", default="firma")
    parser.add_argument("--json", dest="como_json", action="store_true", default=False)
    parser.add_argument("-h", "--help", "--ajuda", dest="ajuda", action="store_true", default=False)

    args, desconhecidos = parser.parse_known_args()

    if args.ajuda:
        sys.stderr.write(USO + "\n")
        sys.exit(2)

    fontes = [k for k, v in [("--lote", args.lote), ("--origem", args.origem), ("--drive", args.drive)] if v is not None]
    if len(fontes) > 1:
        sys.stderr.write(USO + "\n")
        sys.stderr.write(f"ingerir: erro: {' e '.join(fontes)} são mutuamente exclusivos\n")
        sys.exit(2)

    if not fontes:
        sys.stderr.write(USO + "\n")
        sys.stderr.write("ingerir: erro: informe --lote <pasta>, --origem <gdrive:pasta|url> ou --drive [<pasta>]\n")
        sys.exit(2)

    if args.drive is not None:
        args.lote = aterrissar_drive(args.drive)
    elif args.origem:
        args.lote = aterrissar_origem(args.origem)

    if not os.path.isdir(args.lote):
        sys.stderr.write(f"ingerir: erro: pasta de lote não encontrada: {args.lote}\n")
        sys.exit(1)

    if args.ate not in ("catalogar", "chunk", "embed", "vetor"):
        sys.stderr.write(f"ingerir: erro: degrau --ate inválido: {args.ate}\n")
        sys.exit(2)

    if args.ate != "catalogar":
        alvo = "Transcrever" if args.ate == "chunk" else "Transcrever, Indexar e pôr no ar"
        sys.stderr.write(
            f"ingerir: --ate {args.ate}: o lote cataloga e, no --apply, encadeia obra a obra até {alvo} "
            f"(acervo espelhar; motor {args.motor or 'rag'} indexar --promover). A obra que um portão barra "
            "para ali, com o portão dito; as outras seguem.\n"
        )
    elif args.motor or args.ocr:
        sys.stderr.write("ingerir: aviso: --motor e --ocr só valem com --ate além de catalogar; ignorados\n")
        args.motor, args.ocr = None, False

    autor = args.autor
    if not autor:
        cad = os.environ.get("PF_CADEIRA", "").strip().lower()
        if cad:
            cad = cad.removeprefix("claudinho-").removeprefix("claudinha-")
            autor = cad
        else:
            autor = "dados"

    headers = {}
    if TOKEN:
        headers["authorization"] = f"Bearer {TOKEN}"

    arquivos, sidecars = escanear_pasta(args.lote)
    if not arquivos:
        sys.stderr.write(f"ingerir: erro: nenhum arquivo de conteúdo encontrado em {args.lote}\n")
        sys.exit(1)

    itens = []
    for rel, fp in arquivos:
        with open(fp, "rb") as f:
            corpo = f.read()
        sha256 = hashlib.sha256(corpo).hexdigest()

        if len(corpo) > 0:
            subir_objeto(fp, sha256, args.colecao, headers)

        classif = sidecars.get(rel) or sidecars.get(os.path.basename(rel)) or {}
        classif = dict(classif)
        titulo = classif.pop("titulo", None)
        if not titulo and fp.lower().endswith(".md"):
            titulo = extrair_titulo_de_md(fp)
        if not titulo:
            titulo = os.path.splitext(os.path.basename(rel))[0]

        m_wiki = _RE_WIKI_DATADO.match(rel)
        if m_wiki:
            pagina = m_wiki.group(1)
            edicao = m_wiki.group(2)
            origem = {
                "tipo": "pagina",
                "endereco": f"wiki://{pagina}",
                "objeto": f"acervo/{sha256}",
                "edicao": edicao,
            }
        else:
            origem = {
                "tipo": "objeto",
                "objeto": f"acervo/{sha256}",
            }

        item = {
            "titulo": titulo,
            "arquivo": rel,
            "origem": origem,
        }
        if classif:
            item["classificacao"] = classif
        itens.append(item)

    # O lote do servidor só incorpora (arq:0119 §2): transcrever e indexar são atos próprios,
    # encadeados aqui depois do aplicar (encadear_estagios).
    payload = {
        "autor": autor,
        "ate": "catalogar",
        "ocr": False,
        "semantico": args.semantico,
        "colecao": args.colecao,
        "itens": itens,
    }

    try:
        resp = requests.post(f"{BASE}/acervo/lotes", json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)

    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 201:
        try:
            pj = resp.json()
            sys.stderr.write(f"ingerir: erro {resp.status_code} ({pj.get('title', 'Erro')}): {pj.get('detail', resp.text)}\n")
        except Exception:
            sys.stderr.write(f"ingerir: erro {resp.status_code}: {resp.text}\n")
        sys.exit(1)

    lote = resp.json()

    lote_id = lote["id"]

    # [3096] Gravar manifesto do lote na bancada
    def salvar_manifesto(lote_obj):
        bancada_conf = os.path.expanduser("~/.config/platafirma/bancada")
        if os.path.exists(bancada_conf):
            bancada = open(bancada_conf).read().strip()
            lotes_dir = os.path.join(bancada, "registro", "lotes")
            os.makedirs(lotes_dir, exist_ok=True)
            manifesto = os.path.join(lotes_dir, f"{lote_obj['id']}.json")
            with open(manifesto, "w", encoding="utf-8") as f:
                json.dump(lote_obj, f, indent=2, ensure_ascii=False)
    
    salvar_manifesto(lote)


    if not args.apply:
        if args.como_json:
            print(json.dumps(lote, indent=2, ensure_ascii=False))
        else:
            print(formatar_tabela_plano(lote))
        reprovados = sum(1 for it in lote.get("itens", []) if it.get("veredito") == "reprovado")
        sys.exit(3 if reprovados > 0 else 0)

    # Execução assíncrona (--apply)
    try:
        resp_app = requests.post(f"{BASE}/acervo/lotes/{lote_id}/aplicar", headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)

    if resp_app.status_code >= 500:
        falha_indeterminavel(resp_app)
    if resp_app.status_code not in (200, 202):
        sys.stderr.write(f"ingerir: erro ao aplicar lote ({resp_app.status_code}): {resp_app.text}\n")
        sys.exit(1)

    while True:
        time.sleep(1.0)
        try:
            r_chk = requests.get(f"{BASE}/acervo/lotes/{lote_id}", headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if r_chk.status_code >= 500:
            falha_indeterminavel(r_chk)
        if r_chk.status_code != 200:
            continue
        lote_atual = r_chk.json()
        if lote_atual.get("estado") in ("concluido", "falhou"):
            lote = lote_atual
            break

    if args.como_json:
        print(json.dumps(lote, indent=2, ensure_ascii=False))
    else:
        print(formatar_tabela_aplicado(lote))

    salvar_manifesto(lote)
    if lote.get("estado") != "concluido":
        sys.exit(1)
    if args.ate == "catalogar":
        sys.exit(0)
    barradas = encadear_estagios(lote, args.ate, args.motor or "rag", autor)
    sys.exit(1 if barradas else 0)


if __name__ == "__main__":
    main()
