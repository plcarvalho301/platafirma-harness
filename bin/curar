# atos: --reclassificar, --situacao, --expurgar, --restaurar, --apagar, --promover, --recortar, --reextrair, --rejulgar, --conceito, --relacionar, --relacoes, --desrelacionar, --derivar, --derivacoes, --desderivar, --registrar-obra
