_UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.IGNORECASE)

USO = """uso:
  curar --reclassificar [opções de alteração] [opções de seleção]
  curar --situacao <obra>
  curar --expurgar <obra> [--apply]
  curar --restaurar <obra> [--apply]
  curar --apagar <obra> [--apply]                             tira do acervo, SEM VOLTA, a obra já retirada: catálogo,
                                                              motor e balde (arq:0119 §9.2); sem --apply, o plano
  curar --promover <obra> --impressao <id>
  curar --recortar <obra> [--corte <slug>] [--apply]          impressão nova sobre o mesmo espelho; termina na selada
  curar --reextrair <obra> [--metodo <slug|digest>] [--apply] espelho novo do próprio arquivo; termina na selada
                                                              (sem --metodo: o padrão do tipo, `acervo listar biblioteca metodos`)
  curar --reextrair --lote [--ordem <id,id,…|@arquivo>] [--metodo <slug>] [--apply]
                                                              o estoque pelo padrão do tipo (spec espelho-de-leitura §4.2):
                                                              plano = PORTÃO 1 com a contagem por tipo; --apply abre o lote
  curar --reextrair --lote --medida --replicas <n> --ordem <id,id,…|@arquivo> [--metodo <slug>] [--apply]
                                                              só converte e mede a lista em até <n> réplicas (#3228);
                                                              nada no acervo: o item sai `medida` com o relatório
  curar --reextrair --lote --relatorio <lote> [--json]         estado do lote, obra a obra
  curar --rejulgar --lote [--apply]                           espelhos com régua antiga: o veredito de novo, sem reconverter
  curar --reextrair <id,id,…|@arquivo> --bancada <pasta> [--metodo <slug>] [--modo bancada|medida] [--refazer] [--timeout-s <n>] [--json]
                                                              converte em <pasta>/<metodo>/<obra_id>/, não escreve no acervo
  curar --expurgar --espelhos [--apply]                       espelho de impressão aposentada há +90 dias
  curar --restaurar --espelhos [<obra>] [--apply]             desfaz o expurgo de espelhos
  curar --conceito <slug> [--rotulo … --definicao … --natureza … --estatuto … --alt "rótulo@pt,…"] --pai <slug> --tipo <t> --garantia <g> --motivo "…" [--lastro …] [--apply]
  curar --conceito <slug> --renomear <slug-novo> --motivo "…" [--sem-hermit] [--apply]
                                troca o slug (cura K15): o velho vira termo de entrada; o plano traz a varredura de quem
                                aponta, D7 e D8 do slug novo e o HermiT
  curar --relacionar <de> <para> --tipo <t> --garantia <g> --motivo <m> [--lastro <obra>] [--apply]
  curar --relacionar --help     cartilha: as 11 famílias (frase-molde) e as 3 garantias
  curar --relacoes <conceito>   arestas de um conceito, coluna + tabela (o que já está lavrado)
  curar --desrelacionar <id>    desfaz UMA aresta lavrada (pede confirmação 'sim')
  curar --derivar <obra> --de <origem> [--motivo \"…\"] [--apply]   a obra deriva da origem (ont:0092 §2)
  curar --derivacoes <obra>     de onde a obra deriva e o que deriva dela
  curar --desderivar <obra> --de <origem> [--sim]   desfaz UMA derivação
  curar --registrar-obra \"<título>\" [--especie … --emitido-por … --id-canonico … --publicacao … --colecao firma] [--apply]

ações principais:
  --reclassificar               reclassifica obra(s) em lote ou individualmente (default: plano seco)
  --situacao <obra>             consulta a situação viva de uma obra no acervo
  --expurgar <obra>             expurgo reversível de uma obra (default: plano seco; --apply executa)
  --restaurar <obra>            restaura obra expurgada (default: plano seco; --apply executa)
  --promover <obra>             põe a impressão selada no ar (exige --impressao), pela marcação da obra (arq:0119 §5):
                                inteira não promove; transcrita exige trechos; transcrita e indexada exige índice aprovado
  --relacionar <de> <para>      lavra UMA aresta em acervo.conceito_relacao (default: plano seco —
                                conferências SQL com a aresta dentro + HermiT com diff de insatisfazíveis)
  --relacoes <conceito>         lista as arestas de um conceito (pai/filhos da coluna + tabela)
  --desrelacionar <id>          apaga uma aresta pelo id (o export versionado é o registro)

opções de --conceito:
  --rotulo <texto>              rótulo preferido (obrigatório)
  --definicao <texto>           definição (obrigatório)
  --natureza <n>                processo|disposicao|modelo|fenomeno (obrigatório)
  --estatuto <e>                instituido|doutrinario|natural (obrigatório)
  --mais-amplo <slug>           conceito pai (opcional; exige --mais-amplo-tipo)
  --mais-amplo-tipo <t>         generica|partitiva|instancia|instrumental|aferidora|patologica|condicional|economica|tematica
  --rotulo-alt 'lingua|rotulo'  rótulo alternativo (repetível; lingua pt|en|zxx)
  --lingua <l>                  língua do rótulo preferido (default pt)
  --endereco <texto>            endereço/URI canônico (opcional)
  --filhos-exclusivos           filhos mutuamente exclusivos
  --trata-de <obras>            obra(s) de lastro literário (uuid/título, vírgula)

opções de --conceito --renomear (cura K15; não combina com as de criar nem com --pai):
  --renomear <slug-novo>        slug novo; o velho (o do --conceito) vira termo de entrada em acervo.conceito_rotulo
                                (papel alternativo, língua zxx) e a ficha do conceito na raiz o acompanha
  --motivo <texto>              por que o slug muda (obrigatório)
  --sem-hermit                  pula a projeção formal (só com --apply se o HermiT estiver fora)
  o plano mostra: slug, outros_rotulos, varredura de quem aponta (banco, por id: relações, obras, filhos; e o
  texto que cita o velho nos repositórios servidos), D7 e D8 do slug novo e HermiT. Slug novo que já existe sai 1
  com ConceitoDuplicado e o id do que existe; slug velho que não existe, 1 com ConceitoNaoEncontrado

opções de --relacionar:
  --tipo <família>              generica|partitiva|instancia|instrumental|condicional|tematica|
                                patologica|aferidora|economica|relacionada|disjunta
  --garantia <g>                literaria (exige --lastro) | de-uso | instituida
  --motivo <texto>              na frase-molde da família (ver --relacionar --help)
  --lastro <obra>               obra do acervo que sustenta (uuid ou título exato)
  --sem-hermit                  pula a projeção formal (só com --apply se o HermiT estiver fora)

opções de alteração (--reclassificar):
  --trata-de <conceitos>        adiciona conceito(s) (separados por vírgula)
  --remover-trata-de <conceitos> remove conceito(s) (separados por vírgula)
  --substituir-trata-de <concs> substitui todo o conjunto de conceitos da obra
  --dominio <slug>              novo domínio da obra (ou 'null' para limpar)
  --subdominio <slug>           novo subdomínio da obra (ou 'null' para limpar)
  --especie <slug>              nova espécie da obra (ou 'null' para limpar); sem --subtipo, zera o subtipo
  --subtipo <slug>              subtipo da espécie (exige --especie na mesma chamada; 'null' limpa)
  --titulo <texto>              novo título da obra (único no acervo)
  --id-canonico <texto>         identificador canônico (ISBN, DOI, número do ato); 'null' limpa
  --publicacao <texto>          dado de publicação (texto livre, como na fonte); 'null' limpa
  --emitido-por <a;b>           quem emitiu (autor, órgão); vários separados por ';'
  --anotacao <texto>            anotação textual da obra

opções de seleção (--reclassificar em lote):
  --obras <id1,id2,...>         lista de IDs ou títulos de obras a alterar
  --obra <id>                   alteração de uma única obra
  --de-dominio <slug>           filtra obras pelo domínio de origem
  --de-subdominio <slug>        filtra obras pelo subdomínio de origem (usado com --de-dominio)
  --de-conceito <slug>          filtra obras pelo conceito de origem
  --de-colecao <slug>           filtra obras pela coleção (firma | pessoal)
  --sem-dominio                 filtra obras sem domínio atribuído
  --expurgadas                  filtra obras expurgadas
  --teto <n>                    teto máximo de obras a alterar no lote (default: 200, máx: 5000)

opções de --reextrair --bancada (card #3187; "bancada" aqui é só uma pasta de saída dada na linha de comando):
  --bancada <pasta>             grava <pasta>/<metodo>/<obra_id>/{espelho.md,indice.json,relatorio.json}; não escreve no acervo
                                (recusa --apply). --reextrair passa a aceitar 'id1,id2,…' ou '@arquivo' (um id por linha;
                                vazias e '#' ignoradas). Retomável: obra com relatorio.json válido é pulada ('já feito')
                                Item que é um arquivo local (caminho que existe) vai direto ao serviço do conversor,
                                sem a rag-api e sem credencial (PF_CONVERSOR_URL, padrão http://127.0.0.1:8200; #3276);
                                a pasta da obra leva o nome do arquivo sem extensão
  --metodo <slug>               método e segmento de pasta (default: perfil)
  --modo bancada|medida         bancada (padrão) converte e mede a fidelidade; medida (card #3207) só mede as calhas de duas
                                colunas de cada PDF, pela porta ao MuPDF, sem modelo e sem espelho: grava só o relatorio.json
                                (com `medida`: páginas, páginas com calha e as calhas por página). Use uma pasta só para a
                                medida: a retomada pula obra com relatorio.json válido, de qualquer modo. Obra que não é PDF
                                sai n/a; PDF que a porta não abre sai falha. O resumo ganha as obras e as páginas com calha
  --refazer                     refaz mesmo as obras já feitas
  --timeout-s <n>               timeout da conversão no servidor (default 1800); o HTTP espera n+120
  saída: uma linha por obra 'ok|reprovada|n/a|falha|erro|já feito  <obra>  <tipo>  classe=  blocos=  perda=  <ms>ms
  [medida-indeterminada]  [causa]' e os totais. reprovada, n/a e falha são DADO (o servidor respondeu 200; grava
  relatorio.json, conta como feita e a retomada a pula): 'falha' = o método falhou nesta obra (relatorio.erro com
  erro_tipo conversao, timeout ou subprocesso); 'medida-indeterminada' = a conversão vale mas fidelidade.erro diz que a
  medida falhou (refazer é decisão sua, com --refazer). 'erro' = a obra NÃO foi obtida (HTTP 4xx/5xx, rede, título que
  não resolve, método indisponível no servidor, gravação ou conferência sha256/bytes): sem relatorio.json válido,
  sem marcar feito; a conferência que falha deixa relatorio.invalido.json e erro.txt
  exit 0 se todas foram obtidas, 1 se alguma não foi (erro), 2 uso errado (inclui pasta de saída sem escrita, antes de qualquer POST)

opções gerais:
  --apply                       aplica as alterações (default: falso, dry-run do plano)
  --autor <slug>                curador responsável (default: cadeira da sessão ou 'dados')
  --impressao <id>              ID da impressão a promover (obrigatório com --promover)
  --json                        emite resultado em formato JSON
  --sim, -y                     confirma expurgo sem prompt interativo
"""


def falha_indeterminavel(erro_ou_resp):
    print("indeterminavel")
    if isinstance(erro_ou_resp, requests.Response):
        try:
            pj = erro_ou_resp.json()
            print(json.dumps(pj, indent=2, ensure_ascii=False))
        except Exception:
            print(json.dumps({
                "type": "about:blank",
                "title": "FonteIndisponivel",
                "status": erro_ou_resp.status_code,
                "detail": erro_ou_resp.text,
            }, indent=2, ensure_ascii=False))
    else:
        print(json.dumps({
            "type": "about:blank",
            "title": "FonteIndisponivel",
            "status": 503,
            "detail": f"Motor acervo indisponível em {BASE}: {erro_ou_resp}",
        }, indent=2, ensure_ascii=False))
    sys.exit(1)


def falha_problem(resp: requests.Response) -> None:
    try:
        pj = resp.json()
        title = pj.get("title") or f"HTTP {resp.status_code}"
        detail = pj.get("detail")
        msg = f"{title}\n{detail}" if detail else f"{title}\n"
    except Exception:
        msg = f"HTTP {resp.status_code}\n{resp.text}"
    sys.stderr.write(msg.rstrip() + "\n")
    print(msg.rstrip())
    sys.exit(1)


def _parse_lista(vals) -> list[str]:
    if not vals:
        return []
    if isinstance(vals, str):
        vals = [vals]
    res = []
    for v in vals:
        for p in re.split(r"[,;\s]+", str(v)):
            p = p.strip()
            if p:
                res.append(p)
    return res


def resolver_obra_id(obra: str, headers: dict, expurgadas: bool = False, timeout=None) -> str:
    obra = obra.strip()
    if _UUID_RE.match(obra):
        return obra
    ordem_qs = ("?expurgadas=true", "") if expurgadas else ("", "?expurgadas=true")
    resp = None
    for qs in ordem_qs:
        url = f"{BASE}/acervo/obras/{urllib.parse.quote(obra, safe='')}/situacao{qs}"
        try:
            resp = requests.get(url, headers=headers, timeout=timeout)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if resp.status_code >= 500:
            falha_indeterminavel(resp)
        if resp.status_code == 200:
            break
    if resp is None or resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    oid = data.get("obra_id")
    if not oid:
        sys.stderr.write(f"curar: não foi possível resolver o ID da obra '{obra}'\n")
        sys.exit(1)
    # Verbo de ESCRITA: título só resolve por casamento EXATO (trava do card #2975 — nada de
    # seleção por texto livre). Aproximado devolve o candidato e exige o uuid.
    if data.get("casamento") not in (None, "exato"):
        sys.stderr.write(f"curar: '{obra}' casou só aproximado com {oid} ({data.get('titulo')}); "
                         "passe o uuid para escrever nela\n")
        sys.exit(2)
    return oid


def formatar_lote_resultado(res: dict) -> str:
    modo = res.get("modo", "plano")
    n = res.get("n", 0)
    itens = res.get("itens", [])
    linhas = []
    if modo == "plano":
        linhas.append(f"Plano de curadoria: plano com n:{n} (dry-run)")
    else:
        linhas.append(f"Curadoria aplicada: n:{n} aplicado")
    linhas.append("")
    linhas.append(f"{'#':<3} {'Obra ID':<38} {'Título':<40} {'Alterações'}")
    linhas.append("-" * 125)
    for idx, item in enumerate(itens, 1):
        oid = item.get("obra_id", "-")
        tit = item.get("titulo", "-")
        if len(tit) > 38:
            tit = tit[:35] + "..."
        antes = item.get("antes", {})
        depois = item.get("depois", {})
        diffs = []
        for k in sorted(set(antes.keys()) | set(depois.keys())):
            a = antes.get(k)
            d = depois.get(k)
            diffs.append(f"{k}: {a} -> {d}")
        diff_str = "; ".join(diffs) if diffs else "(sem alterações)"
        linhas.append(f"{idx:<3} {oid:<38} {tit:<40} {diff_str}")
    return "\n".join(linhas)


def formatar_situacao(payload: dict) -> str:
    oid = payload.get("obra_id", "-")
    tit = payload.get("titulo", "-")
    servivel = "sim" if payload.get("servivel") else "não"
    degrau = payload.get("degrau", "-")
    desde = payload.get("desde") or "-"
    imp = payload.get("impressao_id") or "-"
    obj = payload.get("objeto") or "-"
    return (
        f"Situação da obra: {tit} ({oid})\n"
        f"  Servível   : {servivel}\n"
        f"  Degrau     : {degrau}\n"
        f"  Desde      : {desde}\n"
        f"  Impressão  : {imp}\n"
        f"  Objeto     : {obj}"
    )


def acao_situacao(obra: str, como_json: bool, headers: dict) -> int:
    # `?expurgadas=true` carrega SÓ o catálogo das expurgadas (servidor): obra viva vira 404.
    # Primeiro o catálogo vivo; expurgada só no 404, como segunda leitura.
    base_url = f"{BASE}/acervo/obras/{urllib.parse.quote(obra, safe='')}/situacao"
    resp = None
    for qs in ("", "?expurgadas=true"):
        try:
            resp = requests.get(base_url + qs, headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if resp.status_code >= 500:
            falha_indeterminavel(resp)
        if resp.status_code != 404:
            break
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        print(formatar_situacao(data))
    return 0


def acao_expurgar(obra: str, autor: str, aplicar: bool, como_json: bool, headers: dict) -> int:
    obra_id = resolver_obra_id(obra, headers, expurgadas=False)
    url_obra = f"{BASE}/acervo/obras/{obra_id}"
    try:
        resp_obra = requests.get(url_obra, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp_obra.status_code >= 500:
        falha_indeterminavel(resp_obra)
    if resp_obra.status_code != 200:
        falha_problem(resp_obra)
    obra_dados = resp_obra.json()
    titulo = obra_dados.get("titulo") or "-"
    expurgada_em_atual = obra_dados.get("expurgada_em")

    if not aplicar:
        plano = {
            "modo": "plano",
            "ato": "expurgar",
            "obra_id": obra_id,
            "titulo": titulo,
            "antes": {
                "expurgada": expurgada_em_atual is not None,
                "expurgada_em": expurgada_em_atual,
            },
            "depois": {
                "expurgada": True,
                "expurgada_em": "now()",
            },
            "export": "sai de ontologia/acervo/obra.jsonl",
            "autor": autor,
        }
        if como_json:
            print(json.dumps(plano, indent=2, ensure_ascii=False))
        else:
            print(f"Plano: expurgar a obra {obra_id} ({titulo})")
            if expurgada_em_atual is not None:
                print(f"  alteração: obra já estava expurgada em {expurgada_em_atual} (idempotente)")
                print("  export   : já ausente de ontologia/acervo/obra.jsonl")
            else:
                print("  alteração: expurgada_em: None -> now() (expurgada)")
                print("  export   : sai de ontologia/acervo/obra.jsonl")
            print("  (plano seco — repita com --apply para gravar)")
        return 0

    url = f"{BASE}/acervo/obras/{obra_id}?autor={urllib.parse.quote(autor)}"
    try:
        resp = requests.delete(url, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 204:
        falha_problem(resp)

    repo_conh = _repo_conhecimento()
    export = _exportar(repo_conh or "")
    if como_json:
        print(json.dumps({
            "modo": "aplicado",
            "ato": "expurgar",
            "expurgada": True,
            "obra_id": obra_id,
            "titulo": titulo,
            "autor": autor,
            "export": export,
        }, indent=2, ensure_ascii=False))
    else:
        print(f"Obra {obra_id} expurgada com sucesso ({titulo}).")
        if export is None:
            print("  export : NÃO regenerado (clone de conhecimento em main / venv não achados) — rode `exportar-acervo` e commite")
        else:
            print(f"  export : regenerado no clone — commit e push são seus:\n    {export.replace(chr(10), chr(10) + '    ')}")
    return 0


def acao_restaurar(obra: str, autor: str, aplicar: bool, como_json: bool, headers: dict) -> int:
    obra_id = resolver_obra_id(obra, headers, expurgadas=True)
    url_obra = f"{BASE}/acervo/obras/{obra_id}"
    try:
        resp_obra = requests.get(url_obra, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp_obra.status_code >= 500:
        falha_indeterminavel(resp_obra)
    if resp_obra.status_code != 200:
        falha_problem(resp_obra)
    obra_dados = resp_obra.json()
    titulo = obra_dados.get("titulo") or "-"
    expurgada_em_atual = obra_dados.get("expurgada_em")

    if not aplicar:
        plano = {
            "modo": "plano",
            "ato": "restaurar",
            "obra_id": obra_id,
            "titulo": titulo,
            "antes": {
                "expurgada": expurgada_em_atual is not None,
                "expurgada_em": expurgada_em_atual,
            },
            "depois": {
                "expurgada": False,
                "expurgada_em": None,
            },
            "export": "entra em ontologia/acervo/obra.jsonl",
            "autor": autor,
        }
        if como_json:
            print(json.dumps(plano, indent=2, ensure_ascii=False))
        else:
            print(f"Plano: restaurar a obra {obra_id} ({titulo})")
            if expurgada_em_atual is None:
                print("  alteração: obra já estava ativa (expurgada_em é nulo)")
                print("  export   : já presente em ontologia/acervo/obra.jsonl")
            else:
                print(f"  alteração: expurgada_em: {expurgada_em_atual} -> None (ativa)")
                print("  export   : entra em ontologia/acervo/obra.jsonl")
            print("  (plano seco — repita com --apply para gravar)")
        return 0

    url = f"{BASE}/acervo/obras/{obra_id}"
    payload = {
        "autor": autor,
        "expurgada": False,
    }
    try:
        resp = requests.patch(url, json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()

    repo_conh = _repo_conhecimento()
    export = _exportar(repo_conh or "")
    if como_json:
        print(json.dumps({
            "modo": "aplicado",
            "ato": "restaurar",
            **data,
            "export": export,
        }, indent=2, ensure_ascii=False))
    else:
        print(f"Obra {obra_id} restaurada com sucesso ({titulo}).")
        if export is None:
            print("  export : NÃO regenerado (clone de conhecimento em main / venv não achados) — rode `exportar-acervo` e commite")
        else:
            print(f"  export : regenerado no clone — commit e push são seus:\n    {export.replace(chr(10), chr(10) + '    ')}")
    return 0


def acao_apagar(obra: str, autor: str, aplicar: bool, como_json: bool, headers: dict) -> int:
    """`curar --apagar <obra> [--apply]`: tira do acervo, sem volta, a obra já retirada (arq:0119 §9.2;
    #3191). Sai o catálogo (com impressões, seções, trechos e ligações), os índices do motor e, no
    balde, o arquivo e os espelhos. Sem --apply, o plano. Exit 1 se algum objeto do balde não saiu."""
    obra_id = resolver_obra_id(obra, headers, expurgadas=True)
    url = f"{BASE}/acervo/obras/{obra_id}/apagar"
    try:
        resp = requests.post(url, json={"autor": autor, "aplicar": aplicar}, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    balde = data.get("balde") or {}
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 1 if balde.get("falhas") else 0
    if data.get("modo") == "plano":
        print(f"Plano: apagar a obra {data['obra_id']} ({data.get('titulo')}), SEM VOLTA")
        print(f"  catálogo: {data['impressoes']} impressão(ões), {data['ligacoes_conceito']} ligação(ões) a "
              f"conceito, {data['ligacoes_frente']} a frente, {data['itens_lote_reextracao']} item(ns) de lote "
              f"de reextração, {data['itens_lote_ingestao']} de lote de ingestão")
        print(f"  ponteiros de fora: {data['obras_fichadas_nela']} obra(s) fichada(s) nela, "
              f"{data['derivacoes']} derivação(ões), {data['lastros_de_aresta']} lastro(s) de aresta")
        mantido = " (fica: outra obra o usa)" if data.get("objeto_compartilhado") else ""
        print(f"  balde: arquivo {data.get('objeto') or '-'}{mantido}, {data['espelhos']} espelho(s)")
        print("  (plano seco — repita com --apply para apagar)")
        return 0
    print(f"Obra {data['obra_id']} apagada: catálogo, {len(data.get('indices_apagados') or [])} índice(s) "
          f"no motor, {len(balde.get('apagados') or [])} objeto(s) no balde {balde.get('bucket')}")
    if balde.get("mantidos"):
        print(f"  ficaram no balde (outra obra usa): {', '.join(balde['mantidos'])}")
    if balde.get("ausentes"):
        print(f"  já ausentes do balde: {', '.join(balde['ausentes'])}")
    if balde.get("falhas"):
        print(f"  NÃO saíram do balde (o catálogo já saiu): {'; '.join(balde['falhas'])}")
        return 1
    return 0


def acao_promover(obra: str, impressao_id: str, autor: str, como_json: bool, headers: dict) -> int:
    obra_id = resolver_obra_id(obra, headers)
    url = f"{BASE}/acervo/obras/{obra_id}/promover"
    payload = {
        "autor": autor,
        "impressao_id": impressao_id,
    }
    try:
        resp = requests.post(url, json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        prom = data.get("promovida", {})
        apos = data.get("aposentada") or {}
        apos_str = f" (aposentada: {apos.get('id')})" if apos.get("id") else ""
        print(f"Impressão {prom.get('id')} promovida a servindo com sucesso{apos_str}.")
        print(f"Obra {data.get('obra_id')}: servível=sim, degrau={data.get('degrau')}")
        # arq:0119 §5: a marcação diz o que subiu junto; só a indexada promove índice (#3193)
        if data.get("marcacao"):
            linha = f"  marcação {data['marcacao']}"
            if data.get("indices_promovidos"):
                linha += f" · índices no ar: {', '.join(map(str, data['indices_promovidos']))}"
            if data.get("indices_aposentados"):
                linha += f" · índices aposentados: {data['indices_aposentados']}"
            print(linha)
    return 0


# Espelho de motor_acervo.relacao_conceito.MOLDES (conhecimento) — a API serve o mesmo em
# GET /acervo/conceitos/relacoes/cartilha; aqui fica o que --help imprime sem rede.
CARTILHA = """cartilha de --relacionar — A = <de>, B = <para>; o motivo tem de caber na frase-molde

hierárquicas (ont:0080; sobem na expansão da busca):
  generica      A é um tipo/forma/escola/método de B; A é B aplicado a X
  partitiva     A é uma camada/estágio/elo/dimensão de B
  instancia     A é um B específico; A é o que instancia B
associativas (ont:0080; vizinhança, não herança):
  instrumental  A é o instrumento/mecanismo/artefato de B
  condicional   A é exigência/condição/restrição/critério de B
  tematica      B é o assunto largo de A; A é o objeto de B
  patologica    A é a falha/risco/degradação de B
  aferidora     A afere B; A é a medida de B
  economica     A é o custo/preço de B
simétricas (gravam uma vez, ordem canônica de uuid):
  relacionada   A e B andam colados, sem direção nem hierarquia (skos:related, ont:0085)
  disjunta      A e B nunca são a mesma coisa (owl:disjointWith, ont:0086 4b) — homonímia ou exclusão

garantias (Z39.19 §5.3.5; caderno de ontologia 02/09):
  literaria     obra do acervo sustenta — exige --lastro (obra não expurgada)
  de-uso        pergunta feita ao motor sustenta (evento_recuperacao)
  instituida    dono ou cadeira afirma — não precisa de trecho (ont:0078)

regras que o plano aplica antes de gravar:
  - a coluna mais_amplo_id é o pai de navegação: repetir o mesmo pai/tipo é duplicata (409);
  - pai e lateral ao mesmo tempo é recusado para o par, nos dois sentidos (ont:0080 Aberto; SKOS S27);
  - conferências SQL rodam com a aresta dentro (ciclo, categoria, exclusividade, ciclo da coluna):
    qualquer linha NOVA reprova; HermiT roda com a aresta em memória e o diff de insatisfazíveis
    tem de ser vazio;
  - aresta cruzando domínio: lavra a cadeira do <de>, avisa a outra pela fila (mesa dados #22).
depois de --apply: o export ontologia/acervo/conceito_relacao.jsonl é regenerado no clone de
conhecimento — commit e push são da cadeira que lavrou.
"""

_PROJECAO_REL = "ontologia/projecao/gerar-e-raciocinar.py"


def _repo_conhecimento() -> str | None:
    """Clone de conhecimento em `main` onde o export ESCREVE — declarado em PF_CONHECIMENTO_DIR,
    sem default: verbo servido nao procura arvore de trabalho. Um clone parado em branch de
    fábrica NÃO serve (03/09: clone principal ficou em fabrica/2974)."""
    d = os.environ.get("PF_CONHECIMENTO_DIR")
    if not d or not os.path.isfile(os.path.join(d, _PROJECAO_REL)):
        return None
    try:
        br = subprocess.run(["git", "-C", d, "branch", "--show-current"], capture_output=True, text=True, check=False).stdout.strip()
    except OSError:
        br = ""
    return d if br == "main" else None


def _arvore_projecao() -> str | None:
    """Árvore de conhecimento de onde a projeção só LÊ: o clone declarado, se houver, senão a
    release no ar ($PLATAFIRMA_RELEASE/conhecimento)."""
    for d in (_repo_conhecimento(), str(release() / "conhecimento")):
        if d and os.path.isfile(os.path.join(d, _PROJECAO_REL)):
            return d
    return None


def _hermit(de: str, para: str, tipo: str) -> dict | None:
    """Projeção formal duas vezes (sem e com a aresta em memória) e diff de insatisfazíveis.
    Devolve None quando não dá para rodar (sem árvore de conhecimento, sem venv, script falhou)."""
    return _hermit_com(["--mais", f"{de}:{para}:{tipo}"])


def _hermit_renomear(velho: str, novo: str) -> dict | None:
    """O mesmo diff para a troca de slug (`--renomear VELHO:NOVO` do gerador, card #3239). O gerador no
    ar só aceita a opção depois do `release promover platafirma-conhecimento`; antes, volta `{"erro": …}`."""
    return _hermit_com(["--renomear", f"{velho}:{novo}"], renomeia=(velho, novo))


def _hermit_com(mudanca: list[str], renomeia: tuple[str, str] | None = None) -> dict | None:
    """Projeta a base e a base com `mudanca` (flags do gerador que a aplicam em memória) e compara.
    `renomeia` = (velho, novo): a classe insatisfazível que já existia volta com o nome novo (o IRI troca
    `.` por `_`), e não conta como insatisfazível nova da troca."""
    repo = _arvore_projecao()
    py = os.environ.get("PF_PROJECAO_PYTHON") or str(release() / "venv" / "acervo" / "bin" / "python")
    if not repo or not os.path.isfile(py):
        return None
    script = os.path.join(repo, _PROJECAO_REL)
    tmp = str(instancia() / "var" / "tmp" / "projecao")
    os.makedirs(tmp, exist_ok=True)

    def roda(extra, ttl):
        r = subprocess.run([py, script, "--json", "--ttl", ttl, *extra], capture_output=True, text=True, cwd=repo, check=False)
        if r.returncode:
            raise RuntimeError((r.stderr or r.stdout).strip()[-400:])
        return json.loads(r.stdout.strip().splitlines()[-1])
    try:
        base = roda([], os.path.join(tmp, "projecao-base.ttl"))
        com = roda(mudanca, os.path.join(tmp, "projecao-plano.ttl"))
    except (RuntimeError, ValueError, OSError) as e:
        return {"erro": str(e)}
    b, c = set(base["insatisfaziveis"]), set(com["insatisfaziveis"])
    if renomeia:
        velho_iri, novo_iri = (s.replace(".", "_") for s in renomeia)
        b = {novo_iri if nome == velho_iri else nome for nome in b}
    return {"antes": len(b), "depois": len(c), "novos": sorted(c - b), "saem": sorted(b - c),
            "triplas": (base["triplas"], com["triplas"]), "repo": repo}


def _exportar(repo: str) -> str | None:
    """Regenera ontologia/acervo/*.jsonl no clone (cli exportar-acervo). Devolve os arquivos
    alterados segundo o git, ou None se não deu para rodar."""
    # Delega a `acervo exportar` (bin/_acervo/exportar), dono unico do export: venv rag,
    # ambiente da ingestao (EMBED_MODEL, POSTGRES_*) e bancada da sessao. Chamar o cli direto
    # daqui falhava por venv e por ambiente (#3130, 27/09). `repo` fica so pela assinatura.
    acervo = os.path.join(os.path.dirname(os.path.realpath(__file__)), "acervo")
    if not os.access(acervo, os.X_OK):
        return None
    r = subprocess.run([acervo, "exportar"], capture_output=True, text=True, check=False)
    saida = (r.stdout + r.stderr).strip()
    if r.returncode:
        return f"acervo exportar falhou: {saida[-300:]}"
    i = saida.rfind("bancada:")
    return saida[i:] if i >= 0 else (saida[-300:] or "(export sem saida)")


def formatar_plano_relacao(p: dict, hermit: dict | None) -> str:
    a = p.get("aresta", {})
    seta = "<->" if a.get("simetrica") else "->"
    titulo = "Aresta aplicada" if p.get("modo") == "aplicado" else "Plano de aresta"
    cabeca = (f"{titulo}: {a.get('de')} -{a.get('tipo')}{seta} {a.get('para')}  "
              f"[{a.get('familia')}; garantia {a.get('garantia')}; curador {p.get('emitido_por')}]")
    lin = [cabeca]
    if a.get("ordem_canonica"):
        lin.append("  (simétrica: gravada em ordem canônica de uuid — de/para trocados, sem efeito)")
    lin.append(f"  motivo : {a.get('motivo')}")
    lin.append(f"  molde  : {p.get('molde')}")
    if p.get("lastro"):
        lin.append(f"  lastro : {p['lastro'].get('titulo')} ({p['lastro'].get('id')})")
    for nome, c in (p.get("conferencias") or {}).items():
        novas = c.get("novas") or []
        tag = "OK" if not novas else f"REPROVA +{len(novas)}"
        lin.append(f"  conferência {nome:<14} {c.get('antes')} -> {c.get('depois')}  {tag}")
        for r in novas[:5]:
            lin.append(f"      + {r}")
    if hermit is None:
        lin.append("  HermiT: indisponível (árvore de conhecimento na release ou em PF_CONHECIMENTO_DIR + venv acervo da release não achados)")
    elif hermit.get("erro"):
        lin.append(f"  HermiT: falhou — {hermit['erro']}")
    else:
        tag = "OK" if not hermit["novos"] else f"REPROVA +{len(hermit['novos'])}"
        lin.append(f"  HermiT insatisfazíveis {hermit['antes']} -> {hermit['depois']}  {tag}"
                   + (f"  novos: {', '.join(hermit['novos'])}" if hermit["novos"] else "")
                   + (f"  saem: {', '.join(hermit['saem'])}" if hermit["saem"] else ""))
    if p.get("modo") == "aplicado":
        lin.append(f"  id     : {p.get('id')}   (desfazer: curar --desrelacionar {p.get('id')})")
    else:
        lin.append(f"  veredito: {'APROVADO — repita com --apply para gravar' if p.get('aprovado') and not (hermit or {}).get('novos') and not (hermit or {}).get('erro') else 'REPROVADO — nada gravado'}")
    return "\n".join(lin)


def formatar_plano_conceito(p: dict) -> str:
    c = p.get("conceito", {})
    lin = [f"conceito : {c.get('slug')}  «{c.get('rotulo')}»",
           f"  natureza/estatuto: {c.get('natureza')} / {c.get('estatuto')}"]
    if c.get("mais_amplo"):
        lin.append(f"  pai      : {c.get('mais_amplo')}  ({c.get('mais_amplo_tipo')})")
    rots = c.get("rotulos", [])
    alt = [r for r in rots if r.get("papel") != "preferido"]
    if alt:
        lin.append("  rótulos  : +" + str(len(alt)) + " alt — " +
                   ", ".join(f"{r['rotulo']}[{r['lingua']}]" for r in alt))
    if c.get("trata_de"):
        lin.append(f"  trata_de : {len(c['trata_de'])} obra(s)")
    for nome, d in (p.get("conferencias") or {}).items():
        marca = "OK" if not d.get("novas") else f"REPROVOU +{len(d['novas'])}"
        lin.append(f"  conf {nome:<13}: {marca}")
    for nome, d in (p.get("avisos") or {}).items():
        if d.get("linhas"):
            lin.append(f"  aviso {nome:<12}: {d['linhas']} linha(s) (não bloqueia)")
    lin.append(f"  emitido_por: {p.get('emitido_por')}")
    if p.get("modo") == "aplicado":
        ver = f"GRAVADO — id {p.get('id')}"
    elif p.get("aprovado"):
        ver = "APROVADO — repita com --apply para gravar"
    else:
        ver = "REPROVADO — nada gravado"
    lin.append(f"  veredito : {ver}")
    return "\n".join(lin)


def acao_conceito(args, autor: str, como_json: bool, headers: dict) -> int:
    if args.renomear is not None:
        return acao_conceito_renomear(args, autor, como_json, headers)
    slug = args.conceito.strip()
    pai_slug = (getattr(args, "pai", None) or args.mais_amplo or "").strip()
    tipo = args.tipo or args.mais_amplo_tipo
    garantia = args.garantia
    motivo = args.motivo
    lastro = args.lastro

    # 1. Verifica se conceito já existe na API (GET .../relacoes -> 200 existe, 404 nao existe)
    url_rel = f"{BASE}/acervo/conceitos/{urllib.parse.quote(slug, safe='')}/relacoes"
    try:
        r_check = requests.get(url_rel, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if r_check.status_code >= 500:
        falha_indeterminavel(r_check)

    existe = (r_check.status_code == 200)

    if not existe:
        # POST /acervo/conceitos (criar)
        faltam = [k for k in ("rotulo", "definicao", "natureza", "estatuto") if not getattr(args, k)]
        if faltam:
            sys.stderr.write(f"curar: erro: criar conceito exige --{' --'.join(faltam)}\n")
            return 2
        if pai_slug:
            faltam_pai = []
            if not tipo:
                faltam_pai.append("tipo")
            if not garantia:
                faltam_pai.append("garantia")
            if not motivo:
                faltam_pai.append("motivo")
            if faltam_pai:
                sys.stderr.write(f"curar: erro: --pai exige --{' --'.join(faltam_pai)}\n")
                return 2

        corpo = {
            "slug": slug,
            "rotulo": args.rotulo,
            "definicao": args.definicao,
            "natureza": args.natureza,
            "estatuto": args.estatuto,
            "autor": autor,
        }
        if pai_slug:
            pai_dict = {
                "slug": pai_slug,
                "tipo": tipo,
                "garantia": garantia,
                "motivo": motivo,
            }
            if lastro:
                pai_dict["lastro"] = resolver_obra_id(lastro, headers)
            corpo["pai"] = pai_dict

        alts = []
        if getattr(args, "alt", None):
            for pedaco in args.alt.split(","):
                pedaco = pedaco.strip()
                if not pedaco:
                    continue
                if "@" in pedaco:
                    r, lg = pedaco.rsplit("@", 1)
                    alts.append({"rotulo": r.strip(), "lingua": lg.strip()})
                else:
                    alts.append({"rotulo": pedaco, "lingua": "pt"})
        if getattr(args, "rotulo_alt", None):
            for item in args.rotulo_alt:
                if "|" in item:
                    lg, r = item.split("|", 1)
                    alts.append({"rotulo": r.strip(), "lingua": lg.strip()})
                elif "@" in item:
                    r, lg = item.rsplit("@", 1)
                    alts.append({"rotulo": r.strip(), "lingua": lg.strip()})
                else:
                    alts.append({"rotulo": item.strip(), "lingua": "pt"})
        if alts:
            corpo["rotulos_alternativos"] = alts

        url_alvo = f"{BASE}/acervo/conceitos"
        metodo = "POST"
    else:
        # PATCH /acervo/conceitos/{id}/pai (trocar pai)
        if not pai_slug:
            sys.stderr.write("curar: erro: conceito já existe; use --pai para fixar ou trocar o pai de navegação\n")
            return 2
        faltam = []
        if not tipo:
            faltam.append("tipo")
        if not garantia:
            faltam.append("garantia")
        if not motivo:
            faltam.append("motivo")
        if faltam:
            sys.stderr.write(f"curar: erro: trocar pai exige --{' --'.join(faltam)}\n")
            return 2

        corpo = {
            "pai": pai_slug,
            "tipo": tipo,
            "garantia": garantia,
            "motivo": motivo,
            "autor": autor,
        }
        if lastro:
            corpo["lastro"] = resolver_obra_id(lastro, headers)

        url_alvo = f"{BASE}/acervo/conceitos/{urllib.parse.quote(slug, safe='')}/pai"
        metodo = "PATCH"

    def envia(aplicar: bool):
        try:
            payload = {**corpo, "aplicar": aplicar}
            if metodo == "POST":
                r = requests.post(url_alvo, json=payload, headers=headers)
            else:
                r = requests.patch(url_alvo, json=payload, headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if r.status_code >= 500:
            falha_indeterminavel(r)
        return r

    # 1. plano seco na API (validação + conferências SQL com a aresta dentro, sem gravar)
    resp = envia(False)
    if resp.status_code != 200:
        try:
            pj = resp.json()
        except ValueError:
            pj = {}
        if isinstance(pj, dict) and pj.get("plano"):
            print(formatar_plano_relacao(pj["plano"], None))
        falha_problem(resp)
    plano = resp.json()

    # 2. projeção formal com a aresta em memória
    aresta = plano.get("aresta") or {}
    if not args.sem_hermit and aresta.get("de") and aresta.get("para") and aresta.get("tipo"):
        hermit = _hermit(aresta["de"], aresta["para"], aresta["tipo"])
    else:
        hermit = None
    hermit_ok = args.sem_hermit or (hermit is not None and not hermit.get("erro") and not hermit.get("novos"))
    aprovado = bool(plano.get("aprovado")) and hermit_ok

    if not args.apply:
        if como_json:
            print(json.dumps({"plano": plano, "hermit": hermit, "aprovado": aprovado}, indent=2, ensure_ascii=False))
        else:
            print(formatar_plano_relacao(plano, hermit))
        return 0 if aprovado else 1

    if not aprovado:
        print(formatar_plano_relacao(plano, hermit))
        if not plano.get("aprovado"):
            sys.stderr.write("curar: conferência SQL reprovou; nada gravado\n")
        elif hermit is None or hermit.get("erro"):
            sys.stderr.write("curar: HermiT não rodou; para gravar mesmo assim passe --sem-hermit\n")
        else:
            sys.stderr.write("curar: HermiT reprovou (insatisfazíveis novos); nada gravado\n")
        return 1

    # 3. grava
    resp = envia(True)
    if resp.status_code not in (200, 201):
        falha_problem(resp)
    feito = resp.json()
    export = _exportar(hermit["repo"]) if hermit and hermit.get("repo") else (_exportar(_repo_conhecimento()) if _repo_conhecimento() else None)
    if como_json:
        print(json.dumps({"aplicado": feito, "hermit": hermit, "export": export}, indent=2, ensure_ascii=False))
    else:
        print(formatar_plano_relacao(feito, hermit))
        if export is None:
            print("  export : NÃO regenerado (clone de conhecimento em main / venv não achados) — rode `exportar-acervo` e commite")
        else:
            print(f"  export : regenerado no clone — commit e push são seus:\n    {export.replace(chr(10), chr(10) + '    ')}")
    return 0


# --- --conceito <slug> --renomear <slug-novo> (card #3239, cura K15) ------------------------------
# Irmão da troca de pai: plano seco por padrão, conferências, HermiT, --apply e export. O que a
# renomeação acrescenta é o que o card pede antes de gravar: a varredura de quem aponta para o slug
# velho (no banco, o servidor conta; fora do banco, este verbo procura o texto) e D7/D8 sobre o novo.

_VARREDURA_EXEMPLOS = 5
_VARREDURA_TIMEOUT_S = 60
# derivados do export, que o --apply regera (o jsonl) ou a regeração do vocabulário refaz: não são texto à mão
_VARREDURA_FORA = ("ontologia/acervo/", "rag/docs/ontologia/vocabulario.json")
_VARREDURA_SEM_RAIZ = ("venv", "terceiros")    # em release(): ambientes e artefato de terceiro, não repositório
_RENOMEAR_NAO_COMBINA = ("pai", "mais_amplo", "mais_amplo_tipo", "rotulo", "definicao", "natureza", "estatuto",
                         "alt", "rotulo_alt", "endereco", "lingua", "tipo", "garantia", "lastro",
                         "filhos_exclusivos")
# opções de OUTRO ato: a escada de despacho do `main` entregaria o pedido a esse ato e calaria o --renomear
_RENOMEAR_OUTROS_ATOS = ("reclassificar", "situacao", "expurgar", "restaurar", "espelhos", "apagar", "recortar",
                         "reextrair", "rejulgar", "lote", "ordem", "relatorio", "medida", "replicas", "bancada",
                         "refazer", "timeout_s", "modo", "metodo", "corte", "promover", "impressao", "relacionar",
                         "relacoes", "desrelacionar", "derivar", "derivacoes", "desderivar", "de", "registrar_obra",
                         "obra", "obras", "de_dominio", "de_subdominio", "de_conceito", "de_colecao", "sem_dominio",
                         "expurgadas", "trata_de", "remover_trata_de", "substituir_trata_de", "dominio", "subdominio",
                         "especie", "subtipo", "titulo", "id_canonico", "publicacao", "emitido_por", "anotacao",
                         "colecao")


def _renomear_incompativeis(args) -> list[str]:
    """As opções de criar conceito, de trocar o pai e de qualquer outro ato que vieram junto do --renomear."""
    return ["--" + n.replace("_", "-") for n in _RENOMEAR_NAO_COMBINA + _RENOMEAR_OUTROS_ATOS
            if getattr(args, n, None) not in (None, False)]


def _ere_escape(texto: str) -> str:
    return re.sub(r"([.\[\]()*+?{}|^$\\])", r"\\\1", texto)


def _padrao_do_slug(slug: str) -> str:
    """Palavra inteira de slug, em ERE: colada a letra, dígito ou hífen não vale (`tool` não é `tool-use`)."""
    return "(^|[^a-z0-9-])" + _ere_escape(slug) + "($|[^a-z0-9-])"


def _achados(saida: str, com_rev: bool) -> dict:
    """`grep -rn` (`./caminho:linha:texto`) ou `git grep -n <rev>` (`rev:caminho:linha:texto`): contagem e
    exemplos, sem o que mora em `ontologia/acervo/` (o export, que o --apply regera)."""
    arquivos, n_linhas, exemplos = set(), 0, []
    for ln in saida.splitlines():
        partes = ln.split(":", 3 if com_rev else 2)
        if com_rev:
            partes = partes[1:]
        if len(partes) < 2 or not partes[1].isdigit():
            continue
        caminho = partes[0][2:] if partes[0].startswith("./") else partes[0]
        if caminho.startswith(_VARREDURA_FORA):
            continue
        arquivos.add(caminho)
        n_linhas += 1
        if len(exemplos) < _VARREDURA_EXEMPLOS:
            exemplos.append(f"{caminho}:{partes[1]}")
    return {"arquivos": len(arquivos), "linhas": n_linhas, "exemplos": exemplos}


def _varredura_literal(slug: str, raiz=None, espelho=None) -> dict:
    """O texto que cita o slug velho pelo nome e NÃO segue a renomeação sozinho: palavra inteira nos
    repositórios servidos (um diretório por repositório em `release()`) e no espelho do suporte
    platafirma-casa (origin/main). Devolve {"repos": {nome: {arquivos, linhas, exemplos}}, "nao_varrido":
    {nome: motivo}}: o que não se conseguiu olhar fica dito e nunca vira «nenhuma ocorrência».
    `grep -m 20` põe teto por arquivo: `linhas` é piso em arquivo que o atinge."""
    raiz = raiz if raiz is not None else release()
    padrao = _padrao_do_slug(slug)
    repos, nao = {}, {}
    try:
        dirs = sorted(p for p in raiz.iterdir() if p.is_dir() and p.name not in _VARREDURA_SEM_RAIZ)
    except OSError as e:
        dirs = []
        nao[str(raiz)] = f"não li o diretório: {e.strerror or e}"
    for d in dirs:
        try:
            r = subprocess.run(
                ["grep", "-rIEn", "-m", "20", "--exclude-dir=.git", "--exclude-dir=node_modules",
                 "--exclude-dir=__pycache__", "-e", padrao, "."],
                cwd=str(d), capture_output=True, text=True, errors="replace",
                timeout=_VARREDURA_TIMEOUT_S, check=False)
        except subprocess.TimeoutExpired:
            nao[d.name] = f"passou de {_VARREDURA_TIMEOUT_S} s"
            continue
        except OSError as e:
            nao[d.name] = f"grep não rodou: {e.strerror or e}"
            continue
        if r.returncode not in (0, 1):
            nao[d.name] = f"grep saiu {r.returncode}: {(r.stderr or '').strip()[:100]}"
            continue
        achados = _achados(r.stdout, False)
        if achados["linhas"]:
            repos[d.name] = achados
    nome_casa = "platafirma-casa (espelho, origin/main)"
    esp = espelho if espelho is not None else (
        os.environ.get("PF_SUPORTE_ESPELHO") or str(instancia() / "var" / "acervo" / "suporte" / "platafirma-casa.git"))
    if not os.path.isdir(esp):
        nao[nome_casa] = f"espelho ausente ({esp})"
    else:
        try:
            r = subprocess.run(["git", "--git-dir", esp, "grep", "-InE", "-e", padrao, "origin/main", "--"],
                               capture_output=True, text=True, errors="replace",
                               timeout=_VARREDURA_TIMEOUT_S, check=False)
        except subprocess.TimeoutExpired:
            nao[nome_casa] = f"passou de {_VARREDURA_TIMEOUT_S} s"
        except OSError as e:
            nao[nome_casa] = f"git não rodou: {e.strerror or e}"
        else:
            if r.returncode not in (0, 1):
                nao[nome_casa] = f"git grep saiu {r.returncode}: {(r.stderr or '').strip()[:100]}"
            else:
                achados = _achados(r.stdout, True)
                if achados["linhas"]:
                    repos[nome_casa] = achados
    return {"repos": repos, "nao_varrido": nao}


def _conferir_slug(slug: str) -> dict:
    """D7 e D8 da lista antipadroes-do-acervo sobre o slug NOVO, pelos predicados do próprio lint
    (bin/_lint/acervo.py): a cura não pode gerar o slug que o lint acusa. Cada uma volta `ok`, `reprova` ou
    `indeterminavel` (o lint não carregou, ou a lista não se resolveu ou não traz o contraponto de D7)."""
    bin_dir = os.path.join(HARNESS_DIR, "bin")
    if bin_dir not in sys.path:
        sys.path.insert(0, bin_dir)
    try:
        from _lint import acervo as lint
    except Exception as e:  # noqa: BLE001 — sem o lint, nenhuma das duas se mede
        quebra = {"estado": "indeterminavel", "detalhe": f"lint indisponível ({type(e).__name__}: {e})"}
        return {"D7": dict(quebra), "D8": dict(quebra)}
    c = {"slug": slug}
    if lint.d8(c):
        achado = [x for x in ("-vs-", "-versus-", "-antes-de-", "-depois-de-") if x in slug]
        d8 = {"estado": "reprova", "detalhe": "slug contém " + ", ".join(f"`{x}`" for x in achado)}
    else:
        d8 = {"estado": "ok", "detalhe": ""}
    try:
        lista = lint.resolver_lista(lint.CHAVE_LISTA)
    except Exception:  # noqa: BLE001
        lista = None
    funcionais = lint.palavras_funcionais(lista.get("corpo", "")) if lista else None
    if not funcionais:
        d7 = {"estado": "indeterminavel",
              "detalhe": "a lista antipadroes-do-acervo não se resolveu ou não traz as palavras funcionais (Contrapontos)"}
    elif lint.d7(c, funcionais):
        fora_da_lista = {x.lower() for x in funcionais}
        fora = [p for p in slug.split("-") if p and p.lower() not in fora_da_lista]
        d7 = {"estado": "reprova",
              "detalhe": f"{len(fora)} partes fora das palavras funcionais ({', '.join(fora)}); o teto é três"}
    else:
        d7 = {"estado": "ok", "detalhe": ""}
    return {"D7": d7, "D8": d8}


def formatar_plano_renomear(p: dict, varredura: dict | None, conf_slug: dict | None, hermit: dict | None,
                            aprovado: bool) -> str:
    s = p.get("slug") or {}
    c = p.get("conceito") or {}
    titulo = "Renomeação aplicada" if p.get("modo") == "aplicado" else "Plano de renomeação"
    lin = [f"{titulo}: {s.get('de')} -> {s.get('para')}  [«{c.get('rotulo')}»; curador {p.get('emitido_por')}]",
           f"  slug: {s.get('de')} -> {s.get('para')}"]
    o = p.get("outros_rotulos") or {}
    if o.get("acrescenta"):
        lin.append(f"  outros_rotulos: + {o['acrescenta']}  (termo de entrada, língua {o.get('lingua')})")
    else:
        lin.append(f"  outros_rotulos: o slug velho já era rótulo do conceito ({o.get('ja_era')}); nada a acrescentar")
    f = p.get("ficha")
    if f:
        lin.append(f"  ficha na raiz : chave_humana {f['chave_humana']['de']} -> {f['chave_humana']['para']}; alias + {f['alias']}")
    else:
        lin.append("  ficha na raiz : o conceito não tem ficha em acervo.entidade; nada a mover")
    lin.append(f"  motivo : {p.get('motivo')}")
    v = p.get("varredura") or {}
    lin.append("  varredura de quem aponta, no banco (por id: segue o conceito, não muda)")
    lin.append(f"    relações em conceito_relacao : {v.get('relacoes')}")
    lin.append(f"    obras em obra_trata_de       : {v.get('obras')} (vivas {v.get('obras_vivas')})")
    lin.append(f"    filhos por mais_amplo_id     : {v.get('filhos')}")
    e = v.get("endereco") or {}
    lin.append(f"    endereço                     : {e.get('valor') or '—'}" + ("  (cita o slug velho)" if e.get("cita_o_slug") else ""))
    if varredura is not None:
        lin.append("  varredura do texto que cita o slug velho (fora do banco: não segue sozinho; sem os derivados do export)")
        repos = varredura.get("repos") or {}
        nao = varredura.get("nao_varrido") or {}
        for nome, a in repos.items():
            lin.append(f"    {nome}: {a['arquivos']} arquivo(s), {a['linhas']} linha(s) — {', '.join(a['exemplos'])}")
        for nome, motivo in nao.items():
            lin.append(f"    não varrido: {nome} ({motivo})")
        if not repos and not nao:
            lin.append("    nenhuma ocorrência")
    for nome, cs in (conf_slug or {}).items():
        marca = {"ok": "OK", "reprova": "REPROVA", "indeterminavel": "INDETERMINÁVEL"}[cs["estado"]]
        lin.append(f"  conferência {nome} (slug novo): {marca}" + (f" — {cs['detalhe']}" if cs.get("detalhe") else ""))
    for nome, cf in (p.get("conferencias") or {}).items():
        novas = cf.get("novas") or []
        tag = "OK" if not novas else f"REPROVA +{len(novas)}"
        lin.append(f"  conferência {nome:<14} {cf.get('antes')} -> {cf.get('depois')}  {tag}")
        for r in novas[:5]:
            lin.append(f"      + {r}")
    if hermit is None:
        lin.append("  HermiT: indisponível (árvore de conhecimento na release ou em PF_CONHECIMENTO_DIR + venv acervo da release não achados)")
    elif hermit.get("pulado"):
        lin.append("  HermiT: pulado (--sem-hermit)")
    elif hermit.get("naorodou"):
        lin.append("  HermiT: não rodou (a API recusou o plano antes)")
    elif hermit.get("erro"):
        lin.append(f"  HermiT: falhou — {hermit['erro']}")
    else:
        tag = "OK" if not hermit["novos"] else f"REPROVA +{len(hermit['novos'])}"
        lin.append(f"  HermiT insatisfazíveis {hermit['antes']} -> {hermit['depois']}  {tag}"
                   + (f"  novos: {', '.join(hermit['novos'])}" if hermit["novos"] else "")
                   + (f"  saem: {', '.join(hermit['saem'])}" if hermit["saem"] else ""))
    if p.get("modo") == "aplicado":
        lin.append(f"  id     : {p.get('id')}   (o id do conceito não muda)")
    else:
        lin.append("  veredito: " + ("APROVADO — repita com --apply para gravar" if aprovado else "REPROVADO — nada gravado"))
    return "\n".join(lin)


def acao_conceito_renomear(args, autor: str, como_json: bool, headers: dict) -> int:
    velho = args.conceito.strip()
    novo = (args.renomear or "").strip()
    if not novo:
        sys.stderr.write("curar: erro: --renomear exige o slug novo\n")
        return 2
    if not args.motivo or not args.motivo.strip():
        sys.stderr.write("curar: erro: renomear exige --motivo\n")
        return 2
    # a combinação com opção de outro ato já foi recusada no `main`, antes da escada de despacho

    url = f"{BASE}/acervo/conceitos/{urllib.parse.quote(velho, safe='')}"
    corpo = {"slug": novo, "motivo": args.motivo.strip(), "autor": autor}

    def envia(aplicar: bool):
        try:
            r = requests.patch(url, json={**corpo, "aplicar": aplicar}, headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if r.status_code >= 500:
            falha_indeterminavel(r)
        return r

    # 1. plano seco na API: valida (404 ConceitoNaoEncontrado, 409 ConceitoDuplicado, 422), conta quem aponta
    #    e roda as conferências SQL com o slug novo dentro, sem gravar
    resp = envia(False)
    if resp.status_code != 200:
        try:
            pj = resp.json()
        except ValueError:
            pj = {}
        if isinstance(pj, dict) and pj.get("plano"):
            print(formatar_plano_renomear(pj["plano"], None, None, {"naorodou": True}, False))
        falha_problem(resp)
    plano = resp.json()

    # 2. o que é do cliente: forma do slug novo (D7, D8), o texto que cita o velho, o HermiT
    conf_slug = _conferir_slug(novo)
    varredura = _varredura_literal(velho)
    hermit = {"pulado": True} if args.sem_hermit else _hermit_renomear(velho, novo)
    hermit_ok = hermit is not None and (bool(hermit.get("pulado")) or (not hermit.get("erro") and not hermit.get("novos")))
    forma_ok = all(cs["estado"] == "ok" for cs in conf_slug.values())
    aprovado = bool(plano.get("aprovado")) and forma_ok and hermit_ok

    if not args.apply:
        if como_json:
            print(json.dumps({"plano": plano, "conferencia_slug": conf_slug, "varredura_texto": varredura,
                              "hermit": hermit, "aprovado": aprovado}, indent=2, ensure_ascii=False))
        else:
            print(formatar_plano_renomear(plano, varredura, conf_slug, hermit, aprovado))
        return 0 if aprovado else 1

    if not aprovado:
        if como_json:
            print(json.dumps({"plano": plano, "conferencia_slug": conf_slug, "varredura_texto": varredura,
                              "hermit": hermit, "aprovado": False}, indent=2, ensure_ascii=False))
        else:
            print(formatar_plano_renomear(plano, varredura, conf_slug, hermit, aprovado))
        if not plano.get("aprovado"):
            sys.stderr.write("curar: conferência SQL reprovou; nada gravado\n")
        elif not forma_ok:
            sys.stderr.write("curar: a forma do slug novo reprova (D7/D8) ou não se mediu; nada gravado\n")
        elif hermit is None or hermit.get("erro"):
            sys.stderr.write("curar: HermiT não rodou; para gravar mesmo assim passe --sem-hermit\n")
        else:
            sys.stderr.write("curar: HermiT reprovou (insatisfazíveis novos); nada gravado\n")
        return 1

    # 3. grava
    resp = envia(True)
    if resp.status_code != 200:
        falha_problem(resp)
    feito = resp.json()
    repo_conh = hermit.get("repo") if isinstance(hermit, dict) else None
    # `_exportar` delega a `acervo exportar` (o repo fica só pela assinatura): roda sempre, com ou sem clone declarado
    export = _exportar(repo_conh or _repo_conhecimento() or "")
    export_ok = export is not None and not export.startswith("acervo exportar falhou")
    if como_json:
        print(json.dumps({"aplicado": feito, "conferencia_slug": conf_slug, "varredura_texto": varredura,
                          "hermit": hermit, "export": export, "export_ok": export_ok}, indent=2, ensure_ascii=False))
    else:
        print(formatar_plano_renomear(feito, varredura, conf_slug, hermit, True))
        if export_ok:
            print(f"  export : regenerado no clone — commit e push são seus:\n    {export.replace(chr(10), chr(10) + '    ')}")
        else:
            print(f"  export : NÃO regenerado ({export or '`acervo exportar` não achado'}) — o slug JÁ foi renomeado: "
                  "não repita o --apply; rode `acervo exportar` e commite")
    return 0 if export_ok else 1


def acao_relacionar(args, autor: str, como_json: bool, headers: dict) -> int:
    pos = args.relacionar or []
    if args.ajuda or not pos:
        print(CARTILHA)
        return 0 if args.ajuda else 2
    if len(pos) != 2:
        sys.stderr.write("curar: erro: --relacionar espera exatamente <de> <para>\n")
        return 2
    faltam = [k for k in ("tipo", "garantia", "motivo") if not getattr(args, k)]
    if faltam:
        sys.stderr.write(f"curar: erro: --relacionar exige --{' --'.join(faltam)} (veja --relacionar --help)\n")
        return 2
    de, para = pos
    corpo = {"de": de, "para": para, "tipo": args.tipo, "garantia": args.garantia, "motivo": args.motivo, "autor": autor}
    if args.lastro:
        corpo["lastro"] = resolver_obra_id(args.lastro, headers)

    def post(aplicar: bool):
        try:
            r = requests.post(f"{BASE}/acervo/conceitos/relacoes", json={**corpo, "aplicar": aplicar}, headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if r.status_code >= 500:
            falha_indeterminavel(r)
        return r

    # 1. plano seco na API (validação + conferências SQL com a aresta dentro, sem gravar)
    resp = post(False)
    if resp.status_code != 200:
        try:
            pj = resp.json()
        except ValueError:
            pj = {}
        if isinstance(pj, dict) and pj.get("plano"):
            print(formatar_plano_relacao(pj["plano"], None))
        falha_problem(resp)
    plano = resp.json()

    # 2. projeção formal com a aresta em memória
    hermit = None if args.sem_hermit else _hermit(plano["aresta"]["de"], plano["aresta"]["para"], plano["aresta"]["tipo"])
    hermit_ok = args.sem_hermit or (hermit is not None and not hermit.get("erro") and not hermit["novos"])
    aprovado = bool(plano.get("aprovado")) and hermit_ok

    if not args.apply:
        if como_json:
            print(json.dumps({"plano": plano, "hermit": hermit, "aprovado": aprovado}, indent=2, ensure_ascii=False))
        else:
            print(formatar_plano_relacao(plano, hermit))
        return 0 if aprovado else 1

    if not aprovado:
        print(formatar_plano_relacao(plano, hermit))
        if not plano.get("aprovado"):
            sys.stderr.write("curar: conferência SQL reprovou; nada gravado\n")
        elif hermit is None or hermit.get("erro"):
            sys.stderr.write("curar: HermiT não rodou; para gravar mesmo assim passe --sem-hermit\n")
        else:
            sys.stderr.write("curar: HermiT reprovou (insatisfazíveis novos); nada gravado\n")
        return 1

    # 3. grava
    resp = post(True)
    if resp.status_code != 201:
        falha_problem(resp)
    feito = resp.json()
    export = _exportar(hermit["repo"]) if hermit and hermit.get("repo") else (_exportar(_repo_conhecimento()) if _repo_conhecimento() else None)
    if como_json:
        print(json.dumps({"aplicado": feito, "hermit": hermit, "export": export}, indent=2, ensure_ascii=False))
    else:
        print(formatar_plano_relacao(feito, hermit))
        if export is None:
            print("  export : NÃO regenerado (clone de conhecimento em main / venv não achados) — rode `exportar-acervo` e commite")
        else:
            print(f"  export : regenerado no clone — commit e push são seus:\n    {export.replace(chr(10), chr(10) + '    ')}")
    return 0


def acao_relacoes(conceito: str, como_json: bool, headers: dict) -> int:
    url = f"{BASE}/acervo/conceitos/{urllib.parse.quote(conceito, safe='')}/relacoes"
    try:
        resp = requests.get(url, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    itens = data.get("itens", [])
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    print(f"Arestas de {conceito}: {len(itens)}")
    for a in itens:
        seta = "->" if a.get("direcao") == "saida" else "<-"
        origem = a.get("origem") or "coluna"
        extra = f"  [{a.get('garantia')}] {a.get('motivo')}" if a.get("motivo") else ""
        idt = f"  id {a['id']}" if a.get("id") else ""
        print(f"  {seta} {a.get('conceito'):<36} {a.get('tipo'):<13} {a.get('papel'):<15} {origem}{extra}{idt}")
    return 0


def acao_desrelacionar(relacao_id: str, autor: str, como_json: bool, headers: dict, confirmado: bool = False) -> int:
    if not _UUID_RE.match(relacao_id.strip()):
        sys.stderr.write("curar: erro: --desrelacionar espera o uuid da aresta (veja --relacoes <conceito>)\n")
        return 2
    if not confirmado:
        try:
            ans = input(f"Desfazer a aresta {relacao_id}? digite 'sim' para confirmar: ")
        except EOFError:
            ans = ""
        if ans.strip().lower() != "sim":
            print("cancelado")
            return 1
    url = f"{BASE}/acervo/conceitos/relacoes/{relacao_id.strip()}?autor={urllib.parse.quote(autor)}"
    try:
        resp = requests.delete(url, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    repo = _repo_conhecimento()
    export = _exportar(repo) if repo else None
    if como_json:
        print(json.dumps({**data, "export": export}, indent=2, ensure_ascii=False))
    else:
        d = data.get("desfeita", {})
        print(f"Aresta desfeita: {d.get('de')} -{d.get('tipo')}-> {d.get('para')} [{d.get('garantia')}] ({d.get('id')})")
        print("  export : " + (export.replace(chr(10), chr(10) + '    ') if export else "NÃO regenerado — rode `exportar-acervo` e commite"))
    return 0


def acao_reclassificar(args, autor: str, como_json: bool, headers: dict) -> int:
    alteracao = {}
    if args.dominio is not None:
        alteracao["dominio"] = None if args.dominio.lower() in ("null", "none", "") else args.dominio
    if args.subdominio is not None:
        alteracao["subdominio"] = None if args.subdominio.lower() in ("null", "none", "") else args.subdominio
    if args.especie is not None:
        alteracao["especie"] = None if args.especie.lower() in ("null", "none", "") else args.especie
    if args.subtipo is not None:
        alteracao["subtipo"] = None if args.subtipo.lower() in ("null", "none", "") else args.subtipo
    if args.anotacao is not None:
        alteracao["anotacao"] = args.anotacao
    if args.titulo is not None:
        alteracao["titulo"] = args.titulo
    if args.id_canonico is not None:
        alteracao["id_canonico"] = None if args.id_canonico.lower() in ("null", "none", "") else args.id_canonico
    if args.publicacao is not None:
        alteracao["publicacao"] = None if args.publicacao.lower() in ("null", "none", "") else args.publicacao
    if args.emitido_por is not None:
        # emissor tem espaço no nome ("Conseil constitutionnel"): separa só por ';'
        alteracao["emitido_por"] = [p.strip() for p in args.emitido_por.split(";") if p.strip()]

    trata_de = _parse_lista(args.trata_de) if args.trata_de else []
    remover_trata_de = _parse_lista(args.remover_trata_de) if args.remover_trata_de else []
    substituir_trata_de = _parse_lista(args.substituir_trata_de) if args.substituir_trata_de else []

    cont_delta = sum(bool(x) for x in (trata_de, remover_trata_de, substituir_trata_de))
    if cont_delta > 1:
        sys.stderr.write("curar: erro: use apenas uma das opções de conceitos: --trata-de, --remover-trata-de ou --substituir-trata-de\n")
        sys.exit(2)
    elif trata_de:
        alteracao["conceitos"] = {"adicionar": trata_de}
    elif remover_trata_de:
        alteracao["conceitos"] = {"remover": remover_trata_de}
    elif substituir_trata_de:
        alteracao["conceitos"] = {"substituir": substituir_trata_de}

    if args.obra:
        obra_id = resolver_obra_id(args.obra, headers)
        if not alteracao:
            sys.stderr.write("curar: erro: nenhuma alteração informada (--titulo, --especie, --id-canonico, etc.)\n")
            sys.exit(2)
        if not args.apply:
            # titulo e id_canonico não cabem na rota de lote (patch_obras_lote recusa os dois;
            # a rota da obra aceita). O plano deles é o valor lido da obra contra o pedido; o
            # resto da alteração passa pelo plano do servidor, que valida slug e hierarquia (#3160).
            locais = {k: alteracao[k] for k in ("titulo", "id_canonico") if k in alteracao}
            resto = {k: v for k, v in alteracao.items() if k not in locais}
            data = {"modo": "plano", "n": 1, "proximo": None,
                    "itens": [{"obra_id": obra_id, "titulo": None, "antes": {}, "depois": {}}]}
            if resto:
                payload = {
                    "autor": autor,
                    "selecao": {"ids": [obra_id]},
                    "alteracao": resto,
                    "modo": "plano",
                    "teto": args.teto,
                }
                try:
                    resp = requests.patch(f"{BASE}/acervo/obras", json=payload, headers=headers)
                except requests.exceptions.RequestException as e:
                    falha_indeterminavel(e)
                if resp.status_code >= 500:
                    falha_indeterminavel(resp)
                if resp.status_code != 200:
                    falha_problem(resp)
                data = resp.json()
            if locais:
                try:
                    resp = requests.get(f"{BASE}/acervo/obras/{obra_id}", headers=headers)
                except requests.exceptions.RequestException as e:
                    falha_indeterminavel(e)
                if resp.status_code >= 500:
                    falha_indeterminavel(resp)
                if resp.status_code != 200:
                    falha_problem(resp)
                atual = resp.json()
                item = data["itens"][0]
                item["titulo"] = item.get("titulo") or atual.get("titulo")
                for k, v in locais.items():
                    item.setdefault("antes", {})[k] = atual.get(k)
                    item.setdefault("depois", {})[k] = v
            if como_json:
                print(json.dumps(data, indent=2, ensure_ascii=False))
            else:
                print(formatar_lote_resultado(data))
            return 0
        else:
            url = f"{BASE}/acervo/obras/{obra_id}"
            payload = {
                "autor": autor,
                **alteracao,
            }
            try:
                resp = requests.patch(url, json=payload, headers=headers)
            except requests.exceptions.RequestException as e:
                falha_indeterminavel(e)
            if resp.status_code >= 500:
                falha_indeterminavel(resp)
            if resp.status_code != 200:
                falha_problem(resp)
            data = resp.json()
            if como_json:
                print(json.dumps(data, indent=2, ensure_ascii=False))
            else:
                print(f"Obra {obra_id} reclassificada com sucesso:")
                print(f"  Título     : {data.get('titulo')}")
                print(f"  Domínio    : {data.get('dominio')} / {data.get('subdominio')}")
                print(f"  Espécie    : {data.get('especie')}")
                print(f"  Emitido por: {'; '.join(data.get('emitido_por') or [])}")
                print(f"  Publicação : {data.get('publicacao')} · id canônico: {data.get('id_canonico')}")
                print(f"  Conceitos  : {', '.join(data.get('conceitos', []))}")
            return 0

    selecao = {}
    obras_lista = _parse_lista(args.obras) if args.obras else []
    if obras_lista:
        resolved_ids = [resolver_obra_id(x, headers) for x in obras_lista]
        selecao["ids"] = resolved_ids
    elif args.de_dominio:
        selecao["dominio"] = args.de_dominio
        if args.de_subdominio:
            selecao["subdominio"] = args.de_subdominio
    elif args.de_conceito:
        selecao["conceito"] = args.de_conceito
    elif args.de_colecao:
        selecao["colecao"] = args.de_colecao
    elif args.sem_dominio:
        selecao["sem_dominio"] = True
    elif args.expurgadas:
        selecao["expurgadas"] = True
    else:
        sys.stderr.write("curar: erro: reclassificação exige seleção (--obras, --de-dominio, etc.) ou --obra\n")
        sys.exit(2)

    if not alteracao:
        sys.stderr.write("curar: erro: nenhuma alteração informada (--trata-de, --dominio, --subdominio, etc.)\n")
        sys.exit(2)

    modo = "aplicar" if args.apply else "plano"
    payload = {
        "autor": autor,
        "selecao": selecao,
        "alteracao": alteracao,
        "modo": modo,
        "teto": args.teto,
    }
    url = f"{BASE}/acervo/obras"
    try:
        resp = requests.patch(url, json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        print(formatar_lote_resultado(data))
    return 0


def _chamar(metodo: str, url: str, headers: dict, payload: dict | None = None, ok=(200,)) -> dict:
    try:
        resp = requests.request(metodo, url, json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code not in ok:
        falha_problem(resp)
    return resp.json()


def acao_derivar(args, autor: str, como_json: bool, headers: dict) -> int:
    """ont:0092 §2: declara que a obra deriva da origem. Plano seco sem --apply (#3160)."""
    if not args.de:
        sys.stderr.write("curar: erro: --derivar exige --de <obra de origem> (uuid ou título exato)\n")
        return 2
    obra_id = resolver_obra_id(args.derivar, headers)
    origem_id = resolver_obra_id(args.de, headers)
    payload = {"autor": autor, "origem": origem_id, "motivo": args.motivo,
               "modo": "aplicar" if args.apply else "plano"}
    data = _chamar("POST", f"{BASE}/acervo/obras/{obra_id}/derivacoes", headers, payload)
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    o, g = data.get("obra", {}), data.get("origem", {})
    titulo = "Derivação aplicada" if data.get("modo") == "aplicado" else "Plano de derivação"
    print(f"{titulo}: {o.get('titulo')} ({o.get('id')})")
    print(f"  deriva de : {g.get('titulo')} ({g.get('id')})" + ("  [não adquirida]" if g.get("nao_adquirida") else ""))
    if data.get("motivo"):
        print(f"  motivo    : {data['motivo']}")
    if data.get("ja_existia"):
        print("  já estava declarada: nada a gravar")
    elif data.get("modo") != "aplicado":
        print("  (plano seco — repita com --apply para gravar)")
    return 0


def acao_derivacoes(obra: str, como_json: bool, headers: dict) -> int:
    obra_id = resolver_obra_id(obra, headers)
    data = _chamar("GET", f"{BASE}/acervo/obras/{obra_id}/derivacoes", headers)
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    o = data.get("obra", {})
    print(f"Derivações de {o.get('titulo')} ({o.get('id')})")
    origens = data.get("origens", [])
    print(f"  deriva de ({len(origens)}):")
    for g in origens:
        marca = "  [não adquirida]" if g.get("nao_adquirida") else ""
        print(f"    {g.get('titulo')} ({g.get('id')}){marca}")
    derivadas = data.get("derivadas", [])
    print(f"  origina ({len(derivadas)}):")
    for d in derivadas:
        print(f"    {d.get('titulo')} ({d.get('id')})")
    return 0


def acao_desderivar(args, autor: str, como_json: bool, headers: dict) -> int:
    if not args.de:
        sys.stderr.write("curar: erro: --desderivar exige --de <obra de origem>\n")
        return 2
    obra_id = resolver_obra_id(args.desderivar, headers)
    origem_id = resolver_obra_id(args.de, headers)
    if not args.confirmado:
        try:
            ans = input(f"Desfazer a derivação {obra_id} <- {origem_id}? digite 'sim' para confirmar: ")
        except EOFError:
            ans = ""
        if ans.strip().lower() != "sim":
            print("cancelado")
            return 1
    url = f"{BASE}/acervo/obras/{obra_id}/derivacoes/{origem_id}?autor={urllib.parse.quote(autor)}"
    data = _chamar("DELETE", url, headers)
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        d = data.get("desfeita", {})
        print(f"Derivação desfeita: {d.get('obra', {}).get('titulo')} <- {d.get('origem', {}).get('titulo')}")
    return 0


def acao_registrar_obra(args, autor: str, como_json: bool, headers: dict) -> int:
    """Registra obra sem suporte (não adquirida, ont:0073 §9) pela regra de casamento (§7)."""
    payload = {
        "autor": autor,
        "titulo": args.registrar_obra,
        "colecao": args.colecao or "firma",
        "especie": args.especie,
        "emitido_por": [p.strip() for p in (args.emitido_por or "").split(";") if p.strip()],
        "id_canonico": args.id_canonico,
        "publicacao": args.publicacao,
        "modo": "aplicar" if args.apply else "plano",
    }
    data = _chamar("POST", f"{BASE}/acervo/obras", headers, payload, ok=(200, 201))
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    if data.get("casou"):
        c = data["casou"]
        print(f"Já existe: {c.get('titulo')} ({c.get('id')}), casou pelo degrau {c.get('degrau')} — nada a gravar")
        return 0
    p = data.get("proposta", {})
    if data.get("criada"):
        print(f"Obra não adquirida registrada: {p.get('titulo')} ({data['criada'].get('id')})")
    else:
        print(f"Plano de registro: {p.get('titulo')}  [não adquirida, coleção {p.get('colecao')}]")
    print(f"  espécie    : {p.get('especie')}")
    print(f"  emitido por: {'; '.join(p.get('emitido_por') or [])}")
    print(f"  id canônico: {p.get('id_canonico')} · publicação: {p.get('publicacao')}")
    if not data.get("criada"):
        print("  (plano seco — repita com --apply para gravar)")
    return 0


# --- atos sobre o espelho de leitura (spec espelho-de-leitura §6.3, §9, §10; card #3180) ------


def _linha_espelho(e: dict | None) -> str:
    if not e:
        return "(sem espelho)"
    enc = e.get("encoding") or {}
    conv = e.get("conversor") or {}
    motivo = e.get("motivo")
    if isinstance(motivo, (list, tuple)):  # o veredito da régua 2 traz o motivo em lista (#3193)
        motivo = "; ".join(str(m) for m in motivo if m)
    return (f"{conv.get('nome', '?')}@{conv.get('versao', '?')} · digest {str(e.get('digest'))[:12]} · "
            f"{enc.get('decidido', '?')} ({enc.get('por', '?')}) · substituições {e.get('substituicoes')} · "
            f"{e.get('julgamento') or 'não julgado'}" + (f" ({motivo})" if motivo else ""))


def acao_recortar(args, autor: str, como_json: bool, headers: dict) -> int:
    """Impressão nova sobre o MESMO espelho, sem tocar o balde (§6.3). Plano seco sem --apply."""
    obra_id = resolver_obra_id(args.recortar, headers)
    payload = {"autor": autor, "aplicar": args.apply, "corte": args.corte}
    data = _chamar("POST", f"{BASE}/acervo/obras/{obra_id}/recortes", headers, payload)
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    titulo = "Recorte aplicado" if data.get("modo") == "aplicado" else "Plano de recorte"
    print(f"{titulo}: {data.get('titulo')} ({data.get('obra_id')})")
    print(f"  espelho   : {data.get('espelho')} (o mesmo; balde intocado)")
    print(f"  corte     : {data.get('corte_atual')} -> {data.get('corte_alvo')} · "
          f"{data.get('trechos')} trecho(s) em {data.get('secoes')} seção(ões)")
    if data.get("modo") == "aplicado":
        _linhas_selada(data, data.get("impressao_atual"))
    else:
        print(f"  impressão : {data.get('impressao_atual')} (servindo)")
        print("  (plano seco — repita com --apply para gravar)")
    return 0


def _linhas_selada(data: dict, servindo: str | None) -> None:
    """Recortar e reextrair terminam na impressão selada (arq:0119 §5, #3193): a anterior segue
    servindo até o `--promover`, que a resposta traz pronto."""
    print(f"  impressão : {data.get('impressao_nova')} selada" + (" (já existia)" if data.get("ja_selada") else "")
          + (f"; {servindo} segue servindo" if servindo else ""))
    if data.get("promover"):
        print(f"  promover  : {data['promover']}")


def _linhas_portoes(relatorio: dict | None) -> list[str]:
    """Os portões do relatório, todos (spec espelho-de-leitura §4.1 passo 7): o reprovado primeiro."""
    portoes = (relatorio or {}).get("portoes") or []
    linhas = []
    for p in sorted(portoes, key=lambda p: bool(p.get("ok"))):
        marca = "ok" if p.get("ok") else ("REPROVA" if p.get("bloqueante", True) else "aviso")
        causa = f"  {p['causa']}" if p.get("causa") else ""
        criterio = f" [{p['criterio']}]" if p.get("criterio") else ""
        linhas.append(f"    {marca:<8}{p.get('portao')}{criterio}{causa}")
    return linhas


def acao_reextrair(args, autor: str, como_json: bool, headers: dict) -> int:
    """Espelho novo do próprio arquivo e impressão nova sobre ele (§9 caso 2; com o digest de
    um espelho atestado, regenera sob a mesma chave, §10.1). Plano seco sem --apply."""
    obra_id = resolver_obra_id(args.reextrair, headers)
    # sem --metodo, o servidor usa o padrão do tipo real (spec §4.3; `acervo listar biblioteca metodos`)
    payload = {"autor": autor, "aplicar": args.apply, "metodo": args.metodo or None, "corte": args.corte}
    try:
        resp = requests.post(f"{BASE}/acervo/obras/{obra_id}/reextracoes", json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code == 422:
        try:
            problema = resp.json()
        except ValueError:
            problema = {}
        if problema.get("title") == "ReextracaoReprovada":
            # §4.1 passo 7: nada se sela, e o relatório traz todos os portões, não só o primeiro
            if como_json:
                print(json.dumps(problema, indent=2, ensure_ascii=False))
            else:
                print(f"Reextração reprovada: {obra_id}")
                print(f"  causa     : {problema.get('detail')}")
                linhas = _linhas_portoes(problema.get("relatorio"))
                if linhas:
                    print("  portões   :")
                    print("\n".join(linhas))
                print("  nada selado; a impressão que servia segue servindo")
            return 1
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    aplicado = data.get("modo") == "aplicado"
    print(f"{'Reextração aplicada' if aplicado else 'Plano de reextração'}: {data.get('titulo')} ({data.get('obra_id')})")
    print(f"  objeto    : {data.get('objeto')}")
    print(f"  método    : {data.get('metodo') or data.get('metodo_alvo')}"
          + (" (regenerar sob a mesma chave)" if data.get("regenerar") else ""))
    print(f"  espelho   : atual {data.get('espelho_atual') or '(nenhum)'}")
    if aplicado:
        print(f"  novo      : {_linha_espelho(data.get('espelho'))}" + ("  [já existia]" if data.get("ja_existia") else ""))
        if data.get("trechos") is not None:
            print(f"  trechos   : {data.get('trechos')}")
        _linhas_selada(data, data.get("impressao_atual"))
    else:
        print("  (plano seco — repita com --apply para gravar)")
    return 0


def acao_espelhos(ato: str, obra: str | None, autor: str, aplicar: bool, como_json: bool, headers: dict) -> int:
    """`--expurgar --espelhos` e `--restaurar --espelhos` (§10.2). Plano seco sem --apply."""
    payload = {"autor": autor, "aplicar": aplicar}
    if obra:
        payload["obra"] = resolver_obra_id(obra, headers)
    rota = "expurgo" if ato == "expurgar" else "restauro"
    data = _chamar("POST", f"{BASE}/acervo/espelhos/{rota}", headers, payload)
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    verbo = "expurgado(s)" if ato == "expurgar" else "restaurado(s)"
    cabeca = f"{data.get('n', 0)} espelho(s) {verbo}" if data.get("modo") == "aplicado" else \
        f"Plano: {data.get('n', 0)} espelho(s) a {ato}"
    if ato == "expurgar":
        cabeca += f" (impressões todas aposentadas há mais de {data.get('prazo_dias', 90)} dias)"
    print(cabeca)
    for it in data.get("itens", []):
        extra = ""
        if ato == "expurgar":
            extra = f"  aposentada em {it.get('aposentada_em')} · regenerável {'sim' if it.get('regeneravel') else 'não'}"
        print(f"  {it.get('bucket')}/espelho/{str(it.get('fonte_versao')).split(':')[-1][:12]}…/{str(it.get('digest'))[:12]}{extra}")
    if data.get("modo") != "aplicado":
        print("  (plano seco — repita com --apply para gravar)")
    return 0


# --- régua nova e lote de reextração (spec espelho-de-leitura §4.2, §9 caso 8; card #3193) ------


_LOTE_LINHAS = 40   # obras que o plano do lote mostra em texto; --json traz todas


def _mib(n) -> str:
    return "-" if n is None else f"{n / 1048576:.1f} MiB"


def acao_rejulgar(autor: str, aplicar: bool, como_json: bool, headers: dict) -> int:
    """`--rejulgar --lote`: os espelhos com veredito de régua anterior à vigente. Plano lista; --apply
    recalcula o veredito de cada um, sem reconverter (§9 caso 8). Depois do --apply, o plano volta vazio."""
    data = _chamar("POST", f"{BASE}/acervo/espelhos/rejulgamento", headers, {"autor": autor, "aplicar": aplicar})
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    regua = data.get("regua")
    if data.get("modo") == "aplicado":
        # régua 6 (#3282): a contagem servível / servível imperfeito / não servível vai ao card
        contagem = data.get("contagem") or {}
        resumo = ", ".join(f"{contagem.get(k, 0)} {k}" for k in ("servível", "servível imperfeito", "não servível"))
        print(f"{data.get('n', 0)} espelho(s) rejulgado(s) pela régua {regua}: {resumo}")
    else:
        print(f"Plano: {data.get('n', 0)} espelho(s) com régua anterior à {regua}")
    for it in data.get("itens", []):
        depois = ""
        if "julgamento" in it:
            motivo = "; ".join(map(str, it.get("motivo") or []))
            depois = f" -> {it['julgamento']}" + (f" ({motivo})" if motivo else "")
        print(f"  {it.get('impressao')}  {it.get('estado'):<13} régua {it.get('regua_atual')} "
              f"{it.get('julgamento_atual')}{depois}  {it.get('titulo')}")
    for it in data.get("falhas", []):
        print(f"  FALHOU {it.get('impressao')}  {it.get('titulo')}: {it.get('erro')}")
    if data.get("modo") != "aplicado":
        print("  (plano seco — repita com --apply para gravar)")
    return 1 if data.get("falhas") else 0


def acao_reextrair_lote(args, autor: str, como_json: bool, headers: dict) -> int:
    """`--reextrair --lote`: o plano é o PORTÃO 1 (a contagem por tipo, §4.2 item 1); --apply abre o lote,
    que roda na API obra a obra e para na selada (§4.2 item 5). O verbo volta em segundos com o id."""
    ordem = _bancada_lista(args.ordem) if args.ordem else []
    payload = {"autor": autor, "aplicar": args.apply, "metodo": args.metodo or None, "ordem": ordem,
               "corte": args.corte}
    if args.medida or args.replicas is not None:
        # #3228 passo 2: a medida roda só a lista dada, em até <n> réplicas, e não grava no acervo
        if not args.medida or not ordem:
            sys.stderr.write("curar: erro: --medida vai com --replicas <n> e --ordem <lista>; --replicas só com --medida\n")
            return 2
        payload.update(medida=True, replicas=args.replicas)
    data = _chamar("POST", f"{BASE}/acervo/reextracoes/lote", headers, payload)
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    aplicado = data.get("modo") == "aplicado"
    metodo = data.get("metodo") or "o padrão de cada tipo"
    print(f"{'Lote aberto' if aplicado else 'PORTÃO 1 — plano do lote de reextração'}: {data.get('n', 0)} obra(s) "
          f"· método {metodo} · corte {data.get('corte')}")
    for t in data.get("totais", []):
        print(f"  {t.get('tipo'):<10} {t.get('n'):>5} obra(s)  {_mib(t.get('bytes'))}")
    fora = data.get("fora_do_lote") or {}
    if fora:
        print("  fora do lote (marcação inteira, §4.3): " + ", ".join(f"{k} {v}" for k, v in fora.items()))
    print(f"  inteiras: {data.get('inteiras', 0)} · em dia: {data.get('em_dia', 0)} · "
          f"seladas à espera do --promover: {data.get('seladas_a_promover', 0)}")
    if aplicado:
        print(f"  lote      : {data.get('lote')}")
        print(f"  acompanhar: {data.get('acompanhar')}")
        return 0
    for it in data.get("itens", [])[:_LOTE_LINHAS]:
        print(f"  {it.get('posicao'):>5}  {it.get('obra_id')}  {it.get('tipo'):<8} {_mib(it.get('bytes')):>10}  "
              f"{it.get('metodo_atual')} -> {it.get('metodo_alvo')}  {it.get('marcacao')}"
              + (f"  [fonte servindo em {it['servindo_da_fonte']}]" if (it.get("servindo_da_fonte") or 0) > 1 else "")
              + f"  {_bancada_curta(it.get('titulo') or '', 60)}")
    resto = len(data.get("itens", [])) - _LOTE_LINHAS
    if resto > 0:
        print(f"  … +{resto} obra(s) (--json traz todas)")
    print("  (plano seco — repita com --apply para abrir o lote)")
    return 0


def acao_relatorio_lote(lote: str, como_json: bool, headers: dict) -> int:
    """`--reextrair --lote --relatorio <lote>`: o estado do lote, as contagens e as reprovadas com as causas."""
    qs = "?completo=true" if como_json else ""
    data = _chamar("GET", f"{BASE}/acervo/reextracoes/lote/{urllib.parse.quote(lote, safe='')}{qs}", headers)
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    print(f"Lote {data.get('lote')} · {data.get('estado')} · aberto {data.get('criado_em')} por {data.get('autor')}"
          + (f" · concluído {data['concluido_em']}" if data.get("concluido_em") else ""))
    print("  por estado: " + ", ".join(f"{k} {v}" for k, v in sorted((data.get("por_estado") or {}).items())))
    for t in data.get("por_tipo", []):
        print(f"  {str(t.get('tipo')):<10} {t.get('n'):>5} obra(s)  conversão {t.get('conversao_ms', 0) / 1000:.0f} s  "
              f"corte {t.get('corte_ms', 0) / 1000:.0f} s")
    for nome, rotulo in (("reprovadas", "reprovadas"), ("prazo_insuficiente", "prazo insuficiente"),
                         ("falha_de_maquina_repetida", "falha de máquina repetida")):
        lista = data.get(nome) or []
        if not lista:
            continue
        print(f"  {rotulo} ({len(lista)}):")
        for it in lista:
            causa = "; ".join(it.get("causas") or []) or it.get("detalhe") or ""
            print(f"    {it.get('obra_id')}  {_bancada_curta(it.get('titulo') or '', 50)}  {_bancada_curta(causa, 120)}")
    return 0


# --- --reextrair ... --bancada <pasta>: conversão em lote para uma pasta (card #3187) -------------
# "bancada" aqui é só a pasta de saída dada na linha de comando. Não toca o acervo: o servidor
# converte e devolve; o cliente grava <pasta>/<metodo>/<obra_id>/{espelho.md,indice.json,relatorio.json}.

_BANCADA_METODO_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
_BANCADA_SEGURO_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
_BANCADA_ARQUIVOS = (("espelho.md", "sha256_md", "bytes_md"),
                     ("indice.json", "sha256_indice", "bytes_indice"))
# erro_tipo do relatório v1 e v2 que significam "o MÉTODO falhou nesta obra" (dado). 'indisponivel' (o método
# não roda no ambiente do servidor: não é resultado, refazer) e valor desconhecido ficam de fora: erro.
_BANCADA_TIPOS_FALHA = ("conversao", "timeout", "subprocesso", "ausente")
# versao_relatorio que o cliente aceita: 1 (conversor em subprocesso da API) e 2 (conversor como serviço,
# #3205: mesmos campos, mais versao_imagem, paginas, prazo_s e pico_memoria_kb). Outra versão: não obtida.
_BANCADA_VERSOES_RELATORIO = (1, 2)
# `--modo` da bancada (card #3207): converte e mede a fidelidade, ou só mede as calhas de duas colunas
_BANCADA_MODOS = ("bancada", "medida")
# POST: (conexão, leitura). A leitura espera o timeout da conversão no servidor + margem.
_BANCADA_CONEXAO_S = 10
_BANCADA_MARGEM_HTTP_S = 120
_BANCADA_TIMEOUT_RESOLVER = (10, 60)   # GET que resolve título -> obra_id
# Entrada que é um ARQUIVO local vai direto ao serviço do conversor (#3276): sem a rag-api, sem credencial
# (o serviço não tem segredo, spec conversor-pdf-combinado §2) e sem o prazo da porta. A rota do host é a
# porta publicada pela stack conversor (127.0.0.1:8200, #3276 c.1537).
CONVERSOR_URL_BANCADA = (os.environ.get("PF_CONVERSOR_URL") or "http://127.0.0.1:8200").rstrip("/")
_BANCADA_OCUPADO_TENTATIVAS = 20        # 409 do serviço: espera o Retry-After e tenta de novo (spec §4.2)


def _bancada_lista(valor: str) -> list[str]:
    """`id1,id2,…` ou `@caminho` (um id por linha; vazias e '#' ignoradas). Sem repetição, na ordem."""
    if valor.startswith("@"):
        with open(valor[1:], encoding="utf-8-sig") as f:   # BOM de editor não vira parte do 1º id
            itens = [linha.strip() for linha in f.read().splitlines()]
        itens = [i for i in itens if i and not i.startswith("#")]
    else:
        itens = [p.strip() for p in valor.split(",") if p.strip()]
    vistos, res = set(), []
    for i in itens:
        if _UUID_RE.match(i):
            i = i.lower()   # o mesmo UUID em maiúsculas é a mesma obra (e a mesma pasta)
        if i not in vistos:
            vistos.add(i)
            res.append(i)
    return res


def _bancada_modo() -> int:
    """0644 & ~umask: o mkstemp nasce 0600, e o arquivo da pasta é para o time ler."""
    umask = os.umask(0)
    os.umask(umask)
    return 0o644 & ~umask


def _bancada_gravar(caminho: str, dados: bytes) -> None:
    """Escrita atômica: tmp na mesma pasta + fsync + modo 0644 & ~umask + rename."""
    pasta = os.path.dirname(caminho)
    os.makedirs(pasta, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=pasta, prefix=".tmp-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(dados)
            f.flush()
            os.fchmod(f.fileno(), _bancada_modo())
            os.fsync(f.fileno())
        os.replace(tmp, caminho)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _bancada_testar_escrita(destino: str) -> str | None:
    """Cria a pasta e prova que se escreve nela (arquivo temporário, removido). None = ok; senão a
    causa, já com o caminho."""
    try:
        os.makedirs(destino, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=destino, prefix=".tmp-teste-")
        try:
            os.write(fd, b"teste de escrita\n")
            os.fsync(fd)
        finally:
            os.close(fd)
            os.unlink(tmp)
    except OSError as e:
        return f"{destino}: {e.strerror or e}"
    return None


def _bancada_curta(texto, limite: int = 80) -> str:
    t = " ".join(str(texto).split())
    return t if len(t) <= limite else t[: limite - 1] + "…"


def _bancada_n(v) -> str:
    if v is None:
        return "-"
    if isinstance(v, float) and v == int(v):
        return str(int(v))
    return str(v)


def _bancada_erro_tipo(rel: dict) -> str | None:
    """erro_tipo do relatório: None sem erro; relatório antigo com 'erro' e sem 'erro_tipo' vale conversao."""
    if not rel.get("erro"):
        return None
    return str(rel.get("erro_tipo") or "conversao")


def _bancada_campos(rel: dict) -> dict:
    """situacao (ok|reprovada|n/a|falha|erro) e os campos da linha, lidos do relatório v1 sem KeyError.
    'falha' = o método falhou nesta obra (dado). 'erro' aqui só para erro_tipo que não é dado."""
    fid = rel.get("fidelidade") if isinstance(rel.get("fidelidade"), dict) else {}
    cab = rel.get("cabecalho") if isinstance(rel.get("cabecalho"), dict) else {}
    tempos = rel.get("tempos_ms") if isinstance(rel.get("tempos_ms"), dict) else {}
    erro_tipo = _bancada_erro_tipo(rel)
    # precedência (a mesma do agregador): indisponivel > aplicavel false > falha do método
    if erro_tipo is not None and erro_tipo not in _BANCADA_TIPOS_FALHA:
        situacao, causa = "erro", _bancada_curta(f"método indisponível ({erro_tipo}): {rel['erro']}")
    elif rel.get("aplicavel") is False:
        situacao, causa = "n/a", "método não cobre o tipo"
    elif erro_tipo is not None:
        situacao, causa = "falha", _bancada_curta(f"{erro_tipo}: {rel['erro']}")
    elif rel.get("reprovado"):
        situacao, causa = "reprovada", _bancada_curta(rel.get("causa") or rel.get("criterio") or "reprovada")
    else:
        situacao, causa = "ok", None
    perda = None
    if isinstance(fid.get("perda"), dict) and not fid.get("erro"):
        perda = sum(v for v in fid["perda"].values() if isinstance(v, (int, float)) and not isinstance(v, bool))
    tipo = os.path.splitext(str(rel.get("arquivo") or ""))[1].lstrip(".").lower() \
        or str(rel.get("tipo") or "-").rsplit("/", 1)[-1]
    total = tempos.get("total")
    # a MEDIDA falhou (fidelidade.erro), a conversão não: continua ok/reprovada, com a marca
    medida_indeterminada = bool(fid.get("erro")) and erro_tipo is None and rel.get("aplicavel") is not False
    # a medida de duas colunas (modo `medida`, #3207): páginas e páginas com calha; None fora dele
    med = rel.get("medida") if isinstance(rel.get("medida"), dict) else None
    calhas = ({"paginas": med.get("paginas"), "com_calha": med.get("paginas_com_calha")}
              if med is not None else None)
    return {"situacao": situacao, "causa": causa, "tipo": tipo or "-", "erro_tipo": erro_tipo,
            "classe": rel.get("classe") or "-", "blocos": cab.get("blocos"), "perda": perda,
            "medida": calhas, "medida_indeterminada": medida_indeterminada,
            "total_ms": total if isinstance(total, (int, float)) and not isinstance(total, bool) else None}


def _bancada_linha(item: dict) -> str:
    medida = item.get("medida")
    if medida:  # modo medida: páginas e páginas com calha no lugar de classe, blocos e perda
        partes = [item["situacao"].ljust(9), (item.get("obra_id") or item["entrada"])[:8], item["tipo"],
                  f"paginas={_bancada_n(medida.get('paginas'))}", f"calha={_bancada_n(medida.get('com_calha'))}",
                  f"{_bancada_n(item['total_ms'])}ms"]
    else:
        partes = [item["situacao"].ljust(9), (item.get("obra_id") or item["entrada"])[:8], item["tipo"],
                  f"classe={item['classe']}", f"blocos={_bancada_n(item['blocos'])}",
                  f"perda={_bancada_n(item['perda']) if item['perda'] is not None else '-'}",
                  f"{_bancada_n(item['total_ms'])}ms"]
    if item.get("medida_indeterminada"):
        partes.append("medida-indeterminada")
    if item.get("causa"):
        partes.append(f"[{item['causa']}]")
    return "  ".join(partes)


def _bancada_total_de_calhas(itens: list) -> dict | None:
    """O total do modo `medida` (card #3207): obras medidas, obras com calha, páginas e páginas com calha.
    None quando nenhuma obra do lote traz `medida` (fora do modo medida)."""
    medidas = [i["medida"] for i in itens if i.get("medida")]
    if not medidas:
        return None
    com_calha = [m for m in medidas if (m.get("com_calha") or 0) > 0]
    return {"obras_medidas": len(medidas), "obras_com_calha": len(com_calha),
            "paginas": sum(m.get("paginas") or 0 for m in medidas),
            "paginas_com_calha": sum(m.get("com_calha") or 0 for m in com_calha)}


def _bancada_relatorio_integro(pasta_obra: str) -> dict | None:
    """relatorio.json VÁLIDO da pasta da obra, ou None. Válido: JSON objeto, versao_relatorio 1 ou 2,
    'erro' (se houver) com erro_tipo que é DADO (a falha do método é dado; 'indisponivel' não é) e os
    arquivos declarados presentes com o tamanho E o sha256 declarados."""
    try:
        with open(os.path.join(pasta_obra, "relatorio.json"), encoding="utf-8") as f:
            rel = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(rel, dict) or rel.get("versao_relatorio") not in _BANCADA_VERSOES_RELATORIO:
        return None
    erro_tipo = _bancada_erro_tipo(rel)
    if erro_tipo is not None and erro_tipo not in _BANCADA_TIPOS_FALHA:
        return None
    for nome, chave_sha, chave_bytes in _BANCADA_ARQUIVOS:
        esperado_sha, esperado_bytes = rel.get(chave_sha), rel.get(chave_bytes)
        if esperado_sha is None and esperado_bytes is None:
            continue
        try:
            with open(os.path.join(pasta_obra, nome), "rb") as f:
                dados = f.read()
        except OSError:
            return None
        if esperado_bytes is not None and len(dados) != esperado_bytes:
            return None
        if esperado_sha is not None and hashlib.sha256(dados).hexdigest() != str(esperado_sha).lower():
            return None
    return rel


def _bancada_feito(pasta_obra: str) -> dict | None:
    """relatorio.json de rodada anterior que dispensa refazer (retomada): válido e íntegro (tamanho e
    sha256 dos arquivos contra o relatório) e sem erro.txt ao lado. Falha do método e medida
    indeterminada são DADO: contam como feitas (refazer é decisão do operador, com --refazer)."""
    if os.path.exists(os.path.join(pasta_obra, "erro.txt")):
        return None
    return _bancada_relatorio_integro(pasta_obra)


def _bancada_resolver(entrada: str, headers: dict) -> tuple[str | None, str | None]:
    """resolver_obra_id sem deixar o sys.exit dele derrubar o lote: (obra_id, None) ou (None, causa)."""
    if _UUID_RE.match(entrada):
        return entrada, None
    sai, err = io.StringIO(), io.StringIO()
    try:
        with contextlib.redirect_stdout(sai), contextlib.redirect_stderr(err):
            return resolver_obra_id(entrada, headers, timeout=_BANCADA_TIMEOUT_RESOLVER), None
    except SystemExit as e:
        detalhe = _bancada_curta(err.getvalue() or sai.getvalue() or f"exit {e.code}", 100)
        return None, f"resolver: {detalhe}"
    except Exception as e:  # noqa: BLE001 — uma obra ruim não derruba as demais
        return None, f"resolver: {type(e).__name__}: {e}"


def _bancada_causa_http(resp) -> str:
    detalhe = ""
    try:
        pj = resp.json()
        if isinstance(pj, dict):
            detalhe = str(pj.get("detail") or pj.get("title") or "")
    except ValueError:
        detalhe = resp.text or ""
    rotulo = {404: "obra inexistente", 422: "método indisponível"}.get(
        resp.status_code, "erro do servidor" if resp.status_code >= 500 else "recusado")
    return _bancada_curta(f"{rotulo} (HTTP {resp.status_code})" + (f": {detalhe}" if detalhe else ""), 160)


def _bancada_obra(entrada: str, metodo: str, pasta: str, autor: str, timeout_s: int,
                  refazer: bool, headers: dict, modo: str | None = None) -> dict:
    """UMA obra. Nunca levanta por causa dela (quem chama ainda protege); devolve o item do resumo.
    `modo` (`bancada` ou `medida`) vai no corpo do POST só quando dado: sem ele o servidor assume `bancada`."""
    item = {"entrada": entrada, "obra_id": None, "situacao": "erro", "arquivo_relatorio": None,
            "arquivos": [], "tipo": "-", "classe": "-", "blocos": None, "perda": None,
            "total_ms": None, "causa": None, "origem_erro": None, "erro_tipo": None,
            "medida": None, "medida_indeterminada": False}
    arquivo_local = entrada if os.path.isfile(entrada) else None
    if arquivo_local:
        # a pasta leva o nome do arquivo sem extensão, só com os caracteres que servem de nome de pasta
        oid = re.sub(r"[^A-Za-z0-9._-]+", "_", os.path.splitext(os.path.basename(arquivo_local))[0]).strip("._-")
        problema = None if oid else "arquivo sem nome que sirva de pasta"
    else:
        oid, problema = _bancada_resolver(entrada, headers)
    if problema:
        item.update(causa=problema, origem_erro="cliente")
        return item
    if _UUID_RE.match(oid):
        oid = oid.lower()   # pasta e POST sempre com o UUID normalizado
    item["obra_id"] = oid
    if not _BANCADA_SEGURO_RE.match(oid):
        item.update(causa="obra_id impróprio como nome de pasta", origem_erro="cliente")
        return item
    pasta_obra = os.path.join(pasta, metodo, oid)
    caminho_rel = os.path.join(pasta_obra, "relatorio.json")

    def registrar_erro(causa: str) -> None:
        """erro.txt na pasta da obra, sem apagar nada que já esteja lá."""
        try:
            agora = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            _bancada_gravar(os.path.join(pasta_obra, "erro.txt"), f"{agora}\n{causa}\n".encode("utf-8"))
        except OSError as e:
            item["causa"] += f" (erro.txt não gravado: {e})"

    def nao_obtida(causa: str, origem: str) -> dict:
        """Falha ANTES de haver resposta 200 válida em mãos (HTTP, rede, corpo, método indisponível).
        Não toca o que já está na pasta; erro.txt só nasce onde não há relatorio.json válido (com um
        relatório antigo íntegro, --refazer que falha só reporta). Com um relatorio.json antigo que NÃO
        é íntegro (sha/tamanho não conferem), ele vira relatorio.invalido.json antes do erro.txt: estado
        A3 (sem relatorio.json válido; nunca relatorio.json + erro.txt lado a lado)."""
        item.update(situacao="erro", causa=_bancada_curta(causa, 200), origem_erro=origem)
        if _bancada_relatorio_integro(pasta_obra) is None:
            if os.path.exists(caminho_rel):
                try:
                    os.replace(caminho_rel, os.path.join(pasta_obra, "relatorio.invalido.json"))
                except OSError as e:
                    item["causa"] += f" (relatorio.json não renomeado: {e})"
            registrar_erro(causa)
        return item

    if not refazer:
        rel = _bancada_feito(pasta_obra)
        if rel is not None:
            campos = _bancada_campos(rel)
            item.update(campos, situacao="já feito", situacao_gravada=campos["situacao"],
                        arquivo_relatorio=caminho_rel,
                        arquivos=[n for n, _s, _b in _BANCADA_ARQUIVOS if rel.get(_b) is not None])
            return item

    if arquivo_local:
        # direto ao serviço (spec conversor-pdf-combinado §3.3): os bytes no corpo, o prazo pedido como teto
        try:
            with open(arquivo_local, "rb") as f:
                dados = f.read()
        except OSError as e:
            return nao_obtida(f"ler {arquivo_local}: {e}", "cliente")
        params = {"metodo": metodo, "modo": modo or "bancada", "prazo_s": timeout_s,
                  "extensao": os.path.splitext(arquivo_local)[1].lstrip(".").lower()}
        try:
            for _ in range(_BANCADA_OCUPADO_TENTATIVAS):
                resp = requests.post(f"{CONVERSOR_URL_BANCADA}/conversoes", params=params, data=dados,
                                     headers={"Content-Type": "application/octet-stream"},
                                     timeout=(_BANCADA_CONEXAO_S, timeout_s + _BANCADA_MARGEM_HTTP_S))
                if resp.status_code != 409:
                    break
                time.sleep(int(resp.headers.get("Retry-After") or 30))
        except requests.exceptions.RequestException as e:
            return nao_obtida(f"rede ({CONVERSOR_URL_BANCADA}): {type(e).__name__}: {e}", "servidor")
        # 504 (prazo) e 500 trazem o relatório com erro_tipo: o 504 é dado (timeout), o 500 não
        if resp.status_code not in (200, 504, 500):
            return nao_obtida(_bancada_causa_http(resp), "servidor")
    else:
        pedido = {"autor": autor, "metodo": metodo, "timeout_s": timeout_s}
        if modo:
            pedido["modo"] = modo
        try:
            resp = requests.post(f"{BASE}/acervo/obras/{oid}/conversoes", headers=headers, json=pedido,
                                 timeout=(_BANCADA_CONEXAO_S, timeout_s + _BANCADA_MARGEM_HTTP_S))
        except requests.exceptions.RequestException as e:
            return nao_obtida(f"rede: {type(e).__name__}: {e}", "servidor")
        if resp.status_code != 200:
            return nao_obtida(_bancada_causa_http(resp), "servidor")
    try:
        corpo = resp.json()
    except ValueError:
        return nao_obtida("HTTP 200 com corpo que não é JSON", "servidor")
    rel = corpo.get("relatorio") if isinstance(corpo, dict) else None
    if not isinstance(rel, dict):
        return nao_obtida("HTTP 200 sem 'relatorio' no corpo", "servidor")
    if rel.get("versao_relatorio") not in _BANCADA_VERSOES_RELATORIO:
        return nao_obtida(f"relatório de versão {_bancada_curta(repr(rel.get('versao_relatorio')), 20)} (esperado 1 ou 2)",
                          "servidor")
    erro_tipo = _bancada_erro_tipo(rel)
    if erro_tipo is not None and erro_tipo not in _BANCADA_TIPOS_FALHA:
        # 'indisponivel': o método não roda no ambiente do servidor — NÃO é resultado do método, refazer
        return nao_obtida(f"método indisponível no servidor (erro_tipo={erro_tipo}): "
                          f"{_bancada_curta(rel['erro'], 120)}", "servidor")
    arquivos = corpo.get("arquivos") if isinstance(corpo.get("arquivos"), dict) else {}
    if arquivo_local:
        rel.setdefault("arquivo", os.path.basename(arquivo_local))   # o serviço recebe só os bytes

    # Há resposta 200 válida em mãos. Daí em diante o relatório antigo não vale mais: sai AGORA, antes
    # de gravar os arquivos novos (rodada interrompida não deixa relatorio.json velho sobre arquivos
    # novos), e o relatorio.json novo só nasce POR ÚLTIMO, depois da conferência.
    texto_rel = (json.dumps(rel, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
    campos = _bancada_campos(rel)
    item.update({k: v for k, v in campos.items() if k not in ("situacao", "causa")})
    gravados, problemas = [], []

    def invalidar(causa: str) -> dict:
        """Gravação ou conferência falhou: NÃO há relatorio.json válido. O que já foi gravado fica; o
        relatório recebido vai para relatorio.invalido.json (diagnóstico) e erro.txt diz o porquê."""
        item.update(situacao="erro", causa=_bancada_curta(causa, 200), origem_erro="cliente",
                    arquivos=list(gravados), arquivo_relatorio=None)
        try:
            _bancada_gravar(os.path.join(pasta_obra, "relatorio.invalido.json"), texto_rel)
        except OSError as e:
            item["causa"] += f" (relatorio.invalido.json não gravado: {e})"
        try:
            os.unlink(caminho_rel)
        except FileNotFoundError:
            pass
        except OSError as e:
            item["causa"] += f" (relatorio.json não removido: {e})"
        registrar_erro(causa)
        return item

    try:
        os.makedirs(pasta_obra, exist_ok=True)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(caminho_rel)
        for nome, _sha, _bytes in _BANCADA_ARQUIVOS:
            texto = arquivos.get(nome)
            if isinstance(texto, str):
                _bancada_gravar(os.path.join(pasta_obra, nome), texto.encode("utf-8"))
                gravados.append(nome)
            else:
                # a resposta nova não traz este arquivo: o da rodada anterior sai, para não ficar ao
                # lado do relatório novo (falha do método, n/a)
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(os.path.join(pasta_obra, nome))
                if texto is not None:
                    problemas.append(f"{nome}: não veio como texto")
    except OSError as e:
        return invalidar(f"gravar em {pasta_obra}: {e}")

    if rel.get("metodo") not in (None, metodo):
        problemas.append(f"relatório de outro método ({rel.get('metodo')!r} != {metodo!r})")
    for nome, chave_sha, chave_bytes in _BANCADA_ARQUIVOS:
        if nome not in gravados:
            if rel.get(chave_sha):
                problemas.append(f"{nome}: declarado no relatório e ausente da resposta")
            continue
        try:
            with open(os.path.join(pasta_obra, nome), "rb") as f:
                dados = f.read()
        except OSError as e:
            problemas.append(f"{nome}: não li de volta para conferir ({e})")
            continue
        esperado_sha, esperado_bytes = rel.get(chave_sha), rel.get(chave_bytes)
        if esperado_sha is None and esperado_bytes is None:
            problemas.append(f"{nome}: relatório sem {chave_sha}/{chave_bytes} para conferir")
            continue
        if esperado_bytes is not None and len(dados) != esperado_bytes:
            problemas.append(f"{nome}: {len(dados)} bytes != {chave_bytes} {esperado_bytes}")
        if esperado_sha is not None and hashlib.sha256(dados).hexdigest() != str(esperado_sha).lower():
            problemas.append(f"{nome}: sha256 diverge de {chave_sha}")
    if problemas:
        return invalidar("conferência: " + "; ".join(problemas))
    try:  # o relatório, por último: sua presença é a marca de 'feito'
        _bancada_gravar(caminho_rel, texto_rel)
    except OSError as e:
        return invalidar(f"gravar {caminho_rel}: {e}")
    item.update(campos, arquivo_relatorio=caminho_rel, arquivos=gravados)
    for sobra in ("erro.txt", "relatorio.invalido.json"):   # de rodada anterior que não fechou
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(pasta_obra, sobra))
    return item


def acao_reextrair_bancada(args, autor: str, como_json: bool, headers: dict) -> int:
    """`curar --reextrair <lista> --bancada <pasta>`: converte no servidor (rota do contrato
    POST /acervo/obras/{id}/conversoes) e grava em <pasta>/<metodo>/<obra_id>/. Retomável.
    Exit 0: todas obtidas (reprovada, n/a, falha do método e medida indeterminada são dados); 1:
    alguma NÃO pôde ser obtida (HTTP, rede, título, método indisponível, gravação, conferência);
    2: uso errado, inclusive pasta de saída sem escrita (antes de qualquer POST)."""
    def uso(msg: str) -> int:
        sys.stderr.write(f"curar: erro: {msg}\n")
        return 2

    if args.bancada is None:
        return uso("--refazer, --timeout-s e --modo acompanham --reextrair <lista> --bancada <pasta>")
    if not args.bancada.strip():
        return uso("--bancada exige uma pasta")
    if not args.reextrair:
        return uso("--bancada acompanha --reextrair <obra|id,id…|@arquivo>")
    if args.apply:
        return uso("bancada não escreve no acervo: --apply não vale com --bancada")
    if args.recortar or args.corte:
        return uso("--bancada não combina com --recortar/--corte")
    metodo = args.metodo or "perfil"
    if not _BANCADA_METODO_RE.match(metodo):
        return uso(f"--metodo '{metodo}' não serve de nome de pasta (slug: a-z, 0-9, ponto, hífen, sublinhado)")
    timeout_s = 1800 if args.timeout_s is None else args.timeout_s
    if timeout_s <= 0:
        return uso("--timeout-s deve ser positivo")
    modo = args.modo.strip() if args.modo is not None else None
    if modo is not None and modo not in _BANCADA_MODOS:
        return uso(f"--modo é {' ou '.join(_BANCADA_MODOS)}, veio '{args.modo}'")
    try:
        entradas = _bancada_lista(args.reextrair)
    except UnicodeDecodeError as e:
        return uso(f"a lista '{args.reextrair}' não é texto utf-8 (byte inválido na posição {e.start}); "
                   "salve como utf-8")
    except OSError as e:
        return uso(f"não li a lista '{args.reextrair}': {e}")
    if not entradas:
        return uso("a lista de obras está vazia")

    pasta = args.bancada
    # A pasta de saída tem de aceitar escrita ANTES de qualquer POST: senão o lote inteiro converteria
    # (horas de servidor) para descartar tudo na gravação.
    causa = _bancada_testar_escrita(os.path.join(pasta, metodo))
    if causa:
        return uso(f"não consigo escrever em {causa}")
    saida = sys.stderr if como_json else sys.stdout  # com --json o stdout é só o resumo
    t0 = time.monotonic()
    itens = []
    for entrada in entradas:
        try:
            item = _bancada_obra(entrada, metodo, pasta, autor, timeout_s, args.refazer, headers, modo)
        except Exception as e:  # noqa: BLE001 — falha de uma obra nunca derruba as demais
            item = {"entrada": entrada, "obra_id": None, "situacao": "erro", "arquivo_relatorio": None,
                    "arquivos": [], "tipo": "-", "classe": "-", "blocos": None, "perda": None,
                    "total_ms": None, "causa": _bancada_curta(f"{type(e).__name__}: {e}"),
                    "origem_erro": "cliente", "erro_tipo": None, "medida": None,
                    "medida_indeterminada": False}
        itens.append(item)
        saida.write(_bancada_linha(item) + "\n")
        saida.flush()
    contagem = {k: sum(1 for i in itens if i["situacao"] == k)
                for k in ("ok", "reprovada", "n/a", "falha", "erro", "já feito")}
    decorrido = time.monotonic() - t0
    saida.write(f"total  {len(itens)} obra(s)  ok={contagem['ok']}  reprovada={contagem['reprovada']}  "
                f"n/a={contagem['n/a']}  falha={contagem['falha']}  erro={contagem['erro']}  "
                f"já feito={contagem['já feito']}  "
                f"{decorrido:.1f}s  {os.path.join(pasta, metodo)}\n")
    saida.flush()
    calhas = _bancada_total_de_calhas(itens)
    if calhas:
        saida.write(f"medida  {calhas['obras_com_calha']} de {calhas['obras_medidas']} obra(s) com calha  "
                    f"{calhas['paginas_com_calha']} de {calhas['paginas']} página(s) com calha\n")
        saida.flush()
    codigo = 1 if contagem["erro"] else 0
    if como_json:
        resumo = {"ato": "converter-em-bancada-lote", "pasta": pasta, "metodo": metodo,
                  "autor": autor, "total": len(itens), "contagem": contagem,
                  "exit_code": codigo, "obras": itens}
        if modo is not None:
            resumo["modo"] = modo
        if calhas:
            resumo["medida"] = calhas
        print(json.dumps(resumo, indent=2, ensure_ascii=False))
    return codigo


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    parser = argparse.ArgumentParser(
        prog="curar",
        description="Cliente fino da API de curadoria do acervo.",
        add_help=False,
    )
    # Ações
    parser.add_argument("--reclassificar", action="store_true", default=False)
    parser.add_argument("--situacao", default=None)
    # nargs="?": `--expurgar --espelhos` e `--restaurar --espelhos` não levam obra (#3180)
    parser.add_argument("--expurgar", nargs="?", const="", default=None)
    parser.add_argument("--restaurar", nargs="?", const="", default=None)
    parser.add_argument("--espelhos", action="store_true", default=False)
    parser.add_argument("--apagar", default=None)
    parser.add_argument("--recortar", default=None)
    # nargs="?": `--reextrair --lote` não leva obra (#3193)
    parser.add_argument("--reextrair", nargs="?", const="", default=None)
    parser.add_argument("--rejulgar", action="store_true", default=False)
    parser.add_argument("--lote", action="store_true", default=False)
    parser.add_argument("--ordem", default=None)
    parser.add_argument("--relatorio", default=None)
    # --medida --replicas <n>: o lote de medida do #3228 (só converte e mede; nada no acervo)
    parser.add_argument("--medida", action="store_true", default=False)
    parser.add_argument("--replicas", type=int, default=None)
    # --bancada <pasta>: pasta de SAÍDA da conversão em lote (card #3187); nada a ver com a raiz
    # de lib/raizes.py nem com `acervo curar biblioteca lote`
    parser.add_argument("--bancada", default=None)
    parser.add_argument("--refazer", action="store_true", default=False)
    parser.add_argument("--timeout-s", dest="timeout_s", type=int, default=None)
    parser.add_argument("--modo", default=None)
    parser.add_argument("--metodo", default=None)
    parser.add_argument("--corte", default=None)
    parser.add_argument("--promover", default=None)
    parser.add_argument("--relacionar", nargs="*", default=None)
    parser.add_argument("--relacoes", default=None)
    parser.add_argument("--desrelacionar", default=None)
    parser.add_argument("--derivar", default=None)
    parser.add_argument("--derivacoes", default=None)
    parser.add_argument("--desderivar", default=None)
    parser.add_argument("--de", default=None)
    parser.add_argument("--registrar-obra", dest="registrar_obra", default=None)
    parser.add_argument("--conceito", default=None)
    parser.add_argument("--rotulo", default=None)
    parser.add_argument("--definicao", default=None)
    parser.add_argument("--natureza", default=None)
    parser.add_argument("--estatuto", default=None)
    parser.add_argument("--pai", default=None)
    parser.add_argument("--renomear", default=None)
    parser.add_argument("--alt", default=None)
    parser.add_argument("--endereco", default=None)
    parser.add_argument("--lingua", default=None)
    parser.add_argument("--mais-amplo", dest="mais_amplo", default=None)
    parser.add_argument("--mais-amplo-tipo", dest="mais_amplo_tipo", default=None)
    parser.add_argument("--rotulo-alt", dest="rotulo_alt", action="append", default=None)
    parser.add_argument("--filhos-exclusivos", dest="filhos_exclusivos", action="store_true", default=False)
    parser.add_argument("--tipo", default=None)
    parser.add_argument("--garantia", default=None)
    parser.add_argument("--motivo", default=None)
    parser.add_argument("--lastro", default=None)
    parser.add_argument("--sem-hermit", dest="sem_hermit", action="store_true", default=False)

    # Alterações
    parser.add_argument("--trata-de", default=None)
    parser.add_argument("--remover-trata-de", default=None)
    parser.add_argument("--substituir-trata-de", default=None)
    parser.add_argument("--dominio", default=None)
    parser.add_argument("--subdominio", default=None)
    parser.add_argument("--especie", default=None)
    parser.add_argument("--subtipo", default=None)
    parser.add_argument("--titulo", default=None)
    parser.add_argument("--id-canonico", dest="id_canonico", default=None)
    parser.add_argument("--publicacao", default=None)
    parser.add_argument("--emitido-por", dest="emitido_por", default=None)
    parser.add_argument("--anotacao", default=None)
    parser.add_argument("--colecao", default=None)

    # Seleção
    parser.add_argument("--obras", nargs="*", default=None)
    parser.add_argument("--obra", default=None)
    parser.add_argument("--de-dominio", default=None)
    parser.add_argument("--de-subdominio", default=None)
    parser.add_argument("--de-conceito", default=None)
    parser.add_argument("--de-colecao", default=None)
    parser.add_argument("--sem-dominio", action="store_true", default=False)
    parser.add_argument("--expurgadas", action="store_true", default=False)
    parser.add_argument("--teto", type=int, default=200)

    # Gerais
    parser.add_argument("--apply", action="store_true", default=False)
    parser.add_argument("--autor", default=None)
    parser.add_argument("--impressao", default=None)
    parser.add_argument("--json", dest="como_json", action="store_true", default=False)
    parser.add_argument("--sim", "-y", dest="confirmado", action="store_true", default=False)
    parser.add_argument("-h", "--help", "--ajuda", dest="ajuda", action="store_true", default=False)

    args, desconhecidos = parser.parse_known_args(argv)

    if args.ajuda and args.relacionar is not None:
        print(CARTILHA)
        sys.exit(0)
    if args.ajuda or (not argv):
        sys.stdout.write(USO)
        sys.exit(0 if args.ajuda else 2)
    if desconhecidos:
        # #2856 linha 151: o parse_known_args deixava `--emitido_por` e `--id_canonico` passarem com
        # exit 0 e o plano os ignorava; flag que o verbo nao le e recusa (exit 2), com a grafia certa.
        conhecidas = set(parser._option_string_actions)
        linhas = []
        for tok in desconhecidos:
            sugestao = tok.split("=", 1)[0].replace("_", "-")
            dica = f" (a grafia é {sugestao})" if sugestao in conhecidas else ""
            linhas.append(f"  {tok}{dica}")
        sys.stderr.write("curar: erro: argumento que o verbo não lê:\n" + "\n".join(linhas) + "\n"
                         "  veja `acervo curar biblioteca --ajuda`; nada foi chamado\n")
        sys.exit(2)

    autor = args.autor
    if not autor:
        cad = (os.environ.get("PF_CADEIRA") or os.environ.get("PF_CONTA") or "").strip().lower()
        if cad:
            autor = cad.removeprefix("claudinho-").removeprefix("claudinha-")
        else:
            autor = "dados"

    headers = {}
    if TOKEN:
        headers["authorization"] = f"Bearer {TOKEN}"
    traceparent = f"00-{secrets.token_hex(16)}-{secrets.token_hex(8)}-01"
    headers["traceparent"] = traceparent

    if args.renomear is not None:
        # antes da escada de despacho: senão `--conceito x --renomear y --recortar z` seguiria para o recorte
        if not args.conceito:
            sys.stderr.write("curar: erro: --renomear acompanha --conceito <slug>\n")
            return 2
        incompativeis = _renomear_incompativeis(args)
        if incompativeis:
            sys.stderr.write(f"curar: erro: --renomear não combina com {' '.join(incompativeis)}: "
                             "criar conceito, trocar o pai e os outros atos são chamadas à parte\n")
            return 2
    if args.espelhos and (args.expurgar is not None or args.restaurar is not None):
        ato = "expurgar" if args.expurgar is not None else "restaurar"
        obra = (args.expurgar if ato == "expurgar" else args.restaurar) or args.obra
        return acao_espelhos(ato, obra, autor, args.apply, args.como_json, headers)
    if args.espelhos:
        sys.stderr.write("curar: erro: --espelhos acompanha --expurgar ou --restaurar\n")
        return 2
    if args.lote or args.rejulgar or args.ordem is not None or args.relatorio is not None:
        # spec espelho-de-leitura §4.2 e §9 caso 8 (#3193): os atos de lote sobre o estoque
        if not args.lote:
            sys.stderr.write("curar: erro: --rejulgar, --ordem e --relatorio acompanham --lote\n")
            return 2
        if args.bancada is not None or args.recortar:
            sys.stderr.write("curar: erro: --lote não combina com --bancada nem com --recortar\n")
            return 2
        if args.rejulgar and args.reextrair is None:
            return acao_rejulgar(autor, args.apply, args.como_json, headers)
        if args.reextrair == "" and not args.rejulgar:
            if args.relatorio is not None:
                return acao_relatorio_lote(args.relatorio, args.como_json, headers)
            return acao_reextrair_lote(args, autor, args.como_json, headers)
        sys.stderr.write("curar: erro: --lote vai com --reextrair (sem obra) ou com --rejulgar\n")
        return 2
    if args.bancada is not None or args.refazer or args.timeout_s is not None or args.modo is not None:
        return acao_reextrair_bancada(args, autor, args.como_json, headers)
    if args.recortar:
        return acao_recortar(args, autor, args.como_json, headers)
    if args.reextrair:
        return acao_reextrair(args, autor, args.como_json, headers)
    if args.conceito:
        return acao_conceito(args, autor, args.como_json, headers)
    if args.derivar:
        return acao_derivar(args, autor, args.como_json, headers)
    if args.derivacoes:
        return acao_derivacoes(args.derivacoes, args.como_json, headers)
    if args.desderivar:
        return acao_desderivar(args, autor, args.como_json, headers)
    if args.registrar_obra:
        return acao_registrar_obra(args, autor, args.como_json, headers)
    if args.relacionar is not None:
        return acao_relacionar(args, autor, args.como_json, headers)
    elif args.relacoes:
        return acao_relacoes(args.relacoes, args.como_json, headers)
    elif args.desrelacionar:
        return acao_desrelacionar(args.desrelacionar, autor, args.como_json, headers, confirmado=args.confirmado)
    elif args.situacao:
        return acao_situacao(args.situacao, args.como_json, headers)
    elif args.expurgar is not None:
        obra = args.expurgar or args.obra
        if not obra:
            sys.stderr.write("curar: erro: --expurgar exige <obra> ou --obra <id>\n")
            return 2
        return acao_expurgar(obra, autor, args.apply, args.como_json, headers)
    elif args.restaurar is not None:
        obra = args.restaurar or args.obra
        if not obra:
            sys.stderr.write("curar: erro: --restaurar exige <obra> ou --obra <id>\n")
            return 2
        return acao_restaurar(obra, autor, args.apply, args.como_json, headers)
    elif args.apagar:
        return acao_apagar(args.apagar, autor, args.apply, args.como_json, headers)
    elif args.promover:
        if not args.impressao:
            sys.stderr.write("curar: erro: --promover exige --impressao <id>\n")
            sys.exit(2)
        return acao_promover(args.promover, args.impressao, autor, args.como_json, headers)
    elif args.reclassificar or args.obra or args.obras or args.de_dominio or args.trata_de or args.remover_trata_de or args.substituir_trata_de:
        return acao_reclassificar(args, autor, args.como_json, headers)
    else:
        sys.stderr.write(USO)
        sys.stderr.write("curar: erro: nenhuma ação especificada\n")
        sys.exit(2)


if __name__ == "__main__":
    sys.exit(main())
