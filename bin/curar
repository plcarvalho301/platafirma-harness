#!/usr/bin/env python3
# curar — cliente fino da API de curadoria do acervo
# capacidade: classificacao
# dono: claudinho-dados
# use para: curadoria do acervo, reclassificação em lote e avulsa, expurgo, restauração, promoção, criação de conceito (nó) e teia de conceitos (aresta entre conceitos)
# atos: --reclassificar, --situacao, --expurgar, --restaurar, --promover, --conceito, --relacionar, --relacoes, --desrelacionar
import argparse
import json
import os
import re
import secrets
import subprocess
import sys
import urllib.parse

import requests

HARNESS_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if HARNESS_DIR not in sys.path:
    sys.path.insert(0, HARNESS_DIR)

try:
    from recuperacao.adaptadores.motor_acervo_rest import BASE as DEFAULT_BASE, TOKEN as DEFAULT_TOKEN
except ImportError:
    DEFAULT_BASE = "http://127.0.0.1:8100"
    DEFAULT_TOKEN = ""

BASE = (os.environ.get("MOTOR_ACERVO_URL") or os.environ.get("RAG_API_URL") or os.environ.get("RAG_API_BASE") or DEFAULT_BASE).rstrip("/")
TOKEN = os.environ.get("RAG_API_TOKEN") or DEFAULT_TOKEN

_UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.IGNORECASE)

USO = """uso:
  curar --reclassificar [opções de alteração] [opções de seleção]
  curar --situacao <obra>
  curar --expurgar <obra> [--sim]
  curar --restaurar <obra>
  curar --promover <obra> --impressao <id>
  curar --conceito <slug> --rotulo <r> --definicao <d> --natureza <n> --estatuto <e> [--mais-amplo <slug> --mais-amplo-tipo <t>] [--rotulo-alt 'lingua|rotulo']... [--trata-de <obras>] [--apply]
  curar --relacionar <de> <para> --tipo <t> --garantia <g> --motivo <m> [--lastro <obra>] [--apply]
  curar --relacionar --help     cartilha: as 11 famílias (frase-molde) e as 3 garantias
  curar --relacoes <conceito>   arestas de um conceito, coluna + tabela (o que já está lavrado)
  curar --desrelacionar <id>    desfaz UMA aresta lavrada (pede confirmação 'sim')

ações principais:
  --reclassificar               reclassifica obra(s) em lote ou individualmente (default: plano seco)
  --situacao <obra>             consulta a situação viva de uma obra no acervo
  --expurgar <obra>             expurgo reversível de uma obra (pede confirmação 'sim')
  --restaurar <obra>            restaura obra expurgada (expurgada: false)
  --promover <obra>             promove impressão de bancada para servindo (exige --impressao)
  --relacionar <de> <para>      lavra UMA aresta em acervo.conceito_relacao (default: plano seco —
                                conferências SQL com a aresta dentro + HermiT com diff de insatisfazíveis)
  --relacoes <conceito>         lista as arestas de um conceito (pai/filhos da coluna + tabela)
  --desrelacionar <id>          apaga uma aresta pelo id (o export versionado é o registro)

opções de --conceito:
  --rotulo <texto>              rótulo preferido (obrigatório)
  --definicao <texto>           definição (obrigatório)
  --natureza <n>                processo|disposicao|modelo|fenomeno (obrigatório)
  --estatuto <e>                instituido|doutrinario|natural (obrigatório)
  --mais-amplo <slug>           conceito pai (opcional; exige --mais-amplo-tipo)
  --mais-amplo-tipo <t>         generica|partitiva|instancia|instrumental|aferidora|patologica|condicional|economica|tematica
  --rotulo-alt 'lingua|rotulo'  rótulo alternativo (repetível; lingua pt|en|zxx)
  --lingua <l>                  língua do rótulo preferido (default pt)
  --endereco <texto>            endereço/URI canônico (opcional)
  --filhos-exclusivos           filhos mutuamente exclusivos
  --trata-de <obras>            obra(s) de lastro literário (uuid/título, vírgula)

opções de --relacionar:
  --tipo <família>              generica|partitiva|instancia|instrumental|condicional|tematica|
                                patologica|aferidora|economica|relacionada|disjunta
  --garantia <g>                literaria (exige --lastro) | de-uso | instituida
  --motivo <texto>              na frase-molde da família (ver --relacionar --help)
  --lastro <obra>               obra do acervo que sustenta (uuid ou título exato)
  --sem-hermit                  pula a projeção formal (só com --apply se o HermiT estiver fora)

opções de alteração (--reclassificar):
  --trata-de <conceitos>        adiciona conceito(s) (separados por vírgula)
  --remover-trata-de <conceitos> remove conceito(s) (separados por vírgula)
  --substituir-trata-de <concs> substitui todo o conjunto de conceitos da obra
  --dominio <slug>              novo domínio da obra (ou 'null' para limpar)
  --subdominio <slug>           novo subdomínio da obra (ou 'null' para limpar)
  --especie <slug>              nova espécie da obra (ou 'null' para limpar)
  --anotacao <texto>            anotação textual da obra

opções de seleção (--reclassificar em lote):
  --obras <id1,id2,...>         lista de IDs ou títulos de obras a alterar
  --obra <id>                   alteração de uma única obra
  --de-dominio <slug>           filtra obras pelo domínio de origem
  --de-subdominio <slug>        filtra obras pelo subdomínio de origem (usado com --de-dominio)
  --de-conceito <slug>          filtra obras pelo conceito de origem
  --de-colecao <slug>           filtra obras pela coleção (firma | pessoal)
  --sem-dominio                 filtra obras sem domínio atribuído
  --expurgadas                  filtra obras expurgadas
  --teto <n>                    teto máximo de obras a alterar no lote (default: 200, máx: 5000)

opções gerais:
  --apply                       aplica as alterações (default: falso, dry-run do plano)
  --autor <slug>                curador responsável (default: cadeira da sessão ou 'dados')
  --impressao <id>              ID da impressão a promover (obrigatório com --promover)
  --json                        emite resultado em formato JSON
  --sim, -y                     confirma expurgo sem prompt interativo
"""


def falha_indeterminavel(erro_ou_resp):
    print("indeterminavel")
    if isinstance(erro_ou_resp, requests.Response):
        try:
            pj = erro_ou_resp.json()
            print(json.dumps(pj, indent=2, ensure_ascii=False))
        except Exception:
            print(json.dumps({
                "type": "about:blank",
                "title": "FonteIndisponivel",
                "status": erro_ou_resp.status_code,
                "detail": erro_ou_resp.text,
            }, indent=2, ensure_ascii=False))
    else:
        print(json.dumps({
            "type": "about:blank",
            "title": "FonteIndisponivel",
            "status": 503,
            "detail": f"Motor acervo indisponível em {BASE}: {erro_ou_resp}",
        }, indent=2, ensure_ascii=False))
    sys.exit(1)


def falha_problem(resp: requests.Response) -> None:
    try:
        pj = resp.json()
        title = pj.get("title") or f"HTTP {resp.status_code}"
        detail = pj.get("detail")
        msg = f"{title}\n{detail}" if detail else f"{title}\n"
    except Exception:
        msg = f"HTTP {resp.status_code}\n{resp.text}"
    sys.stderr.write(msg.rstrip() + "\n")
    print(msg.rstrip())
    sys.exit(1)


def _parse_lista(vals) -> list[str]:
    if not vals:
        return []
    if isinstance(vals, str):
        vals = [vals]
    res = []
    for v in vals:
        for p in re.split(r"[,;\s]+", str(v)):
            p = p.strip()
            if p:
                res.append(p)
    return res


def resolver_obra_id(obra: str, headers: dict, expurgadas: bool = False) -> str:
    obra = obra.strip()
    if _UUID_RE.match(obra):
        return obra
    qs = "?expurgadas=true" if expurgadas else ""
    url = f"{BASE}/acervo/obras/{urllib.parse.quote(obra, safe='')}/situacao{qs}"
    try:
        resp = requests.get(url, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    oid = data.get("obra_id")
    if not oid:
        sys.stderr.write(f"curar: não foi possível resolver o ID da obra '{obra}'\n")
        sys.exit(1)
    # Verbo de ESCRITA: título só resolve por casamento EXATO (trava do card #2975 — nada de
    # seleção por texto livre). Aproximado devolve o candidato e exige o uuid.
    if data.get("casamento") not in (None, "exato"):
        sys.stderr.write(f"curar: '{obra}' casou só aproximado com {oid} ({data.get('titulo')}); "
                         "passe o uuid para escrever nela\n")
        sys.exit(2)
    return oid


def formatar_lote_resultado(res: dict) -> str:
    modo = res.get("modo", "plano")
    n = res.get("n", 0)
    itens = res.get("itens", [])
    linhas = []
    if modo == "plano":
        linhas.append(f"Plano de curadoria: plano com n:{n} (dry-run)")
    else:
        linhas.append(f"Curadoria aplicada: n:{n} aplicado")
    linhas.append("")
    linhas.append(f"{'#':<3} {'Obra ID':<38} {'Título':<40} {'Alterações'}")
    linhas.append("-" * 125)
    for idx, item in enumerate(itens, 1):
        oid = item.get("obra_id", "-")
        tit = item.get("titulo", "-")
        if len(tit) > 38:
            tit = tit[:35] + "..."
        antes = item.get("antes", {})
        depois = item.get("depois", {})
        diffs = []
        for k in sorted(set(antes.keys()) | set(depois.keys())):
            a = antes.get(k)
            d = depois.get(k)
            diffs.append(f"{k}: {a} -> {d}")
        diff_str = "; ".join(diffs) if diffs else "(sem alterações)"
        linhas.append(f"{idx:<3} {oid:<38} {tit:<40} {diff_str}")
    return "\n".join(linhas)


def formatar_situacao(payload: dict) -> str:
    oid = payload.get("obra_id", "-")
    tit = payload.get("titulo", "-")
    servivel = "sim" if payload.get("servivel") else "não"
    degrau = payload.get("degrau", "-")
    desde = payload.get("desde") or "-"
    imp = payload.get("impressao_id") or "-"
    obj = payload.get("objeto") or "-"
    return (
        f"Situação da obra: {tit} ({oid})\n"
        f"  Servível   : {servivel}\n"
        f"  Degrau     : {degrau}\n"
        f"  Desde      : {desde}\n"
        f"  Impressão  : {imp}\n"
        f"  Objeto     : {obj}"
    )


def acao_situacao(obra: str, como_json: bool, headers: dict) -> int:
    # `?expurgadas=true` carrega SÓ o catálogo das expurgadas (servidor): obra viva vira 404.
    # Primeiro o catálogo vivo; expurgada só no 404, como segunda leitura.
    base_url = f"{BASE}/acervo/obras/{urllib.parse.quote(obra, safe='')}/situacao"
    resp = None
    for qs in ("", "?expurgadas=true"):
        try:
            resp = requests.get(base_url + qs, headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if resp.status_code >= 500:
            falha_indeterminavel(resp)
        if resp.status_code != 404:
            break
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        print(formatar_situacao(data))
    return 0


def acao_expurgar(obra: str, autor: str, como_json: bool, headers: dict, confirmado: bool = False) -> int:
    obra_id = resolver_obra_id(obra, headers)
    if not confirmado:
        sys.stderr.write(f"Confirma expurgo da obra '{obra}' ({obra_id})? Digite 'sim' para confirmar: ")
        sys.stderr.flush()
        try:
            resp_conf = input().strip()
        except EOFError:
            resp_conf = ""
        if resp_conf.lower() != "sim":
            sys.stderr.write("Expurgo cancelado.\n")
            return 1

    url = f"{BASE}/acervo/obras/{obra_id}?autor={urllib.parse.quote(autor)}"
    try:
        resp = requests.delete(url, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 204:
        falha_problem(resp)

    if como_json:
        print(json.dumps({"expurgada": True, "obra_id": obra_id, "autor": autor}, indent=2, ensure_ascii=False))
    else:
        print(f"Obra {obra_id} expurgada com sucesso.")
    return 0


def acao_restaurar(obra: str, autor: str, como_json: bool, headers: dict) -> int:
    obra_id = resolver_obra_id(obra, headers, expurgadas=True)
    url = f"{BASE}/acervo/obras/{obra_id}"
    payload = {
        "autor": autor,
        "expurgada": False,
    }
    try:
        resp = requests.patch(url, json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        print(f"Obra {obra_id} restaurada com sucesso.")
    return 0


def acao_promover(obra: str, impressao_id: str, autor: str, como_json: bool, headers: dict) -> int:
    obra_id = resolver_obra_id(obra, headers)
    url = f"{BASE}/acervo/obras/{obra_id}/promover"
    payload = {
        "autor": autor,
        "impressao_id": impressao_id,
    }
    try:
        resp = requests.post(url, json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        prom = data.get("promovida", {})
        apos = data.get("aposentada") or {}
        apos_str = f" (aposentada: {apos.get('id')})" if apos.get("id") else ""
        print(f"Impressão {prom.get('id')} promovida a servindo com sucesso{apos_str}.")
        print(f"Obra {data.get('obra_id')}: servível=sim, degrau={data.get('degrau')}")
    return 0


# Espelho de motor_acervo.relacao_conceito.MOLDES (conhecimento) — a API serve o mesmo em
# GET /acervo/conceitos/relacoes/cartilha; aqui fica o que --help imprime sem rede.
CARTILHA = """cartilha de --relacionar — A = <de>, B = <para>; o motivo tem de caber na frase-molde

hierárquicas (ont:0080; sobem na expansão da busca):
  generica      A é um tipo/forma/escola/método de B; A é B aplicado a X
  partitiva     A é uma camada/estágio/elo/dimensão de B
  instancia     A é um B específico; A é o que instancia B
associativas (ont:0080; vizinhança, não herança):
  instrumental  A é o instrumento/mecanismo/artefato de B
  condicional   A é exigência/condição/restrição/critério de B
  tematica      B é o assunto largo de A; A é o objeto de B
  patologica    A é a falha/risco/degradação de B
  aferidora     A afere B; A é a medida de B
  economica     A é o custo/preço de B
simétricas (gravam uma vez, ordem canônica de uuid):
  relacionada   A e B andam colados, sem direção nem hierarquia (skos:related, ont:0085)
  disjunta      A e B nunca são a mesma coisa (owl:disjointWith, ont:0086 4b) — homonímia ou exclusão

garantias (Z39.19 §5.3.5; caderno de ontologia 02/09):
  literaria     obra do acervo sustenta — exige --lastro (obra não expurgada)
  de-uso        pergunta feita ao motor sustenta (evento_recuperacao)
  instituida    dono ou cadeira afirma — não precisa de trecho (ont:0078)

regras que o plano aplica antes de gravar:
  - a coluna mais_amplo_id é o pai de navegação: repetir o mesmo pai/tipo é duplicata (409);
  - pai e lateral ao mesmo tempo é recusado para o par, nos dois sentidos (ont:0080 Aberto; SKOS S27);
  - conferências SQL rodam com a aresta dentro (ciclo, categoria, exclusividade, ciclo da coluna):
    qualquer linha NOVA reprova; HermiT roda com a aresta em memória e o diff de insatisfazíveis
    tem de ser vazio;
  - aresta cruzando domínio: lavra a cadeira do <de>, avisa a outra pela fila (mesa dados #22).
depois de --apply: o export ontologia/acervo/conceito_relacao.jsonl é regenerado no clone de
conhecimento — commit e push são da cadeira que lavrou.
"""

_PROJECAO_REL = "ontologia/projecao/gerar-e-raciocinar.py"


def _repo_conhecimento() -> str | None:
    """Clone de conhecimento em `main` — o export e a projeção escrevem/leem daí. Um clone
    parado em branch de fábrica NÃO serve (03/09: clone principal ficou em fabrica/2974)."""
    cands = [os.environ.get("PF_CONHECIMENTO_DIR"),
             os.path.expanduser("~/AI/platafirma-conhecimento"),
             os.path.expanduser("~/AI/var/wt/conhecimento-main")]
    for d in cands:
        if not d or not os.path.isfile(os.path.join(d, _PROJECAO_REL)):
            continue
        try:
            br = subprocess.run(["git", "-C", d, "branch", "--show-current"], capture_output=True, text=True, check=False).stdout.strip()
        except OSError:
            br = ""
        if br == "main":
            return d
    return None


def _hermit(de: str, para: str, tipo: str) -> dict | None:
    """Projeção formal duas vezes (sem e com a aresta em memória) e diff de insatisfazíveis.
    Devolve None quando não dá para rodar (sem clone em main, sem venv, script falhou)."""
    repo = _repo_conhecimento()
    py = os.environ.get("PF_PROJECAO_PYTHON") or os.path.expanduser("~/AI/.venv/bin/python")
    if not repo or not os.path.isfile(py):
        return None
    script = os.path.join(repo, _PROJECAO_REL)
    tmp = os.path.expanduser("~/AI/tmp")
    os.makedirs(tmp, exist_ok=True)

    def roda(extra, ttl):
        r = subprocess.run([py, script, "--json", "--ttl", ttl, *extra], capture_output=True, text=True, cwd=repo, check=False)
        if r.returncode:
            raise RuntimeError((r.stderr or r.stdout).strip()[-400:])
        return json.loads(r.stdout.strip().splitlines()[-1])
    try:
        base = roda([], os.path.join(tmp, "projecao-base.ttl"))
        com = roda(["--mais", f"{de}:{para}:{tipo}"], os.path.join(tmp, "projecao-plano.ttl"))
    except (RuntimeError, ValueError, OSError) as e:
        return {"erro": str(e)}
    b, c = set(base["insatisfaziveis"]), set(com["insatisfaziveis"])
    return {"antes": len(b), "depois": len(c), "novos": sorted(c - b), "saem": sorted(b - c),
            "triplas": (base["triplas"], com["triplas"]), "repo": repo}


def _exportar(repo: str) -> str | None:
    """Regenera ontologia/acervo/*.jsonl no clone (cli exportar-acervo). Devolve os arquivos
    alterados segundo o git, ou None se não deu para rodar."""
    py = os.environ.get("PF_EXPORT_PYTHON") or os.path.expanduser("~/AI/.venv-testes/bin/python")
    if not os.path.isfile(py):
        return None
    r = subprocess.run([py, "-m", "motor_acervo.cli", "exportar-acervo"], capture_output=True, text=True,
                       cwd=os.path.join(repo, "rag"), check=False)
    if r.returncode:
        return f"exportar-acervo falhou: {(r.stderr or r.stdout).strip()[-300:]}"
    g = subprocess.run(["git", "-C", repo, "status", "--short", "--", "ontologia/acervo"], capture_output=True, text=True, check=False)
    return g.stdout.strip() or "(export igual ao versionado)"


def formatar_plano_relacao(p: dict, hermit: dict | None) -> str:
    a = p.get("aresta", {})
    seta = "<->" if a.get("simetrica") else "->"
    titulo = "Aresta aplicada" if p.get("modo") == "aplicado" else "Plano de aresta"
    cabeca = (f"{titulo}: {a.get('de')} -{a.get('tipo')}{seta} {a.get('para')}  "
              f"[{a.get('familia')}; garantia {a.get('garantia')}; curador {p.get('emitido_por')}]")
    lin = [cabeca]
    if a.get("ordem_canonica"):
        lin.append("  (simétrica: gravada em ordem canônica de uuid — de/para trocados, sem efeito)")
    lin.append(f"  motivo : {a.get('motivo')}")
    lin.append(f"  molde  : {p.get('molde')}")
    if p.get("lastro"):
        lin.append(f"  lastro : {p['lastro'].get('titulo')} ({p['lastro'].get('id')})")
    for nome, c in (p.get("conferencias") or {}).items():
        novas = c.get("novas") or []
        tag = "OK" if not novas else f"REPROVA +{len(novas)}"
        lin.append(f"  conferência {nome:<14} {c.get('antes')} -> {c.get('depois')}  {tag}")
        for r in novas[:5]:
            lin.append(f"      + {r}")
    if hermit is None:
        lin.append("  HermiT: indisponível (clone de conhecimento em main + ~/AI/.venv/bin/python não achados)")
    elif hermit.get("erro"):
        lin.append(f"  HermiT: falhou — {hermit['erro']}")
    else:
        tag = "OK" if not hermit["novos"] else f"REPROVA +{len(hermit['novos'])}"
        lin.append(f"  HermiT insatisfazíveis {hermit['antes']} -> {hermit['depois']}  {tag}"
                   + (f"  novos: {', '.join(hermit['novos'])}" if hermit["novos"] else "")
                   + (f"  saem: {', '.join(hermit['saem'])}" if hermit["saem"] else ""))
    if p.get("modo") == "aplicado":
        lin.append(f"  id     : {p.get('id')}   (desfazer: curar --desrelacionar {p.get('id')})")
    else:
        lin.append(f"  veredito: {'APROVADO — repita com --apply para gravar' if p.get('aprovado') and not (hermit or {}).get('novos') and not (hermit or {}).get('erro') else 'REPROVADO — nada gravado'}")
    return "\n".join(lin)


def formatar_plano_conceito(p: dict) -> str:
    c = p.get("conceito", {})
    lin = [f"conceito : {c.get('slug')}  «{c.get('rotulo')}»",
           f"  natureza/estatuto: {c.get('natureza')} / {c.get('estatuto')}"]
    if c.get("mais_amplo"):
        lin.append(f"  pai      : {c.get('mais_amplo')}  ({c.get('mais_amplo_tipo')})")
    rots = c.get("rotulos", [])
    alt = [r for r in rots if r.get("papel") != "preferido"]
    if alt:
        lin.append("  rótulos  : +" + str(len(alt)) + " alt — " +
                   ", ".join(f"{r['rotulo']}[{r['lingua']}]" for r in alt))
    if c.get("trata_de"):
        lin.append(f"  trata_de : {len(c['trata_de'])} obra(s)")
    for nome, d in (p.get("conferencias") or {}).items():
        marca = "OK" if not d.get("novas") else f"REPROVOU +{len(d['novas'])}"
        lin.append(f"  conf {nome:<13}: {marca}")
    for nome, d in (p.get("avisos") or {}).items():
        if d.get("linhas"):
            lin.append(f"  aviso {nome:<12}: {d['linhas']} linha(s) (não bloqueia)")
    lin.append(f"  emitido_por: {p.get('emitido_por')}")
    if p.get("modo") == "aplicado":
        ver = f"GRAVADO — id {p.get('id')}"
    elif p.get("aprovado"):
        ver = "APROVADO — repita com --apply para gravar"
    else:
        ver = "REPROVADO — nada gravado"
    lin.append(f"  veredito : {ver}")
    return "\n".join(lin)


def acao_conceito(args, autor: str, como_json: bool, headers: dict) -> int:
    slug = args.conceito
    faltam = [k for k in ("rotulo", "definicao", "natureza", "estatuto") if not getattr(args, k)]
    if faltam:
        sys.stderr.write(f"curar: erro: --conceito exige --{' --'.join(faltam)}\n")
        return 2
    if bool(args.mais_amplo) != bool(args.mais_amplo_tipo):
        sys.stderr.write("curar: erro: --mais-amplo e --mais-amplo-tipo andam juntos\n")
        return 2
    corpo = {"slug": slug, "rotulo": args.rotulo, "definicao": args.definicao,
             "natureza": args.natureza, "estatuto": args.estatuto, "autor": autor}
    if args.lingua:
        corpo["lingua"] = args.lingua
    if args.endereco:
        corpo["endereco"] = args.endereco
    if args.filhos_exclusivos:
        corpo["filhos_exclusivos"] = True
    if args.mais_amplo:
        corpo["mais_amplo"] = args.mais_amplo
        corpo["mais_amplo_tipo"] = args.mais_amplo_tipo
    alts = []
    for item in (args.rotulo_alt or []):
        if "|" not in item:
            sys.stderr.write(f"curar: erro: --rotulo-alt no formato 'lingua|rotulo' (ex: 'en|site reliability engineering'): {item}\n")
            return 2
        lg, r = item.split("|", 1)
        alts.append({"lingua": lg.strip(), "rotulo": r.strip()})
    if alts:
        corpo["rotulos_alt"] = alts
    if args.trata_de:
        corpo["trata_de"] = [resolver_obra_id(o, headers) for o in _parse_lista(args.trata_de)]

    def post(aplicar: bool):
        try:
            r = requests.post(f"{BASE}/acervo/conceitos", json={**corpo, "aplicar": aplicar}, headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if r.status_code >= 500:
            falha_indeterminavel(r)
        return r

    resp = post(False)
    if resp.status_code != 200:
        try:
            pj = resp.json()
        except ValueError:
            pj = {}
        if isinstance(pj, dict) and pj.get("plano"):
            print(formatar_plano_conceito(pj["plano"]))
        falha_problem(resp)
    plano = resp.json()

    if not args.apply:
        if como_json:
            print(json.dumps({"plano": plano}, indent=2, ensure_ascii=False))
        else:
            print(formatar_plano_conceito(plano))
        return 0 if plano.get("aprovado") else 1

    if not plano.get("aprovado"):
        print(formatar_plano_conceito(plano))
        sys.stderr.write("curar: conceito reprovado nas conferências — nada gravado\n")
        return 1
    resp = post(True)
    if resp.status_code not in (200, 201):
        falha_problem(resp)
    aplicado = resp.json()
    if como_json:
        print(json.dumps(aplicado, indent=2, ensure_ascii=False))
    else:
        print(formatar_plano_conceito(aplicado))
    return 0


def acao_relacionar(args, autor: str, como_json: bool, headers: dict) -> int:
    pos = args.relacionar or []
    if args.ajuda or not pos:
        print(CARTILHA)
        return 0 if args.ajuda else 2
    if len(pos) != 2:
        sys.stderr.write("curar: erro: --relacionar espera exatamente <de> <para>\n")
        return 2
    faltam = [k for k in ("tipo", "garantia", "motivo") if not getattr(args, k)]
    if faltam:
        sys.stderr.write(f"curar: erro: --relacionar exige --{' --'.join(faltam)} (veja --relacionar --help)\n")
        return 2
    de, para = pos
    corpo = {"de": de, "para": para, "tipo": args.tipo, "garantia": args.garantia, "motivo": args.motivo, "autor": autor}
    if args.lastro:
        corpo["lastro"] = resolver_obra_id(args.lastro, headers)

    def post(aplicar: bool):
        try:
            r = requests.post(f"{BASE}/acervo/conceitos/relacoes", json={**corpo, "aplicar": aplicar}, headers=headers)
        except requests.exceptions.RequestException as e:
            falha_indeterminavel(e)
        if r.status_code >= 500:
            falha_indeterminavel(r)
        return r

    # 1. plano seco na API (validação + conferências SQL com a aresta dentro, sem gravar)
    resp = post(False)
    if resp.status_code != 200:
        try:
            pj = resp.json()
        except ValueError:
            pj = {}
        if isinstance(pj, dict) and pj.get("plano"):
            print(formatar_plano_relacao(pj["plano"], None))
        falha_problem(resp)
    plano = resp.json()

    # 2. projeção formal com a aresta em memória
    hermit = None if args.sem_hermit else _hermit(plano["aresta"]["de"], plano["aresta"]["para"], plano["aresta"]["tipo"])
    hermit_ok = args.sem_hermit or (hermit is not None and not hermit.get("erro") and not hermit["novos"])
    aprovado = bool(plano.get("aprovado")) and hermit_ok

    if not args.apply:
        if como_json:
            print(json.dumps({"plano": plano, "hermit": hermit, "aprovado": aprovado}, indent=2, ensure_ascii=False))
        else:
            print(formatar_plano_relacao(plano, hermit))
        return 0 if aprovado else 1

    if not aprovado:
        print(formatar_plano_relacao(plano, hermit))
        if not plano.get("aprovado"):
            sys.stderr.write("curar: conferência SQL reprovou; nada gravado\n")
        elif hermit is None or hermit.get("erro"):
            sys.stderr.write("curar: HermiT não rodou; para gravar mesmo assim passe --sem-hermit\n")
        else:
            sys.stderr.write("curar: HermiT reprovou (insatisfazíveis novos); nada gravado\n")
        return 1

    # 3. grava
    resp = post(True)
    if resp.status_code != 201:
        falha_problem(resp)
    feito = resp.json()
    export = _exportar(hermit["repo"]) if hermit and hermit.get("repo") else (_exportar(_repo_conhecimento()) if _repo_conhecimento() else None)
    if como_json:
        print(json.dumps({"aplicado": feito, "hermit": hermit, "export": export}, indent=2, ensure_ascii=False))
    else:
        print(formatar_plano_relacao(feito, hermit))
        if export is None:
            print("  export : NÃO regenerado (clone de conhecimento em main / venv não achados) — rode `exportar-acervo` e commite")
        else:
            print(f"  export : regenerado no clone — commit e push são seus:\n    {export.replace(chr(10), chr(10) + '    ')}")
    return 0


def acao_relacoes(conceito: str, como_json: bool, headers: dict) -> int:
    url = f"{BASE}/acervo/conceitos/{urllib.parse.quote(conceito, safe='')}/relacoes"
    try:
        resp = requests.get(url, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    itens = data.get("itens", [])
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    print(f"Arestas de {conceito}: {len(itens)}")
    for a in itens:
        seta = "->" if a.get("direcao") == "saida" else "<-"
        origem = a.get("origem") or "coluna"
        extra = f"  [{a.get('garantia')}] {a.get('motivo')}" if a.get("motivo") else ""
        idt = f"  id {a['id']}" if a.get("id") else ""
        print(f"  {seta} {a.get('conceito'):<36} {a.get('tipo'):<13} {a.get('papel'):<15} {origem}{extra}{idt}")
    return 0


def acao_desrelacionar(relacao_id: str, autor: str, como_json: bool, headers: dict, confirmado: bool = False) -> int:
    if not _UUID_RE.match(relacao_id.strip()):
        sys.stderr.write("curar: erro: --desrelacionar espera o uuid da aresta (veja --relacoes <conceito>)\n")
        return 2
    if not confirmado:
        try:
            ans = input(f"Desfazer a aresta {relacao_id}? digite 'sim' para confirmar: ")
        except EOFError:
            ans = ""
        if ans.strip().lower() != "sim":
            print("cancelado")
            return 1
    url = f"{BASE}/acervo/conceitos/relacoes/{relacao_id.strip()}?autor={urllib.parse.quote(autor)}"
    try:
        resp = requests.delete(url, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    repo = _repo_conhecimento()
    export = _exportar(repo) if repo else None
    if como_json:
        print(json.dumps({**data, "export": export}, indent=2, ensure_ascii=False))
    else:
        d = data.get("desfeita", {})
        print(f"Aresta desfeita: {d.get('de')} -{d.get('tipo')}-> {d.get('para')} [{d.get('garantia')}] ({d.get('id')})")
        print("  export : " + (export.replace(chr(10), chr(10) + '    ') if export else "NÃO regenerado — rode `exportar-acervo` e commite"))
    return 0


def acao_reclassificar(args, autor: str, como_json: bool, headers: dict) -> int:
    alteracao = {}
    if args.dominio is not None:
        alteracao["dominio"] = None if args.dominio.lower() in ("null", "none", "") else args.dominio
    if args.subdominio is not None:
        alteracao["subdominio"] = None if args.subdominio.lower() in ("null", "none", "") else args.subdominio
    if args.especie is not None:
        alteracao["especie"] = None if args.especie.lower() in ("null", "none", "") else args.especie
    if args.anotacao is not None:
        alteracao["anotacao"] = args.anotacao

    trata_de = _parse_lista(args.trata_de) if args.trata_de else []
    remover_trata_de = _parse_lista(args.remover_trata_de) if args.remover_trata_de else []
    substituir_trata_de = _parse_lista(args.substituir_trata_de) if args.substituir_trata_de else []

    cont_delta = sum(bool(x) for x in (trata_de, remover_trata_de, substituir_trata_de))
    if cont_delta > 1:
        sys.stderr.write("curar: erro: use apenas uma das opções de conceitos: --trata-de, --remover-trata-de ou --substituir-trata-de\n")
        sys.exit(2)
    elif trata_de:
        alteracao["conceitos"] = {"adicionar": trata_de}
    elif remover_trata_de:
        alteracao["conceitos"] = {"remover": remover_trata_de}
    elif substituir_trata_de:
        alteracao["conceitos"] = {"substituir": substituir_trata_de}

    if args.obra:
        obra_id = resolver_obra_id(args.obra, headers)
        if not args.apply:
            payload = {
                "autor": autor,
                "selecao": {"ids": [obra_id]},
                "alteracao": alteracao,
                "modo": "plano",
                "teto": args.teto,
            }
            url = f"{BASE}/acervo/obras"
            try:
                resp = requests.patch(url, json=payload, headers=headers)
            except requests.exceptions.RequestException as e:
                falha_indeterminavel(e)
            if resp.status_code >= 500:
                falha_indeterminavel(resp)
            if resp.status_code != 200:
                falha_problem(resp)
            data = resp.json()
            if como_json:
                print(json.dumps(data, indent=2, ensure_ascii=False))
            else:
                print(formatar_lote_resultado(data))
            return 0
        else:
            url = f"{BASE}/acervo/obras/{obra_id}"
            payload = {
                "autor": autor,
                **alteracao,
            }
            try:
                resp = requests.patch(url, json=payload, headers=headers)
            except requests.exceptions.RequestException as e:
                falha_indeterminavel(e)
            if resp.status_code >= 500:
                falha_indeterminavel(resp)
            if resp.status_code != 200:
                falha_problem(resp)
            data = resp.json()
            if como_json:
                print(json.dumps(data, indent=2, ensure_ascii=False))
            else:
                print(f"Obra {obra_id} reclassificada com sucesso:")
                print(f"  Título     : {data.get('titulo')}")
                print(f"  Domínio    : {data.get('dominio')} / {data.get('subdominio')}")
                print(f"  Espécie    : {data.get('especie')}")
                print(f"  Conceitos  : {', '.join(data.get('conceitos', []))}")
            return 0

    selecao = {}
    obras_lista = _parse_lista(args.obras) if args.obras else []
    if obras_lista:
        resolved_ids = [resolver_obra_id(x, headers) for x in obras_lista]
        selecao["ids"] = resolved_ids
    elif args.de_dominio:
        selecao["dominio"] = args.de_dominio
        if args.de_subdominio:
            selecao["subdominio"] = args.de_subdominio
    elif args.de_conceito:
        selecao["conceito"] = args.de_conceito
    elif args.de_colecao:
        selecao["colecao"] = args.de_colecao
    elif args.sem_dominio:
        selecao["sem_dominio"] = True
    elif args.expurgadas:
        selecao["expurgadas"] = True
    else:
        sys.stderr.write("curar: erro: reclassificação exige seleção (--obras, --de-dominio, etc.) ou --obra\n")
        sys.exit(2)

    if not alteracao:
        sys.stderr.write("curar: erro: nenhuma alteração informada (--trata-de, --dominio, --subdominio, etc.)\n")
        sys.exit(2)

    modo = "aplicar" if args.apply else "plano"
    payload = {
        "autor": autor,
        "selecao": selecao,
        "alteracao": alteracao,
        "modo": modo,
        "teto": args.teto,
    }
    url = f"{BASE}/acervo/obras"
    try:
        resp = requests.patch(url, json=payload, headers=headers)
    except requests.exceptions.RequestException as e:
        falha_indeterminavel(e)
    if resp.status_code >= 500:
        falha_indeterminavel(resp)
    if resp.status_code != 200:
        falha_problem(resp)
    data = resp.json()
    if como_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        print(formatar_lote_resultado(data))
    return 0


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    parser = argparse.ArgumentParser(
        prog="curar",
        description="Cliente fino da API de curadoria do acervo.",
        add_help=False,
    )
    # Ações
    parser.add_argument("--reclassificar", action="store_true", default=False)
    parser.add_argument("--situacao", default=None)
    parser.add_argument("--expurgar", default=None)
    parser.add_argument("--restaurar", default=None)
    parser.add_argument("--promover", default=None)
    parser.add_argument("--relacionar", nargs="*", default=None)
    parser.add_argument("--relacoes", default=None)
    parser.add_argument("--desrelacionar", default=None)
    parser.add_argument("--conceito", default=None)
    parser.add_argument("--rotulo", default=None)
    parser.add_argument("--definicao", default=None)
    parser.add_argument("--natureza", default=None)
    parser.add_argument("--estatuto", default=None)
    parser.add_argument("--endereco", default=None)
    parser.add_argument("--lingua", default=None)
    parser.add_argument("--mais-amplo", dest="mais_amplo", default=None)
    parser.add_argument("--mais-amplo-tipo", dest="mais_amplo_tipo", default=None)
    parser.add_argument("--rotulo-alt", dest="rotulo_alt", action="append", default=None)
    parser.add_argument("--filhos-exclusivos", dest="filhos_exclusivos", action="store_true", default=False)
    parser.add_argument("--tipo", default=None)
    parser.add_argument("--garantia", default=None)
    parser.add_argument("--motivo", default=None)
    parser.add_argument("--lastro", default=None)
    parser.add_argument("--sem-hermit", dest="sem_hermit", action="store_true", default=False)

    # Alterações
    parser.add_argument("--trata-de", default=None)
    parser.add_argument("--remover-trata-de", default=None)
    parser.add_argument("--substituir-trata-de", default=None)
    parser.add_argument("--dominio", default=None)
    parser.add_argument("--subdominio", default=None)
    parser.add_argument("--especie", default=None)
    parser.add_argument("--anotacao", default=None)

    # Seleção
    parser.add_argument("--obras", nargs="*", default=None)
    parser.add_argument("--obra", default=None)
    parser.add_argument("--de-dominio", default=None)
    parser.add_argument("--de-subdominio", default=None)
    parser.add_argument("--de-conceito", default=None)
    parser.add_argument("--de-colecao", default=None)
    parser.add_argument("--sem-dominio", action="store_true", default=False)
    parser.add_argument("--expurgadas", action="store_true", default=False)
    parser.add_argument("--teto", type=int, default=200)

    # Gerais
    parser.add_argument("--apply", action="store_true", default=False)
    parser.add_argument("--autor", default=None)
    parser.add_argument("--impressao", default=None)
    parser.add_argument("--json", dest="como_json", action="store_true", default=False)
    parser.add_argument("--sim", "-y", dest="confirmado", action="store_true", default=False)
    parser.add_argument("-h", "--help", "--ajuda", dest="ajuda", action="store_true", default=False)

    args, desconhecidos = parser.parse_known_args(argv)

    if args.ajuda and args.relacionar is not None:
        print(CARTILHA)
        sys.exit(0)
    if args.ajuda or (not argv):
        sys.stdout.write(USO)
        sys.exit(0 if args.ajuda else 2)

    autor = args.autor
    if not autor:
        cad = (os.environ.get("PF_CADEIRA") or os.environ.get("PF_CONTA") or "").strip().lower()
        if cad:
            autor = cad.removeprefix("claudinho-").removeprefix("claudinha-")
        else:
            autor = "dados"

    headers = {}
    if TOKEN:
        headers["authorization"] = f"Bearer {TOKEN}"
    traceparent = f"00-{secrets.token_hex(16)}-{secrets.token_hex(8)}-01"
    headers["traceparent"] = traceparent

    if args.conceito:
        return acao_conceito(args, autor, args.como_json, headers)
    if args.relacionar is not None:
        return acao_relacionar(args, autor, args.como_json, headers)
    elif args.relacoes:
        return acao_relacoes(args.relacoes, args.como_json, headers)
    elif args.desrelacionar:
        return acao_desrelacionar(args.desrelacionar, autor, args.como_json, headers, confirmado=args.confirmado)
    elif args.situacao:
        return acao_situacao(args.situacao, args.como_json, headers)
    elif args.expurgar:
        return acao_expurgar(args.expurgar, autor, args.como_json, headers, confirmado=args.confirmado)
    elif args.restaurar:
        return acao_restaurar(args.restaurar, autor, args.como_json, headers)
    elif args.promover:
        if not args.impressao:
            sys.stderr.write("curar: erro: --promover exige --impressao <id>\n")
            sys.exit(2)
        return acao_promover(args.promover, args.impressao, autor, args.como_json, headers)
    elif args.reclassificar or args.obra or args.obras or args.de_dominio or args.trata_de or args.remover_trata_de or args.substituir_trata_de:
        return acao_reclassificar(args, autor, args.como_json, headers)
    else:
        sys.stderr.write(USO)
        sys.stderr.write("curar: erro: nenhuma ação especificada\n")
        sys.exit(2)


if __name__ == "__main__":
    sys.exit(main())
