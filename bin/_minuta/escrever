#!/usr/bin/env bash
# minuta escrever — numera e grava o esqueleto do protocolo. Não commita, não
# circula: entre o esqueleto e a circulação existe o texto que só a cadeira
# escreve. Protocolo: minutas/PROTOCOLO.md §2-3.
set -euo pipefail

REPO="${MINUTA_REPO:-$HOME/AI/platafirma-arquitetura}"
DIR="$REPO/minutas"

uso() {
  echo "uso: minuta escrever <slug> --convoca <c1>[,<c2>...] [--fecha <cadeira|pedro>] [--card <#N>]" >&2
  exit 2
}

[ $# -ge 1 ] || uso
SLUG="$1"; shift
CONVOCA=""
FECHA="Pedro"
CARD=""

while [ $# -gt 0 ]; do
  case "$1" in
    --convoca) CONVOCA="$2"; shift 2 ;;
    --fecha)   FECHA="$2"; shift 2 ;;
    --card)    CARD="$2"; shift 2 ;;
    *) echo "minuta escrever: opção desconhecida '$1'" >&2; uso ;;
  esac
done

[ -n "$CONVOCA" ] || { echo "minuta escrever: --convoca é obrigatório (protocolo §1 — três ou mais cadeiras com posição própria)." >&2; exit 2; }

CADEIRA="${PF_CADEIRA:-}"
[ -n "$CADEIRA" ] || { echo "minuta escrever: exporte PF_CADEIRA=<cadeira>." >&2; exit 2; }

[[ "$SLUG" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || { echo "minuta escrever: slug precisa ser kebab-case (a-z0-9-)." >&2; exit 2; }

mkdir -p "$DIR"
# Numero nunca recicla. Minuta formalizada e APAGADA (protocolo §5), entao contar
# so o que esta no disco reemitiria o numero de uma minuta ja fechada — e toda
# citacao antiga a "minuta NNNN" (commit, card, carta) passaria a apontar pra outra
# coisa. O teto sai do maior entre o disco e o historico do git, que guarda as mortas.
NO_DISCO=$(find "$DIR" -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-*.md' -printf '%f\n' 2>/dev/null \
  | sed -E 's/^([0-9]{4})-.*/\1/' | sort -n | tail -1)
NO_HISTORICO=$(git -C "$REPO" log --pretty=format: --name-only --diff-filter=A -- 'minutas/*.md' 2>/dev/null \
  | sed -nE 's#^minutas/([0-9]{4})-.*\.md$#\1#p' | sort -n | tail -1)
ULTIMO=$(printf '%s\n%s\n0000\n' "$NO_DISCO" "$NO_HISTORICO" | grep -E '^[0-9]{4}$' | sort -n | tail -1)
N=$(printf '%04d' $((10#$ULTIMO + 1)))

ARQ="$DIR/${N}-${SLUG}.md"
[ -e "$ARQ" ] && { echo "minuta escrever: $ARQ já existe (corrida de numeração?) — rode de novo." >&2; exit 1; }

# convocadas: trim de espaço em cada elemento da lista separada por vírgula
IFS=',' read -ra CADS_RAW <<< "$CONVOCA"
CADS=()
for c in "${CADS_RAW[@]}"; do
  c="$(echo "$c" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [ -n "$c" ] && CADS+=("$c")
done
[ "${#CADS[@]}" -ge 1 ] || { echo "minuta escrever: --convoca veio vazio depois de aparado." >&2; exit 2; }
for c in "${CADS[@]}"; do
  [ "$c" = "$CADEIRA" ] && { echo "minuta escrever: '${CADEIRA}' já tem seção própria por abrir a minuta — não se lista em --convoca." >&2; exit 2; }
done

# Esqueleto de uma posicao. Tres subsecoes, e nao um campo so: diagnostico e
# proposta misturados sao o modo de falha nomeado pelo dono em 19/08/2026
# (PROTOCOLO §3). O placeholder repete nas tres porque a checagem de pauta vazia
# procura a string; apagar as tres e o ato de escrever a posicao.
posicao_esqueleto() {
  local ph="$1"
  echo "### Diagnóstico — o presente medido"
  echo "${ph}"
  echo "A1. <achado verificável na data, com a fonte>"
  echo
  echo "### Proposta — o que fazer"
  echo "${ph}"
  echo "B1. <o que fazer> (sustenta-se em A1)"
  echo
  echo "### O que não sei"
  echo "${ph}"
  echo "C1. <lacuna, e o que a fecharia — vazio aqui afirma que não há>"
  echo
}

TITULO="$(tr '-' ' ' <<<"$SLUG")"
TITULO="$(tr '[:lower:]' '[:upper:]' <<<"${TITULO:0:1}")${TITULO:1}"

{
  echo "# ${N} — ${TITULO}"
  echo
  echo "Aberta por: ${CADEIRA} · $(date +%F)"
  CONV_LINE=""
  for c in "${CADS[@]}"; do
    if [ -z "$CONV_LINE" ]; then CONV_LINE="$c"; else CONV_LINE="${CONV_LINE}, ${c}"; fi
  done
  echo "Convocadas: ${CONV_LINE}"
  echo "Fecha: ${FECHA}"
  [ -n "$CARD" ] && echo "Card: ${CARD}"
  echo
  echo "## Pergunta"
  echo "<uma frase: a decisão pedida>"
  echo
  echo "## Posição — ${CADEIRA}"
  echo
  posicao_esqueleto "<escreva aqui antes de circular>"
  for c in "${CADS[@]}"; do
    echo "## Posição — ${c}"
    echo
    posicao_esqueleto "<a preencher pela própria cadeira>"
  done
  echo "## Divergência"
  echo "<só o que sobrou em conflito depois das posições>"
  echo
  echo "## Decisão"
  echo "<preenchida por quem fecha, com ponteiro para o canônico>"
} > "$ARQ"

echo "$ARQ"
