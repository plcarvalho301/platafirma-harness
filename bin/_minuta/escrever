#!/usr/bin/env bash
# minuta escrever — numera, grava e PUBLICA o esqueleto (commit+push no nascimento,
# 07/09/2026): o dono nao le clone local, minuta so no disco e rascunho invisivel.
# Nao circula — entre o esqueleto e a circulacao existe o merito que so a cadeira
# escreve, e 'circular' barra pauta vazia. Protocolo: padrao protocolo-de-minuta §2-3.
set -euo pipefail

# Onde escreve: platafirma-casa e repositorio de deliberacao e commita direto em main
# (arq:0083 §1; ordem do dono de 28/09/2026; regime declarado em bin/repo). A worktree e
# a de main da cadeira, <bancada>/wt/platafirma-casa/<cadeira>/main, resolvida (e aberta
# por `repo abrir platafirma-casa` quando falta) por _casa.py, o mesmo de circular e
# formalizar. MINUTA_REPO aponta outro checkout (teste).
ATOS="$(dirname "$(readlink -f "$0")")"
CASA="$ATOS/_casa.py"

# git e gh pelo caminho real: o PATH da porta tem shims que so saem 2 (ver _casa.py).
GIT="$(command -v /usr/bin/git /bin/git 2>/dev/null | head -1 || true)"
[ -n "$GIT" ] || GIT=git
GH_REAL="$(command -v /usr/bin/gh /bin/gh "$HOME/.local/bin/gh" 2>/dev/null | head -1 || true)"
[ -z "$GH_REAL" ] || export PATH="$(dirname "$GH_REAL"):$PATH"

uso() {
  echo "uso: minuta escrever <slug> --convoca <c1>[,<c2>...] [--fecha <cadeira|pedro>] [--card <#N>]" >&2
  exit 2
}

[ $# -ge 1 ] || uso
SLUG="$1"; shift
CONVOCA=""
FECHA="Pedro"
CARD=""

while [ $# -gt 0 ]; do
  case "$1" in
    --convoca) CONVOCA="${2:-}"; shift 2 || uso ;;
    --fecha)   FECHA="${2:-}"; shift 2 || uso ;;
    --card)    CARD="${2:-}"; shift 2 || uso ;;
    *) echo "minuta escrever: opção desconhecida '$1'" >&2; uso ;;
  esac
done

[ -n "$CONVOCA" ] || { echo "minuta escrever: --convoca é obrigatório (protocolo §1 — três ou mais cadeiras com posição própria)." >&2; exit 2; }

CADEIRA="${PF_CADEIRA:-}"
[ -n "$CADEIRA" ] || { echo "minuta escrever: exporte PF_CADEIRA=<cadeira>." >&2; exit 2; }

[[ "$SLUG" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || { echo "minuta escrever: slug precisa ser kebab-case (a-z0-9-)." >&2; exit 2; }

# convocadas: trim de espaço em cada elemento da lista separada por vírgula
IFS=',' read -ra CADS_RAW <<< "$CONVOCA"
CADS=()
for c in "${CADS_RAW[@]}"; do
  c="$(echo "$c" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [ -n "$c" ] && CADS+=("$c")
done
[ "${#CADS[@]}" -ge 1 ] || { echo "minuta escrever: --convoca veio vazio depois de aparado." >&2; exit 2; }
for c in "${CADS[@]}"; do
  [ "$c" = "$CADEIRA" ] && { echo "minuta escrever: '${CADEIRA}' já tem seção própria por abrir a minuta — não se lista em --convoca." >&2; exit 2; }
done

# Worktree de main (sem ela: abre por repo abrir, ou sai 3 com a chamada exata) e pull
# ANTES de numerar: o numero sai do main de agora, nao da copia velha da cadeira.
REPO="$(python3 "$CASA" worktree escrever)" || exit $?
python3 "$CASA" puxar "$REPO" || exit $?
DIR="$REPO/minuta"

mkdir -p "$DIR"
# Numero nunca recicla. Minuta formalizada e APAGADA (protocolo §5), entao contar
# so o que esta no disco reemitiria o numero de uma minuta ja fechada — e toda
# citacao antiga a "minuta NNNN" (commit, card, carta) passaria a apontar pra outra
# coisa. O teto sai do maior entre o disco e o historico do git, que guarda as mortas.
NO_DISCO=$(find "$DIR" -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-*.md' -printf '%f\n' 2>/dev/null \
  | sed -E 's/^([0-9]{4})-.*/\1/' | sort -n | tail -1 || true)
NO_HISTORICO=$("$GIT" -C "$REPO" log --pretty=format: --name-only --diff-filter=A -- 'minuta/*.md' 2>/dev/null \
  | sed -nE 's#^minuta/([0-9]{4})-.*\.md$#\1#p' | sort -n | tail -1 || true)
ULTIMO=$(printf '%s\n%s\n0000\n' "$NO_DISCO" "$NO_HISTORICO" | grep -E '^[0-9]{4}$' | sort -n | tail -1)
N=$(printf '%04d' $((10#$ULTIMO + 1)))

ARQ="$DIR/${N}-${SLUG}.md"
[ -e "$ARQ" ] && { echo "minuta escrever: $ARQ já existe (corrida de numeração?) — rode de novo." >&2; exit 1; }

# Esqueleto de uma posicao. Tres subsecoes, e nao um campo so: diagnostico e
# proposta misturados sao o modo de falha nomeado pelo dono em 19/08/2026
# (PROTOCOLO §3). O placeholder repete nas tres porque a checagem de pauta vazia
# procura a string; apagar as tres e o ato de escrever a posicao.
posicao_esqueleto() {
  local ph="$1"
  echo "### Diagnóstico — o presente medido"
  echo "${ph}"
  echo "A1. <achado verificável na data, com a fonte>"
  echo
  echo "### Proposta — o que fazer"
  echo "${ph}"
  echo "B1. <o que fazer> (sustenta-se em A1)"
  echo
  echo "### O que não sei"
  echo "${ph}"
  echo "C1. <lacuna, e o que a fecharia — vazio aqui afirma que não há>"
  echo
}

TITULO="$(tr '-' ' ' <<<"$SLUG")"
TITULO="$(tr '[:lower:]' '[:upper:]' <<<"${TITULO:0:1}")${TITULO:1}"

CONV_LINE=""
for c in "${CADS[@]}"; do
  if [ -z "$CONV_LINE" ]; then CONV_LINE="$c"; else CONV_LINE="${CONV_LINE}, ${c}"; fi
done

{
  echo "# ${N} — ${TITULO}"
  echo
  # Espécie antes do primeiro ##: sem ela a ingestão recusa a minuta e ela não vira
  # ficha do acervo, que é por onde `minuta ler` a lê (arq:0115 §2.1, §7; #3225).
  echo "Espécie: minuta"
  echo
  echo "Aberta por: ${CADEIRA} · $(date +%F)"
  echo "Convocadas: ${CONV_LINE}"
  echo "Fecha: ${FECHA}"
  if [ -n "$CARD" ]; then echo "Card: ${CARD}"; fi
  echo
  echo "## Pergunta"
  echo "<uma frase: a decisão pedida>"
  echo
  echo "## Posição — ${CADEIRA}"
  echo
  posicao_esqueleto "<escreva aqui antes de circular>"
  for c in "${CADS[@]}"; do
    echo "## Posição — ${c}"
    echo
    posicao_esqueleto "<a preencher pela própria cadeira>"
  done
  echo "## Divergência"
  echo "<só o que sobrou em conflito depois das posições>"
  echo
  echo "## Decisão"
  echo "<preenchida por quem fecha, com ponteiro para o canônico>"
} > "$ARQ"

# Publica o esqueleto no nascimento. O dono NAO le clone local — arquivo parado em
# bancada e rascunho invisivel (oficio.md). Antes desta linha existia uma janela entre
# 'escrever' e 'circular' em que a minuta so vivia no clone de quem abriu, e quem
# pedia pra ver nao a encontrava. Publicar cedo (esqueleto) e publicar de novo (merito,
# antes de circular) vence rascunho invisivel: 'circular' ja barra pauta vazia, entao
# o esqueleto publicado nao circula sozinho. Ordem do dono, 07/09/2026. Publicar e
# empurrar para main (arq:0083): sem ramo, sem PR.
REL="$(realpath --relative-to="$REPO" "$ARQ")"
"$GIT" -C "$REPO" add -- "$REL" \
  || { echo "minuta escrever: git add falhou em $REPO — $ARQ ficou no disco, sem commit." >&2; exit 3; }
"$GIT" -C "$REPO" commit -q -m "minuta ${N}: esqueleto (${CADEIRA} abre, convoca ${CONV_LINE})" -- "$REL" \
  || { echo "minuta escrever: git commit falhou em $REPO (o pre-commit barrou? ver acima) — $ARQ ficou no disco." >&2; exit 3; }
python3 "$CASA" publicar "$REPO" || exit $?

echo "$ARQ"
