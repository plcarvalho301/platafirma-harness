#!/usr/bin/env python3
"""minuta circular — despacha o ping tipo:minuta às convocadas.
Recusa: seção de quem abriu vazia (pauta vazia não circula); minuta com
mudança não commitada (o ping aponta um ref que o destinatário precisa
conseguir ler). Protocolo: padrao protocolo-de-minuta §4.
"""
import os
import re
import sys
import glob
import subprocess

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _casa as casa  # noqa: E402

# Circular edita, commita e empurra para main na worktree de main da cadeira em
# platafirma-casa, repositorio de deliberacao que commita direto em main (arq:0083 §1;
# ordem do dono de 28/09/2026): <bancada>/wt/platafirma-casa/<cadeira>/main, resolvida e
# aberta por _casa.worktree. Puxa antes de ler: a minuta que outra cadeira ja empurrou
# para main aparece aqui. MINUTA_REPO aponta outro checkout (teste).
REPO = None
DIR = None
PLACEHOLDER_ABRE = "<escreva aqui antes de circular>"
PLACEHOLDER_CONV = "<a preencher pela própria cadeira>"


def esqueleto_posicao(ph):
    """Espelha bin/_minuta/escrever:posicao_esqueleto. Tres subsecoes, e nao um
    campo so — diagnostico e proposta misturados sao o modo de falha nomeado
    pelo dono em 19/08/2026 (PROTOCOLO §3)."""
    return (
        f"### Diagnóstico — o presente medido\n{ph}\n"
        "A1. <achado verificável na data, com a fonte>\n\n"
        f"### Proposta — o que fazer\n{ph}\n"
        "B1. <o que fazer> (sustenta-se em A1)\n\n"
        f"### O que não sei\n{ph}\n"
        "C1. <lacuna, e o que a fecharia — vazio aqui afirma que não há>\n\n"
    )


def erro(msg, code=1):
    print(f"minuta circular: {msg}", file=sys.stderr)
    sys.exit(code)


def git(*args, check=True):
    try:
        return casa.git(REPO, *args, check=check)
    except subprocess.CalledProcessError as e:
        erro(f"git {args[0]} falhou em {REPO}: {(e.stderr or e.stdout or '').strip()}", 3)


def resolve(n):
    if not n.isdigit():
        erro(f"'{n}' não é um número de minuta")
    num = f"{int(n):04d}"
    achados = glob.glob(os.path.join(DIR, f"{num}-*.md"))
    if not achados:
        erro(f"minuta {num} não encontrada em {DIR} (main puxado do forge)")
    if len(achados) > 1:
        erro(f"mais de um arquivo casa com {num}: {achados}")
    return num, achados[0]


def parse_secoes(texto):
    secoes = {}
    for m in re.finditer(r"^## Posição — (.+?)\s*$\n(.*?)(?=^## |\Z)", texto, re.M | re.S):
        secoes[m.group(1).strip()] = m.group(2).strip()
    return secoes


def main():
    global REPO, DIR
    args = sys.argv[1:]
    if not args:
        erro("uso: minuta circular <n> [<cadeira>...]", 2)
    try:
        REPO = casa.worktree("circular")
        casa.puxar(REPO)
    except casa.Falha as f:
        erro(f.msg, f.code)
    DIR = os.path.join(REPO, "minuta")
    n = args[0]
    alvos_pedidos = args[1:]
    num, caminho = resolve(n)
    relcaminho = os.path.relpath(caminho, REPO)

    st = git("status", "--porcelain", "--", relcaminho).stdout.strip()
    if st:
        erro(
            f"minuta {num} tem mudança não commitada — commite antes de circular "
            f"(o ping aponta um ref que o destinatário precisa conseguir ler):\n{st}"
        )

    texto = open(caminho, encoding="utf-8").read()

    m_titulo = re.match(r"^# (\d{4}) — (.+)$", texto, re.M)
    titulo = m_titulo.group(2).strip() if m_titulo else f"minuta {num}"

    m_abre = re.search(r"^Aberta por: (.+?) ·", texto, re.M)
    if not m_abre:
        erro(f"minuta {num}: não achei 'Aberta por:' no cabeçalho")
    abridora = m_abre.group(1).strip()

    m_conv = re.search(r"^Convocadas: (.+)$", texto, re.M)
    if not m_conv:
        erro(f"minuta {num}: não achei 'Convocadas:' no cabeçalho")
    convocadas = [c.strip() for c in m_conv.group(1).split(",") if c.strip()]

    secoes = parse_secoes(texto)
    body_abre = secoes.get(abridora, "")
    if not body_abre or PLACEHOLDER_ABRE in body_abre:
        erro(
            f"minuta {num}: seção de quem abriu ({abridora}) está vazia — "
            f"pauta vazia não circula (protocolo §2/§3)"
        )

    novas = [c for c in alvos_pedidos if c not in convocadas]
    if novas:
        convocadas_novas = convocadas + novas
        texto = re.sub(
            r"^Convocadas: .+$",
            "Convocadas: " + ", ".join(convocadas_novas),
            texto,
            count=1,
            flags=re.M,
        )
        novas_secoes = "".join(
            f"## Posição — {c}\n\n{esqueleto_posicao(PLACEHOLDER_CONV)}" for c in novas
        )
        if "\n## Divergência" in texto:
            texto = texto.replace("\n## Divergência", "\n" + novas_secoes + "## Divergência", 1)
        else:
            texto = texto.rstrip("\n") + "\n\n" + novas_secoes
        with open(caminho, "w", encoding="utf-8") as f:
            f.write(texto)
        git("add", "--", relcaminho)
        diff = git("diff", "--cached", "--quiet", check=False)
        if diff.returncode != 0:
            git("commit", "-q", "-m", f"minuta {num}: convoca {', '.join(novas)}", "--", relcaminho)
        convocadas = convocadas_novas

    # O ping aponta um ref que o destinatario le em main: o merito commitado e a convocacao
    # nova sobem antes do ping (direto em main, arq:0083).
    try:
        casa.publicar(REPO)
    except casa.Falha as f:
        erro(f.msg, f.code)

    alvos = alvos_pedidos if alvos_pedidos else convocadas
    if not alvos:
        erro(f"minuta {num}: nenhuma convocada para circular")

    cadeira = os.environ.get("PF_CADEIRA", "")
    if not cadeira:
        erro("exporte PF_CADEIRA=<cadeira>.")

    linha_corpo = f"Minuta {num} circulada — manifeste sua posição em {relcaminho}."
    enviados = []
    for c in alvos:
        r = subprocess.run(
            [
                "fila", "enviar",
                "--tipo", "minuta",
                "--assunto", f"Minuta {num} — {titulo}",
                "--ref", relcaminho,
                c,
            ],
            input=linha_corpo,
            text=True,
            capture_output=True,
        )
        if r.returncode != 0:
            print(f"falhou {c}: {r.stderr.strip()}", file=sys.stderr)
        else:
            enviados.append(c)

    print(f"circulado: minuta {num} para {', '.join(enviados) if enviados else '(ninguém — todas falharam)'}")
    if len(enviados) != len(alvos):
        sys.exit(1)


if __name__ == "__main__":
    main()
