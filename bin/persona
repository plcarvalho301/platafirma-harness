#!/usr/bin/env bash
# persona — quem a cadeira e e como se comporta: leitura para o expediente, escrita compartimentada.
# capacidade: organizacao
# dono: gestao-estrategica
# classe: B
# use para: ler persona/chapeu/conduta/foto (o que o expediente serve), escrever/editar persona, designar, afastar, desligar, filme da cadeira
# atos: ler, conduta, foto, abrir, salvar, conferir, sanear, rotas, prover, designar, afastar, dispensar, desligar, remover, reverter, filme, idade
# folhas: ler|conduta|foto -> organizacao/leitura (serve o expediente) · abrir|salvar|conferir|sanear|rotas -> organizacao/redacao ·
#         prover|designar|dispensar|remover|afastar|reverter|desligar|filme -> organizacao/vinculo (ledger)
# ambiente: PF_ABERTURA_DIR[=/srv/platafirma/casa/var/abertura-publicada] (leitura, arq:0097) · PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] · PLATAFIRMA_BANCADA[sem default; senao a linha de $HOME/.config/platafirma/bancada; ausente = exit 3] (escrita: bancada de card <bancada>/wt/platafirma-harness/$PF_CADEIRA/<card-slug>; nunca o clone-cache) · PERSONA_REPO (override de teste do clone de escrita) · PF_CADEIRA porta
# depende: morada publicada (ler, conduta, foto); bancada de card (conferir de alvo no clone, salvar, rotas, ledger)
# escreve: nada em git (#3273: o verbo confere, nao commita nem empurra); o ledger escreve registro/eventos-org.jsonl na bancada
#
# LEITURA E DA MORADA PUBLICADA, nunca do clone (arq:0097): `ler`, `conduta` e `foto`
# servem a arvore imutavel sob $PF_ABERTURA_DIR/current/abertura — e o que o expediente
# injeta (spec_expediente §7: persona, chapeu, conduta, alias-cadeiras), sem open() de caminho
# composto no montador. A sincronizacao mora do lado da ESCRITA: pull antes, confere, commit
# e push depois. So toca abertura/ e o ledger — mudanca fora deles aborta o salvar.
# Ausencia se declara e ensina: cadeira fora da arvore lista as validas (exit 1),
# chapeu fora do vocabulario lista os da cadeira (exit 1), morada nao publicada exit 3.
set -euo pipefail

# Raizes da casa (card #3010): leitura na instancia; escrita so na bancada declarada.
AQUI="$(dirname "$(readlink -f "$0")")"
. "$AQUI/../lib/raizes.sh"

MORADA="${PF_ABERTURA_DIR:-$PLATAFIRMA_INSTANCIA/var/abertura-publicada}"
# Clone de escrita: resolvido so pelos atos que o usam (entra_no_clone). Leitura nunca
# toca a bancada — sem ela declarada, ler/conduta/foto/conferir seguem servindo.
REPO="${PERSONA_REPO:-}"
ARVORE="$MORADA/current/abertura"

# --bancada <card-slug>: opcao global; escolhe a bancada de card quando ha mais de uma aberta
# (#3273). Sai da lista de argumentos antes do despacho.
BANCADA_SLUG=""
_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --bancada)
      BANCADA_SLUG="${2:-}"
      [ -n "$BANCADA_SLUG" ] || { echo "persona: --bancada exige <card-slug>" >&2; exit 2; }
      shift 2 ;;
    *) _args+=("$1"); shift ;;
  esac
done
set -- ${_args[@]+"${_args[@]}"}
# conteudo vivo mora na arvore de abertura (um dir por cadeira, persona.md + chapeus).
# o ledger de organizacao mora em registro/eventos-org.jsonl (ato proprio, _persona-org.py).
ALVO="abertura"

uso() {
  cat >&2 <<'EOF'
uso:
  leitura, da morada publicada (o que o expediente serve):
  persona ler <cadeira>                 persona.md da cadeira, cru
  persona ler <cadeira> --chapeu <slug> chapeu.md + ferramental.md do chapeu, crus
  persona conduta                       dono.md — a conduta do dono, igual em toda cadeira
  persona foto [--json]                 vocabulário de cadeiras e aliases da morada publicada

  redacao, na bancada de card (repo abrir platafirma-harness <card> --slug persona-<tema>):
  persona abrir | sanear     aposentados (#3273): saem 2 com o caminho; persona nao faz git
  persona idade              sha, data do último commit e idade da bancada
  persona conferir [alvo]    roda os checks do molde novo (alvo: cadeira, arquivo ou dir)
  persona salvar -m "<msg>"  confere o que mudou em abertura/ e no ledger; NAO commita nem
                             empurra — diz o fluxo de entrega (commitar, sincronizar, pr-abrir)
  persona rotas [opções]     regenera abertura/rotas-chapeu.json (recuperacao/gerar_rotas_chapeu.py)
  --bancada <card-slug>      (global) escolhe a bancada quando ha mais de uma aberta; com uma so,
                             ela e usada; nunca o clone-cache, nunca HEAD destacado

  atos de organização — ledger append-only em personas/eventos-org.jsonl:
  persona prover <cadeira> [--alias "<Nome>"]     abre cadeira
  persona designar <cadeira> <gerência>            dá gerência
  persona dispensar <cadeira> <gerência>           tira gerência, cadeira fica
  persona remover <gerência> <de> <para>           migra competência entre cadeiras
  persona afastar <cadeira> --gatilho "<cond>"     suspende; gatilho é obrigatório
  persona reverter <cadeira>                       reabre a suspensa
  persona desligar <cadeira> --motivo "<txt>"      encerra
  persona filme [cadeira]                          a série datada
  Comuns: --em AAAA-MM-DD (data do fato) · --nota "<txt>" · --autor <quem>

  Checks que BLOQUEIAM: falta de seção obrigatória do molde novo (introdução,
  Perguntas de competência, Vocabulário canônico, Escopo, Sinais de reconhecimento,
  Gerências) ou fora de ordem, seções obsoletas do molde velho (ESPECIALISTA,
  POSTURA, NEGATIVAS), bloco repetido no mesmo arquivo, seção declarada vazia
  ("SEÇÃO: —") com conteúdo embaixo.
  Checks que AVISAM: gerência sem chapeu.md servido, linha acima de 100 colunas,
  teto de 1400 palavras.
EOF
  exit 2
}

# --- leitura: morada publicada ------------------------------------------------
exige_morada() {
  if [ ! -d "$ARVORE" ]; then
    echo "persona: morada nao publicada ($ARVORE nao existe) — a cura e \`publicar-abertura\`" >&2
    exit 3
  fi
}

# slug puro: sem prefixo claudinho-/claudinha-, minusculas — a mesma forma que nomeia o
# diretorio em abertura/ (arq:0073 §1).
slug_cadeira() {
  local c
  c=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
  c="${c#claudinho-}"; c="${c#claudinha-}"
  printf '%s' "$c"
}

cadeiras_validas() {
  # cadeira viva = diretorio com persona.md (arq:0073 §1)
  find "$ARVORE" -mindepth 2 -maxdepth 2 -name persona.md -printf '%h\n' \
    | xargs -rn1 basename | sort | tr '\n' ' '
}

chapeus_da_cadeira() {
  find "$ARVORE/$1" -mindepth 2 -maxdepth 2 -name chapeu.md -printf '%h\n' 2>/dev/null \
    | xargs -rn1 basename | sort | tr '\n' ' '
}

ler() {
  exige_morada
  local cad chapeu=""
  cad=$(slug_cadeira "${1:-}")
  [ -n "$cad" ] || { echo "persona ler: falta <cadeira> — validas: $(cadeiras_validas)" >&2; exit 2; }
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --chapeu) chapeu="${2:-}"; [ -n "$chapeu" ] || { echo "persona ler: --chapeu exige <slug>" >&2; exit 2; }; shift 2 ;;
      *) echo "persona ler: argumento desconhecido '$1'" >&2; uso ;;
    esac
  done
  if [ ! -d "$ARVORE/$cad" ]; then
    echo "nao-existe: cadeira $cad — validas: $(cadeiras_validas)" >&2
    exit 1
  fi
  if [ -z "$chapeu" ]; then
    if [ ! -f "$ARVORE/$cad/persona.md" ]; then
      echo "nao-existe: abertura/$cad/persona.md — cadeira provida e nao redigida" >&2
      exit 1
    fi
    cat "$ARVORE/$cad/persona.md"
    return 0
  fi
  if [ ! -f "$ARVORE/$cad/$chapeu/chapeu.md" ]; then
    echo "nao-existe: chapeu $chapeu em $cad — validos: $(chapeus_da_cadeira "$cad")" >&2
    exit 1
  fi
  cat "$ARVORE/$cad/$chapeu/chapeu.md"
  if [ -f "$ARVORE/$cad/$chapeu/ferramental.md" ]; then
    printf '\n'
    cat "$ARVORE/$cad/$chapeu/ferramental.md"
  else
    echo "(chapeu $chapeu sem ferramental.md — declarado, nao e erro)" >&2
  fi
}

conduta() {
  exige_morada
  if [ ! -f "$ARVORE/dono.md" ]; then
    echo "nao-existe: abertura/dono.md na morada publicada" >&2
    exit 1
  fi
  cat "$ARVORE/dono.md"
}

foto() {
  exige_morada
  python3 - "$ARVORE" "$@" <<'PY'
# Transição declarada no ato: quando `acervo resolver` (feature #3032, dados)
# existir, `foto` o consome e a leitura de aliases.json sai.
import json, os, pathlib, sys

arvore = pathlib.Path(sys.argv[1])
como_json = False

for arg in sys.argv[2:]:
    if arg == "--json":
        como_json = True
    else:
        print(f"persona foto: argumento desconhecido '{arg}'", file=sys.stderr)
        sys.exit(2)

# cadeira viva = diretório com persona.md (arq:0073 §1); chapéus = subdirs com chapeu.md
vivas = {}
for p in sorted(arvore.iterdir()):
    if p.is_dir() and (p / "persona.md").is_file():
        slug = p.name
        chapeus = sorted([
            c.name for c in p.iterdir()
            if c.is_dir() and (c / "chapeu.md").is_file()
        ])
        vivas[slug] = chapeus

# alias = aliases.json da árvore publicada.
# exit: 0 · 3 morada não publicada · 1 aliases.json ilegível (declara e lista as cadeiras sem alias mesmo assim — degrada, não trava).
aliases_path = arvore / "aliases.json"
aliases_map = {}
degra_exit = 0

try:
    if not aliases_path.is_file():
        raise FileNotFoundError(f"{aliases_path} nao existe")
    with open(aliases_path, "r", encoding="utf-8") as f:
        aliases_map = json.load(f)
    if not isinstance(aliases_map, dict):
        raise ValueError("aliases.json nao e um mapa JSON")
except Exception as e:
    print(f"persona foto: aliases.json ausente ou ilegivel ({e}) — listando cadeiras sem alias", file=sys.stderr)
    degra_exit = 1
    aliases_map = {}

if como_json:
    saida = {}
    for slug in sorted(vivas.keys()):
        alias_val = aliases_map.get(slug) if degra_exit == 0 else None
        if not isinstance(alias_val, str) or not alias_val.strip():
            alias_val = None
        else:
            alias_val = alias_val.strip()
        saida[slug] = {
            "alias": alias_val,
            "chapeus": vivas[slug],
        }
    print(json.dumps(saida, ensure_ascii=False))
    sys.exit(degra_exit)

# Formato texto: uma linha por cadeira, ordenada pelo alias: `Nome Humano -> slug`;
# cadeira viva sem alias (aliases.json com null, ex. fabrica) sai `(sem alias) -> fabrica`;
# cadeira viva ausente do mapa sai com nota `(sem alias, omitido)`.
linhas = []
for slug in vivas:
    if degra_exit != 0:
        alias_txt = "(sem alias)"
    elif slug in aliases_map:
        val = aliases_map[slug]
        if val is not None and isinstance(val, str) and val.strip():
            alias_txt = val.strip()
        else:
            alias_txt = "(sem alias)"
    else:
        alias_txt = "(sem alias, omitido)"
    linhas.append((alias_txt, slug))

# ordenada pelo alias
linhas.sort(key=lambda item: (item[0], item[1]))

for alias_txt, slug in linhas:
    print(f"{alias_txt} -> {slug}")

sys.exit(degra_exit)
PY
}

case "${1:-}" in
  ler)     shift; ler "$@"; exit $? ;;
  conduta) conduta; exit $? ;;
  foto)    shift; foto "$@"; exit $? ;;
esac

# Worktree da cadeira na bancada (arq:0109 §2), senao o clone base. Bancada nao
# declarada sai 3; clone ausente sai 3 com a cura, nunca criacao silenciosa.
entra_no_clone() {
  if [ -z "$REPO" ]; then
    local b base d cands=()
    b="$(pf_bancada)" || exit 3
    base="$b/wt/platafirma-harness/${PF_CADEIRA:-}"
    # bancada de card (arq:0109): wt/<repo>/<cadeira>/<card-slug>. NUNCA o clone-cache
    # <bancada>/platafirma-harness: o `repo sanear` o deixa destacado e nele nada sobe (#3273).
    if [ -n "${PF_CADEIRA:-}" ] && [ -d "$base" ]; then
      for d in "$base"/*/; do
        [ -e "${d}.git" ] && cands+=("${d%/}")
      done
    fi
    if [ -n "$BANCADA_SLUG" ]; then
      [ -e "$base/$BANCADA_SLUG/.git" ] || {
        echo "persona: bancada '$BANCADA_SLUG' nao existe — abertas: $(printf '%s ' "${cands[@]##*/}")" >&2
        exit 3
      }
      REPO="$base/$BANCADA_SLUG"
    elif [ "${#cands[@]}" -eq 1 ]; then
      REPO="${cands[0]}"
    elif [ "${#cands[@]}" -eq 0 ]; then
      echo "persona: sem bancada de card para ${PF_CADEIRA:-a cadeira} — a cura e \`repo abrir platafirma-harness <card> --slug persona-<tema>\`" >&2
      exit 3
    else
      echo "persona: ${#cands[@]} bancadas abertas — diga qual com --bancada <card-slug>: $(printf '%s ' "${cands[@]##*/}")" >&2
      exit 3
    fi
  fi
  if [ ! -d "$REPO" ]; then
    echo "persona: clone de escrita ausente em $REPO — a cura e \`repo abrir platafirma-harness <card> --slug persona-<tema>\`" >&2
    exit 3
  fi
  cd "$REPO"
  # clone destacado nao e bancada de card: nada que se escreva nele sobe.
  git symbolic-ref -q HEAD >/dev/null || {
    echo "persona: $REPO esta em HEAD destacado — nao e bancada de card; \`repo abrir platafirma-harness <card> --slug persona-<tema>\`" >&2
    exit 3
  }
  # o sub-ato de ledger escreve no MESMO clone que o salvar versiona
  export PERSONA_REPO="$REPO"
}

idade() {
  local sha data seg
  sha=$(git rev-parse --short HEAD)
  data=$(git log -1 --format=%cI)
  seg=$(( $(date +%s) - $(git log -1 --format=%ct) ))
  printf '%s · último commit %s · clone com %dh%02dm\n' \
    "$sha" "$data" $((seg/3600)) $(( (seg%3600)/60 ))
}

# conferir le a MORADA PUBLICADA por padrao (arq:0097: o que as cadeiras recebem), ou o
# clone de trabalho/alvo especificado. Valida as personas contra o molde novo (spec_template_persona.md).
conferir() {
  local alvos=("$@")
  if [ "${#alvos[@]}" -eq 0 ]; then
    # Se há mudanças em abertura/ no clone atual, confere os modificados
    if [ -n "${REPO:-}" ] && [ -d "${REPO:-}/.git" ]; then
      while IFS= read -r f; do
        [ -n "$f" ] && alvos+=("$REPO/$f")
      done < <(git -C "$REPO" status --porcelain abertura/ 2>/dev/null | awk '{print $NF}' | grep 'persona\.md$' || true)
    fi
  fi
  if [ "${#alvos[@]}" -eq 0 ]; then
    if [ -d "$ARVORE" ]; then
      alvos=("$ARVORE")
    elif [ -d "$AQUI/../abertura" ]; then
      alvos=("$AQUI/../abertura")
    elif [ -d "abertura" ]; then
      alvos=("abertura")
    fi
  fi

  python3 - "${alvos[@]}" <<'PY'
import pathlib, re, sys, collections

TETO = 1400

# Seções obrigatórias do molde novo (spec_template_persona.md, card #3086), na ordem canônica:
# 0. Introdução (sem rótulo, 4 a 6 linhas antes da primeira seção)
# 1. Perguntas de competência
# 2. Vocabulário canônico
# 3. Escopo
# 4. Sinais de reconhecimento
# 5. Gerências
SECOES_OBRIGATORIAS = [
    ("Perguntas de competência", r"^##\s+Perguntas de compet[êe]ncia\b"),
    ("Vocabulário canônico", r"^##\s+Vocabul[áa]rio can[ôo]nico\b"),
    ("Escopo", r"^##\s+Escopo\b"),
    ("Sinais de reconhecimento", r"^##\s+Sinais de reconhecimento\b"),
    ("Gerências", r"^##\s+Ger[êe]ncias\b"),
]

# Seções obsoletas do molde velho que devem reprovar
SECOES_OBSOLETAS = ["POSTURA", "NEGATIVAS", "ESPECIALISTA"]

erros, avisos = [], []

# Determina alvos
alvos = []
for arg in sys.argv[1:]:
    p = pathlib.Path(arg)
    if p.is_file() and p.name == "persona.md":
        alvos.append(p)
    elif (p / "persona.md").is_file():
        alvos.append(p / "persona.md")
    elif p.is_dir():
        alvos.extend(sorted(p.glob("*/persona.md")))
    else:
        # Tenta resolver como slug de cadeira
        achou = False
        for base in [pathlib.Path("abertura"), pathlib.Path(__file__).resolve().parent.parent / "abertura"]:
            if (base / arg / "persona.md").is_file():
                alvos.append(base / arg / "persona.md")
                achou = True
                break
        if not achou:
            print(f"aviso: alvo não encontrado: '{arg}'", file=sys.stderr)

alvos = sorted(list(dict.fromkeys(alvos)))
if not alvos:
    print("nenhuma persona em abertura/*/persona.md", file=sys.stderr)
    sys.exit(0)

for f in alvos:
    cad = f.parent.name
    txt = f.read_text(encoding="utf-8")

    # 0. Introdução (sem rótulo, no topo antes da primeira seção ##)
    m_primeira = re.search(r"^##\s+", txt, re.M)
    intro_txt = txt[:m_primeira.start()].strip() if m_primeira else ""
    linhas_intro = [l for l in intro_txt.splitlines() if l.strip()]
    if not linhas_intro:
        erros.append(f"{cad}: falta a introducao (sem rotulo, no topo)")

    # 1. Rótulos obrigatórios presentes e em ordem
    pos = -1
    for nome_sec, padrao in SECOES_OBRIGATORIAS:
        m = re.search(padrao, txt, re.M)
        if not m:
            erros.append(f"{cad}: falta a secao {nome_sec}")
        elif m.start() < pos:
            erros.append(f"{cad}: secao {nome_sec} fora de ordem")
        else:
            pos = m.start()

    # Reprova seções do molde velho
    for velha in SECOES_OBSOLETAS:
        if re.search(rf"^(?:##\s+)?{re.escape(velha)}[\s:]", txt, re.M):
            erros.append(f"{cad}: secao obsoleta do molde velho '{velha}'")

    # 2. Cada gerência listada tem um chapéu servido (dir irmão com chapeu.md)
    mg = re.search(r"^##\s+Ger[êe]ncias\s*$(.*?)(?=^##|\Z)", txt, re.S | re.M)
    if mg:
        ger = re.findall(r"^-\s+(?:\*\*)?([a-z0-9-]+)(?:\*\*)?\s*[—·:-]", mg.group(1), re.M)
        for g in ger:
            if not re.match(r"^[a-z0-9][a-z0-9-]{0,40}$", g):
                erros.append(f"{cad}: gerencia '{g}' — slug de chapeu tem de caber em "
                             f"^[a-z0-9][a-z0-9-]{{0,40}}$ (ate 41 chars, mesmo teto de `mesa`)")
            if not (f.parent / g / "chapeu.md").is_file():
                avisos.append(f"{cad}: gerencia '{g}' sem chapeu.md servido")

    # 3. Bloco repetido no mesmo arquivo
    linhas = [l.rstrip() for l in txt.splitlines()]
    c = collections.Counter(l for l in linhas if len(l.strip()) > 40)
    for l, k in c.items():
        if k > 1:
            erros.append(f"{cad}: linha repetida — {l[:60]}…")

    # 4. Seção declarada vazia com conteúdo embaixo
    for m in re.finditer(r"^(?:##\s+)?([A-Za-zÇÃÉÍÓÚçãéíóú ]+):\s*—\s*$", txt, re.M):
        resto = txt[m.end():].lstrip("\n")
        if resto and not resto[:1].isupper() and not resto.startswith("#"):
            erros.append(f"{cad}: {m.group(1)} declara vazio e tem conteudo abaixo")

    # 5. Largura (conta caracteres, nao bytes; tabela e link isentos)
    for i, l in enumerate(linhas, 1):
        if len(l) > 100 and "http" not in l and not l.lstrip().startswith("|"):
            avisos.append(f"{cad}:{i}: linha com {len(l)} colunas (>100)")

    # 6. Teto de palavras (aviso) calibrado para o molde novo
    pw = len(txt.split())
    if pw > TETO:
        avisos.append(f"{cad}: {pw} palavras (teto {TETO})")

for a in avisos:
    print(f"aviso  {a}")
for e in erros:
    print(f"ERRO   {e}")
print(f"--- {len(erros)} erro(s), {len(avisos)} aviso(s)")
sys.exit(1 if erros else 0)
PY
}

# abrir e sanear foram aposentados (#3273): puxavam, resetavam e empurravam no clone-cache
# <bancada>/platafirma-harness, que fica destacado e onde nada sobe. A redacao de persona
# e conduta e edicao de arquivo numa bancada de card; a bancada se atualiza por `repo atualizar`.
aposentado() {
  echo "persona $1: aposentado (#3273) — persona nao mexe mais em git." >&2
  echo "  1. repo abrir platafirma-harness <card> --slug persona-<tema>" >&2
  echo "  2. edite abertura/ na bancada (write_file) e rode: persona conferir / persona salvar -m \"<msg>\"" >&2
  echo "  3. entregue: repo commitar → sincronizar → pr-abrir → pr-merge → release promover" >&2
  exit 2
}

# salvar — confere abertura/ e o ledger na bancada de card, sem commit e sem push (#3273;
# a entrega e commitar/sincronizar/pr-abrir). Corpo em funcao (card #3122): o corpo mora AQUI, dentro de funcao, para que os `local`
# valham; o case final so despacha (`salvar) shift; salvar "$@" ;;`), nunca roda o
# corpo no nivel do script.
salvar() {
  [ "${1:-}" = "-m" ] && [ -n "${2:-}" ] || uso
  local msg="$2"
  entra_no_clone
  # o verbo versiona dois caminhos: o conteudo vivo (abertura/) e o ledger de
  # organizacao (registro/eventos-org.jsonl), que _persona-org.py escreve sem commitar.
  # Mudanca fora desses dois aborta em vez de entrar de carona.
  local sujo
  sujo=$(git status --porcelain | grep -v "^.. abertura/" \
                                | grep -v "^.. registro/eventos-org.jsonl" || true)
  if [ -n "$sujo" ]; then
    echo "abortado: há mudança fora de abertura/ e do ledger — commite ou guarde antes." >&2
    echo "$sujo" >&2
    exit 1
  fi

  # Identifica quais personas foram modificadas / adicionadas
  local mudados=()
  while IFS= read -r f; do
    [ -n "$f" ] && mudados+=("$f")
  done < <(git status --porcelain -uall abertura/ | awk '{print $NF}' | grep 'persona\.md$' || true)

  # Também confere se foram modificados chapéus em abertura/<cad>/
  while IFS= read -r cad; do
    if [ -n "$cad" ] && [ -f "$REPO/$ALVO/$cad/persona.md" ]; then
      local ja_tem
      ja_tem=0
      for m in "${mudados[@]}"; do
        if [ "$m" = "abertura/$cad/persona.md" ] || [ "$m" = "$ALVO/$cad/persona.md" ]; then
          ja_tem=1
        fi
      done
      [ "$ja_tem" -eq 0 ] && mudados+=("$ALVO/$cad/persona.md")
    fi
  done < <(git status --porcelain -uall abertura/ | awk '{print $NF}' | cut -d/ -f2 | sort -u || true)

  if [ "${#mudados[@]}" -gt 0 ]; then
    conferir "${mudados[@]}"
  fi

  # SEM git (#3273): o verbo confere e para aqui. Commit, push e PR sao do fluxo de
  # bancada de card (repo commitar / sincronizar / pr-abrir), com o pre-push do harness.
  if [ -z "$(git status --porcelain abertura registro/eventos-org.jsonl)" ]; then
    echo "nada a salvar"
    exit 0
  fi
  local slug
  slug="$(basename "$REPO")"
  echo "conferido · nada commitado nem empurrado (persona nao faz mais git) · bancada $slug"
  echo "entrega: repo commitar platafirma-harness@$slug -m \"$msg\" → repo sincronizar → repo pr-abrir → repo pr-merge → release promover platafirma-harness <sha>"
}

# rotas — regenera abertura/rotas-chapeu.json a partir das personas do clone (card
# #3110). Entra no clone porque o gerador le abertura/<cadeira>/persona.md do
# WORKTREE (o que se esta editando), nao da morada publicada.
rotas() {
  entra_no_clone
  python3 "$REPO/recuperacao/gerar_rotas_chapeu.py" --abertura "$REPO/abertura" "$@"
}

# --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4). ANTES do
# despacho, varrendo TODOS os argumentos: cobre `persona --ajuda` e `persona <sub> --ajuda`
# — sem isto, `persona abrir --ajuda` dispararia o git pull de `abrir` e ignoraria a flag.
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

case "${1:-}" in
  abrir|sanear)
    aposentado "$1"
    ;;
  idade)
    entra_no_clone
    idade
    ;;
  conferir)
    shift
    conferir "$@"
    ;;
  salvar)
    shift
    salvar "$@"
    ;;
  rotas)
    shift
    rotas "$@"
    ;;
  prover|designar|dispensar|remover)
    # LEMBRETE, NAO GATE (dono, 17/08/2026). Ato que cria ou move unidade organizacional
    # tem uma pergunta de arquitetura do lado — capacidade nova, ou capacidade que ja
    # existe noutra unidade. O arquiteto QUALIFICA a decisao, nao a toma: quem bate o
    # martelo continua sendo o dono, e o ledger nao espera parecer de ninguem. Hoje quem
    # lembra e sempre o dono; esta linha divide esse trabalho com ele.
    echo "lembrete: passou pelo mapa de capacidades? platafirma-arquitetura@docs/arquitetura-negocio-operacao.md · arq:0059" >&2
    echo "          claudinho-arquiteto qualifica; nao e gate e nao bloqueia este ato." >&2
    entra_no_clone
    exec python3 "$AQUI/_persona/org.py" "$@"
    ;;
  afastar|reverter|desligar|filme)
    entra_no_clone
    exec python3 "$AQUI/_persona/org.py" "$@"
    ;;
  *)
    uso
    ;;
esac
