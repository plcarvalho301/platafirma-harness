#!/usr/bin/env bash
# persona — escrita compartimentada das personas da PlataFirma.
# capacidade: organizacao
# dono: claudinha-gestao-estrategica
# use para: escrever/editar persona, designar, afastar, desligar, foto/filme da cadeira
# atos: abrir, salvar, conferir, prover, designar, afastar, dispensar, desligar, remover, reverter, foto, filme, idade
# Leitura serve do clone sem rede (monta_sessao); a sincronização mora aqui,
# do lado da escrita: pull antes, confere, commit e push depois. Só toca
# personas/ — mudança fora dela aborta o salvar em vez de entrar de carona.
set -euo pipefail

REPO="${PERSONA_REPO:-$HOME/AI/platafirma-harness}"
# conteudo vivo mora na arvore de abertura (um dir por cadeira, persona.md + chapeus).
# o ledger de organizacao mora em registro/eventos-org.jsonl (ato proprio, _persona-org.py).
ALVO="abertura"

uso() {
  cat >&2 <<'EOF'
uso:
  persona abrir              pull --ff-only antes de editar; diz o sha e a idade
  persona idade              sha, data do último commit e idade do clone
  persona conferir           roda os checks sem escrever nada
  persona salvar -m "<msg>"  pull, confere, commit só de abertura/ e push

  atos de organização — ledger append-only em personas/eventos-org.jsonl:
  persona prover <cadeira> [--alias "<Nome>"]     abre cadeira
  persona designar <cadeira> <gerência>            dá gerência
  persona dispensar <cadeira> <gerência>           tira gerência, cadeira fica
  persona remover <gerência> <de> <para>           migra competência entre cadeiras
  persona afastar <cadeira> --gatilho "<cond>"     suspende; gatilho é obrigatório
  persona reverter <cadeira>                       reabre a suspensa
  persona desligar <cadeira> --motivo "<txt>"      encerra
  persona foto                                     estado atual, por replay
  persona filme [cadeira]                          a série datada
  Comuns: --em AAAA-MM-DD (data do fato) · --nota "<txt>" · --autor <quem>

  Checks que BLOQUEIAM: falta de seção obrigatória (ESPECIALISTA, GERÊNCIAS,
  POSTURA, NEGATIVAS) ou fora de ordem, bloco repetido no mesmo arquivo, seção
  declarada vazia ("SEÇÃO: —") com conteúdo embaixo, linha acima de 88 colunas.
  Checks que AVISAM: gerência sem chapeu.md servido, teto de 650 palavras.
EOF
  exit 2
}

cd "$REPO"

idade() {
  local sha data seg
  sha=$(git rev-parse --short HEAD)
  data=$(git log -1 --format=%cI)
  seg=$(( $(date +%s) - $(git log -1 --format=%ct) ))
  printf '%s · último commit %s · clone com %dh%02dm\n' \
    "$sha" "$data" $((seg/3600)) $(( (seg%3600)/60 ))
}

conferir() {
  python3 - "$REPO/$ALVO" <<'PY'
import pathlib, re, sys, collections

raiz = pathlib.Path(sys.argv[1])
TETO = 650

# Schema vivo da persona (arvore de abertura): rotulos obrigatorios, na ordem.
# ATIVACAO/FRONTEIRA/TEMPLATE eram do formato antigo (personas/persona-*.md), morto.
# obrigatorias: presentes em TODAS as personas vivas. ESPECIALISTA e recomendada
# (3 cadeiras validas nao a tem: politicas-publicas, seguranca, ti) -> vira aviso.
ROTULOS = ["GERÊNCIAS", "POSTURA", "NEGATIVAS"]
RECOMENDADAS = ["ESPECIALISTA"]

erros, avisos = [], []

# uma persona por cadeira: abertura/<cadeira>/persona.md
alvos = sorted(raiz.glob("*/persona.md"))
if not alvos:
    print("nenhuma persona em abertura/*/persona.md", file=sys.stderr)
    sys.exit(0)

for f in alvos:
    cad = f.parent.name
    txt = f.read_text(encoding="utf-8")

    # 1. rotulos obrigatorios presentes e em ordem
    pos = -1
    for r in ROTULOS:
        m = re.search(rf"^{re.escape(r)}\b", txt, re.M)
        if not m:
            erros.append(f"{cad}: falta a secao {r}")
        elif m.start() < pos:
            erros.append(f"{cad}: secao {r} fora de ordem")
        else:
            pos = m.start()
    for r in RECOMENDADAS:
        if not re.search(rf"^{re.escape(r)}\b", txt, re.M):
            avisos.append(f"{cad}: sem a secao recomendada {r}")

    # 2. cada gerencia listada tem um chapeu servido (dir irmao com chapeu.md)
    mg = re.search(r"^GERÊNCIAS\s*$(.*?)^POSTURA", txt, re.S | re.M)
    if mg:
        ger = re.findall(r"^-\s+([a-z0-9-]+)\s+·", mg.group(1), re.M)
        for g in ger:
            if not (f.parent / g / "chapeu.md").is_file():
                avisos.append(f"{cad}: gerencia '{g}' sem chapeu.md servido")

    # 3. bloco repetido no mesmo arquivo (o defeito que passou meses na IA)
    linhas = [l.rstrip() for l in txt.splitlines()]
    c = collections.Counter(l for l in linhas if len(l.strip()) > 40)
    for l, k in c.items():
        if k > 1:
            erros.append(f"{cad}: linha repetida — {l[:60]}…")

    # 4. secao declarada vazia com conteudo embaixo
    for m in re.finditer(r"^([A-ZÇÃÉÍÓÚ][A-ZÇÃÉÍÓÚ ]+):\s*—\s*$", txt, re.M):
        resto = txt[m.end():].lstrip("\n")
        if resto and not resto[:1].isupper():
            erros.append(f"{cad}: {m.group(1)} declara vazio e tem conteudo abaixo")

    # 5. largura (conta caracteres, nao bytes; tabela e link isentos). O formato vivo
    #    corre mais largo que o antigo; >100 col e aviso de legibilidade, nao erro.
    for i, l in enumerate(linhas, 1):
        if len(l) > 100 and "http" not in l and not l.lstrip().startswith("|"):
            avisos.append(f"{cad}:{i}: linha com {len(l)} colunas (>100)")

    # 6. teto de palavras (aviso)
    pw = len(txt.split())
    if pw > TETO:
        avisos.append(f"{cad}: {pw} palavras (teto {TETO})")

for a in avisos:
    print(f"aviso  {a}")
for e in erros:
    print(f"ERRO   {e}")
print(f"--- {len(erros)} erro(s), {len(avisos)} aviso(s)")
sys.exit(1 if erros else 0)
PY
}

# --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4). ANTES do
# despacho, varrendo TODOS os argumentos: cobre `persona --ajuda` e `persona <sub> --ajuda`
# — sem isto, `persona abrir --ajuda` dispararia o git pull de `abrir` e ignoraria a flag.
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

case "${1:-}" in
  abrir)
    git pull --ff-only -q origin HEAD && echo "clone em dia · $(idade)"
    ;;
  idade)
    idade
    ;;
  conferir)
    conferir
    ;;
  salvar)
    shift
    [ "${1:-}" = "-m" ] && [ -n "${2:-}" ] || uso
    msg="$2"
    # o verbo versiona dois caminhos: o conteudo vivo (abertura/) e o ledger de
    # organizacao (registro/eventos-org.jsonl), que _persona-org.py escreve sem commitar.
    # Mudanca fora desses dois aborta em vez de entrar de carona.
    sujo=$(git status --porcelain | grep -v "^.. abertura/" \
                                  | grep -v "^.. registro/eventos-org.jsonl" || true)
    if [ -n "$sujo" ]; then
      echo "abortado: há mudança fora de abertura/ e do ledger — commite ou guarde antes." >&2
      echo "$sujo" >&2
      exit 1
    fi
    git pull --ff-only -q origin HEAD
    conferir
    git add abertura registro/eventos-org.jsonl
    git diff --cached --quiet && { echo "nada a salvar"; exit 0; }
    git commit -q -m "$msg"
    git push -q origin HEAD
    echo "salvo · $(idade)"
    ;;
  prover|designar|dispensar|remover)
    # LEMBRETE, NAO GATE (dono, 17/08/2026). Ato que cria ou move unidade organizacional
    # tem uma pergunta de arquitetura do lado — capacidade nova, ou capacidade que ja
    # existe noutra unidade. O arquiteto QUALIFICA a decisao, nao a toma: quem bate o
    # martelo continua sendo o dono, e o ledger nao espera parecer de ninguem. Hoje quem
    # lembra e sempre o dono; esta linha divide esse trabalho com ele.
    echo "lembrete: passou pelo mapa de capacidades? platafirma-arquitetura@docs/arquitetura-negocio-operacao.md · arq:0059" >&2
    echo "          claudinho-arquiteto qualifica; nao e gate e nao bloqueia este ato." >&2
    exec python3 "$REPO/bin/_persona-org.py" "$@"
    ;;
  afastar|reverter|desligar|foto|filme)
    exec python3 "$REPO/bin/_persona-org.py" "$@"
    ;;
  *)
    uso
    ;;
esac
