#!/usr/bin/env bash
# acervo — opera o acervo da plataforma (biblioteca, casa, registro)
# capacidade: conhecimento
# dono: dados
# classe: B
# use para: ler o texto de uma obra por pagina ou capitulo (ler biblioteca impressao), ler uma ADR/spec/pagina/obra que sabe onde esta (ler), listar o que ha de um tipo ou sobre um assunto pelo catalogo (listar --sobre), gravar uma pagina de wiki (escrever casa pagina), por um repo de doc no acervo (ingerir casa <repo>)
# atos: ler (leitura, casa), listar (leitura, casa), resolver (leitura, casa), escrever (escrita, registro), ingerir (escrita, incorporacao), curar (escrita, curadoria), catalogar (escrita, classificacao), definir (escrita, tesauro), relacionar (escrita, tesauro), desrelacionar (escrita, tesauro), derivar (escrita, classificacao), desderivar (escrita, classificacao), empacotar (leitura, classificacao), espelhar (escrita, transcricao), recortar (escrita, transcricao), promover (escrita, transcricao), julgar (escrita, transcricao), converter (escrita, transcricao), recolher (escrita, transcricao), repor (escrita, transcricao), retirar (escrita, retirada), restaurar (escrita, retirada), apagar (escrita, retirada), extrato (leitura, acervo), exportar (escrita, acervo), psql (escrita, acervo), balde (escrita, acervo)
# forma: texto
# le: ler=acervo.casa,acervo.obra,acervo.registro,repo
# le: listar=acervo.casa,acervo.obra,acervo.registro,repo,arquivo-local
# le: resolver=acervo.casa
# le: escrever=nada
# le: ingerir=repo
# le: curar=acervo.obra,acervo.casa
# le: catalogar=acervo.obra
# le: definir=acervo.obra
# le: relacionar=acervo.obra
# le: desrelacionar=acervo.obra
# le: derivar=acervo.obra
# le: desderivar=acervo.obra
# le: empacotar=acervo.obra,minio
# le: espelhar=acervo.obra,minio
# le: recortar=acervo.obra
# le: promover=acervo.obra
# le: julgar=acervo.obra
# le: converter=acervo.obra,minio
# le: recolher=acervo.obra,minio
# le: repor=acervo.obra,minio
# le: retirar=acervo.obra,acervo.casa
# le: restaurar=acervo.obra,acervo.casa
# le: apagar=acervo.obra,minio
# le: extrato=acervo.*
# le: exportar=acervo.*,repo
# le: psql=acervo.*
# le: balde=acervo.*,minio
# escreve: ler=nada
# escreve: listar=nada
# escreve: resolver=nada
# escreve: escrever=acervo.casa
# escreve: ingerir=acervo.casa,acervo.obra,acervo.registro,motor,repo
# escreve: curar=acervo.obra,acervo.casa,arquivo-local
# escreve: catalogar=acervo.obra
# escreve: definir=acervo.obra
# escreve: relacionar=acervo.obra
# escreve: desrelacionar=acervo.obra
# escreve: derivar=acervo.obra
# escreve: desderivar=acervo.obra
# escreve: empacotar=arquivo-local
# escreve: espelhar=acervo.obra,minio
# escreve: recortar=acervo.obra
# escreve: promover=acervo.obra
# escreve: julgar=acervo.obra
# escreve: converter=arquivo-local
# escreve: recolher=minio
# escreve: repor=minio
# escreve: retirar=acervo.obra,acervo.casa,motor,repo
# escreve: restaurar=acervo.obra,acervo.casa,repo
# escreve: apagar=acervo.obra,motor,minio
# escreve: extrato=arquivo-local
# escreve: exportar=repo
# escreve: psql=acervo.*
# escreve: balde=acervo.obra,minio
# consome: motor_acervo_rest, rag_extractor_pg
# ambiente: PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] (ingerir casa le o suporte platafirma-casa pelo sha no espelho bare <instancia>/var/acervo/suporte/platafirma-casa.git, com a credencial da conta; nunca release, nunca clone de bancada; ler/listar casa so leem o origin/main ja buscado dele, para o campo servido), PF_SUPORTE_ESPELHO (opcional, override do espelho), PF_SUPORTE_URL[=https://github.com/plcarvalho301/platafirma-casa.git] (opcional, forge do suporte), RAG_API_BASE (opcional, url do motor), RAG_API_TOKEN (opcional, auth do motor)
# depende: docker, git, psql
# substitui: situacao, escada, descobrir, bancada
#
# Despachante (arq:0040): o verbo e o par binario+subcomando. Os sub-atos moram
# em bin/_acervo/ e nao entram no PATH; a porta e esta.
#
# GRAMATICA (arq:0106): acervo <ato> <particao> <entidade> [seletor].
# Doc de produto: spec acervo, no suporte platafirma-casa, lido pela chave (arq:0115 §3.3):
#   acervo ler casa spec acervo
set -euo pipefail

ATOS="$(dirname "$(readlink -f "$0")")/_acervo"
SPEC="spec acervo (acervo ler casa spec acervo)"

# aviso de forma vigente/deprecada: uma vez por sessao (arq:0110 §11, spec_acervo §8)
avisa() {
  local forma_velha="$1"
  local forma_nova="$2"
  local regra="${3:-arq:0106}"
  local sess_dir="/tmp/platafirma-avisos-${PF_SESSAO_ID:-${PF_SESSAO:-${USER:-default}}}"
  mkdir -p "$sess_dir" 2>/dev/null || true
  local chave
  chave="$(printf '%s' "$forma_velha" | tr -c 'a-zA-Z0-9_' '_')"
  local trava="$sess_dir/$chave"
  if [ ! -f "$trava" ]; then
    touch "$trava" 2>/dev/null || true
    printf 'acervo: `%s` e a forma vigente; a conforme (%s) e `%s`.\n  %s\n' \
      "$forma_velha" "$regra" "$forma_nova" "$SPEC" >&2
  fi
}

uso() {
  cat >&2 <<FIM
uso (gramatica arq:0106 — acervo <ato> <particao> <entidade> [seletor]):
  acervo ler      <particao> <entidade> <seletor> [--situacao]
  acervo listar   <particao> <entidade> [--sobre <termo>] [--eixo <eixo>] [--situacao] [--dono <cadeira>] [--json]
  acervo resolver <classe> <string>
  acervo escrever <particao> <entidade> <seletor>
  acervo ingerir  <particao> <raiz> [--apply]
  acervo ler      casa <especie> <chave> [--offset <bytes>]   pela chave (arq:0115 §3): acervo ler casa adr arq:0075
                  documento longo vem em paginas; o fim diz \`continue com --offset N\`
  acervo listar   casa [<especie>] [--todas]          sem especie: o catalogo (projecao, regime, contagem)
  acervo listar   casa [<especie>] --sobre <classe> <chave>   a documentacao de uma entidade
  acervo listar   casa topologia [<stack>] [--completo] [--json]   golden record acervo.stack
  acervo listar   casa topologia <stack> --rotas|--acessos    ingress/gate da stack
                  (sucessora de \`deploy <stack> rotas|acessos\`; segredos: \`seg segredo exigidos\`)
  acervo ingerir  casa platafirma-casa[@<rev>] [--apply]      o suporte, pelo sha (arq:0115 §8.1)
  acervo lote     <id>
  acervo curar    casa alias <classe> <chave> <alias>
  acervo curar    casa revisao <revid>... --motivo <m> [--apply]   tira texto antigo do historico da wiki
  acervo ler      biblioteca impressao <obra> [--paginas a-b | --capitulo <ancora>] [--formato md|blocos]
                  [--papel corpo|todos] [--cursor c] [--impressao <id>] [--baixar [<pasta>]]
                  o texto da obra pelo espelho de leitura, do comeco e em ordem
  acervo ler      biblioteca objeto <uuid|prefixo|titulo> [--destino <pasta>]
                  o arquivo original da obra; --destino so na bancada ou var/tmp/<ordem_id> (exit 4 fora); diz caminho e sha256
  Classificar (arq:0119 §2, §7) — plano seco sem --apply:
  acervo catalogar     biblioteca obra [<obra>] [--obras …|--de-dominio …|--de-conceito …|--sem-dominio]
                       [--especie|--subtipo|--dominio|--subdominio|--trata-de|--remover-trata-de|--titulo … ] [--apply]
                       espécie, domínio, subdomínio, conceitos e dados de catálogo da obra (classificacao)
  acervo definir       biblioteca conceito <slug> --rotulo … --definicao … --natureza … --estatuto … --pai <slug> --tipo <t>
                       --garantia <g> --motivo "…" [--apply] · <slug> --renomear <slug-novo> --motivo "…"
                       · <slug> --natureza <n> --motivo "…" (conceito existente: reclassifica)   (tesauro)
  acervo relacionar    biblioteca conceito <de> <para> --tipo <t> --garantia <g> --motivo <m> [--lastro <obra>] [--apply]
                       a aresta da teia (tesauro); --ajuda traz as famílias e as garantias
  acervo desrelacionar biblioteca relacao <id> [--sim]                desfaz uma aresta (tesauro)
  acervo derivar       biblioteca obra <obra> --de <origem> [--motivo "…"] [--apply]   a obra deriva da origem (classificacao)
  acervo desderivar    biblioteca obra <obra> --de <origem> [--sim]  desfaz uma derivacao (classificacao)
  acervo listar        biblioteca relacao <conceito> · biblioteca derivacao <obra>
  acervo empacotar     biblioteca obra [dest]   planilha e capas das obras sem espécie, para classificar fora (classificacao)
  acervo curar    biblioteca --situacao <...>
                  (--reclassificar, --conceito, --relacionar, --relacoes, --desrelacionar, --derivar, --derivacoes e
                  --desderivar ainda respondem, com aviso: sao os atos de Classificar acima; --expurgar, --restaurar
                  e --apagar, com aviso: sao os atos de Retirar abaixo)
  Transcrever (arq:0119 §2, §5) — opcional; o texto fiel ao arquivo, em impressao selada:
  acervo espelhar      biblioteca obra <obra> [--metodo <slug>] [--apply]   espelho novo do proprio arquivo; termina na selada
  acervo espelhar      biblioteca lote [--ordem <lista>] [--medida --replicas <n>] [--apply]   o mesmo, em lote
  acervo ler           biblioteca lote <lote> [--json]   estado do lote de espelhar, obra a obra
  acervo recortar      biblioteca obra <obra>   corte novo sobre o mesmo espelho, em impressao nova
  acervo promover      biblioteca obra <obra> --impressao <id>   poe a impressao selada em servico, pela marcacao
  acervo julgar        biblioteca lote [--apply]   veredito pela regua vigente, sem reconverter
  acervo converter     biblioteca obra <id,id…|@arquivo> --bancada <pasta> [--metodo <slug>] [--refazer]
                       converte em pasta de saida (nao escreve no acervo; retomavel); depois:
  acervo listar   biblioteca bancada <pasta> [--json] [--estratos <arquivo>]   perfil x docling por obra (card #3187)
  acervo recolher      biblioteca espelho [<obra>] [--apply]   tira do balde vivo o espelho de impressao aposentada
                       (vai a expurgado/, com volta; o catalogo fica)
  acervo repor         biblioteca espelho [<obra>] [--apply]   a volta de recolher
  Retirar (arq:0119 §2, §9) — plano seco sem --apply:
  acervo retirar       biblioteca obra <obra> --motivo <m> [--apply]    fora de servico, com volta, em cascata (catalogo, impressao, indice)
  acervo restaurar     biblioteca obra <obra> --motivo <m> [--apply]    a obra retirada volta ao catalogo
                       (--motivo e obrigatorio nos dois: fica com a obra, com o autor e a data; sem ele sai 2)
  acervo apagar        biblioteca obra <obra> [--apply]    SEM VOLTA, so a obra ja retirada (catalogo, motor, balde);
                       vai ao dono antes do --apply
  acervo retirar       casa revisao <revid>... --motivo <m> [--apply]   tira texto antigo do historico da wiki
  acervo restaurar     casa revisao <revid>... --motivo <m> [--apply]   devolve ao historico
  acervo extrato  --todas [dest]
  acervo exportar                    regera ontologia/acervo/*.jsonl e vocabulario.json na bancada
  acervo psql     [--banco rag|motor]  <SQL por stdin>
  acervo balde    listar|ler|copiar|mover|apagar <bucket|sha256> [...] [--apply]

as particoes: biblioteca, casa, registro (arq:0106 §2-3). conceito e transversal, vive na biblioteca.
'obra' como particao saiu em 03/10/2026: recusa (exit 2) com a chamada em 'biblioteca'.
leitura e anonima; escrever loga com a conta de bot. ato/particao/entidade desconhecidos
recusam em vez de adivinhar — errar a chamada devolve o vocabulario certo.

doc de produto (o que cada ato faz, entidades por particao, transicao):
  $SPEC
FIM
  exit 2
}

# --ajuda UNIVERSAL, sem efeito colateral (card #2868). ANTES do despacho e varrendo
# TODOS os argumentos. EXCECAO: `... wiki ... --ajuda` cai para o sub-ato (argparse proprio), e
# `relacionar ... --ajuda` cai para a cartilha das familias e garantias do bin/curar.
if [ "${1:-}" != "wiki" ] && [ "${1:-}" != "relacionar" ]; then
  for _a in "$@"; do
    case "$_a" in
      --ajuda|--help|-h) uso ;;
    esac
  done
fi

[ $# -eq 0 ] && uso
ATO="$1"; shift

# ---- forma CONFORME: acervo <ato> <particao> <entidade> [seletor] ----
# ler/listar/escrever roteiam por (particao, entidade) para o sub-ato que ja faz o
# trabalho. A particao entra na decisao; a entidade escolhe o sub-ato de _acervo/.
conforme() {
  local ato="$1"; shift
  local particao="${1:-}"; local entidade="${2:-}"
  # `obra` como particao saiu (arq:0106 §2, emendada em 29/09): a forma velha servia so
  # enquanto a nova nao subia (arq:0106, Consequencias), e a nova subiu em 03/10 (#3197).
  # Recusa com a chamada certa. A tabela acervo.obra e a entidade `obra` nao mudam.
  if [ "$particao" = "obra" ]; then
    shift
    echo "acervo $ato obra: a particao 'obra' saiu em 03/10/2026; chame \`acervo $ato biblioteca $*\` (arq:0106 §2)." >&2
    echo "  $SPEC" >&2
    exit 2
  fi
  case "$particao" in
    biblioteca|casa|registro) ;;
    *) echo "acervo $ato: particao '$particao' desconhecida (biblioteca, casa, registro)." >&2
       echo "  $SPEC" >&2; exit 2 ;;
  esac
  if [ $# -lt 2 ]; then
    # `listar casa` sem especie e o catalogo das especies de casa (arq:0115 §4.3, §11)
    [ "$ato:$particao" = "listar:casa" ] && exec "$ATOS/casa" listar
    echo "acervo $ato $particao: falta a entidade." >&2; echo "  $SPEC" >&2; exit 2
  fi
  shift 2
  case "$ato:$particao:$entidade" in
    # --- casa: wiki, adr, golden records ---
    ler:casa:pagina)        exec "$ATOS/wiki" ler "$@" ;;
    # ADR vive em acervo.casa (especie 'adr') como qualquer especie da tabela: cai no ramo
    # generico `ler:casa:*` abaixo, que le a chave (arq:0075) via _acervo/casa. O sub-ato
    # _acervo/adr, que varria o repo por caminho, esta MORTO (arq:0106: `acervo adr` proscrito).
    ler:casa:ferramental)   exec "$ATOS/ferramenta" "$@" ;;
    ler:casa:stack)         exec "$ATOS/stack" ver "$@" ;;
    ler:casa:cargo)         exec "$ATOS/wiki" cargo "$@" ;;
    listar:casa:pagina)     exec "$ATOS/wiki" listar "$@" ;;
    listar:casa:ferramental) exec "$ATOS/listar" ferramental "$@" ;;
    # topologia (golden record acervo.stack): forma conforme da porta de `deploy <stack>
    # rotas|acessos|segredos` (card #3145 frente D); `_acervo/listar` trata --rotas/--acessos/
    # --completo e o [<stack>] opcional.
    listar:casa:topologia)  exec "$ATOS/listar" topologia "$@" ;;
    escrever:casa:pagina)   exec "$ATOS/wiki" editar "$@" ;;
    escrever:casa:arquivo)  exec "$ATOS/wiki" subir "$@" ;;
    escrever:casa:ferramental) exec "$ATOS/registrar" "$@" ;;
    escrever:casa:stack)
        case "${1:-}" in
          --rm) shift; exec "$ATOS/stack" rm "$@" ;;
          *)    exec "$ATOS/stack" import "$@" ;;
        esac ;;
    escrever:casa:*)
        echo "acervo escrever casa $entidade: $entidade nasce em git, não se escreve no acervo. Caminho: write_file na bancada de platafirma-casa → PR → merge em main → acervo ingerir casa platafirma-casa. escrever grava só: pagina, arquivo, ferramental, stack." >&2
        exit 2 ;;
    escrever:biblioteca:*)
        echo "acervo escrever biblioteca: obra nasce fora e entra por acervo ingerir biblioteca <raiz>, nunca por escrever." >&2
        exit 2 ;;
    # --- casa: raiz de entidades (arq:0108) ---
    # A raiz vive na particao casa. `listar casa entidade` e a forma conforme;
    # o atalho `listar entidade` (sem particao) e tratado no case de $ATO abaixo.
    listar:casa:entidade)   exec "$ATOS/entidade" listar "$@" ;;
    ler:casa:entidade)      exec "$ATOS/entidade" listar "$@" ;;
    # --- biblioteca (cabeçada pela tabela acervo.obra): conceito, objeto, bancada, obra ---
    listar:biblioteca:obra)       exec "$ATOS/listar" obra "$@" ;;
    listar:biblioteca:metodos)    exec "$ATOS/listar" obra metodos "$@" ;;
    # agregador perfil x docling da pasta que `curar --reextrair --bancada` gravou (card #3187):
    # so stdlib, le arquivos, nao toca o acervo
    listar:biblioteca:bancada)    exec "$ATOS/listar" obra bancada "$@" ;;
    listar:biblioteca:conceito)   exec "$ATOS/listar" conceitos "$@" ;;
    # as arestas de um conceito e as derivacoes de uma obra (Classificar, #3296)
    listar:biblioteca:relacao)    exec "$ATOS/curar" obra --relacoes "$@" ;;
    listar:biblioteca:derivacao)  exec "$ATOS/curar" obra --derivacoes "$@" ;;
    # o arquivo original da obra, por uuid (inteiro ou prefixo) ou titulo, em --destino (#2856 l.153/96):
    # precisa de boto3, que so o venv acervo da release tem
    ler:biblioteca:objeto)        exec "${PLATAFIRMA_RELEASE:-/opt/platafirma/current}/venv/acervo/bin/python" "$ATOS/objeto" "$@" ;;
    # o texto da obra pelo espelho de leitura, por pagina ou capitulo (spec espelho-de-leitura
    # §5.4; #3180): cliente fino da rota de leitura do motor, nunca converte nem renderiza
    ler:biblioteca:impressao)     exec python3 "$ATOS/impressao" "$@" ;;
    # o estado da obra e onde ela se lê (arq:0119 §8.3: `curar --situacao` passa a `ler obra --situacao`;
    # #3294): servida inteira aponta o arquivo, com impressão servindo aponta também o trecho.
    # `--situacao` é aceito e não muda nada: a leitura da obra é a situação dela.
    ler:biblioteca:obra)
        args=(); for a in "$@"; do [[ "$a" == --situacao ]] || args+=("$a"); done
        exec "$ATOS/curar" obra --situacao "${args[@]}" ;;
    # o estado de um lote de espelhar, obra a obra (Transcrever, #3297)
    ler:biblioteca:lote)          exec "$ATOS/curar" obra --reextrair --lote --relatorio "$@" ;;
    curar:biblioteca:lote)        avisa "acervo curar biblioteca lote" "acervo empacotar biblioteca obra [dest]" "arq:0119 §2"
                                  exec "$ATOS/bancada" "$@" ;;
    # curadoria de UMA obra (#3126): entidade e a FLAG de bin/curar (--situacao, --expurgar,
    # --restaurar, --promover, --reclassificar, --conceito, --relacionar...), nao um nome fixo
    # -- repassa entidade + resto tal qual para _acervo/curar, que so encosta em bin/curar.
    curar:biblioteca:*)     forma_velha_classificar "$entidade" "$@"
                            forma_velha_transcrever "$entidade" "$@"
                            forma_velha_retirar "$entidade" "$@"
                            exec "$ATOS/curar" obra "$entidade" "$@" ;;
    curar:casa:alias)       exec "$ATOS/curar" alias "$@" ;;
    # revisao antiga de pagina da wiki fora do historico publico (revisiondelete)
    curar:casa:revisao)     avisa "acervo curar casa revisao" "acervo retirar casa revisao <revid>" "arq:0119 §9.1"
                            exec "$ATOS/wiki" ocultar-revisao "$@" ;;
    bancada:biblioteca:lote) exec "$ATOS/bancada" "$@" ;;
    # --- ingerir por particao ---
    # Biblioteca e registro seguem no cliente de obra (objeto-por-sha, MinIO, OCR, bancada).
    # Casa NAO: doc de casa e texto de git — identidade (repo,path), corpo no payload, sem
    # objeto e sem OCR — e o servidor separa os dois caminhos desde o #3027
    # (POST /acervo/casa/lotes). Deixar casa cair aqui SUBIA o .md da casa ao MinIO e criava
    # uma OBRA no lugar de uma linha em acervo.casa: falha silenciosa, que e pior que recusa.
    ingerir:biblioteca:*|ingerir:registro:*)
        if [[ "$entidade" == --* ]]; then
            exec "$ATOS/../ingerir" "$entidade" "$@"
        else
            exec "$ATOS/../ingerir" --lote "$entidade" "$@"
        fi ;;
    ingerir:casa:*)
        # $entidade e a fonte: platafirma-casa[@<rev>] (arq:0115 §8.1). O cliente magro de
        # casa (card #3027, rota POST /acervo/casa/lotes) le o objeto git pelo sha no espelho
        # bare do suporte, na instancia, e sobe {repo,path,sha_ref,titulo,corpo} no payload --
        # sem MinIO, sem OCR, sem release, sem bancada. Nao passa pelo cliente de OBRA.
        # $entidade repassa SEMPRE: flag solta (--apply) chega ao cliente, que a le.
        exec "$ATOS/casa-ingerir" "$entidade" "$@" ;;
    # --- casa generico: especies que vivem na TABELA acervo.casa (arq:0106, arq:0115) ---
    # As entidades com fonte propria (pagina, ferramental, stack, cargo, entidade) ja foram
    # capturadas acima. O que sobra em ler/listar casa <especie> vai ao sub-ato casa,
    # que valida a especie contra acervo.especie_tipo e le de acervo.casa PELA CHAVE
    # (adr arq:0075, spec acervo, nota-tecnica 2026-09-08-...). `listar casa --sobre <classe>
    # <chave>` chega aqui com --sobre no lugar da especie, e o sub-ato o trata.
    ler:casa:*)             exec "$ATOS/casa" ler "$entidade" "$@" ;;
    listar:casa:*)          exec "$ATOS/casa" listar "$entidade" "$@" ;;
    *) echo "acervo $ato $particao $entidade: combinacao nao servida." >&2
       echo "  entidades de $particao e formas validas: $SPEC" >&2; exit 2 ;;
  esac
}

# ---- atos de Classificar (arq:0119 §2, §4, §7; #3296) ----
# O ato tem o nome do que faz no estagio; o trabalho segue em bin/curar, chamado pela opcao
# que ja o fazia. A tabela de-para mora na spec acervo, secao 10.
classificar() {
  local ato="$1"; shift
  if [ "$ato" = "relacionar" ]; then
    for _a in "$@"; do
      case "$_a" in --ajuda|--help|-h) exec "$ATOS/curar" obra --relacionar --ajuda ;; esac
    done
  fi
  local particao="${1:-}" entidade="${2:-}" esperada
  case "$ato" in
    catalogar|derivar|desderivar|empacotar) esperada=obra ;;
    definir|relacionar)           esperada=conceito ;;
    desrelacionar)                esperada=relacao ;;
  esac
  if [ "$particao" != "biblioteca" ] || [ "$entidade" != "$esperada" ]; then
    echo "acervo $ato: a forma e \`acervo $ato biblioteca $esperada …\`; veio \`acervo $ato $*\`." >&2
    echo "  $SPEC" >&2
    exit 2
  fi
  shift 2
  case "$ato" in
    catalogar)
      # a obra posicional e opcional: sem ela, a selecao vai por flag (--obras, --de-dominio…)
      if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
        local obra="$1"; shift
        exec "$ATOS/curar" obra --reclassificar --obra "$obra" "$@"
      fi
      exec "$ATOS/curar" obra --reclassificar "$@" ;;
    definir)       exec "$ATOS/curar" obra --conceito "$@" ;;
    relacionar)    exec "$ATOS/curar" obra --relacionar "$@" ;;
    desrelacionar) exec "$ATOS/curar" obra --desrelacionar "$@" ;;
    derivar)       exec "$ATOS/curar" obra --derivar "$@" ;;
    desderivar)    exec "$ATOS/curar" obra --desderivar "$@" ;;
    # o pacote de classificacao externa (planilha e capas das obras sem especie, card 258)
    empacotar)     exec "$ATOS/bancada" "$@" ;;
  esac
}

# A forma velha de Classificar (`acervo curar biblioteca --<opcao>`) segue rodando, com aviso que
# nomeia o ato novo. A ordem dos testes e a do despacho de bin/curar: quem ele atenderia primeiro
# decide o aviso. Opcao de Transcrever, Retirar ou Incorporar nao avisa aqui (#3295, #3297, #3298).
forma_velha_classificar() {
  local tem=" " a t velha="" nova=""
  for a in "$@"; do
    case "$a" in --*) tem+="${a%%=*} " ;; esac
  done
  for t in --espelhos --lote --rejulgar --ordem --relatorio --bancada --refazer --timeout-s --modo \
           --recortar --reextrair; do
    [[ "$tem" == *" $t "* ]] && return 0
  done
  if   [[ "$tem" == *" --conceito "* ]];       then velha=--conceito;      nova="acervo definir biblioteca conceito <slug>"
  elif [[ "$tem" == *" --derivar "* ]];        then velha=--derivar;       nova="acervo derivar biblioteca obra <obra> --de <origem>"
  elif [[ "$tem" == *" --derivacoes "* ]];     then velha=--derivacoes;    nova="acervo listar biblioteca derivacao <obra>"
  elif [[ "$tem" == *" --desderivar "* ]];     then velha=--desderivar;    nova="acervo desderivar biblioteca obra <obra> --de <origem>"
  elif [[ "$tem" == *" --registrar-obra "* ]]; then return 0
  elif [[ "$tem" == *" --relacionar "* ]];     then velha=--relacionar;    nova="acervo relacionar biblioteca conceito <de> <para>"
  elif [[ "$tem" == *" --relacoes "* ]];       then velha=--relacoes;      nova="acervo listar biblioteca relacao <conceito>"
  elif [[ "$tem" == *" --desrelacionar "* ]];  then velha=--desrelacionar; nova="acervo desrelacionar biblioteca relacao <id>"
  else
    for t in --situacao --expurgar --restaurar --apagar --promover; do
      [[ "$tem" == *" $t "* ]] && return 0
    done
    for t in --reclassificar --obra --obras --de-dominio --trata-de --remover-trata-de --substituir-trata-de; do
      if [[ "$tem" == *" $t "* ]]; then
        velha=--reclassificar; nova="acervo catalogar biblioteca obra [<obra>]"; break
      fi
    done
    [ -n "$velha" ] || return 0
  fi
  avisa "acervo curar biblioteca $velha" "$nova" "arq:0119 §2"
}

# ---- atos de Transcrever (arq:0119 §2, §5; #3297) ----
# Mesmo desenho do Classificar: o ato tem o nome do que faz, o trabalho segue em bin/curar pela
# opcao que ja o fazia. `converter` nao e `espelhar` porque nao escreve no acervo (arq:0118 §4);
# `julgar` e o `--rejulgar`, sem o prefixo, que o ato nao precisa. De-para: spec acervo, secao 10.
transcrever() {
  local ato="$1"; shift
  local particao="${1:-}" entidade="${2:-}" esperada
  case "$ato" in
    recortar|promover|converter) esperada=obra ;;
    julgar)                      esperada=lote ;;
    espelhar)                    esperada="$entidade"
                                 [ "$entidade" = obra ] || [ "$entidade" = lote ] || esperada="obra|lote" ;;
  esac
  if [ "$particao" != "biblioteca" ] || [ "$entidade" != "$esperada" ]; then
    echo "acervo $ato: a forma e \`acervo $ato biblioteca $esperada …\`; veio \`acervo $ato $*\`." >&2
    echo "  $SPEC" >&2
    exit 2
  fi
  shift 2
  case "$ato:$entidade" in
    espelhar:obra)  exec "$ATOS/curar" obra --reextrair "$@" ;;
    espelhar:lote)  exec "$ATOS/curar" obra --reextrair --lote "$@" ;;
    recortar:obra)  exec "$ATOS/curar" obra --recortar "$@" ;;
    promover:obra)  exec "$ATOS/curar" obra --promover "$@" ;;
    julgar:lote)    exec "$ATOS/curar" obra --rejulgar --lote "$@" ;;
    converter:obra)
      local a
      for a in "$@"; do [ "$a" = --bancada ] && exec "$ATOS/curar" obra --reextrair "$@"; done
      echo "acervo converter: falta --bancada <pasta>; converter nao escreve no acervo (o que escreve e \`acervo espelhar\`)." >&2
      exit 2 ;;
  esac
}

# A forma velha de Transcrever (`acervo curar biblioteca --reextrair|--recortar|--promover|--rejulgar`)
# segue rodando e saindo como sempre (o lote da #3194 roda por ela), com aviso que nomeia o ato novo.
forma_velha_transcrever() {
  local tem=" " a velha="" nova=""
  for a in "$@"; do
    case "$a" in --*) tem+="${a%%=*} " ;; esac
  done
  if   [[ "$tem" == *" --rejulgar "* ]];  then velha="--rejulgar --lote"; nova="acervo julgar biblioteca lote"
  elif [[ "$tem" == *" --reextrair "* ]]; then
    if   [[ "$tem" == *" --bancada "* ]];   then velha="--reextrair --bancada"; nova="acervo converter biblioteca obra <ids> --bancada <pasta>"
    elif [[ "$tem" == *" --relatorio "* ]]; then velha="--reextrair --lote --relatorio"; nova="acervo ler biblioteca lote <lote>"
    elif [[ "$tem" == *" --lote "* ]];      then velha="--reextrair --lote"; nova="acervo espelhar biblioteca lote"
    else velha=--reextrair; nova="acervo espelhar biblioteca obra <obra>"
    fi
  elif [[ "$tem" == *" --espelhos "* ]];  then return 0
  elif [[ "$tem" == *" --recortar "* ]];  then velha=--recortar; nova="acervo recortar biblioteca obra <obra>"
  elif [[ "$tem" == *" --promover "* ]];  then velha=--promover; nova="acervo promover biblioteca obra <obra> --impressao <id>"
  else return 0
  fi
  avisa "acervo curar biblioteca $velha" "$nova" "arq:0119 §2"
}

# ---- atos de Retirar (arq:0119 §2, §9; #3298) ----
# Mesmo desenho: o ato tem o nome do que faz, o trabalho segue em bin/curar (obra) e em _acervo/wiki
# (revisao). retirar e restaurar tem volta; apagar nao tem, e so vale para a obra ja retirada.
# recolher e repor agem sobre o espelho de impressao aposentada, nao sobre a obra: nome proprio, para
# que a mesma raiz nao tenha efeito diferente conforme o objeto (arq:0118 §4). De-para: spec acervo, secao 10.
retirada() {
  local ato="$1"; shift
  local particao="${1:-}" entidade="${2:-}"
  case "$ato:$particao:$entidade" in
    retirar:biblioteca:obra|restaurar:biblioteca:obra|apagar:biblioteca:obra) ;;
    retirar:casa:revisao|restaurar:casa:revisao) ;;
    recolher:biblioteca:espelho|repor:biblioteca:espelho) ;;
    *)
      local forma="biblioteca obra <obra>"
      case "$ato" in
        retirar|restaurar) forma="biblioteca obra <obra>\` ou \`acervo $ato casa revisao <revid>" ;;
        recolher|repor)    forma="biblioteca espelho [<obra>]" ;;
      esac
      echo "acervo $ato: a forma e \`acervo $ato $forma\`; veio \`acervo $ato $*\`." >&2
      echo "  $SPEC" >&2
      exit 2 ;;
  esac
  shift 2
  case "$ato:$entidade" in
    retirar:obra)     exec "$ATOS/curar" obra --expurgar "$@" ;;
    restaurar:obra)   exec "$ATOS/curar" obra --restaurar "$@" ;;
    apagar:obra)      exec "$ATOS/curar" obra --apagar "$@" ;;
    retirar:revisao)  exec "$ATOS/wiki" ocultar-revisao "$@" ;;
    restaurar:revisao) exec "$ATOS/wiki" mostrar-revisao "$@" ;;
    # --espelhos antes: a obra opcional cai no --expurgar|--restaurar, que a lê como valor
    recolher:espelho) exec "$ATOS/curar" obra --espelhos --expurgar "$@" ;;
    repor:espelho)    exec "$ATOS/curar" obra --espelhos --restaurar "$@" ;;
  esac
}

# A forma velha de Retirar (`acervo curar biblioteca --expurgar|--restaurar|--apagar`, com ou sem
# --espelhos) segue rodando e saindo como sempre, com aviso que nomeia o ato novo.
forma_velha_retirar() {
  local tem=" " a velha="" nova=""
  for a in "$@"; do
    case "$a" in --*) tem+="${a%%=*} " ;; esac
  done
  if [[ "$tem" == *" --espelhos "* ]]; then
    if   [[ "$tem" == *" --expurgar "* ]];  then velha="--expurgar --espelhos";  nova="acervo recolher biblioteca espelho [<obra>]"
    elif [[ "$tem" == *" --restaurar "* ]]; then velha="--restaurar --espelhos"; nova="acervo repor biblioteca espelho [<obra>]"
    else return 0
    fi
  elif [[ "$tem" == *" --expurgar "* ]];  then velha=--expurgar;  nova="acervo retirar biblioteca obra <obra>"
  elif [[ "$tem" == *" --restaurar "* ]]; then velha=--restaurar; nova="acervo restaurar biblioteca obra <obra>"
  elif [[ "$tem" == *" --apagar "* ]];    then velha=--apagar;    nova="acervo apagar biblioteca obra <obra>"
  else return 0
  fi
  avisa "acervo curar biblioteca $velha" "$nova" "arq:0119 §9"
}

case "$ATO" in
  catalogar|definir|relacionar|desrelacionar|derivar|desderivar|empacotar) classificar "$ATO" "$@" ;;
  espelhar|recortar|promover|julgar|converter) transcrever "$ATO" "$@" ;;
  retirar|restaurar|apagar|recolher|repor) retirada "$ATO" "$@" ;;

  # resolver <classe> <string>: o ato de resolucao de identidade da raiz (arq:0108
  # §5, arq:0022). Nao segue a gramatica ato-particao-entidade: a raiz e uma so
  # (acervo.entidade), a classe ja diz o recorte. Vai direto ao sub-ato.
  resolver)             exec "$ATOS/entidade" resolver "$@" ;;

  # listar/ler com alvo `entidade` SEM particao explicita: atalho para a raiz.
  # `listar entidade [--especie|--dona]` e a forma que a ordem de 0108 pediu; a
  # conforme e `listar casa entidade`, roteada no conforme() acima. Aqui capturamos
  # o atalho antes de conforme() tratar `entidade` como nome de particao (e recusar).
  ler)
    if [ "${1:-}" = "entidade" ]; then
      shift
      exec "$ATOS/entidade" listar "$@"
    fi
    conforme "$ATO" "$@" ;;

  listar)
    if [ "${1:-}" = "entidade" ]; then
      shift
      exec "$ATOS/entidade" listar "$@"
    fi
    case "${1:-}" in
      biblioteca|obra|casa|registro) conforme "$ATO" "$@" ;;
      *)
        avisa "acervo listar <entidade>" "acervo listar <particao> <entidade>"
        exec "$ATOS/listar" "$@" ;;
    esac ;;

  # gramatica conforme (arq:0106)
  escrever)             conforme "$ATO" "$@" ;;
  curar)                conforme "$ATO" "$@" ;;
  lote)                 exec "$ATOS/lote" "$@" ;;
  ingerir)
    # conforme: ingerir <particao> <raiz>; vigente: ingerir <raiz> (alias de `ingerir --lote`)
    case "${1:-}" in
      biblioteca|obra|casa|registro) conforme ingerir "$@" ;;
      *) avisa "acervo ingerir <raiz>" "acervo ingerir <particao> <raiz>"
         exec "$ATOS/ingerir" "$@" ;;
    esac ;;
  escada)
    avisa "acervo escada" "acervo listar biblioteca obra --situacao"
    case "${1:-}" in
      --todas) shift ;;
      biblioteca|obra|casa|registro) ;;
    esac
    exec "$ATOS/escada" "$@" ;;
  baixar)          avisa "acervo baixar \"<titulo>\"" "acervo ler biblioteca objeto \"<titulo>\""
                   exec "${PLATAFIRMA_RELEASE:-/opt/platafirma/current}/venv/acervo/bin/python" "$ATOS/objeto" "$@" ;;
  bancada)
    avisa "acervo bancada" "acervo empacotar biblioteca obra [dest]" "arq:0119 §2"
    case "${1:-}" in
      biblioteca|obra) conforme bancada "$@" ;;
      *) exec "$ATOS/bancada" "$@" ;;
    esac ;;
  extrato)
    case "${1:-}" in
      --todas) shift ;;
      biblioteca|obra|casa|registro) ;;
      *) avisa "acervo extrato" "acervo extrato --todas" ;;
    esac
    exec "$ATOS/extrato" "$@" ;;
  # exportar: a cadeia derivada do vocabulario (export -> vocabulario.json) na bancada da
  # sessao. Contrato do export e de dados; o ato so expoe (pedido 20260922T220127-dados).
  exportar)        exec python3 "$ATOS/exportar" "$@" ;;
  # balde: braco do curador sobre o store MinIO (#3126, pedido 20260922T180117-dados) --
  # listar/ler/copiar/mover/apagar objeto de bucket, plano seco por padrao e --apply pra gravar.
  balde)           exec python3 "$ATOS/balde" "$@" ;;
  psql)
    case "${1:-}" in
      --banco|--sql) ;;
      "") ;;
      -h|--help|ajuda) ;;
      rag|motor) avisa "acervo psql <banco>" "acervo psql --banco <banco>" ;;
      *) ;;
    esac
    exec bash "$ATOS/psql" "$@" ;;

  # formas VIGENTES/DEPRECADAS com implementacao: avisam uma vez por sessao e delegam
  registrar)       avisa "acervo registrar <verbo>" "acervo escrever casa ferramental <verbo>"
                   exec "$ATOS/registrar" "$@" ;;
  stack)           avisa "acervo stack <ato>" "acervo ler/escrever casa stack"
                   exec "$ATOS/stack"   "$@" ;;
  ferramenta)      avisa "acervo ferramenta <nome>" "acervo ler casa ferramental <nome>"
                   exec "$ATOS/ferramenta" "$@" ;;
  wiki)            avisa "acervo wiki <ato>" "acervo ler/listar/escrever casa pagina|arquivo|cargo"
                   exec "$ATOS/wiki"    "$@" ;;

  # `acervo adr` esta proscrito (arq:0106) e o atalho supunha a serie arq para numero nu,
  # o que arq:0115 §3.2 desfaz (arq e ont compartilham numeros): recusa com a forma certa.
  adr)
    echo "acervo adr: ato deprecado e removido (arq:0106). Use \`acervo ler casa adr <chave>\` (ex.: arq:0075) ou \`acervo listar casa adr\`." >&2
    echo "  $SPEC" >&2
    exit 2 ;;

  -h|--help|ajuda) uso ;;
  *)
    echo "acervo: ato '$ATO' desconhecido. Atos canonicos: ler, listar, resolver, escrever, ingerir, curar, extrato, exportar, psql, balde, catalogar, definir, relacionar, desrelacionar, derivar, desderivar, empacotar, espelhar, recortar, promover, julgar, converter, recolher, repor, retirar, restaurar, apagar." >&2
    echo "  $SPEC" >&2
    exit 2 ;;
esac
