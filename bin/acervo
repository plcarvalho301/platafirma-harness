#!/usr/bin/env bash
# acervo — opera o acervo: ingestão ponta a ponta, escada, obra, bancada e extrato.
# capacidade: conhecimento
# dono: claudinho-conhecimento
#
# Despachante (arq:0040): o verbo é o par binário+subcomando. Os sub-atos moram
# em bin/_acervo/ e não entram no PATH; a porta é esta.
set -euo pipefail

ATOS="$(dirname "$(readlink -f "$0")")/_acervo"

uso() {
  cat >&2 <<'FIM'
uso:
  acervo ingerir <raiz> [--apply]            leva a obra da entrada até a vetorização
  acervo escada  [--json] [--detalhe]        onde cada obra parou nos cinco degraus
  acervo baixar  "<trecho do titulo>" [dest] tira uma cópia da obra do store
  acervo bancada [destino]                   monta o lote do que falta classificar
  acervo extrato [destino]                   foto do acervo para ler fora da bancada
  acervo listar  conceitos [--json]          golden record acervo.conceito (referência)
  acervo listar  ferramental [--json]        golden record acervo.ferramental (3 níveis)
  acervo stack   ver|import|rm               topologia de deploy: lê e ESCREVE acervo.stack
  acervo ferramenta <nome> [--json]          o que e <nome> e qual o verbo certo

Os cinco degraus da escada: catalogada, armazenada, ingerida, embedded,
vetorizada. `escada` mede; os outros três produzem artefato.

`ingerir` é o único que escreve, e é dry-run sem `--apply`. Os outros cinco só
leem. Ato desconhecido recusa em vez de adivinhar.
FIM
  exit 2
}

# --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4). ANTES do
# despacho e varrendo TODOS os argumentos: interceptar aqui cobre `acervo --ajuda`
# e `acervo <sub> --ajuda`, e nenhum sub-ato (exec do $ATOS/*) chega a rodar. `uso` ja sai 2.
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

[ $# -eq 0 ] && uso
ATO="$1"; shift

case "$ATO" in
  ingerir)         exec "$ATOS/ingerir" "$@" ;;
  escada)          exec "$ATOS/escada"  "$@" ;;
  baixar)          exec "$ATOS/baixar"  "$@" ;;
  bancada)         exec "$ATOS/bancada" "$@" ;;
  extrato)         exec "$ATOS/extrato" "$@" ;;
  listar)          exec "$ATOS/listar"  "$@" ;;
  stack)           exec "$ATOS/stack"   "$@" ;;
  ferramenta)      exec "$ATOS/ferramenta" "$@" ;;
  -h|--help|ajuda) uso ;;
  *) echo "acervo: ato desconhecido '$ATO'" >&2; uso ;;
esac
