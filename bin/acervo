#!/usr/bin/env bash
# acervo — opera o acervo: ingestão ponta a ponta, escada, obra, bancada, extrato e a wiki.
# capacidade: conhecimento
# dono: claudinho-dados
# use para: ingerir obra, escada, bancada, extrato, stack, registrar verbo, golden record, operar a wiki
# atos: ingerir, baixar, escada, bancada, extrato, listar, registrar, ferramenta, stack, adr, wiki
#
# ato: ingerir <raiz> [--apply] — leva a obra da entrada ate a vetorizacao
#   sem --apply, so diz o que faria
#   ex: acervo ingerir entrada/lote-12 --apply
# ato: escada [--json] [--detalhe] — onde cada obra parou nos cinco degraus
#   ex: acervo escada --json
# ato: baixar "<trecho do titulo>" [dest] — tira uma copia da obra do store
#   ex: acervo baixar "rito de debito"
# ato: bancada [destino] — monta o lote do que falta classificar
#   ex: acervo bancada
# ato: extrato [destino] — foto do acervo para ler fora da bancada
#   ex: acervo extrato
# ato: listar <conceitos|ferramental> [--json] — golden record acervo.conceito / acervo.ferramental
#   ex: acervo listar ferramental --json
# ato: registrar <verbo>|--todos — ESCREVE o verbo no golden record, lido do cabecalho
#   ex: acervo registrar repo
# ato: stack <ver|import|rm> — topologia de deploy: le e ESCREVE acervo.stack
#   ex: acervo stack ver
# ato: ferramenta <nome> [--json] — o que e <nome> e qual o verbo certo
#   ex: acervo ferramenta pytest
# ato: adr <lista|<codigo>|--<entidade>> — consulta o registro de decisoes de arquitetura
#   ex: acervo adr 0037
# ato: wiki <sub-ato> — a wiki (MediaWiki) como fonte editavel do acervo
#   ler <titulo...>                      wikitext da(s) pagina(s), com rev para editar sem conflito
#   buscar <termo> [--limite N]          busca full-text na prosa
#   listar [--prefixo|--categoria|--ns]  titulos por prefixo, categoria ou namespace
#   editar <titulo> [--resumo] [--base-rev]   cria/substitui; conteudo por STDIN
#   subir <arquivo> [--nome]             envia arquivo (Arquivo:<nome>), teto 2 MB
#   cargo <tabela> <campos> [--where ...]     consulta SQL sobre campos Cargo
#   leitura e anonima; editar e subir logam com a conta de bot
#   ex: acervo wiki ler "PlataFirma"
#
# exit: 0 ok · 1 falha declarada · 2 uso
#
# Despachante (arq:0040): o verbo é o par binário+subcomando. Os sub-atos moram
# em bin/_acervo/ e não entram no PATH; a porta é esta.
set -euo pipefail

ATOS="$(dirname "$(readlink -f "$0")")/_acervo"

# Mapa (N1), forma por ato (N2) e recusa de ato desconhecido saem de lib/uso.sh, que
# renderiza o cabecalho deste arquivo (card #3016). O heredoc abaixo segue servindo o
# erro DENTRO de um ato, que e do verbo.
. "$(dirname "$(readlink -f "$0")")/../lib/uso.sh"
uso_intercepta "$@"

uso() {
  cat >&2 <<'FIM'
uso:
  acervo ingerir <raiz> [--apply]            leva a obra da entrada até a vetorização
  acervo escada  [--json] [--detalhe]        onde cada obra parou nos cinco degraus
  acervo baixar  "<trecho do titulo>" [dest] tira uma cópia da obra do store
  acervo bancada [destino]                   monta o lote do que falta classificar
  acervo extrato [destino]                   foto do acervo para ler fora da bancada
  acervo listar  conceitos [--json]          golden record acervo.conceito (referência)
  acervo listar  ferramental [--json]        golden record acervo.ferramental (3 níveis)
  acervo registrar <verbo>|--todos           ESCREVE verbo no golden record (do cabeçalho)
  acervo stack   ver|import|rm               topologia de deploy: lê e ESCREVE acervo.stack
  acervo ferramenta <nome> [--json]          o que e <nome> e qual o verbo certo
  acervo adr <lista|<codigo>|--<entidade>>   consulta registro de decisões de arquitetura (ADR)
  acervo wiki    <ato>                        a wiki (MediaWiki) como fonte editável do acervo

`acervo wiki` (a wiki é SoT de registro editável, dona dados — arq:0069). Atos:
  ler <titulo...>                            wikitext da(s) página(s) (+rev p/ editar sem conflito)
  buscar <termo> [--limite N]                busca full-text na prosa (ns de conteúdo)
  listar [--prefixo|--categoria|--ns]        títulos por prefixo, categoria ou namespace
  editar <titulo> [--resumo] [--base-rev]    cria/substitui (conteúdo por STDIN), sob a conta de bot
  subir <arquivo> [--nome]                   envia arquivo (Arquivo:<nome>), teto 2 MB
  cargo <tabela> <campos> [--where ...]      consulta SQL sobre campos Cargo declarados
Leitura é anônima; editar/subir logam com a conta de bot Claudinho. Contrato = a
Action API do MediaWiki (spec_recuperador §5); `acervo wiki` é consumidor direto dela.

Os cinco degraus da escada: catalogada, armazenada, ingerida, embedded,
vetorizada. `escada` mede; os outros três produzem artefato.

`ingerir` é o único da ingestão que escreve, e é dry-run sem `--apply`. Em `wiki`,
`editar`/`subir` escrevem; `ler`/`buscar`/`listar`/`cargo` só leem. Os demais atos só
leem. Ato desconhecido recusa em vez de adivinhar.
FIM
  exit 2
}

# --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4). ANTES do
# despacho e varrendo TODOS os argumentos: interceptar aqui cobre `acervo --ajuda`
# e `acervo <sub> --ajuda`, e nenhum sub-ato (exec do $ATOS/*) chega a rodar. `uso` ja sai 2.
# EXCECAO: `acervo wiki ... --ajuda` cai para o sub-ato (argparse do wiki tem -h proprio),
# senao a ajuda do wiki nunca apareceria.
if [ "${1:-}" != "wiki" ]; then
  for _a in "$@"; do
    case "$_a" in
      --ajuda|--help|-h) uso ;;
    esac
  done
fi

[ $# -eq 0 ] && uso
ATO="$1"; shift

case "$ATO" in
  ingerir)         exec "$ATOS/ingerir" "$@" ;;
  escada)          exec "$ATOS/escada"  "$@" ;;
  baixar)          exec "$ATOS/baixar"  "$@" ;;
  bancada)         exec "$ATOS/bancada" "$@" ;;
  extrato)         exec "$ATOS/extrato" "$@" ;;
  listar)          exec "$ATOS/listar"  "$@" ;;
  registrar)       exec "$ATOS/registrar" "$@" ;;
  stack)           exec "$ATOS/stack"   "$@" ;;
  ferramenta)      exec "$ATOS/ferramenta" "$@" ;;
  adr)             exec "$ATOS/adr"     "$@" ;;
  wiki)            exec "$ATOS/wiki"    "$@" ;;
  -h|--help|ajuda) uso ;;
  *) echo "acervo: ato desconhecido '$ATO'" >&2; uso ;;
esac
