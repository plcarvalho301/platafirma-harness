#!/usr/bin/env bash
# acervo — opera o acervo: ingestão ponta a ponta, escada, obra, bancada, extrato e a wiki.
# capacidade: conhecimento
# dono: claudinho-dados
# use para: ler uma ADR/página/obra que você sabe onde está (ler casa|obra), listar o que há de um tipo (listar), gravar uma página de wiki (escrever casa pagina)
# atos: ler, listar, escrever, ingerir, baixar, bancada, extrato, escada, psql — sobre partição obra|casa|registro
# conforme: parcial (arq:0106 — gramatica verbo-ato-particao-entidade; forma vigente ainda responde COM aviso)
#
# Despachante (arq:0040): o verbo é o par binário+subcomando. Os sub-atos moram
# em bin/_acervo/ e não entram no PATH; a porta é esta.
#
# GRAMATICA (arq:0106): acervo <ato> <particao> <entidade> [seletor]. A forma
# conforme roteia para os mesmos sub-atos de _acervo/; a forma vigente (adr, wiki,
# ferramenta, registrar, stack, listar conceitos...) ainda responde, mas cospe um
# aviso ao stderr apontando a forma nova e a spec. Doc de produto:
#   https://github.com/plcarvalho301/platafirma-arquitetura/blob/main/docs/spec_acervo.md
set -euo pipefail

ATOS="$(dirname "$(readlink -f "$0")")/_acervo"
SPEC="https://github.com/plcarvalho301/platafirma-arquitetura/blob/main/docs/spec_acervo.md"

# aviso de forma vigente: nunca em silencio (spec_acervo §5). $1=forma velha, $2=forma nova
avisa() {
  printf 'acervo: `%s` e a forma vigente; a conforme (arq:0106) e `%s`.\n  %s\n' \
    "$1" "$2" "$SPEC" >&2
}

uso() {
  cat >&2 <<FIM
uso (gramatica arq:0106 — acervo <ato> <particao> <entidade> [seletor]):
  acervo ler      <particao> <entidade> <seletor>   leitura exata (nao passa pelo motor)
      ex: acervo ler casa adr 0105 · acervo ler casa ferramental <nome>
          acervo ler casa chapeu <slug> · acervo ler casa stack <slug>
          acervo ler casa pagina "<Titulo>" · acervo ler obra objeto "<titulo>" [dest]
  acervo listar   <particao> <entidade> [filtros]   lista entidades de um tipo
      ex: acervo listar obra conceito [--json] · acervo listar casa adr [--cap x]
          acervo listar casa ferramental [--json] [--oficio] · acervo listar casa pagina [--prefixo|--categoria|--ns]
  acervo escrever <particao> <entidade> <seletor>   cria/substitui (corpo por STDIN)
      ex: acervo escrever casa pagina "<Titulo>" [--resumo] · acervo escrever casa ferramental <verbo>|--todos
          acervo escrever casa stack <arquivo.json>|--rm <slug> · acervo escrever casa arquivo <nome>
  acervo ingerir  <particao> <raiz> [--apply]       leva a fonte ate a vetorizacao (dry-run sem --apply)
  acervo baixar   obra objeto "<titulo>" [dest]     copia do objeto do store
  acervo bancada  obra lote [dest]                  monta o lote de classificacao humana
  acervo extrato  --todas [dest]                    foto do schema para leitura fora da bancada
  acervo escada   --todas|<particao> [--json] [--detalhe]  onde cada obra parou nos cinco degraus
  acervo psql     [--banco rag|motor]  <SQL por stdin>     SQL cru no Postgres da casa (default rag)

as particoes: obra, casa, registro (arq:0106 §3). conceito e transversal, vive em obra.
leitura e anonima; escrever loga com a conta de bot. ato/particao/entidade desconhecidos
recusam em vez de adivinhar — errar a chamada devolve o vocabulario certo.

doc de produto (o que cada ato faz, entidades por particao, transicao):
  $SPEC
FIM
  exit 2
}

# --ajuda UNIVERSAL, sem efeito colateral (card #2868). ANTES do despacho e varrendo
# TODOS os argumentos. EXCECAO: `... wiki ... --ajuda` cai para o sub-ato (argparse proprio).
if [ "${1:-}" != "wiki" ]; then
  for _a in "$@"; do
    case "$_a" in
      --ajuda|--help|-h) uso ;;
    esac
  done
fi

[ $# -eq 0 ] && uso
ATO="$1"; shift

# ---- forma CONFORME: acervo <ato> <particao> <entidade> [seletor] ----
# ler/listar/escrever roteiam por (particao, entidade) para o sub-ato que ja faz o
# trabalho. A particao entra na decisao; a entidade escolhe o sub-ato de _acervo/.
conforme() {
  local ato="$1"; shift
  local particao="${1:-}"; local entidade="${2:-}"
  case "$particao" in
    obra|casa|registro) ;;
    *) echo "acervo $ato: particao '$particao' desconhecida (obra, casa, registro)." >&2
       echo "  $SPEC" >&2; exit 2 ;;
  esac
  shift 2 || { echo "acervo $ato $particao: falta a entidade." >&2; echo "  $SPEC" >&2; exit 2; }
  case "$ato:$particao:$entidade" in
    # --- casa: wiki, adr, golden records ---
    ler:casa:pagina)        exec "$ATOS/wiki" ler "$@" ;;
    # ADR agora vive em acervo.casa (especie 'adr') como qualquer especie da tabela: cai no
    # ramo generico `ler:casa:*` abaixo, que le de acervo.casa via _acervo/casa. O sub-ato
    # _acervo/adr (que varria macro-global/) esta MORTO (arq:0106: `acervo adr` proscrito).
    ler:casa:ferramental)   exec "$ATOS/ferramenta" "$@" ;;
    ler:casa:stack)         exec "$ATOS/stack" ver "$@" ;;
    ler:casa:cargo)         exec "$ATOS/wiki" cargo "$@" ;;
    listar:casa:pagina)     exec "$ATOS/wiki" listar "$@" ;;
    listar:casa:adr)        exec "$ATOS/adr" lista "$@" ;;
    listar:casa:ferramental) exec "$ATOS/listar" ferramental "$@" ;;
    escrever:casa:pagina)   exec "$ATOS/wiki" editar "$@" ;;
    escrever:casa:arquivo)  exec "$ATOS/wiki" subir "$@" ;;
    escrever:casa:ferramental) exec "$ATOS/registrar" "$@" ;;
    escrever:casa:stack)
        case "${1:-}" in
          --rm) shift; exec "$ATOS/stack" rm "$@" ;;
          *)    exec "$ATOS/stack" import "$@" ;;
        esac ;;
    # --- obra: conceito, objeto, bancada ---
    listar:obra:conceito)   exec "$ATOS/listar" conceitos "$@" ;;
    ler:obra:objeto)        exec "$ATOS/baixar" "$@" ;;
    bancada:obra:lote)      exec "$ATOS/bancada" "$@" ;;
    # --- ingerir por particao ---
    # Obra e registro seguem no cliente de obra (objeto-por-sha, MinIO, OCR, bancada).
    # Casa NAO: doc de casa e texto de git — identidade (repo,path), corpo no payload, sem
    # objeto e sem OCR — e o servidor separa os dois caminhos desde o #3027
    # (POST /acervo/casa/lotes). Deixar casa cair aqui SUBIA o .md da casa ao MinIO e criava
    # uma OBRA no lugar de uma linha em acervo.casa: falha silenciosa, que e pior que recusa.
    ingerir:obra:*|ingerir:registro:*)
        exec "$ATOS/../ingerir" --lote "$entidade" "$@" ;;
    ingerir:casa:*)
        # $entidade e a <raiz> (lista curada ou clone). O cliente magro de casa (card #3027,
        # rota POST /acervo/casa/lotes) parseia a lista, resolve sha por repo, le o corpo do
        # git e sobe no payload -- sem MinIO, sem OCR. Nao passa pelo cliente de OBRA.
        case "$entidade" in
          --*) exec "$ATOS/casa-ingerir" "$@" ;;
          *)   exec "$ATOS/casa-ingerir" "$entidade" "$@" ;;
        esac ;;
    # --- casa generico: especies que vivem na TABELA acervo.casa (arq:0106) ---
    # As especies com fonte propria (adr, pagina-wiki, stack, ferramental) ja foram
    # capturadas acima. O que sobra em ler/listar casa <especie> vai ao sub-ato casa,
    # que valida a especie contra acervo.especie_tipo e le de acervo.casa. Assim as
    # especies novas (caderno, persona, spec, minuta, cabecalho-de-verbo, automacao)
    # sao servidas sem hard-code, resolvendo contra a taxonomia viva.
    ler:casa:*)             exec "$ATOS/casa" ler "$entidade" "$@" ;;
    listar:casa:*)          exec "$ATOS/casa" listar "$entidade" "$@" ;;
    *) echo "acervo $ato $particao $entidade: combinacao nao servida." >&2
       echo "  entidades de $particao e formas validas: $SPEC" >&2; exit 2 ;;
  esac
}

case "$ATO" in
  # gramatica conforme (arq:0106)
  ler|listar|escrever)  conforme "$ATO" "$@" ;;
  ingerir)
    # conforme: ingerir <particao> <raiz>; vigente: ingerir <raiz> (alias de `ingerir --lote`)
    case "${1:-}" in
      obra|casa|registro) conforme ingerir "$@" ;;
      *) avisa "acervo ingerir <raiz>" "acervo ingerir <particao> <raiz>"
         exec "$ATOS/ingerir" "$@" ;;
    esac ;;
  escada)
    case "${1:-}" in
      --todas) shift ;;
      obra|casa|registro) ;;
      *) avisa "acervo escada" "acervo escada --todas" ;;
    esac
    exec "$ATOS/escada" "$@" ;;
  baixar)          avisa "acervo baixar \"<titulo>\"" "acervo ler obra objeto \"<titulo>\""
                   exec "$ATOS/baixar"  "$@" ;;
  bancada)
    case "${1:-}" in
      obra) conforme bancada "$@" ;;
      *) avisa "acervo bancada" "acervo bancada obra lote"
         exec "$ATOS/bancada" "$@" ;;
    esac ;;
  extrato)
    case "${1:-}" in
      --todas) shift ;;
      obra|casa|registro) ;;
      *) avisa "acervo extrato" "acervo extrato --todas" ;;
    esac
    exec "$ATOS/extrato" "$@" ;;
  psql)
    case "${1:-}" in
      --banco) ;;
      "") ;;
      -h|--help|ajuda) ;;
      *) avisa "acervo psql <banco>" "acervo psql --banco <banco>" ;;
    esac
    exec bash "$ATOS/psql" "$@" ;;

  # formas VIGENTES: respondem, mas avisam a forma conforme (spec_acervo §5)
  adr)             # MORTO (arq:0106 §Consequencias: `acervo adr` -> `acervo ler casa adr`).
                   # ADR agora e especie de acervo.casa, ingerida e servida como as demais.
                   echo "acervo adr: verbo morto (arq:0106). ADR agora vive em acervo.casa." >&2
                   echo "  ler uma:   acervo ler casa adr <codigo|path>   (ex: acervo ler casa adr arq:0106)" >&2
                   echo "  listar:    acervo listar casa adr" >&2
                   echo "  buscar:    motor rag buscar casa \"<pergunta>\"" >&2
                   echo "  $SPEC" >&2
                   exit 2 ;;
  listar)          avisa "acervo listar <entidade>" "acervo listar <particao> <entidade>"
                   exec "$ATOS/listar"  "$@" ;;
  registrar)       avisa "acervo registrar <verbo>" "acervo escrever casa ferramental <verbo>"
                   exec "$ATOS/registrar" "$@" ;;
  stack)           avisa "acervo stack <ato>" "acervo ler/escrever casa stack"
                   exec "$ATOS/stack"   "$@" ;;
  ferramenta)      avisa "acervo ferramenta <nome>" "acervo ler casa ferramental <nome>"
                   exec "$ATOS/ferramenta" "$@" ;;
  wiki)            avisa "acervo wiki <ato>" "acervo ler/listar/escrever casa pagina|arquivo|cargo"
                   exec "$ATOS/wiki"    "$@" ;;

  -h|--help|ajuda) uso ;;
  *) echo "acervo: ato desconhecido '$ATO'" >&2; uso ;;
esac
