#!/usr/bin/env bash
# teste — roda a suite de teste do clone local, detectando a stack e o ambiente do repo
# capacidade: qualidade-do-codigo-teste
# dono: claudinho-TI
#
# Por que essa capacidade: o levantamento de conformacao a arq:0110 (12/09/2026,
# levantamento/2026-09-12-conformacao-verbos-arq0110.md) partiu a folha composta
# `construcao/qualidade-do-codigo` (que `lint` e `teste` carregavam junto, DEBITO 1:1
# com arq:0037) em duas folhas L2 proprias no golden record: `qualidade-do-codigo-teste`
# (este verbo) e `qualidade-do-codigo-lint`. O cabecalho ficou parado na folha antiga;
# corrigido aqui (card #3150) para bater com o que o acervo ja resolve. Averbacao formal
# da folha composta segue Aberta no levantamento.
#
# Linha de corte com `conferir`: `conferir` verifica a PLATAFORMA (declarado x servido —
# verbo, superficie, servico). `teste` e `lint` verificam o CODIGO de um repo.
# use para: rodar teste de um repo, suite verde/vermelha, conferir mudanca antes de PR
# atos: rodar, detectar
# forma: predicado
# cauda: sim
#
# Verbo-por-API do braco de teste (card #3004, feature #3003, invariante seg:0014).
# Substitui `run_command "cd ... && pytest"` — a linha livre atravessava a allowlist de
# prefixo por flag (`-p`, `--rootdir`) e o alcance real nao aparecia na decisao. Aqui o
# chamador escolhe o REPO e, no maximo, um alvo DENTRO dele; a linha do runner e montada
# pelo verbo, e nenhuma flag do chamador atravessa.
#
# DETECCAO DO AMBIENTE, e nao so da stack. Medido em 05/09: `uvx pytest` num repo desta
# casa da FALSO VERMELHO — monta ambiente isolado, o projeto perde as proprias
# dependencias e a suite morre no import (`No module named yaml`), nao no teste. Suite
# que nao chegou a rodar nao e suite vermelha. Por isso a escada abaixo procura o
# interpretador do projeto ANTES de cair no isolado, e o ultimo degrau sai avisado.
#
#   python  interpretador, na ordem: PF_TESTE_PYTHON · <repo>/.venv · <bancada>/.venv-<sufixo>
#           · $PLATAFIRMA_RELEASE/venv/<sufixo> (convencao da casa: platafirma-harness -> harness)
#           ->  uv run --python <py> --with pytest pytest     (ve as deps do venv)
#           pyproject.toml sem venv casado  ->  uv run pytest
#           nenhum dos dois              ->  uvx pytest       (ISOLADO — avisa no stderr)
#   node    package.json com scripts.test  ->  npm test
#
# Repo sem stack nenhuma responde INDETERMINAVEL (exit 5), nunca "verde": suite que nao
# existe nao e suite que passou — a mesma regua de fonte inalcancavel dos verbos de
# leitura (arq:0085).
set -uo pipefail

# Raizes da casa (card #3010): a bancada vem de pf_bancada, sem default.
. "$(dirname "$(readlink -f "$0")")/../lib/raizes.sh"
# resolver_uv, resolver_python, construir_venv: o MESMO construtor de release, pela
# mesma chave <nome>-<hash> (card #3150 passo 2-3) — usado por `teste rodar --chave`.
. "$(dirname "$(readlink -f "$0")")/../lib/venv.sh"
PF_VENV_PREFIXO="teste"

BANCADA=""   # preenchida por declara_bancada, depois de validado o ato
VERBO="$(basename "$0")"

# preenchidos por detecta()
STACK=""; LINHA=""; PY=""; ISOLADO=0; RAIZPY=""

# preenchidos por ambiente_da_chave() — caminho --chave (registro/venvs.json)
CHAVE_PY=""; CHAVE_HASH=""; SUBARVORE_CHAVE=""

uso() {
  cat >&2 <<EOF
uso:
  $VERBO rodar <repo> [<alvo>] [--chave <nome>]   roda a suite do clone
  $VERBO detectar <repo> [--chave <nome>]         diz o ambiente e a linha que rodaria

  <alvo> = caminho dentro do repo (sem ele, a suite inteira)
  --chave <nome>: usa o ambiente de registro/venvs.json (a MESMA chave e o mesmo
    construtor de \`release promover\`, card #3150), em vez da escada heuristica
    de interpretador; --chave desconhecida sai 2 com a lista, sem lock declarado
    (ou lock ausente na arvore) sai 5

bancada: PLATAFIRMA_BANCADA, senao $PLATAFIRMA_ARQUIVO_BANCADA (sem default: exit 3)
interpretador: PF_TESTE_PYTHON (ignorado com --chave, que usa o do registro)
exit: 0 suite verde · 1 suite vermelha · 2 uso · 3 falha do runner · 4 alvo fora da raiz
      5 indeterminavel (nenhuma stack de teste detectada, ou --chave sem lock)
EOF
  exit 2
}

morre() { printf '%s: %s\n' "$VERBO" "$1" >&2; exit "${2:-3}"; }

# Bancada declarada pela conta (card #3010): PLATAFIRMA_BANCADA, senao a linha de
# ~/.config/platafirma/bancada. Sem declaracao: exit 3. Nunca cria diretorio.
declara_bancada() {
  BANCADA="$(pf_bancada)" || exit 3
  case "$BANCADA" in
    /*) BANCADA="${BANCADA%/}" ;;
    *) morre "bancada declarada nao e caminho absoluto: $BANCADA" 3 ;;
  esac
}

bancada_de() {
  local nome="$1" chave="${2:-}"
  local cadeira="${PF_CADEIRA:-}"
  cadeira="${cadeira#claudinho-}"
  cadeira="${cadeira#claudinha-}"
  # card:3149: a bancada e wt/<repo>/<cadeira>/<card-ou-slug>, a mesma regra do `repo`.
  # Com chave (<repo>@<chave>): so ela. Sem chave: a unica aninhada da cadeira; mais de
  # uma e ambiguo (exit 2 com a lista), nunca escolha por heuristica.
  if [ -n "$chave" ]; then
    [ -n "$cadeira" ] && [ -e "$BANCADA/wt/$nome/$cadeira/$chave/.git" ] \
      || morre "sem bancada '$nome@$chave' nesta cadeira — vizinho: repo abrir $nome <card> --slug <s>" 1
    printf '%s/wt/%s/%s/%s' "$BANCADA" "$nome" "$cadeira" "$chave"
    return 0
  fi
  if [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira" ] && [ ! -e "$BANCADA/wt/$nome/$cadeira/.git" ]; then
    local cands=() d
    for d in "$BANCADA/wt/$nome/$cadeira"/*/; do [ -e "${d%/}/.git" ] && cands+=("${d%/}"); done
    if [ "${#cands[@]}" -eq 1 ]; then printf '%s' "${cands[0]}"; return 0; fi
    if [ "${#cands[@]}" -gt 1 ]; then
      printf '%s: mais de uma bancada aberta de %s nesta cadeira — nomeie qual:\n' "$VERBO" "$nome" >&2
      for d in "${cands[@]}"; do printf '  %s@%s\n' "$nome" "$(basename "$d")" >&2; done
      exit 2
    fi
  fi
  # legado: a bancada da SESSAO (wt/<repo>/<sessao>) e a plana da cadeira
  local sid="${PF_SESSAO:-}"
  if [ -n "$sid" ] && [ -d "$BANCADA/wt/$nome/$sid" ] && [ -e "$BANCADA/wt/$nome/$sid/.git" ]; then
    printf '%s/wt/%s/%s' "$BANCADA" "$nome" "$sid"
    return 0
  fi
  if [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira" ] && [ -e "$BANCADA/wt/$nome/$cadeira/.git" ]; then
    printf '%s/wt/%s/%s' "$BANCADA" "$nome" "$cadeira"
    return 0
  fi
  if [ -d "$BANCADA/$nome" ]; then
    if [ -n "$cadeira" ]; then
      printf '%s: aviso: worktree wt/%s/%s nao existe — usando fallback %s/%s\n' "$VERBO" "$nome" "$cadeira" "$BANCADA" "$nome" >&2
    else
      printf '%s: aviso: PF_CADEIRA nao definida — usando fallback %s/%s\n' "$VERBO" "$BANCADA" "$nome" >&2
    fi
  fi
  printf '%s/%s' "$BANCADA" "$nome"
}

clone_de() {
  local nome="$1" alvo real raiz_real chave=""
  [ -n "$nome" ] || morre "falta o nome do repo" 2
  case "$nome" in *@*) chave="${nome#*@}"; nome="${nome%%@*}" ;; esac
  case "$nome" in
    */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$nome' — e slug dentro da bancada $BANCADA" 4 ;;
  esac
  case "$chave" in */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "chave de bancada invalida: '$chave'" 2 ;; esac
  alvo="$(bancada_de "$nome" "$chave")" || exit $?
  [ -d "$alvo" ] || morre "nao ha clone '$nome' na bancada $BANCADA — \`repo abrir $nome\` clona" 3
  real="$(realpath "$alvo" 2>/dev/null)" || morre "nao resolvi '$alvo'" 4
  raiz_real="$(realpath "$BANCADA" 2>/dev/null || printf '%s' "$BANCADA")"
  case "$real/" in "$BANCADA"/*|"$raiz_real"/*) : ;; *) morre "'$nome' resolve fora da bancada $BANCADA" 4 ;; esac
  printf '%s' "$real"
}

# Alvo opcional: caminho DENTRO do clone. Nao pode escapar nem virar flag.
alvo_de() {
  local c="$1" a="$2" real
  case "$a" in
    -*) morre "alvo nao pode comecar com '-': '$a'" 2 ;;
    /*|*..*) morre "alvo tem de ser caminho dentro do repo: '$a'" 4 ;;
  esac
  [ -e "$c/$a" ] || morre "alvo '$a' nao existe em $c" 3
  real="$(realpath "$c/$a")" || morre "nao resolvi o alvo" 4
  case "$real/" in "$c"/*) : ;; *) morre "alvo '$a' resolve fora do clone" 4 ;; esac
  printf '%s' "$real"
}

# --chave <nome> (card #3150 passos 2-3): ambiente por registro/venvs.json, pela
# MESMA chave <nome>-sha256(lock+python) que release constroi — nao a escada
# heuristica de detecta(). Leitor unico: bin/_release/registro.py (comentario B1).
# Preenche CHAVE_PY (interpretador do venv) e SUBARVORE_CHAVE (pode ficar vazia).
# Exit: 2 chave desconhecida (lista as conhecidas) · 3 registro ilegivel/falha do
# construtor · 5 chave conhecida sem lock, ou lock ausente na arvore do clone.
ambiente_da_chave() {  # $1=clone $2=chave
  local c="$1" chave="$2" registro out familia lock teste rc=0
  registro="$(dirname "$(readlink -f "$0")")/_release/registro.py"
  out="$(PLATAFIRMA_VENVS="${PLATAFIRMA_VENVS:-$(dirname "$(readlink -f "$0")")/../registro/venvs.json}" \
         python3 "$registro" "$chave")" || return $?
  IFS=$'\t' read -r familia lock teste <<<"$out"
  if [ ! -f "$c/$lock" ]; then
    morre "chave '$chave' declara lock '$lock', ausente em $c — nada a medir" 5
  fi
  local pyid py py_real py_ver hash dest uv t0 t1
  pyid="$(resolver_python)" || exit 3
  IFS=$'\t' read -r py py_real py_ver <<<"$pyid"
  hash="$({ cat "$c/$lock"; printf '\npython=%s %s\n' "$py_real" "$py_ver"; } | sha256sum | cut -c1-12)"
  dest="${PF_RELEASE_RAIZ}/venv/$chave-$hash"
  if [ -f "$dest/.pronto" ]; then
    printf 'ambiente:  %s-%s ja construido (lock e python inalterados) — reaproveitado\n' "$chave" "$hash" >&2
  else
    uv="$(resolver_uv)" || exit 3
    mkdir -p "$(dirname "$dest")"
    t0="$(date +%s 2>/dev/null || echo 0)"
    if ! construir_venv "$c/$lock" "$dest" "$uv" "$py" "$py_ver"; then
      chmod -R u+w "$dest" 2>/dev/null || true; rm -rf "$dest"
      exit 3
    fi
    : > "$dest/.pronto"; chmod -R a-w "$dest"
    t1="$(date +%s 2>/dev/null || echo 0)"
    printf 'ambiente:  %s-%s construido (%s s)\n' "$chave" "$hash" "$((t1 - t0))" >&2
  fi
  CHAVE_PY="$dest/bin/python"; CHAVE_HASH="$hash"; SUBARVORE_CHAVE="$teste"
  return 0
}

# Raiz do projeto Python DENTRO do clone: a pasta que tem o pyproject.toml. Quase sempre
# e o proprio clone; mas ha repo (platafirma-conhecimento) cujo pacote mora num subdir
# (rag/), e ai `uvx pytest` da raiz cai em ambiente isolado e a suite morre no import
# (card #3074). Procura o pyproject na raiz e, senao, um nivel abaixo — sem descer a
# arvore inteira, que acharia pyproject de fixture ou de vendored dep. Ecoa o subdir
# achado (vazio = raiz), para o `cd` do runner e para o venv casarem no mesmo lugar.
raiz_projeto_py() {
  local c="$1"
  [ -f "$c/pyproject.toml" ] && { printf '%s' "$c"; return 0; }
  local p
  for p in "$c"/*/pyproject.toml; do
    [ -f "$p" ] && { printf '%s' "$(dirname "$p")"; return 0; }
  done
  printf '%s' "$c"
}

# Interpretador do projeto, ou vazio. Convencao da casa: venv fora do repo, em
# <bancada>/.venv-<sufixo>, senao o venv da release ($PLATAFIRMA_RELEASE/venv/<sufixo>, o mesmo
# do shebang dos verbos), com o sufixo = nome do repo sem o prefixo `platafirma-`.
# `raiz` = a pasta do pyproject (pode ser um subdir do clone); o venv do projeto mora la.
python_do_projeto() {
  local c="$1" nome="${2:-}" raiz="${3:-$1}" sufixo
  if [ -n "${PF_TESTE_PYTHON:-}" ]; then
    [ -x "$PF_TESTE_PYTHON" ] || morre "PF_TESTE_PYTHON='$PF_TESTE_PYTHON' nao e executavel" 3
    printf '%s' "$PF_TESTE_PYTHON"; return 0
  fi
  [ -x "$raiz/.venv/bin/python" ] && { printf '%s' "$raiz/.venv/bin/python"; return 0; }
  [ -x "$c/.venv/bin/python" ] && { printf '%s' "$c/.venv/bin/python"; return 0; }
  # sufixo pelo NOME do repo: no worktree wt/<repo>/<cadeira> o basename e a cadeira
  sufixo="${nome:-$(basename "$c")}"; sufixo="${sufixo#platafirma-}"
  [ -x "$BANCADA/.venv-$sufixo/bin/python" ] && { printf '%s' "$BANCADA/.venv-$sufixo/bin/python"; return 0; }
  [ -x "$PLATAFIRMA_RELEASE/venv/$sufixo/bin/python" ] && { printf '%s' "$PLATAFIRMA_RELEASE/venv/$sufixo/bin/python"; return 0; }
  return 1
}

detecta() {
  local c="$1" nome="${2:-}"
  STACK=""; LINHA=""; PY=""; ISOLADO=0; RAIZPY="$c"
  if [ -f "$c/package.json" ] && grep -q '"test"[[:space:]]*:' "$c/package.json" 2>/dev/null \
     && [ ! -f "$c/pyproject.toml" ]; then
    STACK="node"; LINHA="npm test"; return 0
  fi
  RAIZPY="$(raiz_projeto_py "$c")"
  if [ -f "$RAIZPY/pyproject.toml" ] || [ -d "$c/testes" ] \
     || compgen -G "$c/test_*.py" >/dev/null 2>&1 || compgen -G "$c/*/test_*.py" >/dev/null 2>&1; then
    STACK="python"
    if PY="$(python_do_projeto "$c" "$nome" "$RAIZPY")"; then
      LINHA="uv run --python $PY --with pytest pytest"
    elif [ -f "$RAIZPY/pyproject.toml" ]; then
      LINHA="uv run pytest"
    else
      LINHA="uvx pytest"; ISOLADO=1
    fi
    return 0
  fi
  if [ -f "$c/package.json" ] && grep -q '"test"[[:space:]]*:' "$c/package.json" 2>/dev/null; then
    STACK="node"; LINHA="npm test"; return 0
  fi
  return 1
}

ato_detectar() {
  local nome="" chave="" c
  while [ $# -gt 0 ]; do
    case "$1" in
      --chave) shift; [ $# -gt 0 ] || morre "--chave exige um valor" 2; chave="$1"; shift ;;
      *) [ -z "$nome" ] && nome="$1" || morre "argumento extra: $1" 2; shift ;;
    esac
  done
  c="$(clone_de "$nome")" || exit $?
  nome="${nome%%@*}"
  if [ -n "$chave" ]; then
    ambiente_da_chave "$c" "$chave" || exit $?
    printf '%s  ·  chave %s-%s  ·  interpretador: %s\n' "$nome" "$chave" "$CHAVE_HASH" "$CHAVE_PY"
    [ -n "$SUBARVORE_CHAVE" ] && printf '  subarvore de teste: %s\n' "$SUBARVORE_CHAVE"
    return 0
  fi
  detecta "$c" "$nome" || { printf '%s: indeterminavel — nenhuma stack de teste detectada em %s\n' \
                      "$VERBO" "$c" >&2; exit 5; }
  printf '%s  ·  stack %s  ·  rodaria: %s\n' "$nome" "$STACK" "$LINHA"
  [ -n "$PY" ] && printf '  interpretador do projeto: %s\n' "$PY"
  [ "$ISOLADO" -eq 1 ] && printf '  AVISO: ambiente isolado — dependencia do projeto pode faltar e a suite morrer no import\n'
  return 0
}

ato_rodar() {
  local nome="" alvo="" chave="" c rc
  while [ $# -gt 0 ]; do
    case "$1" in
      --chave) shift; [ $# -gt 0 ] || morre "--chave exige um valor" 2; chave="$1"; shift ;;
      *)
        if [ -z "$nome" ]; then nome="$1"
        elif [ -z "$alvo" ]; then alvo="$1"
        else morre "argumento extra: $1" 2
        fi
        shift ;;
    esac
  done
  c="$(clone_de "$nome")" || exit $?
  nome="${nome%%@*}"
  # `if`, e com `|| exit`: `alvo_de` recusa por `exit` DENTRO da substituicao de comando,
  # que mata so o subshell. Sem propagar o codigo aqui, a recusa virava alvo vazio e o
  # runner rodava o repo INTEIRO — contencao que avisa e deixa passar nao e contencao.
  if [ -n "$alvo" ]; then alvo="$(alvo_de "$c" "$alvo")" || exit $?; fi
  if [ -n "$chave" ]; then
    ambiente_da_chave "$c" "$chave" || exit $?
    local raiz_chave="$c"
    [ -n "$SUBARVORE_CHAVE" ] && raiz_chave="$c/$SUBARVORE_CHAVE"
    printf '# %s · chave %s-%s · uv run --python %s --with pytest pytest (raiz %s)\n' \
      "$nome" "$chave" "$CHAVE_HASH" "$CHAVE_PY" "$raiz_chave" >&2
    ( cd "$raiz_chave" && uv run --python "$CHAVE_PY" --with pytest pytest ${alvo:+"$alvo"} )
    rc=$?
    if [ "$rc" -eq 0 ]; then printf 'suite VERDE: %s (chave %s)\n' "$nome" "$chave"
    else printf 'suite VERMELHA: %s (chave %s) — exit %s\n' "$nome" "$chave" "$rc"; fi
    return "$rc"
  fi
  detecta "$c" "$nome" || { printf '%s: indeterminavel — nenhuma stack de teste detectada em %s\n' \
                      "$VERBO" "$c" >&2; exit 5; }
  printf '# %s · stack %s · %s\n' "$nome" "$STACK" "$LINHA" >&2
  [ "$ISOLADO" -eq 1 ] && printf '# AVISO: ambiente isolado — falha de import aqui e do ambiente, nao do codigo\n' >&2
  case "$STACK" in
    python)
      # roda da RAIZ do projeto (a pasta do pyproject), que pode ser um subdir do clone.
      # o alvo ja e caminho absoluto (alvo_de -> realpath), entao vale de qualquer cwd.
      if [ -n "$PY" ]; then
        (cd "$RAIZPY" && uv run --python "$PY" --with pytest pytest ${alvo:+"$alvo"})
      elif [ "$ISOLADO" -eq 1 ]; then
        (cd "$RAIZPY" && uvx pytest ${alvo:+"$alvo"})
      else
        (cd "$RAIZPY" && uv run pytest ${alvo:+"$alvo"})
      fi ;;
    node)
      if [ -n "$alvo" ]; then (cd "$c" && npm test -- "$alvo"); else (cd "$c" && npm test); fi ;;
  esac
  rc=$?
  if [ "$rc" -eq 0 ]; then printf 'suite VERDE: %s (%s)\n' "$nome" "$STACK"
  else printf 'suite VERMELHA: %s (%s) — exit %s\n' "$nome" "$STACK" "$rc"; fi
  return "$rc"
}

ato="${1:-}"; [ -n "$ato" ] && shift
case "$ato" in
  ""|-h|--help|ajuda) uso ;;
esac
declara_bancada
case "$ato" in
  rodar)    ato_rodar "$@" ;;
  detectar) ato_detectar "$@" ;;
  ""|-h|--help|ajuda) uso ;;
  *)
    # arq:0110 §3 Q9: teste <verbo>
    c="$(clone_de "platafirma-harness")" || exit $?
    if [ -f "$c/controle/tests/test_contrato_$ato.py" ]; then
      ato_rodar "platafirma-harness" "controle/tests/test_contrato_$ato.py"
    elif [ -f "$c/testes/test_contrato_$ato.py" ]; then
      ato_rodar "platafirma-harness" "testes/test_contrato_$ato.py"
    elif [ -f "$c/testes/test_$ato.sh" ]; then
      printf '# %s · stack bash · %s\n' "$ato" "bash $c/testes/test_$ato.sh" >&2
      (cd "$c" && bash "testes/test_$ato.sh")
      rc=$?
      if [ "$rc" -eq 0 ]; then printf 'suite VERDE: %s (bash)\n' "$ato"
      else printf 'suite VERMELHA: %s (bash) — exit %s\n' "$ato" "$rc"; fi
      exit "$rc"
    elif [ -f "$c/testes/test_contrato_$ato.sh" ]; then
      printf '# %s · stack bash · %s\n' "$ato" "bash $c/testes/test_contrato_$ato.sh" >&2
      (cd "$c" && bash "testes/test_contrato_$ato.sh")
      rc=$?
      if [ "$rc" -eq 0 ]; then printf 'suite VERDE: %s (bash)\n' "$ato"
      else printf 'suite VERMELHA: %s (bash) — exit %s\n' "$ato" "$rc"; fi
      exit "$rc"
    else
      morre "ato desconhecido: '$ato' — atos: rodar, detectar (ou teste <verbo>)" 2
    fi ;;
esac
