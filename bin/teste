#!/usr/bin/env bash
# teste — roda a suite de teste do clone local, detectando a stack e o ambiente do repo
# capacidade: qualidade-do-codigo-teste
# dono: ti
# classe: C
# atos: rodar (leitura, operacao), detectar (leitura, operacao), inventario (leitura, operacao)
# forma: predicado
# cauda: sim
#
# Verbo conforme a spec_teste (rev 3) e arq:0110.
# A unidade de teste é a stack ou repositório resolvido pelo registro único
# (bin/_release/registro.py, registro/venvs.json). Substitui a escada heurística
# de interpretador pela resolução canônica.
#
# Linha de corte com `conferir`: `conferir` verifica a PLATAFORMA (declarado x servido).
# `teste` e `lint` verificam o CÓDIGO de um repositório ou stack.
#
# Atos:
#   rodar       roda a suite de teste (verde/vermelha, bloco fixo, veredito memoizado)
#   detectar    mostra stack, runner, chave, caminho e a linha que rodaria
#   inventario  lista arquivos de teste (em portão ou fora, fóssil: não medido)
set -uo pipefail

. "$(dirname "$(readlink -f "$0")")/../lib/raizes.sh"
. "$(dirname "$(readlink -f "$0")")/../lib/venv.sh"
. "$(dirname "$(readlink -f "$0")")/../lib/terceiros.sh"
PF_VENV_PREFIXO="teste"

BANCADA=""
VERBO="$(basename "$0")"
REGISTRO="$(dirname "$(readlink -f "$0")")/_release/registro.py"

# Preenchidos pela resolução no registro
REG_FAMILIA=""; REG_LOCK=""; REG_SUBARVORE=""; REG_ESTEIRA=""; REG_STACK=""
CHAVE_PY=""; CHAVE_HASH=""

uso() {
  cat >&2 <<EOF
uso:
  $VERBO rodar <nome> [<alvo>...] [--portao] [--arvore <caminho>] [--chave <nome>]
  $VERBO detectar <nome> [--chave <nome>]
  $VERBO inventario [<nome>|--all] [--json]

  <nome> = nome de repositório ou stack registrado em registro/venvs.json
  <alvo> = caminho dentro da subárvore de teste, um ou mais (sem ele, a suíte inteira)
  --portao: roda só a lista do portão da subárvore (<sub>/tests/VERDES ou <sub>/VERDES);
            com <nome> = repositório e sem <alvo>, toda chave dele que declara
            subárvore de teste, e passa quando todas passam (arq:0116 §6)
  --arvore <caminho>: roda a árvore materializada (exigida sob a raiz de release)
  --chave <nome>: (deprecado) usa o ambiente de registro/venvs.json (arq:0110 §11)

bancada: PLATAFIRMA_BANCADA, senão \$PLATAFIRMA_ARQUIVO_BANCADA (sem declaração: exit 3)
interpretador: venv construído pelo registro
exit: 0 suíte verde / inventário lido · 1 suíte vermelha / sem bancada
      2 uso / nome desconhecido / nome duplicado / --ajuda · 3 dependência ausente
      4 alvo fora da subárvore ou --arvore fora da raiz
      5 indeterminável (nenhuma stack detectada, stack sem lock, lista de portão ausente)
      6 só com PF_TESTE_SO_MEMO=1: árvore ainda sem veredito gravado (nada rodou)
EOF
  exit 2
}

morre() { printf '%s: %s\n' "$VERBO" "$1" >&2; exit "${2:-3}"; }

avisa_deprecado() {  # uma vez por sessão (arq:0110 §11)
  local aviso="$1" chave="$2"
  local sess_dir="/tmp/platafirma-avisos-${PF_SESSAO:-${USER:-default}}"
  mkdir -p "$sess_dir" 2>/dev/null || true
  local trava="$sess_dir/teste_$chave"
  if [ ! -f "$trava" ]; then
    touch "$trava" 2>/dev/null || true
    printf '%s: aviso: %s\n' "$VERBO" "$aviso" >&2
  fi
}

declara_bancada() {
  BANCADA="$(pf_bancada)" || exit 3
  case "$BANCADA" in
    /*) BANCADA="${BANCADA%/}" ;;
    *) morre "bancada declarada nao e caminho absoluto: $BANCADA" 3 ;;
  esac
}

bancada_de() {
  local nome="$1" chave="${2:-}"
  local cadeira="${PF_CADEIRA:-}"
  cadeira="${cadeira#claudinho-}"
  cadeira="${cadeira#claudinha-}"

  if [ -n "$chave" ]; then
    [ -n "$cadeira" ] && [ -e "$BANCADA/wt/$nome/$cadeira/$chave/.git" ] \
      || morre "sem bancada '$nome@$chave' nesta cadeira — vizinho: repo abrir $nome <card> --slug <s>" 1
    printf '%s/wt/%s/%s/%s' "$BANCADA" "$nome" "$cadeira" "$chave"
    return 0
  fi
  if [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira" ] && [ ! -e "$BANCADA/wt/$nome/$cadeira/.git" ]; then
    local cands=() d
    for d in "$BANCADA/wt/$nome/$cadeira"/*/; do [ -e "${d%/}/.git" ] && cands+=("${d%/}"); done
    if [ "${#cands[@]}" -eq 1 ]; then printf '%s' "${cands[0]}"; return 0; fi
    if [ "${#cands[@]}" -gt 1 ]; then
      printf '%s: mais de uma bancada aberta de %s nesta cadeira — nomeie qual:\n' "$VERBO" "$nome" >&2
      for d in "${cands[@]}"; do printf '  %s@%s\n' "$nome" "$(basename "$d")" >&2; done
      exit 2
    fi
  fi
  local sid="${PF_SESSAO:-}"
  if [ -n "$sid" ] && [ -d "$BANCADA/wt/$nome/$sid" ] && [ -e "$BANCADA/wt/$nome/$sid/.git" ]; then
    printf '%s/wt/%s/%s' "$BANCADA" "$nome" "$sid"
    return 0
  fi
  if [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira" ] && [ -e "$BANCADA/wt/$nome/$cadeira/.git" ]; then
    printf '%s/wt/%s/%s' "$BANCADA" "$nome" "$cadeira"
    return 0
  fi

  # Sem bancada da cadeira para o repositório: exit 1 com varrido: e vizinho: repo abrir <repo>;
  # o fallback para o clone base sai (Passo 4 do card #3152).
  local varrido="$BANCADA/wt/$nome${cadeira:+/$cadeira}"
  printf '%s: sem bancada da cadeira para o repositório '\''%s'\''\n' "$VERBO" "$nome" >&2
  printf '  varrido: %s\n' "$varrido" >&2
  printf '  vizinho: repo abrir %s\n' "$nome" >&2
  exit 1
}

clone_de() {
  local nome="$1" alvo real raiz_real chave=""
  [ -n "$nome" ] || morre "falta o nome do repo" 2
  case "$nome" in *@*) chave="${nome#*@}"; nome="${nome%%@*}" ;; esac
  case "$nome" in
    */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$nome' — e slug dentro da bancada $BANCADA" 4 ;;
  esac
  case "$chave" in */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "chave de bancada invalida: '$chave'" 2 ;; esac
  alvo="$(bancada_de "$nome" "$chave")" || exit $?
  [ -d "$alvo" ] || morre "nao ha clone '$nome' na bancada $BANCADA — \`repo abrir $nome\` clona" 1
  real="$(realpath "$alvo" 2>/dev/null)" || morre "nao resolvi '$alvo'" 4
  raiz_real="$(realpath "$BANCADA" 2>/dev/null || printf '%s' "$BANCADA")"
  case "$real/" in "$BANCADA"/*|"$raiz_real"/*) : ;; *) morre "'$nome' resolve fora da bancada $BANCADA" 4 ;; esac
  printf '%s' "$real"
}

alvo_de() {
  local c="$1" a="$2" real
  case "$a" in
    -*) morre "alvo nao pode comecar com '-': '$a'" 2 ;;
    /*|*..*) morre "alvo tem de ser caminho dentro do repo: '$a'" 4 ;;
  esac
  [ -e "$c/$a" ] || morre "alvo '$a' nao existe em $c" 3
  real="$(realpath "$c/$a")" || morre "nao resolvi o alvo" 4
  case "$real/" in "$c"/*) : ;; *) morre "alvo '$a' resolve fora do clone" 4 ;; esac
  printf '%s' "$real"
}

validar_arvore() {
  local arv="$1" real_arv raiz_rel raiz_pre_push
  [ -d "$arv" ] || morre "árvore materializada '$arv' não é diretório" 4
  real_arv="$(realpath "$arv" 2>/dev/null)" || morre "não resolvi '$arv'" 4
  raiz_rel="$(realpath "${PF_RELEASE_RAIZ:-/opt/platafirma}" 2>/dev/null || printf '%s' "${PF_RELEASE_RAIZ:-/opt/platafirma}")"
  raiz_pre_push="$(realpath "${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/pre-push" 2>/dev/null || printf '%s' "${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}/var/pre-push")"

  case "$real_arv/" in
    "$raiz_rel"/*|"$raiz_pre_push"/*) : ;;
    *) morre "o caminho de --arvore só é aceito sob a raiz de árvores materializadas: '$arv'" 4 ;;
  esac
  printf '%s' "$real_arv"
}

resolver_registro() {  # $1=nome[@<chave da bancada>]
  # <repo>@<chave> escolhe a bancada (card:3149); o registro so conhece o nome. A chave
  # volta em REG_BANCADA para o clone_de, nunca ao registro.
  local nome="${1%%@*}" out rc=0
  REG_BANCADA=""
  case "$1" in *@*) REG_BANCADA="${1#*@}" ;; esac
  local venvs="${PLATAFIRMA_VENVS:-$(dirname "$(readlink -f "$0")")/../registro/venvs.json}"
  out="$(PLATAFIRMA_VENVS="$venvs" python3 "$REGISTRO" "$nome")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    [ -n "$out" ] && printf '%s\n' "$out" >&2
    exit "$rc"
  fi
  REG_FAMILIA=""; REG_LOCK=""; REG_SUBARVORE=""; REG_ESTEIRA=""; REG_STACK=""
  IFS=$'\t' read -r REG_FAMILIA REG_LOCK REG_SUBARVORE REG_ESTEIRA REG_STACK <<<"$out"
  [ "$REG_SUBARVORE" = "-" ] && REG_SUBARVORE=""
  [ "$REG_LOCK" = "-" ] && REG_LOCK=""
  return 0
}

# Esteira documento (spec_teste §1 e §4, card #3152 passo 6): o que a esteira aplica e
# a admissao da ingestao, e quem a roda e o proprio detector dela, pelo verbo de dados
# (`acervo ingerir casa <repo> --arvore <dir>`, so dry-run). Nenhuma regra copiada aqui.
# A admissao so aceita arvore sob a raiz materializada; a bancada, como esta (sujeira
# inclusa, ignorado fora), e copiada para la e apagada depois.
rodar_documento() {  # $1=bancada ou arvore $2=repo $3=em_arvore(0|1)
  local c="$1" repo="$2" em="$3" dir="" rc=0 saida f
  local inst="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}"
  local acervo_bin="${PF_ACERVO_BIN:-$(dirname "$(readlink -f "$0")")/acervo}"
  [ -x "$acervo_bin" ] || morre "dependência ausente: $acervo_bin (acervo ingerir casa --arvore)" 3
  if [ "$em" -eq 1 ]; then
    dir="$c"
  else
    mkdir -p "$inst/var/pre-push/arvores" 2>/dev/null || true
    dir="$(mktemp -d "$inst/var/pre-push/arvores/teste-doc.XXXXXX")" \
      || morre "não criei a árvore de admissão sob $inst/var/pre-push/arvores" 3
    while IFS= read -r -d '' f; do
      [ -f "$c/$f" ] || continue
      mkdir -p "$dir/$(dirname "$f")" && cp "$c/$f" "$dir/$f" \
        || { rm -rf "$dir"; morre "não copiei a bancada para $dir" 3; }
    done < <(git -C "$c" ls-files -co --exclude-standard -z)
  fi
  printf '# %s · esteira documento · acervo ingerir casa %s --arvore %s\n' "$repo" "$repo" "$dir" >&2
  saida="$("$acervo_bin" ingerir casa "$repo" --arvore "$dir" 2>&1)" || rc=$?
  [ "$em" -eq 1 ] || rm -rf "$dir"
  case "$rc" in
    0) printf 'suite VERDE: %s (admissão da ingestão)\n' "$repo"; return 0 ;;
    3) printf 'suite VERMELHA: %s — a admissão da ingestão recusaria\n' "$repo"
       printf '%s\n' "$saida" | tail -n 5 | sed 's/^/  reprovado: /'
       return 1 ;;
    4) printf '%s\n' "$saida" >&2; exit 4 ;;
    *) printf 'suite INDISPONIVEL: %s — acervo ingerir saiu %s (não medido)\n' "$repo" "$rc"
       printf '%s\n' "$saida" | tail -n 5 | sed 's/^/  /' >&2
       return 5 ;;
  esac
}

ambiente_do_registro() {  # $1=clone
  local c="$1"
  if [ -z "$REG_LOCK" ]; then
    morre "stack '$REG_STACK' sem lock declarado em registro/venvs.json" 5
  fi
  if [ ! -f "$c/$REG_LOCK" ]; then
    morre "lock '$REG_LOCK' ausente em $c — nada a medir" 5
  fi
  local pyid py py_real py_ver hash dest uv t0 t1
  pyid="$(resolver_python)" || exit 3
  IFS=$'\t' read -r py py_real py_ver <<<"$pyid"
  hash="$({ cat "$c/$REG_LOCK"; printf '\npython=%s %s\n' "$py_real" "$py_ver"; } | sha256sum | cut -c1-12)"
  dest="${PF_RELEASE_RAIZ}/venv/$REG_STACK-$hash"
  if [ -f "$dest/.pronto" ]; then
    printf 'ambiente:  %s-%s ja construido (lock e python inalterados) — reaproveitado\n' "$REG_STACK" "$hash" >&2
  else
    uv="$(resolver_uv)" || exit 3
    mkdir -p "$(dirname "$dest")"
    t0="$(date +%s 2>/dev/null || echo 0)"
    if ! construir_venv "$c/$REG_LOCK" "$dest" "$uv" "$py" "$py_ver"; then
      chmod -R u+w "$dest" 2>/dev/null || true; rm -rf "$dest"
      exit 3
    fi
    : > "$dest/.pronto"; chmod -R a-w "$dest"
    t1="$(date +%s 2>/dev/null || echo 0)"
    printf 'ambiente:  %s-%s construido (%s s)\n' "$REG_STACK" "$hash" "$((t1 - t0))" >&2
  fi
  CHAVE_PY="$dest/bin/python"; CHAVE_HASH="$hash"
  return 0
}

arvore_da_bancada() {  # $1=clone
  local c="$1" idx h
  idx="$(mktemp "${TMPDIR:-/tmp}/teste-idx.XXXXXX")" || return 1
  rm -f "$idx"
  h="$(GIT_INDEX_FILE="$idx" git -C "$c" add -A . >/dev/null 2>&1 && GIT_INDEX_FILE="$idx" git -C "$c" write-tree 2>/dev/null)"
  rm -f "$idx"
  [ -n "$h" ] || return 1
  printf '%s' "$h"
  return 0
}

pytest_em_bloco() {  # $1=clone $2=raiz(cwd) $3=rotulo $4=modo(py:<python>|isolado|projeto) [$5=alvo...]
  local c="$1" raiz="$2" rotulo="$3" modo="$4"; shift 4
  local alvos=("$@") rc=0
  local runner=()
  case "$modo" in
    py:*)
      if [ -f "$raiz/uv.lock" ]; then
        runner=(uv run --frozen --python "${modo#py:}" --with pytest pytest)
      else
        runner=(uv run --python "${modo#py:}" --with pytest pytest)
      fi
      ;;
    isolado) runner=(uvx pytest) ;;
    *)       runner=(uv run pytest) ;;
  esac
  if [ "${PF_TESTE_VERBOSO:-0}" = 1 ]; then
    (cd "$raiz" && "${runner[@]}" ${alvos:+"${alvos[@]}"}) || rc=$?
    if [ "$rc" -eq 0 ]; then printf 'suite VERDE: %s\n' "$rotulo"; else printf 'suite VERMELHA: %s — exit %s\n' "$rotulo" "$rc"; fi
    return "$rc"
  fi

  local inst="${PLATAFIRMA_INSTANCIA:-/srv/platafirma/casa}" arvore chave="" memo=""
  if [ "${EM_ARVORE:-0}" -eq 1 ]; then
    arvore="$(git -C "$c" rev-parse 'HEAD^{tree}' 2>/dev/null || echo '')"
  else
    arvore="$(arvore_da_bancada "$c")" || arvore=""
    if [ -z "$arvore" ]; then
      arvore="$(git -C "$c" rev-parse 'HEAD^{tree}' 2>/dev/null || echo '')"
    fi
  fi
  local vereditos_dir="$inst/var/pre-push/vereditos"
  # O memo do portão (o mesmo que pre-push e gate leem) só recebe a rodada do portão
  # inteiro: um arquivo só verde não é a árvore verde, e gravar ali abria o gate para
  # quem rodasse um teste isolado antes do push. Rodada parcial vai ao memo próprio,
  # com o alvo na chave.
  if [ -n "$arvore" ] && [ -n "${CHAVE_HASH:-}" ] && [ "${portao:-0}" -eq 1 ]; then
    memo="$(caminho_veredito "$vereditos_dir" "$arvore" "$REG_STACK" "$CHAVE_HASH")"
    mkdir -p "$(dirname "$memo")" 2>/dev/null || memo=""
  elif [ -n "$arvore" ]; then
    chave="$(printf '%s|%s|%s' "$arvore" "${alvos[*]}" "$modo" | sha256sum | cut -c1-16)"
    memo="$inst/var/teste/vereditos/$chave.txt"
    mkdir -p "$(dirname "$memo")" 2>/dev/null || memo=""
  fi

  if [ -n "$memo" ] && [ -f "$memo" ] && [ "${PF_TESTE_SEM_MEMO:-0}" != 1 ]; then
    local v; v="$(ler_veredito "$memo")"
    if [ -n "$v" ]; then
      case "$v" in
        verde)
          printf 'suite VERDE: %s — veredito reaproveitado (mesma arvore %s, chave %s-%s)\n' \
            "$rotulo" "${arvore:0:12}" "$REG_STACK" "$CHAVE_HASH"
          return 0 ;;
        vermelho)
          printf 'suite VERMELHA: %s — veredito reaproveitado (mesma arvore %s, chave %s-%s)\n' \
            "$rotulo" "${arvore:0:12}" "$REG_STACK" "$CHAVE_HASH" >&2
          return 1 ;;
      esac
    else
      local v_antigo; v_antigo="$(head -n 1 "$memo")"
      printf '%s — veredito reaproveitado (mesma arvore %s, medido %s)\n' \
        "${v_antigo%%|*}" "${arvore:0:12}" "$(sed -n 2p "$memo")"
      sed -n '3,$p' "$memo"
      case "$v_antigo" in 'suite VERDE'*) return 0 ;; *) return 1 ;; esac
    fi
  fi

  # PF_TESTE_SO_MEMO=1: só o veredito gravado, nunca roda (o gate lê assim o repositório
  # inteiro antes de medir, e enquanto o job mede). Sem veredito: 6.
  if [ "${PF_TESTE_SO_MEMO:-0}" = 1 ]; then
    printf 'suite AINDA NAO MEDIDA: %s — sem veredito gravado para a arvore %s\n' "$rotulo" "${arvore:0:12}"
    return 6
  fi

  local logd="$inst/var/log/teste" log xml
  mkdir -p "$logd" 2>/dev/null || logd="${TMPDIR:-/tmp}"
  log="$logd/$(date -u +%Y%m%dT%H%M%SZ)-${rotulo%% *}-$$.txt"
  xml="$(mktemp "${TMPDIR:-/tmp}/teste-junit.XXXXXX.xml")"

  # Suporte a árvore materializada (read-only): desliga cacheprovider do pytest
  local pytest_flags=(-q --junitxml="$xml")
  if [ "${EM_ARVORE:-0}" -eq 1 ]; then
    pytest_flags+=(-p no:cacheprovider)
  fi

  local env_opts=()
  if [ "${EM_ARVORE:-0}" -eq 1 ]; then
    local envtmp; envtmp="$(mktemp -d "${TMPDIR:-/tmp}/teste-env.XXXXXX")"
    env_opts=(UV_PROJECT_ENVIRONMENT="$envtmp/venv")
  fi

  (cd "$raiz" && env ${env_opts:+"${env_opts[@]}"} timeout 300 "${runner[@]}" ${alvos:+"${alvos[@]}"} "${pytest_flags[@]}") >"$log" 2>&1 || rc=$?
  [ -n "${envtmp:-}" ] && rm -rf "$envtmp"

  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    rc=5
    linha="suite INDISPONIVEL: $rotulo — timeout (300s excedidos)"
    rm -f "$xml"
    printf '%s\n' "$linha"
    printf 'saida inteira: %s\n' "$log"
    return 5
  fi

  local resumo; resumo="$(grep -E '(passed|failed|error|no tests ran)' "$log" | tail -n 1 | sed 's/^=* *//; s/ *=*$//')"
  local linha extra=""
  if [ "$rc" -eq 0 ]; then
    linha="suite VERDE: $rotulo — ${resumo:-sem contagem}"
  else
    linha="suite VERMELHA: $rotulo — exit $rc${resumo:+, $resumo}"
    [ "$rc" -eq 1 ] && extra="$(nomear_reprovados "$xml" | sed 's/^/  reprovado: /')"
    [ "$rc" -eq 1 ] || extra="$(tail -n 5 "$log" | sed 's/^/  | /')"
  fi
  rm -f "$xml"
  printf '%s\n' "$linha"
  [ -z "$extra" ] || printf '%s\n' "$extra"
  printf 'saida inteira: %s\n' "$log"

  if [ -n "$memo" ] && { [ "$rc" -eq 0 ] || [ "$rc" -eq 1 ]; }; then
    local v_str="verde"
    [ "$rc" -eq 1 ] && v_str="vermelho"
    gravar_veredito "$memo" "$v_str" "${arvore:0:12}"
    # Grava também formato legado de texto caso leitor simples consulte
    local depois
    depois="$(arvore_da_bancada "$c" 2>/dev/null || echo '')"
    # o runner pode deixar arquivo novo na bancada (uv.lock, por exemplo): grava tambem
    # sob a arvore de depois, no MESMO memo em que a rodada caiu (portao ou parcial)
    if [ -n "$depois" ] && [ "$depois" != "$arvore" ]; then
      local memo_depois
      if [ "${portao:-0}" -eq 1 ] && [ -n "${CHAVE_HASH:-}" ]; then
        memo_depois="$(caminho_veredito "$vereditos_dir" "$depois" "$REG_STACK" "$CHAVE_HASH")"
      else
        memo_depois="$(dirname "$memo")/$(printf '%s|%s|%s' "$depois" "${alvos[*]}" "$modo" | sha256sum | cut -c1-16).txt"
      fi
      gravar_veredito "$memo_depois" "$v_str" "${depois:0:12}"
    fi
  fi
  return "$rc"
}

# arq:0116 §7: artefato de terceiro pinado da família entra na árvore medida pelo mesmo
# construtor da release (lib/terceiros.sh), do cache por sha256. O registro vem da própria
# árvore quando ela o tem (bancada ou árvore materializada), senão o do verbo.
terceiros_na_arvore() {  # $1=arvore
  local c="$1" reg rc=0
  reg="${PLATAFIRMA_TERCEIROS:-$c/registro/terceiros.json}"
  [ -r "$reg" ] || reg="$(dirname "$(readlink -f "$0")")/../registro/terceiros.json"
  materializar_terceiros_em "$REG_FAMILIA" "$c" "$reg" "$PF_RELEASE_RAIZ/terceiros/sha256" >&2 || rc=$?
  case "$rc" in
    0) return 0 ;;
    5) exit 5 ;;
    *) exit 3 ;;
  esac
}

# arq:0116 §5: a lista de portão mora na própria subárvore de teste da chave, com os
# caminhos relativos a ela: <sub>/tests/VERDES, senão <sub>/VERDES. Imprime o caminho;
# vazio = lista ausente.
lista_portao_de() {  # $1=clone $2=subarvore
  local base="$1${2:+/$2}" cand
  for cand in "$base/tests/VERDES" "$base/VERDES"; do
    if [ -r "$cand" ]; then printf '%s' "$cand"; return 0; fi
  done
  return 0
}

# arq:0116 §6: `teste rodar <repositório> --portao` roda a lista de portão de toda chave do
# repositório que declara subárvore de teste, cada uma no seu ambiente, e passa quando
# todas passam. O registro das chaves vem da árvore medida (a que o push ou a promoção
# leva), não do verbo no ar. Cada chave é um processo próprio (memo por árvore e chave).
portao_da_familia() {  # $1=clone $2=familia $3=bancada(chave ou vazio) $4=arvore(ou vazio)
  local c="$1" familia="$2" bancada="$3" arv="$4" venvs linhas chave lock sub
  venvs="${PLATAFIRMA_VENVS:-$c/registro/venvs.json}"
  [ -r "$venvs" ] || venvs="$(dirname "$(readlink -f "$0")")/../registro/venvs.json"
  linhas="$(PLATAFIRMA_VENVS="$venvs" python3 "$REGISTRO" --familia "$familia")" || exit $?
  local chaves=() rc rc_fam=0 vermelhas=() nao_medidas=() pendentes=()
  while IFS=$'\t' read -r chave lock sub; do
    [ -n "$chave" ] && [ -n "$sub" ] || continue
    chaves+=("$chave")
  done <<<"$linhas"
  if [ "${#chaves[@]}" -eq 0 ]; then
    printf 'suite VERDE: %s — nenhuma chave com subárvore de teste no registro (nada a medir)\n' "$familia"
    return 0
  fi
  for chave in "${chaves[@]}"; do
    rc=0
    if [ -n "$arv" ]; then
      PLATAFIRMA_VENVS="$venvs" "$0" rodar "$chave" --portao --arvore "$arv" || rc=$?
    else
      PLATAFIRMA_VENVS="$venvs" "$0" rodar "$chave${bancada:+@$bancada}" --portao || rc=$?
    fi
    case "$rc" in
      0) : ;;
      1) vermelhas+=("$chave") ;;
      6) pendentes+=("$chave") ;;
      *) nao_medidas+=("$chave (exit $rc)") ;;
    esac
  done
  if [ "${#vermelhas[@]}" -gt 0 ]; then
    printf 'portao %s: VERMELHO — %s\n' "$familia" "${vermelhas[*]}"
    return 1
  fi
  if [ "${#nao_medidas[@]}" -gt 0 ]; then
    printf 'portao %s: NAO MEDIDO — %s\n' "$familia" "${nao_medidas[*]}"
    return 5
  fi
  if [ "${#pendentes[@]}" -gt 0 ]; then
    printf 'portao %s: AINDA NAO MEDIDO — %s\n' "$familia" "${pendentes[*]}"
    return 6
  fi
  printf 'portao %s: VERDE — %s\n' "$familia" "${chaves[*]}"
  return "$rc_fam"
}

ato_detectar() {
  local nome="" chave="" c
  while [ $# -gt 0 ]; do
    case "$1" in
      --chave) shift; [ $# -gt 0 ] || morre "--chave exige um valor" 2; chave="$1"; shift ;;
      *) [ -z "$nome" ] && nome="$1" || morre "argumento extra: $1" 2; shift ;;
    esac
  done
  [ -n "$nome" ] || [ -n "$chave" ] || uso
  if [ -n "$chave" ]; then
    avisa_deprecado "--chave está deprecado (arq:0110 §11); aponte o nome da stack ou repositório no primeiro argumento" "chave"
  fi

  local alvo_resolver="${chave:-$nome}"
  resolver_registro "$alvo_resolver"
  case "$nome" in *@*) REG_BANCADA="${nome#*@}" ;; esac  # --chave nao apaga a bancada escolhida
  declara_bancada
  c="$(clone_de "$REG_FAMILIA${REG_BANCADA:+@$REG_BANCADA}")" || exit $?
  if [ "$REG_ESTEIRA" = "documento" ]; then
    printf '%s  ·  esteira documento  ·  runner admissão da ingestão  ·  caminho %s  ·  rodaria: acervo ingerir casa %s --arvore <cópia da bancada>\n' \
      "$nome" "$c" "$REG_FAMILIA"
    return 0
  fi
  ambiente_do_registro "$c" || exit $?

  local raiz="$c"
  [ -n "$REG_SUBARVORE" ] && raiz="$c/$REG_SUBARVORE"
  local runner="pytest"
  local linha_cmd="uv run --python $CHAVE_PY --with pytest pytest"
  if [ "$REG_ESTEIRA" = "documento" ]; then
    runner="documento"
  fi

  # Formato conforme: stack, runner, chave, caminho e a linha
  printf '%s  ·  stack %s  ·  runner %s  ·  chave %s-%s  ·  caminho %s  ·  rodaria: %s\n' \
    "$nome" "$REG_STACK" "$runner" "$REG_STACK" "$CHAVE_HASH" "$raiz" "$linha_cmd"
  return 0
}

ato_inventario() {
  local nome="" modo_all=0 json_out=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) modo_all=1; shift ;;
      --json) json_out=1; shift ;;
      *) [ -z "$nome" ] && nome="$1" || morre "argumento extra: $1" 2; shift ;;
    esac
  done

  local venvs="${PLATAFIRMA_VENVS:-$(dirname "$(readlink -f "$0")")/../registro/venvs.json}"

  if [ "$modo_all" -eq 1 ]; then
    local linhas
    linhas="$(PLATAFIRMA_VENVS="$venvs" python3 "$REGISTRO" --all)" || exit $?
    while IFS=$'\t' read -r s_nome s_fam s_lock s_teste s_esteira; do
      [ -n "$s_nome" ] || continue
      printf '%s (%s): fóssil: não medido\n' "$s_nome" "$s_fam"
    done <<<"$linhas"
    return 0
  fi

  [ -n "$nome" ] || morre "inventario exige <nome> ou --all" 2
  resolver_registro "$nome"
  declara_bancada
  local c; c="$(clone_de "$REG_FAMILIA${REG_BANCADA:+@$REG_BANCADA}")" || exit $?

  local raiz="$c"
  [ -n "$REG_SUBARVORE" ] && raiz="$c/$REG_SUBARVORE"

  printf '# inventário de testes: %s (%s)\n' "$nome" "$REG_FAMILIA"
  local achados=() arq
  while IFS= read -r arq; do
    [ -n "$arq" ] || continue
    achados+=("$arq")
  done < <(find "$raiz" -type f \( -name "test_*.py" -o -name "*_test.py" \) 2>/dev/null | sort)

  if [ "${#achados[@]}" -eq 0 ]; then
    printf 'nenhum arquivo de teste encontrado em %s\n' "$raiz"
    return 0
  fi

  local verdes_lista=() cand
  cand="$(lista_portao_de "$c" "$REG_SUBARVORE")"
  if [ -n "$cand" ]; then
    while IFS= read -r l; do
      case "$l" in ''|'#'*) continue ;; esac
      verdes_lista+=("$l")
    done < "$cand"
  fi

  for arq in "${achados[@]}"; do
    local rel="${arq#"$raiz"/}" rel_c="${arq#"$c"/}"
    local portao="fora"
    for v in "${verdes_lista[@]}"; do
      if [ "$rel" = "$v" ] || [ "$rel_c" = "$v" ] || [ "$rel_c" = "controle/$v" ]; then
        portao="portão"
        break
      fi
    done
    printf '  %-50s  [%s]  fóssil: não medido\n' "$rel" "$portao"
  done
  return 0
}

ato_rodar() {
  local nome="" alvo="" chave="" arvore="" portao=0 EM_ARVORE=0 c rc extras=() extras_resolvidos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --chave) shift; [ $# -gt 0 ] || morre "--chave exige um valor" 2; chave="$1"; shift ;;
      --portao) portao=1; shift ;;
      --arvore) shift; [ $# -gt 0 ] || morre "--arvore exige um caminho" 2; arvore="$1"; shift ;;
      *)
        if [ -z "$nome" ]; then nome="$1"
        elif [ -z "$alvo" ]; then alvo="$1"
        else extras+=("$1")   # mais de um alvo (#2856 linha 11)
        fi
        shift ;;
    esac
  done

  [ -n "$nome" ] || [ -n "$chave" ] || uso
  if [ -n "$chave" ]; then
    avisa_deprecado "--chave está deprecado (arq:0110 §11); aponte o nome da stack ou repositório no primeiro argumento" "chave"
  fi

  local alvo_resolver="${chave:-$nome}"
  resolver_registro "$alvo_resolver"
  case "$nome" in *@*) REG_BANCADA="${nome#*@}" ;; esac  # --chave nao apaga a bancada escolhida

  if [ -n "$arvore" ]; then
    c="$(validar_arvore "$arvore")" || exit $?
    EM_ARVORE=1
  else
    declara_bancada
    c="$(clone_de "$REG_FAMILIA${REG_BANCADA:+@$REG_BANCADA}")" || exit $?
  fi

  local raiz="$c"
  [ -n "$REG_SUBARVORE" ] && raiz="$c/$REG_SUBARVORE"

  if [ "$REG_ESTEIRA" = "documento" ]; then
    [ -z "$alvo" ] || morre "esteira documento mede a árvore inteira: <alvo> não se aplica" 2
    rodar_documento "$c" "$REG_FAMILIA" "$EM_ARVORE"
    return $?
  fi

  # arq:0116 §6: o repositório inteiro no portão — toda chave com subárvore de teste
  if [ "$portao" -eq 1 ] && [ -z "$alvo" ] && [ -z "$chave" ] && [ "${nome%%@*}" = "$REG_FAMILIA" ]; then
    local arv_fam=""
    [ "$EM_ARVORE" -eq 1 ] && arv_fam="$c"
    portao_da_familia "$c" "$REG_FAMILIA" "$REG_BANCADA" "$arv_fam"
    return $?
  fi

  if [ -n "$alvo" ]; then
    alvo="$(alvo_de "$c" "$alvo")" || exit $?
    local resolvido x
    for x in ${extras[@]+"${extras[@]}"}; do
      resolvido="$(alvo_de "$c" "$x")" || exit $?
      extras_resolvidos+=("$resolvido")
    done
  fi

  local alvos=() lista_portao="" ausentes=()
  if [ "$portao" -eq 1 ]; then
    # arq:0116 §5: lista na própria subárvore; ausente é suíte não medida; vazia vale
    lista_portao="$(lista_portao_de "$c" "$REG_SUBARVORE")"
    if [ -z "$lista_portao" ]; then
      printf 'suite INDISPONIVEL: %s — sem lista de portão em %s/ (tests/VERDES ou VERDES; arq:0116 §5: lista ausente é suíte não medida)\n' \
        "$nome" "${REG_SUBARVORE:-.}"
      exit 5
    fi
    while IFS= read -r linha; do
      case "$linha" in ''|'#'*) continue ;; esac
      if [ -f "$raiz/$linha" ]; then
        alvos+=("$linha")
      elif [ -f "$c/$linha" ]; then
        alvos+=("$c/$linha")
      else
        ausentes+=("$linha")
      fi
    done < "$lista_portao"
    if [ "${#ausentes[@]}" -gt 0 ]; then
      printf 'suite INDISPONIVEL: %s — %s lista arquivo que não existe na árvore: %s\n' \
        "$nome" "${lista_portao#"$c"/}" "${ausentes[*]}"
      exit 5
    fi
    if [ "${#alvos[@]}" -eq 0 ]; then
      printf 'suite VERDE: %s — lista de portão vazia, declarada em %s\n' "$nome" "${lista_portao#"$c"/}"
      return 0
    fi
  elif [ -n "$alvo" ]; then
    alvos+=("$alvo" ${extras_resolvidos[@]+"${extras_resolvidos[@]}"})
  fi

  ambiente_do_registro "$c" || exit $?
  terceiros_na_arvore "$c"

  local rotulo="$nome"
  [ -n "$chave" ] && rotulo="$nome (chave $chave)"
  [ -z "$chave" ] && [ "$nome" != "$REG_STACK" ] && rotulo="$nome (chave $REG_STACK)"

  printf '# %s · chave %s-%s · uv run --python %s --with pytest pytest (raiz %s)\n' \
    "$nome" "$REG_STACK" "$CHAVE_HASH" "$CHAVE_PY" "$raiz" >&2

  pytest_em_bloco "$c" "$raiz" "$rotulo" "py:$CHAVE_PY" ${alvos:+"${alvos[@]}"}
  return $?
}

# Despacho de atos
if [ $# -eq 0 ]; then
  uso
fi

for _a in "$@"; do
  case "$_a" in
    --ajuda|-h|--help|ajuda) uso ;;
  esac
done

ato="$1"
shift

case "$ato" in
  rodar)      ato_rodar "$@" ;;
  detectar)   ato_detectar "$@" ;;
  inventario) ato_inventario "$@" ;;
  *)
    # arq:0110 §3 Q9: teste <verbo>
    c="$(declara_bancada 2>/dev/null && clone_de "platafirma-harness" 2>/dev/null || true)"
    if [ -n "$c" ] && [ -f "$c/controle/tests/test_contrato_$ato.py" ]; then
      ato_rodar "platafirma-harness" "controle/tests/test_contrato_$ato.py"
    elif [ -n "$c" ] && [ -f "$c/testes/test_contrato_$ato.py" ]; then
      ato_rodar "platafirma-harness" "testes/test_contrato_$ato.py"
    elif [ -n "$c" ] && [ -f "$c/testes/test_$ato.sh" ]; then
      printf '# %s · stack bash · %s\n' "$ato" "bash $c/testes/test_$ato.sh" >&2
      (cd "$c" && bash "testes/test_$ato.sh")
      rc=$?
      if [ "$rc" -eq 0 ]; then printf 'suite VERDE: %s (bash)\n' "$ato"
      else printf 'suite VERMELHA: %s (bash) — exit %s\n' "$ato" "$rc"; fi
      exit "$rc"
    elif [ -n "$c" ] && [ -f "$c/testes/test_contrato_$ato.sh" ]; then
      printf '# %s · stack bash · %s\n' "$ato" "bash $c/testes/test_contrato_$ato.sh" >&2
      (cd "$c" && bash "testes/test_contrato_$ato.sh")
      rc=$?
      if [ "$rc" -eq 0 ]; then printf 'suite VERDE: %s (bash)\n' "$ato"
      else printf 'suite VERMELHA: %s (bash) — exit %s\n' "$ato" "$rc"; fi
      exit "$rc"
    else
      morre "ato desconhecido: '$ato' — atos: rodar, detectar, inventario" 2
    fi
    ;;
esac
