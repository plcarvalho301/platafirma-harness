#!/usr/bin/env bash
# lint — roda o linter do clone local, detectando a stack do repo
# capacidade: construcao/qualidade-do-codigo
# dono: claudinho-TI
#
# Por que essa capacidade: o mapa (arquitetura-negocio-operacao.md, construcao nivel 2) poe
# `lint` e `teste` na folha `construcao/qualidade-do-codigo` desde 12/09/2026 — a L1
# `verificacao` foi extinta e `conferir` desceu a `infra/promocao-de-mudanca`. DEBITO 1:1: a
# folha carrega DOIS verbos (lint, teste), nao-conformidade com arq:0037 a refatorar em fita
# propria (linter-e-ferramenta vs. segunda folha L2). Linha de corte: `conferir` verifica a
# plataforma; `lint` verifica o codigo.
# use para: lintar um repo, conferir estilo antes de commit/PR, ver o que o linter aponta
# atos: rodar, detectar
# forma: predicado
# cauda: sim
#
# Verbo-por-API do braco de lint (card #3004, feature #3003, invariante seg:0014).
# Mesma regua do verbo `teste`: o chamador escolhe o REPO (e no maximo um alvo dentro
# dele); a linha do linter e montada aqui. Nenhuma flag do chamador atravessa.
#
# Deteccao (nesta ordem; `detectar` mostra sem rodar):
#   python  pyproject.toml | .ruff.toml | .ruff_cache  ->  uvx ruff check
#   node    package.json com scripts.lint              ->  npm run lint
# Repo sem nenhuma das duas responde INDETERMINAVEL (exit 5), nunca "limpo": linter que
# nao existe nao e linter que passou.
set -uo pipefail

# Raizes da casa (card #3010): a bancada vem de pf_bancada, sem default.
. "$(dirname "$(readlink -f "$0")")/../lib/raizes.sh"

BANCADA=""   # preenchida por declara_bancada, depois de validado o ato
VERBO="$(basename "$0")"

uso() {
  cat >&2 <<EOF
uso:
  $VERBO rodar <repo> [<alvo>]   roda o linter do clone; <alvo> = caminho dentro do repo
  $VERBO detectar <repo>         diz qual stack casou e que linha rodaria, sem rodar

bancada: PLATAFIRMA_BANCADA, senao $PLATAFIRMA_ARQUIVO_BANCADA (sem default: exit 3)
exit: 0 limpo · 1 apontamentos · 2 uso · 3 falha do linter · 4 alvo fora da raiz
      5 indeterminavel (nenhuma stack de lint detectada)
EOF
  exit 2
}

morre() { printf '%s: %s\n' "$VERBO" "$1" >&2; exit "${2:-3}"; }

# Bancada declarada pela conta (card #3010): PLATAFIRMA_BANCADA, senao a linha de
# ~/.config/platafirma/bancada. Sem declaracao: exit 3. Nunca cria diretorio.
declara_bancada() {
  BANCADA="$(pf_bancada)" || exit 3
  case "$BANCADA" in
    /*) BANCADA="${BANCADA%/}" ;;
    *) morre "bancada declarada nao e caminho absoluto: $BANCADA" 3 ;;
  esac
}

bancada_de() {
  local nome="$1"
  local cadeira="${PF_CADEIRA:-}"
  cadeira="${cadeira#claudinho-}"
  cadeira="${cadeira#claudinha-}"
  if [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira" ] && [ -e "$BANCADA/wt/$nome/$cadeira/.git" ]; then
    printf '%s/wt/%s/%s' "$BANCADA" "$nome" "$cadeira"
    return 0
  fi
  if [ -d "$BANCADA/$nome" ]; then
    if [ -n "$cadeira" ]; then
      printf '%s: aviso: worktree wt/%s/%s nao existe — usando fallback %s/%s\n' "$VERBO" "$nome" "$cadeira" "$BANCADA" "$nome" >&2
    else
      printf '%s: aviso: PF_CADEIRA nao definida — usando fallback %s/%s\n' "$VERBO" "$BANCADA" "$nome" >&2
    fi
  fi
  printf '%s/%s' "$BANCADA" "$nome"
}

clone_de() {
  local nome="$1" alvo real raiz_real
  [ -n "$nome" ] || morre "falta o nome do repo" 2
  case "$nome" in
    */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$nome' — e slug dentro da bancada $BANCADA" 4 ;;
  esac
  alvo="$(bancada_de "$nome")"
  [ -d "$alvo" ] || morre "nao ha clone '$nome' na bancada $BANCADA — \`repo abrir $nome\` clona" 3
  real="$(realpath "$alvo" 2>/dev/null)" || morre "nao resolvi '$alvo'" 4
  raiz_real="$(realpath "$BANCADA" 2>/dev/null || printf '%s' "$BANCADA")"
  case "$real/" in "$BANCADA"/*|"$raiz_real"/*) : ;; *) morre "'$nome' resolve fora da bancada $BANCADA" 4 ;; esac
  printf '%s' "$real"
}

alvo_de() {
  local c="$1" a="$2" real
  case "$a" in
    -*) morre "alvo nao pode comecar com '-': '$a'" 2 ;;
    /*|*..*) morre "alvo tem de ser caminho dentro do repo: '$a'" 4 ;;
  esac
  [ -e "$c/$a" ] || morre "alvo '$a' nao existe em $c" 3
  real="$(realpath "$c/$a")" || morre "nao resolvi o alvo" 4
  case "$real/" in "$c"/*) : ;; *) morre "alvo '$a' resolve fora do clone" 4 ;; esac
  printf '%s' "$real"
}

lint_bash() {
  local c="$1"
  local achados
  achados=$(find "$c" -maxdepth 2 -type f \( -name "*.sh" -o -path "*/bin/*" \) ! -name "*.*" ! -path "*/.*" 2>/dev/null | xargs -r awk '
    /^[a-zA-Z_0-9]+[ ]*\(\)[ ]*\{/ { in_func=1; func_name=$1; last_line="" }
    in_func && /^\}/ {
      if (last_line ~ /^[[:space:]]*\[.*\][[:space:]]*&&/ && last_line !~ /\|\|/) {
        print FILENAME ":" NR-1 ": " func_name " termina com condicional sob set -e sem return/exit explicito"
      }
      in_func=0
    }
    in_func && NF && !/^[[:space:]]*#/ { last_line=$0 }
  ')
  if [ -n "$achados" ]; then
    printf '%s\n' "$achados" >&2
    return 1
  fi
  return 0
}

detecta() {
  local c="$1"
  if [ -f "$c/pyproject.toml" ] || [ -f "$c/.ruff.toml" ] || [ -f "$c/ruff.toml" ] \
     || [ -d "$c/.ruff_cache" ]; then printf 'python|uvx ruff check'; return 0; fi
  if [ -f "$c/package.json" ] && grep -q '"lint"[[:space:]]*:' "$c/package.json" 2>/dev/null; then
    printf 'node|npm run lint'; return 0
  fi
  if [ -d "$c/bin" ] || compgen -G "$c/*.sh" >/dev/null 2>&1; then
    printf 'bash|lint_bash'; return 0
  fi
  return 1
}

ato_detectar() {
  local c d stack
  c="$(clone_de "${1:-}")" || exit $?
  if ! d="$(detecta "$c")"; then
    printf '%s: indeterminavel — nenhuma stack de lint detectada em %s\n' "$VERBO" "$c" >&2
    exit 5
  fi
  stack="${d%%|*}"
  printf '%s  ·  stack %s  ·  rodaria: %s\n' "$(basename "$c")" "$stack" "${d#*|}"
}

ato_rodar() {
  local nome="${1:-}" alvo="${2:-}" c d stack rc
  c="$(clone_de "$nome")" || exit $?
  if ! d="$(detecta "$c")"; then
    printf '%s: indeterminavel — nenhuma stack de lint detectada em %s\n' "$VERBO" "$c" >&2
    exit 5
  fi
  stack="${d%%|*}"
  # `if`, e com `|| exit`: `alvo_de` recusa por `exit` DENTRO da substituicao de comando,
  # que mata so o subshell. Sem propagar o codigo aqui, a recusa virava alvo vazio e o
  # linter rodava o repo INTEIRO — contencao que avisa e deixa passar nao e contencao.
  if [ -n "$alvo" ]; then alvo="$(alvo_de "$c" "$alvo")" || exit $?; fi
  printf '# %s · stack %s · %s\n' "$nome" "$stack" "${d#*|}" >&2
  case "$stack" in
    python) (cd "$c" && uvx ruff check "${alvo:-.}") ;;
    node)
      if [ -n "$alvo" ]; then (cd "$c" && npm run lint -- "$alvo"); else (cd "$c" && npm run lint); fi ;;
    bash) lint_bash "$c" ;;
  esac
  rc=$?
  if [ -d "$c/bin" ] && [ "$stack" != "bash" ]; then
    lint_bash "$c" || rc=$(( rc == 0 ? 1 : rc ))
  fi
  [ "$rc" -eq 0 ] && printf 'lint LIMPO: %s (%s)\n' "$nome" "$stack" \
                  || printf 'lint com APONTAMENTOS: %s (%s) — exit %s\n' "$nome" "$stack" "$rc"
  return "$rc"
}

ato="${1:-}"; [ -n "$ato" ] && shift
case "$ato" in
  rodar)    declara_bancada; ato_rodar "$@" ;;
  detectar) declara_bancada; ato_detectar "$@" ;;
  ""|-h|--help|ajuda) uso ;;
  *) morre "ato desconhecido: '$ato' — atos: rodar, detectar" 2 ;;
esac
