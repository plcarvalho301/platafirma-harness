#!/usr/bin/env python3
# lint — aponta desvios em relacao a listas de verificacao e padroes de codigo
# capacidade: qualidade-do-codigo-lint
# dono: ti
# classe: C
# use para: verificar codigo antes de commit/PR, checar conformidade de regras e checklists
# atos: rodar, detectar, codigo, fossil, repo, superficie, arranque, commit, vocabulario, alcance, chapeu, organizacao, card, prosa, testes
# regua: codigo repositorio
# regua: fossil repositorio
# regua: repo lista-de-verificacao checklist-repo
# regua: superficie lista-de-verificacao checklist-superficie
# regua: arranque lista-de-verificacao checklist-arranque
# regua: commit lista-de-verificacao checklist-commit
# regua: vocabulario lista-de-verificacao checklist-vocabulario
# regua: alcance lista-de-verificacao checklist-alcance
# regua: chapeu lista-de-verificacao checklist-chapeu
# regua: organizacao lista-de-verificacao checklist-antipadroes-organizacao-documental
# regua: card lista-de-verificacao arq-0096
# regua: prosa lista-de-verificacao styleguide-da-wiki
# regua: testes lista-de-verificacao checklist-testes
# forma: relatorio
# cauda: sim
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

# Configura importacao de _lint e lib
AQUI = Path(__file__).resolve().parent
HARNESS_DIR = AQUI.parent
if str(AQUI) not in sys.path:
    sys.path.insert(0, str(AQUI))
if str(HARNESS_DIR) not in sys.path:
    sys.path.insert(0, str(HARNESS_DIR))

from _lint.alcance import verificar_alcance
from _lint.arranque import verificar_arranque
from _lint.bancada import ErroBancada, resolver_alvo, resolver_bancada
from _lint.card import verificar_card
from _lint.chapeu import verificar_chapeu
from _lint.codigo import detectar_stack, verificar_codigo
from _lint.commit import verificar_commit
from _lint.fossil import verificar_fossil
from _lint.lista import resolver_lista
from _lint.organizacao import verificar_organizacao
from _lint.prosa import verificar_prosa
from _lint.repo import verificar_repo
from _lint.resultado import Apontamento, relatorio_lint
from _lint.superficie import verificar_superficie
from _lint.testes import verificar_testes
from _lint.vocabulario import verificar_vocabulario

CLASSES_LINT = {
    "codigo": {
        "tipo": "repositorio",
        "chave": "repositorio",
        "detector": "ruff / npm / bash",
        "descricao": "linter de linguagem da stack do clone",
    },
    "fossil": {
        "tipo": "repositorio",
        "chave": "repositorio",
        "detector": "referencias orfas",
        "descricao": "referencias a caminhos ou simbolos quebrados",
    },
    "repo": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-repo",
        "detector": "predicados de repo (arq:0042)",
        "descricao": "materia de acervo, blobs, gerados e cabecalhos de operacao",
    },
    "superficie": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-superficie",
        "detector": "conectores e tools servidas",
        "descricao": "equalizacao de superficies e tools validas",
    },
    "arranque": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-arranque",
        "detector": "ponteiro de arranque em CLAUDE.md",
        "descricao": "garantia de ponteiro para conduta/arranque.md",
    },
    "commit": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-commit",
        "detector": "validacao de ids no rastreador",
        "descricao": "referencias a ids de cards validos e abertos",
    },
    "vocabulario": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-vocabulario",
        "detector": "verbos e atos citados no texto",
        "descricao": "citacoes `verbo ato` entre crases contra bin/",
    },
    "alcance": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-alcance",
        "detector": "cadeia de acesso sujeito->fonte",
        "descricao": "saltos da cadeia de acesso e politicas de PEP",
    },
    "chapeu": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-chapeu",
        "detector": "template de chapeu",
        "descricao": "chapeu de camada C contra TEMPLATE-chapeu.md",
    },
    "organizacao": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-antipadroes-organizacao-documental",
        "detector": "antipadroes documentais",
        "descricao": "conformidade de organizacao documental",
    },
    "card": {
        "tipo": "lista-de-verificacao",
        "chave": "arq-0096",
        "detector": "secoes obrigatorias de card (arq:0096)",
        "descricao": "secoes obrigatorias por nivel de card",
    },
    "prosa": {
        "tipo": "lista-de-verificacao",
        "chave": "styleguide-da-wiki",
        "detector": "regras de prosa e estilo",
        "descricao": "regras de escrita da wiki e conduta",
    },
    "testes": {
        "tipo": "lista-de-verificacao",
        "chave": "checklist-testes",
        "detector": "criterios de teste",
        "descricao": "padroes e cobertura minima de suites de teste",
    },
}


def imprimir_uso(stream=sys.stdout):
    print("uso:", file=stream)
    print("  lint <classe> <repo>[@<chave>] [<alvo>] [--staged] [--json]", file=stream)
    print("  lint commit <arquivo>|- [--json]", file=stream)
    print("  lint card <arquivo>|- [<repo>] [--json]", file=stream)
    print("  lint organizacao <repo> [<alvo>] [--todas] [--resumo]   --todas inclui os bloqueantes (contagem; quem barra e o pre-commit); --resumo conta por regra\n", file=stream)
    print("classes:", file=stream)
    for c, info in CLASSES_LINT.items():
        lista_desc = f"{info['tipo']} {info['chave']}" if info['tipo'] == 'lista-de-verificacao' else info['tipo']
        print(f"  {c:<12} {lista_desc:<50} {info['detector']}", file=stream)
    print("\nbancada: PLATAFIRMA_BANCADA, senao ~/.config/platafirma/bancada", file=stream)
    print("exit: 0 limpo · 1 apontamentos · 2 uso · 3 falha do linter · 4 alvo fora da raiz", file=stream)
    print("      5 indeterminavel (sem lista ou linter indeterminavel)", file=stream)


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        imprimir_uso(sys.stderr)
        return 2

    # Flags globais
    como_json = "--json" in argv
    staged = "--staged" in argv
    todas = "--todas" in argv
    resumo = "--resumo" in argv
    argv = [a for a in argv if a not in ("--json", "--staged", "--todas", "--resumo")]

    if not argv:
        imprimir_uso(sys.stderr)
        return 2

    primeiro = argv[0]
    if primeiro in ("--ajuda", "--help", "-h", "ajuda"):
        imprimir_uso(sys.stdout)
        return 2

    # Trata atos legados (rodar, detectar)
    if primeiro == "rodar":
        classe = "codigo"
        args_resto = argv[1:]
    elif primeiro == "detectar":
        if len(argv) < 2:
            print("lint: uso: lint detectar <repo>", file=sys.stderr)
            return 2
        nome_repo = argv[1]
        try:
            raiz, _ = resolver_bancada(nome_repo)
            det = detectar_stack(raiz)
            if not det:
                print(f"lint: indeterminavel — nenhuma stack de lint detectada em {raiz}", file=sys.stderr)
                return 5
            stack, cmd = det
            print(f"{raiz.name}  ·  stack {stack}  ·  rodaria: {cmd}")
            return 0
        except ErroBancada as e:
            print(f"lint: {e.msg}", file=sys.stderr)
            return e.exit_code
    else:
        classe = primeiro
        args_resto = argv[1:]

    if classe not in CLASSES_LINT:
        print(f"lint: classe desconhecida: '{classe}' — use `lint --ajuda` para ver classes suportadas", file=sys.stderr)
        return 2

    info_classe = CLASSES_LINT[classe]
    chave_lista = info_classe["chave"]
    tipo_regua = info_classe["tipo"]

    # 1. Classe CARD
    if classe == "card":
        alvo_card = args_resto[0] if args_resto else "-"
        repo_card = args_resto[1] if len(args_resto) > 1 else None
        raiz_repo = None
        if repo_card:
            try:
                raiz_repo, _ = resolver_bancada(repo_card)
            except ErroBancada:
                pass
        apontamentos = verificar_card(alvo=alvo_card, raiz=raiz_repo)
        return relatorio_lint(classe, alvo_card, apontamentos, chave_lista, rev=1, como_json=como_json)

    # 2. Classe COMMIT
    if classe == "commit":
        if not args_resto:
            alvo_commit = "-"
            raiz_repo = Path.cwd()
        else:
            # Pode ser 'commit <msg_file>' ou 'commit <repo> <msg_file>'
            if len(args_resto) == 1:
                alvo_commit = args_resto[0]
                raiz_repo = Path.cwd()
            else:
                try:
                    raiz_repo, _ = resolver_bancada(args_resto[0])
                    alvo_commit = args_resto[1]
                except ErroBancada:
                    raiz_repo = Path.cwd()
                    alvo_commit = args_resto[0]
        apontamentos = verificar_commit(raiz_repo, alvo=alvo_commit)
        return relatorio_lint(classe, alvo_commit, apontamentos, chave_lista, rev=1, como_json=como_json)

    # Demais classes exigem <repo>
    if not args_resto:
        print(f"lint: classe '{classe}' exige o nome do repositorio (ex: lint {classe} platafirma-harness)", file=sys.stderr)
        return 2

    nome_repo = args_resto[0]
    alvo = args_resto[1] if len(args_resto) > 1 else None

    try:
        raiz_repo, chave_bancada = resolver_bancada(nome_repo)
    except ErroBancada as e:
        print(f"lint: {e.msg}", file=sys.stderr)
        return e.exit_code

    # em alcance o alvo e "<sujeito> <fonte>", nao caminho: nao se resolve no repo
    if alvo and classe != "alcance":
        try:
            resolver_alvo(raiz_repo, alvo)
        except ErroBancada as e:
            print(f"lint: {e.msg}", file=sys.stderr)
            return e.exit_code

    # Monta identificador de alvo para a ancora
    alvo_ancora = f"{nome_repo}/{alvo}" if alvo else nome_repo

    # 3. Classes com lista que exigem acervo (organizacao, prosa, testes)
    if classe == "organizacao":
        try:
            apontamentos, chv, rev = verificar_organizacao(raiz_repo, alvo=alvo, com_bloqueantes=todas)
            return relatorio_lint(classe, alvo_ancora, apontamentos, chv, rev=rev, como_json=como_json,
                                  resumo=resumo)
        except ValueError as e:
            rc, msg = e.args
            print(f"lint: {msg}", file=sys.stderr)
            return rc

    if classe == "prosa":
        try:
            apontamentos, chv, rev = verificar_prosa(raiz_repo, alvo=alvo)
            return relatorio_lint(classe, alvo_ancora, apontamentos, chv, rev=rev, como_json=como_json)
        except ValueError as e:
            rc, msg = e.args
            print(f"lint: {msg}", file=sys.stderr)
            return rc

    if classe == "testes":
        try:
            apontamentos, chv, rev = verificar_testes(raiz_repo, alvo=alvo)
            return relatorio_lint(classe, alvo_ancora, apontamentos, chv, rev=rev, como_json=como_json)
        except ValueError as e:
            rc, msg = e.args
            print(f"lint: {msg}", file=sys.stderr)
            return rc

    # 4. Classe CODIGO
    if classe == "codigo":
        try:
            apontamentos, stack = verificar_codigo(raiz_repo, alvo=alvo)
            return relatorio_lint(classe, alvo_ancora, apontamentos, "repositorio", rev=None, como_json=como_json)
        except ValueError as e:
            rc, msg = e.args
            print(f"lint: {msg}", file=sys.stderr)
            return rc

    # 5. Classe FOSSIL
    if classe == "fossil":
        apontamentos = verificar_fossil(raiz_repo, alvo=alvo)
        return relatorio_lint(classe, alvo_ancora, apontamentos, "repositorio", rev=None, como_json=como_json)

    # 6. Classe REPO
    if classe == "repo":
        apontamentos = verificar_repo(raiz_repo, staged=staged, alvo=alvo)
        return relatorio_lint(classe, alvo_ancora, apontamentos, chave_lista, rev=1, como_json=como_json)

    # 7. Classe SUPERFICIE
    if classe == "superficie":
        apontamentos = verificar_superficie(raiz_repo, staged=staged, alvo=alvo)
        return relatorio_lint(classe, alvo_ancora, apontamentos, chave_lista, rev=1, como_json=como_json)

    # 8. Classe ARRANQUE
    if classe == "arranque":
        apontamentos = verificar_arranque(raiz_repo, staged=staged, alvo=alvo)
        return relatorio_lint(classe, alvo_ancora, apontamentos, chave_lista, rev=1, como_json=como_json)

    # 9. Classe VOCABULARIO
    if classe == "vocabulario":
        apontamentos = verificar_vocabulario(raiz_repo, alvo=alvo)
        return relatorio_lint(classe, alvo_ancora, apontamentos, chave_lista, rev=1, como_json=como_json)

    # 10. Classe ALCANCE
    if classe == "alcance":
        apontamentos = verificar_alcance(raiz_repo, alvo=alvo)
        return relatorio_lint(classe, alvo_ancora, apontamentos, chave_lista, rev=1, como_json=como_json)

    # 11. Classe CHAPEU
    if classe == "chapeu":
        apontamentos = verificar_chapeu(raiz_repo, alvo=alvo)
        return relatorio_lint(classe, alvo_ancora, apontamentos, chave_lista, rev=1, como_json=como_json)

    return 0


if __name__ == "__main__":
    sys.exit(main())
