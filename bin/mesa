#!/opt/platafirma/current/venv/harness/bin/python
# mesa — grava e lê o trabalho da cadeira na lousa, pela chave do trabalho
# capacidade: memoria
# dono: gestao-estrategica
"""Verbo `mesa` da casa nova (story 4366, feature 4269).

Expõe apenas `item`, `fez` e `ver`, sem atos de caderno. Grava e lê o trabalho da cadeira
na lousa (memória de trabalho) pela chave do trabalho (`card:<N>` ou `turno:<ordem_id>`),
fora da chave da sessão e sem prazo de relógio.

capacidade: memoria · dono: gestao-estrategica · classe: B
atos: item (escrita, trabalho), fez (escrita, trabalho), ver (leitura, trabalho)
saídas: 0 ok · 2 uso ou ocasião ausente · 3 memória de trabalho fora do ar
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from collections.abc import Mapping
from pathlib import Path

_REPO_REAL = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO_REAL / "lib"))

from abertura.pauta import ler_estados_de_cards
from postura.lousa import (
    Fora,
    ItemDeTrabalho,
    Ocasiao,
    OcasiaoAusente,
    agora_iso,
    chave_item_trabalho,
    lousa_do_ambiente,
    normalizar_card,
)

ATOS_VALIDOS = ("item", "fez", "ver")


def _erro(msg: str, codigo: int, *, como_json: bool) -> int:
    if como_json:
        print(json.dumps({"erro": msg, "exit_code": codigo}, ensure_ascii=False))
    else:
        print(msg, file=sys.stderr)
    return codigo


def _parsear_e_cadeira(parser: argparse.ArgumentParser, argv: list[str]) -> tuple[argparse.Namespace | None, str, int]:
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return None, "", int(exc.code) if isinstance(exc.code, int) else 2
    cadeira = (args.cadeira or os.environ.get("PF_CADEIRA") or "").strip()
    if not cadeira:
        rc = _erro("sem cadeira: informe --cadeira ou PF_CADEIRA", 2, como_json=bool(args.como_json))
        return None, "", rc
    return args, cadeira, 0


def _normalizar_chave(bruta: str) -> str:
    s = (bruta or "").strip()
    if not s:
        return ""
    if s.startswith(("card:", "turno:")):
        prefixo, resto = s.split(":", 1)
        if prefixo == "card":
            c = normalizar_card(resto)
            return f"card:{c}" if c else ""
        return f"turno:{resto.strip()}" if resto.strip() else ""
    if s.lstrip("#").isdigit():
        return f"card:{s.lstrip('#')}"
    return s


def _estado_texto(info: object) -> str | None:
    if isinstance(info, Mapping):
        est = info.get("estado") or info.get("estado_derivado")
        return str(est).strip() if est else None
    if isinstance(info, str):
        return info.strip() or None
    return None


def _consultar_estado_card(card: str) -> str | None:
    avisos: list[str] = []
    estados = ler_estados_de_cards([card], avisos=avisos)
    for aviso in avisos:
        print(f"aviso: {aviso}", file=sys.stderr)
    estado = _estado_texto(estados.get(card))
    if estado is None and not avisos:
        print(
            f"aviso: rastreador não devolveu estado do card #{card}; gravando estado_card como null",
            file=sys.stderr,
        )
    return estado


def _formatar_item(item: ItemDeTrabalho) -> str:
    partes = [item.chave, f"({item.situacao})"]
    if item.estagio:
        partes.append(f"[{item.estagio}]")
    if item.proxima_jogada:
        partes.append(item.proxima_jogada)
    if item.ocasiao is not None:
        oc = [
            texto
            for cond, texto in (
                (item.ocasiao.card, f"card #{item.ocasiao.card}"),
                (item.ocasiao.chapeu, f"chapéu {item.ocasiao.chapeu}"),
                (item.ocasiao.pedido, f"pedido: {item.ocasiao.pedido}"),
            )
            if cond
        ]
        if oc:
            partes.append(f"— ocasião: {', '.join(oc)}")
    return " ".join(partes)


def _montar_ocasiao(
    args: argparse.Namespace,
    existente: ItemDeTrabalho | None,
    card_final: str | None,
) -> tuple[Ocasiao | None, str | None]:
    tem_flag_ocasiao = any([args.ocasiao_card, args.ocasiao_pedido, args.ocasiao_chapeu])
    if args.guardar and not tem_flag_ocasiao:
        return None, "ocasião de voltar falta: informe --ocasiao-card, --ocasiao-pedido ou --ocasiao-chapeu"
    oc_prev = existente.ocasiao if existente else None
    oc_card = normalizar_card(args.ocasiao_card) if args.ocasiao_card else (oc_prev.card if oc_prev else None)
    oc_pedido = args.ocasiao_pedido if args.ocasiao_pedido is not None else (oc_prev.pedido if oc_prev else None)
    oc_chapeu = args.ocasiao_chapeu if args.ocasiao_chapeu is not None else (oc_prev.chapeu if oc_prev else None)

    estado_card = args.estado_card if args.estado_card is not None else (oc_prev.estado_card if oc_prev else None)
    card_para_estado = oc_card or card_final
    if estado_card is None and card_para_estado:
        estado_card = _consultar_estado_card(card_para_estado)

    ocasiao = Ocasiao(card=oc_card, pedido=oc_pedido, chapeu=oc_chapeu, estado_card=estado_card)
    if ocasiao.vazia():
        return None, "ocasião de voltar falta: informe --ocasiao-card, --ocasiao-pedido ou --ocasiao-chapeu"
    return ocasiao, None


def _resolver_chave_e_existente(
    args: argparse.Namespace,
    cadeira: str,
    lousa,
) -> tuple[str, ItemDeTrabalho | None, str | None, int]:
    if args.corrigir:
        chave_alvo = _normalizar_chave(args.corrigir)
        if not chave_alvo:
            return "", None, "chave inválida em --corrigir", 2
        try:
            return chave_alvo, lousa.ler_trabalho(cadeira, chave_alvo), None, 0
        except Fora as erro:
            return "", None, str(erro), 3
    turno_ref = args.turno or os.environ.get("PF_ORDEM_ID")
    try:
        return chave_item_trabalho(card=args.card, turno=turno_ref), None, None, 0
    except ValueError as erro:
        return "", None, str(erro), 2


def _ato_item(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="mesa item", add_help=True)
    parser.add_argument("--card", dest="card")
    parser.add_argument("--turno", dest="turno")
    parser.add_argument("--estagio", dest="estagio")
    parser.add_argument("--proxima-jogada", "--ato", dest="proxima_jogada")
    parser.add_argument("--chapeu", dest="chapeu")
    parser.add_argument("--guardar", action="store_true")
    parser.add_argument("--ocasiao-card", dest="ocasiao_card")
    parser.add_argument("--ocasiao-pedido", dest="ocasiao_pedido")
    parser.add_argument("--ocasiao-chapeu", dest="ocasiao_chapeu")
    parser.add_argument("--estado-card", dest="estado_card")
    parser.add_argument("--corrigir", dest="corrigir")
    parser.add_argument("--cadeira", dest="cadeira")
    parser.add_argument("--json", dest="como_json", action="store_true")
    args, cadeira, rc = _parsear_e_cadeira(parser, argv)
    if args is None:
        return rc
    como_json = bool(args.como_json)

    lousa = lousa_do_ambiente()
    chave_alvo, existente, msg_erro, cod_erro = _resolver_chave_e_existente(args, cadeira, lousa)
    if msg_erro:
        return _erro(msg_erro, cod_erro, como_json=como_json)

    card_final = normalizar_card(args.card) if args.card else (existente.card if existente else None)
    if card_final is None and chave_alvo.startswith("card:"):
        card_final = normalizar_card(chave_alvo.split(":", 1)[1])

    turno_env = None if card_final else (os.environ.get("PF_ORDEM_ID") or "").strip() or None
    turno_final = args.turno.strip() if args.turno else (existente.turno if existente else turno_env)
    estagio_final = args.estagio if args.estagio is not None else (existente.estagio if existente else "")
    jogada_final = (
        args.proxima_jogada if args.proxima_jogada is not None else (existente.proxima_jogada if existente else "")
    )
    chapeu_final = args.chapeu if args.chapeu is not None else (existente.chapeu if existente else None)
    situacao = "guardado" if args.guardar else (existente.situacao if (args.corrigir and existente) else "em_curso")

    ocasiao_final: Ocasiao | None = None
    if situacao == "guardado":
        ocasiao_final, msg_oc = _montar_ocasiao(args, existente, card_final)
        if msg_oc:
            return _erro(msg_oc, 2, como_json=como_json)

    agora = agora_iso()
    guardado_em = (
        (existente.guardado_em if (existente and existente.guardado_em) else agora)
        if situacao == "guardado"
        else None
    )

    try:
        item = ItemDeTrabalho(
            chave=chave_alvo,
            cadeira=cadeira,
            situacao=situacao,
            card=card_final,
            turno=turno_final,
            estagio=estagio_final,
            proxima_jogada=jogada_final,
            chapeu=chapeu_final,
            ocasiao=ocasiao_final,
            guardado_em=guardado_em,
            atualizado_em=agora,
        )
        lousa.gravar_trabalho(cadeira, item)
    except (OcasiaoAusente, ValueError) as erro:
        return _erro(str(erro), 2, como_json=como_json)
    except Fora as erro:
        return _erro(str(erro), 3, como_json=como_json)

    if como_json:
        print(json.dumps(item.como_dict(), ensure_ascii=False))
    else:
        print(_formatar_item(item))
    return 0


def _ato_fez(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="mesa fez", add_help=True)
    parser.add_argument("alvo", nargs="?")
    parser.add_argument("--card", dest="card")
    parser.add_argument("--turno", dest="turno")
    parser.add_argument("--chave", dest="chave")
    parser.add_argument("--cadeira", dest="cadeira")
    parser.add_argument("--json", dest="como_json", action="store_true")
    args, cadeira, rc = _parsear_e_cadeira(parser, argv)
    if args is None:
        return rc
    como_json = bool(args.como_json)

    if args.chave:
        chave_alvo = _normalizar_chave(args.chave)
    elif args.card or args.turno:
        chave_alvo = chave_item_trabalho(card=args.card, turno=args.turno)
    elif args.alvo:
        chave_alvo = _normalizar_chave(args.alvo)
    else:
        chave_alvo = ""

    if not chave_alvo:
        return _erro("informe a chave, --card ou --turno do item feito", 2, como_json=como_json)

    try:
        removido = lousa_do_ambiente().apagar_trabalho(cadeira, chave_alvo)
    except Fora as erro:
        return _erro(str(erro), 3, como_json=como_json)

    if como_json:
        print(json.dumps({"ok": True, "chave": chave_alvo, "removido": removido}, ensure_ascii=False))
    else:
        estado = "removido" if removido else "não encontrado"
        print(f"{chave_alvo}: {estado}")
    return 0


def _ato_ver(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="mesa ver", add_help=True)
    parser.add_argument("--situacao", choices=["em_curso", "guardado"])
    parser.add_argument("--cadeira", dest="cadeira")
    parser.add_argument("--json", dest="como_json", action="store_true")
    args, cadeira, rc = _parsear_e_cadeira(parser, argv)
    if args is None:
        return rc
    como_json = bool(args.como_json)

    try:
        itens = lousa_do_ambiente().listar_trabalhos(cadeira, situacao=args.situacao)
    except Fora as erro:
        return _erro(str(erro), 3, como_json=como_json)

    if como_json:
        print(json.dumps([i.como_dict() for i in itens], ensure_ascii=False))
    elif not itens:
        print("lousa vazia")
    else:
        for item in itens:
            print(_formatar_item(item))
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    como_json = "--json" in args
    if not args or args[0] in ("-h", "--help"):
        print("uso: mesa <item|fez|ver> [opções]")
        return 0
    ato, resto = args[0], args[1:]
    if ato == "item":
        return _ato_item(resto)
    if ato == "fez":
        return _ato_fez(resto)
    if ato == "ver":
        return _ato_ver(resto)
    return _erro(f"ato desconhecido '{ato}' (atos disponíveis: {', '.join(ATOS_VALIDOS)})", 2, como_json=como_json)


if __name__ == "__main__":
    sys.exit(main())
