#!/home/claudinho/AI/.venv-harness/bin/python
# mesa — memoria de trabalho da cadeira entre fitas, por chapeu
# capacidade: memoria
# dono: claudinho-IA (conteudo e formato) · claudinho-TI (substrato)
#
# Despachante (arq:0040): o binario agrupa a memoria da cadeira, o sub-ato e o
# ato. Dois substratos duraveis, um eixo — o chapeu (slot) e o mesmo nos dois:
#
#   mesa    (item)    tabela `sessao.mesa_item`, instancia harness-sessao. Item com
#                     ATO e ALVO, que esvazia por execucao do ato. O que a fita de
#                     hoje precisa que a fita de amanha FACA.
#   caderno (duravel) arquivo `caderno/<cadeira>/<slot>.md` no repo do harness.
#                     Versionado, com diff e revisao. O que a cadeira aprendeu do
#                     proprio oficio e vale alem de um expediente.
#
# SUBSTRATO DA MESA TROCOU (fase 6 do card #189, spec_montagem-de-sessao §3): era
# texto livre na classe `mem` do Valkey, e agora e entidade em Postgres. O que
# muda de verdade nao e o banco, e a REGUA DE ADMISSAO: mesa e o que tem ato
# pendente. Prosa sem ato nao e mesa — decisao fechada e a peca `antirreabertura`,
# aprendizado de oficio e caderno.
#
# O VALKEY AINDA SERVE, e nao e por indecisao: `descansar`, os rituais do chat e o
# ops-server chamam `mesa anota <chapeu>` com prosa em stdin, e derrubar esse
# contrato hoje quebraria o encerramento de fita de TODA cadeira. Enquanto eles
# nao migram, `anota` continua escrevendo la, `ver` le os dois e marca qual e qual.
# A mesa velha ja esta capturada em `sessao.mesa_legado` (sessao/migracao/).
#
# NAO E A FILA. Protocolo inteiro distinto: sem envelope, sem destinatario, sem
# ack, sem consumer group, sem trim de arq:0024. A fila e dirigida a outro e
# imutavel; a memoria e para si mesma e mutavel. Fato que interessa a outra
# cadeira desce ao canal proprio (card, commit, wiki) — nunca mora aqui.
#
# NAO HA CONSUMO. `monta_sessao` le sem apagar. Item sai da mesa por `mesa fez
# <id>`, que e a execucao do ato — nunca por leitura, e nunca por robo.
#
# BANCO FORA DO AR SE DECLARA INDISPONIVEL, nunca como mesa vazia: ausencia de
# item e resposta valida (arq:0041) e seria indistinguivel de substrato mudo.
#
# CADERNO E CORPO SOB DEMANDA. A abertura entrega o INDICE (nome, idade, bytes);
# o corpo so entra na fita que o pediu — mesma regra da fila (envelope, nunca
# corpo) e da skill (descritor no contexto, corpo por ato).
import argparse
import json
import os
import re
import subprocess
import sys
import time

try:
    import redis
except ImportError:
    sys.exit("erro: modulo 'redis' nao instalado neste venv (uv pip install redis)")

HOST = os.environ.get("MEM_REDIS_HOST", "127.0.0.1")
PORTA = int(os.environ.get("MEM_REDIS_PORT", "6380"))  # instancia msg-mem, nao a malha
TTL_PADRAO = int(os.environ.get("MEM_TTL_DIAS", "14")) * 86400
TETO_AVISO = 4000  # bytes; acima disto e sintoma de fato nao despachado
RAIZ = os.environ.get("PF_RAIZ", os.path.expanduser("~/AI"))
HARNESS = os.path.join(RAIZ, "platafirma-harness")
CADERNOS = os.path.join(HARNESS, "abertura")  # arq:0073: caderno mora em abertura/<cadeira>/<slug>/
LEDGER = os.path.join(HARNESS, "registro", "eventos-org.jsonl")
SESSAO_ENV = os.path.join(HARNESS, "sessao", ".env")
SLOT_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,23}$")

# Slot de fita corrente (card 449). Fora do padrao `mem:<cadeira>:<slot>` de
# proposito: `mesa ver` e a varredura de `descansar` varrem aquele padrao e
# acusariam a fita como chapeu orfao. Mesma instancia msg-mem — nao e trafego
# novo na malha `pf:msg` (criterio 13 da minuta 0002), que e outra instancia.
# Valor e o id puro, nao JSON: o compare-and-swap e comparacao de string, e a
# idade sai do TTL restante. Uma peca a menos que um decode em Lua.
#
# O CAS FICA NO VALKEY, e nao migra junto: e comparacao de string em memoria no
# caminho de toda escrita de mesa. `sessao.fita` recebe o REGISTRO da fita (para
# giro, pacote e peca-servida terem raiz), nao a guarda.
FITA_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

# CAS: escreve KEYS[2] so se KEYS[1] (fita corrente) ainda for ARGV[1].
LUA_ANOTA = """
if redis.call('GET', KEYS[1]) ~= ARGV[1] then return 0 end
redis.call('SET', KEYS[2], ARGV[2], 'EX', tonumber(ARGV[3]))
return 1
"""
LUA_FECHA = """
if redis.call('GET', KEYS[1]) ~= ARGV[1] then return 0 end
return redis.call('DEL', KEYS[1])
"""


def conn():
    return redis.Redis(host=HOST, port=PORTA, decode_responses=True)


def dsn():
    """DSN do harness-sessao. Senha sai de `sessao/.env`, que e 600 e fora do git —
    o verbo roda como `claudinho`, dono do arquivo, e nao ha segredo em codigo."""
    d = os.environ.get("SESSAO_PG_DSN")
    if d:
        return d
    senha = os.environ.get("SESSAO_PG_PASSWORD", "")
    if not senha and os.path.isfile(SESSAO_ENV):
        for linha in open(SESSAO_ENV, encoding="utf-8"):
            if linha.startswith("SESSAO_PG_PASSWORD="):
                senha = linha.split("=", 1)[1].strip()
                break
    porta = os.environ.get("SESSAO_PG_PORT", "5437")
    return f"host=127.0.0.1 port={porta} dbname=sessao user=sessao password={senha}"


def pg(silencioso=False):
    """Conexao com o substrato de item. Devolve None em vez de morrer: mesa fora do
    ar nao pode derrubar o verbo nem a abertura de sessao — se declara e segue."""
    try:
        import psycopg
    except ImportError:
        if not silencioso:
            print("(itens de mesa indisponiveis: modulo 'psycopg' ausente neste venv)",
                  file=sys.stderr)
        return None
    try:
        return psycopg.connect(dsn(), connect_timeout=3)
    except Exception as e:  # noqa: BLE001 — qualquer falha aqui e "substrato mudo"
        if not silencioso:
            print(f"(itens de mesa indisponiveis: sessao-db nao respondeu — {e.__class__.__name__})",
                  file=sys.stderr)
        return None


def _bruta():
    c = os.environ.get("PF_CADEIRA", "").strip().lower()
    if not c:
        sys.exit("erro: PF_CADEIRA nao definida — a memoria e privada da cadeira (arq:0041)")
    return c


_RESOLVIDA = []


def _resolve():
    """(curto, canonico) a partir de PF_CADEIRA, que chega nas DUAS formas.

    Sufixo e deterministico: tira o prefixo claudinho-/claudinha- e baixa a caixa. O
    canonico (chave da fila) vem do LEDGER de vinculo (arq:0073) — a persona do form
    novo poe o ALIAS na linha 1, nao o slug, entao a linha 1 nao serve mais de fonte.
    Nao achando no ledger, devolve (curto, None): nao inventa cadeira.
    """
    if _RESOLVIDA:
        return _RESOLVIDA[0]
    bruta = _bruta()
    curto = bruta
    for pref in ("claudinho-", "claudinha-"):
        if curto.lower().startswith(pref):
            curto = curto[len(pref):]
    curto = curto.lower()
    canon = None
    try:
        with open(LEDGER, encoding="utf-8", errors="replace") as fh:
            for linha in fh:
                try:
                    cad = (json.loads(linha).get("cadeira") or "").strip()
                except ValueError:
                    continue
                suf = cad
                for pref in ("claudinho-", "claudinha-"):
                    if suf.lower().startswith(pref):
                        suf = suf[len(pref):]
                if suf.lower() == curto:
                    canon = cad
    except OSError:
        pass
    par = (curto, canon)
    _RESOLVIDA.append(par)
    return par


def cadeira():
    """Chave do SUBSTRATO: o sufixo (`ia`, `ti`). Decisao do dono, 18/08/2026.

    Vale para `mem:`, `fita:` e `caderno/`. A caixa da fila continua canonica —
    sao endereços de coisas diferentes, e colapsar os dois foi o que partiu a mesa
    em duas metades (medido em 16/08).
    """
    return _resolve()[0]


def canonica():
    """Slug canonico: caixa da fila e substrato NOVO (Postgres)."""
    return _resolve()[1] or _bruta()


def dir_legado():
    """Sem legado sob abertura/: o tombamento (arq:0073) unificou a morada."""
    return None


def chave(slot):
    return f"mem:{cadeira()}:{slot}"


def chave_fita():
    return f"fita:{cadeira()}"


def fita_do_ambiente(explicito=None):
    """Guarda por id e opt-in pelo ambiente: o adaptador exporta PF_FITA ao abrir
    a fita, como ja exporta PF_CADEIRA. Sem PF_FITA, comportamento de sempre —
    sessao de mao (claude.ai, terminal) nao tem fita registrada e nao deve travar."""
    return (explicito or os.environ.get("PF_FITA", "")).strip() or None


def valida_fita(fid):
    if not FITA_RE.match(fid or ""):
        sys.exit(f"erro: id de fita invalido {fid!r} — alfanumerico, ponto, hifen ou _, ate 64 chars")
    return fid


def valida_slot(slot):
    if not SLOT_RE.match(slot or ""):
        sys.exit(f"erro: slot invalido {slot!r} — minusculas, digitos e hifen, ate 24 chars")
    return slot


def idade(seg):
    seg = max(0, int(seg))
    if seg < 3600:
        return f"{seg // 60} min"
    if seg < 86400:
        return f"{seg // 3600} h"
    return f"{seg // 86400} d"


def registra_fita(con, fid):
    """Raiz do agregado operacional. Superficie sai de PF_SUPERFICIE; quem nao
    declara e registrado como 'desconhecida', nunca como um palpite plausivel."""
    sup = os.environ.get("PF_SUPERFICIE", "").strip() or "desconhecida"
    if sup not in ("claude.ai", "chat", "code", "desconhecida"):
        sup = "desconhecida"
    with con.cursor() as cur:
        cur.execute(
            "INSERT INTO sessao.fita (id, persona, superficie) VALUES (%s, %s, %s) "
            "ON CONFLICT (id) DO NOTHING",
            (fid, canonica(), sup),
        )
    con.commit()


def ato_ver(args):
    """Indice do que esta pendente. Item primeiro (substrato novo), prosa depois."""
    achou = False
    con = pg()
    if con is not None:
        with con, con.cursor() as cur:
            cur.execute(
                "SELECT id, chapeu, ato, alvo, texto, plantado_em FROM sessao.mesa_item "
                "WHERE cadeira = %s AND esvaziado_em IS NULL "
                + ("AND chapeu = %s " if args.slot else "")
                + "ORDER BY chapeu, plantado_em",
                (canonica(), args.slot) if args.slot else (canonica(),),
            )
            linhas = cur.fetchall()
        for id_, chapeu, ato, alvo, texto, plantado in linhas:
            achou = True
            print(f"#{id_} [{chapeu}] {ato} → {alvo}   (plantado ha {idade(time.time() - plantado.timestamp())})")
            if texto:
                for l in texto.rstrip().splitlines():
                    print(f"      {l}")
        if linhas:
            print("  (executou? `mesa fez <id>` — leitura nao esvazia)")
            print()

    rc = conn()
    alvo = f"mem:{cadeira()}:{args.slot}" if args.slot else f"mem:{cadeira()}:*"
    for k in sorted(rc.keys(alvo)):
        achou = True
        bruto = rc.get(k)
        slot = k.split(":", 2)[2]
        try:
            d = json.loads(bruto)
            texto, ts = d.get("x", ""), d.get("t", 0)
        except (ValueError, AttributeError):
            texto, ts = bruto or "", 0
        print(f"[{slot}] (prosa, substrato velho) escrito ha {idade(time.time() - ts)}")
        print(texto.rstrip())
        print()

    if not achou:
        print("mesa vazia" if not args.slot else f"slot {args.slot}: vazio")
    return 0


def ato_item(args):
    """Planta um item. Sem ato e sem alvo nao entra: a regua de admissao da mesa e
    'se eu nao fizer nada, isso continua do jeito que esta?' — sem ato, nao continua
    nada, e o lugar do texto e outro (antirreabertura, caderno, card)."""
    slot = valida_slot(args.chapeu)
    texto = "" if sys.stdin.isatty() else sys.stdin.read().strip()
    con = pg()
    if con is None:
        return 3
    with con, con.cursor() as cur:
        cur.execute(
            "INSERT INTO sessao.mesa_item (cadeira, chapeu, ato, alvo, texto, plantado_por_fita) "
            "VALUES (%s, %s, %s, %s, %s, %s) RETURNING id",
            (canonica(), slot, args.ato.strip(), args.alvo.strip(), texto or None,
             fita_registrada(con)),
        )
        novo = cur.fetchone()[0]
    print(f"mesa: item #{novo} plantado em [{slot}] — {args.ato.strip()} → {args.alvo.strip()}")
    return 0


def fita_registrada(con):
    """Registra a fita corrente e devolve o id, ou None quando nao ha fita declarada
    (sessao de mao). FK opcional de proposito: item plantado sem fita continua item."""
    fid = fita_do_ambiente()
    if not fid:
        return None
    valida_fita(fid)
    registra_fita(con, fid)
    return fid


def ato_fez(args):
    """Esvazia o item porque o ato foi executado. Nao apaga: o item fica com
    `esvaziado_em`, que e o unico jeito de medir depois o que a mesa realmente moveu."""
    con = pg()
    if con is None:
        return 3
    with con, con.cursor() as cur:
        fid = fita_registrada(con)
        cur.execute(
            "UPDATE sessao.mesa_item SET esvaziado_em = now(), esvaziado_por_fita = %s "
            "WHERE id = %s AND cadeira = %s AND esvaziado_em IS NULL RETURNING chapeu, ato",
            (fid, args.id, canonica()),
        )
        linha = cur.fetchone()
    if not linha:
        print(f"mesa: item #{args.id} nao esta pendente nesta cadeira — nada a esvaziar",
              file=sys.stderr)
        return 3
    print(f"mesa: item #{args.id} esvaziado [{linha[0]}] — {linha[1]}")
    return 0


def ato_legado(args):
    """A mesa velha, capturada do Valkey na migracao da fase 6. Leitura, e um gesto
    de triagem: o que ainda tem ato vira `mesa item`, o resto morre com o registro."""
    con = pg()
    if con is None:
        return 3
    with con, con.cursor() as cur:
        if args.triado:
            cur.execute(
                "UPDATE sessao.mesa_legado SET triado_em = now() "
                "WHERE cadeira = %s AND chapeu = %s AND triado_em IS NULL RETURNING chave_origem",
                (canonica(), args.triado),
            )
            achados = cur.fetchall()
            print(f"mesa legada: {len(achados) or 'nenhuma'} entrada(s) de [{args.triado}] triada(s)")
            return 0
        cur.execute(
            "SELECT chave_origem, chapeu, bytes, texto FROM sessao.mesa_legado "
            "WHERE cadeira = %s AND triado_em IS NULL ORDER BY chapeu, chave_origem",
            (canonica(),),
        )
        linhas = cur.fetchall()
    if not linhas:
        print("mesa legada: nada pendente de triagem")
        return 0
    for chave_origem, chapeu, bytes_, texto in linhas:
        print(f"===== {chave_origem}  [{chapeu}] {bytes_} B =====")
        print(texto.rstrip() if args.corpo else "  (corpo por `mesa legado --corpo`)")
        print()
    print("  (triado? `mesa legado --triado <chapeu>`; o que tinha ato vira `mesa item`)")
    return 0


def ato_anota(args):
    """FORMA VELHA, mantida porque `descansar`, os rituais do chat e o ops-server
    ainda a chamam com prosa em stdin. Escreve no Valkey, nao no substrato de item."""
    slot = valida_slot(args.slot)
    texto = sys.stdin.read().strip()
    if not texto:
        sys.exit("erro: corpo vazio — para esquecer um slot use `mesa limpa <slot>`")
    print("aviso: `mesa anota` escreve prosa no substrato velho. O que tem ATO pendente vai "
          "em `mesa item <chapeu> --ato ... --alvo ...`, que e o que a abertura serve.",
          file=sys.stderr)
    if len(texto.encode()) > TETO_AVISO:
        print(
            f"aviso: {len(texto.encode())} bytes no slot {slot} — mesa grande e sintoma "
            "de fato que devia ter descido a card, commit ou wiki",
            file=sys.stderr,
        )
    rc = conn()
    valor = json.dumps({"t": int(time.time()), "x": texto})
    fid = fita_do_ambiente(args.se_fita)
    if fid is None:
        rc.set(chave(slot), valor, ex=TTL_PADRAO)
        print(f"mesa: slot {slot} reescrito ({len(texto.splitlines())} linhas)")
        return 0
    # Criterio 18 da minuta 0002: ritual que termina depois de a fita nova ter
    # anotado descarta a PROPRIA escrita. Compare-and-swap, nao confianca em ordem.
    valida_fita(fid)
    ok = rc.eval(LUA_ANOTA, 2, chave_fita(), chave(slot), fid, valor, TTL_PADRAO)
    if not ok:
        corrente = rc.get(chave_fita())
        print(f"mesa: escrita DESCARTADA no slot {slot} — a fita {fid} ja nao e a corrente "
              f"({corrente or 'nenhuma'}); a fita seguinte manda", file=sys.stderr)
        return 3
    print(f"mesa: slot {slot} reescrito ({len(texto.splitlines())} linhas, fita {fid})")
    return 0


def ato_limpa(args):
    slot = valida_slot(args.slot)  # mutacao exige alvo explicito
    rc = conn()
    print(f"mesa: slot {slot} {'limpo' if rc.delete(chave(slot)) else 'ja estava vazio'}")
    return 0


def ato_fita(args):
    """Slot de fita corrente da cadeira: quem abriu, e contra quem o CAS compara.
    Escrito pelo adaptador do chat na abertura; lido por toda escrita de mesa.
    A guarda mora no Valkey; o REGISTRO da fita vai para `sessao.fita`, que e a raiz
    de giro, pacote e peca-servida — falha no registro nao impede abrir a fita."""
    rc = conn()
    k = chave_fita()
    if args.gesto == "abre":
        fid = valida_fita(args.id or f"{int(time.time())}-{os.urandom(3).hex()}")
        rc.set(k, fid, ex=TTL_PADRAO)
        con = pg(silencioso=True)
        if con is not None:
            with con:
                registra_fita(con, fid)
        print(fid)  # stdout e o id, para `export PF_FITA=$(mesa fita abre)`
        return 0
    if args.gesto == "fecha":
        fid = valida_fita(fita_do_ambiente(args.id) or "")
        if rc.eval(LUA_FECHA, 1, k, fid):
            con = pg(silencioso=True)
            if con is not None:
                with con, con.cursor() as cur:
                    cur.execute(
                        "UPDATE sessao.fita SET encerrada_em = now(), encerramento = 'zerar' "
                        "WHERE id = %s AND encerrada_em IS NULL", (fid,))
                con.commit()
            print(f"fita {fid}: fechada")
            return 0
        print(f"fita {fid}: nao era a corrente ({rc.get(k) or 'nenhuma'}) — nada a fechar",
              file=sys.stderr)
        return 3
    fid = rc.get(k)
    if not fid:
        print("fita: nenhuma aberta")  # ausencia e resposta valida (arq:0041)
        return 0
    ttl = rc.ttl(k)
    print(f"fita {fid}: aberta ha {idade(TTL_PADRAO - ttl) if ttl and ttl > 0 else '?'}")
    return 0


def dir_caderno():
    return os.path.join(CADERNOS, cadeira())


def ato_caderno(args):
    """Sem slot: indice (o que entra na abertura). Com slot: corpo, sob demanda.
    Morada arq:0073: abertura/<cadeira>/<slot>/caderno.md."""
    d = dir_caderno()
    if args.slot:
        slot = valida_slot(args.slot)
        caminho = os.path.join(d, slot, "caderno.md")
        if not os.path.isfile(caminho):
            print(f"caderno {slot}: nao existe ({caminho})")
            return 0
        print(f"===== abertura/{cadeira()}/{slot}/caderno.md =====")
        sys.stdout.write(open(caminho, errors="replace").read())
        return 0
    if not os.path.isdir(d):
        print(f"cadernos: nenhum ({d} nao existe)")
        return 0
    achados = sorted(x for x in os.listdir(d)
                     if os.path.isfile(os.path.join(d, x, "caderno.md")))
    if not achados:
        print(f"cadernos: nenhum em {d}")
        return 0
    for slot in achados:
        caminho = os.path.join(d, slot, "caderno.md")
        st = os.stat(caminho)
        # Idade e a do ultimo commit, nao a do mtime: clone recem-puxado tem mtime de hoje.
        try:
            ts = int(subprocess.run(
                ["git", "-C", os.path.dirname(CADERNOS), "log", "-1", "--format=%ct", "--", caminho],
                capture_output=True, text=True, timeout=10).stdout.strip() or st.st_mtime)
        except (OSError, ValueError, subprocess.SubprocessError):
            ts = int(st.st_mtime)
        print(f"  {slot:<16} {st.st_size:>6} B   ultima escrita ha {idade(time.time() - ts)}")
    print(f"  (corpo sob demanda: `mesa caderno <chapeu>`)")
    return 0


def main():
    p = argparse.ArgumentParser(prog="mesa", description="memoria de trabalho da cadeira, por chapeu")
    sub = p.add_subparsers(dest="ato")

    v = sub.add_parser("ver", help="o que esta pendente: item com ato, e a prosa que sobrou")
    v.add_argument("slot", nargs="?")
    v.set_defaults(func=ato_ver)

    i = sub.add_parser("item", help="planta um item de mesa: ato e alvo obrigatorios")
    i.add_argument("chapeu")
    i.add_argument("--ato", required=True, help="o que a proxima fita tem de FAZER")
    i.add_argument("--alvo", required=True, help="sobre o que: card, arquivo, servico, cadeira")
    i.set_defaults(func=ato_item)

    f = sub.add_parser("fez", help="esvazia o item porque o ato foi executado")
    f.add_argument("id", type=int)
    f.set_defaults(func=ato_fez)

    g = sub.add_parser("legado", help="a mesa velha capturada do Valkey, e a triagem dela")
    g.add_argument("--corpo", action="store_true", help="imprime o texto, nao so o cabecalho")
    g.add_argument("--triado", metavar="CHAPEU", help="marca o chapeu como triado")
    g.set_defaults(func=ato_legado)

    a = sub.add_parser("anota", help="forma velha: reescreve prosa num slot; corpo em stdin")
    a.add_argument("slot")
    a.add_argument("--se-fita", metavar="ID",
                   help="so escreve se esta ainda for a fita corrente; default PF_FITA")
    a.set_defaults(func=ato_anota)

    ft = sub.add_parser("fita", help="slot de fita corrente: sem gesto, mostra; abre/fecha mudam")
    ft.add_argument("gesto", nargs="?", choices=["abre", "fecha"])
    ft.add_argument("--id", metavar="ID", help="id explicito; em `abre` sem --id, gera um")
    ft.set_defaults(func=ato_fita)

    l = sub.add_parser("limpa", help="esquece um slot de prosa; alvo obrigatorio")
    l.add_argument("slot")
    l.set_defaults(func=ato_limpa)

    c = sub.add_parser("caderno", help="sem slot, o indice; com slot, o corpo do caderno duravel")
    c.add_argument("slot", nargs="?")
    c.set_defaults(func=ato_caderno)

    args = p.parse_args()
    if not args.ato:
        p.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
