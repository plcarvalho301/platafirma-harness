#!/opt/platafirma/current/venv/harness/bin/python
# fila — lê e envia mensagens entre cadeiras
# capacidade: mensageria
# dono: ia
# componente: harness
# use para: SEMPRE que o dono disser «mensagem», «carta», «recado», «caixa», «fila» ou «o que chegou?», e SEMPRE que não houver pedido ou o pedido já estiver atendido; ler a caixa, tratar mensagem e contestar; enviar mensagem, handoff, resposta ou pauta a outra cadeira
# atos: status (leitura, mensagem) · ler (leitura, mensagem) · tratar (escrita, mensagem) · enviar (escrita, mensagem) · tipos (leitura, mensagem) · contestar (escrita, mensagem)
# forma: status,tipos=lista · ler=texto · tratar=lista · enviar=objeto · contestar=objeto
# face: contestar=motor
# rotulo: contestar=Contestar o indicador
# volta: contestar=nao
# (face: o contestar. A face so alcanca o
#  `contestar`, que manda uma carta de um tipo so (contestacao) com o indicador e o fundamento; o `enviar` geral
#  segue fora da face.)
# cauda: nao
# classe: B
# consome: valkey@streams (protocolo redis — sem OpenAPI)
# ambiente: FILA_REDIS_HOST[=127.0.0.1] · FILA_REDIS_PORT[=6379] · PF_CASA_RAIZ[=/opt/platafirma/current/casa] (personas em instancias/persona/*.md) · PF_CADEIRA (obrigatoria em enviar e em ler/status sem persona; porta) · PF_SESSAO (porta, so log)
# depende: modulo redis no venv; personas da casa nova (instancias/persona/*.md); rede ao loopback da malha
# le: status=malha
# le: ler=malha
# le: tratar=malha
# le: enviar=malha,arquivo-local
# le: tipos=nada
# le: contestar=malha,arquivo-local
# escreve: status=nada
# escreve: ler=malha
# escreve: tratar=malha
# escreve: enviar=malha
# escreve: tipos=nada
# escreve: contestar=malha
# (acesso: malha msg. `enviar` e `contestar` fazem XADD na caixa do destinatario e leem a persona dele em
#  abertura/<cadeira>/persona.md; `ler` quente move o ponteiro do grupo, e a carta fica pendurada; `tratar` faz
#  XACK; `status`, `tipos`, `ler` frio e `--penduradas` nao escrevem. A linha antiga, em prosa, nao tinha
#  `<ato>=` e o registro recusava o verbo inteiro: a fila nunca tinha entrado no registro do ferramental.)
# substitui: redis-cli XADD/XREADGROUP/XRANGE na caixa; o "cola a mensagem aqui" que a conduta do dono proibe
# conforme: parcial (spec_fila §6)
#
# Shim: o cabecalho canonico (proposito/capacidade/dono/use para/atos) mora AQUI,
# no binario que `conferir verbo`/`release conferir` leem, e nao so no modulo
# _fila/streams.py — os demais verbos da Onda 2 (mesa, tarefas, sessao) trazem o
# cabecalho no proprio binario servido; a fila, por ser shim, ficava sem. A regua
# do corpo continua em _fila/streams.py (fonte unica de comportamento).
import os
import runpy

runpy.run_path(os.path.join(os.path.dirname(os.path.realpath(__file__)), "_fila", "streams.py"), run_name="__main__")
