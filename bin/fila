#!/usr/bin/env bash
# fila — caixa de mensagens entre personas da PlataFirma.
# Uma caixa = um arquivo: fila/<persona>.md. Escrita é append sob flock.
# Leitura sai da mais nova para a mais antiga. Consumo remove o bloco e
# não deixa resto: caixa vazia é removida do disco.
set -euo pipefail

RAIZ="${FILA_RAIZ:-$HOME/AI/fila}"
ESPIA="claudinha-gestao-estrategica"

uso() {
  cat >&2 <<'EOF'
uso:
  fila status <persona>              quem mandou e quantas — sem conteudo
  fila status --todas                (so claudinha-gestao-estrategica)
  fila ler <persona> [remetente]     imprime as mensagens, mais nova em cima
  fila ler --todas [remetente]       (so claudinha-gestao-estrategica)
  fila consumir <persona> <id>...    remove os blocos processados
  fila consumir <persona> --de <remetente>
  fila consumir <persona> --todas
  fila enviar <destinatario> --de <remetente> --tipo <t> --assunto <a>
              [--ref <r>] [--responde <id>]      (corpo em stdin)
EOF
  exit 2
}

caixa() { printf '%s/%s.md\n' "$RAIZ" "$1"; }

personas_com_caixa() {
  find "$RAIZ" -maxdepth 1 -type f -name '*.md' -printf '%f\n' 2>/dev/null \
    | sed 's/\.md$//' | sort
}

valida_persona() {
  local p="$1" lista="$RAIZ/.personas"
  [[ -f "$lista" ]] || return 0
  grep -qxF "$p" "$lista" && return 0
  if [[ -f "$RAIZ/.encerradas/$p.md" ]]; then
    printf 'erro: caixa "%s" esta encerrada.\n\n' "$p" >&2
    cat "$RAIZ/.encerradas/$p.md" >&2
  else
    printf 'erro: persona "%s" nao esta em %s — caixa fantasma nao e lida por ninguem\n' "$p" "$lista" >&2
  fi
  return 1
}

# ---------- status ----------
cmd_status() {
  local alvo="${1-}"; [[ -n "$alvo" ]] || uso
  local personas
  if [[ "$alvo" == "--todas" ]]; then
    personas=$(personas_com_caixa)
  else
    valida_persona "$alvo" || exit 1
    personas="$alvo"
  fi
  local vazio=1
  while read -r p; do
    [[ -n "$p" ]] || continue
    local f; f=$(caixa "$p")
    [[ -s "$f" ]] || continue
    vazio=0
    local n; n=$(grep -c '^===MSG ' "$f")
    local por; por=$(grep '^===MSG ' "$f" \
      | sed -e 's/^===MSG [0-9T]*-//' -e 's/===$//' \
      | sort | uniq -c | awk '{printf "%s %s, ", $2, $1}' | sed 's/, $//')
    local antiga; antiga=$(grep -m1 '^===MSG ' "$f" | sed -e 's/^===MSG //' -e 's/-.*//')
    printf '%s: %s (%s) · mais antiga %s\n' "$p" "$n" "$por" "$antiga"
  done <<< "$personas"
  [[ $vazio -eq 1 ]] && echo "caixa vazia"
  return 0
}

# ---------- ler ----------
imprime() {
  local f="$1" remet="${2-}"
  awk -v remet="$remet" '
    /^===MSG /{
      n++; linha=$0
      sub(/^===MSG /,"",linha); sub(/===$/,"",linha)
      id[n]=linha
      de[n]=linha; sub(/^[^-]*-/,"",de[n])
      buf[n]=$0 "\n"; next
    }
    { if(n>0) buf[n]=buf[n] $0 "\n" }
    END{
      for(i=n;i>=1;i--){
        if(remet!="" && de[i]!=remet) continue
        b=buf[i]; sub(/\n+$/,"\n",b)
        printf "%s\n", b
      }
    }' "$f"
}

cmd_ler() {
  local alvo="${1-}"; [[ -n "$alvo" ]] || uso
  local remet="${2-}"
  local personas
  if [[ "$alvo" == "--todas" ]]; then
    personas=$(personas_com_caixa)
  else
    valida_persona "$alvo" || exit 1
    personas="$alvo"
  fi
  local vazio=1
  while read -r p; do
    [[ -n "$p" ]] || continue
    local f; f=$(caixa "$p")
    [[ -s "$f" ]] || continue
    local out; out=$(imprime "$f" "$remet")
    [[ -n "$out" ]] || continue
    vazio=0
    [[ "$alvo" == "--todas" ]] && printf '## caixa: %s\n\n' "$p"
    printf '%s\n' "$out"
  done <<< "$personas"
  [[ $vazio -eq 1 ]] && echo "nada a ler"
  return 0
}

# ---------- consumir ----------
cmd_consumir() {
  local p="${1-}"; shift || true
  [[ -n "$p" && $# -gt 0 ]] || uso
  valida_persona "$p" || exit 1
  local f; f=$(caixa "$p")
  [[ -s "$f" ]] || { echo "caixa vazia"; return 0; }

  local modo="ids" arg="" ids=""
  case "${1-}" in
    --todas) modo="todas" ;;
    --de)    modo="de"; arg="${2-}"; [[ -n "$arg" ]] || uso ;;
    *)       ids="$*" ;;
  esac

  exec 9>"$f.lock"
  flock 9
  local tmp; tmp=$(mktemp)
  awk -v modo="$modo" -v arg="$arg" -v ids=" $ids " '
    function corta(id,   de){
      if(modo=="todas") return 1
      de=id; sub(/^[^-]*-/,"",de)
      if(modo=="de")  return (de==arg)
      return (index(ids, " " id " ") > 0)
    }
    /^===MSG /{
      linha=$0; sub(/^===MSG /,"",linha); sub(/===$/,"",linha)
      cur=corta(linha); if(!cur) mantidos++
      if(cur) removidos++
    }
    { if(!cur) print }
    END{ printf("%d %d\n", removidos+0, mantidos+0) > "/dev/stderr" }
  ' "$f" > "$tmp" 2>"$tmp.cnt"

  # normaliza: sem linhas em branco no fim, uma newline final
  local limpo; limpo=$(mktemp)
  sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$limpo"

  if [[ -s "$limpo" ]]; then
    mv "$limpo" "$f"
  else
    rm -f "$f" "$limpo"
  fi
  rm -f "$tmp"
  local cnt; cnt=$(cat "$tmp.cnt"); rm -f "$tmp.cnt"
  flock -u 9; exec 9>&-; rm -f "$f.lock"
  printf 'consumidas %s, restam %s\n' "${cnt% *}" "${cnt#* }"
}

# ---------- enviar ----------
cmd_enviar() {
  local para="${1-}"; shift || true
  [[ -n "$para" ]] || uso
  local de="" tipo="" assunto="" ref="" responde=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --de)       de="${2-}"; shift 2 ;;
      --tipo)     tipo="${2-}"; shift 2 ;;
      --assunto)  assunto="${2-}"; shift 2 ;;
      --ref)      ref="${2-}"; shift 2 ;;
      --responde) responde="${2-}"; shift 2 ;;
      *) uso ;;
    esac
  done
  [[ -n "$de" && -n "$tipo" && -n "$assunto" ]] || uso
  valida_persona "$para" || exit 1
  valida_persona "$de" || exit 1
  case "$tipo" in
    decisao|resposta|pedido|minuta|demanda|handoff) ;;
    *) echo "erro: tipo invalido: $tipo" >&2; exit 1 ;;
  esac
  local corpo; corpo=$(cat)
  [[ -n "${corpo//[[:space:]]/}" ]] || { echo "erro: corpo vazio" >&2; exit 1; }
  if grep -q '^===MSG ' <<< "$corpo"; then
    echo "erro: corpo contem a sentinela '===MSG ' no inicio de linha" >&2; exit 1
  fi

  mkdir -p "$RAIZ"
  local f; f=$(caixa "$para")
  exec 9>"$f.lock"
  flock 9
  local seg=0 id
  while :; do
    id="$(date -d "+${seg} seconds" +%Y%m%dT%H%M%S)-$de"
    [[ -f "$f" ]] && grep -qF "===MSG $id===" "$f" || break
    seg=$((seg+1))
  done
  {
    printf '===MSG %s===\n' "$id"
    printf 'tipo: %s\n' "$tipo"
    printf 'assunto: %s\n' "$assunto"
    [[ -n "$ref" ]]      && printf 'ref: %s\n' "$ref"
    [[ -n "$responde" ]] && printf 'responde: %s\n' "$responde"
    printf '\n%s\n' "$corpo"
  } >> "$f"
  flock -u 9; exec 9>&-; rm -f "$f.lock"
  printf '%s\n' "$id"
}

case "${1-}" in
  status)   shift; cmd_status "$@" ;;
  ler)      shift; cmd_ler "$@" ;;
  consumir) shift; cmd_consumir "$@" ;;
  enviar)   shift; cmd_enviar "$@" ;;
  *) uso ;;
esac
