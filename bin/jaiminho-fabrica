#!/bin/bash
# capacidade: mensagem
# dono: claudinho-TI
#
# Segunda conta da fabrica, motor `agy` (org:0020). NAO e um verbo novo: e o mesmo
# `bin/jaiminho`, apontado por env para o container, a persona e o volume desta conta.
# Existe como arquivo proprio porque `chat` roteia participante por NOME do binario
# (VERBO_DO_PARTICIPANTE), e porque `jaiminho-fabrica perguntar` e o que a recepcao
# chama — ninguem deveria precisar lembrar de exportar tres variaveis para girar.
#
# Sub-atos: os mesmos de `jaiminho` — perguntar | continuar | estado | logs | login.
set -euo pipefail
RAIZ="${PF_RAIZ:-$HOME/AI}"
export PF_JAIMINHO_CONTAINER="jaiminho-fabrica"
# Daemon do braco desde o #2286: rootless da conta `jaiminho` (uid 1003). Declarado e
# nao adivinhado — sem isto o verbo pergunta ao daemon do `claudinho`, nao acha o
# container e sugere `up -d`, que sobe um SEGUNDO braco. `claudinho` nao tem sudo, entao
# hoje isto NAO da alcance: da a RECUSA CERTA, com o endereco de quem alcanca.
export PF_JAIMINHO_DOCKER_HOST="${PF_JAIMINHO_DOCKER_HOST:-unix:///run/user/1003/docker.sock}"
export PF_JAIMINHO_DAEMON_DONO="jaiminho (uid 1003), deploy em /srv/pf/agy/jaiminho-fabrica"
export PF_JAIMINHO_PERSONA="$RAIZ/platafirma-harness/personas/persona-jaiminho-fabrica.md"
export PF_JAIMINHO_TRABALHO="/home/jaiminho/trabalho"
exec "$RAIZ/platafirma-harness/bin/jaiminho" "$@"
