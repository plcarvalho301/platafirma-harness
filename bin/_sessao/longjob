#!/usr/bin/env bash
# longjob — dispara trabalho longo como unit transiente do systemd --user.
# capacidade: orfa
# orfa por design: entra em gerenciamento de memoria (F3d)
# dono: claudinho-TI
#
# A unit nasce IRMÃ do ops-mcp.service dentro do app.slice, não filha: fica fora
# do process group do run_command (imune ao os.killpg do timeout) e fora do
# cgroup do serviço (imune a `systemctl --user restart ops-mcp`).
#
# Cota: CPUWeight rebaixa o job contra o serving sob disputa (nao corta teto) e
# MemoryHigh poe pressao de reclaim antes de qualquer OOM. Sem MemoryMax por
# default: job longo legitimo nao pode passar a morrer por causa desta linha.
#
# Log vai para arquivo desde o primeiro byte: PYTHONUNBUFFERED=1 no ambiente da
# unit e StandardOutput/StandardError em append no mesmo arquivo. Job que morre
# no meio deixa o que já escreveu.
#
# Tudo o que o job grava de estado mora na instancia, nunca na pasta de onde foi
# chamado: log em $PLATAFIRMA_INSTANCIA/var/log/jobs e cwd da unit em
# $PLATAFIRMA_INSTANCIA/var/tmp/jobs/<unit>. Quem precisa rodar noutro diretorio o declara
# (LONGJOB_CWD) ou faz `cd` dentro do proprio comando. O PATH da unit e o da release.
set -euo pipefail

# bin/_sessao/longjob (card #3145): um nivel a mais que bin/, entao lib/ fica dois
# diretorios acima -- nao um.
. "$(dirname "$(readlink -f "$0")")/../../lib/raizes.sh"

LOGDIR="${LONGJOB_LOGDIR:-$PLATAFIRMA_INSTANCIA/var/log/jobs}"
mkdir -p "$LOGDIR"

uso() {
  cat >&2 <<'FIM'
uso: (contrato herdado -- invoque por `sessao longjob ...`, arq:0110 §14)
  sessao longjob run <nome> <comando> [args...]   dispara; devolve nome da unit e caminho do log
  sessao longjob list                             units platafirma-job-* ativas e falhadas
  sessao longjob logs                             arquivos de log mais recentes
  sessao longjob status <unit>                    estado da unit + últimas linhas do log; unit já coletada lê o evento de fim
  sessao longjob log <unit> [n]                   últimas n linhas do log (default 40)
  sessao longjob stop <unit>                      encerra a unit
FIM
  exit 2
}

cmd="${1:-}"; shift || uso

case "$cmd" in
  run)
    [ $# -ge 2 ] || uso
    nome="$1"; shift
    unit="platafirma-job-${nome}-$(date +%Y%m%dT%H%M%S)"
    log="$LOGDIR/${unit}.log"
    cwd="${LONGJOB_CWD:-$PLATAFIRMA_INSTANCIA/var/tmp/jobs/$unit}"
    mkdir -p "$cwd"
    : > "$log"
    # Identidade da porta (mesa ti #21): o systemd --user nao herda o ambiente de quem
    # chama, entao PF_SUJEITO e o resto da identidade injetada pela porta nao chegavam a
    # unit, e verbo que exige identidade (infra up, migrar aplicar) recusava com
    # «PF_SUJEITO ausente». Repassa so as variaveis presentes; ausente segue ausente (o
    # verbo do job decide, sem fallback aqui).
    # Atributos do agente (card #3156, spec agente §11.1): `sessao longjob` os le da chave viva e
    # os poe no ambiente antes do exec; aqui so seguem adiante e entram no cabecalho do log, que e
    # onde a trilha do segundo plano diz quem agiu, por qual agente e em nome de que cadeira.
    ident=()
    for v in PF_SUJEITO PF_CADEIRA PF_SESSAO PF_ORDEM_ID PF_SUPERFICIE \
             PF_AGENTE PF_EM_NOME_DE PF_CONTA_AGENTE PF_ORIGEM_SESSAO; do
      if [ -n "${!v:-}" ]; then ident+=("--setenv=$v=${!v}"); fi
    done
    printf '# unit=%s\n# inicio=%s\n# cwd=%s\n# sujeito=%s\n' \
      "$unit" "$(date -Is)" "$cwd" "${PF_SUJEITO:-(ausente)}" >> "$log"
    if [ -n "${PF_AGENTE:-}" ]; then
      printf '# agente=%s\n# em_nome_de=%s\n# origem=%s\n# conta=%s\n' \
        "$PF_AGENTE" "${PF_EM_NOME_DE:-(ausente)}" "${PF_ORIGEM_SESSAO:-(ausente)}" \
        "${PF_CONTA_AGENTE:-(ausente)}" >> "$log"
    fi
    printf '# comando=%s\n' "$*" >> "$log"
    systemd-run --user --unit="$unit" --quiet \
      "${ident[@]}" \
      --property=WorkingDirectory="$cwd" \
      --property=StandardOutput="append:$log" \
      --property=StandardError="append:$log" \
      --property=SyslogIdentifier="$unit" \
      --property=CPUWeight="${LONGJOB_CPU_PESO:-50}" \
      --property=MemoryHigh="${LONGJOB_MEM_ALTA:-16G}" \
      --setenv=PATH="$PLATAFIRMA_RELEASE/harness/bin:$PATH" \
      --setenv=PYTHONUNBUFFERED=1 \
      -- "$@"
    echo "unit: $unit"
    echo "log:  $log"
    ;;
  list)
    # só units, uma por linha, 1ª coluna = nome parseável.
    # systemctl prefixa unit falhada com '●'; tira, senão a 1ª coluna não é nome de unit.
    systemctl --user list-units 'platafirma-job-*' --all --no-legend --no-pager \
      | sed 's/^[^[:alnum:]]*//' || true
    ;;
  logs)
    ls -1t "$LOGDIR" 2>/dev/null | head -20 || true
    ;;
  status)
    [ $# -ge 1 ] || uso
    unit="$1"
    base="${unit%.service}"
    carga="$(systemctl --user show "$unit" -p LoadState --value 2>/dev/null || true)"
    if [ "$carga" = "not-found" ]; then
      # A unit já saiu: a limpeza de fóssil a tirou da lista (`infra limpeza fossil`, card #3920) ou o systemd a descarregou.
      # `systemctl show` de unit descarregada devolve os valores padrão, e o padrão é Result=success com status 0: um
      # job que falhou leria verde (medido no #3100). O que a unit sabia está no evento de fim, a linha `# fim=<ts>
      # result=<Result> status=<ExecMainStatus>` que a limpeza grava no log do job antes de tirá-la (decisão do dono,
      # #3103). Sem a linha, o resultado não se sabe e o status diz isso: nunca success.
      fim="$(grep '^# fim=' "$LOGDIR/${base}.log" 2>/dev/null | tail -n 1 || true)"
      echo "Id=$unit"
      echo "LoadState=not-found (coletada)"
      if [ -n "$fim" ]; then
        quando="$(printf '%s\n' "$fim" | sed -n 's/^# fim=\([^ ]*\) .*/\1/p')"
        resultado="$(printf '%s\n' "$fim" | sed -n 's/.* result=\([^ ]*\).*/\1/p')"
        codigo="$(printf '%s\n' "$fim" | sed -n 's/.* status=\([^ ]*\).*/\1/p')"
        echo "Result=${resultado:-desconhecido}"
        echo "ExecMainStatus=${codigo:-desconhecido}"
        echo "Fim=${quando:-desconhecido} (lido do evento de fim no log do job)"
      else
        echo "Result=desconhecido"
        echo "ExecMainStatus=desconhecido"
        echo "(coletada sem evento de fim: o resultado do job não se sabe)"
      fi
    else
      systemctl --user show "$unit" \
        -p Id -p SubState -p Result -p ExecMainPID -p ExecMainStatus \
        -p ActiveEnterTimestamp -p ControlGroup 2>&1 || true
    fi
    echo "--- log ---"
    tail -n 20 "$LOGDIR/${base}.log" 2>/dev/null || echo "(sem log)"
    ;;
  log)
    [ $# -ge 1 ] || uso
    tail -n "${2:-40}" "$LOGDIR/${1}.log"
    ;;
  stop)
    [ $# -ge 1 ] || uso
    systemctl --user stop "$1"
    ;;
  *) uso ;;
esac
