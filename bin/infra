#!/usr/bin/env bash
# infra — estado e operação da infraestrutura local: contêiner, unit, timer,
# stack (compose) e a agenda do cron.
# capacidade: infra
# dono: ti
# componente: docker, systemd --user, cron
# use para: ver contêiner/unit/timer de pé e a saúde da porta, "está no ar?" (estado,
#   saude, logs), reiniciar contêiner/unit e (re)criar a stack por compose (restart,
#   up, down, pull, build), tirar contêiner avulso ou unit que ficou fora do declarado
#   (remover), convergir a agenda do cron e as units da instância (units) e podar log/quarentena/job falhado por
#   retenção declarada (agenda, limpeza), liberar cache de VRAM e disco (cache), que
#   hardware é este e quanto consome em W agora (hardware), a GPU ao vivo: uso, VRAM,
#   temperatura, W e processos (gpu), o teto de processos e threads da conta contra o uso agora (limites), copiar o ingress versionado do túnel para a cópia da
#   instância, que é a que o cloudflared lê, e reiniciá-lo (ingress), medir a rede do host: as conexões dos três túneis com a borda e a porta pelo endereço público (medir rede),
#   medir a memória do host: uso real, cache, total, pressão, quem consome e as mortes por limite (medir ram) e tirar o fóssil que as rodadas deixam, contêiner sem label de projeto e job falhado (limpeza fossil)
# atos: estado (leitura, operacao), saude (leitura, operacao), logs (leitura, operacao), restart (escrita, operacao), remover (escrita, operacao), unit-env (escrita, operacao), cache (escrita, operacao), hardware (leitura, operacao), limites (leitura, operacao), gpu (leitura, operacao), backup (leitura, operacao), up (escrita, operacao), down (escrita, operacao), ps (leitura, operacao), config (leitura, operacao), pull (escrita, operacao), build (escrita, operacao), limpeza (escrita, operacao), agenda (escrita, operacao), units (escrita, operacao), ingress (escrita, operacao), medir (leitura, operacao)
# forma: log
# cauda: sim
# classe: B
# consome: porta@ops-log
# ambiente: DOCKER_HOST[=unix:///run/user/<uid>/docker.sock] porta · XDG_RUNTIME_DIR[=/run/user/<uid>] porta · DBUS_SESSION_BUS_ADDRESS[=unix:path=$XDG_RUNTIME_DIR/bus] porta (os dois só quando ausentes) · INFRA_OPS_HEALTH[=http://127.0.0.1:8010/health] porta · INFRA_RAPL[=/sys/class/powercap/intel-rapl:0/energy_uj] porta · INFRA_CPUINFO[=/proc/cpuinfo] porta · INFRA_MEMINFO[=/proc/meminfo] porta · INFRA_PRESSAO_MEMORIA[=/proc/pressure/memory] porta (medir ram) · INFRA_SLICE_EVENTS[=memory.events do slice da conta] porta (medir ram) · INFRA_FOSSIL_IDADE_H[=24] porta (limpeza fossil: horas de vida do contêiner sem label de projeto) · LONGJOB_LOGDIR[=$PLATAFIRMA_INSTANCIA/var/log/jobs] porta (limpeza fossil: onde o evento de fim do job é gravado) · INFRA_UNIT_AUTO[=ops-mcp] porta · INFRA_BACKUPS[=$AQUI/../registro/backups.json] porta · INFRA_CRONTAB_SCRIPT[=$PLATAFIRMA_RELEASE/core/deploy/instala-crontab.sh] porta · INFRA_UNITS_SCRIPT[=$PLATAFIRMA_RELEASE/core/deploy/instala-units.sh] porta · INFRA_INGRESS_FONTE[=$PLATAFIRMA_RELEASE/core/deploy/cloudflared-config.yml] porta · INFRA_INGRESS_COPIA[=$PLATAFIRMA_INSTANCIA/deploy/core/cloudflared.yml] porta · INFRA_INGRESS_CONTEINER[=platafirma-core-cloudflared-1] porta · INFRA_INGRESS_ESPERA[=5] porta (ingress: segundos até conferir o contêiner de pé) · OPS_LOG_DIR[=$PLATAFIRMA_INSTANCIA/var/log/ops] porta (saude: lido por lib/oplog, o bruto contra o teto) · PF_SUJEITO[obrigatória em up|down|pull|build] porta (sem fallback; entra na linha de log do ato quando presente) · PLATAFIRMA_INSTANCIA, PF_RELEASE_RAIZ, PLATAFIRMA_RELEASE (lib/raizes.sh)
# depende: docker · systemctl --user · curl · diff (ingress) · jq (cache) · nvidia-smi (cache ver, hardware, gpu) · ps (limites) · python3 · lib/oplog (saude: `python3 -m oplog teto`, o bruto contra o teto do corte) · bin/_release/stack (ajudante de up/down/ps/config/pull/build, ao lado deste bin) · bin/_infra/limpeza-logs, bin/_infra/limpeza-quarentena e bin/_infra/limpeza-fossil (ajudantes de limpeza) · bin/_infra/medir-rede, bin/_infra/medir-ram e bin/_infra/eixos.py (medir rede, medir ram) · journalctl --user (medir ram: a morte por limite das units) · bin/sinal (medir rede: a medida da porta) · o script declarado em INFRA_CRONTAB_SCRIPT (agenda) · o script declarado em INFRA_UNITS_SCRIPT (units)
# escreve: restart=contêiner/unit reiniciado (efeito, não arquivo) · remover=contêiner avulso removido (a inspeção dele guardada antes em var/log/infra/removidos), unit transitória tirada da lista (reset-failed) ou unit da conta parada, desabilitada e com o arquivo movido para var/quarentena · unit-env=drop-in systemd ($HOME/.config/systemd/user/<unit>.service.d/zz-infra-env.conf) · cache=VRAM descarregada e cache local podado (vram, disco) · up/down/pull/build=contêineres e imagens da stack, via bin/_release/stack · limpeza=arquivos de log/quarentena da instância apagados; fossil=contêiner sem label de projeto removido (logs e inspeção guardados antes em var/log/infra/removidos) e unit platafirma-job-* falha tirada da lista (reset-failed) depois do evento de fim gravado no log do job · agenda=crontab do sistema (aplicar) · units=symlink das units da instância em ~/.local/share/systemd/user e daemon-reload (aplicar) · ingress=cópia da instância do ingress do túnel (deploy/core/cloudflared.yml, com a anterior ao lado em .anterior) e reinício do contêiner cloudflared · estado/saude/logs/ps/config/backup/hardware/limites/gpu/medir=nada
# substitui: docker ps/restart/logs direto · systemctl --user status/restart/cat direto · deploy <stack> up|down|ps|config|pull|build (deploy apagado — decisão do dono, 27/09) · crontab -e a mão · cp à mão do ingress versionado para deploy/core/cloudflared.yml da instância + docker restart do cloudflared · ops-log-prune e quarentena-prune (movidos para bin/_infra/, atos de infra por arq:0110 §14 emenda 26/09/2026)
# face: medir=Operação
# rotulo: medir --rede=Medir rede
# rotulo: medir --ram=Medir RAM
# volta: medir --rede=sim — só lê
# volta: medir --ram=sim — só lê
# face: limpeza=Operação
# rotulo: limpeza --fossil=Limpar o fóssil do host
# volta: limpeza --fossil=nao
# (face, rotulo e volta: arq:0124 §3, cards #3919 e #3920. Um ato único, `medir <eixo>`, e o eixo é o modo: a chave
#  `medir --ram` declara o `infra medir ram`, e o #3921 acrescenta vram e cpu. O `infra` mede e não grava a série: quem a
#  grava é a sonda, pela `metrica`. A limpeza de fóssil não volta: o contêiner removido não se recria, e do job tirado da
#  lista fica o evento de fim no log do job, não a unit (decisão do dono, 19/10/2026, #3103). logs, quarentena e jobs
#  não declaram texto de controle.)
# Encapsula as três pegadinhas conhecidas: DOCKER_HOST rootless, restart que
# mata a própria chamada, e alvo que pode ser contêiner ou unit de usuário.
set -euo pipefail

AQUI="$(dirname "$(readlink -f "$0")")"
. "$AQUI/../lib/raizes.sh"

STACK_AJUDANTE="$AQUI/_release/stack"
LIMPEZA_LOGS="$AQUI/_infra/limpeza-logs"
LIMPEZA_QUARENTENA="$AQUI/_infra/limpeza-quarentena"
LIMPEZA_FOSSIL="$AQUI/_infra/limpeza-fossil"
MEDIR_REDE="$AQUI/_infra/medir-rede"
MEDIR_RAM="$AQUI/_infra/medir-ram"
CRONTAB_SCRIPT="${INFRA_CRONTAB_SCRIPT:-$PLATAFIRMA_RELEASE/core/deploy/instala-crontab.sh}"
UNITS_SCRIPT="${INFRA_UNITS_SCRIPT:-$PLATAFIRMA_RELEASE/core/deploy/instala-units.sh}"

export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/$(id -u)/docker.sock}"
# systemctl --user e systemd-run --user falam com o bus da conta. Pelo wrapper, runuser, cron
# ou pelo release, o ambiente chega sem XDG_RUNTIME_DIR: `systemctl --user cat` sai 1 com
# 'Failed to connect to bus', a unit não é achada e o restart não acontece (medido 15/09).
# Os dois só são definidos quando ausentes; valor que já veio no ambiente vence — salvo o
# herdado de OUTRA conta (runuser/su sem -l levam o XDG de quem chamou, ex. /run/user/0, onde
# esta conta não entra): diretório que existe e não é desta conta é trocado, e o DBUS que
# aponta para dentro dele sai junto.
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ ! -O "$XDG_RUNTIME_DIR" ]; then
  case "${DBUS_SESSION_BUS_ADDRESS:-}" in *"$XDG_RUNTIME_DIR"*) unset DBUS_SESSION_BUS_ADDRESS ;; esac
  unset XDG_RUNTIME_DIR
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
OPS_HEALTH="${INFRA_OPS_HEALTH:-http://127.0.0.1:8010/health}"

uso_texto() {
  cat >&2 <<'FIM'
uso:
  infra estado   [alvo] [--json]                contêineres, units de usuário e timers, uma tela
  infra saude    [alvo] [--json]                 /health do ops, contêiner não-saudável, disco, RAM, o bruto contra o teto
  infra logs     <alvo> [n]                      alvo = contêiner OU unit --user (default 50)
  infra restart  <alvo> [--nao-esperar]          contêiner ou unit --user; confere antes de dizer ok
  infra remover  <alvo> [--ver]                  tira contêiner avulso ou unit --user fora do declarado; --ver só mostra
  infra unit-env <unit> [--ver | CHAVE=VALOR...] drop-in de ambiente da unit --user (daemon-reload)
  infra cache    [ver|vram|disco]                o que ocupa VRAM e disco; liberar é explícito
  infra hardware [--json]                        CPU, RAM, GPU e consumo em W agora; a fonte (PSU) não se lê
  infra limites  [--amostrar <s>]                teto de processos e threads da conta e a memória, lidos juntos; --amostrar dá o pico em <s> segundos
  infra gpu      [--json]                        GPU ao vivo: uso, VRAM, temperatura, W e processos
  infra backup   [--json]                        por alvo declarado: quando rodou, gerações
  infra up       <stack> [args compose…] [<serviço>…]  bin/_release/stack compose … up
  infra down     <stack> [args compose…] [<serviço>…]  … down
  infra ps       <stack> [args compose…] [<serviço>…]  … ps
  infra config   <stack> [args compose…] [<serviço>…]  … config
  infra pull     <stack> [args compose…] [<serviço>…]  … pull
  infra build    <stack> [args compose…] [<serviço>…]  … build
  infra limpeza  logs|quarentena|jobs|fossil [args…] despacha para bin/_infra/limpeza-{logs,quarentena,fossil}; jobs é o fossil só de job
  infra limpeza  fossil [--ver] [--so-jobs] [--dias N]  tira contêiner sem label de projeto com mais de 24 h e unit platafirma-job-* em failed; --ver só lista
  infra agenda   conferir|aplicar                convergência do crontab (instala-crontab.sh)
  infra units    conferir|aplicar                convergência das units da instância (instala-units.sh)
  infra ingress  [--ver]                         copia o ingress versionado do túnel para a cópia da instância e reinicia o cloudflared
  infra medir    rede [--json]                   a rede do host: conexões dos três túneis com a borda, reconexões e a porta por fora; só lê
  infra medir    ram [--json] [--janela <s>]     a memória do host: uso real, cache e total à parte, pressão, quem consome e as mortes por limite; só lê

Leitura aceita alvo opcional; sem alvo, olha tudo. Mutação exige alvo explícito.
remover recusa (4) contêiner de stack compose (é infra down), unit declarada no core ou
no harness e unit fora de ~/.config/systemd/user; guarda a inspeção do contêiner antes
de removê-lo e move o arquivo da unit para a quarentena, de onde volta com mv.
up, down, pull, build e remover exigem identidade: variável PF_SUJEITO (sem fallback; a
porta a injeta pelo fluxo OAuth). agenda conferir roda com --check (0 igual, 1
divergente); agenda aplicar aplica de fato. units conferir|aplicar, o mesmo para as units
systemd --user declaradas em deploy/units-da-instancia.json do core (symlink e daemon-reload). Ajudante de compose localizado ao
lado deste script (bin/_release/stack), nunca pelo PATH.
ingress mostra a diferença entre o ingress versionado do core (release no ar) e a cópia da instância
(deploy/core/cloudflared.yml, a que o contêiner lê) e, sem --ver, grava a cópia e reinicia o contêiner
cloudflared. --ver só mostra: 0 igual, 1 divergente. Cópia já igual: nada gravado, nada reiniciado.

exit: tabela arq:0110 §4 — 0 ok · 1 negativo de mérito (alvo/stack inexistente,
      agenda divergente) · 2 uso · 3 dependência ausente (docker, systemctl,
      ajudante, PF_SUJEITO) · 4 política/trava · 5 indeterminável
FIM
}

uso() {
  uso_texto
  exit 2
}

# `infra medir <eixo> --help`: o ato de eixo declara no cabeçalho e repete aqui a face, o rótulo e a volta (spec
# eixos-do-host R1). Sai 0: pedir ajuda não é erro de uso.
ajuda_medir_rede() {
  cat <<'FIM'
uso: infra medir rede [--json]

Mede a rede do host: as conexões de cada um dos três túneis (ops, recuperacao, wiki) com a borda da Cloudflare, as
reconexões desde a partida do processo e, no ops, a porta pelo endereço público ao lado do tempo que ela mesma registrou.
Sai o JSON do eixo (--json) ou a frase gerada dele. Só lê: não grava série e não reinicia túnel. Medida não reprova: o
número, por alto que seja, sai 0.

face: Operação
rotulo: Medir rede
volta: sim — só lê

exit: 0 lido · 2 uso · 3 dependência ausente · 5 não consegui olhar (a fonte não respondeu; o JSON diz qual)
FIM
}

ajuda_medir_ram() {
  cat <<'FIM'
uso: infra medir ram [--json] [--janela <segundos>]

Mede a memória do host: o uso real (o que o kernel não devolve), o cache que ele devolve e o total da máquina, cada um
em campo próprio e nunca somados, a pressão de memória do kernel (10, 60 e 300 s), os maiores consumidores pela chave de
serviço <stack>/<serviço> (o que não resolve sai como desvio) e as mortes por limite na janela (1 h por padrão). Sai o JSON
do eixo (--json) ou a frase gerada dele. Só lê: não grava série. Medida não reprova: o número, por alto que seja, sai 0.

face: Operação
rotulo: Medir RAM
volta: sim — só lê

exit: 0 lido · 2 uso · 3 dependência ausente · 5 não consegui olhar (a fonte não respondeu; o JSON diz qual)
FIM
}

# A ajuda do eixo pedido; sem eixo (`infra medir --help`), a de todos.
ajuda_medir() {
  case "${1:-}" in
    rede) ajuda_medir_rede ;;
    ram) ajuda_medir_ram ;;
    *) ajuda_medir_rede; echo; ajuda_medir_ram ;;
  esac
}

# Identidade (decisão 9, card #3145): só PF_SUJEITO, sem fallback para PF_CADEIRA/USER.
# Exigida em up/down/pull/build; ausente = exit 3 com a cura. Presente, entra na linha
# de status do ato (rastreio de quem pediu a operação).
exigir_sujeito() {  # $1=rótulo do ato, só para a mensagem
  if [ -z "${PF_SUJEITO:-}" ]; then
    printf 'infra: erro: variável PF_SUJEITO: ausente — %s exige identidade; rode dentro da sessão (a porta a injeta pelo fluxo OAuth)\n' "$1" >&2
    return 3
  fi
  return 0
}

# --- leituras elementares ---------------------------------------------------

conteineres()      { docker ps --format '{{.Names}}\t{{.Status}}' | sort; }
conteineres_doentes() {
  docker ps -a --format '{{.Names}}\t{{.Status}}' \
    | grep -Ei 'exited|unhealthy|restarting' || echo "(nenhum)"
}
units_vivas() {
  systemctl --user list-units --type=service --state=running,failed \
    --no-pager --no-legend | sed 's/^[●*] *//' | awk '{print $1"\t"$4}'
}
units_falhadas()   { systemctl --user list-units --state=failed --no-pager --no-legend || true; }
timers()           { systemctl --user list-timers --no-pager --no-legend | awk '{print $NF"\t"$1,$2,$3}'; }
e_conteiner()      { docker ps -a --format '{{.Names}}' | grep -qx "$1"; }
e_unit()           { systemctl --user cat -- "$1" >/dev/null 2>&1; }

# --- apoio a --json -----------------------------------------------------
#
# card #390 lote 1: `estado`/`saude` ganham --json sem mudar a saida de texto.
# Regra: stdout so leva o JSON quando --json esta presente, diagnostico vai
# para stderr, e falha de coleta vira {"erro": motivo} em vez de estourar --
# a chamada preserva o exit code que a coleta ja tinha (nunca stdout vazio,
# nunca sucesso com zero fake). Escolha deliberada: systemctl e lido sempre
# pela saida tabular (a mesma fonte que o modo texto ja usa e ja confere) --
# nao tentamos `--output=json` do systemd aqui porque esta maquina de
# desenvolvimento nao tem systemd nenhum para validar o esquema de campos, e
# arriscar um nome de campo errado sem forma de testar e pior que a saida
# tabular, que ja e o dado provado. Fica registrado como fallback declarado,
# nao omissao (ver NOTAS-390.md, secao "ambiente de desenvolvimento local").

# Roda $1 (uma das funcoes _*_json abaixo) capturando o stdout dela (que ja
# e o JSON pronto) e o stderr (diagnostico, sempre repassado). Se a funcao
# falhar de verdade (docker/systemctl fora do ar, saida ilegivel mesmo depois
# do fallback tabular) imprime {"erro": motivo} em vez de deixar o script
# estourar, com o mesmo exit code que a coleta teria dado.
_json_ou_erro() {
  local fn="$1"; shift
  local tmp_err saida rc=0
  tmp_err=$(mktemp)
  if saida=$("$fn" "$@" 2>"$tmp_err"); then
    rc=0
  else
    rc=$?
  fi
  cat "$tmp_err" >&2
  if [ "$rc" -ne 0 ]; then
    local motivo
    motivo=$(tail -n 1 "$tmp_err")
    [ -n "$motivo" ] || motivo="$fn falhou (exit $rc)"
    rm -f "$tmp_err"
    python3 -c 'import json, sys; print(json.dumps({"erro": sys.argv[1]}))' "$motivo"
    return "$rc"
  fi
  rm -f "$tmp_err"
  printf '%s\n' "$saida"
}

# Contêineres estruturados a partir de `docker ps -a --format {{json .}}`
# (uma linha JSON por contêiner) — separa o campo Status do docker em
# "desde" (o "Up 3 days"/"Exited (0) 2 hours ago") e "saude" (o parêntese
# final, só quando ele é mesmo saúde — "Exited (0) ..." não tem parêntese no
# fim da string, então não vira saude por engano). $1 opcional filtra por nome.
_conteineres_json() {
  local alvo="${1:-}"
  docker ps -a --format '{{json .}}' | python3 -c '
import json, re, sys

alvo = sys.argv[1]

def separa(status):
    status = status or ""
    m = re.search(r"\(([^()]*)\)\s*$", status)
    if not m:
        return (status.strip() or None), None
    return (status[:m.start()].strip() or None), m.group(1)

itens = []
for linha in sys.stdin:
    linha = linha.strip()
    if not linha:
        continue
    d = json.loads(linha)
    nome = d.get("Names")
    if alvo and nome != alvo:
        continue
    desde, saude = separa(d.get("Status"))
    itens.append({"nome": nome, "estado_docker": d.get("State"), "saude": saude, "desde": desde})
print(json.dumps(itens))
' "$alvo"
}

# Contêiner parado ou não-saudável — mesmo critério textual de
# conteineres_doentes() (exited/unhealthy/restarting no Status), estruturado.
# Lista vazia é o "nenhum" honesto (nunca a sentinela de texto "(nenhum)").
_doentes_json() {
  docker ps -a --format '{{json .}}' | python3 -c '
import json, sys

itens = []
for linha in sys.stdin:
    linha = linha.strip()
    if not linha:
        continue
    d = json.loads(linha)
    status = d.get("Status") or ""
    if any(p in status.lower() for p in ("exited", "unhealthy", "restarting")):
        itens.append({"nome": d.get("Names"), "status": status})
print(json.dumps(itens))
'
}

# units_vivas() já devolve "nome\testado" (UNIT / SUB de systemctl list-units);
# aqui só embrulha em JSON. $1 opcional filtra por nome.
_units_json() {
  local alvo="${1:-}"
  units_vivas | python3 -c '
import json, sys

alvo = sys.argv[1]
itens = []
for l in sys.stdin:
    l = l.rstrip("\n")
    if not l:
        continue
    p = l.split("\t")
    nome = p[0] if p else None
    if alvo and nome != alvo:
        continue
    itens.append({"nome": nome, "estado": p[1] if len(p) > 1 else None})
print(json.dumps(itens))
' "$alvo"
}

# units_falhadas() é tabular "cru" (UNIT LOAD ACTIVE SUB DESCRIPTION) e já
# engole falha do systemctl com `|| true` — herdado, não é desta mudança.
_falhadas_json() {
  units_falhadas | python3 -c '
import json, sys

itens = []
for l in sys.stdin:
    l = l.rstrip("\n")
    if not l.strip():
        continue
    p = l.split()
    itens.append({"nome": p[0] if len(p) > 0 else None, "estado": p[3] if len(p) > 3 else None})
print(json.dumps(itens))
'
}

# timers() já devolve "nome\tproxima_execucao" (ACTIVATES / NEXT de systemctl
# list-timers); aqui só embrulha em JSON. $1 opcional filtra por nome.
_timers_json() {
  local alvo="${1:-}"
  timers | python3 -c '
import json, sys

alvo = sys.argv[1]
itens = []
for l in sys.stdin:
    l = l.rstrip("\n")
    if not l:
        continue
    p = l.split("\t")
    nome = p[0] if p else None
    if alvo and nome != alvo:
        continue
    itens.append({"nome": nome, "proxima_execucao": p[1] if len(p) > 1 else None})
print(json.dumps(itens))
' "$alvo"
}

# /health do ops: indisponibilidade é dado (motivo preenchido), não erro de
# execução do infra — por isso curl que falha aqui NÃO vira {"erro":...}.
_ops_health_json() {
  local rc=0
  curl -sf --max-time 5 "$OPS_HEALTH" >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    python3 -c 'import json; print(json.dumps({"ok": True, "motivo": None}))'
  else
    python3 -c 'import json, sys; print(json.dumps({"ok": False, "motivo": "sem resposta de " + sys.argv[1]}))' "$OPS_HEALTH"
  fi
}

# `df -h /` tem 6 colunas na linha de dado (Mounted on conta como uma só,
# o caminho não tem espaço). Estrutura crua — sem converter unidade humana.
_disco_json() {
  df -h / | tail -1 | python3 -c '
import json, sys

chaves = ["sistema_arquivos", "tamanho", "usado", "disponivel", "uso_pct", "montado_em"]
partes = sys.stdin.read().split()
print(json.dumps(dict(zip(chaves, partes))))
'
}

# `free -h` linha 2 é "Mem:" + 6 valores — descarta o rótulo, mantém a
# unidade humana (a mesma fonte que o texto já usa, só estruturada).
_memoria_json() {
  free -h | sed -n 2p | python3 -c '
import json, sys

chaves = ["total", "usado", "livre", "compartilhado", "buffer_cache", "disponivel"]
partes = sys.stdin.read().split()[1:]
print(json.dumps(dict(zip(chaves, partes))))
'
}

# O bruto da porta contra o teto (card #3354, arq:0123 regra 10): a mediana de bytes por dia das quatro semanas
# anteriores x 35 x 1,5. Quem le o bruto e o lib/oplog (`python3 -m oplog teto`); aqui so se pergunta. Estado:
# dentro, acima, sem_base (poucos dias para medir) ou indeterminavel. Sondagem que falha nao derruba a saude: vira
# estado, dado e nao erro de execucao, como o /health do ops. Acima do teto vira CARD, nao incidente.
_bruto_json() {
  local saida rc=0 motivo
  saida=$(PYTHONPATH="$AQUI/../lib${PYTHONPATH:+:$PYTHONPATH}" python3 -m oplog teto 2>/dev/null) || rc=$?
  if [ "$rc" -eq 0 ]; then
    if saida=$(python3 -c 'import json, sys; print(json.dumps(json.loads(sys.argv[1])))' "$saida" 2>/dev/null); then
      printf '%s\n' "$saida"
      return 0
    fi
    motivo="oplog teto devolveu resposta ilegível"
  else
    motivo="oplog teto saiu $rc"
  fi
  python3 -c 'import json, sys; print(json.dumps({"estado": "indeterminavel", "motivo": sys.argv[1]}))' "$motivo"
}

_bruto_texto() {
  _bruto_json | python3 -c '
import json, sys


def mb(n):
    return "-" if n is None else "%.1f MB" % (n / 1048576)


def texto(d):
    if d.get("estado") == "indeterminavel":
        return "bruto: não medido (%s)" % d.get("motivo", "?")
    if d["estado"] == "sem_base":
        return ("bruto: %s em %d dia(s); sem base para o teto (%d dia(s) nas quatro semanas anteriores)"
                % (mb(d["bytes"]), d["dias_no_disco"], d["dias_na_base"]))
    base = "bruto: %s em %d dia(s) · teto %s (mediana %s/dia x 35 x 1,5)" % (
        mb(d["bytes"]), d["dias_no_disco"], mb(d["teto_bytes"]), mb(d["mediana_bytes_dia"]))
    if d["estado"] == "acima":
        return ("ACIMA DO TETO — " + base + " — o corte está atrasado ou não corta: abra card (não é incidente) "
                "e leia `infra logs corte-bruto`")
    return base + " — dentro"


# resposta torta da sondagem e dado, nao erro: a saude segue inteira (card #3354)
try:
    print(texto(json.load(sys.stdin)))
except (AttributeError, KeyError, TypeError, ValueError):
    print("bruto: não medido (resposta fora do formato)")
'
}

# --- verbos -----------------------------------------------------------------

_estado_texto() {
  local alvo="${1:-}"
  if [ -n "$alvo" ]; then
    e_conteiner "$alvo" && { docker ps -a --format '{{.Names}}\t{{.Status}}' | grep -E "^$alvo\\s" || echo "$alvo: não está em execução"; return; }
    e_unit "$alvo" || { echo "$alvo: sem contêiner (parado ou removido) e sem unit de usuário com esse nome"; return; }
    systemctl --user status "$alvo" --no-pager -n 0 || true
    return
  fi
  echo "== contêineres";                        conteineres
  echo; echo "== units de usuário (ativas e falhadas)"; units_vivas
  echo; echo "== timers";                       timers
}

# {"conteineres":[...], "units":[...], "timers":[...]} — mesmas três seções
# do texto, só estruturadas. Com alvo, filtra as três listas por nome (0 ou 1
# item cada); é uma forma diferente do alvo em modo texto (que faz uma
# consulta pontual via `docker ps`/`systemctl status`), mas o card não define
# um formato próprio para essa combinação e o agregador (lote 2) só chama
# `infra estado --json` sem alvo — suposição registrada no relatório da tarefa.
#
# Nota sobre o `|| return $?` em cada passo: `_json_ou_erro` testa esta função
# num `if saida=$(...); then` — e bash suspende `errexit` para toda a árvore
# de chamadas dentro do comando testado por `if`/`&&`/`||`, não só para o
# comando testado em si (é comportamento documentado do bash, não bug desta
# implementação). Sem o `|| return $?` explícito aqui, uma falha do docker no
# primeiro passo passaria despercebida e a função terminaria "com sucesso"
# no último passo, escondendo a falha real — por isso cada passo se checa na
# mão em vez de confiar em `set -e` propagar sozinho por este caminho.
_estado_json_corpo() {
  local alvo="${1:-}"
  local c u t
  c=$(_conteineres_json "$alvo") || return $?
  u=$(_units_json "$alvo") || return $?
  t=$(_timers_json "$alvo") || return $?
  python3 -c '
import json, sys

c, u, t = (json.loads(a) for a in sys.argv[1:4])
print(json.dumps({"conteineres": c, "units": u, "timers": t}))
' "$c" "$u" "$t" || return $?
}

_estado_json() { _json_ou_erro _estado_json_corpo "${1:-}"; }

estado() {
  local alvo="" json=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      *) [ -z "$alvo" ] && alvo="$a" ;;
    esac
  done
  if [ "$json" = 1 ]; then
    _estado_json "$alvo"
  else
    _estado_texto "$alvo"
  fi
}

_saude_texto() {
  echo -n "ops-mcp /health: "
  curl -sf --max-time 5 "$OPS_HEALTH" || echo "SEM RESPOSTA"
  echo; echo "== contêiner parado ou não-saudável"; conteineres_doentes
  echo; echo "== unit falhada";                     units_falhadas
  echo; echo "== disco e memória"
  df -h / | tail -1
  free -h | sed -n 2p
  echo; echo "== bruto da porta (teto do corte)"
  _bruto_texto
}

# {"ops_health":{"ok","motivo"}, "doentes":[...], "falhadas":[...],
#  "disco":{...}, "memoria":{...}} — mesmas cinco seções do texto. `|| return
# $?` em cada passo pelo mesmo motivo do comentário em _estado_json_corpo.
_saude_json_corpo() {
  local oh do_ fa di me br
  oh=$(_ops_health_json) || return $?
  do_=$(_doentes_json) || return $?
  fa=$(_falhadas_json) || return $?
  di=$(_disco_json) || return $?
  me=$(_memoria_json) || return $?
  br=$(_bruto_json) || return $?
  python3 -c '
import json, sys

oh, do_, fa, di, me, br = (json.loads(a) for a in sys.argv[1:7])
print(json.dumps({"ops_health": oh, "doentes": do_, "falhadas": fa, "disco": di, "memoria": me, "bruto": br}))
' "$oh" "$do_" "$fa" "$di" "$me" "$br" || return $?
}

_saude_json() { _json_ou_erro _saude_json_corpo; }

saude() {
  local json=0 a
  for a in "$@"; do
    [ "$a" = "--json" ] && json=1
  done
  if [ "$json" = 1 ]; then
    _saude_json
  else
    _saude_texto
  fi
}

logs() {
  local alvo="$1" n="${2:-50}"
  if e_conteiner "$alvo"; then
    docker logs --tail "$n" "$alvo" 2>&1
  else
    journalctl --user -u "$alvo" -n "$n" --no-pager
  fi
}

# Cache: o que ocupa VRAM e o que ocupa disco. Leitura por default; liberar e explicito.
cache() {
  local ato="${1:-ver}"
  case "$ato" in
    ver)
      echo "== modelo residente em VRAM (ollama)"
      curl -sf --max-time 5 127.0.0.1:11434/api/ps \
        | jq -r '.models[]? | "  \(.name)  vram=\(.size_vram/1073741824*100|round/100)GiB  ate=\(.expires_at[0:19])"' \
        | grep . || echo "  (nenhum)"
      echo; echo "== VRAM total"
      nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader
      echo; echo "== cache em disco"
      du -sh "$HOME/.cache/huggingface" "$HOME/.cache/uv" 2>/dev/null
      docker system df 2>/dev/null | sed -n '1,5p'
      ;;
    vram)
      # #2856 linha 142: `vram` DESCARREGA o modelo residente (nao mede; medir e `cache ver`) e
      # saia 0 sem uma linha quando nao havia nada ou o ollama nao respondia.
      local ps nomes m falhou=0
      ps="$(curl -sf --max-time 5 127.0.0.1:11434/api/ps)" \
        || { echo "infra cache vram: o ollama nao respondeu em 127.0.0.1:11434 — nada descarregado" >&2; exit 3; }
      nomes="$(printf '%s' "$ps" | jq -r '.models[]?.name')"
      if [ -z "$nomes" ]; then
        echo "nada residente em VRAM (ollama): nada a descarregar; para medir a VRAM, infra cache ver"
        return 0
      fi
      while read -r m; do
        if curl -sf --max-time 30 127.0.0.1:11434/api/generate -d "{\"model\":\"$m\",\"keep_alive\":0}" >/dev/null; then
          echo "descarregado: $m"
        else
          echo "infra cache vram: nao consegui descarregar $m" >&2; falhou=1
        fi
      done <<< "$nomes"
      [ "$falhou" -eq 0 ] || exit 3
      ;;
    disco)
      docker builder prune -f
      uv cache prune 2>/dev/null || true
      echo "cache de modelo (huggingface, ollama) nao e apagado aqui: rebaixar custa GiB de re-download."
      ;;
    *) echo "uso: infra cache [ver|vram|disco]" >&2; exit 2 ;;
  esac
}

# Hardware e GPU: leitura, nunca mutação. nvidia-smi é a fonte da GPU; CPU e RAM vêm de
# /proc. A potência da CPU vem do RAPL (amostra de 1 s), que desde o CVE-2020-8694 costuma
# ser só do root: ilegível sai dito, nunca como 0 W. A fonte de alimentação (PSU) não se
# informa ao sistema; o ato diz isso em vez de calar, porque é a pergunta que o traz aqui
# (dimensionar nobreak, 03/10/2026). Sem nvidia-smi: exit 3; nvidia-smi que falha: exit 5.
exigir_nvidia_smi() {
  command -v nvidia-smi >/dev/null 2>&1 && return 0
  echo "infra: erro: dependência nvidia-smi: ausente — sem leitura de GPU" >&2
  return 3
}

_rapl_watts() {  # potência do pacote da CPU em W inteiros; vazio quando ilegível
  local f="${INFRA_RAPL:-/sys/class/powercap/intel-rapl:0/energy_uj}" a b
  a=$(cat "$f" 2>/dev/null) || return 0
  sleep 1
  b=$(cat "$f" 2>/dev/null) || return 0
  case "$a$b" in *[!0-9]*|"") return 0 ;; esac
  [ "$b" -ge "$a" ] || return 0   # contador deu a volta: sem leitura honesta nesta amostra
  echo $(( (b - a) / 1000000 ))
}

hardware() {
  local json=0 a gpus cpu_w
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      *) echo "uso: infra hardware [--json]" >&2; exit 2 ;;
    esac
  done
  exigir_nvidia_smi || exit 3
  gpus=$(nvidia-smi --query-gpu=name,memory.total,power.draw,power.limit,power.max_limit,driver_version \
           --format=csv,noheader,nounits) \
    || { echo "infra: erro: nvidia-smi falhou — GPU não lida" >&2; exit 5; }
  cpu_w=$(_rapl_watts)
  INFRA_HW_GPUS="$gpus" INFRA_HW_CPUW="$cpu_w" INFRA_HW_JSON="$json" \
  INFRA_HW_CPUINFO="${INFRA_CPUINFO:-/proc/cpuinfo}" INFRA_HW_MEMINFO="${INFRA_MEMINFO:-/proc/meminfo}" \
  python3 - <<'PY'
import csv, io, json, os

def num(s):
    try:
        return round(float(s), 1)
    except (TypeError, ValueError):
        return None

def cpu():
    modelo, nucleos, threads, bloco = None, set(), 0, {}
    def fecha(b):
        nonlocal modelo, threads
        if b.get("processor") is None:
            return
        threads += 1
        nucleos.add((b.get("physical id"), b.get("core id")))
        modelo = modelo or b.get("model name")
    try:
        for l in open(os.environ["INFRA_HW_CPUINFO"]):
            if not l.strip():
                fecha(bloco); bloco = {}; continue
            k, _, v = l.partition(":")
            bloco[k.strip()] = v.strip()
        fecha(bloco)
    except OSError:
        pass
    n = len(nucleos) if nucleos and (None, None) not in nucleos else None
    return {"modelo": modelo, "nucleos": n, "threads": threads or None}

def ram_gib():
    try:
        for l in open(os.environ["INFRA_HW_MEMINFO"]):
            if l.startswith("MemTotal:"):
                return round(int(l.split()[1]) / 1048576, 1)
    except (OSError, ValueError, IndexError):
        pass
    return None

gpus = []
for r in csv.reader(io.StringIO(os.environ["INFRA_HW_GPUS"]), skipinitialspace=True):
    if not r:
        continue
    r += [None] * (6 - len(r))
    gpus.append({"nome": r[0], "vram_mib": num(r[1]), "watts": num(r[2]),
                 "teto_w": num(r[3]), "teto_max_w": num(r[4]), "driver": r[5]})

c = cpu()
c["watts"] = int(os.environ["INFRA_HW_CPUW"]) if os.environ["INFRA_HW_CPUW"] else None
psu = {"legivel": False, "motivo": "a fonte não se informa ao sistema; a potência está na etiqueta dela"}
soma = None
if c["watts"] is not None and gpus and all(g["watts"] is not None for g in gpus):
    soma = round(c["watts"] + sum(g["watts"] for g in gpus))

if os.environ["INFRA_HW_JSON"] == "1":
    print(json.dumps({"cpu": c, "ram_gib": ram_gib(), "gpus": gpus, "psu": psu,
                      "soma_cpu_gpu_w": soma}, ensure_ascii=False))
    raise SystemExit(0)

def w(v):
    return "—" if v is None else f"{v:g} W"

print("== CPU")
nuc = f"{c['nucleos']} núcleos / " if c["nucleos"] else ""
thr = f"{c['threads']} threads" if c["threads"] else "threads não lidas"
print(f"  {c['modelo'] or 'modelo não lido'} · {nuc}{thr}")
if c["watts"] is None:
    print("  consumo agora: não legível desta conta (RAPL é do root)")
else:
    print(f"  consumo agora: {c['watts']} W (pacote, amostra de 1 s)")
print(); print("== RAM")
r = ram_gib()
print(f"  {r:g} GiB" if r is not None else "  não lida")
for i, g in enumerate(gpus):
    print(); print(f"== GPU {i}")
    vram = f"{g['vram_mib'] / 1024:.0f} GiB" if g["vram_mib"] else "VRAM não lida"
    print(f"  {g['nome']} · {vram} · driver {g['driver']}")
    print(f"  consumo agora: {w(g['watts'])} · teto configurado: {w(g['teto_w'])} · teto máximo da placa: {w(g['teto_max_w'])}")
if not gpus:
    print(); print("== GPU"); print("  nenhuma listada pelo nvidia-smi")
print(); print("== fonte de alimentação (PSU)")
print(f"  não lida: {psu['motivo']}")
if soma is not None:
    print(); print("== soma medida agora")
    print(f"  CPU + GPU = {soma} W (fora placa-mãe, discos, ventoinhas e monitor)")
PY
}

gpu() {
  local json=0 a q p apps_ok=1
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      *) echo "uso: infra gpu [--json]" >&2; exit 2 ;;
    esac
  done
  exigir_nvidia_smi || exit 3
  q=$(nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,power.limit,clocks.sm,pstate \
        --format=csv,noheader,nounits) \
    || { echo "infra: erro: nvidia-smi falhou — GPU não lida" >&2; exit 5; }
  p=$(nvidia-smi --query-compute-apps=gpu_bus_id,pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null) \
    || { p=""; apps_ok=0; }
  INFRA_GPU_Q="$q" INFRA_GPU_P="$p" INFRA_GPU_APPS_OK="$apps_ok" INFRA_GPU_JSON="$json" python3 - <<'PY'
import csv, io, json, os

def num(s):
    try:
        return round(float(s), 1)
    except (TypeError, ValueError):
        return None

def linhas(var):
    return [r for r in csv.reader(io.StringIO(os.environ[var]), skipinitialspace=True) if r]

gpus = []
for r in linhas("INFRA_GPU_Q"):
    r += [None] * (10 - len(r))
    gpus.append({"indice": r[0], "nome": r[1], "uso_pct": num(r[2]), "vram_usada_mib": num(r[3]),
                 "vram_total_mib": num(r[4]), "temp_c": num(r[5]), "watts": num(r[6]),
                 "teto_w": num(r[7]), "clock_mhz": num(r[8]), "pstate": r[9]})
apps_ok = os.environ["INFRA_GPU_APPS_OK"] == "1"
procs = []
for r in linhas("INFRA_GPU_P"):
    r += [None] * (4 - len(r))
    procs.append({"pid": r[1], "processo": r[2], "vram_mib": num(r[3])})

if os.environ["INFRA_GPU_JSON"] == "1":
    print(json.dumps({"gpus": gpus, "processos": procs if apps_ok else None,
                      "processos_motivo": None if apps_ok else "nvidia-smi não listou processos"},
                     ensure_ascii=False))
    raise SystemExit(0)

def f(v, u):
    return "—" if v is None else f"{v:g}{u}"

for g in gpus:
    print(f"== GPU {g['indice']}: {g['nome']} ({g['pstate'] or '—'})")
    print(f"  uso {f(g['uso_pct'], '%')} · VRAM {f(g['vram_usada_mib'], '')} / {f(g['vram_total_mib'], ' MiB')}"
          f" · {f(g['temp_c'], ' °C')} · {f(g['watts'], '')} / {f(g['teto_w'], ' W')} · {f(g['clock_mhz'], ' MHz')}")
if not gpus:
    print("== GPU"); print("  nenhuma listada pelo nvidia-smi")
print(); print("== processos na GPU")
if not apps_ok:
    print("  não listados: nvidia-smi recusou a consulta de processos")
elif not procs:
    print("  (nenhum)")
for p in procs:
    print(f"  {p['pid']}  {p['processo']}  {f(p['vram_mib'], ' MiB')}")
PY
}

# Alvo pode ser contêiner OU unit --user, e o ato ramifica: nome de contêiner
# passado a `systemctl --user restart` falha DENTRO da unit destacada, o
# --collect recolhe a falha e o echo de sucesso já saiu no processo de fora,
# que nunca vê o código de saída (medido em 12/08 por claudinha-produto, #339).
# Por isso: síncrono e conferido por padrão; destacado só onde o restart mata a
# própria chamada — o ops-mcp — ou sob --nao-esperar explícito.
INFRA_UNIT_AUTO="${INFRA_UNIT_AUTO:-ops-mcp}"

restart() {
  local esperar=1 alvo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --nao-esperar) esperar=0 ;;
      --) shift; alvo="${1:-}" ;;
      -*) echo "erro: opção desconhecida em restart: $1" >&2; exit 2 ;;
      *)  alvo="$1" ;;
    esac
    shift
  done
  [ -n "$alvo" ] || { echo "erro: restart exige alvo explícito — não reinicia tudo." >&2; exit 2; }

  if e_conteiner "$alvo"; then
    if [ "$esperar" = 1 ]; then
      docker restart "$alvo" >/dev/null \
        || { echo "erro: docker restart falhou em $alvo — nada garantido." >&2; exit 1; }
      echo "contêiner $alvo reiniciado: $(docker ps -a --format '{{.Names}}\t{{.Status}}' | grep -P "^$alvo\t" | cut -f2)"
    else
      systemd-run --user --collect --quiet --unit="infra-restart-$$" docker restart "$alvo" \
        || { echo "erro: não consegui despachar o restart de $alvo." >&2; exit 1; }
      echo "restart do contêiner $alvo despachado destacado; conferir com: infra estado $alvo"
    fi
    return
  fi

  if e_unit "$alvo"; then
    if [ "$esperar" = 1 ] && [ "${alvo%.service}" != "${INFRA_UNIT_AUTO%.service}" ]; then
      systemctl --user restart "$alvo" \
        || { echo "erro: systemctl --user restart falhou em $alvo — ver: infra logs $alvo" >&2; exit 1; }
      echo "unit $alvo reiniciada: $(systemctl --user is-active -- "$alvo" || true)"
    else
      systemd-run --user --collect --quiet --unit="infra-restart-$$" systemctl --user restart "$alvo" \
        || { echo "erro: não consegui despachar o restart de $alvo." >&2; exit 1; }
      echo "restart da unit $alvo despachado destacado (a chamada não sobrevive a ele); conferir com: infra estado $alvo"
    fi
    return
  fi

  # sem bus o `systemctl --user cat` também falha: dizer "não é unit" esconderia a causa
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "erro: sem bus do systemd --user (XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS)." >&2
    echo "       '$alvo' não foi achado nem reiniciado; rode como a conta dona das units, com a sessão de usuário viva (loginctl enable-linger)." >&2
    exit 3
  fi
  echo "erro: '$alvo' não é contêiner conhecido (docker ps -a) nem unit --user (systemctl --user cat)." >&2
  echo "       nada foi reiniciado; conferir o nome com: infra estado" >&2
  exit 2
}

# `infra remover <alvo> [--ver]` — tira o que ficou de pé fora do declarado (balde #2856 linha 17):
# contêiner avulso (sem stack compose, subido à mão: kind_gould, 15/10/2026), unit transitória que
# falhou e unit da conta que ninguém declara (jaiminho-server, 27/09/2026). Não havia verbo, e o
# resíduo virava ato do dono no host. O declarado não sai por aqui: contêiner de stack é `infra
# down`, unit declarada no core ou no harness sai por PR no repositório que a declara. Cada ramo
# deixa a volta antes do ato: a inspeção do contêiner (imagem, montagens, portas, comando) é
# gravada antes do rm e a imagem fica no disco; o arquivo da unit vai para uma leva da quarentena
# e volta com mv enquanto a leva viver; a transitória só sai da lista, e o registro dela segue no
# journal. --ver mostra o que se sabe e o que aconteceria, sem efeito e sem identidade; recusa
# sai 4 com ou sem --ver.
INFRA_REMOVIDOS="${INFRA_REMOVIDOS:-$PLATAFIRMA_INSTANCIA/var/log/infra/removidos}"
INFRA_QUARENTENA="${INFRA_QUARENTENA:-$PLATAFIRMA_INSTANCIA/var/quarentena}"
INFRA_UNITS_DIR="${INFRA_UNITS_DIR:-$HOME/.config/systemd/user}"
INFRA_DECLARADOS="${INFRA_DECLARADOS:-$PLATAFIRMA_RELEASE/core/deploy:$PLATAFIRMA_RELEASE/harness/deploy-harness:$AQUI/../registro}"

_declarado_em() {  # $1=nome sem .service; imprime o primeiro arquivo declarado que o cita
  local d f IFS=:
  for d in $INFRA_DECLARADOS; do
    [ -e "$d" ] || continue
    f=$(grep -rlwF -- "$1" "$d" 2>/dev/null | head -n 1)
    [ -n "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

_inspecao_campo() {  # stdin=docker inspect; $1=resumo|projeto|imagem
  python3 -c '
import json, sys
d = json.load(sys.stdin)[0]
cfg, st = d.get("Config") or {}, d.get("State") or {}
proj = (cfg.get("Labels") or {}).get("com.docker.compose.project") or ""
if sys.argv[1] == "projeto":
    print(proj); raise SystemExit(0)
if sys.argv[1] == "imagem":
    print(cfg.get("Image") or ""); raise SystemExit(0)
mont = ["%s -> %s (%s)" % (m.get("Source"), m.get("Destination"), "rw" if m.get("RW") else "ro")
        for m in d.get("Mounts") or []]
portas = []
for p, b in ((d.get("NetworkSettings") or {}).get("Ports") or {}).items():
    if b:
        portas += ["%s -> %s:%s" % (p, x.get("HostIp"), x.get("HostPort")) for x in b]
    else:
        portas.append("%s (não publicada)" % p)
cmd = " ".join((cfg.get("Entrypoint") or []) + (cfg.get("Cmd") or []))
print("contêiner: %s" % (d.get("Name") or "").lstrip("/"))
print("imagem:    %s" % (cfg.get("Image") or "-"))
print("criado:    %s" % (d.get("Created") or "-"))
print("estado:    %s" % (st.get("Status") or "-"))
print("comando:   %s" % (cmd or "-"))
print("montagens: %s" % ("; ".join(mont) or "nenhuma"))
print("portas:    %s" % ("; ".join(portas) or "nenhuma"))
print("stack:     %s" % (proj or "nenhuma (avulso)"))
' "$1"
}

_remover_conteiner() {  # $1=contêiner $2=ver
  local c="$1" ver="$2" j proj img arq
  j=$(docker inspect -- "$c" 2>/dev/null) || { echo "infra: erro: docker inspect falhou em $c — nada removido" >&2; exit 5; }
  printf '%s' "$j" | _inspecao_campo resumo \
    || { echo "infra: erro: inspeção de $c ilegível — nada removido" >&2; exit 5; }
  proj=$(printf '%s' "$j" | _inspecao_campo projeto)
  img=$(printf '%s' "$j" | _inspecao_campo imagem)
  if [ -n "$proj" ]; then
    echo "infra: $c é da stack compose '$proj', não avulso — derrube por: infra down <stack> <serviço>; nada removido" >&2
    exit 4
  fi
  if [ "$ver" = 1 ]; then
    echo "removível: sim — sem --ver, a inspeção vai para $INFRA_REMOVIDOS e o contêiner sai (a imagem fica)"
    return 0
  fi
  mkdir -p "$INFRA_REMOVIDOS" 2>/dev/null || { echo "infra: erro: não consegui criar $INFRA_REMOVIDOS — nada removido" >&2; exit 3; }
  arq="$INFRA_REMOVIDOS/$c-$(date +%Y%m%dT%H%M%S).json"
  printf '%s\n' "$j" > "$arq" 2>/dev/null || { echo "infra: erro: não consegui gravar a inspeção em $arq — nada removido" >&2; exit 3; }
  docker rm -f -- "$c" >/dev/null || { echo "infra: erro: docker rm falhou em $c — a inspeção ficou em $arq" >&2; exit 1; }
  if e_conteiner "$c"; then
    echo "infra: erro: $c ainda aparece em docker ps -a depois do rm" >&2
    exit 1
  fi
  echo "removido: $c · inspeção guardada em $arq · a imagem ${img:-?} segue no disco"
}

_remover_unit() {  # $1=unit (.service) $2=ver
  local u="$1" ver="$2" transit ativo frag dir dono decl leva
  transit=$(systemctl --user show -p Transient --value -- "$u" 2>/dev/null || true)
  ativo=$(systemctl --user show -p ActiveState --value -- "$u" 2>/dev/null || true)
  frag=$(systemctl --user show -p FragmentPath --value -- "$u" 2>/dev/null || true)
  printf 'unit:        %s\ntransitória: %s\nestado:      %s\narquivo:     %s\n' \
    "$u" "${transit:-?}" "${ativo:-?}" "${frag:-nenhum}"

  if [ "$transit" = yes ]; then
    case "$ativo" in
      failed|inactive) ;;
      *) echo "infra: $u está ${ativo:-?} — pare antes (sessao longjob stop $u); nada removido" >&2; exit 4 ;;
    esac
    if [ "$ver" = 1 ]; then
      echo "removível: sim — sem --ver, sai da lista de units (reset-failed); o registro segue no journal: infra logs $u"
      return 0
    fi
    systemctl --user reset-failed -- "$u" 2>/dev/null || { echo "infra: erro: reset-failed recusado em $u" >&2; exit 1; }
    echo "removida: $u saiu da lista de units · o registro segue no journal: infra logs $u"
    return 0
  fi

  if [ "${u%.service}" = "${INFRA_UNIT_AUTO%.service}" ]; then
    echo "infra: $u é a porta de operação — não sai por aqui; nada removido" >&2
    exit 4
  fi
  if decl=$(_declarado_em "${u%.service}"); then
    echo "infra: $u está declarada em $decl — tirar é PR no repositório que a declara; nada removido" >&2
    exit 4
  fi
  case "$frag" in
    "$INFRA_UNITS_DIR"/*) ;;
    *) echo "infra: o arquivo de $u (${frag:-nenhum}) não está em $INFRA_UNITS_DIR — unit do sistema ou de pacote, não da conta; nada removido" >&2
       exit 4 ;;
  esac
  dir="$(dirname "$frag")"
  if [ ! -w "$dir" ]; then
    dono=$(stat -c %U -- "$dir" 2>/dev/null || echo "?")
    echo "infra: $dir é de $dono, sem escrita desta conta — a unit veio de setup com sudo; nada removido" >&2
    exit 4
  fi
  if [ "$ver" = 1 ]; then
    echo "removível: sim — sem --ver, a unit para, sai do boot (disable) e o arquivo vai para uma leva de $INFRA_QUARENTENA, de onde volta com mv"
    return 0
  fi
  leva="$INFRA_QUARENTENA/$(date +%Y%m%dT%H%M%S)-infra-remover"
  mkdir -p "$leva" 2>/dev/null || { echo "infra: erro: não consegui criar $leva — nada removido" >&2; exit 3; }
  systemctl --user stop -- "$u" 2>/dev/null || { echo "infra: erro: systemctl --user stop falhou em $u — nada movido" >&2; exit 1; }
  systemctl --user disable -- "$u" >/dev/null 2>&1 || true
  mv -- "$frag" "$leva/" || { echo "infra: erro: não consegui mover $frag — a unit está parada e desabilitada, o arquivo ficou" >&2; exit 1; }
  if [ -d "$INFRA_UNITS_DIR/$u.d" ]; then mv -- "$INFRA_UNITS_DIR/$u.d" "$leva/" || true; fi
  systemctl --user daemon-reload 2>/dev/null || true
  systemctl --user reset-failed -- "$u" >/dev/null 2>&1 || true
  echo "removida: $u parada e desabilitada · arquivo em $leva (volta: mv para $dir e daemon-reload)"
}

remover() {
  local ver=0 alvo="" a
  for a in "$@"; do
    case "$a" in
      --ver) ver=1 ;;
      -*) echo "erro: opção desconhecida em remover: $a (uso: infra remover <alvo> [--ver])" >&2; exit 2 ;;
      *) [ -z "$alvo" ] || { echo "erro: remover aceita um alvo só — não remove em lote" >&2; exit 2; }
         alvo="$a" ;;
    esac
  done
  [ -n "$alvo" ] || { echo "erro: remover exige alvo explícito — não remove nada em lote." >&2; exit 2; }
  [ "$ver" = 1 ] || exigir_sujeito "infra remover" || exit 3
  if e_conteiner "$alvo"; then _remover_conteiner "$alvo" "$ver"; return; fi
  if e_unit "${alvo%.service}.service"; then _remover_unit "${alvo%.service}.service" "$ver"; return; fi
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "erro: sem bus do systemd --user (XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR) — '$alvo' não foi achado nem removido" >&2
    exit 3
  fi
  echo "infra: '$alvo' não é contêiner (docker ps -a) nem unit --user (systemctl --user cat) — nada removido" >&2
  exit 1
}

# Ambiente de unit --user por drop-in (spec_porta-so-verbo §9: o shell saiu da porta, e
# editar ~/.config/systemd/user/<unit>.service.d/ e operacao de unit — capacidade infra).
# Escreve SO o drop-in 90-infra-env.conf (nunca a unit nem outros drop-ins), chave por
# chave, merge com o que ja esta nele; `systemctl daemon-reload` no fim. Nao reinicia:
# `infra restart <unit>` e ato separado, para a janela ser dita antes.
unit_env() {
  local unit="${1:-}"; shift || true
  [ -n "$unit" ] || { echo "uso: infra unit-env <unit> [--ver | CHAVE=VALOR...]" >&2; exit 2; }
  unit="${unit%.service}.service"
  e_unit "$unit" || { echo "erro: unit --user '$unit' nao existe (systemctl --user cat)." >&2; exit 2; }
  local dir="$HOME/.config/systemd/user/$unit.d" arq
  # drop-in vence por ordem lexica (o ultimo ganha); `zz-` para passar por cima de
  # drop-in sem numero (capsula.conf), senao a chave gravada aqui perde calada.
  arq="$dir/zz-infra-env.conf"
  if [ $# -eq 0 ] || [ "${1:-}" = "--ver" ]; then
    echo "== ambiente efetivo de $unit (unit + drop-ins)"
    systemctl --user show -p Environment --value -- "$unit" | tr ' ' '\n' | grep . || echo "(vazio)"
    echo; echo "== drop-in gerido por infra: $arq"
    cat "$arq" 2>/dev/null || echo "(ainda nao existe)"
    return
  fi
  local kv
  for kv in "$@"; do
    case "$kv" in
      [A-Za-z_]*=*) ;;
      *) echo "erro: '$kv' nao e CHAVE=VALOR." >&2; exit 2 ;;
    esac
  done
  mkdir -p "$dir"
  python3 - "$arq" "$@" <<'PY'
import os, sys, tempfile
arq, novos = sys.argv[1], sys.argv[2:]
env = {}
legado = os.path.join(os.path.dirname(arq), "90-infra-env.conf")  # nome antigo, perdia para capsula.conf
for fonte in (legado, arq):
    if os.path.exists(fonte):
        for l in open(fonte):
            l = l.strip()
            if l.startswith("Environment=") and "=" in l[12:]:
                k, v = l[12:].split("=", 1); env[k] = v
if os.path.exists(legado):
    os.unlink(legado)
for kv in novos:
    k, v = kv.split("=", 1); env[k] = v
corpo = "[Service]\n" + "".join(f"Environment={k}={v}\n" for k, v in sorted(env.items()))
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(arq), prefix=".90-infra-env.")
with os.fdopen(fd, "w") as f:
    f.write(corpo); f.flush(); os.fsync(f.fileno())
os.chmod(tmp, 0o644); os.rename(tmp, arq)
print(corpo, end="")
PY
  systemctl --user daemon-reload
  echo "daemon-reload feito; vale apos: infra restart ${unit%.service}"
}

# Mede backup, nao faz backup e nao propoe rotina. Le o DECLARADO em
# registro/backups.json: alvo sem cobertura fica na lista de proposito, porque alvo que
# some da lista deixa de ser medido e reaparece como surpresa. Alvo cujo backup roda em
# conta que o claudinho nao alcanca sai como `nao medivel daqui`, nunca como zero.
backup() {
  # registro e corpo do sub-ato vem da propria arvore deste verbo (a release no ar), nunca de clone
  local reg="${INFRA_BACKUPS:-$AQUI/../registro/backups.json}"
  [ -r "$reg" ] || { echo "registro nao legivel: $reg" >&2; exit 1; }
  INFRA_BACKUPS_REG="$reg" python3 "$AQUI/_infra/backup.py" "$@"
}

# Ato de compose de stack: `infra up|down|ps|config|pull|build <stack> [args…] [<serviço>…]`
# repassa para `bin/_release/stack compose <stack> <acao> [args…] [<serviço>…]`. O ajudante
# mora ao lado deste bin (nunca pelo PATH); identidade só nos atos de mutação (up/down/
# pull/build), lida do §9 da decisão do card #3145.
exigir_stack_ajudante() {
  if [ ! -x "$STACK_AJUDANTE" ]; then
    printf 'infra: erro: dependência bin/_release/stack: ausente (%s) — ajudante de compose não encontrado\n' "$STACK_AJUDANTE" >&2
    return 3
  fi
  return 0
}

cmd_stack() {  # $1=acao ; resto: <stack> [args compose…] [<serviço>…]
  local acao="$1"; shift
  case "$acao" in
    up|down|pull|build) exigir_sujeito "infra $acao" || return $? ;;
  esac
  exigir_stack_ajudante || return $?
  local stack="${1:-}"
  [ -n "$stack" ] || { printf 'infra: erro: %s exige <stack>\n' "$acao" >&2; uso; }
  shift
  local suf=""
  [ -n "${PF_SUJEITO:-}" ] && suf=" sujeito=$PF_SUJEITO"
  printf 'stack:     %s → %s compose %s %s%s\n' "$stack" "$(basename "$STACK_AJUDANTE")" "$stack" "$acao" "$suf"
  "$STACK_AJUDANTE" compose "$stack" "$acao" "$@"
}

# `infra medir <eixo> [--json]` — os eixos do host lidos por ato (spec eixos-do-host R1, cards #3919 e #3920). Cada
# eixo é um sub-ato de bin/_infra/, chamado por exec, como a limpeza; hoje `rede` e `ram`. O ato só lê (não grava
# série, não reinicia túnel) e não exige PF_SUJEITO. O código de saída é o do eixo: 0 lido, 5 não consegui olhar.
cmd_medir() {
  local eixo="${1:-}"; shift || true
  case "$eixo" in
    rede)
      [ -x "$MEDIR_REDE" ] || { printf 'infra: erro: dependência bin/_infra/medir-rede: ausente (%s)\n' "$MEDIR_REDE" >&2; exit 3; }
      exec "$MEDIR_REDE" "$@"
      ;;
    ram)
      [ -x "$MEDIR_RAM" ] || { printf 'infra: erro: dependência bin/_infra/medir-ram: ausente (%s)\n' "$MEDIR_RAM" >&2; exit 3; }
      exec "$MEDIR_RAM" "$@"
      ;;
    "")
      printf 'infra: erro: medir exige o eixo: rede, ram\n' >&2; uso ;;
    *)
      printf 'infra: erro: eixo desconhecido: %s — valores válidos: rede, ram\n' "$eixo" >&2; uso ;;
  esac
}

# `infra limpeza logs|quarentena [args…]` — sub-atos movidos de bin/ops-log-prune e
# bin/quarentena-prune para bin/_infra/ (arq:0110 §14, emenda 26/09/2026): não exigem
# PF_SUJEITO — já eram chamados por automação (cron), sem identidade humana no ato.
cmd_limpeza() {
  local alvo="${1:-}"; shift || true
  case "$alvo" in
    logs)
      [ -x "$LIMPEZA_LOGS" ] || { printf 'infra: erro: dependência bin/_infra/limpeza-logs: ausente (%s)\n' "$LIMPEZA_LOGS" >&2; exit 3; }
      exec "$LIMPEZA_LOGS" "$@"
      ;;
    quarentena)
      [ -x "$LIMPEZA_QUARENTENA" ] || { printf 'infra: erro: dependência bin/_infra/limpeza-quarentena: ausente (%s)\n' "$LIMPEZA_QUARENTENA" >&2; exit 3; }
      exec "$LIMPEZA_QUARENTENA" "$@"
      ;;
    fossil)
      # #3920 (R12 a R14 da spec eixos-do-host): o que as rodadas deixam para trás, pelo critério positivo — contêiner
      # sem label de projeto do compose com mais de 24 h e unit platafirma-job-* em failed. Grava o evento do job antes
      # do reset-failed e guarda logs e inspeção do contêiner antes do rm. Também não exige PF_SUJEITO: roda no timer.
      [ -x "$LIMPEZA_FOSSIL" ] || { printf 'infra: erro: dependência bin/_infra/limpeza-fossil: ausente (%s)\n' "$LIMPEZA_FOSSIL" >&2; exit 3; }
      exec "$LIMPEZA_FOSSIL" "$@"
      ;;
    jobs)
      # #2856 linha 17, absorvido pelo #3920: o job avulso falhado é fóssil e sai pela limpeza de fóssil, com o evento
      # gravado antes. A entrada fica porque o cron do core chama `infra limpeza jobs --dias 1` (core/deploy/
      # crontab-claudinho); um caminho só para o mesmo fóssil, dois nomes.
      [ -x "$LIMPEZA_FOSSIL" ] || { printf 'infra: erro: dependência bin/_infra/limpeza-fossil: ausente (%s)\n' "$LIMPEZA_FOSSIL" >&2; exit 3; }
      exec "$LIMPEZA_FOSSIL" --so-jobs "$@"
      ;;
    "")
      printf 'infra: erro: limpeza exige logs, quarentena, jobs ou fossil\n' >&2; uso ;;
    *)
      printf 'infra: erro: limpeza desconhecida: %s — valores válidos: logs, quarentena, jobs, fossil\n' "$alvo" >&2; uso ;;
  esac
}

# `infra agenda conferir|aplicar` — convergência do crontab do claudinho (decisão 8,
# card #3145): script único em INFRA_CRONTAB_SCRIPT, --check em conferir (0 igual, 1
# divergente — mérito, não uso), sem --check em aplicar. Não exige PF_SUJEITO: já é
# chamado por automação/gatilho, como restart/backup/cache/limpeza.
# `infra units conferir|aplicar` — o par de `agenda` para as units systemd --user da instância
# (deploy/units-da-instancia.json do core, card #3917): script único em INFRA_UNITS_SCRIPT, --check
# em conferir (0 conforme, 1 divergente), sem --check em aplicar (symlink para a release e
# daemon-reload). Não exige PF_SUJEITO, pela mesma razão de agenda.
cmd_units() {
  local sub="${1:-}"; shift || true
  [ -x "$UNITS_SCRIPT" ] || { printf 'infra: erro: dependência %s: ausente\n' "$UNITS_SCRIPT" >&2; exit 3; }
  case "$sub" in
    conferir) exec "$UNITS_SCRIPT" --check "$@" ;;
    aplicar)  exec "$UNITS_SCRIPT" "$@" ;;
    "")
      printf 'infra: erro: units exige conferir ou aplicar\n' >&2; uso ;;
    *)
      printf 'infra: erro: units desconhecido: %s — valores válidos: conferir, aplicar\n' "$sub" >&2; uso ;;
  esac
}

cmd_agenda() {
  local sub="${1:-}"; shift || true
  [ -x "$CRONTAB_SCRIPT" ] || { printf 'infra: erro: dependência %s: ausente\n' "$CRONTAB_SCRIPT" >&2; exit 3; }
  case "$sub" in
    conferir) exec "$CRONTAB_SCRIPT" --check "$@" ;;
    aplicar)  exec "$CRONTAB_SCRIPT" "$@" ;;
    "")
      printf 'infra: erro: agenda exige conferir ou aplicar\n' >&2; uso ;;
    *)
      printf 'infra: erro: agenda desconhecida: %s — valores válidos: conferir, aplicar\n' "$sub" >&2; uso ;;
  esac
}

# `infra instalar` saiu (desenho #3010 §2; arq:0109 Consequencias): nao existe mais bin servido
# por copia nem diretorio de symlinks de verbos. O PATH e a release no ar,
# $PLATAFIRMA_RELEASE/harness/bin, e verbo novo chega ao ar por `release promover platafirma-harness <rev>`.
instalar() {
  echo "erro: \`infra instalar\` saiu — nao ha bin servido por copia." >&2
  echo "       o PATH e a release no ar: $PLATAFIRMA_RELEASE/harness/bin" >&2
  echo "       verbo novo vai ao ar por: release promover platafirma-harness <rev>" >&2
  exit 2
}

# `infra ingress [--ver]` — o ingress do túnel `wiki`. O contêiner lê a CÓPIA da instância
# (deploy/core/cloudflared.yml, montada pelo override; card #3010), não o arquivo versionado, e nenhum
# ato a escrevia: a rota decomissionada seguiu viva até a mão do dono copiar (#3271, #3473). O ato
# copia o versionado da release no ar para a cópia, mostra a diferença antes e reinicia o contêiner.
# A cópia nova entra por rename no mesmo diretório (inteira ou nada) e a anterior fica em
# <cópia>.anterior; se o contêiner não ficar de pé, a anterior volta e ele reinicia de novo (exit 1).
# Fonte que o cloudflared recusaria (sem túnel, sem `ingress:` ou sem a regra final http_status) não
# se grava: o contêiner cairia em laço no restart.
ingress() {
  local ver=0 a
  for a in "$@"; do
    case "$a" in
      --ver) ver=1 ;;
      *) echo "erro: opção desconhecida em ingress: $a (uso: infra ingress [--ver])" >&2; exit 2 ;;
    esac
  done
  local fonte="${INFRA_INGRESS_FONTE:-$PLATAFIRMA_RELEASE/core/deploy/cloudflared-config.yml}"
  local copia="${INFRA_INGRESS_COPIA:-$PLATAFIRMA_INSTANCIA/deploy/core/cloudflared.yml}"
  local conteiner="${INFRA_INGRESS_CONTEINER:-platafirma-core-cloudflared-1}"
  local espera="${INFRA_INGRESS_ESPERA:-5}"
  [ -r "$fonte" ] || {
    printf 'infra: erro: dependência %s: ausente — o ingress versionado vem da release no ar (release promover platafirma-core)\n' "$fonte" >&2
    exit 3
  }
  command -v diff >/dev/null 2>&1 || { echo "infra: erro: dependência diff: ausente" >&2; exit 3; }

  local ultima
  ultima="$(grep -Ev '^[[:space:]]*(#|$)' "$fonte" | tail -n 1 || true)"
  if ! grep -Eq '^tunnel:[[:space:]]*[0-9a-f-]{36}[[:space:]]*$' "$fonte" \
     || ! grep -Eq '^ingress:[[:space:]]*$' "$fonte" \
     || ! [[ "$ultima" =~ ^[[:space:]]*-[[:space:]]+service:[[:space:]]+http_status:[0-9]+ ]]; then
    printf 'infra: ingress versionado reprovado em %s: precisa de `tunnel:`, de `ingress:` e da regra final `- service: http_status:<n>` — nada gravado, nada reiniciado\n' "$fonte" >&2
    exit 1
  fi

  local dif rc=0
  if [ -e "$copia" ]; then
    dif="$(diff -u --label "instancia:$copia" --label "versionado:$fonte" -- "$copia" "$fonte")" || rc=$?
    if [ "$rc" -gt 1 ]; then
      printf 'infra: erro: diff não conseguiu ler %s ou %s (exit %s) — nada gravado\n' "$copia" "$fonte" "$rc" >&2
      exit 5
    fi
  else
    rc=1
    dif="(a cópia ainda não existe; o arquivo versionado inteiro é a diferença)"
  fi

  echo "versionado: $fonte"
  echo "instância:  $copia"
  if [ "$rc" -eq 0 ]; then
    echo "igual: a cópia da instância já é o ingress versionado — nada gravado, nada reiniciado"
    return 0
  fi
  echo "== diferença (instância → versionado)"
  printf '%s\n' "$dif"
  if [ "$ver" = 1 ]; then
    echo "divergente: infra ingress grava a cópia e reinicia $conteiner"
    return 1
  fi

  e_conteiner "$conteiner" || {
    printf 'infra: erro: contêiner %s: ausente (docker ps -a) — nada gravado, nada reiniciado\n' "$conteiner" >&2
    exit 3
  }
  local dir tmp
  dir="$(dirname "$copia")"
  if [ ! -d "$dir" ] || [ ! -w "$dir" ]; then
    printf 'infra: erro: diretório %s: ausente ou sem escrita — nada gravado, nada reiniciado\n' "$dir" >&2
    exit 3
  fi
  tmp="$(mktemp "$dir/.cloudflared.XXXXXX")" || { echo "infra: erro: mktemp em $dir falhou" >&2; exit 3; }
  local tinha_anterior=0
  if [ -e "$copia" ]; then
    { cp -- "$fonte" "$tmp" && chmod --reference="$copia" "$tmp" && cp -p -- "$copia" "$copia.anterior"; } \
      || { rm -f -- "$tmp"; echo "infra: erro: não consegui preparar a cópia nova em $dir — nada gravado, nada reiniciado" >&2; exit 3; }
    tinha_anterior=1
  else
    { cp -- "$fonte" "$tmp" && chmod 0644 "$tmp"; } \
      || { rm -f -- "$tmp"; echo "infra: erro: não consegui preparar a cópia nova em $dir — nada gravado, nada reiniciado" >&2; exit 3; }
  fi
  sync -- "$tmp" 2>/dev/null || true
  mv -f -- "$tmp" "$copia"
  echo "gravada: $copia$([ "$tinha_anterior" = 1 ] && echo " (a anterior ficou em $copia.anterior)")"

  # restart sai do processo na falha; em subshell, a volta da cópia ainda roda.
  local de_pe=""
  if ( restart "$conteiner" ); then
    [ "$espera" -gt 0 ] && sleep "$espera"
    de_pe="$(docker ps --filter "name=^${conteiner}\$" --format '{{.Status}}' 2>/dev/null || true)"
  fi
  case "$de_pe" in
    Up*) echo "ok: $conteiner de pé ($de_pe) com a cópia nova"; return 0 ;;
  esac
  printf 'infra: erro: %s não ficou de pé com a cópia nova (%s)\n' "$conteiner" "${de_pe:-sem status}" >&2
  if [ "$tinha_anterior" = 1 ]; then
    cp -p -- "$copia.anterior" "$copia.volta" && mv -f -- "$copia.volta" "$copia"
    echo "voltou a cópia anterior em $copia; reiniciando $conteiner de novo" >&2
    docker restart "$conteiner" >/dev/null || echo "infra: erro: o restart da cópia anterior também falhou — ver: infra logs $conteiner" >&2
  else
    echo "não havia cópia anterior para voltar — ver: infra logs $conteiner" >&2
  fi
  exit 1
}

# limites: o teto de processos e threads da conta e a memória, lidos juntos, para medir
# `fork: retry: Resource temporarily unavailable` (#3496). Só leitura. fork(2) devolve EAGAIN
# no teto de processos (RLIMIT_NPROC, pids do cgroup, threads-max) e ENOMEM na falta de
# memória; ler os dois na mesma hora separa as causas. --amostrar <s> lê a cada 0,5 s por <s>
# segundos e devolve o pico de threads e de memória do slice e o vale do MemAvailable.
meminfo_kb() {  # $1=campo do /proc/meminfo; imprime o valor em kB, vazio se ausente
  awk -v c="$1:" '$1 == c { print $2; exit }' "${INFRA_MEMINFO:-/proc/meminfo}" 2>/dev/null
}

limites() {
  local uid slice v f amostrar=0
  case "${1:-}" in
    --amostrar) amostrar="${2:?uso: infra limites [--amostrar <segundos>]}" ;;
    "") ;;
    *) echo "uso: infra limites [--amostrar <segundos>]" >&2; exit 2 ;;
  esac
  case "$amostrar" in *[!0-9]*) echo "infra: erro: --amostrar pede segundos inteiros" >&2; exit 2 ;; esac
  uid="$(id -u)"
  slice="/sys/fs/cgroup/user.slice/user-${uid}.slice"
  printf 'conta: %s (uid %s)\n' "$(id -un)" "$uid"
  printf 'ulimit -u (processos+threads da conta): %s\n' "$(ulimit -u)"
  for f in pids.max pids.current memory.max memory.high memory.current; do
    if [ -r "$slice/$f" ]; then v="$(cat "$slice/$f")"; else v="ilegivel"; fi
    printf 'slice %s %s: %s\n' "user-${uid}.slice" "$f" "$v"
  done
  if [ -r "$slice/pids.events" ]; then
    printf 'slice pids.events (max = fork recusado pelo teto de pids): %s\n' "$(tr '\n' ' ' < "$slice/pids.events")"
  fi
  if [ -r "$slice/memory.events" ]; then
    printf 'slice memory.events (oom/oom_kill = falta de memória no slice): %s\n' "$(tr '\n' ' ' < "$slice/memory.events")"
  fi
  printf 'threads vivas da conta agora: %s\n' "$(ps -L -u "$uid" --no-headers 2>/dev/null | wc -l)"
  printf 'memória (kB): MemTotal %s · MemAvailable %s · SwapFree %s de %s · Committed_AS %s · CommitLimit %s\n' \
    "$(meminfo_kb MemTotal)" "$(meminfo_kb MemAvailable)" "$(meminfo_kb SwapFree)" "$(meminfo_kb SwapTotal)" \
    "$(meminfo_kb Committed_AS)" "$(meminfo_kb CommitLimit)"
  for f in /proc/sys/kernel/threads-max /proc/sys/kernel/pid_max /proc/sys/vm/overcommit_memory; do
    [ -r "$f" ] && printf 'kernel %s: %s\n' "$(basename "$f")" "$(cat "$f")"
  done
  [ "$amostrar" -gt 0 ] || return 0

  local fim t pico_t=0 m pico_m=0 a vale_a="" n=0
  fim=$(( $(date +%s) + amostrar ))
  while [ "$(date +%s)" -lt "$fim" ]; do
    t="$(ps -L -u "$uid" --no-headers 2>/dev/null | wc -l)"
    [ "$t" -gt "$pico_t" ] && pico_t="$t"
    if [ -r "$slice/memory.current" ]; then
      m="$(cat "$slice/memory.current")"; [ "$m" -gt "$pico_m" ] && pico_m="$m"
    fi
    a="$(meminfo_kb MemAvailable)"
    if [ -n "$a" ] && { [ -z "$vale_a" ] || [ "$a" -lt "$vale_a" ]; }; then vale_a="$a"; fi
    n=$((n + 1))
    sleep 0.5
  done
  printf 'amostra (%s s, %s leituras): pico de threads da conta %s · pico de memory.current do slice %s B · vale de MemAvailable %s kB\n' \
    "$amostrar" "$n" "$pico_t" "$pico_m" "${vale_a:-ilegivel}"
  return 0
}

# --- despacho ---------------------------------------------------------------

# Sem argumento nenhum: usage, exit 2, nada executado (Q2/Q9).
if [ $# -eq 0 ]; then
  uso
fi

# `infra medir [<eixo>] --help` mostra a ajuda do ato de eixo (face, rótulo e volta) e sai 0, antes da ajuda
# universal, que é o uso geral e sai 2.
if [ "$1" = "medir" ]; then
  _eixo_da_ajuda="${2:-}"
  case "$_eixo_da_ajuda" in -*) _eixo_da_ajuda="" ;; esac
  for _a in "$@"; do
    case "$_a" in
      --ajuda|--help|-h) ajuda_medir "$_eixo_da_ajuda"; exit 0 ;;
    esac
  done
fi

# --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4; Q2). ANTES do
# despacho, varrendo TODOS os argumentos: cobre `infra --ajuda` e `infra <ato> --ajuda`
# em qualquer posição. `uso` já sai 2.
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

cmd="$1"
shift

case "$cmd" in
  estado)    estado "$@" ;;
  saude)     saude "$@" ;;
  logs)      logs "${1:?uso: infra logs <alvo> [n]}" "${2:-50}" ;;
  cache)     cache "${1:-ver}" ;;
  hardware)  hardware "$@" ;;
  limites)   limites "$@" ;;
  gpu)       gpu "$@" ;;
  backup)    backup "$@" ;;
  unit-env)  unit_env "$@" ;;
  instalar)  instalar "$@" ;;
  restart)
    [ $# -ge 1 ] || { echo "erro: restart exige alvo explícito — não reinicia tudo." >&2; exit 2; }
    restart "$@" ;;
  remover)   remover "$@" ;;
  up|down|ps|config|pull|build) cmd_stack "$cmd" "$@" ;;
  limpeza)   cmd_limpeza "$@" ;;
  agenda)    cmd_agenda "$@" ;;
  units)     cmd_units "$@" ;;
  ingress)   ingress "$@" ;;
  medir)     cmd_medir "$@" ;;
  *)
    printf 'infra: erro: ato desconhecido: %s\n' "$cmd" >&2
    printf 'atos: estado, saude, logs, restart, remover, unit-env, cache, hardware, limites, gpu, backup, up, down, ps, config, pull, build, limpeza, agenda, units, ingress, medir\n' >&2
    uso_texto
    exit 2
    ;;
esac
