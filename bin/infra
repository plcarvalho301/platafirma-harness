#!/usr/bin/env bash
# infra — estado e operação da infraestrutura local (contêiner, unit, timer).
# capacidade: infra
# dono: claudinho-TI
# Encapsula as três pegadinhas conhecidas: DOCKER_HOST rootless, restart que
# mata a própria chamada, e alvo que pode ser contêiner ou unit de usuário.
set -euo pipefail

export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/$(id -u)/docker.sock}"
OPS_HEALTH="${INFRA_OPS_HEALTH:-http://127.0.0.1:8010/health}"

uso() {
  cat >&2 <<'FIM'
uso:
  infra estado [alvo]            contêineres, units de usuário e timers, uma tela
  infra saude  [alvo]            /health do ops, contêiner não-saudável, disco, RAM
  infra logs   <alvo> [n]        alvo = nome de contêiner OU unit --user (default 50)
  infra restart <alvo>           destacado: sobrevive ao fim desta chamada

Leitura aceita alvo opcional; sem alvo, olha tudo. Mutação exige alvo explícito e
recusa sem ele. Promover release não é daqui: `deploy <stack>`.
FIM
  exit 2
}

# --- leituras elementares ---------------------------------------------------

conteineres()      { docker ps --format '{{.Names}}\t{{.Status}}' | sort; }
conteineres_doentes() {
  docker ps -a --format '{{.Names}}\t{{.Status}}' \
    | grep -Ei 'exited|unhealthy|restarting' || echo "(nenhum)"
}
units_vivas() {
  systemctl --user list-units --type=service --state=running,failed \
    --no-pager --no-legend | sed 's/^[●*] *//' | awk '{print $1"\t"$4}'
}
units_falhadas()   { systemctl --user list-units --state=failed --no-pager --no-legend || true; }
timers()           { systemctl --user list-timers --no-pager --no-legend | awk '{print $NF"\t"$1,$2,$3}'; }
e_conteiner()      { docker ps -a --format '{{.Names}}' | grep -qx "$1"; }

# --- verbos -----------------------------------------------------------------

estado() {
  local alvo="${1:-}"
  if [ -n "$alvo" ]; then
    e_conteiner "$alvo" && { docker ps -a --format '{{.Names}}\t{{.Status}}' | grep -E "^$alvo\\s" || echo "$alvo: não está em execução"; return; }
    systemctl --user status "$alvo" --no-pager -n 0 || true
    return
  fi
  echo "== contêineres";                        conteineres
  echo; echo "== units de usuário (ativas e falhadas)"; units_vivas
  echo; echo "== timers";                       timers
}

saude() {
  echo -n "ops-mcp /health: "
  curl -sf --max-time 5 "$OPS_HEALTH" || echo "SEM RESPOSTA"
  echo; echo "== contêiner parado ou não-saudável"; conteineres_doentes
  echo; echo "== unit falhada";                     units_falhadas
  echo; echo "== disco e memória"
  df -h / | tail -1
  free -h | sed -n 2p
}

logs() {
  local alvo="$1" n="${2:-50}"
  if e_conteiner "$alvo"; then
    docker logs --tail "$n" "$alvo" 2>&1
  else
    journalctl --user -u "$alvo" -n "$n" --no-pager
  fi
}

# Restart direto do ops-mcp mata a chamada em curso: despachar destacado.
restart() {
  systemd-run --user --collect --unit="infra-restart-$$" \
    systemctl --user restart "$1"
  echo "restart de $1 despachado destacado; conferir com: infra estado"
}

# --- despacho ---------------------------------------------------------------

cmd="${1:-}"; shift || uso

case "$cmd" in
  estado)  estado "${1:-}" ;;
  saude)   saude ;;
  logs)    logs "${1:?uso: infra logs <alvo> [n]}" "${2:-50}" ;;
  restart) [ $# -ge 1 ] || { echo "erro: restart exige alvo explícito — não reinicia tudo." >&2; exit 2; }
           restart "$1" ;;
  compose) echo "erro: promover release saiu do \`infra\` — capacidade \`mudanca\`, verbo \`deploy\`." >&2
           echo "       use: deploy <stack> up -d   (stack e obrigatoria; nao ha alvo default)" >&2
           exit 2 ;;
  *)       uso ;;
esac
