#!/usr/bin/env bash
# repo — opera o clone local de um repositorio da stack, do clone ao PR
# capacidade: construcao
# dono: ti
# classe: B
# forma: predicado (estado, diff) / lista (listar, procurar, historico, pr-listar) / texto (ler, pr-diff) / fluxo (sanear)
# use para: ler, listar ou procurar o que esta na bancada, ainda nao servido (ler, listar, procurar); historico de um caminho e diff contra origin/main (historico, diff); estado do clone; ramo por card; abrir o worktree da cadeira em origin/main ou no sha que esta em producao (abrir --da-producao); commitar so o que a sessao tocou; empurrar; PR de ponta a ponta (pr-abrir, pr-listar, pr-ver, pr-diff, pr-merge); atualizar e sanear o clone; git cru contido (git)
# atos: estado (leitura, operacao), listar (leitura, operacao), ler (leitura, operacao), procurar (leitura, operacao), historico (leitura, operacao), diff (leitura, operacao), commitar (escrita, operacao), ramo (escrita, operacao), atualizar (escrita, operacao), sincronizar (escrita, forge), abrir (escrita, operacao), clonar (escrita, operacao), empurrar (escrita, forge), pr-abrir (escrita, forge), pr-listar (leitura, forge), pr-ver (leitura, forge), pr-diff (leitura, forge), pr-merge (escrita, forge), sanear (escrita, forge), git (escrita, operacao)
# le: estado=repo
# le: listar=repo
# le: ler=repo
# le: procurar=repo
# le: historico=repo
# le: diff=repo
# le: commitar=repo,arquivo-local
# le: ramo=repo
# le: atualizar=repo
# le: sincronizar=repo
# le: abrir=repo
# le: clonar=repo
# le: empurrar=repo
# le: pr-abrir=repo
# le: pr-listar=repo
# le: pr-ver=repo
# le: pr-diff=repo
# le: pr-merge=repo
# le: sanear=repo
# le: git=repo
# escreve: estado=nada
# escreve: listar=nada
# escreve: ler=nada
# escreve: procurar=nada
# escreve: historico=nada
# escreve: diff=nada
# escreve: commitar=repo
# escreve: ramo=repo
# escreve: atualizar=repo
# escreve: sincronizar=repo
# escreve: abrir=repo
# escreve: clonar=repo
# escreve: empurrar=repo
# escreve: pr-abrir=repo
# escreve: pr-listar=nada
# escreve: pr-ver=nada
# escreve: pr-diff=nada
# escreve: pr-merge=repo
# escreve: sanear=repo
# escreve: git=repo
# (recursos pelo enum de ferramental_recurso; o forge - origin, PR - pende id proprio, e ate la sai como repo; commitar le o log da porta em arquivo-local)
# consome: porta@ops-log
# ambiente: PLATAFIRMA_BANCADA[sem default; senao a linha de $HOME/.config/platafirma/bancada; ausente = exit 3] porta · PLATAFIRMA_ARQUIVO_BANCADA[=$HOME/.config/platafirma/bancada] porta · PF_RELEASE_RAIZ[=/opt/platafirma] porta (abrir --da-producao: sha de <raiz>/<repo>/current) · PLATAFIRMA_RELEASE[=$PF_RELEASE_RAIZ/current] porta (registro de familias: URL do forge em abrir/clonar) · PF_CADEIRA porta (lida) · PF_SESSAO porta (lida) · PF_TAREFAS_BIN[=<dir deste verbo>/tarefas] porta (abrir move o card) · OPS_LOG_DIR[=$PLATAFIRMA_INSTANCIA/var/log/ops] porta (PF_OPS_LOG_DIR lido so como alias) · PLATAFIRMA_INSTANCIA[=/srv/platafirma/casa] porta · HOME
# depende: git · gh (pr-*, empurrar, atualizar, clonar) · rede ao forge
# substitui: git -C … ls-files|grep|log|diff|show|status|checkout -b|commit|push|fetch · gh pr create|list|view|diff|merge
# conforme: sim
set -uo pipefail

# Raizes da casa (card #3010): a bancada vem de pf_bancada, sem default; o log da porta
# e o registro de familias derivam da instancia e da release.
. "$(dirname "$(readlink -f "$0")")/../lib/raizes.sh"

VERBO="$(basename "$0")"
BANCADA=""   # preenchida por declara_bancada, depois de uso/ato validados
GH_OWNER="plcarvalho301"
COMO_JSON=0

# Resolução de binário real uma vez, evitando shims no PATH da porta
GIT="$(command -v /usr/bin/git /bin/git 2>/dev/null | head -1)"
[ -x "$GIT" ] || GIT=/usr/bin/git
if [ ! -x "$GIT" ]; then
  printf 'repo: dependência ausente: git não encontrado\n' >&2
  exit 3
fi

GH="$(command -v /usr/bin/gh /bin/gh "$HOME/.local/bin/gh" 2>/dev/null | head -1)"
PATH_FORGE="$PATH"
if [ -n "$GH" ] && [ -x "$GH" ]; then
  PATH_FORGE="$(dirname "$GH"):$PATH"
fi

uso_texto() {
  cat >&2 <<'EOF'
uso:
  repo estado    [<repo>] [--json]
  repo listar    <repo> [<prefixo>] [--json]
  repo ler       <repo> <caminho>
  repo procurar  <repo> --termo <termo> [<prefixo>] [--json]
  repo historico <repo> [<caminho>] [--n <N>] [--json]
  repo diff      <repo> [<caminho>] [--staged]
  repo ramo      <repo> [<card>] [--slug <slug>]
  repo commitar  <repo> -m <msg> [<caminho>…] [--tudo]
  repo empurrar  <repo> [<ramo>]
  repo atualizar <repo>
  repo sincronizar <repo>
  repo abrir     <repo> [<card>] [--slug <s>] [--da-producao]
  repo clonar    <url|owner/nome> [<nome>]
  repo sanear    [<repo>] [--relatar]
  repo pr-abrir  <repo> --titulo <t> [--corpo <c>] [--base <ramo>]
  repo pr-listar <repo> [--todos]
  repo pr-ver    <repo> <numero>
  repo pr-diff   <repo> <numero>
  repo pr-merge  <repo> <numero> [--squash|--merge|--rebase] [--forcar]
  repo git       <repo> <args…>

bancada: PLATAFIRMA_BANCADA[sem default] (exit 3)
<repo> resolve wt/<repo>/<cadeira>/<card-ou-slug>; com mais de uma bancada aberta na
cadeira, nomeie-a: <repo>@<card-ou-slug> (ex.: platafirma-harness@3149-bancada-por-card)
exit: 0 achou/fez · 1 nao existe/negativo · 2 uso · 3 dependencia · 4 politica · 5 indeterminavel
EOF
}

uso() {
  if [ "$COMO_JSON" -eq 1 ]; then
    python3 -c 'import sys, json; print(json.dumps({"erro": sys.argv[1]}))' "uso incorreto"
    exit 2
  fi
  uso_texto
  exit 2
}

morre() {
  local msg="$1" rc="${2:-3}"
  if [ "$COMO_JSON" -eq 1 ]; then
    python3 -c 'import sys, json; print(json.dumps({"erro": sys.argv[1]}))' "$msg"
  else
    printf '%s: %s\n' "$VERBO" "$msg" >&2
  fi
  exit "$rc"
}

# Bancada declarada pela conta (desenho §6/§9). Sem declaracao: exit 3, nunca criacao
# silenciosa. Nenhum ato cria diretorio aqui; so abrir e clonar criam, e so ao clonar.
declara_bancada() {
  if ! BANCADA="$(pf_bancada)"; then
    case " $* " in
      *" --json "*) python3 -c 'import sys, json; print(json.dumps({"erro": sys.argv[1]}))' "bancada nao declarada" ;;
    esac
    exit 3
  fi
  case "$BANCADA" in
    /*) BANCADA="${BANCADA%/}" ;;
    *) printf '%s: bancada declarada nao e caminho absoluto: %s\n' "$VERBO" "$BANCADA" >&2; exit 3 ;;
  esac
}

# URL do forge de um repo: registro de familias da release, senao a URL canonica.
# Nunca lida de clone local (remote de clone de bancada nao e fonte).
url_forge() {
  local nome="$1" reg="$PLATAFIRMA_RELEASE/harness/registro/familias.json" url=""
  if [ -r "$reg" ]; then
    url="$(python3 -c '
import sys, json
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(0)
if isinstance(d, dict) and isinstance(d.get("familias"), (dict, list)):
    d = d["familias"]
e = None
if isinstance(d, dict):
    e = d.get(sys.argv[2])
elif isinstance(d, list):
    for x in d:
        if isinstance(x, dict) and sys.argv[2] in (x.get("familia"), x.get("nome"), x.get("repo")):
            e = x
            break
if isinstance(e, dict):
    e = e.get("url") or e.get("forge") or e.get("origem")
if isinstance(e, str) and e:
    print(e)
' "$reg" "$nome" 2>/dev/null)"
  fi
  [ -n "$url" ] || url="https://github.com/$GH_OWNER/$nome.git"
  printf '%s' "$url"
}

# chave_de <card> <slug> -- nome da pasta sob wt/<repo>/<cadeira>/ para este card/slug,
# igual ao sufixo do ramo fabrica/<...> (card:3149 passo 3; exemplo do card: wt/demo/ti/42-x).
chave_de() {
  local card="$1" slug="$2"
  if [ -n "$card" ]; then
    local card_num="${card###}"
    if [[ "$card_num" =~ ^[0-9]+$ ]]; then
      if [ -n "$slug" ]; then printf '%s-%s' "$card_num" "$slug"; else printf '%s' "$card_num"; fi
    else
      if [ -n "$slug" ]; then printf '%s-%s' "$card" "$slug"; else printf '%s' "$card"; fi
    fi
  elif [ -n "$slug" ]; then
    printf '%s' "$slug"
  else
    printf '_avulso'
  fi
}

# Resolucao de bancada: <bancada>/wt/<repo>/<cadeira>/<card-ou-slug> (arq:0109, arq:0110,
# card:3149 passo 3). Com $2 (chave): so aquele card/slug, sem varredura. Sem $2: um
# worktree aninhado so, usa-o; mais de um e AMBIGUO -- rc 2 (candidatas_de lista),
# e quem chama pede a chave (<repo>@<chave>). Nao ha desempate por heuristica: mtime do
# .git da worktree e a hora do add, nao do uso, e escolher errado commita no card alheio.
# Sem worktree aninhado: le o legado de antes do passo 3 (plano por cadeira, ou por
# sessao). Nada encontrado: string vazia e rc 1, sem fallback ao cache (clone_de decide).
cadeira_da_sessao() {
  local c="${PF_CADEIRA:-}"
  c="${c#claudinho-}"; c="${c#claudinha-}"
  printf '%s' "$c"
}

# candidatas_de <repo> <cadeira> -- as bancadas aninhadas da cadeira, uma por linha. A pasta
# plana legada (wt/<repo>/<cadeira> que e ela propria worktree) nao tem aninhadas por desenho:
# abrir migra a plana antes de criar a primeira aninhada (nunca worktree dentro de worktree).
candidatas_de() {
  local nome="$1" cadeira="$2" d
  [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira" ] || return 0
  [ -e "$BANCADA/wt/$nome/$cadeira/.git" ] && return 0
  for d in "$BANCADA/wt/$nome/$cadeira"/*/; do
    [ -e "${d%/}/.git" ] && printf '%s\n' "${d%/}"
  done
}

bancada_de() {
  local nome="$1"
  local chave="${2:-}"
  local cadeira="${PF_CADEIRA:-}"
  cadeira="${cadeira#claudinho-}"
  cadeira="${cadeira#claudinha-}"
  local sid="${PF_SESSAO:-}"

  if [ -n "$chave" ]; then
    if [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira/$chave" ] && [ -e "$BANCADA/wt/$nome/$cadeira/$chave/.git" ]; then
      printf '%s/wt/%s/%s/%s' "$BANCADA" "$nome" "$cadeira" "$chave"
      return 0
    fi
    return 1
  fi

  if [ -n "$cadeira" ] && [ -d "$BANCADA/wt/$nome/$cadeira" ]; then
    local cands=() d
    while IFS= read -r d; do [ -n "$d" ] && cands+=("$d"); done < <(candidatas_de "$nome" "$cadeira")
    if [ "${#cands[@]}" -eq 1 ]; then
      printf '%s' "${cands[0]}"
      return 0
    elif [ "${#cands[@]}" -gt 1 ]; then
      return 2
    fi
    if [ -e "$BANCADA/wt/$nome/$cadeira/.git" ]; then
      printf '%s/wt/%s/%s' "$BANCADA" "$nome" "$cadeira"
      return 0
    fi
  fi

  if [ -n "$sid" ] && [ -d "$BANCADA/wt/$nome/$sid" ] && [ -e "$BANCADA/wt/$nome/$sid/.git" ]; then
    printf '%s/wt/%s/%s' "$BANCADA" "$nome" "$sid"
    return 0
  fi

  return 1
}

listar_repos() {
  local r=()
  if [ -d "$BANCADA" ]; then
    for d in "$BANCADA"/*; do
      if [ -e "$d/.git" ]; then
        r+=("$(basename "$d")")
      fi
    done
  fi
  printf '%s\n' "${r[@]}"
}

clone_de() {
  local nome="${1:-}"
  [ -n "$nome" ] || {
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "falta o nome do repo" 2
    fi
    printf '%s: erro: falta o nome do repo\n' "$VERBO" >&2
    uso
  }

  if [ "$nome" = "pull" ]; then
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "ordem trocada: 'repo git pull <repo>' — use 'repo atualizar <repo>'" 2
    fi
    printf '%s: ordem trocada: '\''repo git pull <repo>'\'' — use '\''repo atualizar <repo>'\''\n' "$VERBO" >&2
    printf 'repositórios disponíveis:\n' >&2
    local lr; lr="$(listar_repos)"
    if [ -n "$lr" ]; then printf '%s\n' "$lr" | sed 's/^/  /' >&2; else printf '  (nenhum)\n' >&2; fi
    uso_texto
    exit 2
  elif [ "$nome" = "-C" ]; then
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "ordem trocada: 'repo git -C <repo>' — use 'repo <ato> <repo>'" 2
    fi
    printf '%s: ordem trocada: '\''repo git -C <repo>'\'' — use '\''repo <ato> <repo>'\''\n' "$VERBO" >&2
    printf 'repositórios disponíveis:\n' >&2
    local lr; lr="$(listar_repos)"
    if [ -n "$lr" ]; then printf '%s\n' "$lr" | sed 's/^/  /' >&2; else printf '  (nenhum)\n' >&2; fi
    uso_texto
    exit 2
  fi

  local chave=""
  case "$nome" in
    *@*) chave="${nome#*@}"; nome="${nome%%@*}" ;;
  esac
  case "$nome" in
    */*|.*|*..*) morre "nome de repo invalido: '$nome' — e slug dentro da bancada $BANCADA, nao caminho" 4 ;;
    *[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$nome' — use [A-Za-z0-9._-]" 4 ;;
  esac
  case "$chave" in
    */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "chave de bancada invalida: '$chave' — use <repo>@<card-ou-slug>" 2 ;;
  esac

  local alvo rc_b
  alvo="$(bancada_de "$nome" "$chave")"; rc_b=$?
  if [ "$rc_b" -eq 2 ]; then
    [ "$COMO_JSON" -eq 1 ] && morre "mais de uma bancada aberta de '$nome' nesta cadeira — nomeie <repo>@<chave>" 2
    printf '%s: mais de uma bancada aberta de '\''%s'\'' nesta cadeira — nomeie qual:\n' "$VERBO" "$nome" >&2
    candidatas_de "$nome" "$(cadeira_da_sessao)" | while IFS= read -r d; do
      printf '  %s@%s  (%s @ %s)\n' "$nome" "$(basename "$d")" "$(ramo_atual "$d")" "$("$GIT" -C "$d" rev-parse --short HEAD 2>/dev/null)" >&2
    done
    printf 'vizinho: repo <ato> %s@<chave>\n' "$nome" >&2
    exit 2
  fi
  if [ -z "$alvo" ] && [ -n "$chave" ]; then
    [ "$COMO_JSON" -eq 1 ] && morre "sem bancada '$nome@$chave' nesta cadeira" 1
    printf '%s: sem bancada '\''%s@%s'\'' nesta cadeira\n' "$VERBO" "$nome" "$chave" >&2
    printf 'vizinho: repo abrir %s <card> --slug <s>\n' "$nome" >&2
    exit 1
  fi
  if [ -z "$alvo" ]; then
    if [ -e "$BANCADA/$nome" ]; then
      # card:3149 passo 3: clone base existe, so falta o worktree desta cadeira -- sem
      # fallback ao cache (spec_ambiente-de-desenvolvimento §2).
      if [ "$COMO_JSON" -eq 1 ]; then
        morre "sem bancada aberta para '$nome' nesta cadeira" 1
      fi
      printf '%s: sem bancada aberta para '\''%s'\'' nesta cadeira\n' "$VERBO" "$nome" >&2
      printf 'vizinho: repo abrir %s <card> --slug <s>\n' "$nome" >&2
      exit 1
    fi
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "repositório desconhecido: '$nome'" 2
    fi
    printf '%s: repositório desconhecido: '\''%s'\''\n' "$VERBO" "$nome" >&2
    printf 'repositórios disponíveis:\n' >&2
    local lr; lr="$(listar_repos)"
    if [ -n "$lr" ]; then printf '%s\n' "$lr" | sed 's/^/  /' >&2; else printf '  (nenhum)\n' >&2; fi
    uso_texto
    exit 2
  fi

  local real; real="$(realpath "$alvo" 2>/dev/null)" || morre "nao resolvi '$alvo'" 4
  local raiz_real; raiz_real="$(realpath "$BANCADA" 2>/dev/null || printf '%s' "$BANCADA")"
  case "$real/" in
    "$BANCADA"/*|"$raiz_real"/*) : ;;
    *) morre "'$nome' resolve para $real, fora da bancada $BANCADA" 4 ;;
  esac

  if ! "$GIT" -C "$real" rev-parse --git-dir >/dev/null 2>&1; then
    morre "indeterminavel: o git recusa o clone '$nome' — $("$GIT" -C "$real" rev-parse --git-dir 2>&1 | head -1)" 5
  fi

  printf '%s' "$real"
}

# base_de_repo <repo> -- o clone base, para os atos que so falam com o forge (pr-listar, pr-ver,
# pr-diff, pr-merge): nao dependem de bancada aberta (spec_ambiente-de-desenvolvimento §2).
base_de_repo() {
  local n="${1:-}"; n="${n%%@*}"
  [ -n "$n" ] || morre "falta o nome do repo" 2
  case "$n" in */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$n'" 4 ;; esac
  [ -e "$BANCADA/$n/.git" ] || morre "repositório desconhecido: '$n'" 2
  printf '%s' "$BANCADA/$n"
}

ramo_atual() {
  local c="$1"
  "$GIT" -C "$c" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD"
}

# [3096] Um ramo pertence a esta cadeira? Aceita main/master, o proprio prefixo
# <cadeira>/*, os ramos de fabrica (fabrica/*) e o caderno da cadeira
# (caderno/<cadeira>/*). Sem PF_CADEIRA, nao barra (exit 0). Retorna 1 se e ramo
# de outra cadeira.
ramo_da_cadeira() {
  local ramo="$1"
  local cad="${PF_CADEIRA:-}"
  cad="${cad#claudinho-}"
  cad="${cad#claudinha-}"
  [ -z "$cad" ] && return 0
  case "$ramo" in
    main|master) return 0 ;;
    "$cad"/*) return 0 ;;
    fabrica/*) return 0 ;;
    caderno/"$cad"/*) return 0 ;;
    *) return 1 ;;
  esac
}

info_varrido() {
  local c="$1" repo="$2"
  local cadeira="${PF_CADEIRA:-sem-cadeira}"
  local ramo; ramo="$(ramo_atual "$c")"
  local sha; sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "0000000")"
  local sujo; sujo="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
  local estado_arvore="árvore limpa"
  [ "${sujo:-0}" -gt 0 ] && estado_arvore="árvore suja"
  printf 'varrido: bancada %s/%s (%s @ %s, %s)\n' "$repo" "$cadeira" "$ramo" "$sha" "$estado_arvore" >&2
}

tem_gh() {
  [ -n "$GH" ] && [ -x "$GH" ] \
    || morre "'gh' nao esta no PATH desta conta — o endpoint do forge nao esta alcancavel daqui" 3
}

ato_git() {
  local nome="${1:-}"; shift || uso
  if [ "${1:-}" = pull ] && [ $# -eq 1 ]; then
    ato_atualizar "$nome"
    return $?
  fi
  local c; c="$(clone_de "$nome")" || exit $?

  # [3096] Recusa git cru add -A
  if [ "${1:-}" = "add" ]; then
    for arg in "$@"; do
      if [ "$arg" = "-A" ] || [ "$arg" = "--all" ]; then
        morre "git cru recusa add -A. Use caminhos explicitos ou 'repo commitar'." 3
      fi
    done
  fi

  # [3096] Recusa commit em ramo de outra cadeira
  if [ "${1:-}" = "commit" ]; then
    local ramo_atual
    ramo_atual="$(ramo_atual "$c")"
    ramo_da_cadeira "$ramo_atual" || morre "commit recusado: o ramo '$ramo_atual' pertence a outra cadeira (esperados: <cadeira>/*, fabrica/*, caderno/<cadeira>/*, main)." 3
  fi

  if [ "${1:-}" = apply ]; then
    shift
    local tem_unidiff=0
    for arg in "$@"; do
      if [ "$arg" = "--unidiff-zero" ]; then
        tem_unidiff=1
        break
      fi
    done
    if [ "$tem_unidiff" -eq 0 ]; then
      set -- apply --unidiff-zero "$@"
    else
      set -- apply "$@"
    fi
  fi
  if [ "${1:-}" = grep ]; then
    local rc=0
    env PATH="$PATH_FORGE" "$GIT" -C "$c" "$@" || rc=$?
    if [ "$rc" -eq 1 ]; then
      printf 'veredito: sem ocorrencias\n' >&2
    fi
    return "$rc"
  fi
  exec env PATH="$PATH_FORGE" "$GIT" -C "$c" "$@"
}

cmd_estado() {
  local como_json=0
  local repo_alvo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo_alvo" ]; then
          repo_alvo="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done

  if [ -z "$repo_alvo" ]; then
    local repos=()
    while IFS= read -r r; do
      [ -n "$r" ] && repos+=("$r")
    done < <(listar_repos)

    if [ "$como_json" -eq 1 ]; then
      local json_recs=()
      for r in "${repos[@]}"; do
        local c; c="$(bancada_de "$r")"
        [ -n "$c" ] || continue
        local ramo sha sujo_qtd trilha upstream
        ramo="$(ramo_atual "$c")"
        sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "")"
        sujo_qtd="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
        upstream="$("$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo "")"
        local atras=0 frente=0
        if [ -n "$upstream" ]; then
          read -r atras frente < <("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null || echo "0 0")
        fi
        json_recs+=("$(python3 -c '
import sys, json
print(json.dumps({
  "repo": sys.argv[1],
  "ramo": sys.argv[2],
  "sha": sys.argv[3],
  "upstream": sys.argv[4] or None,
  "atras": int(sys.argv[5]),
  "a_frente": int(sys.argv[6]),
  "limpo": int(sys.argv[7]) == 0,
  "alteracoes": int(sys.argv[7])
}))' "$r" "$ramo" "$sha" "$upstream" "${atras:-0}" "${frente:-0}" "${sujo_qtd:-0}")")
      done
      python3 -c '
import sys, json
recs = [json.loads(l) for l in sys.stdin.read().splitlines() if l]
print(json.dumps({"bancadas": {r["repo"]: r for r in recs}}, indent=2))' <<<"$(printf '%s\n' "${json_recs[@]}")"
      return 0
    fi

    printf 'clones em %s\n' "$BANCADA"
    for r in "${repos[@]}"; do
      local c rc_b; c="$(bancada_de "$r")"; rc_b=$?
      if [ -z "$c" ]; then
        printf '  %-28s %s\n' "$r" "$([ "$rc_b" -eq 2 ] && echo 'mais de uma bancada: nomeie <repo>@<chave>' || echo 'sem bancada nesta cadeira')"
        continue
      fi
      local ramo sujo
      if ! ramo="$("$GIT" -C "$c" rev-parse --abbrev-ref HEAD 2>&1)"; then
        printf '  %-28s %-34s %s\n' "$r" "-" "indeterminavel: $(printf '%s' "$ramo" | head -1)"
        continue
      fi
      sujo="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
      printf '  %-28s %-34s %s\n' "$r" "$ramo" \
        "$([ "${sujo:-0}" -eq 0 ] && echo limpo || echo "$sujo alteracao(oes)")"
    done
    return 0
  fi

  local c; c="$(clone_de "$repo_alvo")" || exit $?
  # spec_ambiente-de-desenvolvimento §2: o atraso contra origin/main se mede depois de
  # buscar o forge; sem forge, o numero vira '?' declarado, nunca o da copia velha.
  local atras_main="?" nota_forge=""
  if git_sem_engolir "$c" fetch --prune origin; then
    atras_main="$("$GIT" -C "$c" rev-list --count HEAD..origin/main 2>/dev/null || echo '?')"
  else
    nota_forge="forge inalcancavel: $REPLY"
  fi
  local ramo sha sujo_qtd trilha upstream
  ramo="$(ramo_atual "$c")"
  sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "")"
  sujo_qtd="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
  upstream="$("$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo "")"
  local atras=0 frente=0
  if [ -n "$upstream" ]; then
    read -r atras frente < <("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null || echo "0 0")
  fi
  local ultimo; ultimo="$("$GIT" -C "$c" log -1 --format='%h %s  (%an, %ar)' 2>/dev/null || echo "")"

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
print(json.dumps({
  "repo": sys.argv[1],
  "ramo": sys.argv[2],
  "sha": sys.argv[3],
  "upstream": sys.argv[4] or None,
  "atras": int(sys.argv[5]),
  "a_frente": int(sys.argv[6]),
  "limpo": int(sys.argv[7]) == 0,
  "alteracoes": int(sys.argv[7]),
  "ultimo_commit": sys.argv[8] or None,
  "atras_de_origin_main": (int(sys.argv[9]) if sys.argv[9].isdigit() else None),
  "bancada": sys.argv[10],
  "forge": sys.argv[11] or "ok"
}, indent=2))' "$repo_alvo" "$ramo" "$sha" "$upstream" "${atras:-0}" "${frente:-0}" "${sujo_qtd:-0}" "$ultimo" "$atras_main" "$c" "$nota_forge"
    return 0
  fi

  printf '%s  ·  ramo %s  ·  bancada %s\n' "$repo_alvo" "$ramo" "${c#"$BANCADA"/}"
  printf '  origin/main  ·  atras %s%s\n' "$atras_main" "${nota_forge:+  ($nota_forge)}"
  if [ -n "$upstream" ]; then
    printf '  upstream %s  ·  atras %s  ·  a frente %s\n' "$upstream" "${atras:-0}" "${frente:-0}"
  else
    printf '  sem upstream (ramo local ainda nao empurrado)\n'
  fi
  printf '  ultimo   %s\n' "$ultimo"
  local st; st="$("$GIT" -C "$c" status --short 2>/dev/null)"
  if [ -n "$st" ]; then
    printf '  arvore suja:\n%s\n' "$(printf '%s' "$st" | sed 's/^/    /')"
  else
    printf '  arvore limpa\n'
  fi
  return 0
}

cmd_listar() {
  local como_json=0 repo="" prefixo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] || morre "repo obrigatório para listar" 2

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      morre "prefixo fora da raiz ou símbolo que escapa: '$prefixo'" 4
    fi
  fi

  local files
  if [ -n "$prefixo" ]; then
    files="$("$GIT" -C "$c" ls-files -- "$prefixo" 2>/dev/null || true)"
  else
    files="$("$GIT" -C "$c" ls-files 2>/dev/null || true)"
  fi

  if [ -z "$files" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"repo": sys.argv[1], "arquivos": [], "total": 0, "motivo": "nenhum arquivo encontrado sob '\''" + sys.argv[2] + "'\''"}, indent=2))' "$repo" "${prefixo:-.}"
    else
      printf 'motivo: nenhum arquivo encontrado sob '\''%s'\''\n' "${prefixo:-.}"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c 'import sys, json; arqs = [l for l in sys.stdin.read().splitlines() if l]; print(json.dumps({"repo": sys.argv[1], "arquivos": arqs, "total": len(arqs)}, indent=2))' "$repo" <<<"$files"
  else
    printf '%s\n' "$files"
  fi
  return 0
}

cmd_ler() {
  local repo="" caminho=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] && [ -n "$caminho" ] || morre "repo e caminho são obrigatórios para ler" 2

  local c; c="$(clone_de "$repo")" || exit $?

  if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
    morre "caminho fora da raiz ou símbolo que escapa: '$caminho'" 4
  fi

  local alvo_arquivo="$c/$caminho"
  if [ ! -f "$alvo_arquivo" ]; then
    info_varrido "$c" "$repo"
    printf 'vizinho: release ler %s %s\n' "$repo" "$caminho" >&2
    exit 1
  fi

  cat "$alvo_arquivo"

  local ramo; ramo="$(ramo_atual "$c")"
  local sha; sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "")"
  local mod=""
  if ! "$GIT" -C "$c" diff --quiet HEAD -- "$caminho" 2>/dev/null; then
    mod=" (modificado)"
  elif ! "$GIT" -C "$c" ls-files --error-unmatch "$caminho" >/dev/null 2>&1; then
    mod=" (modificado)"
  fi
  printf 'versão: %s@%s%s\n' "$ramo" "$sha" "$mod" >&2
  return 0
}

cmd_procurar() {
  local como_json=0 repo="" termo="" prefixo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      --termo)
        shift
        [ $# -gt 0 ] || morre "--termo exige um valor" 2
        termo="$1"
        shift
        ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || morre "repo obrigatório para procurar" 2
  [ -n "$termo" ] || morre "--termo <termo> é obrigatório para procurar" 2

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      morre "prefixo fora da raiz ou símbolo que escapa: '$prefixo'" 4
    fi
  fi

  local out=""
  if [ -n "$prefixo" ]; then
    out="$("$GIT" -C "$c" grep -n -F -- "$termo" -- "$prefixo" 2>/dev/null || true)"
  else
    out="$("$GIT" -C "$c" grep -n -F -- "$termo" 2>/dev/null || true)"
  fi

  if [ -z "$out" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"repo": sys.argv[1], "termo": sys.argv[2], "ocorrencias": [], "total": 0, "motivo": "termo não encontrado na bancada"}, indent=2))' "$repo" "$termo"
    else
      printf 'motivo: termo '\''%s'\'' não encontrado na bancada %s\n' "$termo" "$repo"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
linhas = [l for l in sys.stdin.read().splitlines() if l]
ocorr = []
for l in linhas:
    partes = l.split(":", 2)
    if len(partes) >= 3:
        ocorr.append({"caminho": partes[0], "linha": int(partes[1]) if partes[1].isdigit() else partes[1], "texto": partes[2]})
    else:
        ocorr.append({"linha_crua": l})
print(json.dumps({"repo": sys.argv[1], "termo": sys.argv[2], "ocorrencias": ocorr, "total": len(ocorr)}, indent=2))
' "$repo" "$termo" <<<"$out"
  else
    printf '%s\n' "$out"
  fi
  return 0
}

cmd_historico() {
  local como_json=0 repo="" caminho="" n_commits="10"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      --n)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: --n exige um número\n' "$VERBO" >&2; uso; }
        n_commits="$1"
        shift
        ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] || { printf '%s: erro: repo obrigatório para historico\n' "$VERBO" >&2; uso; }
  case "$n_commits" in *[!0-9]*) morre "número de commits inválido: '$n_commits'" 2 ;; esac

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$caminho" ]; then
    if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
      morre "caminho fora da raiz ou símbolo que escapa: '$caminho'" 4
    fi
    if [ ! -e "$c/$caminho" ] && [ -z "$("$GIT" -C "$c" log -1 --format='%h' -- "$caminho" 2>/dev/null)" ]; then
      info_varrido "$c" "$repo"
      printf 'vizinho: release ler %s %s\n' "$repo" "$caminho" >&2
      exit 1
    fi
  fi

  local log_fmt='%h%x09%ad%x09%an%x09%s'
  local out=""
  if [ -n "$caminho" ]; then
    out="$("$GIT" -C "$c" log -n "$n_commits" --format="$log_fmt" --date=short -- "$caminho" 2>/dev/null || true)"
  else
    out="$("$GIT" -C "$c" log -n "$n_commits" --format="$log_fmt" --date=short 2>/dev/null || true)"
  fi

  if [ -z "$out" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"repo": sys.argv[1], "caminho": sys.argv[2] or None, "commits": [], "total": 0, "motivo": "nenhum commit encontrado"}, indent=2))' "$repo" "$caminho"
    else
      printf 'motivo: nenhum commit encontrado\n'
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
linhas = [l for l in sys.stdin.read().splitlines() if l]
commits = []
for l in linhas:
    partes = l.split("\t", 3)
    if len(partes) == 4:
        commits.append({"sha": partes[0], "data": partes[1], "autor": partes[2], "mensagem": partes[3]})
    else:
        commits.append({"linha_crua": l})
print(json.dumps({"repo": sys.argv[1], "caminho": sys.argv[2] or None, "commits": commits, "total": len(commits)}, indent=2))
' "$repo" "$caminho" <<<"$out"
  else
    python3 -c '
import sys
for l in sys.stdin.read().splitlines():
    if not l: continue
    partes = l.split("\t", 3)
    if len(partes) == 4:
        print(f"{partes[0]} {partes[1]} {partes[2]}: {partes[3]}")
    else:
        print(l)
' <<<"$out"
  fi
  return 0
}

cmd_diff() {
  local staged=0 repo="" caminho=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --staged) staged=1; shift ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] || { printf '%s: erro: repo obrigatório para diff\n' "$VERBO" >&2; uso; }

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$caminho" ]; then
    if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
      morre "caminho fora da raiz ou símbolo que escapa: '$caminho'" 4
    fi
  fi

  if [ "$staged" -eq 1 ]; then
    if [ -n "$caminho" ]; then
      "$GIT" -C "$c" diff --staged -- "$caminho"
    else
      "$GIT" -C "$c" diff --staged
    fi
  else
    local base_ref=""
    if "$GIT" -C "$c" rev-parse --verify origin/main >/dev/null 2>&1; then
      base_ref="origin/main"
    elif "$GIT" -C "$c" rev-parse --verify main >/dev/null 2>&1; then
      base_ref="main"
    fi

    if [ -n "$base_ref" ]; then
      if [ -n "$caminho" ]; then
        "$GIT" -C "$c" diff "$base_ref" -- "$caminho"
      else
        "$GIT" -C "$c" diff "$base_ref"
      fi
    else
      if [ -n "$caminho" ]; then
        "$GIT" -C "$c" diff -- "$caminho"
      else
        "$GIT" -C "$c" diff
      fi
    fi
  fi
  return 0
}

ato_atualizar() {
  local nome="${1:-}" c ramo up
  c="$(clone_de "$nome")" || exit $?
  ramo="$(ramo_atual "$c")"
  case "$ramo" in
    HEAD) morre "HEAD destacado em '$nome' — sem ramo para atualizar" 3 ;;
  esac
  up="$("$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" \
    || morre "'$ramo' nao tem upstream — nada para puxar" 3
  env PATH="$PATH_FORGE" "$GIT" -C "$c" fetch --prune origin || morre "git fetch falhou" 3

  local atras frente
  read -r atras frente < <("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null || echo "0 0")
  if [ "${atras:-0}" -eq 0 ]; then
    printf 'já em dia: %s/%s (@ %s)\n' "$nome" "$ramo" "$("$GIT" -C "$c" rev-parse --short HEAD)"
    exit 1
  fi

  if ! "$GIT" -C "$c" merge --ff-only "@{upstream}" >/dev/null 2>&1; then
    local trilha
    trilha="$("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null)"
    morre "recuso atualizar '$nome': '$ramo' divergiu de '$up' (atras/frente: ${trilha:-?}). ff-only nao funde nem forca — reconcilie a mao com \`repo ramo\` + merge/rebase deliberado." 4
  fi
  printf 'atualizado: %s/%s -> %s\n' "$nome" "$ramo" \
    "$("$GIT" -C "$c" log -1 --format='%h %s')"
}

# sincronizar <repo> -- traz main para o ramo do card e deixa o ramo empurrado (spec_ambiente-
# de-desenvolvimento §2; spec_repo §2: o UNICO ato de repo que mescla, e so por chamada da
# cadeira). Mescla, nunca rebase. Em ordem, cada passo com exit proprio:
#   busca o forge (falhou: 5) -> arvore suja: 4, vizinho commitar -> ramo do card do origin,
#   ff-only (divergido: 4, vizinho atualizar) -> merge origin/main (conflito: aborta, bancada
#   intacta, 4 com a lista) -> empurra -> confirma o sha no forge (ls-remote).
# main sem nada novo e ramo ja no origin: 0, "ja em dia", nada muda.
ato_sincronizar() {
  local nome="${1:-}"
  [ -n "$nome" ] || uso
  [ $# -le 1 ] || morre "argumento excedente: '$2'" 2
  local c; c="$(clone_de "$nome")" || exit $?
  local ramo; ramo="$(ramo_atual "$c")"
  case "$ramo" in
    HEAD|main|master) morre "sincronizar e do ramo de card — '$ramo' nao se sincroniza" 4 ;;
  esac
  git_sem_engolir "$c" fetch --prune origin || morre "indeterminavel: fetch do forge falhou ($REPLY)" 5

  local st; st="$("$GIT" -C "$c" status --porcelain 2>/dev/null)" || morre "indeterminavel: git status falhou" 5
  if [ -n "$st" ]; then
    printf '%s: arvore com escrita nao commitada (%s) — nao mesclo sobre ela\n' "$VERBO" "$(printf '%s\n' "$st" | wc -l) arquivo(s)" >&2
    printf 'vizinho: repo commitar %s\n' "$nome" >&2
    exit 4
  fi

  local fsha rc
  fsha="$(forge_sha "$c" "$ramo")"; rc=$?
  [ "$rc" -eq 5 ] && morre "indeterminavel: nao li origin/$ramo ($fsha)" 5
  if [ "$rc" -eq 0 ] && ! "$GIT" -C "$c" merge-base --is-ancestor "$fsha" HEAD 2>/dev/null; then
    if "$GIT" -C "$c" merge-base --is-ancestor HEAD "$fsha" 2>/dev/null; then
      "$GIT" -C "$c" merge -q --ff-only "$fsha" >/dev/null 2>&1 || morre "ff-only de origin/$ramo falhou" 3
    else
      printf '%s: %s divergiu de origin/%s — nao mesclo main sobre ramo divergido\n' "$VERBO" "$ramo" "$ramo" >&2
      printf 'vizinho: repo atualizar %s\n' "$nome" >&2
      exit 4
    fi
  fi

  local antes; antes="$("$GIT" -C "$c" rev-parse HEAD)"
  local main; main="$("$GIT" -C "$c" rev-parse --verify -q origin/main)" || morre "indeterminavel: sem origin/main" 5
  local mesclou=0 novos=0
  if ! "$GIT" -C "$c" merge-base --is-ancestor "$main" HEAD 2>/dev/null; then
    novos="$("$GIT" -C "$c" rev-list --count "HEAD..$main")"
    if ! "$GIT" -C "$c" merge -q --no-edit "$main" >/dev/null 2>&1; then
      local conflito; conflito="$("$GIT" -C "$c" diff --name-only --diff-filter=U 2>/dev/null)"
      "$GIT" -C "$c" merge --abort >/dev/null 2>&1
      if [ "$("$GIT" -C "$c" rev-parse HEAD)" != "$antes" ] || [ -n "$("$GIT" -C "$c" status --porcelain)" ]; then
        morre "indeterminavel: o merge falhou e a bancada nao voltou a ${antes:0:7} — confira a mao" 5
      fi
      printf '%s: conflito ao mesclar origin/main (%s) em %s — abortado, bancada intacta em %s\n' \
        "$VERBO" "${main:0:7}" "$ramo" "${antes:0:7}" >&2
      printf '%s\n' "$conflito" | sed 's/^/  conflito: /' >&2
      printf 'vizinho: resolva os arquivos, repo commitar %s, e sincronizar de novo\n' "$nome" >&2
      exit 4
    fi
    mesclou=1
  fi

  local head; head="$("$GIT" -C "$c" rev-parse HEAD)"
  if [ "$mesclou" -eq 0 ] && [ "$rc" -eq 0 ] && [ "$(forge_sha "$c" "$ramo")" = "$head" ]; then
    printf 'já em dia: %s @ %s, origin/%s igual, origin/main %s ja contido\n' "$ramo" "${head:0:7}" "$ramo" "${main:0:7}"
    return 0
  fi

  # stderr do push segue visivel: e onde o pre-push diz o que barrou
  # o stdout do push e o do hook: a linha do pre-push (chave, rodou|reaproveitou) vai ao
  # stderr, visivel, em vez de sumir em /dev/null (card #3150)
  env PATH="$PATH_FORGE" "$GIT" -C "$c" push -u origin "$ramo" >&2
  fsha="$(forge_sha "$c" "$ramo")"; rc=$?
  if [ "$rc" -eq 0 ] && [ "$fsha" = "$head" ]; then
    if [ "$mesclou" -eq 1 ]; then
      printf 'sincronizado: %s = %s (mesclou origin/main %s, %s commit(s) novo(s)); origin/%s = %s [lido do forge]\n' \
        "$ramo" "${head:0:7}" "${main:0:7}" "$novos" "$ramo" "${fsha:0:7}"
    else
      printf 'sincronizado: %s = %s (main ja contido); origin/%s = %s [lido do forge]\n' \
        "$ramo" "${head:0:7}" "$ramo" "${fsha:0:7}"
    fi
    return 0
  fi
  [ "$rc" -eq 5 ] && morre "indeterminavel: empurrei? o forge nao respondeu ($fsha)" 5
  morre "push falhou: local ${head:0:7}, origin/$ramo $([ -n "$fsha" ] && echo "${fsha:0:7}" || echo ausente) (o pre-push barrou? ver acima)$([ "$mesclou" -eq 1 ] && echo ' — o merge local fica; rode de novo depois de corrigir')" 3
}

# Clone base <bancada>/<nome> a partir de <url>. Cria a bancada se ela nao existe
# (apagar a bancada = o proximo abrir/clonar refaz). Chamado so por atos de escrita.
clona_base() {
  local url="$1" nome="$2"
  [ -e "$BANCADA/$nome" ] && morre "'$BANCADA/$nome' ja existe — nao sobrescrevo clone" 3
  mkdir -p "$BANCADA" || morre "nao criei a bancada $BANCADA" 3
  env PATH="$PATH_FORGE" "$GIT" clone "$url" "$BANCADA/$nome" || morre "git clone falhou: $url" 3
}

ato_clonar() {
  local origem="${1:-}" nome="${2:-}" url
  [ -n "$origem" ] || uso
  case "$origem" in
    https://*|git@*|file://*|/*|./*) url="$origem" ;;
    */*) url="https://github.com/$origem.git" ;;
    *[!A-Za-z0-9._-]*|.*) morre "origem invalida: '$origem' — use uma URL, owner/nome ou o nome do repo" 2 ;;
    *) url="$(url_forge "$origem")" ;;
  esac
  [ -n "$nome" ] || { nome="$(basename "$origem")"; nome="${nome%.git}"; }
  case "$nome" in
    */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "nome de destino invalido: '$nome'" 4 ;;
  esac
  clona_base "$url" "$nome"
  printf 'clonado: %s -> %s (ramo %s)\n' "$url" "$BANCADA/$nome" "$(ramo_atual "$BANCADA/$nome")"
}

# Sha que a release serve para <repo>: readlink de $PF_RELEASE_RAIZ/<repo>/current. O nome do
# diretorio da familia e o nome do repo (platafirma-harness…). Forma de servido: current e
# symlink para <sha> de 40 hex, e o destino e o diretorio <raiz>/<repo>/<sha>.
# Familia fora da release: exit 1 com varrido/vizinho. Pendurado ou fora da forma: exit 5.
sha_de_producao() {
  local nome="$1" fam="$PF_RELEASE_RAIZ/$1" link alvo sha
  link="$fam/current"
  if [ ! -d "$fam" ] || { [ ! -L "$link" ] && [ ! -e "$link" ]; }; then
    printf 'varrido: release %s (familia %s sem current)\n' "$PF_RELEASE_RAIZ" "$nome" >&2
    printf 'vizinho: repo abrir %s (sem --da-producao, nasce em origin/main)\n' "$nome" >&2
    exit 1
  fi
  [ -L "$link" ] || morre "indeterminavel: $link nao e symlink — fora da forma de servido" 5
  [ -e "$link" ] || morre "indeterminavel: current pendurado em $link -> $(readlink "$link")" 5
  alvo="$(readlink "$link")"
  sha="$(basename "$alvo")"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || morre "indeterminavel: $link -> $alvo nao e sha de 40 hex — fora da forma de servido" 5
  [ "$(realpath "$link" 2>/dev/null)" = "$(realpath "$fam/$sha" 2>/dev/null)" ] \
    || morre "indeterminavel: $link -> $alvo resolve fora de $fam/$sha — fora da forma de servido" 5
  printf '%s' "$sha"
}

# abrir --da-producao: worktree <bancada>/wt/<repo>/<cadeira> no sha que roda, nao em origin/main.
# O sha tem de estar no clone base (fetch do forge se faltar) e descender de origin/main (exit 4).
# Worktree ja aberto: no mesmo sha e limpo e conforme; em outro sha ou sujo, relata e nao mexe (4).
abrir_da_producao() {
  local nome="$1" cadeira="$2" card="$3" slug="$4"
  local sha; sha="$(sha_de_producao "$nome")" || exit $?
  local curto="${sha:0:7}" clone_raiz="$BANCADA/$nome"
  local wt_dir="$BANCADA/wt/$nome/$cadeira/$(chave_de "$card" "$slug")"

  local ramo_alvo=""
  if [ -n "$card" ]; then
    local card_num="${card###}"
    [[ "$card_num" =~ ^[0-9]+$ ]] || morre "card invalido com --da-producao: '$card' — use o numero do card" 2
    case "$slug" in
      *[!a-z0-9-]*|-*) morre "slug invalido com --da-producao: '$slug' — use [a-z0-9-]" 2 ;;
    esac
    ramo_alvo="fabrica/${card_num}${slug:+-$slug}"
  elif [ -n "$slug" ]; then
    morre "--slug exige <card>" 2
  fi

  if [ -d "$wt_dir" ] && [ -e "$wt_dir/.git" ]; then
    local head st sujo ramo
    head="$("$GIT" -C "$wt_dir" rev-parse HEAD 2>/dev/null)" || morre "indeterminavel: o git recusa o worktree $wt_dir" 5
    # status que falha (indice corrompido) nao e arvore limpa
    st="$("$GIT" -C "$wt_dir" status --porcelain 2>/dev/null)" \
      || morre "indeterminavel: git status falhou no worktree — nao mexo: $wt_dir" 5
    sujo=0; [ -z "$st" ] || sujo="$(printf '%s\n' "$st" | wc -l)"
    ramo="$(ramo_atual "$wt_dir")"
    if [ "$head" != "$sha" ]; then
      morre "worktree ja aberto em ${head:0:7} ($ramo), producao em $curto — nao mexo: $wt_dir" 4
    fi
    if [ "$sujo" -gt 0 ]; then
      morre "worktree sujo ($sujo alteracao(oes)) no sha de producao $curto — nao mexo: $wt_dir" 4
    fi
    if [ -n "$ramo_alvo" ] && [ "$ramo" != "$ramo_alvo" ]; then
      morre "worktree ja aberto no sha de producao $curto em $ramo, nao em $ramo_alvo — nao mexo: $wt_dir" 4
    fi
    printf 'conforme: %s (@ %s, sha de producao %s)\n' "$wt_dir" "$ramo" "$curto"
    return 0
  fi

  if [ ! -e "$clone_raiz" ]; then
    local url; url="$(url_forge "$nome")"
    clona_base "$url" "$nome"
    printf 'clonado: %s -> %s\n' "$url" "$clone_raiz"
  fi
  [ -d "$clone_raiz" ] && [ -e "$clone_raiz/.git" ] || morre "repositório desconhecido: '$nome' — $clone_raiz existe e nao e clone" 2

  # sha e origin/main em dia: busca no forge so quando falta um deles ou a ancestralidade falha
  local buscou=0
  if ! "$GIT" -C "$clone_raiz" cat-file -e "${sha}^{commit}" 2>/dev/null \
     || ! "$GIT" -C "$clone_raiz" merge-base --is-ancestor "$sha" origin/main 2>/dev/null; then
    env PATH="$PATH_FORGE" "$GIT" -C "$clone_raiz" fetch --prune origin >/dev/null 2>&1 \
      || morre "dependência ausente: git fetch do forge falhou em $clone_raiz" 3
    buscou=1
    if ! "$GIT" -C "$clone_raiz" cat-file -e "${sha}^{commit}" 2>/dev/null; then
      env PATH="$PATH_FORGE" "$GIT" -C "$clone_raiz" fetch origin "$sha" >/dev/null 2>&1 || true
    fi
  fi
  "$GIT" -C "$clone_raiz" cat-file -e "${sha}^{commit}" 2>/dev/null \
    || morre "indeterminavel: sha de producao $curto ausente no forge (fetch feito: $buscou)" 5
  "$GIT" -C "$clone_raiz" rev-parse --verify -q origin/main >/dev/null \
    || morre "indeterminavel: $clone_raiz sem origin/main — ancestralidade nao se mede" 5
  "$GIT" -C "$clone_raiz" merge-base --is-ancestor "$sha" origin/main 2>/dev/null \
    || morre "recusa de política: sha de producao $curto nao descende de origin/main" 4

  migra_plana "$nome" "$cadeira" || exit $?
  mkdir -p "$(dirname "$wt_dir")" || morre "falha ao criar diretório pai de $wt_dir" 3
  if [ -d "$wt_dir" ] && [ ! -e "$wt_dir/.git" ]; then
    rmdir "$wt_dir" 2>/dev/null || morre "$wt_dir existe e nao e worktree — nao sobrescrevo" 4
  fi
  # wt/ apagado com o clone base de pe: o registro velho do worktree impede o add. prune so
  # esquece worktree cujo diretorio sumiu (e nao esta travado); nada em disco se apaga.
  "$GIT" -C "$clone_raiz" worktree prune >/dev/null 2>&1 || true

  if [ -n "$ramo_alvo" ]; then
    if "$GIT" -C "$clone_raiz" show-ref --verify --quiet "refs/heads/$ramo_alvo"; then
      local ponta; ponta="$("$GIT" -C "$clone_raiz" rev-parse "refs/heads/$ramo_alvo")"
      [ "$ponta" = "$sha" ] \
        || morre "ramo '$ramo_alvo' ja existe em ${ponta:0:7}, producao em $curto — nao mexo" 4
      "$GIT" -C "$clone_raiz" worktree add -q "$wt_dir" "$ramo_alvo" >/dev/null 2>&1 \
        || morre "git worktree add falhou" 3
    else
      "$GIT" -C "$clone_raiz" worktree add -q -b "$ramo_alvo" "$wt_dir" "$sha" >/dev/null 2>&1 \
        || morre "git worktree add -b falhou" 3
    fi
    printf 'bancada aberta: %s (ramo %s do sha de producao %s)\n' "$wt_dir" "$ramo_alvo" "$curto"
  else
    "$GIT" -C "$clone_raiz" worktree add -q --detach "$wt_dir" "$sha" >/dev/null 2>&1 \
      || morre "git worktree add falhou" 3
    printf 'bancada aberta: %s (HEAD destacado no sha de producao %s)\n' "$wt_dir" "$curto"
  fi
}

cmd_abrir() {
  local nome="${1:-}"
  [ -n "$nome" ] || uso
  shift || true

  case "$nome" in
    */*|.*|*..*) morre "nome de repo invalido: '$nome' — e slug dentro da bancada $BANCADA, nao caminho" 4 ;;
    *[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$nome' — use [A-Za-z0-9._-]" 4 ;;
  esac

  local card="" slug="" arg_cadeira="" da_producao=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --da-producao) da_producao=1; shift ;;
      --slug)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: --slug exige um valor\n' "$VERBO" >&2; exit 2; }
        slug="$1"
        shift
        ;;
      --cadeira)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: --cadeira exige um valor\n' "$VERBO" >&2; exit 2; }
        arg_cadeira="$1"
        shift
        ;;
      -*)
        morre "argumento nao reconhecido: '$1'" 2
        ;;
      *)
        if [ -z "$card" ]; then
          card="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done

  local cadeira="${arg_cadeira:-${PF_CADEIRA:-}}"
  cadeira="${cadeira#claudinho-}"
  cadeira="${cadeira#claudinha-}"
  [ -n "$cadeira" ] || morre "dependência ausente: PF_CADEIRA não definida — abrir exige cadeira" 3

  if [ "$da_producao" -eq 1 ]; then
    abrir_da_producao "$nome" "$cadeira" "$card" "$slug"
    return $?
  fi

  local clone_raiz="$BANCADA/$nome"
  if [ ! -e "$clone_raiz" ]; then
    # Bancada ou clone base ausente: clona do forge (registro de familias da release).
    local url; url="$(url_forge "$nome")"
    clona_base "$url" "$nome"
    printf 'clonado: %s -> %s\n' "$url" "$clone_raiz"
  fi
  [ -d "$clone_raiz" ] && [ -e "$clone_raiz/.git" ] || morre "repositório desconhecido: '$nome' — $clone_raiz existe e nao e clone" 2

  # card:3149 passo 3: worktree por CADEIRA+CARD-OU-SLUG (arq:0109, spec_ambiente-de-
  # desenvolvimento §2/§5) -- a proxima sessao da mesma cadeira NO MESMO card acha a
  # bancada; em card diferente, pasta diferente (bancada_de por chave).
  local chave; chave="$(chave_de "$card" "$slug")"
  local wt_dir="$BANCADA/wt/$nome/$cadeira/$chave"

  local ja; ja="$(bancada_de "$nome" "$chave")"
  if [ -n "$ja" ]; then
    local atras="?"
    if git_sem_engolir "$ja" fetch --prune origin; then
      atras="$("$GIT" -C "$ja" rev-list --count HEAD..origin/main 2>/dev/null || echo '?')"
    else
      atras="? (forge inalcancavel: $REPLY)"
    fi
    local sujo_qtd; sujo_qtd="$("$GIT" -C "$ja" status --porcelain 2>/dev/null | wc -l)"
    local estado_arvore="arvore limpa"; [ "${sujo_qtd:-0}" -eq 0 ] || estado_arvore="arvore suja"
    printf 'bancada já aberta: %s (ramo %s @ %s, atras de origin/main: %s, %s)\n' \
      "$wt_dir" "$(ramo_atual "$ja")" "$("$GIT" -C "$ja" rev-parse --short HEAD)" "$atras" "$estado_arvore"
    return 0
  fi

  # spec_ambiente-de-desenvolvimento §2: o ramo nasce do origin/main DE AGORA. Sem forge,
  # nao nasce sobre copia velha com aviso em stderr: sai 5 e nada se cria.
  git_sem_engolir "$clone_raiz" fetch --prune origin \
    || morre "indeterminavel: fetch do forge falhou ($REPLY) — nada criado" 5

  # Pasta plana legada (wt/<repo>/<cadeira> que e ela propria worktree): a aninhada nasceria
  # DENTRO de outra arvore (add -A da plana a pegaria). Migra antes: limpa, move para
  # wt/<repo>/<cadeira>/<chave-do-ramo-dela>; suja, recusa (4) sem mexer.
  migra_plana "$nome" "$cadeira" || exit $?

  local base_ref="HEAD"
  if "$GIT" -C "$clone_raiz" rev-parse --verify origin/main >/dev/null 2>&1; then
    base_ref="origin/main"
  elif "$GIT" -C "$clone_raiz" rev-parse --verify main >/dev/null 2>&1; then
    base_ref="main"
  fi

  mkdir -p "$(dirname "$wt_dir")" || morre "falha ao criar diretório pai de $wt_dir" 3
  if [ -d "$wt_dir" ] && [ ! -e "$wt_dir/.git" ]; then
    rmdir "$wt_dir" 2>/dev/null || true
  fi

  if [ -n "$card" ]; then
    local card_num="${card###}"
    local ramo_alvo=""
    if [[ "$card_num" =~ ^[0-9]+$ ]]; then
      if [ -n "$slug" ]; then
        ramo_alvo="fabrica/${card_num}-${slug}"
      else
        ramo_alvo="fabrica/${card_num}"
      fi
    else
      ramo_alvo="$card"
      if [ -n "$slug" ]; then
        ramo_alvo="${ramo_alvo}-${slug}"
      fi
    fi
    case "$ramo_alvo" in
      -*|*' '*|*'..'*) morre "nome de ramo invalido: '$ramo_alvo'" 2 ;;
    esac

    if [ -e "$wt_dir/.git" ]; then
      # a plana migrada era deste mesmo card
      printf 'bancada já aberta: %s (ramo %s @ %s, migrada da pasta plana, atras de origin/main: %s)\n' \
        "$wt_dir" "$(ramo_atual "$wt_dir")" "$("$GIT" -C "$wt_dir" rev-parse --short HEAD)" \
        "$("$GIT" -C "$wt_dir" rev-list --count HEAD..origin/main 2>/dev/null || echo '?')"
      return 0
    fi
    if "$GIT" -C "$clone_raiz" show-ref --verify --quiet "refs/heads/$ramo_alvo"; then
      "$GIT" -C "$clone_raiz" worktree add -q "$wt_dir" "$ramo_alvo" >/dev/null 2>&1 || morre "git worktree add falhou (o ramo '$ramo_alvo' ja esta aberto em outra pasta?)" 3
    else
      # --no-track: o upstream do ramo do card e o proprio ramo no origin (o primeiro push o
      # poe), nunca origin/main -- senao estado/sanear leem "atras/a frente" contra main
      "$GIT" -C "$clone_raiz" worktree add -q --no-track -b "$ramo_alvo" "$wt_dir" "$base_ref" >/dev/null 2>&1 || morre "git worktree add -b falhou" 3
    fi
    printf 'bancada aberta: %s (ramo %s @ %s, atras de origin/main: %s, arvore limpa)\n' "$wt_dir" "$ramo_alvo" \
      "$("$GIT" -C "$wt_dir" rev-parse --short HEAD)" "$("$GIT" -C "$wt_dir" rev-list --count HEAD..origin/main 2>/dev/null || echo '?')"
    [[ "$card_num" =~ ^[0-9]+$ ]] && move_card "$card_num"
  else
    if [ -n "$slug" ]; then
      # sem card: ramo de uma cadeira so, <cadeira>/<slug> (spec_ambiente-de-desenvolvimento §2)
      local ramo_slug="$cadeira/$slug"
      case "$slug" in -*|*' '*|*'..'*) morre "slug invalido: '$slug'" 2 ;; esac
      if "$GIT" -C "$clone_raiz" show-ref --verify --quiet "refs/heads/$ramo_slug"; then
        "$GIT" -C "$clone_raiz" worktree add -q "$wt_dir" "$ramo_slug" >/dev/null 2>&1 || morre "git worktree add falhou (o ramo '$ramo_slug' ja esta aberto em outra pasta?)" 3
      else
        "$GIT" -C "$clone_raiz" worktree add -q --no-track -b "$ramo_slug" "$wt_dir" "$base_ref" >/dev/null 2>&1 || morre "git worktree add -b falhou" 3
      fi
      printf 'bancada aberta: %s (ramo %s @ %s, atras de origin/main: 0, arvore limpa)\n' "$wt_dir" "$ramo_slug" "$("$GIT" -C "$wt_dir" rev-parse --short HEAD)"
      return 0
    fi
    "$GIT" -C "$clone_raiz" worktree add -q --detach "$wt_dir" "$base_ref" >/dev/null 2>&1 || morre "git worktree add falhou" 3
    printf 'bancada aberta: %s (HEAD destacado em %s, atras de origin/main: 0, arvore limpa)\n' "$wt_dir" "$base_ref"
  fi
}

# move_card <n> -- abrir com card poe o card em em-execucao no mesmo ato. Recusa do
# rastreador (card sem corpo, estado que nao anda) se declara na saida e NAO derruba o
# abrir: a bancada ja existe, e o card e ato do rastreador (spec_ambiente-de-desenvolvimento §2).
move_card() {
  local n="$1" tarefas_bin="${PF_TAREFAS_BIN:-$(dirname "$(readlink -f "$0")")/tarefas}" out rc
  if [ ! -x "$tarefas_bin" ]; then
    printf 'card #%s: nao movido (verbo tarefas ausente em %s)\n' "$n" "$tarefas_bin"
    return 0
  fi
  out="$("$tarefas_bin" mover "$n" em-execucao 2>&1)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    printf 'card #%s: em-execucao (%s)\n' "$n" "$(printf '%s' "$out" | head -1)"
  else
    printf 'card #%s: rastreador recusou mover (exit %s): %s\n' "$n" "$rc" "$(printf '%s' "$out" | head -1)"
  fi
  return 0
}

# migra_plana <repo> <cadeira> -- a pasta plana legada wt/<repo>/<cadeira> (worktree de antes
# do passo 3) vira wt/<repo>/<cadeira>/<chave-do-ramo>. Limpa: move (dois passos, porque o
# destino fica dentro da origem). Suja: exit 4 sem mexer. Ramo nao-fabrica: chave = ramo
# com '/' trocado por '-'. HEAD destacado limpo: chave = _destacado-<sha7>.
migra_plana() {
  local nome="$1" cadeira="$2" plana="$BANCADA/wt/$1/$2" clone_raiz="$BANCADA/$1"
  [ -e "$plana/.git" ] || return 0
  local st; st="$("$GIT" -C "$plana" status --porcelain 2>/dev/null)" \
    || { printf '%s: indeterminavel: git status falhou na pasta plana %s\n' "$VERBO" "$plana" >&2; return 5; }
  if [ -n "$st" ]; then
    printf '%s: pasta plana legada %s esta suja (%s) — nao migro nem crio a aninhada dentro dela\n' \
      "$VERBO" "${plana#"$BANCADA"/}" "$(printf '%s\n' "$st" | wc -l) alteracao(oes)" >&2
    printf 'vizinho: repo commitar %s (na plana) e abrir de novo\n' "$nome" >&2
    return 4
  fi
  local ramo chave_p
  ramo="$(ramo_atual "$plana")"
  case "$ramo" in
    HEAD) chave_p="_destacado-$("$GIT" -C "$plana" rev-parse --short HEAD)" ;;
    fabrica/*) chave_p="${ramo#fabrica/}" ;;
    *) chave_p="${ramo//\//-}" ;;
  esac
  local tmp="$BANCADA/wt/$nome/.migrando-$cadeira-$$"
  "$GIT" -C "$clone_raiz" worktree move "$plana" "$tmp" 2>/dev/null \
    || { printf '%s: worktree move falhou (%s -> %s)\n' "$VERBO" "$plana" "$tmp" >&2; return 3; }
  mkdir -p "$plana" && "$GIT" -C "$clone_raiz" worktree move "$tmp" "$plana/$chave_p" 2>/dev/null \
    || { printf '%s: worktree move falhou (%s -> %s); a pasta ficou em %s\n' "$VERBO" "$tmp" "$plana/$chave_p" "$tmp" >&2; return 3; }
  printf 'migrada: %s -> %s (ramo %s)\n' "${plana#"$BANCADA"/}" "${plana#"$BANCADA"/}/$chave_p" "$ramo"
  return 0
}

ato_ramo() {
  local nome="${1:-}"
  [ -n "$nome" ] || uso
  local c; c="$(clone_de "$nome")" || exit $?
  shift || true

  if [ $# -eq 0 ]; then
    printf '%s  ·  atual: %s\n' "$nome" "$(ramo_atual "$c")"
    "$GIT" -C "$c" branch --format='  %(refname:short)' || morre "git branch falhou" 3
    return 0
  fi

  local card="" slug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: --slug exige um valor\n' "$VERBO" >&2; exit 2; }
        slug="$1"
        shift
        ;;
      -*)
        morre "argumento nao reconhecido: '$1'" 2
        ;;
      *)
        if [ -z "$card" ]; then
          card="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done

  local card_num="${card###}"
  local ramo_alvo=""
  if [[ "$card_num" =~ ^[0-9]+$ ]]; then
    if [ -n "$slug" ]; then
      ramo_alvo="fabrica/${card_num}-${slug}"
    else
      ramo_alvo="fabrica/${card_num}"
    fi
  else
    ramo_alvo="$card"
    if [ -n "$slug" ]; then
      ramo_alvo="${ramo_alvo}-${slug}"
    fi
    printf 'aviso: nome livre de ramo ('\''%s'\''); padrão da casa é '\''repo ramo <repo> <card> [--slug <slug>]'\'' -> fabrica/<card>-<slug>\n' "$ramo_alvo" >&2
  fi

  case "$ramo_alvo" in
    -*|*' '*|*'..'*) morre "nome de ramo invalido: '$ramo_alvo'" 2 ;;
  esac

  local atual; atual="$(ramo_atual "$c")"
  if [ "$atual" = "$ramo_alvo" ]; then
    printf 'ramo já em '\''%s'\'' (@ %s)\n' "$ramo_alvo" "$("$GIT" -C "$c" rev-parse --short HEAD)"
    exit 1
  fi

  if "$GIT" -C "$c" show-ref --verify --quiet "refs/heads/$ramo_alvo"; then
    "$GIT" -C "$c" checkout "$ramo_alvo" || morre "checkout falhou" 3
    printf 'ramo trocado: %s (ja existia)\n' "$ramo_alvo"
  else
    local base_ref="HEAD"
    if "$GIT" -C "$c" rev-parse --verify origin/main >/dev/null 2>&1; then
      base_ref="origin/main"
    elif "$GIT" -C "$c" rev-parse --verify main >/dev/null 2>&1; then
      base_ref="main"
    fi
    "$GIT" -C "$c" checkout -b "$ramo_alvo" "$base_ref" || morre "checkout -b falhou" 3
    printf 'ramo criado: %s (de %s)\n' "$ramo_alvo" "$base_ref"
  fi
}

ato_commitar() {
  local nome="${1:-}" msg="" tudo=0 caminhos=()
  shift || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--mensagem)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: -m exige mensagem\n' "$VERBO" >&2; exit 2; }
        msg="$1"
        shift
        ;;
      --tudo)
        tudo=1
        shift
        ;;
      -*)
        morre "argumento nao reconhecido: '$1'" 2
        ;;
      *)
        caminhos+=("$1")
        shift
        ;;
    esac
  done

  [ -n "$msg" ] || morre "falta a mensagem (-m)" 2
  local c; c="$(clone_de "$nome")" || exit $?

  # [3096] Recusa commit em ramo de outra cadeira
  local ramo
  ramo="$(ramo_atual "$c")"
  ramo_da_cadeira "$ramo" || morre "commit recusado: o ramo '$ramo' pertence a outra cadeira (esperados: <cadeira>/*, fabrica/*, caderno/<cadeira>/*, main)." 3


  if [ "$tudo" -eq 1 ]; then
    printf 'deprecado: --tudo faz add -A no clone compartilhado; prefira caminhos nomeados ou lista da sessão\n' >&2
    "$GIT" -C "$c" add -A || morre "git add falhou" 3
    "$GIT" -C "$c" diff --cached --quiet && { fecho_commit "$c" "$nome" ja; exit 0; }
    
  # [3096] Gate de diagrama: confere se compila no Kroki antes de commitar
  local staged_diagrams
  staged_diagrams=$("$GIT" -C "$c" diff --cached --name-only --diff-filter=ACM | grep -E '\.(mmd|d2)$' || true)
  if [ -n "$staged_diagrams" ]; then
    for arq in $staged_diagrams; do
      if ! conferir diagrama "$c/$arq"; then
        morre "diagrama $arq quebrado: Kroki recusou a compilacao." 1
      fi
    done
  fi

    "$GIT" -C "$c" commit -m "$msg" >/dev/null || morre "git commit falhou" 3
    fecho_commit "$c" "$nome" novo
    return 0
  fi

  local alvos_commit=()
  if [ "${#caminhos[@]}" -gt 0 ]; then
    for p in "${caminhos[@]}"; do
      case "$p" in /*|*..*) morre "caminho inválido ou fora da raiz: '$p'" 4 ;; esac
      if [ ! -e "$c/$p" ] && ! "$GIT" -C "$c" ls-files --error-unmatch "$p" >/dev/null 2>&1; then
        morre "caminho '$p' não existe na bancada '$nome'" 1
      fi
      alvos_commit+=("$p")
    done
  else
    if [ -z "${PF_SESSAO:-}" ]; then
      morre "dependência ausente: PF_SESSAO ausente para commitar sem caminho — nomeie os caminhos ou abra a sessão com \`monta_sessao\`" 3
    fi

    # OPS_LOG_DIR e o nome unico do log da porta; PF_OPS_LOG_DIR so como alias antigo
    local log_dir="${OPS_LOG_DIR:-${PF_OPS_LOG_DIR:-$PLATAFIRMA_INSTANCIA/var/log/ops}}"
    local py_out rc_py
    py_out="$(python3 -c '
import sys, os, glob, json

log_dir = sys.argv[1]
sessao_id = sys.argv[2]
repo_root = os.path.abspath(sys.argv[3])
repo_nome = sys.argv[4]
bancada = os.path.realpath(sys.argv[5])

if not os.path.isdir(log_dir) or not os.access(log_dir, os.R_OK):
    sys.exit(3)

pattern = os.path.join(log_dir, "ops-*.jsonl")
files = glob.glob(pattern)
readable = [f for f in files if os.path.isfile(f) and os.access(f, os.R_OK)]
if not readable:
    sys.exit(3)

caminhos = set()
for f in readable:
    try:
        with open(f, "r", encoding="utf-8", errors="replace") as fp:
            for line in fp:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                if not isinstance(obj, dict):
                    continue
                if obj.get("tool") == "write_file" and str(obj.get("sessao_id")) == sessao_id:
                    p = obj.get("path")
                    if not isinstance(p, str) or not p:
                        continue
                    p_norm = os.path.normpath(p)
                    rel = None
                    if p_norm == repo_root:
                        continue
                    elif os.path.isabs(p_norm):
                        if p_norm.startswith(repo_root + os.sep):
                            rel = os.path.relpath(p_norm, repo_root)
                    elif p_norm == repo_nome:
                        continue
                    elif p_norm.startswith(repo_nome + os.sep) and \
                            os.path.normpath(os.path.join(bancada, repo_nome)) == repo_root:
                        rel = p_norm[len(repo_nome) + 1:]
                    else:
                        # relativo a bancada (wt/<repo>/<cadeira>/...) ou ao proprio clone
                        for base in (bancada, repo_root):
                            cand = os.path.normpath(os.path.join(base, p_norm))
                            if cand.startswith(repo_root + os.sep) and os.path.exists(cand):
                                rel = os.path.relpath(cand, repo_root)
                                break
                    if rel and not rel.startswith(".."):
                        caminhos.add(rel)
    except Exception:
        pass

for p in sorted(caminhos):
    print(p)
' "$log_dir" "$PF_SESSAO" "$c" "${nome%%@*}" "$BANCADA")"
    rc_py=$?

    if [ "$rc_py" -eq 3 ]; then
      morre "dependência ausente: log da porta ilegível em $log_dir — nomeie os caminhos" 3
    elif [ "$rc_py" -ne 0 ]; then
      morre "erro ao ler log da porta em $log_dir" 3
    fi

    local session_paths=()
    if [ -n "$py_out" ]; then
      while IFS= read -r p; do
        [ -n "$p" ] && session_paths+=("$p")
      done <<< "$py_out"
    fi

    if [ "${#session_paths[@]}" -eq 0 ]; then
      printf 'motivo: a sessão %s não tocou %s\n' "$PF_SESSAO" "$nome"
      exit 1
    fi

    alvos_commit=("${session_paths[@]}")
  fi

  "$GIT" -C "$c" add -- "${alvos_commit[@]}" || morre "git add falhou" 3
  "$GIT" -C "$c" diff --cached --quiet && { fecho_commit "$c" "$nome" ja; exit 0; }
  
  # [3096] Gate de diagrama: confere se compila no Kroki antes de commitar
  local staged_diagrams
  staged_diagrams=$("$GIT" -C "$c" diff --cached --name-only --diff-filter=ACM | grep -E '\.(mmd|d2)$' || true)
  if [ -n "$staged_diagrams" ]; then
    for arq in $staged_diagrams; do
      if ! conferir diagrama "$c/$arq"; then
        morre "diagrama $arq quebrado: Kroki recusou a compilacao." 1
      fi
    done
  fi

    "$GIT" -C "$c" commit -m "$msg" >/dev/null || morre "git commit falhou" 3
  fecho_commit "$c" "$nome" novo
  return 0
}

# forge_sha <clone> <ramo> -- sha do ramo no origin, lido do forge (ls-remote --exit-code):
# rc 0 existe (sha no stdout), 1 ausente, 5 indeterminavel (stdout = primeira linha do erro).
forge_sha() {
  local out rc
  out="$(env PATH="$PATH_FORGE" "$GIT" -C "$1" ls-remote --exit-code origin "refs/heads/$2" 2>&1)"; rc=$?
  case "$rc" in
    0) printf '%s' "${out%%[[:space:]]*}"; return 0 ;;
    2) return 1 ;;
    *) printf '%s' "$(printf '%s' "$out" | head -1)"; return 5 ;;
  esac
}

# fecho_commit <clone> <repo> novo|ja -- o fecho de commitar (spec_ambiente-de-desenvolvimento
# §5): o commit local e o que o forge tem do ramo, sem segunda chamada.
fecho_commit() {
  local c="$1" nome="$2" modo="$3" ramo head fsha
  ramo="$(ramo_atual "$c")"; head="$("$GIT" -C "$c" rev-parse HEAD)"
  if [ "$modo" = ja ]; then
    printf 'já feito: nada novo a commitar em %s (%s @ %s)\n' "$nome" "$ramo" "$("$GIT" -C "$c" log -1 --format='%h %s')"
  else
    printf 'commit em %s (%s): %s\n' "$nome" "$ramo" "$("$GIT" -C "$c" log -1 --format='%h %s')"
  fi
  fsha="$(forge_sha "$c" "$ramo")"
  case $? in
    0) if [ "$fsha" = "$head" ]; then printf 'forge: origin/%s = %s (em dia)\n' "$ramo" "${fsha:0:7}"
       else printf 'forge: origin/%s = %s (local a frente: empurrar ou sincronizar)\n' "$ramo" "${fsha:0:7}"; fi ;;
    1) printf 'forge: origin/%s ausente (ramo nunca empurrado)\n' "$ramo" ;;
    *) printf 'forge: indeterminavel (%s)\n' "$fsha" ;;
  esac
}

ato_empurrar() {
  local nome="${1:-}" ramo="${2:-}" c
  c="$(clone_de "$nome")" || exit $?
  [ -n "$ramo" ] || ramo="$(ramo_atual "$c")"
  case "$ramo" in
    HEAD) morre "HEAD solto — troque para um ramo antes de empurrar" 4 ;;
  esac
  local local_sha fsha rc
  local_sha="$("$GIT" -C "$c" rev-parse --verify -q "refs/heads/$ramo")" || morre "ramo '$ramo' nao existe em '$nome'" 1
  fsha="$(forge_sha "$c" "$ramo")"; rc=$?
  [ "$rc" -eq 5 ] && morre "indeterminavel: nao li o forge ($fsha)" 5
  if [ "$rc" -eq 0 ] && [ "$fsha" = "$local_sha" ]; then
    # idempotente: nada a empurrar; garante so o upstream (sincronizar/pr-abrir leem dele)
    env PATH="$PATH_FORGE" "$GIT" -C "$c" fetch -q origin "refs/heads/$ramo:refs/remotes/origin/$ramo" >/dev/null 2>&1
    "$GIT" -C "$c" branch -q --set-upstream-to="origin/$ramo" "$ramo" >/dev/null 2>&1
    printf 'já feito: origin/%s = %s (%s)\n' "$ramo" "${fsha:0:7}" "$("$GIT" -C "$c" log -1 --format='%s' "$local_sha")"
    return 0
  fi
  # stderr do push segue visivel: e onde o pre-push diz o que barrou
  env PATH="$PATH_FORGE" "$GIT" -C "$c" push -u origin "$ramo" >&2
  fsha="$(forge_sha "$c" "$ramo")"; rc=$?
  if [ "$rc" -eq 0 ] && [ "$fsha" = "$local_sha" ]; then
    printf 'empurrado: %s -> origin/%s = %s (%s) [lido do forge]\n' "$nome" "$ramo" "${fsha:0:7}" \
      "$("$GIT" -C "$c" log -1 --format='%s' "$local_sha")"
    return 0
  fi
  [ "$rc" -eq 5 ] && morre "indeterminavel: push feito? o forge nao respondeu ($fsha)" 5
  morre "git push falhou: origin/$ramo = $([ -n "$fsha" ] && echo "${fsha:0:7}" || echo ausente), local = ${local_sha:0:7} (o pre-push barrou? ver acima)" 3
}

ato_pr_abrir() {
  local nome="${1:-}" titulo="" corpo="" base="main" c ramo
  shift || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      --titulo) titulo="${2:-}"; shift 2 || uso ;;
      --corpo)  corpo="${2:-}";  shift 2 || uso ;;
      --base)   base="${2:-}";   shift 2 || uso ;;
      *) morre "argumento nao reconhecido: '$1'" 2 ;;
    esac
  done
  [ -n "$titulo" ] || morre "falta o titulo (--titulo)" 2
  case "$base" in -*|*' '*) morre "base invalida: '$base'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  ramo="$(ramo_atual "$c")"
  case "$ramo" in
    main|master|HEAD) morre "o ramo atual e '$ramo' — PR sai de ramo de trabalho, nao de producao" 4 ;;
  esac
  [ "$ramo" = "$base" ] && morre "ramo e base sao o mesmo ('$ramo')" 2
  "$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 \
    || morre "'$ramo' nao esta em origin — \`$VERBO empurrar $nome\` primeiro" 3
  # idempotente: PR aberto do mesmo ramo e "ja feito", nunca um segundo PR nem erro
  local ja
  ja="$(cd "$c" && env PATH="$PATH_FORGE" "$GH" pr list --head "$ramo" --state open --json number,url,headRefOid \
        --jq '.[0] | select(.) | "#\(.number) \(.url) (head \(.headRefOid[0:7]))"' 2>/dev/null)" \
    || morre "indeterminavel: nao li os PRs do forge" 5
  if [ -n "$ja" ]; then
    printf 'já feito: PR %s aberto de %s\n' "$ja" "$ramo"
    return 0
  fi
  (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr create --base "$base" --head "$ramo" --title "$titulo" --body "$corpo" >/dev/null) \
    || morre "gh pr create falhou" 3
  local lido
  lido="$(cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$ramo" --json number,state,url,headRefOid \
          --jq '"#\(.number) \(.state) \(.url) (head \(.headRefOid[0:7]))"' 2>/dev/null)" \
    || morre "indeterminavel: PR criado? o forge nao confirmou" 5
  printf 'PR %s de %s -> %s [lido do forge]\n' "$lido" "$ramo" "$base"
}

ato_pr_listar() {
  local nome="${1:-}" todos=0 c
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --todos) todos=1; shift ;;
      *) morre "argumento nao reconhecido: '$1'" 2 ;;
    esac
  done
  tem_gh
  c="$(base_de_repo "$nome")" || exit $?
  if [ "$todos" -eq 1 ]; then
    (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr list --state all --limit 30) || morre "gh pr list falhou" 3
  else
    (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr list --limit 30) || morre "gh pr list falhou" 3
  fi
}

ato_pr_ver() {
  local nome="${1:-}" num="${2:-}" c
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(base_de_repo "$nome")" || exit $?
  # `gh pr view <num>` sem --json puxa TODOS os campos, inclusive projectCards, que o
  # forge deprecou (Projects classic) e o GraphQL agora recusa — exit 3 sobre um PR que
  # existe. Pedindo so os campos usados, o campo morto nao entra na query. Campos e
  # template cobrem o que um 'ver' precisa; para o resto ha --json cru ou o proprio gh.
  local campos="number,title,state,author,headRefName,baseRefName,url,isDraft,mergeable,body"
  local tmpl='#{{.number}} {{.title}}  [{{.state}}]{{if .isDraft}} (rascunho){{end}}
  autor : {{.author.login}}
  ramo  : {{.headRefName}} -> {{.baseRefName}}
  merge : {{.mergeable}}
  url   : {{.url}}

{{.body}}
'
  # --template formata legivel; se o template falhar por qualquer motivo, cai para JSON
  # cru (que nunca falha de formatacao) em vez de derrubar o pr-ver. So um exit 3 real
  # (PR inexistente, forge fora) chega no morre.
  if (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num" --json "$campos" --template "$tmpl" 2>/dev/null); then
    :
  elif (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num" --json "$campos"); then
    :
  else
    morre "gh pr view falhou" 3
  fi
}

ato_pr_diff() {
  local nome="${1:-}" num="${2:-}" c
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(base_de_repo "$nome")" || exit $?
  (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr diff "$num") || morre "gh pr diff falhou" 3
}

ato_pr_merge() {
  local nome="${1:-}" num="${2:-}" modo="--squash" forcar=0 c
  shift 2 || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      --squash|--merge|--rebase) modo="$1"; shift ;;
      --forcar) forcar=1; shift ;;
      -*) morre "argumento nao reconhecido: '$1'" 2 ;;
      *) morre "argumento excedente: '$1'" 2 ;;
    esac
  done
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(base_de_repo "$nome")" || exit $?
  # estado lido do forge ANTES: MERGED e "ja feito" (idempotente), nunca erro nem novo merge
  local info st ramo_pr moid
  info="$(cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num" --json state,headRefName,headRefOid,mergeCommit \
          --jq '"\(.state) \(.headRefName) \(.mergeCommit.oid // "-") \(.headRefOid)"' 2>/dev/null)" \
    || morre "indeterminavel: nao li o PR #$num no forge" 5
  local hoid; read -r st ramo_pr moid hoid <<< "$info"
  if [ "$st" = MERGED ]; then
    printf 'já feito: PR #%s MERGED em %s (%s)\n' "$num" "${moid:0:7}" "$ramo_pr"
    limpa_ramo_entregue "$c" "$ramo_pr" "$hoid"
    return 0
  fi
  [ "$st" = OPEN ] || morre "PR #$num esta $st, nao OPEN — nada a mesclar" 4
  if [ "$forcar" -eq 0 ]; then
    local status_checks
    status_checks="$(cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num" --json statusCheckRollup 2>/dev/null || true)"
    if echo "$status_checks" | grep -q '"conclusion":"FAILURE"'; then
      morre "recusa de política: check vermelho no PR #$num (use --forcar para ignorar)" 4
    fi
  fi
  # O merge remoto e a poda do ramo local sao dois atos. --delete-branch tenta apagar
  # o ramo local e falha quando 'main' (ou o ramo do PR) esta preso em worktree, o que
  # propaga exit != 0 mesmo com o merge remoto ja valido (#3057 item 7). Separa-se:
  # merge remoto primeiro (sem tocar ramo local); poda em seguida, best-effort.
  if ! (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr merge "$num" --admin "$modo"); then
    local pr_state_check
    pr_state_check="$(cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num" --json state --jq .state 2>/dev/null || true)"
    if [ "$pr_state_check" != "MERGED" ]; then
      morre "gh pr merge falhou" 3
    fi
  fi

  # Fecho: o merge se confirma no forge (MERGED + sha do merge), nunca pelo exit do gh.
  info="$(cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num" --json state,mergeCommit \
          --jq '"\(.state) \(.mergeCommit.oid // "-")"' 2>/dev/null)" \
    || morre "indeterminavel: merge pedido, mas o forge nao respondeu o estado do PR #$num" 5
  read -r st moid <<< "$info"
  [ "$st" = MERGED ] || morre "PR #$num esta em estado '${st:-desconhecido}', nao MERGED" 3
  printf 'PR #%s MERGED em %s (%s, %s) [lido do forge]\n' "$num" "${moid:0:7}" "$ramo_pr" "${modo#--}"

  # Bancadas do ramo entregue somem no mesmo ato, de qualquer cadeira, salvando antes o que
  # so existe nelas (spec_ambiente-de-desenvolvimento §2, Fechar); depois o ramo no origin.
  limpa_ramo_entregue "$c" "$ramo_pr" "$hoid"
  env PATH="$PATH_FORGE" "$GIT" -C "$c" push -q origin --delete "$ramo_pr" >/dev/null 2>&1 || true
}

git_sem_engolir() {
  local c="$1"; shift
  local out; out="$(env PATH="$PATH_FORGE" "$GIT" -C "$c" "$@" 2>&1 1>/dev/null)"
  local rc=$?
  REPLY="$(printf '%s' "$out" | head -1)"
  return "$rc"
}

# --- salvamento: a unica linha que nao perde trabalho (card:3149 trava 1) ---------------
# O wip e salvamento, nao entrega: commit e push com --no-verify, porque o pre-commit e o
# pre-push julgam entrega e barrariam justamente o trabalho pela metade que se quer salvar.
# O gate de subida continua inteiro em `release promover`, que nunca promove wip/.

# salva_arvore <worktree> <dono> -- arvore suja: commita num ramo wip novo DENTRO da worktree
# e empurra. stdout: o nome do wip. rc 0 salvo e empurrado; 3 falhou (nada removido depois).
salva_arvore() {
  local c="$1" dono="$2" ramo sha7 ts wip
  ramo="$(ramo_atual "$c")"; sha7="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo 0000000)"
  ts="$(date -u +%Y%m%d-%H%M%S)"
  [ "$ramo" = HEAD ] && ramo="destacado"
  wip="wip/$dono/$ramo-$ts-$sha7"
  "$GIT" -C "$c" checkout -q -b "$wip" >/dev/null 2>&1 || return 3
  "$GIT" -C "$c" add -A >/dev/null 2>&1 || return 3
  "$GIT" -C "$c" -c user.name="${GIT_AUTHOR_NAME:-claudinho}" -c user.email="${GIT_AUTHOR_EMAIL:-claudinho@platafirma}" \
    commit -q --no-verify -m "wip: salvo por repo ($ts)" >/dev/null 2>&1 || return 3
  env PATH="$PATH_FORGE" "$GIT" -C "$c" push -q --no-verify -u origin "$wip" >/dev/null 2>&1 || return 3
  printf '%s' "$wip"
}

# salva_ponta <clone> <sha> <dono> <nome> -- commits que so existem aqui (arvore limpa): empurra
# o sha como wip/<dono>/<nome>-<ts>-<sha7>, sem checkout. stdout: o wip. rc 0 ok, 3 falhou.
salva_ponta() {
  local c="$1" sha="$2" dono="$3" base="$4" ts wip
  ts="$(date -u +%Y%m%d-%H%M%S)"
  wip="wip/$dono/$base-$ts-${sha:0:7}"
  env PATH="$PATH_FORGE" "$GIT" -C "$c" push -q --no-verify origin "$sha:refs/heads/$wip" >/dev/null 2>&1 || return 3
  printf '%s' "$wip"
}

# so_aqui <clone> <ref> -- quantos commits de <ref> nao estao em nenhum ramo do origin
so_aqui() {
  "$GIT" -C "$1" rev-list --count "$2" --not --remotes=origin 2>/dev/null || echo 1
}

# base_de <worktree> -- o clone base (dono do .git comum) de uma worktree
base_de() {
  local comum; comum="$("$GIT" -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  dirname "$comum"
}

# remove_bancada <base> <worktree> <dono> [<oid-entregue>] -- salva o que so existe aqui e
# remove a worktree (sem --force: se sujou depois da checagem, o git recusa). stdout: uma
# linha do que fez. rc 0 removida; 3 nao removida (o motivo na linha).
remove_bancada() {
  local base="$1" c="$2" dono="$3" oid="${4:-}" ramo head salvo="" wip
  ramo="$(ramo_atual "$c")"; head="$("$GIT" -C "$c" rev-parse HEAD 2>/dev/null)"
  if [ -n "$("$GIT" -C "$c" status --porcelain 2>/dev/null)" ]; then
    wip="$(salva_arvore "$c" "$dono")" || { printf 'NAO removida: arvore suja e o wip falhou -- nada apagado'; return 3; }
    salvo=" (sujo salvo em origin/$wip)"; ramo="$wip"
  elif [ -n "$head" ] && [ "$head" != "$oid" ] && [ "$(so_aqui "$c" HEAD)" -gt 0 ]; then
    local nb="$ramo"; [ "$nb" = HEAD ] && nb="destacado"
    wip="$(salva_ponta "$c" "$head" "$dono" "$nb")" || { printf 'NAO removida: commits so locais e o wip falhou -- nada apagado'; return 3; }
    salvo=" (commits so locais salvos em origin/$wip)"
  fi
  "$GIT" -C "$base" worktree remove "$c" >/dev/null 2>&1 \
    || { printf 'NAO removida: worktree remove recusou (sujou agora?)%s' "$salvo"; return 3; }
  # ramo local: so depois de salvo; entregue ou salvo em wip, o ref local nao guarda nada unico
  case "$ramo" in HEAD|main|master) : ;; *) "$GIT" -C "$base" branch -q -D "$ramo" >/dev/null 2>&1 ;; esac
  printf 'removida%s' "$salvo"
  return 0
}

# limpa_ramo_entregue <clone> <ramo> <oid> -- pr-merge: remove na conta toda bancada do ramo
# entregue, de qualquer cadeira, salvando antes o que so existe nela.
limpa_ramo_entregue() {
  local c="$1" ramo="$2" oid="$3" base wt br trava linha dono
  base="$(base_de "$c")" || return 0
  while IFS=$'\t' read -r wt br trava; do
    [ "$br" = "refs/heads/$ramo" ] || continue
    [ -z "$trava" ] || { printf 'bancada %s: travada (%s), nao toco\n' "${wt#"$BANCADA"/}" "$trava"; continue; }
    [ "$wt" = "$base" ] && continue
    dono="$(dono_da_pasta "$wt")"
    linha="$(remove_bancada "$base" "$wt" "$dono" "$oid")"
    printf 'bancada %s: %s\n' "${wt#"$BANCADA"/}" "$linha"
  done < <(worktrees_tab "$base")
  # ref local sem bancada: so se aponta exatamente para a ponta que o PR entregou
  if [ -n "$oid" ] && [ "$("$GIT" -C "$base" rev-parse --verify -q "refs/heads/$ramo")" = "$oid" ]; then
    "$GIT" -C "$base" branch -q -D "$ramo" >/dev/null 2>&1
  fi
}

# worktrees_tab <base> -- "<caminho>\t<refs/heads/ramo|detached>" por worktree (porcelain -z)
worktrees_tab() {
  "$GIT" -C "$1" worktree list --porcelain -z 2>/dev/null | python3 -c '
import sys
for bloco in sys.stdin.buffer.read().split(b"\0\0"):
    campos = [c.decode("utf-8", "replace") for c in bloco.split(b"\0") if c]
    if not campos or not campos[0].startswith("worktree "):
        continue
    caminho = campos[0][9:]
    br = "detached"; trava = ""
    for c in campos[1:]:
        if c.startswith("branch "):
            br = c[7:]
        elif c.startswith("locked"):
            trava = "locked"
        elif c.startswith("prunable"):
            trava = "prunable"
    print(f"{caminho}\t{br}\t{trava}")
'
}

# dono_da_pasta <worktree> -- a cadeira dona pela forma do caminho: wt/<repo>/<cadeira>/<chave>
# ou a plana wt/<repo>/<cadeira>; pasta por sessao (uuid) nao diz dono -> a cadeira que roda.
dono_da_pasta() {
  local rel seg=""
  case "$1" in
    "$BANCADA"/wt/*/*) rel="${1#"$BANCADA"/wt/}"; rel="${rel#*/}"; seg="${rel%%/*}" ;;
  esac
  if [ -z "$seg" ] || [[ "$seg" =~ ^[0-9a-f]{8}-[0-9a-f]{4}- ]]; then
    local r; r="$(cadeira_da_sessao)"; printf '%s' "${r:-sem-cadeira}"
  else
    printf '%s' "$seg"
  fi
}

# classe_da_pasta <worktree> <repo> -- eixo (wt/<repo>/<cadeira>/<chave>) | plana
# (wt/<repo>/<cadeira>, legado de antes do passo 3) | fora (por sessao, ou fora de wt/)
classe_da_pasta() {
  local c="$1" nome="$2" rel
  case "$c" in "$BANCADA/wt/$nome/"*) rel="${c#"$BANCADA/wt/$nome/"}" ;; *) printf 'fora'; return ;; esac
  if [[ "$rel" =~ ^[0-9a-f]{8}-[0-9a-f]{4}- ]]; then printf 'fora'
  elif [[ "$rel" == */* ]] && [[ "$rel" != */*/* ]]; then printf 'eixo'
  elif [[ "$rel" != */* ]]; then printf 'plana'
  else printf 'fora'
  fi
}

ato_sanear() {
  local alvo="" relatar=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --relatar) relatar=1; shift ;;
      -*) morre "argumento nao reconhecido: '$1'" 2 ;;
      *) [ -z "$alvo" ] && { alvo="$1"; shift; } || morre "argumento excedente: '$1'" 2 ;;
    esac
  done

  sanear_conforme "$alvo" "$relatar"
  return $?
}

# sanear_cache <clone base> <relatar> <dono> <rotulo> -- o cache e deposito de objetos, nao
# lugar de trabalho: destacado em origin/main. Sujo ou com commit que so existe nele: salva
# em wip/ antes. rc 0 conforme/feito · 1 pendente (relatar) · 3 falhou (nada destacado).
sanear_cache() {
  local c="$1" relatar="$2" dono="$3" rot="$4" ramo head sujo main wip="" acao
  ramo="$(ramo_atual "$c")"; head="$("$GIT" -C "$c" rev-parse HEAD 2>/dev/null)"
  sujo="$("$GIT" -C "$c" status --porcelain 2>/dev/null)"
  main="$("$GIT" -C "$c" rev-parse --verify -q origin/main)" || { printf '%s: sem origin/main -- nao destaco\n' "$rot"; return 3; }
  if [ -z "$sujo" ] && [ "$ramo" = HEAD ] && [ "$head" = "$main" ]; then return 0; fi
  local unicos=0; [ -z "$sujo" ] && unicos="$(so_aqui "$c" HEAD)"
  acao="destacar em origin/main"
  [ -n "$sujo" ] && acao="salvar o sujo em wip/ e $acao"
  [ "$unicos" -gt 0 ] && acao="salvar $unicos commit(s) so locais em wip/ e $acao"
  if [ "$relatar" -eq 1 ]; then
    printf '%s: relataria %s (esta em %s @ %s)\n' "$rot" "$acao" "$ramo" "${head:0:7}"
    return 1
  fi
  if [ -n "$sujo" ]; then
    wip="$(salva_arvore "$c" "$dono")" || { printf '%s: sujo e o wip falhou -- NAO destacado\n' "$rot"; return 3; }
  elif [ "$unicos" -gt 0 ]; then
    local nb="$ramo"; [ "$nb" = HEAD ] && nb="destacado"
    wip="$(salva_ponta "$c" "$head" "$dono" "$nb")" || { printf '%s: commits so locais e o wip falhou -- NAO destacado\n' "$rot"; return 3; }
  fi
  "$GIT" -C "$c" checkout -q --detach origin/main >/dev/null 2>&1 \
    || { printf '%s: checkout --detach origin/main falhou\n' "$rot"; return 3; }
  printf '%s: destacado em origin/main %s (estava em %s @ %s)%s\n' "$rot" "${main:0:7}" "$ramo" "${head:0:7}" \
    "${wip:+; salvo em origin/$wip}"
  return 0
}

# sanear_conforme <alvo> <relatar> -- spec_ambiente-de-desenvolvimento §2; spec_saneamento-de-
# clones §3.4. Por clone base: busca o forge (falhou: incidente, nada destrutivo nele); le do
# forge os PRs mesclados (uma consulta por clone); enumera as worktrees pelo git, nunca por
# glob; e por worktree:
#   entregue (PR mesclado do ramo, ou upstream apagado do origin) -> salva o que so existe
#       nela em wip/ e remove -- eixo, plana ou fora, de qualquer cadeira
#   fora do eixo (por sessao)                                    -> salva e remove
#   plana (wt/<repo>/<cadeira>, legado)                          -> limpa migra ao eixo;
#       suja fica, declarada
#   eixo e nao entregue                                          -> nao toca: bancada viva
#   cache (o clone base)                                         -> sanear_cache
# Entregue nunca por ancestralidade com main (o squash nao deixa ancestral). Nunca --force.
# exit: 0 conforme ou feito · 1 --relatar com pendencia, ou incidente no ato
sanear_conforme() {
  local alvo="$1" relatar="$2" runner
  runner="$(cadeira_da_sessao)"; runner="${runner:-sem-cadeira}"
  local bases=() d
  if [ -n "$alvo" ]; then
    [ -e "$BANCADA/${alvo%%@*}/.git" ] || morre "repositório desconhecido: '${alvo%%@*}'" 2
    bases=("$BANCADA/${alvo%%@*}")
  else
    for d in "$BANCADA"/*/; do [ -e "${d%/}/.git" ] && bases+=("${d%/}"); done
  fi

  local pend=0 incid=() base nome
  for base in "${bases[@]}"; do
    nome="$(basename "$base")"
    if ! "$GIT" -C "$base" rev-parse --git-dir >/dev/null 2>&1; then
      incid+=("$nome: indeterminavel -- o git recusa o clone (uid $(stat -c%u "$base" 2>/dev/null))"); continue
    fi
    if ! git_sem_engolir "$base" fetch --prune origin; then
      incid+=("$nome: indeterminavel -- fetch falhou ($REPLY); nada destrutivo neste clone"); continue
    fi
    "$GIT" -C "$base" worktree prune >/dev/null 2>&1

    local -A merged=()
    local lista="" r o
    if [ -n "$GH" ] && [ -x "$GH" ] \
       && lista="$(cd "$base" && env PATH="$PATH_FORGE" "$GH" pr list --state merged --limit 500 \
                   --json headRefName,headRefOid --jq '.[] | "\(.headRefName) \(.headRefOid)"' 2>/dev/null)"; then
      while read -r r o; do [ -n "$r" ] && merged["$r"]="${merged["$r"]:-} $o"; done <<< "$lista"
    else
      printf '%s: PRs do forge ilegiveis -- entregue so pelo ramo apagado do origin\n' "$nome"
    fi

    local wt br trava
    while IFS=$'\t' read -r wt br trava; do
      [ -n "$wt" ] || continue
      local rot="$nome ${wt#"$BANCADA"/}"
      if [ -n "$trava" ]; then printf '%s: %s, nao toco\n' "$rot" "$trava"; continue; fi
      if [ "$wt" = "$base" ]; then
        sanear_cache "$base" "$relatar" "$runner" "$nome (cache)"
        case $? in 1) pend=1 ;; 3) incid+=("$nome (cache): ver linha acima") ;; esac
        continue
      fi
      local ramo="" head classe dono entregue="" oid="" acao=""
      [ "$br" = detached ] || ramo="${br#refs/heads/}"
      head="$("$GIT" -C "$wt" rev-parse HEAD 2>/dev/null)"
      classe="$(classe_da_pasta "$wt" "$nome")"; dono="$(dono_da_pasta "$wt")"
      if [ -n "$ramo" ]; then
        if [ -n "${merged["$ramo"]:-}" ]; then
          entregue="PR mesclado"
          for o in ${merged["$ramo"]}; do [ "$o" = "$head" ] && oid="$o"; done
        elif [ "$("$GIT" -C "$wt" for-each-ref --format='%(upstream:track)' "refs/heads/$ramo")" = "[gone]" ]; then
          entregue="ramo apagado do origin"
        fi
      fi
      if [ -n "$entregue" ]; then acao="remover (entregue: $entregue)"
      elif [ "$classe" = fora ]; then acao="remover (fora do eixo)"
      elif [ "$classe" = plana ]; then
        if [ -n "$("$GIT" -C "$wt" status --porcelain 2>/dev/null)" ]; then
          printf '%s: plana suja (%s), fica -- quem a usa commita e abre de novo\n' "$rot" "${ramo:-destacado}"
          pend=1; continue
        fi
        acao="migrar ao eixo"
      else
        continue
      fi
      pend=1
      if [ "$relatar" -eq 1 ]; then
        printf '%s: relataria %s (%s @ %s)\n' "$rot" "$acao" "${ramo:-destacado}" "${head:0:7}"
        continue
      fi
      local res
      case "$acao" in
        remover*)
          res="$(remove_bancada "$base" "$wt" "$dono" "$oid")" || incid+=("$rot: $res")
          printf '%s: %s -- %s\n' "$rot" "$acao" "$res" ;;
        migrar*)
          res="$(migra_plana "$nome" "${wt##*/}" 2>&1)" || incid+=("$rot: $res")
          printf '%s: %s\n' "$rot" "$res" ;;
      esac
    done < <(worktrees_tab "$base")
  done

  if [ "$relatar" -eq 1 ]; then
    if [ "$pend" -eq 0 ] && [ "${#incid[@]}" -eq 0 ]; then
      printf 'conforme: nenhum ramo entregue, nenhuma bancada fora do eixo, cache em origin/main\n'
      return 0
    fi
    [ "${#incid[@]}" -eq 0 ] || { printf '\nincidentes (%d):\n' "${#incid[@]}"; printf '  - %s\n' "${incid[@]}"; }
    return 1
  fi
  if [ "${#incid[@]}" -gt 0 ]; then
    printf '\nincidentes (%d):\n' "${#incid[@]}"; printf '  - %s\n' "${incid[@]}"
    return 1
  fi
  [ "$pend" -eq 1 ] || printf 'limpo -- nada a fazer\n'
  return 0
}

if [ $# -eq 0 ]; then
  uso
fi

for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

cmd="$1"
shift

case "$cmd" in
  estado|listar|ler|procurar|historico|diff|ramo|commitar|empurrar|atualizar|sincronizar|abrir|clonar|sanear|pr-abrir|pr-listar|pr-ver|pr-diff|pr-merge|git)
    declara_bancada "$@" ;;
esac

case "$cmd" in
  estado)    cmd_estado "$@" ;;
  listar)    cmd_listar "$@" ;;
  ler)       cmd_ler "$@" ;;
  procurar)  cmd_procurar "$@" ;;
  historico) cmd_historico "$@" ;;
  diff)      cmd_diff "$@" ;;
  ramo)      ato_ramo "$@" ;;
  commitar)  ato_commitar "$@" ;;
  empurrar)  ato_empurrar "$@" ;;
  atualizar) ato_atualizar "$@" ;;
  sincronizar) ato_sincronizar "$@" ;;
  abrir)     cmd_abrir "$@" ;;
  clonar)    ato_clonar "$@" ;;
  sanear)    ato_sanear "$@" ;;
  pr-abrir)  ato_pr_abrir "$@" ;;
  pr-listar) ato_pr_listar "$@" ;;
  pr-ver)    ato_pr_ver "$@" ;;
  pr-diff)   ato_pr_diff "$@" ;;
  pr-merge)  ato_pr_merge "$@" ;;
  git)       ato_git "$@" ;;
  *)
    printf '%s: erro: ato desconhecido '\''%s'\''\n' "$VERBO" "$cmd" >&2
    printf 'atos: estado · listar · ler · procurar · historico · diff · ramo · commitar · empurrar · atualizar · sincronizar · abrir · clonar · sanear · pr-abrir · pr-listar · pr-ver · pr-diff · pr-merge · git\n' >&2
    uso_texto
    exit 2
    ;;
esac
