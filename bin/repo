#!/usr/bin/env bash
# repo — opera o clone local de um repositorio da stack, do clone ao PR
# capacidade: construcao
# dono: ti
# classe: B
# forma: predicado (estado, diff) / lista (listar, procurar, historico, pr-listar) / texto (ler, pr-diff) / fluxo (sanear)
# atos: estado (leitura, operacao) · listar (leitura, operacao) · ler (leitura, operacao) ·
#       procurar (leitura, operacao) · historico (leitura, operacao) · diff (leitura, operacao) ·
#       commitar (escrita, operacao) · ramo (escrita, operacao) · atualizar (escrita, operacao) ·
#       abrir (escrita, operacao) · clonar (escrita, operacao) · empurrar (escrita, forge) ·
#       pr-abrir (escrita, forge) · pr-listar (leitura, forge) · pr-ver (leitura, forge) ·
#       pr-diff (leitura, forge) · pr-merge (escrita, forge) · sanear (escrita, forge) ·
#       git (escrita, operacao)
# escreve: var/wt/<repo>/<cadeira> (objetos e refs) · origin (refs, PR) · wip/ (só sanear) · nada (leitura)
# consome: porta@ops-log
# ambiente: PF_REPO_RAIZ[=$HOME/AI] porta · PF_CADEIRA porta (lida) · PF_SESSAO porta (lida) · PF_OPS_LOG_DIR[=$HOME/AI/var/log/ops] porta · HOME
# depende: git · gh (pr-*, empurrar, atualizar, clonar) · rede ao forge
# substitui: git -C … ls-files|grep|log|diff|show|status|checkout -b|commit|push|fetch · gh pr create|list|view|diff|merge
# conforme: parcial
# falta: abrir (aguarda porta servir main); var/wt/<repo>/<cadeira> (aguarda abrir)
set -uo pipefail

RAIZ="${PF_REPO_RAIZ:-$HOME/AI}"
VERBO="$(basename "$0")"
COMO_JSON=0

# Resolução de binário real uma vez, evitando shims no PATH da porta
GIT="$(command -v /usr/bin/git /bin/git 2>/dev/null | head -1)"
[ -x "$GIT" ] || GIT=/usr/bin/git
if [ ! -x "$GIT" ]; then
  printf 'repo: dependência ausente: git não encontrado\n' >&2
  exit 3
fi

GH="$(command -v /usr/bin/gh /bin/gh "$HOME/.local/bin/gh" 2>/dev/null | head -1)"
PATH_FORGE="$PATH"
if [ -n "$GH" ] && [ -x "$GH" ]; then
  PATH_FORGE="$(dirname "$GH"):$PATH"
fi

uso_texto() {
  cat >&2 <<'EOF'
uso:
  repo estado    [<repo>] [--json]
  repo listar    <repo> [<prefixo>] [--json]
  repo ler       <repo> <caminho>
  repo procurar  <repo> --termo <termo> [<prefixo>] [--json]
  repo historico <repo> [<caminho>] [--n <N>] [--json]
  repo diff      <repo> [<caminho>] [--staged] base: origin/main, senão main, senão HEAD
  repo ramo      <repo> [<card>] [--slug <slug>]
  repo commitar  <repo> -m <msg> [<caminho>…] [--tudo]
  repo empurrar  <repo> [<ramo>]
  repo atualizar <repo>
  repo abrir     <repo>
  repo clonar    <url|owner/nome> [<nome>]
  repo sanear    [<repo>] [--relatar]
  repo pr-abrir  <repo> --titulo <t> [--corpo <c>] [--base <ramo>]
  repo pr-listar <repo> [--todos]
  repo pr-ver    <repo> <numero>
  repo pr-diff   <repo> <numero>
  repo pr-merge  <repo> <numero> [--squash|--merge|--rebase] [--forcar]
  repo git       <repo> <args…>

raiz de trabalho: PF_REPO_RAIZ[=$HOME/AI]
exit: 0 achou/fez · 1 nao existe/negativo · 2 uso · 3 dependencia · 4 politica · 5 indeterminavel
EOF
}

uso() {
  if [ "$COMO_JSON" -eq 1 ]; then
    python3 -c 'import sys, json; print(json.dumps({"erro": sys.argv[1]}))' "uso incorreto"
    exit 2
  fi
  uso_texto
  exit 2
}

morre() {
  local msg="$1" rc="${2:-3}"
  if [ "$COMO_JSON" -eq 1 ]; then
    python3 -c 'import sys, json; print(json.dumps({"erro": sys.argv[1]}))' "$msg"
  else
    printf '%s: %s\n' "$VERBO" "$msg" >&2
  fi
  exit "$rc"
}

# Resolução de bancada: hoje raiz fixa $RAIZ/<repo>; amanhã var/wt/<repo>/<cadeira> (arq:0109).
# Mantida em UMA função só para a troca ser um commit quando a porta servir main.
bancada_de() {
  local nome="$1"
  printf '%s/%s' "$RAIZ" "$nome"
}

listar_repos() {
  local r=()
  if [ -d "$RAIZ" ]; then
    for d in "$RAIZ"/*; do
      if [ -e "$d/.git" ]; then
        r+=("$(basename "$d")")
      fi
    done
  fi
  printf '%s\n' "${r[@]}"
}

clone_de() {
  local nome="${1:-}"
  [ -n "$nome" ] || {
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "falta o nome do repo" 2
    fi
    printf '%s: erro: falta o nome do repo\n' "$VERBO" >&2
    uso
  }

  if [ "$nome" = "pull" ]; then
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "ordem trocada: 'repo git pull <repo>' — use 'repo atualizar <repo>'" 2
    fi
    printf '%s: ordem trocada: '\''repo git pull <repo>'\'' — use '\''repo atualizar <repo>'\''\n' "$VERBO" >&2
    printf 'repositórios disponíveis:\n' >&2
    local lr; lr="$(listar_repos)"
    if [ -n "$lr" ]; then printf '%s\n' "$lr" | sed 's/^/  /' >&2; else printf '  (nenhum)\n' >&2; fi
    uso_texto
    exit 2
  elif [ "$nome" = "-C" ]; then
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "ordem trocada: 'repo git -C <repo>' — use 'repo <ato> <repo>'" 2
    fi
    printf '%s: ordem trocada: '\''repo git -C <repo>'\'' — use '\''repo <ato> <repo>'\''\n' "$VERBO" >&2
    printf 'repositórios disponíveis:\n' >&2
    local lr; lr="$(listar_repos)"
    if [ -n "$lr" ]; then printf '%s\n' "$lr" | sed 's/^/  /' >&2; else printf '  (nenhum)\n' >&2; fi
    uso_texto
    exit 2
  fi

  case "$nome" in
    */*|.*|*..*) morre "nome de repo invalido: '$nome' — e slug dentro de $RAIZ, nao caminho" 4 ;;
    *[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$nome' — use [A-Za-z0-9._-]" 4 ;;
  esac

  local alvo; alvo="$(bancada_de "$nome")"
  if [ ! -d "$alvo" ] || [ ! -e "$alvo/.git" ]; then
    if [ "$COMO_JSON" -eq 1 ]; then
      morre "repositório desconhecido: '$nome'" 2
    fi
    printf '%s: repositório desconhecido: '\''%s'\''\n' "$VERBO" "$nome" >&2
    printf 'repositórios disponíveis:\n' >&2
    local lr; lr="$(listar_repos)"
    if [ -n "$lr" ]; then printf '%s\n' "$lr" | sed 's/^/  /' >&2; else printf '  (nenhum)\n' >&2; fi
    uso_texto
    exit 2
  fi

  local real; real="$(realpath "$alvo" 2>/dev/null)" || morre "nao resolvi '$alvo'" 4
  case "$real/" in
    "$RAIZ"/*) : ;;
    *) morre "'$nome' resolve para $real, fora da raiz $RAIZ" 4 ;;
  esac

  if ! "$GIT" -C "$real" rev-parse --git-dir >/dev/null 2>&1; then
    morre "indeterminavel: o git recusa o clone '$nome' — $("$GIT" -C "$real" rev-parse --git-dir 2>&1 | head -1)" 5
  fi

  printf '%s' "$real"
}

ramo_atual() {
  local c="$1"
  "$GIT" -C "$c" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD"
}

info_varrido() {
  local c="$1" repo="$2"
  local cadeira="${PF_CADEIRA:-sem-cadeira}"
  local ramo; ramo="$(ramo_atual "$c")"
  local sha; sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "0000000")"
  local sujo; sujo="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
  local estado_arvore="árvore limpa"
  [ "${sujo:-0}" -gt 0 ] && estado_arvore="árvore suja"
  printf 'varrido: bancada %s/%s (%s @ %s, %s)\n' "$repo" "$cadeira" "$ramo" "$sha" "$estado_arvore" >&2
}

tem_gh() {
  [ -n "$GH" ] && [ -x "$GH" ] \
    || morre "'gh' nao esta no PATH desta conta — o endpoint do forge nao esta alcancavel daqui" 3
}

ato_git() {
  local nome="${1:-}"; shift || uso
  if [ "${1:-}" = pull ] && [ $# -eq 1 ]; then
    ato_atualizar "$nome"
    return $?
  fi
  local c; c="$(clone_de "$nome")" || exit $?
  exec env PATH="$PATH_FORGE" "$GIT" -C "$c" "$@"
}

cmd_estado() {
  local como_json=0
  local repo_alvo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo_alvo" ]; then
          repo_alvo="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done

  if [ -z "$repo_alvo" ]; then
    local repos=()
    while IFS= read -r r; do
      [ -n "$r" ] && repos+=("$r")
    done < <(listar_repos)

    if [ "$como_json" -eq 1 ]; then
      local json_recs=()
      for r in "${repos[@]}"; do
        local c; c="$(bancada_de "$r")"
        local ramo sha sujo_qtd trilha upstream
        ramo="$(ramo_atual "$c")"
        sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "")"
        sujo_qtd="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
        upstream="$("$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo "")"
        local atras=0 frente=0
        if [ -n "$upstream" ]; then
          read -r atras frente < <("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null || echo "0 0")
        fi
        json_recs+=("$(python3 -c '
import sys, json
print(json.dumps({
  "repo": sys.argv[1],
  "ramo": sys.argv[2],
  "sha": sys.argv[3],
  "upstream": sys.argv[4] or None,
  "atras": int(sys.argv[5]),
  "a_frente": int(sys.argv[6]),
  "limpo": int(sys.argv[7]) == 0,
  "alteracoes": int(sys.argv[7])
}))' "$r" "$ramo" "$sha" "$upstream" "${atras:-0}" "${frente:-0}" "${sujo_qtd:-0}")")
      done
      python3 -c '
import sys, json
recs = [json.loads(l) for l in sys.stdin.read().splitlines() if l]
print(json.dumps({"bancadas": {r["repo"]: r for r in recs}}, indent=2))' <<<"$(printf '%s\n' "${json_recs[@]}")"
      return 0
    fi

    printf 'clones em %s\n' "$RAIZ"
    for r in "${repos[@]}"; do
      local c; c="$(bancada_de "$r")"
      local ramo sujo
      if ! ramo="$("$GIT" -C "$c" rev-parse --abbrev-ref HEAD 2>&1)"; then
        printf '  %-28s %-34s %s\n' "$r" "-" "indeterminavel: $(printf '%s' "$ramo" | head -1)"
        continue
      fi
      sujo="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
      printf '  %-28s %-34s %s\n' "$r" "$ramo" \
        "$([ "${sujo:-0}" -eq 0 ] && echo limpo || echo "$sujo alteracao(oes)")"
    done
    return 0
  fi

  local c; c="$(clone_de "$repo_alvo")" || exit $?
  local ramo sha sujo_qtd trilha upstream
  ramo="$(ramo_atual "$c")"
  sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "")"
  sujo_qtd="$("$GIT" -C "$c" status --porcelain 2>/dev/null | wc -l)"
  upstream="$("$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo "")"
  local atras=0 frente=0
  if [ -n "$upstream" ]; then
    read -r atras frente < <("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null || echo "0 0")
  fi
  local ultimo; ultimo="$("$GIT" -C "$c" log -1 --format='%h %s  (%an, %ar)' 2>/dev/null || echo "")"

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
print(json.dumps({
  "repo": sys.argv[1],
  "ramo": sys.argv[2],
  "sha": sys.argv[3],
  "upstream": sys.argv[4] or None,
  "atras": int(sys.argv[5]),
  "a_frente": int(sys.argv[6]),
  "limpo": int(sys.argv[7]) == 0,
  "alteracoes": int(sys.argv[7]),
  "ultimo_commit": sys.argv[8] or None
}, indent=2))' "$repo_alvo" "$ramo" "$sha" "$upstream" "${atras:-0}" "${frente:-0}" "${sujo_qtd:-0}" "$ultimo"
    return 0
  fi

  printf '%s  ·  ramo %s\n' "$repo_alvo" "$ramo"
  if [ -n "$upstream" ]; then
    printf '  upstream %s  ·  atras %s  ·  a frente %s\n' "$upstream" "${atras:-0}" "${frente:-0}"
  else
    printf '  sem upstream (ramo local ainda nao empurrado)\n'
  fi
  printf '  ultimo   %s\n' "$ultimo"
  local st; st="$("$GIT" -C "$c" status --short 2>/dev/null)"
  if [ -n "$st" ]; then
    printf '  arvore suja:\n%s\n' "$(printf '%s' "$st" | sed 's/^/    /')"
  else
    printf '  arvore limpa\n'
  fi
  return 0
}

cmd_listar() {
  local como_json=0 repo="" prefixo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] || morre "repo obrigatório para listar" 2

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      morre "prefixo fora da raiz ou símbolo que escapa: '$prefixo'" 4
    fi
  fi

  local files
  if [ -n "$prefixo" ]; then
    files="$("$GIT" -C "$c" ls-files -- "$prefixo" 2>/dev/null || true)"
  else
    files="$("$GIT" -C "$c" ls-files 2>/dev/null || true)"
  fi

  if [ -z "$files" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"repo": sys.argv[1], "arquivos": [], "total": 0, "motivo": "nenhum arquivo encontrado sob '\''" + sys.argv[2] + "'\''"}, indent=2))' "$repo" "${prefixo:-.}"
    else
      printf 'motivo: nenhum arquivo encontrado sob '\''%s'\''\n' "${prefixo:-.}"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c 'import sys, json; arqs = [l for l in sys.stdin.read().splitlines() if l]; print(json.dumps({"repo": sys.argv[1], "arquivos": arqs, "total": len(arqs)}, indent=2))' "$repo" <<<"$files"
  else
    printf '%s\n' "$files"
  fi
  return 0
}

cmd_ler() {
  local repo="" caminho=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] && [ -n "$caminho" ] || morre "repo e caminho são obrigatórios para ler" 2

  local c; c="$(clone_de "$repo")" || exit $?

  if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
    morre "caminho fora da raiz ou símbolo que escapa: '$caminho'" 4
  fi

  local alvo_arquivo="$c/$caminho"
  if [ ! -f "$alvo_arquivo" ]; then
    info_varrido "$c" "$repo"
    printf 'vizinho: release ler %s %s\n' "$repo" "$caminho" >&2
    exit 1
  fi

  cat "$alvo_arquivo"

  local ramo; ramo="$(ramo_atual "$c")"
  local sha; sha="$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null || echo "")"
  local mod=""
  if ! "$GIT" -C "$c" diff --quiet HEAD -- "$caminho" 2>/dev/null; then
    mod=" (modificado)"
  elif ! "$GIT" -C "$c" ls-files --error-unmatch "$caminho" >/dev/null 2>&1; then
    mod=" (modificado)"
  fi
  printf 'versão: %s@%s%s\n' "$ramo" "$sha" "$mod" >&2
  return 0
}

cmd_procurar() {
  local como_json=0 repo="" termo="" prefixo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      --termo)
        shift
        [ $# -gt 0 ] || morre "--termo exige um valor" 2
        termo="$1"
        shift
        ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$prefixo" ]; then
          prefixo="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || morre "repo obrigatório para procurar" 2
  [ -n "$termo" ] || morre "--termo <termo> é obrigatório para procurar" 2

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$prefixo" ]; then
    if [[ "$prefixo" == /* ]] || [[ "$prefixo" == *..* ]]; then
      morre "prefixo fora da raiz ou símbolo que escapa: '$prefixo'" 4
    fi
  fi

  local out=""
  if [ -n "$prefixo" ]; then
    out="$("$GIT" -C "$c" grep -n -F -- "$termo" -- "$prefixo" 2>/dev/null || true)"
  else
    out="$("$GIT" -C "$c" grep -n -F -- "$termo" 2>/dev/null || true)"
  fi

  if [ -z "$out" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"repo": sys.argv[1], "termo": sys.argv[2], "ocorrencias": [], "total": 0, "motivo": "termo não encontrado na bancada"}, indent=2))' "$repo" "$termo"
    else
      printf 'motivo: termo '\''%s'\'' não encontrado na bancada %s\n' "$termo" "$repo"
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
linhas = [l for l in sys.stdin.read().splitlines() if l]
ocorr = []
for l in linhas:
    partes = l.split(":", 2)
    if len(partes) >= 3:
        ocorr.append({"caminho": partes[0], "linha": int(partes[1]) if partes[1].isdigit() else partes[1], "texto": partes[2]})
    else:
        ocorr.append({"linha_crua": l})
print(json.dumps({"repo": sys.argv[1], "termo": sys.argv[2], "ocorrencias": ocorr, "total": len(ocorr)}, indent=2))
' "$repo" "$termo" <<<"$out"
  else
    printf '%s\n' "$out"
  fi
  return 0
}

cmd_historico() {
  local como_json=0 repo="" caminho="" n_commits="10"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) como_json=1; COMO_JSON=1; shift ;;
      --n)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: --n exige um número\n' "$VERBO" >&2; uso; }
        n_commits="$1"
        shift
        ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] || { printf '%s: erro: repo obrigatório para historico\n' "$VERBO" >&2; uso; }
  case "$n_commits" in *[!0-9]*) morre "número de commits inválido: '$n_commits'" 2 ;; esac

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$caminho" ]; then
    if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
      morre "caminho fora da raiz ou símbolo que escapa: '$caminho'" 4
    fi
    if [ ! -e "$c/$caminho" ] && [ -z "$("$GIT" -C "$c" log -1 --format='%h' -- "$caminho" 2>/dev/null)" ]; then
      info_varrido "$c" "$repo"
      printf 'vizinho: release ler %s %s\n' "$repo" "$caminho" >&2
      exit 1
    fi
  fi

  local log_fmt='%h%x09%ad%x09%an%x09%s'
  local out=""
  if [ -n "$caminho" ]; then
    out="$("$GIT" -C "$c" log -n "$n_commits" --format="$log_fmt" --date=short -- "$caminho" 2>/dev/null || true)"
  else
    out="$("$GIT" -C "$c" log -n "$n_commits" --format="$log_fmt" --date=short 2>/dev/null || true)"
  fi

  if [ -z "$out" ]; then
    if [ "$como_json" -eq 1 ]; then
      python3 -c 'import sys, json; print(json.dumps({"repo": sys.argv[1], "caminho": sys.argv[2] or None, "commits": [], "total": 0, "motivo": "nenhum commit encontrado"}, indent=2))' "$repo" "$caminho"
    else
      printf 'motivo: nenhum commit encontrado\n'
    fi
    return 0
  fi

  if [ "$como_json" -eq 1 ]; then
    python3 -c '
import sys, json
linhas = [l for l in sys.stdin.read().splitlines() if l]
commits = []
for l in linhas:
    partes = l.split("\t", 3)
    if len(partes) == 4:
        commits.append({"sha": partes[0], "data": partes[1], "autor": partes[2], "mensagem": partes[3]})
    else:
        commits.append({"linha_crua": l})
print(json.dumps({"repo": sys.argv[1], "caminho": sys.argv[2] or None, "commits": commits, "total": len(commits)}, indent=2))
' "$repo" "$caminho" <<<"$out"
  else
    python3 -c '
import sys
for l in sys.stdin.read().splitlines():
    if not l: continue
    partes = l.split("\t", 3)
    if len(partes) == 4:
        print(f"{partes[0]} {partes[1]} {partes[2]}: {partes[3]}")
    else:
        print(l)
' <<<"$out"
  fi
  return 0
}

cmd_diff() {
  local staged=0 repo="" caminho=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --staged) staged=1; shift ;;
      -*) morre "opção desconhecida: '$1'" 2 ;;
      *)
        if [ -z "$repo" ]; then
          repo="$1"
        elif [ -z "$caminho" ]; then
          caminho="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done
  [ -n "$repo" ] || { printf '%s: erro: repo obrigatório para diff\n' "$VERBO" >&2; uso; }

  local c; c="$(clone_de "$repo")" || exit $?

  if [ -n "$caminho" ]; then
    if [[ "$caminho" == /* ]] || [[ "$caminho" == *..* ]]; then
      morre "caminho fora da raiz ou símbolo que escapa: '$caminho'" 4
    fi
  fi

  if [ "$staged" -eq 1 ]; then
    if [ -n "$caminho" ]; then
      "$GIT" -C "$c" diff --staged -- "$caminho"
    else
      "$GIT" -C "$c" diff --staged
    fi
  else
    local base_ref=""
    if "$GIT" -C "$c" rev-parse --verify origin/main >/dev/null 2>&1; then
      base_ref="origin/main"
    elif "$GIT" -C "$c" rev-parse --verify main >/dev/null 2>&1; then
      base_ref="main"
    fi

    if [ -n "$base_ref" ]; then
      if [ -n "$caminho" ]; then
        "$GIT" -C "$c" diff "$base_ref" -- "$caminho"
      else
        "$GIT" -C "$c" diff "$base_ref"
      fi
    else
      if [ -n "$caminho" ]; then
        "$GIT" -C "$c" diff -- "$caminho"
      else
        "$GIT" -C "$c" diff
      fi
    fi
  fi
  return 0
}

ato_atualizar() {
  local nome="${1:-}" c ramo up
  c="$(clone_de "$nome")" || exit $?
  ramo="$(ramo_atual "$c")"
  case "$ramo" in
    HEAD) morre "HEAD destacado em '$nome' — sem ramo para atualizar" 3 ;;
  esac
  up="$("$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" \
    || morre "'$ramo' nao tem upstream — nada para puxar" 3
  env PATH="$PATH_FORGE" "$GIT" -C "$c" fetch --prune origin || morre "git fetch falhou" 3

  local atras frente
  read -r atras frente < <("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null || echo "0 0")
  if [ "${atras:-0}" -eq 0 ]; then
    printf 'já em dia: %s/%s (@ %s)\n' "$nome" "$ramo" "$("$GIT" -C "$c" rev-parse --short HEAD)"
    exit 1
  fi

  if ! "$GIT" -C "$c" merge --ff-only "@{upstream}" >/dev/null 2>&1; then
    local trilha
    trilha="$("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null)"
    morre "recuso atualizar '$nome': '$ramo' divergiu de '$up' (atras/frente: ${trilha:-?}). ff-only nao funde nem forca — reconcilie a mao com \`repo ramo\` + merge/rebase deliberado." 4
  fi
  printf 'atualizado: %s/%s -> %s\n' "$nome" "$ramo" \
    "$("$GIT" -C "$c" log -1 --format='%h %s')"
}

ato_clonar() {
  local origem="${1:-}" nome="${2:-}" url
  [ -n "$origem" ] || uso
  case "$origem" in
    https://*|git@*|file://*|/*|./*) url="$origem" ;;
    */*) url="https://github.com/$origem.git" ;;
    *) morre "origem invalida: '$origem' — use uma URL ou owner/nome" 2 ;;
  esac
  [ -n "$nome" ] || { nome="$(basename "$origem")"; nome="${nome%.git}"; }
  case "$nome" in
    */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "nome de destino invalido: '$nome'" 4 ;;
  esac
  [ -e "$RAIZ/$nome" ] && morre "'$RAIZ/$nome' ja existe — nao sobrescrevo clone" 3
  mkdir -p "$RAIZ" || morre "nao criei a raiz $RAIZ" 3
  env PATH="$PATH_FORGE" "$GIT" clone "$url" "$RAIZ/$nome" || morre "git clone falhou" 3
  printf 'clonado: %s -> %s (ramo %s)\n' "$url" "$RAIZ/$nome" "$(ramo_atual "$RAIZ/$nome")"
}

cmd_abrir() {
  morre "dependência ausente: abrir depende de a porta servir main; a bancada em var/wt/<repo>/<cadeira> chega com o release" 3
}

ato_ramo() {
  local nome="${1:-}"
  [ -n "$nome" ] || uso
  local c; c="$(clone_de "$nome")" || exit $?
  shift || true

  if [ $# -eq 0 ]; then
    printf '%s  ·  atual: %s\n' "$nome" "$(ramo_atual "$c")"
    "$GIT" -C "$c" branch --format='  %(refname:short)' || morre "git branch falhou" 3
    return 0
  fi

  local card="" slug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: --slug exige um valor\n' "$VERBO" >&2; exit 2; }
        slug="$1"
        shift
        ;;
      -*)
        morre "argumento nao reconhecido: '$1'" 2
        ;;
      *)
        if [ -z "$card" ]; then
          card="$1"
        else
          morre "argumento excedente: '$1'" 2
        fi
        shift
        ;;
    esac
  done

  local card_num="${card###}"
  local ramo_alvo=""
  if [[ "$card_num" =~ ^[0-9]+$ ]]; then
    if [ -n "$slug" ]; then
      ramo_alvo="fabrica/${card_num}-${slug}"
    else
      ramo_alvo="fabrica/${card_num}"
    fi
  else
    ramo_alvo="$card"
    if [ -n "$slug" ]; then
      ramo_alvo="${ramo_alvo}-${slug}"
    fi
    printf 'aviso: nome livre de ramo ('\''%s'\''); padrão da casa é '\''repo ramo <repo> <card> [--slug <slug>]'\'' -> fabrica/<card>-<slug>\n' "$ramo_alvo" >&2
  fi

  case "$ramo_alvo" in
    -*|*' '*|*'..'*) morre "nome de ramo invalido: '$ramo_alvo'" 2 ;;
  esac

  local atual; atual="$(ramo_atual "$c")"
  if [ "$atual" = "$ramo_alvo" ]; then
    printf 'ramo já em '\''%s'\'' (@ %s)\n' "$ramo_alvo" "$("$GIT" -C "$c" rev-parse --short HEAD)"
    exit 1
  fi

  if "$GIT" -C "$c" show-ref --verify --quiet "refs/heads/$ramo_alvo"; then
    "$GIT" -C "$c" checkout "$ramo_alvo" || morre "checkout falhou" 3
    printf 'ramo trocado: %s (ja existia)\n' "$ramo_alvo"
  else
    local base_ref="HEAD"
    if "$GIT" -C "$c" rev-parse --verify origin/main >/dev/null 2>&1; then
      base_ref="origin/main"
    elif "$GIT" -C "$c" rev-parse --verify main >/dev/null 2>&1; then
      base_ref="main"
    fi
    "$GIT" -C "$c" checkout -b "$ramo_alvo" "$base_ref" || morre "checkout -b falhou" 3
    printf 'ramo criado: %s (de %s)\n' "$ramo_alvo" "$base_ref"
  fi
}

ato_commitar() {
  local nome="${1:-}" msg="" tudo=0 caminhos=()
  shift || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--mensagem)
        shift
        [ $# -gt 0 ] || { printf '%s: erro: -m exige mensagem\n' "$VERBO" >&2; exit 2; }
        msg="$1"
        shift
        ;;
      --tudo)
        tudo=1
        shift
        ;;
      -*)
        morre "argumento nao reconhecido: '$1'" 2
        ;;
      *)
        caminhos+=("$1")
        shift
        ;;
    esac
  done

  [ -n "$msg" ] || morre "falta a mensagem (-m)" 2
  local c; c="$(clone_de "$nome")" || exit $?

  if [ "$tudo" -eq 1 ]; then
    printf 'deprecado: --tudo faz add -A no clone compartilhado; prefira caminhos nomeados ou lista da sessão\n' >&2
    "$GIT" -C "$c" add -A || morre "git add falhou" 3
    "$GIT" -C "$c" diff --cached --quiet && { printf 'nada a commitar em '\''%s'\''\n' "$nome"; exit 1; }
    "$GIT" -C "$c" commit -m "$msg" >/dev/null || morre "git commit falhou" 3
    printf 'commit em %s (%s): %s\n' "$nome" "$(ramo_atual "$c")" \
      "$("$GIT" -C "$c" log -1 --format='%h %s')"
    return 0
  fi

  local alvos_commit=()
  if [ "${#caminhos[@]}" -gt 0 ]; then
    for p in "${caminhos[@]}"; do
      case "$p" in /*|*..*) morre "caminho inválido ou fora da raiz: '$p'" 4 ;; esac
      if [ ! -e "$c/$p" ] && ! "$GIT" -C "$c" ls-files --error-unmatch "$p" >/dev/null 2>&1; then
        morre "caminho '$p' não existe na bancada '$nome'" 1
      fi
      alvos_commit+=("$p")
    done
  else
    if [ -z "${PF_SESSAO:-}" ]; then
      morre "dependência ausente: PF_SESSAO ausente para commitar sem caminho — nomeie os caminhos ou abra a sessão com \`monta_sessao\`" 3
    fi

    local log_dir="${PF_OPS_LOG_DIR:-${OPS_LOG_DIR:-${RAIZ}/var/log/ops}}"
    local py_out rc_py
    py_out="$(python3 -c '
import sys, os, glob, json

log_dir = sys.argv[1]
sessao_id = sys.argv[2]
repo_root = os.path.abspath(sys.argv[3])
repo_nome = sys.argv[4]

if not os.path.isdir(log_dir) or not os.access(log_dir, os.R_OK):
    sys.exit(3)

pattern = os.path.join(log_dir, "ops-*.jsonl")
files = glob.glob(pattern)
readable = [f for f in files if os.path.isfile(f) and os.access(f, os.R_OK)]
if not readable:
    sys.exit(3)

caminhos = set()
for f in readable:
    try:
        with open(f, "r", encoding="utf-8", errors="replace") as fp:
            for line in fp:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                if not isinstance(obj, dict):
                    continue
                if obj.get("tool") == "write_file" and str(obj.get("sessao_id")) == sessao_id:
                    p = obj.get("path")
                    if not isinstance(p, str) or not p:
                        continue
                    p_norm = os.path.normpath(p)
                    rel = None
                    if p_norm == repo_root:
                        continue
                    elif os.path.isabs(p_norm):
                        if p_norm.startswith(repo_root + os.sep):
                            rel = os.path.relpath(p_norm, repo_root)
                    elif p_norm == repo_nome:
                        continue
                    elif p_norm.startswith(repo_nome + os.sep):
                        rel = p_norm[len(repo_nome) + 1:]
                    else:
                        cand = os.path.normpath(os.path.join(repo_root, p_norm))
                        if cand.startswith(repo_root + os.sep) and os.path.exists(cand):
                            rel = os.path.relpath(cand, repo_root)
                    if rel and not rel.startswith(".."):
                        caminhos.add(rel)
    except Exception:
        pass

for p in sorted(caminhos):
    print(p)
' "$log_dir" "$PF_SESSAO" "$c" "$nome")"
    rc_py=$?

    if [ "$rc_py" -eq 3 ]; then
      morre "dependência ausente: log da porta ilegível em $log_dir — nomeie os caminhos" 3
    elif [ "$rc_py" -ne 0 ]; then
      morre "erro ao ler log da porta em $log_dir" 3
    fi

    local session_paths=()
    if [ -n "$py_out" ]; then
      while IFS= read -r p; do
        [ -n "$p" ] && session_paths+=("$p")
      done <<< "$py_out"
    fi

    if [ "${#session_paths[@]}" -eq 0 ]; then
      printf 'motivo: a sessão %s não tocou %s\n' "$PF_SESSAO" "$nome"
      exit 1
    fi

    alvos_commit=("${session_paths[@]}")

    local dirty_files=()
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      local f="${line:3}"
      f="${f%\"}"; f="${f#\"}"
      dirty_files+=("$f")
    done < <("$GIT" -C "$c" status --porcelain 2>/dev/null)

    for df in "${dirty_files[@]}"; do
      local pertence=0
      for ac in "${alvos_commit[@]}"; do
        if [ "$df" = "$ac" ]; then
          pertence=1
          break
        fi
      done
      if [ "$pertence" -eq 0 ]; then
        morre "recusa de política: arquivo sujo de terceiro na árvore: '$df' — use caminhos nomeados ou limpe a árvore ou use --tudo" 4
      fi
    done
  fi

  "$GIT" -C "$c" add -- "${alvos_commit[@]}" || morre "git add falhou" 3
  "$GIT" -C "$c" diff --cached --quiet && { printf 'nada a commitar em '\''%s'\''\n' "$nome"; exit 1; }
  "$GIT" -C "$c" commit -m "$msg" >/dev/null || morre "git commit falhou" 3
  printf 'commit em %s (%s): %s\n' "$nome" "$(ramo_atual "$c")" \
    "$("$GIT" -C "$c" log -1 --format='%h %s')"
  return 0
}

ato_empurrar() {
  local nome="${1:-}" ramo="${2:-}" c
  c="$(clone_de "$nome")" || exit $?
  [ -n "$ramo" ] || ramo="$(ramo_atual "$c")"
  case "$ramo" in
    HEAD) morre "HEAD solto — troque para um ramo antes de empurrar" 4 ;;
  esac
  env PATH="$PATH_FORGE" "$GIT" -C "$c" push -u origin "$ramo" || morre "git push falhou" 3
  printf 'empurrado: %s -> origin/%s (%s)\n' "$nome" "$ramo" \
    "$("$GIT" -C "$c" log -1 --format='%h %s')"
}

ato_pr_abrir() {
  local nome="${1:-}" titulo="" corpo="" base="main" c ramo
  shift || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      --titulo) titulo="${2:-}"; shift 2 || uso ;;
      --corpo)  corpo="${2:-}";  shift 2 || uso ;;
      --base)   base="${2:-}";   shift 2 || uso ;;
      *) morre "argumento nao reconhecido: '$1'" 2 ;;
    esac
  done
  [ -n "$titulo" ] || morre "falta o titulo (--titulo)" 2
  case "$base" in -*|*' '*) morre "base invalida: '$base'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  ramo="$(ramo_atual "$c")"
  case "$ramo" in
    main|master|HEAD) morre "o ramo atual e '$ramo' — PR sai de ramo de trabalho, nao de producao" 4 ;;
  esac
  [ "$ramo" = "$base" ] && morre "ramo e base sao o mesmo ('$ramo')" 2
  "$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 \
    || morre "'$ramo' nao esta em origin — \`$VERBO empurrar $nome\` primeiro" 3
  (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr create --base "$base" --head "$ramo" --title "$titulo" --body "$corpo") \
    || morre "gh pr create falhou" 3
}

ato_pr_listar() {
  local nome="${1:-}" todos=0 c
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --todos) todos=1; shift ;;
      *) morre "argumento nao reconhecido: '$1'" 2 ;;
    esac
  done
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  if [ "$todos" -eq 1 ]; then
    (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr list --state all --limit 30) || morre "gh pr list falhou" 3
  else
    (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr list --limit 30) || morre "gh pr list falhou" 3
  fi
}

ato_pr_ver() {
  local nome="${1:-}" num="${2:-}" c
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num") || morre "gh pr view falhou" 3
}

ato_pr_diff() {
  local nome="${1:-}" num="${2:-}" c
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr diff "$num") || morre "gh pr diff falhou" 3
}

ato_pr_merge() {
  local nome="${1:-}" num="${2:-}" modo="--squash" forcar=0 c
  shift 2 || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      --squash|--merge|--rebase) modo="$1"; shift ;;
      --forcar) forcar=1; shift ;;
      -*) morre "argumento nao reconhecido: '$1'" 2 ;;
      *) morre "argumento excedente: '$1'" 2 ;;
    esac
  done
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  if [ "$forcar" -eq 0 ]; then
    local status_checks
    status_checks="$(cd "$c" && env PATH="$PATH_FORGE" "$GH" pr view "$num" --json statusCheckRollup 2>/dev/null || true)"
    if echo "$status_checks" | grep -q '"conclusion":"FAILURE"'; then
      morre "recusa de política: check vermelho no PR #$num (use --forcar para ignorar)" 4
    fi
  fi
  (cd "$c" && env PATH="$PATH_FORGE" "$GH" pr merge "$num" --admin "$modo" --delete-branch) \
    || morre "gh pr merge falhou" 3
}

ato_sanear() {
  local alvo="" relatar=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --relatar) relatar=1; shift ;;
      -*) morre "argumento nao reconhecido: '$1'" 2 ;;
      *) [ -z "$alvo" ] && { alvo="$1"; shift; } || morre "argumento excedente: '$1'" 2 ;;
    esac
  done

  local dirs=()
  if [ -n "$alvo" ]; then
    local c; c="$(clone_de "$alvo")" || exit $?
    dirs=("$c")
  else
    for d in "$RAIZ"/*/; do
      [ -e "${d%/}/.git" ] && dirs+=("${d%/}")
    done
  fi

  local ts; ts="$(date -u +%Y%m%d-%H%M)"
  local incidentes=()

  for c in "${dirs[@]}"; do
    local nome; nome="$(basename "$c")"

    if ! "$GIT" -C "$c" rev-parse --git-dir >/dev/null 2>&1; then
      incidentes+=("$nome: indeterminavel -- $("$GIT" -C "$c" rev-parse --git-dir 2>&1 | head -1) (uid: $(stat -c%u "$c" 2>/dev/null))")
      continue
    fi

    local ramo; ramo="$(ramo_atual "$c")"
    local sujo; sujo="$("$GIT" -C "$c" status --porcelain 2>/dev/null)"

    if [ -n "$sujo" ] || [ "$ramo" = "HEAD" ]; then
      local base_wip="${ramo:-HEAD}"; [ "$base_wip" = "HEAD" ] && base_wip="detached-$("$GIT" -C "$c" rev-parse --short HEAD 2>/dev/null)"
      local ramo_wip="wip/${base_wip}-${ts}"
      if [ "$relatar" -eq 1 ]; then
        printf '%s: relataria wip -> %s (sujo=%s HEAD=%s)\n' "$nome" "$ramo_wip" "$([ -n "$sujo" ] && echo sim || echo nao)" "$ramo"
        continue
      fi
      "$GIT" -C "$c" checkout -b "$ramo_wip" >/dev/null 2>&1 || { incidentes+=("$nome: falhou checkout -b $ramo_wip"); continue; }
      [ -n "$sujo" ] && { "$GIT" -C "$c" add -A && "$GIT" -C "$c" commit -q -m "wip: sanear $ts" >/dev/null; }
      if env PATH="$PATH_FORGE" "$GIT" -C "$c" push -u origin "$ramo_wip" >/dev/null 2>&1; then
        printf '%s: salvo em wip -> origin/%s\n' "$nome" "$ramo_wip"
      else
        incidentes+=("$nome: wip $ramo_wip criado mas push falhou -- trabalho local, nao empurrado")
      fi
      continue
    fi

    local upstream; upstream="$("$GIT" -C "$c" rev-parse --abbrev-ref "@{upstream}" 2>/dev/null)"
    if [ -z "$upstream" ]; then
      if [ "$relatar" -eq 1 ]; then printf '%s: relataria push -u origin %s (sem upstream)\n' "$nome" "$ramo"; continue; fi
      if env PATH="$PATH_FORGE" "$GIT" -C "$c" push -u origin "$ramo" >/dev/null 2>&1; then
        printf '%s: empurrado -u origin/%s\n' "$nome" "$ramo"
      else
        incidentes+=("$nome: ramo '$ramo' sem upstream e push -u falhou")
      fi
      continue
    fi

    env PATH="$PATH_FORGE" "$GIT" -C "$c" fetch --prune origin >/dev/null 2>&1

    local ja_mesclado=0
    if "$GIT" -C "$c" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      local wt_git; wt_git="$("$GIT" -C "$c" rev-parse --git-common-dir 2>/dev/null)"
      local main_git; main_git="$("$GIT" -C "$c" rev-parse --git-dir 2>/dev/null)"
      if [ -n "$wt_git" ] && [ "$wt_git" != "$main_git" ] && [ "$ramo" != "HEAD" ] \
        && "$GIT" -C "$c" merge-base --is-ancestor "$ramo" origin/main 2>/dev/null; then
        ja_mesclado=1
        if [ "$relatar" -eq 1 ]; then printf '%s: relataria worktree remove + branch -d %s (ja mesclado)\n' "$nome" "$ramo"; continue; fi
        "$GIT" -C "$c" worktree remove --force "$c" 2>/dev/null \
          && printf '%s: worktree removido (%s ja mesclado em origin/main)\n' "$nome" "$ramo" \
          || incidentes+=("$nome: ramo '$ramo' ja mesclado mas worktree remove falhou")
        continue
      fi
    fi

    local atras frente
    read -r atras frente < <("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null || echo "0 0")

    if [ "${atras:-0}" -gt 0 ] && [ "${frente:-0}" -eq 0 ]; then
      if [ "$relatar" -eq 1 ]; then printf '%s: relataria merge --ff-only (%s atras)\n' "$nome" "$atras"; continue; fi
      if "$GIT" -C "$c" merge --ff-only "@{upstream}" >/dev/null 2>&1; then
        printf '%s: atualizado -> %s\n' "$nome" "$("$GIT" -C "$c" log -1 --format='%h %s')"
      else
        incidentes+=("$nome: ff-only falhou apesar de so-atras (${atras}) -- confira a mao")
      fi
    elif [ "${atras:-0}" -gt 0 ] && [ "${frente:-0}" -gt 0 ]; then
      local ramo_wip="wip/${ramo}-${ts}"
      if [ "$relatar" -eq 1 ]; then
        printf '%s: relataria divergencia -> salvar wip/%s e reset a upstream (atras=%s frente=%s)\n' "$nome" "$ramo_wip" "$atras" "$frente"
        continue
      fi
      "$GIT" -C "$c" branch "$ramo_wip" "$ramo" >/dev/null 2>&1
      if env PATH="$PATH_FORGE" "$GIT" -C "$c" push -u origin "$ramo_wip" >/dev/null 2>&1 \
        && "$GIT" -C "$c" reset --hard "@{upstream}" >/dev/null 2>&1; then
        incidentes+=("$nome: '$ramo' divergiu de upstream (atras=$atras frente=$frente) -- lado local salvo em wip/$ramo_wip (empurrado), checkout resetado a upstream. Cadeira dona do ramo rebaseia.")
      else
        incidentes+=("$nome: divergiu (atras=$atras frente=$frente) e falhei salvando/resetando -- NAO tocado, confira a mao")
      fi
    fi
  done

  if [ "${#incidentes[@]}" -eq 0 ]; then
    [ "$relatar" -eq 1 ] || printf 'limpo -- nada a fazer\n'
  else
    printf '\nincidentes (%d):\n' "${#incidentes[@]}"
    printf '  - %s\n' "${incidentes[@]}"
  fi
}

if [ $# -eq 0 ]; then
  uso
fi

for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

cmd="$1"
shift

case "$cmd" in
  estado)    cmd_estado "$@" ;;
  listar)    cmd_listar "$@" ;;
  ler)       cmd_ler "$@" ;;
  procurar)  cmd_procurar "$@" ;;
  historico) cmd_historico "$@" ;;
  diff)      cmd_diff "$@" ;;
  ramo)      ato_ramo "$@" ;;
  commitar)  ato_commitar "$@" ;;
  empurrar)  ato_empurrar "$@" ;;
  atualizar) ato_atualizar "$@" ;;
  abrir)     cmd_abrir "$@" ;;
  clonar)    ato_clonar "$@" ;;
  sanear)    ato_sanear "$@" ;;
  pr-abrir)  ato_pr_abrir "$@" ;;
  pr-listar) ato_pr_listar "$@" ;;
  pr-ver)    ato_pr_ver "$@" ;;
  pr-diff)   ato_pr_diff "$@" ;;
  pr-merge)  ato_pr_merge "$@" ;;
  git)       ato_git "$@" ;;
  *)
    printf '%s: erro: ato desconhecido '\''%s'\''\n' "$VERBO" "$cmd" >&2
    printf 'atos: estado · listar · ler · procurar · historico · diff · ramo · commitar · empurrar · atualizar · abrir · clonar · sanear · pr-abrir · pr-listar · pr-ver · pr-diff · pr-merge · git\n' >&2
    uso_texto
    exit 2
    ;;
esac
