#!/usr/bin/env bash
# repo — opera o clone local de um repositorio da stack, do clone ao PR
# capacidade: construcao
# dono: claudinho-TI
# use para: clonar repo, estado do clone, criar/trocar ramo, commitar, empurrar, abrir PR
# atos: git, estado, atualizar, clonar, ramo, commitar, empurrar, pr-abrir, pr-listar, pr-ver, pr-diff, pr-merge
#
# Por que `construcao`, e nao um nome novo: a primeira volta desta story inventou
# `repo`, `teste`, `lint` e `revisao-de-codigo` — quatro capacidades paralelas a uma que
# a mesa ja lavrou: `construcao` — "artefato de software entregue", cuja instancia
# declarada no mapa e literalmente `git` (arquitetura-negocio-operacao.md:60, dono
# claudinho-TI, «fábrica (executa, não decide)»). O que faltava nao era a capacidade: era
# o VERBO. Abrir PR entrou aqui como ato pelo mesmo motivo — entregar o artefato e
# construcao, e verbo proprio para isso duplicaria a capacidade (arq:0037).
#
# Verbo-por-API do braco de repo (card #3004, feature #3003, invariante seg:0014).
# Substitui `run_command "git -C ... "` — allowlist de PREFIXO DE STRING, que o proprio
# PAP marca como "mitigacao, nao controle": `git -c` contorna o texto, e o alcance real
# nao aparece na decisao. Aqui o alcance e ESTRUTURAL, nao textual:
#
#   1. RAIZ fixa (PF_REPO_RAIZ) — todo alvo resolve DENTRO dela; `..`, caminho absoluto
#      e symlink que escapa sao recusados ANTES de o git ser chamado.
#   2. O git roda sobre o clone LOCAL da conta. Nao ha tunel de container (#3007): o
#      isolamento e o uid da conta, e o clone e do uid. O que sai da conta para o mundo
#      e SO `empurrar` — e so ele fala com o forge.
#   3. Nenhuma flag do chamador atravessa para o git. Cada ato monta a linha do git com
#      argumento posicional conferido; o que o chamador passa e dado, nao comando.
#
# Trava de producao: SUSPENSA por ordem do dono (07/09/2026) enquanto nao houver PEP
# centralizado — toda cadeira que roda na conta do host empurra direto, main inclusive,
# sem pedir PR. A recusa de main e a allowlist por cadeira voltam como decisao do PEP
# (seg:0014), nao como string neste arquivo. PR segue disponivel para quem quiser revisao.
#
# NAO decide autorizacao: quem decide e o PEP no caminho da chamada (`_autoriza` por
# slug na porta; #3006 poe o PEP nos endpoints laterais). Este verbo executa ou recusa
# por contencao propria, e a recusa sai com o motivo.
set -uo pipefail

RAIZ="${PF_REPO_RAIZ:-$HOME/AI}"
VERBO="$(basename "$0")"

# git por caminho absoluto: ~/AI/bin tem um shim `git` (bilhete que so sai 2) a frente
# do git real no PATH da porta. Chamar `git` nu aqui cai no shim e todo ato morre no
# clone_de com exit 5 enlatado. Resolve-se o binario real UMA vez, fora do PATH.
GIT="$(command -v /usr/bin/git /bin/git 2>/dev/null | head -1)"
[ -x "$GIT" ] || GIT=/usr/bin/git

# gh real para o credential helper do push: ~/AI/bin tambem tem um shim `gh` (bilhete)
# a frente do gh real no PATH. O push HTTPS usa `gh` como credential helper; sem o gh
# real alcancavel, o push morre com "could not read Username". Resolve-se o dir do gh
# real e poe-se na FRENTE do PATH so para os atos que falam com o forge.
GH_REAL="$(command -v /usr/bin/gh /bin/gh "$HOME/.local/bin/gh" 2>/dev/null | head -1)"
PATH_FORGE="$PATH"
[ -n "$GH_REAL" ] && PATH_FORGE="$(dirname "$GH_REAL"):$PATH"

uso() {
  cat >&2 <<EOF
uso:
  $VERBO git <clone> <args...>          roda qualquer git no clone (push/forge inclusive)
  $VERBO estado [<repo>]                estado do clone: ramo, sujidade, ahead/behind, ultimo commit
                                        sem <repo>, lista os clones da raiz
  $VERBO atualizar <repo>              fetch + merge --ff-only do upstream do ramo atual
                                        RECUSA se divergiu (nao funde, nao forca)
  $VERBO clonar <url|owner/nome> [nome] clona em \$RAIZ/<nome>; recusa se o destino ja existe
  $VERBO ramo <repo> [<nome>]           sem <nome>, lista os ramos; com <nome>, troca (cria se faltar)
  $VERBO commitar <repo> -m <msg> [--staged]
                                        add -A + commit; --staged commita so o que ja esta no index
  $VERBO empurrar <repo> [<ramo>]       push -u origin <ramo> (default: o ramo atual)
                                        cadeira na conta do host empurra direto, main inclusive
                                        (ordem do dono 07/09/2026, ate haver PEP centralizado)
  $VERBO pr-abrir <repo> --titulo <t> [--corpo <c>] [--base <ramo>]
                                        abre PR do ramo ATUAL contra <base> (default: main)
  $VERBO pr-listar <repo> [--todos]     PR abertos (--todos inclui fechado e merged)
  $VERBO pr-ver <repo> <numero>         estado, revisao e checks de um PR
  $VERBO pr-diff <repo> <numero>        o diff completo do PR (o que ele muda, linha a linha)
  $VERBO pr-merge <repo> <numero> [--squash|--merge|--rebase] [--forcar]
                                        aprova e mescla o PR (operador do host); default --squash
                                        recusa check vermelho salvo --forcar

raiz de trabalho: $RAIZ   (PF_REPO_RAIZ)
exit: 0 ok · 2 uso · 3 falha do git · 4 alvo fora da raiz ou trava de producao
      5 indeterminavel (o git recusa o clone — ownership de outro uid, .git quebrado)
EOF
  exit 2
}

morre() { printf '%s: %s\n' "$VERBO" "$1" >&2; exit "${2:-3}"; }

# Resolve <nome> para um clone DENTRO da raiz. Contencao estrutural: nome e slug simples,
# nunca caminho. O realpath final confere que nem symlink escapa.
clone_de() {
  local nome="$1" alvo real
  [ -n "$nome" ] || morre "falta o nome do repo" 2
  case "$nome" in
    */*|.*|*..*) morre "nome de repo invalido: '$nome' — e slug dentro de $RAIZ, nao caminho" 4 ;;
  esac
  case "$nome" in
    *[!A-Za-z0-9._-]*) morre "nome de repo invalido: '$nome' — use [A-Za-z0-9._-]" 4 ;;
  esac
  alvo="$RAIZ/$nome"
  [ -d "$alvo" ] || morre "nao ha clone '$nome' em $RAIZ — \`$VERBO clonar\` primeiro" 3
  real="$(realpath "$alvo" 2>/dev/null)" || morre "nao resolvi '$alvo'" 4
  case "$real/" in
    "$RAIZ"/*) : ;;
    *) morre "'$nome' resolve para $real, fora da raiz $RAIZ" 4 ;;
  esac
  # `-e`, nao `-d`: em worktree o `.git` e ARQUIVO com o ponteiro, e worktree e clone.
  [ -e "$real/.git" ] || morre "'$nome' existe mas nao e clone git" 3
  # Clone que o git recusa (ownership de outro uid) e INDETERMINAVEL, nao vazio.
  "$GIT" -C "$real" rev-parse --git-dir >/dev/null 2>&1 \
    || morre "indeterminavel: o git recusa o clone '$nome' — $("$GIT" -C "$real" rev-parse --git-dir 2>&1 | head -1)" 5
  printf '%s' "$real"
}

ramo_atual() { "$GIT" -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null; }

# git: passthrough total sobre o clone. Resolve o clone pelo `clone_de` (raiz fixa, sem
# escape de symlink) e entrega o resto ao git, cru. Roda QUALQUER git — push e forge
# inclusive. Sem gate: quem esta na conta claudinho ja tem a credencial do forge e a
# contencao que importa e o uid da conta (decisao do dono 07/09/2026; seg de deploy e do
# `deploy`/`infra`, nao do `repo`). A contencao estrutural do verbo e SO a raiz fixa via
# `clone_de`; alem dela, o git e do chamador.
ato_git() {
  local nome="${1:-}"; shift || uso
  local c; c="$(clone_de "$nome")" || exit $?
  exec "$GIT" -C "$c" "$@"
}

ato_estado() {
  local nome="${1:-}" c ramo sujo trilha
  if [ -z "$nome" ]; then
    printf 'clones em %s\n' "$RAIZ"
    for d in "$RAIZ"/*/; do
      [ -e "$d.git" ] || continue
      d="${d%/}"
      # Clone que o git recusa (ownership de outro uid, .git corrompido) responde
      # INDETERMINAVEL, nunca "limpo": arvore inalcancavel nao e arvore sem mudanca.
      # No mundo-alvo (#3007) a conta roda sob uid proprio, e clone de outro dono e
      # exatamente este caso — tem de aparecer, nao sumir num zero.
      if ! ramo="$("$GIT" -C "$d" rev-parse --abbrev-ref HEAD 2>&1)"; then
        printf '  %-28s %-34s %s\n' "$(basename "$d")" "-" \
          "indeterminavel: $(printf '%s' "$ramo" | head -1)"
        continue
      fi
      sujo="$("$GIT" -C "$d" status --porcelain 2>/dev/null | wc -l)"
      printf '  %-28s %-34s %s\n' "$(basename "$d")" "$ramo" \
        "$([ "$sujo" -eq 0 ] && echo limpo || echo "$sujo alteracao(oes)")"
    done
    return 0
  fi
  c="$(clone_de "$nome")" || exit $?
  ramo="$(ramo_atual "$c")"
  printf '%s  ·  ramo %s\n' "$nome" "$ramo"
  trilha="$("$GIT" -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null)"
  if [ -n "$trilha" ]; then
    printf '  upstream %s  ·  atras %s  ·  a frente %s\n' \
      "$("$GIT" -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" \
      "$(printf '%s' "$trilha" | cut -f1)" "$(printf '%s' "$trilha" | cut -f2)"
  else
    printf '  sem upstream (ramo local ainda nao empurrado)\n'
  fi
  printf '  ultimo   %s\n' "$("$GIT" -C "$c" log -1 --format='%h %s  (%an, %ar)' 2>/dev/null)"
  local st
  st="$("$GIT" -C "$c" status --short 2>/dev/null)"
  if [ -n "$st" ]; then printf '  arvore suja:\n%s\n' "$(printf '%s' "$st" | sed 's/^/    /')"
  else printf '  arvore limpa\n'; fi
}

# fetch + merge --ff-only: puxa o upstream do ramo atual e avanca o ramo local SO
# se for fast-forward puro. Nao faz merge de fusao, nao rebaseia, nao forca. Se o
# local tem commit que o upstream nao tem (divergencia real), o --ff-only RECUSA e
# nada e tocado — a arvore fica como estava, e a recusa diz o que houve. Cura o
# clone que congela atras de origin sem `pull` (o `repo` nao tinha fetch nenhum).
# Escrito para o caso seguro; reconciliar divergencia real e ato humano, nao deste verbo.
ato_atualizar() {
  local nome="${1:-}" c ramo up
  c="$(clone_de "$nome")" || exit $?
  ramo="$(ramo_atual "$c")"
  case "$ramo" in
    HEAD) morre "HEAD destacado em '$nome' — sem ramo para atualizar" 3 ;;
  esac
  up="$(git -C "$c" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" \
    || morre "'$ramo' nao tem upstream — nada para puxar" 3
  git -C "$c" fetch --prune origin || morre "git fetch falhou" 3
  if ! git -C "$c" merge --ff-only "@{upstream}" >/dev/null 2>&1; then
    local trilha
    trilha="$(git -C "$c" rev-list --left-right --count "@{upstream}...HEAD" 2>/dev/null)"
    morre "recuso atualizar '$nome': '$ramo' divergiu de '$up' (atras/frente: ${trilha:-?}). \
ff-only nao funde nem forca — reconcilie a mao com \`repo ramo\` + merge/rebase deliberado." 4
  fi
  printf 'atualizado: %s/%s -> %s\n' "$nome" "$ramo" \
    "$(git -C "$c" log -1 --format='%h %s')"
}

ato_clonar() {
  local origem="${1:-}" nome="${2:-}" url
  [ -n "$origem" ] || uso
  case "$origem" in
    https://*|git@*) url="$origem" ;;
    */*) url="https://github.com/$origem.git" ;;
    *) morre "origem invalida: '$origem' — use uma URL ou owner/nome" 2 ;;
  esac
  [ -n "$nome" ] || { nome="$(basename "$origem")"; nome="${nome%.git}"; }
  case "$nome" in
    */*|.*|*..*|*[!A-Za-z0-9._-]*) morre "nome de destino invalido: '$nome'" 4 ;;
  esac
  [ -e "$RAIZ/$nome" ] && morre "'$RAIZ/$nome' ja existe — nao sobrescrevo clone" 3
  mkdir -p "$RAIZ" || morre "nao criei a raiz $RAIZ" 3
  git clone "$url" "$RAIZ/$nome" || morre "git clone falhou" 3
  printf 'clonado: %s -> %s (ramo %s)\n' "$url" "$RAIZ/$nome" "$(ramo_atual "$RAIZ/$nome")"
}

ato_ramo() {
  local nome="${1:-}" alvo="${2:-}" c
  c="$(clone_de "$nome")" || exit $?
  if [ -z "$alvo" ]; then
    printf '%s  ·  atual: %s\n' "$nome" "$(ramo_atual "$c")"
    git -C "$c" branch --format='  %(refname:short)' || morre "git branch falhou" 3
    return 0
  fi
  case "$alvo" in
    -*|*' '*|*'..'*) morre "nome de ramo invalido: '$alvo'" 2 ;;
  esac
  if git -C "$c" show-ref --verify --quiet "refs/heads/$alvo"; then
    git -C "$c" checkout "$alvo" || morre "checkout falhou" 3
    printf 'ramo trocado: %s (ja existia)\n' "$alvo"
  else
    git -C "$c" checkout -b "$alvo" || morre "checkout -b falhou" 3
    printf 'ramo criado: %s (de %s)\n' "$alvo" "$nome"
  fi
}

ato_commitar() {
  local nome="${1:-}" msg="" so_staged=0
  shift || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--mensagem) msg="${2:-}"; shift 2 || uso ;;
      --staged) so_staged=1; shift ;;
      *) morre "argumento nao reconhecido: '$1'" 2 ;;
    esac
  done
  [ -n "$msg" ] || morre "falta a mensagem (-m)" 2
  local c; c="$(clone_de "$nome")" || exit $?
  [ "$so_staged" -eq 1 ] || "$GIT" -C "$c" add -A || morre "git add falhou" 3
  "$GIT" -C "$c" diff --cached --quiet && morre "nada para commitar em '$nome'" 3
  "$GIT" -C "$c" commit -m "$msg" >/dev/null || morre "git commit falhou" 3
  printf 'commit em %s (%s): %s\n' "$nome" "$(ramo_atual "$c")" \
    "$("$GIT" -C "$c" log -1 --format='%h %s')"
}

ato_empurrar() {
  local nome="${1:-}" ramo="${2:-}" c
  c="$(clone_de "$nome")" || exit $?
  [ -n "$ramo" ] || ramo="$(ramo_atual "$c")"
  case "$ramo" in
    HEAD) morre "HEAD solto — troque para um ramo antes de empurrar" 4 ;;
  esac
  PATH="$PATH_FORGE" "$GIT" -C "$c" push -u origin "$ramo" || morre "git push falhou" 3
  printf 'empurrado: %s -> origin/%s (%s)\n' "$nome" "$ramo" \
    "$("$GIT" -C "$c" log -1 --format='%h %s')"
}

# --- PR: o forge, unico ponto que fala com fora ------------------------------
# Endpoint: API do GitHub por `gh`, com a credencial da CONTA que executa. Nao ha
# credencial da casa embutida aqui. Conta sem credencial recebe a recusa do proprio
# gh, com o endereco de quem concede — recusa certa, nao contorno.
# NAO ha ato de merge, e isso e do desenho: `empurrar` recusa main, entao mudanca em
# producao so entra por PR que operador do host aprova ("Sai quando" da #3003).

tem_gh() {
  command -v gh >/dev/null 2>&1 \
    || morre "'gh' nao esta no PATH desta conta — o endpoint do forge nao esta alcancavel daqui" 3
}

ato_pr_abrir() {
  local nome="${1:-}" titulo="" corpo="" base="main" c ramo
  shift || uso
  while [ $# -gt 0 ]; do
    case "$1" in
      --titulo) titulo="${2:-}"; shift 2 || uso ;;
      --corpo)  corpo="${2:-}";  shift 2 || uso ;;
      --base)   base="${2:-}";   shift 2 || uso ;;
      *) morre "argumento nao reconhecido: '$1'" 2 ;;
    esac
  done
  [ -n "$titulo" ] || morre "falta o titulo (--titulo)" 2
  case "$base" in -*|*' '*) morre "base invalida: '$base'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  ramo="$(ramo_atual "$c")"
  case "$ramo" in
    main|master|HEAD) morre "o ramo atual e '$ramo' — PR sai de ramo de trabalho, nao de producao" 4 ;;
  esac
  [ "$ramo" = "$base" ] && morre "ramo e base sao o mesmo ('$ramo')" 2
  git -C "$c" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 \
    || morre "'$ramo' nao esta em origin — \`$VERBO empurrar $nome\` primeiro" 3
  (cd "$c" && gh pr create --base "$base" --head "$ramo" --title "$titulo" --body "$corpo") \
    || morre "gh pr create falhou" 3
}

ato_pr_listar() {
  local nome="${1:-}" todos=0 c
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --todos) todos=1; shift ;;
      *) morre "argumento nao reconhecido: '$1'" 2 ;;
    esac
  done
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  if [ "$todos" -eq 1 ]; then
    (cd "$c" && gh pr list --state all --limit 30) || morre "gh pr list falhou" 3
  else
    (cd "$c" && gh pr list --limit 30) || morre "gh pr list falhou" 3
  fi
}

ato_pr_ver() {
  local nome="${1:-}" num="${2:-}" c
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  (cd "$c" && gh pr view "$num") || morre "gh pr view falhou" 3
}

# pr-merge: operador do host aprova o PR pela credencial da CONTA (uid do host), que e
# quem a seg:0014 diz que promove. NAO afrouxa a fronteira: `empurrar` segue recusando
# main, o PR segue obrigatorio. Isto so da ao verbo o que o operador ja faz por fora.
# --admin passa por cima da policy do forge quando o operador precisa promover o proprio
# PR (branch protection ligada, autor != aprovador). Squash + delete do ramo por default.
ato_pr_merge() {
  local nome="${1:-}" num="${2:-}" c
  [ -n "$num" ] || morre "falta o numero do PR" 2
  case "$num" in *[!0-9]*) morre "numero de PR invalido: '$num'" 2 ;; esac
  tem_gh
  c="$(clone_de "$nome")" || exit $?
  (cd "$c" && gh pr merge "$num" --admin --squash --delete-branch) \
    || morre "gh pr merge falhou" 3
}

ato="${1:-}"; [ -n "$ato" ] && shift
case "$ato" in
  git)       ato_git "$@" ;;
  estado)    ato_estado "$@" ;;
  atualizar) ato_atualizar "$@" ;;
  clonar)    ato_clonar "$@" ;;
  ramo)      ato_ramo "$@" ;;
  commitar)  ato_commitar "$@" ;;
  empurrar)  ato_empurrar "$@" ;;
  pr-abrir)  ato_pr_abrir "$@" ;;
  pr-listar) ato_pr_listar "$@" ;;
  pr-ver)    ato_pr_ver "$@" ;;
  pr-merge)  ato_pr_merge "$@" ;;
  ""|-h|--help|ajuda) uso ;;
  *) morre "ato desconhecido: '$ato' — atos: git, estado, atualizar, clonar, ramo, commitar, empurrar, pr-abrir, pr-listar, pr-ver, pr-diff, pr-merge" 2 ;;
esac
