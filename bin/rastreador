#!/usr/bin/env bash
# rastreador — SHIM. Não é verbo: é o nome do serviço/board/banco.
# capacidade: trabalho
# dono: claudinho-TI
#
# Existe só para matar um modo de falha mudo: a cadeira alcança o board pelo nome
# que ouve o dia inteiro ("rastreador") e digita `rastreador ...`, recebe
# `command not found` (exit 127) do bash, e perde o turno sem entender que o verbo
# canônico é `tarefas`. O acervo já diz isso — `rastreador` é INSTÂNCIA de `tarefas`
# (0076_acervo_ferramental_seed.sql §6), como `keycloak` é instância de `acesso`.
# Ninguém erra `keycloak ...` porque o verbo `acesso` é o nome óbvio; `tarefas` não
# é o nome que a firma fala, então a colisão só acontece aqui.
#
# Comportamento: avisa a causa+correção em stderr e DELEGA para `tarefas` com os
# mesmos argumentos, para o erro custar uma linha de aviso, nunca um turno.
set -euo pipefail

destino="$(dirname "$0")/tarefas"

printf '%s\n' \
  "aviso: 'rastreador' não é verbo — é o nome do serviço. O verbo é 'tarefas'." \
  "       redirecionando: tarefas $*" >&2

exec "$destino" "$@"
