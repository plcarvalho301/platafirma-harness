#!/usr/bin/env bash
# minuta — despachante do protocolo de deliberação entre cadeiras.
# capacidade: decisao
# dono: claudinha-gestao-estrategica
# use para: deliberação entre cadeiras, parecer, circular pauta, formalizar em ADR/spec
# atos: ler, escrever, circular, formalizar
#
# ato: escrever <slug> --convoca <c1>[,<c2>...] [--fecha <cadeira|pedro>] [--card <#N>] — numera, grava e publica o esqueleto (commit+push)
#   --convoca     cadeiras convocadas, separadas por virgula (obrigatorio)
#   --fecha       quem fecha a minuta
#   --card <#N>   card de origem
#   escrever NAO circula: circular e ato proprio
#   ex: minuta escrever verbos-com-help --convoca ia,ti --card 3016
# ato: circular <n> [<cadeira>...] — despacha o ping tipo:minuta as convocadas
#   recusa pauta vazia ou minuta nao commitada
#   ex: minuta circular 12
# ato: ler [<n>|<slug>] — sem argumento, as abertas em que PF_CADEIRA esta convocada
#   com argumento, o arquivo inteiro; leitura fria
#   ex: minuta ler 12
# ato: formalizar <n> --como adr|spec [--destino <slug>] [--vencido] — cria o canonico vazio e apaga a minuta
#   --como        adr ou spec (obrigatorio)
#   recusa convocada com secao vazia, salvo --vencido
#   ex: minuta formalizar 12 --como adr
#
# exit: 0 ok · 1 falha declarada · 2 uso
# protocolo: platafirma-arquitetura/minutas/PROTOCOLO.md · spec: docs/spec_verbo-minuta.md
#
# Externaliza platafirma-arquitetura/minutas/PROTOCOLO.md em verbo (spec:
# platafirma-arquitetura/docs/spec_verbo-minuta.md). Ciclo de vida: escrever ->
# (a cadeira escreve o mérito) -> circular -> (convocadas manifestam) ->
# formalizar. Nunca é leitura automática — só roda chamada (ping tipo:minuta
# na caixa, ou ordem do dono). Despachante (arq:0040): sub-atos em
# bin/_minuta/, fora do PATH; a porta é esta.
set -euo pipefail

ATOS="$(dirname "$(readlink -f "$0")")/_minuta"

# Mapa, forma por ato e erro gracioso: lib/uso.sh renderiza o cabecalho deste
# arquivo (card #3016). O texto de uso mora la em cima, uma vez so.
. "$(dirname "$(readlink -f "$0")")/../lib/uso.sh"
uso_intercepta "$@"

uso() {
  uso_mapa >&2
  exit 2
}

# --ajuda UNIVERSAL, sem efeito colateral (card #2868, ex-#2274 defeito 4). ANTES do
# despacho e varrendo TODOS os argumentos: cobre `minuta --ajuda` e `minuta <sub> --ajuda`;
# nenhum sub-ato (exec do $ATOS/*) chega a rodar. `uso` ja sai 2.
for _a in "$@"; do
  case "$_a" in
    --ajuda|--help|-h) uso ;;
  esac
done

[ $# -eq 0 ] && uso
ATO="$1"; shift

case "$ATO" in
  escrever)        exec "$ATOS/escrever" "$@" ;;
  circular)        exec "$ATOS/circular" "$@" ;;
  ler)             exec "$ATOS/ler" "$@" ;;
  formalizar)      exec "$ATOS/formalizar" "$@" ;;
  -h|--help|ajuda) uso ;;
  *) echo "minuta: ato desconhecido '$ATO'" >&2; uso ;;
esac
