[Unit]
Description=Coleta de comportamento das cadeiras pelo ops log, enviada a ia pela fila (#3090)

[Service]
Type=oneshot
# Da release, nunca de clone (card #3010): a unit sobrevive a bancada apagada.
WorkingDirectory=/opt/platafirma/current/harness
Environment=PATH=/opt/platafirma/current/harness/bin:/usr/local/bin:/usr/bin:/bin
# Mesmo ambiente do ops-mcp: verbo que passa por API sem ele toma 401 (caderno release).
EnvironmentFile=/home/claudinho/.config/ops/env
# A janela vai da coleta anterior ate ontem; o estado mora na instancia.
ExecStart=/bin/bash /opt/platafirma/current/harness/deploy-harness/comportamento-coleta.sh
TimeoutStartSec=300
