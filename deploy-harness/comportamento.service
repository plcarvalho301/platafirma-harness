[Unit]
Description=Coleta de comportamento das cadeiras pelo ops log, enviada a ia pela fila (#3090)

[Service]
Type=oneshot
# Da release, nunca de clone (card #3010): a unit sobrevive a bancada apagada.
WorkingDirectory=/opt/platafirma/current/harness
Environment=PATH=/opt/platafirma/current/harness/bin:/usr/local/bin:/usr/bin:/bin
# Sem <dia>, `metrica comportamento` mede ONTEM contra os 7 dias anteriores.
ExecStart=/bin/bash -c 'out="$(metrica comportamento --resumo)" || exit 1; printf "%%s\n" "$out" | fila enviar ia --de gestao-estrategica --tipo handoff --assunto "Coleta de comportamento das cadeiras (#3090)" --ref "#3090"'
TimeoutStartSec=300
