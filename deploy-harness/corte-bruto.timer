[Unit]
Description=Corte do bruto da porta, uma hora depois da linhagem (linhagem-ops as 00:20; o corte so apaga dia ja conferido)

[Timer]
OnCalendar=*-*-* 01:20:00
# Pega a execucao perdida quando a maquina estava desligada na hora marcada: o dia nao cortado so ocupa disco, e o
# teto de `infra saude` acusa se o atraso crescer.
Persistent=true

[Install]
WantedBy=timers.target
