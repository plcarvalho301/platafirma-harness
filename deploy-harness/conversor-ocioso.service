[Unit]
Description=conversor-ocioso — para o conversor quando todas as replicas estao livres ha 15 min
Documentation=https://tarefas.platafirma.org/tasks/4026

[Service]
Type=oneshot
# Da release, nunca de clone (card #3010): a unit sobrevive a bancada apagada.
WorkingDirectory=/opt/platafirma/current/harness
Environment=PATH=/opt/platafirma/current/harness/bin:/usr/local/bin:/usr/bin:/bin
# O conversor e sob demanda (#4026, ordem do dono de 28/10/2026): liga quem converte, e isto o para
# (stop, nao down: a rede pf-conversor-aberta fica para a rag-api). A linha do journal diz o que decidiu.
ExecStart=/bin/bash /opt/platafirma/current/harness/bin/_infra/conversor-sob-demanda adormecer
TimeoutStartSec=180
