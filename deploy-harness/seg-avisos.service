[Unit]
Description=Rodada diária de avisos de vulnerabilidade OSV sobre dependências externas (card #4417)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/platafirma/current/harness
Environment=PATH=/opt/platafirma/current/harness/bin:/usr/local/bin:/usr/bin:/bin
Environment=PF_CADEIRA=seguranca
ExecStart=/opt/platafirma/current/venv/harness/bin/python /opt/platafirma/current/harness/lib/avisos.py
SuccessExitStatus=0
TimeoutStartSec=120
