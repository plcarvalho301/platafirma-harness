#!/usr/bin/env bash
# instalar — converge um ambiente para o que o harness declara: unit da release, gate de commit na bancada.
# capacidade: infra
# dono: claudinho-TI
#
# ambiente: PF_RELEASE_RAIZ (default /opt/platafirma), PLATAFIRMA_RELEASE (default
#           $PF_RELEASE_RAIZ/current), PLATAFIRMA_BANCADA ou ~/.config/platafirma/bancada
#           (sem default: so o gate de commit e o texto de arranque a leem),
#           CONFERIR (default o conferir da release), XDG_DATA_HOME.
#
# Nao entra na conta de arq:0037 (um verbo por capacidade): nao mora em `bin/` e
# nao e chamado por cadeira nenhuma. E ato de preparo de ambiente, rodado pelo
# caminho — uma vez na maquina nova, e de novo sempre que algo divergir.
#
# ESTRATEGIA: sincronizacao, nao infraestrutura imutavel. Roda N vezes, corrige o
# que divergiu, sobrescreve mudanca manual no que e nosso. Nao recria ambiente do
# zero e nao apaga o que nao reconhece: arquivo comum no lugar de um link nosso e
# RELATADO, nunca sobrescrito — quem o pos ali decide, nao este script.
#
# DUAS RAIZES, E SO ELAS (card #3010): unit e hook apontam para a RELEASE
# (/opt/platafirma/current/harness), nunca para clone — apagar a bancada nao pode
# parar unit nem gate. Verbo no PATH NAO e mais deste script: nao ha diretorio de
# symlinks de verbo; o PATH e /opt/platafirma/current/harness/bin, posto pelas units,
# pela porta e por /etc/profile.d/platafirma.sh (ato de root). Aqui so se MEDE.
#
# BASH PURO, SEM MAKEFILE: o publico e a estacao emprestada, que nao instala
# pacote. `make` e pacote; bash e o unico runtime garantido nos dois ambientes.
#
# NAO instala terceiro, NAO clona repo, NAO promove release, NAO escreve credencial,
# NAO fala com a rede. Opera sobre o que ja esta em disco. O que exige privilegio que
# a estacao nao tem, ele mede e nomeia.
#
# SAIDA: uma linha por item, tres estados — conforme, corrigido, impossivel (com
# motivo). Silencio nao conta como sucesso. Em `--check` nada e escrito, entao o
# que seria `corrigido` aparece como `divergente`: o rotulo diz o que aconteceu,
# nao o que aconteceria.
#
# EXIT: pesa so o que ESTE script pode mudar — link de unit e hook. Terceiro ausente,
# release ausente e bancada nao declarada sao MEDICAO, nao divergencia: nao derrubam a
# execucao nem o exit code.
set -uo pipefail

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/raizes.sh"

# Caminho ESTAVEL da release (atravessa promocao por `current`), nunca o realpath.
HARNESS="$PLATAFIRMA_RELEASE/harness"

MODO=converge

uso() {
  cat <<FIM
uso: deploy-harness/instalar [--check]

  (sem argumento)   converge: cria e corrige o que divergiu
  --check           so mede; nao escreve nada e sai 1 se houver divergencia

O que faz: unit de systemd do harness ligada a release ($HARNESS),
core.hooksPath apontando para $HARNESS/hooks nos clones da bancada declarada, e
mede PATH da release e terceiro ausente. Nao instala pacote, nao clona repo, nao
toca em credencial nem em rede.
FIM
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check)    MODO=check; shift;;
    -h|--help)  uso;;
    *)          echo "argumento desconhecido: $1" >&2; uso;;
  esac
done

conformes=0; corrigidos=0; impossiveis=0; divergentes=0; medidos=0

relata() { printf '  %-11s %-18s %s\n' "$1" "$2" "${3:-}"; }

conforme()   { conformes=$((conformes+1));     relata conforme   "$1" "${2:-}"; }
medido()     { medidos=$((medidos+1));         relata "$1"       "$2" "${3:-}"; }
impossivel() { impossiveis=$((impossiveis+1)); relata impossivel "$1" "$2"; }
# Divergencia: em converge vira escrita; em check vira so relato.
corrigir() {  # nome detalhe
  if [ "$MODO" = check ]; then
    divergentes=$((divergentes+1)); relata divergente "$1" "$2"
  else
    corrigidos=$((corrigidos+1)); relata corrigido "$1" "$2"
  fi
}

TEM_RELEASE=1
[ -d "$HARNESS" ] || TEM_RELEASE=0
BANCADA="$(pf_bancada 2>/dev/null)" || BANCADA=""

# --- release e PATH -----------------------------------------------------------
echo
echo "== release em $HARNESS"
if [ "$TEM_RELEASE" = 1 ]; then
  medido conforme "(release)" "$(readlink -f "$HARNESS" 2>/dev/null || printf '%s' "$HARNESS")"
else
  medido impossivel "(release)" "ausente — promover e ato de \`release promover\`; unit e hook ficam sem fonte"
fi
case ":${PATH}:" in
  *":$HARNESS/bin:"*) medido conforme "(PATH)" "$HARNESS/bin no PATH";;
  *) medido impossivel "(PATH)" "$HARNESS/bin fora do PATH desta shell — /etc/profile.d/platafirma.sh e ato de root";;
esac

# --- gate de commit ---------------------------------------------------------
# Os clones sao da BANCADA declarada; o hook e da RELEASE. Sem bancada declarada nao
# ha clone a gatear, e isso e medicao, nunca criacao.
echo
echo "== gate de commit (core.hooksPath -> $HARNESS/hooks)"
if [ "$TEM_RELEASE" = 0 ]; then
  medido impossivel "(hooks)" "release ausente — nao aponto hook para arvore que nao existe"
elif [ -z "$BANCADA" ]; then
  medido impossivel "(hooks)" "bancada nao declarada (PLATAFIRMA_BANCADA ou $PLATAFIRMA_ARQUIVO_BANCADA) — sem clone a gatear"
else
  CLONES="platafirma-harness platafirma-core platafirma-conhecimento platafirma-arquitetura platafirma-motor platafirma-posto"
  for c in $CLONES; do
    if [ ! -e "$BANCADA/$c/.git" ]; then
      medido impossivel "$c" "clone ausente em $BANCADA — \`repo clonar\` e ato de quem prepara a maquina"
      continue
    fi
    atual="$(git -C "$BANCADA/$c" config core.hooksPath 2>/dev/null || true)"
    if [ "$atual" = "$HARNESS/hooks" ]; then
      conforme "$c"
    else
      [ "$MODO" = check ] || git -C "$BANCADA/$c" config core.hooksPath "$HARNESS/hooks"
      corrigir "$c" "apontava para ${atual:-(nao configurado)}"
    fi
  done
fi

# --- unit de systemd declarada pelo harness ----------------------------------
# Mesma estrategia de sempre: symlink, nunca copia — copia congela, e a promocao
# deixa de chegar ao systemd sem ninguem notar. O alvo do link e o caminho ESTAVEL da
# release (/opt/platafirma/current/harness/...), para a unit acompanhar `current`.
# Foi assim que o worker do chat viveu como unit TRANSIENT ate 15/08: declarado
# no repo, nunca convergido, e evaporou junto com quem o parou.
#
# Alvo e ~/.local/share/systemd/user, nao ~/.config/systemd/user: no host o
# segundo e root-owned e recusa escrita nossa. Os dois estao no UnitPath.
#
# `habilita` diz quem tem [Install] proprio. Service que so existe como alvo de
# timer NAO se habilita: quem dispara e o timer, e habilitar os dois poe o job
# para rodar tambem no boot, que nao e o contrato de nenhum deles.
echo
UNIT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/systemd/user"
echo "== unit de systemd em $UNIT_DIR"
UNITS=(
  "chat/systemd/chat-worker.service|habilita"
  "controle/systemd/harness-agregador.service|habilita"
  "deploy-harness/sinal.service|alvo-de-timer"
  "deploy-harness/sinal.timer|habilita"
  "deploy-harness/descansar-varredura.service|alvo-de-timer"
  "deploy-harness/descansar-varredura.timer|habilita"
  "deploy-harness/abertura-caderno.service|alvo-de-timer"
  "deploy-harness/abertura-caderno.timer|habilita"
  "deploy-harness/comportamento.service|alvo-de-timer"
  "deploy-harness/comportamento.timer|habilita"
)
if [ "$TEM_RELEASE" = 0 ]; then
  medido impossivel "(unit)" "release ausente — nenhuma unit do harness tem fonte"
elif ! command -v systemctl >/dev/null 2>&1; then
  medido impossivel "(unit)" "systemctl ausente — nenhuma unit do harness pode ser convergida aqui"
else
  recarregar=0
  for linha in "${UNITS[@]}"; do
    rel="${linha%%|*}"; papel="${linha#*|}"
    nome="$(basename "$rel")"
    fonte="$HARNESS/$rel"
    alvo="$UNIT_DIR/$nome"
    if [ ! -f "$fonte" ]; then
      impossivel "$nome" "declarada na lista e ausente em $fonte — lista e release divergiram"
      continue
    fi
    [ "$MODO" = check ] || mkdir -p "$UNIT_DIR"
    if [ -L "$alvo" ] && [ "$(readlink "$alvo")" = "$fonte" ]; then
      conforme "$nome"
    elif [ -e "$alvo" ] && [ ! -L "$alvo" ]; then
      # Copia no lugar do link: NOSSO caso conhecido, e sobrescrever e o conserto.
      [ "$MODO" = check ] || { ln -sfn "$fonte" "$alvo"; recarregar=1; }
      corrigir "$nome" "arquivo comum no lugar do link — trocado pelo symlink da release"
    else
      [ "$MODO" = check ] || { ln -sfn "$fonte" "$alvo"; recarregar=1; }
      corrigir "$nome" "ausente ou apontando para ${alvo:+$(readlink "$alvo" 2>/dev/null || echo 'lugar nenhum')}"
    fi
    [ "$papel" = habilita ] || continue
    [ "$MODO" = check ] || { [ "$recarregar" = 1 ] && { systemctl --user daemon-reload; recarregar=0; }; }

    # HABILITAR SEM `systemctl enable`: nesta classe de host o diretorio de
    # configuracao do usuario (~/.config/systemd/user) e root-owned, e o enable
    # via D-Bus quer escrever NA RAIZ dele quando a unit e symlink — sai
    # "Access denied" mesmo com o <target>.wants gravavel. Medido em 15/08.
    # O ato do enable e um symlink no <target>.wants; fazemos esse symlink, e o
    # systemd le o estado como `enabled` do mesmo jeito. Onde o .wants tambem e
    # root-owned (timers.target.wants), nomeamos: exige o dono da maquina.
    for alvo_t in $(sed -n 's/^WantedBy=//p' "$fonte" | tr ',' ' '); do
      wants="$HOME/.config/systemd/user/${alvo_t}.wants"
      link="$wants/$nome"
      if [ -L "$link" ] && [ "$(readlink -f "$link" 2>/dev/null || true)" = "$(readlink -f "$alvo")" ]; then
        conforme "$nome" "habilitada em $alvo_t"
      elif [ "$MODO" = check ]; then
        relata divergente "$nome" "nao habilitada em $alvo_t — nao sobe no boot"
      elif mkdir -p "$wants" 2>/dev/null && ln -sfn "$alvo" "$link" 2>/dev/null; then
        recarregar=1
        corrigir "$nome" "habilitada em $alvo_t"
      else
        impossivel "$nome" "$wants nao aceita escrita (root-owned) — habilitar exige o dono da maquina"
      fi
    done

    if [ "$(systemctl --user is-active "$nome" 2>/dev/null)" = active ]; then
      conforme "$nome" "ativa"
    elif [ "$MODO" = check ]; then
      relata divergente "$nome" "nao ativa"
    elif systemctl --user start "$nome" >/dev/null 2>&1; then
      corrigir "$nome" "iniciada"
    else
      impossivel "$nome" "start falhou — ver: systemctl --user status $nome"
    fi
  done
  [ "$recarregar" = 1 ] && systemctl --user daemon-reload
fi

# --- texto de arranque em cwd -----------------------------------------------
# A REGUA nao mora aqui: mora em `conferir arranque`, que o pre-commit tambem
# chama. Duas implementacoes da mesma regua divergem no primeiro ajuste que so
# uma das duas receber — por isso este bloco CONSULTA o verbo em vez de reimplementar.
#
# As copias moram em clones e worktrees da BANCADA: o caminho que o verbo devolve e
# relativo a ela. Sem bancada declarada, nao ha onde convergir.
#
# Converge so onde da: arquivo NAO rastreado em git. Copia em arquivo rastreado
# nao se conserta escrevendo no cwd — o proximo checkout desfaz, e o diff sujo
# aparece no branch de outra pessoa. Ali o conserto e commit no branch, e o
# instalador nomeia em vez de fingir que resolveu.
#
# Antes de sobrescrever, guarda o anterior em CLAUDE.md.antes-do-ponteiro: erro
# reversivel e defeito, erro irreversivel e perda.
echo
echo "== texto de arranque em cwd (ponteiro para conduta/arranque.md)"
CONFERIR_BIN="${CONFERIR:-$HARNESS/bin/conferir}"
if [ -z "$BANCADA" ]; then
  medido impossivel "(arranque)" "bancada nao declarada — copias de arranque moram nela"
elif [ ! -x "$CONFERIR_BIN" ] || ! command -v python3 >/dev/null 2>&1; then
  medido impossivel "(arranque)" "conferir/python3 fora de alcance — regua nao consultavel daqui"
else
  saida_arr="$("$CONFERIR_BIN" arranque --json 2>/dev/null || true)"
  if [ -z "$saida_arr" ]; then
    medido impossivel "(arranque)" "conferir arranque nao respondeu"
  else
    while IFS='|' read -r arq_rel arq_branch; do
      [ -n "$arq_rel" ] || continue
      caminho="$BANCADA/$arq_rel"
      if [ -n "$arq_branch" ]; then
        medido impossivel "$arq_rel" "copia rastreada em $arq_branch — conserto e commit no branch, nao escrita no cwd"
      elif [ "$MODO" = check ]; then
        divergentes=$((divergentes+1)); relata divergente "$arq_rel" "copia nao rastreada — converge para o ponteiro"
      elif cp -f "$caminho" "$caminho.antes-do-ponteiro" 2>/dev/null &&
           cp -f "$HARNESS/CLAUDE.md" "$caminho" 2>/dev/null; then
        corrigir "$arq_rel" "copia trocada pelo ponteiro (anterior em CLAUDE.md.antes-do-ponteiro)"
      else
        impossivel "$arq_rel" "nao consegui escrever em $caminho"
      fi
    done <<EOF_ARR
$(printf '%s' "$saida_arr" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
for c in d.get("copias", []):
    print(c["arquivo"] + "|" + (c.get("rastreado_em") or ""))
')
EOF_ARR
    total_copias="$(printf '%s' "$saida_arr" | python3 -c '
import json, sys
try: print(len(json.load(sys.stdin).get("copias", [])))
except ValueError: print(0)
')"
    [ "$total_copias" = 0 ] && conforme "(arranque)" "nenhuma copia: todo cwd aponta para a peca"
  fi
fi

# --- terceiro: mede e nomeia o efeito, nunca instala -------------------------
# Efeito medido contra bin/ nesta data. Verbo que ganhar dependencia nova
# acrescenta linha aqui no mesmo commit — tabela que envelhece mente com
# confianca, que e pior do que nao existir.
echo
echo "== ferramenta de terceiro (o instalador mede; instalar exige privilegio que ele nao tem)"
TERCEIROS=(
  "python3|conferir, tarefas, sinal, motor, persona e monta-sessao param: e o interpretador da maior parte dos verbos"
  "git|conferir repo e conferir verbo, deploy, persona, mesa e descansar param de ler o declarado dos clones"
  "docker|conferir servico, infra estado, deploy e motor param: e por docker que o servido se le"
  "systemctl|longjob nao dispara unit transiente e infra nao le unit nem timer"
  "curl|tarefas nao fala com o rastreador; infra saude e sinal nao alcancam o healthcheck do ops"
  "jq|seg para de gravar trilha e infra cache para de ler o estado do ollama"
  "rg|busca na bancada cai para grep -r, ordens de grandeza mais lenta"
  "fd|procura de arquivo por nome cai para find"
  "uv|venv reprodutivel e o modulo redis de que a fila depende ficam sem como ser instalados"
  "trivy|varredura de imagem sai do arsenal de claudinho-seguranca"
)
for linha in "${TERCEIROS[@]}"; do
  ferramenta="${linha%%|*}"; efeito="${linha#*|}"
  if command -v "$ferramenta" >/dev/null 2>&1; then
    medido conforme "$ferramenta" "$(command -v "$ferramenta")"
  else
    medido impossivel "$ferramenta" "ausente — sem ela: $efeito"
  fi
done

echo
echo "resumo: $conformes conforme . $corrigidos corrigido . $divergentes divergente . $impossiveis impossivel . $medidos medido (fora do alcance do instalador)"
if [ "$MODO" = check ]; then
  if [ "$divergentes" -gt 0 ] || [ "$impossiveis" -gt 0 ]; then
    echo "divergente: rodar sem --check corrige o que e link e hook; o resto pede decisao humana."
    exit 1
  fi
  echo "convergido: nada a fazer."
  exit 0
fi
[ "$impossiveis" -gt 0 ] && { echo "convergiu o que era do instalador; o que sobrou esta acima, com motivo."; exit 1; }
echo "convergido."
exit 0
