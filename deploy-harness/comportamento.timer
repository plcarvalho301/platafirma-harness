[Unit]
Description=Coleta de comportamento das cadeiras, tercas e sabados as 02h (#3090)

[Timer]
# Pedido do dono (26/09/2026): terca e sabado as 02h, hora do host (-03).
OnCalendar=Tue,Sat *-*-* 02:00:00
# Pega a execucao perdida quando a maquina estava desligada na hora marcada.
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
