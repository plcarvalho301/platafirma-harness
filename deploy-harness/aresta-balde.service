[Unit]
Description=Leva as arestas dos cadernos ao balde de dados (acervo.observacao_aresta) e as retira do caderno (#3505)

[Service]
Type=oneshot
# Da release, nunca de clone (card #3010): a unit sobrevive a bancada apagada.
WorkingDirectory=/opt/platafirma/current/harness
Environment=PATH=/opt/platafirma/current/harness/bin:/usr/local/bin:/usr/bin:/bin
# Mesmo ambiente do ops-mcp: verbo que passa por API sem ele toma 401 (card #3147).
EnvironmentFile=/home/claudinho/.config/ops/env
ExecStart=/opt/platafirma/current/harness/bin/mesa balde
