      "mcp__claude_ai_claudinho-mcp__run_command",
      "mcp__claude_ai_claudinho-mcp__seg",
      "mcp__claude_ai_claudinho-mcp__sessao",
      "mcp__claude_ai_claudinho-mcp__tarefas",
      "mcp__claude_ai_claudinho-mcp__teste",
      "mcp__claude_ai_claudinho-mcp__write_file"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(//home/claudinho/.config/**)",
      "Read(//home/claudinho/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(deploy:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Servidor MCP próprio: https://ops.platafirma.org/mcp (conector claudinho-mcp, controlado pelo PDP da PlataFirma)",
      "Organização GitHub de destino: github.com/plcarvalho301/platafirma-*"
    ],
    "allow": [
      "$defaults",
      "Chamadas ao conector MCP claudinho-mcp (incluindo release promover, repo pr-criar, repo pr-merge, repo sincronizar, malote e write_file): o controle de acesso por cadeira e escopo é aplicado pelo PDP no servidor ops.platafirma.org"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=/opt/platafirma/current/harness/agente/hooks/porta-sessao.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=/opt/platafirma/current/harness/agente/hooks/porta-sessao.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claudinho-mcp__.*|mcp__claude_ai_claudinho-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=/opt/platafirma/current/harness/agente/hooks/porta-sessao.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claudinho-mcp__monta_sessao|mcp__claude_ai_claudinho-mcp__monta_sessao",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=/opt/platafirma/current/harness/agente/hooks/porta-sessao.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"'"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": false
}
