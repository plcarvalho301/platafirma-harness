[Unit]
Description=Plano de controle do harness — tela
After=harness-agregador.service
Wants=harness-agregador.service

[Service]
Type=simple
WorkingDirectory=/home/claudinho/AI/deploy/harness/controle
Environment=PF_RAIZ=/home/claudinho/AI
Environment=AGREGADOR_ESTADO_PATH=/home/claudinho/AI/var/run/harness-controle/estado.json
Environment=TOKENS_CSS_PATH=/home/claudinho/AI/platafirma-arquitetura/design/tokens.css
Environment=PF_CADEIRA_TELA=claudinho-TI
ExecStart=/home/claudinho/.local/bin/uv run uvicorn harness_controle.web:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
