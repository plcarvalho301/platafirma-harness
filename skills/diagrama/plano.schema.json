{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanoDeDiagrama",
  "description": "Esquema do plano de diagrama de arquitetura na PlataFirma",
  "type": "object",
  "required": [
    "pergunta",
    "leitor",
    "tipo",
    "fontes",
    "entidades",
    "relacoes"
  ],
  "properties": {
    "pergunta": {
      "type": "string",
      "minLength": 5,
      "description": "A pergunta direta que a figura responde"
    },
    "pedido": {
      "type": "string",
      "description": "O pedido do dono ou da story, com as palavras dele; o auditor de plano o compara com a pergunta"
    },
    "leitor": {
      "type": "string",
      "minLength": 2,
      "description": "O público leitor da figura (ex: diretoria, engenharia, operacao)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "camada",
        "modulo",
        "componente-e-conector",
        "alocacao",
        "fluxo"
      ],
      "description": "Tipo de figura segundo a taxonomia da casa"
    },
    "fontes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Caminho de cada documento da fonte no repositório"
    },
    "entidades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "fonte",
          "tipo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "fonte": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "type": "string",
            "minLength": 1
          },
          "categoria": {
            "type": "string",
            "enum": [
              "persistencia",
              "servico",
              "superficie",
              "porta",
              "conhecimento",
              "host",
              "mensageria",
              "identidade",
              "cadeira"
            ]
          },
          "camada": {
            "type": "string"
          },
          "modulo_pai": {
            "type": "string"
          },
          "host": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "relacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "de",
          "para",
          "rotulo"
        ],
        "properties": {
          "de": {
            "type": "string",
            "minLength": 1
          },
          "para": {
            "type": "string",
            "minLength": 1
          },
          "rotulo": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "camadas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fronteira": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
